t: str = Field(description=\"UTF-8 text content.\")\n49\t    agent_id: str = Field(\n50\t        default=\"anonymous_agent\",\n51\t        description=\"Identifier of the agent authoring this write — recorded in lineage.\",\n52\t    )\n53\t\n54\t\n55\tclass SandboxWriteResponse(BaseModel):\n56\t    status: Literal[\"written\"]\n57\t    workspace: str\n58\t    relative_path: str\n59\t    bytes_written: int\n60\t\n61\t\n62\t@router.get(\"/health\")\n63\tasync def sandbox_health() -> dict:\n64\t    \"\"\"Liveness probe — confirms the sandbox surface is mounted.\"\"\"\n65\t    return {\"status\": \"ok\", \"subdirs\": list(AGENT_SANDBOX_SUBDIRS)}\n66\t\n67\t\n68\t@router.get(\"/list/{workspace}/{subdir}\")\n69\tasync def list_sandbox(workspace: str, subdir: SubdirLiteral) -> dict:\n70\t    \"\"\"List files in a sandbox subdir. Read-only — also reachable via the\n71\t    standard file API, but exposed here so the agent has a single base URL.\"\"\"\n72\t    target = get_agent_sandbox_path(workspace, subdir)\n73\t    target.mkdir(parents=True, exist_ok=True)\n74\t    entries = sorted(p.name for p in target.iterdir() if p.is_file())\n75\t    return {\"workspace\": workspace, \"subdir\": subdir, \"entries\": entries}\n76\t\n77\t\n78\t@router.get(\"/read/{workspace}/{subdir}/{filename}\")\n79\tasync def read_sandbox_file(workspace: str, subdir: SubdirLiteral, filename: str) -> dict:\n80\t    \"\"\"Return the UTF-8 contents of a sandbox file.\n81\t\n82\t    Read-only counterpart of :func:`write_sandbox_file`. Path validation is\n83\t    identical: the resolved target must stay inside the workspace's\n84\t    ``agent_sandbox/`` subtree, the filename must be a single component\n85\t    without path separators or leading ``.``, and the file must already\n86\t    exist (no implicit creation).\n87\t    \"\"\"\n88\t    _validate_filename(filename)\n89\t\n90\t    subdir_path = get_agent_sandbox_path(workspace, subdir)\n91\t    target = (subdir_path / filename).resolve()\n92\t\n93\t    if not is_within_agent_sandbox(workspace, target):\n94\t        raise HTTPException(\n95\t            status_code=400,\n96\t            detail=\"Resolved path escapes the agent sandbox subtree.\",\n97\t        )\n98\t\n99\t    if not target.is_file():\n100\t        raise HTTPException(\n101\t            status_code=404,\n102\t            detail=f\"agent_sandbox/{subdir}/{filename} does not exist.\",\n103\t        )\n104\t\n105\t    content = target.read_text(encoding=\"utf-8\")\n106\t    return {\n107\t        \"workspace\": workspace,\n108\t        \"subdir\": subdir,\n109\t        \"filename\": filename,\n110\t        \"relative_path\": f\"agent_sandbox/{subdir}/{filename}\",\n111\t        \"content\": content,\n112\t        \"bytes\": len(content.encode(\"utf-8\")),\n113\t    }\n114\t\n115\t\n116\t@router.post(\"/write\", response_model=SandboxWriteResponse)\n117\tasync def write_sandbox_file(req: SandboxWriteRequest) -> SandboxWriteResponse:\n118\t    \"\"\"Write a UTF-8 text file into ``agent_sandbox/<subdir>/``.\n119\t\n120\t    Rejects:\n121\t      - Filenames containing path separators or starting with ``.``\n122\t      - Any resolved path that escapes the sandbox subtree\n123\t    \"\"\"\n124\t    _validate_filename(req.filename)\n125\t\n126\t    subdir_path = get_agent_sandbox_path(req.workspace, req.subdir)\n127\t    subdir_path.mkdir(parents=True, exist_ok=True)\n128\t    target = (subdir_path / req.filename).resolve()\n129\t\n130\t    if not is_within_agent_sandbox(req.workspace, target):\n131\t        raise HTTPException(\n132\t            status_code=400,\n133\t            detail=\"Resolved path escapes the agent sandbox subtree.\",\n134\t        )\n135\t\n136\t    target.write_text(req.content, encoding=\"utf-8\")\n137\t    bytes_written = len(req.content.encode(\"utf-8\"))\n138\t\n139\t    relative_path = f\"agent_sandbox/{req.subdir}/{req.filename}\"\n140\t    emit_agent_authorship(\n141\t        workspace_id=req.workspace,\n142\t        agent_id=