():\n44\t            continue\n45\t        for f in sorted(d.glob(\"*.*\")):\n46\t            if f.suffix.lower() not in SUPPORTED or _safe_stem(f.name) in seen:\n47\t                continue\n48\t            if source and _safe_stem(f.name) != _safe_stem(source):\n49\t                continue\n50\t            seen.add(_safe_stem(f.name))\n51\t            try:\n52\t                model = build_docmodel(f, workspace=workspace, emit_crops=emit_crops, force=force)\n53\t                results.append(\n54\t                    {\n55\t                        \"source\": f.name,\n56\t                        \"elements\": len(model[\"elements\"]),\n57\t                        \"counts\": model[\"counts\"],\n58\t                        \"degraded\": model[\"degraded\"],\n59\t                    }\n60\t                )\n61\t            except Exception as e:  # one bad file must not sink the batch\n62\t                results.append({\"source\": f.name, \"error\": str(e)})\n63\t    if not results:\n64\t        raise HTTPException(404, f\"No ingestible files found under workspace '{workspace}'.\")\n65\t    return {\"status\": \"ok\", \"docmodels\": results}\n66\t\n67\t\n68\t@router.post(\"/enrich\")\n69\tasync def vision_enrich(\n70\t    workspace: str = \"default\",\n71\t    source: Optional[str] = None,\n72\t    vlm_model: Optional[str] = None,\n73\t    reviewer_model: Optional[str] = None,\n74\t    render_check: bool = False,\n75\t    visual_judge: bool = True,\n76\t    min_fidelity: float = 7.0,\n77\t    limit: Optional[int] = None,\n78\t    write_to_data_in: bool = True,\n79\t):\n80\t    \"\"\"Run the describer ladder over each DocModel's visuals, stitch an enriched\n81\t    markdown (+ JSON sidecar), and drop the enriched markdown into data_in/ so the\n82\t    existing RAG ingest picks up the visually-complete document.\"\"\"\n83\t    dm_dir = get_workspace_path(workspace, \".benny/docmodel\")\n84\t    if not dm_dir.exists():\n85\t        raise HTTPException(404, \"No DocModels yet — run POST /api/vision/docmodel first.\")\n86\t\n87\t    enriched = []\n88\t    for jf in sorted(dm_dir.glob(\"*.json\")):\n89\t        if jf.name.endswith(\".enriched.json\"):\n90\t            continue\n91\t        if source and _safe_stem(jf.stem) != _safe_stem(source):\n92\t            continue\n93\t        docmodel = json.loads(jf.read_text(encoding=\"utf-8\"))\n94\t        kwargs = {\n95\t            \"render_check\": render_check,\n96\t            \"visual_judge\": visual_judge,\n97\t            \"min_fidelity\": min_fidelity,\n98\t            \"limit\": limit,\n99\t        }\n100\t        if vlm_model:\n101\t            kwargs[\"vlm_model\"] = vlm_model\n102\t        if reviewer_model:\n103\t            kwargs[\"reviewer_model\"] = reviewer_model\n104\t        res = await enrich_docmodel(docmodel, **kwargs)\n105\t        paths = write_enriched(res, workspace, docmodel.get(\"source\", jf.stem))\n106\t        if write_to_data_in:\n107\t            di = get_workspace_path(workspace, \"data_in\")\n108\t            di.mkdir(parents=True, exist_ok=True)\n109\t            md_name = f\"{_safe_stem(docmodel.get('source', jf.stem))}.md\"\n110\t            (di / md_name).write_text(res[\"markdown\"], encoding=\"utf-8\")\n111\t            paths[\"data_in\"] = str(di / md_name)\n112\t        enriched.append(\n113\t            {\"source\": docmodel.get(\"source\"), \"summary\": res[\"summary\"], \"paths\": paths}\n114\t        )\n115\t\n116\t    if not enriched:\n117\t        raise HTTPException(404, f\"No matching DocModel to enrich in workspace '{workspace}'.\")\n118\t    return {\"status\": \"ok\", \"enriched\": enriched}\n119\t"}]},"uuid":"6235f198-b786-44d4-93a4-24a12bc17ea9","timestamp":"2026-07-01T07:32:36.983Z","toolUseResult":{"type":"text","file":{"filePath":"prime-silo\\runtime\\benny\\api\\vision_routes.py","content":"\"\"\"\nVision ingestion routes (VIS-001 / ADR-003).\n\nExposes the multimodal document-parsing workflow over HTTP so the\n``vision_ingestion_pipeline`` manifest is runnable via ``benny enrich``:\n\n  POST /api/vision/docmodel  — Phase 0: parse staged/ingestible docs into DocModels\n                               (element tree + table JSON + picture crops).\n  POST /api/vision/enrich    — Phase 2+3: run the describer ladder over each DocModel's\n                               visuals and stitch an enriched markdown into data_in/\n                               (which the existing /api/rag/ingest then consumes).\n\nBoth are long-running (Docling + local VLM); callers use the manifest's\nblocking_with_task_fallback. All model calls flow through ``call_model``.\n\"\"\"\n\nimport json\nfrom typing import Optional\n\nfrom fastapi import APIRouter, HTTPException\n\nfrom ..core.docmodel import _safe_stem, build_docmodel\nfrom ..core.vision_pipeline import enrich_docmodel, write_enriched\nfrom ..core.workspace import get_workspace_path\n\nrouter = APIRouter()\n\nSUPPORTED = {\".pdf\", \".docx\", \".pptx\", \".html\", \".md\", \".txt\"}\n\n\n@router.post(\"/docmodel\")\nasync def vision_docmodel(\n    workspace: str = \"default\",\n    emit_crops: bool = True,\n    source: Optional[str] = None,\n    force: bool = False,\n):\n    \"\"\"Build DocModels for ingestible files under the workspace (staging + data_in).\"\"\"\n    results = []\n    seen = set()\n    for sub in (\"staging\", \"data_in\"):\n        d = get_workspace_path(workspace, sub)\n        if not d.exists():\n            continue\n        for f in sorted(d.glob(\"*.*\")):\n            if f.suffix.lower() not in SUPPORTED or _safe_stem(f.name) in seen:\n                continue\n            if source and _safe_stem(f.name) != _safe_stem(source):\n                continue\n            seen.add(_safe_stem(f.name))\n            try:\n                model = build_docmodel(f, workspace=workspace, emit_crops=emit_crops, force=force)\n                results.append(\n                    {\n                        \"source\": f.name,\n              