ting\n44\t    route: Literal[\"no_retrieval\", \"single_step\", \"multi_hop\"]  # Smart Router decision\n45\t    \n46\t    # Retrieval\n47\t    documents: List[RetrievedDocument]   # Raw retrieved documents\n48\t    graded_documents: List[RetrievedDocument]  # Documents that passed relevance grading\n49\t    \n50\t    # Generation\n51\t    generation: Optional[str]           # Generated answer\n52\t    \n53\t    # Quality Control\n54\t    hallucination_check: Optional[bool]  # True = grounded, False = hallucinated\n55\t    answer_quality: Optional[bool]       # True = adequate, False = needs improvement\n56\t    \n57\t    # Self-Correction\n58\t    rewritten_query: Optional[str]       # Refined query for retry\n59\t    retry_count: int                     # Current retry iteration\n60\t    max_retries: int                     # Maximum retries (default 3)\n61\t    \n62\t    # Metadata\n63\t    route_explanation: str               # Why the router chose this route\n64\t    execution_trace: List[str]           # Ordered list of nodes executed\n65\t\n66\t\n67\t# =============================================================================\n68\t# NODE FUNCTIONS\n69\t# =============================================================================\n70\t\n71\tasync def smart_router(state: AdaptiveRAGState) -> dict:\n72\t    \"\"\"Classify the query into no_retrieval, single_step, or multi_hop.\"\"\"\n73\t    logger.info(\"--- NODE: smart_router ---\")\n74\t    \n75\t    system_prompt = \"\"\"You are a smart router for a RAG pipeline.\n76\tYour goal is to classify a user query into one of three routes based on its complexity:\n77\t\n78\t1. `no_retrieval`: Simple factual questions or greetings that can be answered from your internal knowledge.\n79\t   Example: \"What is the capital of France?\", \"Hi\", \"Define GDP\".\n80\t2. `single_step`: Questions requiring a simple document lookup but not complex relational reasoning.\n81\t   Example: \"What does the Frolov report say about AI?\", \"Who is the CEO of Company X?\".\n82\t3. `multi_hop`: Questions requiring cross-document reasoning, entity relationships, or causal chains.\n83\t   Example: \"How would a recession in sector X affect portfolio Y based on the filings?\".\n84\t\n85\tRespond ONLY with a JSON object: {\"route\": \"no_retrieval\" | \"single_step\" | \"multi_hop\", \"explanation\": \"Brief reasoning\"}\"\"\"\n86\t\n87\t    messages = [\n88\t        {\"role\": \"system\", \"content\": system_prompt},\n89\t        {\"role\": \"user\", \"content\": state[\"query\"]}\n90\t    ]\n91\t    \n92\t    # Pre-initialise so the except block can't raise UnboundLocalError when\n93\t    # call_model itself fails (e.g. the resolved provider is down / 500s). A\n94\t    # dead LLM must degrade to single_step retrieval, not crash the pipeline.\n95\t    response = \"\"\n96\t    route = \"single_step\"\n97\t    explanation = \"Defaulted to single_step\"\n98\t    try:\n99\t        response = await call_model(model=state[\"model\"], messages=messages, temperature=0.0)\n100\t        # Handle cases where response might be wrapped in ```json ... ```\n101\t        clean_response = (response or \"\").strip()\n102\t        if clean_response.startswith(\"```json\"):\n103\t            clean_response = clean_response[7:-3].strip()\n104\t        elif clean_response.startswith(\"```\"):\n105\t            clean_response = clean_response[3:-3].strip()\n106\t\n107\t        parsed = json.loads(clean_response)\n108\t        route = parsed.get(\"route\", \"single_step\")\n109\t        explanation = parsed.get(\"explanation\", \"\")\n110\t    except Exception as e:\n111\t        logger.warning(f\"Router fell back to single_step ({e}). Raw: {response!r}\")\n112\t        explanation = f\"Defaulted to single_step (router LLM unavailable: {e})\"\n113\t\n114\t    return {\n115\t        \"route\": route, \n116\t        \"route_explanation\": explanation, \n117\t        \"execution_trace\": state.get(\"execution_trace\", []) + [\"smart_router\"]\n118\t    }\n119\t\n120\t\n121\tasync def retrieve_single_step(state: AdaptiveRAGState) -> dict:\n122\t    \"\"\"Retrieve documents from ChromaDB.\"\"\"\n123\t    logger.info(\"--- NODE: retrieve_single_step ---\")\n124\t    \n125\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n126\t    workspace = state[\"workspace\"]\n127\t    \n128\t    try:\n129\t        client = get_chromadb_client(workspace)\n130\t        collection = get_knowledge_collection(client)\n131\t        \n132\t        results = collection.query(\n133\t            query_texts=[query],\n134\t            n_results=10\n135\t        )\n136\t        \n137\t        documents = []\n138\t        if results and results[\"documents\"] and results[\"documents\"][0]:\n139\t            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n140\t                documents.append({\n141\t                    \"content\": doc,\n142\t                    \"source\": meta.get(\"source\", \"Unknown\"),\n143\t                    \"relevance_score\": 0.0\n144\t                })\n145\t        \n146\t        return {\n147\t            \"documents\": documents,\n148\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n149\t        }\n150\t    except Exception as e:\n151\t        logger.error(f\"Retrieval failed: {e}\")\n152\t        return {\n153\t            \"documents\": [],\n154\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n155\t        }\n156\t\n157\t\n158\tasync def retrieve_multi_hop(state: AdaptiveRAGState) -> dict:\n159\t    \"\"\"Retrieve from ChromaDB and perform multi-hop graph traversal.\"\"\"\n160\t    logger.info(\"--- NODE: retrieve_multi_hop ---\")\n161\t    \n162\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n163\t    workspace = state[\"workspace\"]\n164\t    \n165\t    # 1. ChromaDB Retrieval\n166\t    chroma_docs = []\n167\t    try:\n168\t        client = get_chromadb_client(workspace)\n169\t        collection = get_knowledge_collection(client)\n170\t        results = collection.query(query_texts=[query], n_results=10)\n171\t        if results and results[\"documents\"] and results[\"documents\"][0]:\n172\t            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n173\t                chroma_docs.append({\n174\t                    \"content\": doc,\n175\t                    \"source\": meta.get(\"source\", \"Unknown\"),\n176\t                    \"relevance_score\": 0.0\n177\t                })\n178\t    except Exception as e:\n179\t        logger.error(f\"ChromaDB retrieval failed in multi-hop: {e}\")\n180\t\n181\t    # 2. Neo4j Multi-Hop Traversal\n182\t    graph_docs = multi_hop_traversal(query, workspace=workspace)\n183\t    formatted_graph_docs = []\n184\t    for gdoc in graph_docs:\n185\t        formatted_graph_docs.append({\n186\t            \"content\": gdoc[\"content\"],\n187\t            \"source\": gdoc[\"source\"],\n188\t            \"relevance_score\": 0.0\n189\t        })\n190\t\n191\t    # Merge and deduplicate (by source/content simplified)\n192\t    merged = chroma_docs + formatted_graph_docs\n193\t    seen = set()\n194\t    deduped = []\n195\t    for d in merged:\n196\t        if d[\"content\"] not in seen:\n197\t            deduped.append(d)\n198\t            seen.add(d[\"content\"])\n199\t\n200\t    return {\n201\t        \"documents\": deduped,\n202\t        \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_multi_hop\"]\n203\t    }\n204\t\n205\t\n206\t# Cap how many candidate docs we grade in one shot. Each extra excerpt costs\n207\t# prompt tokens, and local NPU context windows are small; 6 keeps the single\n208\t# grading call well inside a ~2k-token budget while still covering the top hits.\n209\t_MAX_GRADE_DOCS = 6\n210\t\n211\t\n212\tasync def grade_documents(state: AdaptiveRAGState) -> dict:\n213\t    \"\"\"Grade retrieved docs for relevance in a SINGLE batched LLM call.\n214\t\n215\t    The original implementation issued one call per document (up to 10). On a\n216\t    local NPU that degrades under sustained load that would stall or time out,\n217\t    and because zero graded docs triggers a query rewrite it would then spiral\n218\t    into re-retrieval + re-grading. We instead grade all candidates in one call\n219\t    and, if the grader returns nothing usable, fall back to the top retrieved\n220\t    docs so generation always has real context to answer/validate against.\n221\t    \"\"\"\n222\t    logger.info(\"--- NODE: grade_documents ---\")\n223\t\n224\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n225\t    documents = state[\"documents\"][:_MAX_GRADE_DOCS]\n226\t\n227\t    if not documents:\n228\t        return {\n229\t            \"graded_documents\": [],\n230\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"grade_documents\"],\n231\t        }\n232\t\n233\t    listing = \"\\n\\n\".join(f\"[{i}] {d['content'][:600]}\" for i, d in enumerate(documents))\n234\t    system_prompt = (\n235\t        \"You are a relevance grader. Given a question and a numbered list of \"\n236\t        \"document excerpts, return the indices of the excerpts that help answer \"\n237\t        \"the question. Respond ONLY with a JSON array of integers, e.g. [0,2]. \"\n238\t        \"If none are relevant, return [].\"\n239\t    )\n240\t    user_prompt = f\"QUESTION: {query}\\n\\nEXCERPTS:\\n{listing}\"\n241\t\n242\t    graded_documents = []\n243\t    try:\n244\t        response = await call_model(model=state[\"model\"], messages=[\n245\t            {\"role\": \"system\", \"content\": system_prompt},\n246\t            {\"role\": \"user\", \"content\": user_prompt},\n247\t        ], temperature=0.0)\n248\t\n249\t        import re as _re\n250\t        match = _re.search(r\"\\[[\\d,\\s]*\\]\", response or \"\")\n251\t        if match:\n252\t            for i in json.loads(match.group(0)):\n253\t                if isinstance(i, int) and 0 <= i < len(documents):\n254\t                    documents[i][\"relevance_score\"] = 1.0\n255\t                    graded_documents.append(documents[i])\n256\t    except Exception as e:\n257\t        logger.warning(f\"Batched grading failed ({e}); falling back to top retrieved docs.\")\n258\t\n259\t    # Anti-spiral fallback: never hand generation an empty context when we DID\n260\t    # retrieve documents. Keep the top 3 so the model can answer/validate\n261\t    # instead of looping back into a rewrite (which multiplies local LLM calls).\n262\t    if not graded_documents and documents:\n263\t        for doc in documents[:3]:\n264\t            doc[\"relevance_score\"] = 0.5\n265\t            graded_documents.append(doc)\n266\t\n267\t    return {\n268\t        \"graded_documents\": graded_documents,\n269\t        \"execution_trace\": state.get(\"execution_trace\", []) + [\"grade_documents\"]\n270\t    }\n271\t\n272\t\n273\tasync def generate_answer(state: AdaptiveRAGState) -> dict:\n274\t    \"\"\"Generate the answer based on context or parametric knowledge.\"\"\"\n275\t    logger.info(\"--- NODE: generate_answer ---\")\n276\t    \n277\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n278\t    route = state[\"route\"]\n279\t    graded_docs = state[\"graded_documents\"]\n280\t    \n281\t    if route == \"no_retrieval\":\n282\t        system_prompt = \"You are a helpful research assistant. Answer the question accurately based on your knowledge.\"\n283\t        context_str = \"No external context used.\"\n284\t    else:\n285\t        system_prompt = \"\"\"You are a helpful research assistant. Answer the question based STRICTLY on the provided context. \n286\tIf the context doesn't contain the answer, say so explicitly.\"\"\"\n287\t        context_str = \"\\n\".join([f\"[Source: {d['source']}]\\n{d['content']}\" for d in graded_docs])\n288\t\n289\t    user_prompt = f\"CONTEXT:\\n{context_str}\\n\\nQUESTION: {query}\"\n290\t    \n291\t    try:\n292\t        generation = await call_model(model=state[\"model\"], messages=[\n293\t            {\"role\": \"system\", \"content\": system_prompt},\n294\t            {\"role\": \"user\", \"content\": user_prompt}\n295\t        ])\n296\t        \n297\t        return {\n298\t            \"generation\": generation,\n299\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n300\t        }\n301\t    except Exception as e:\n302\t        logger.error(f\"Generation failed: {e}\")\n303\t        return {\n304\t            \"generation\": f\"Error generating answer: {str(e)}\",\n305\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n306\t        }\n307\t\n308\t\n309\tasync def check_hallucination(state: AdaptiveRAGState) -> dict:\n310\t    \"\"\"Check if the answer is grounded in the documents.\"\"\"\n311\t    logger.info(\"--- NODE: check_hallucination ---\")\n312\t    \n313\t    if state[\"route\"] == \"no_retrieval\":\n314\t        return {\"hallucination_check\": True, \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]}\n315\t    \n316\t    graded_docs = state[\"graded_documents\"]\n317\t    generation = state[\"generation\"]\n318\t    \n319\t    context_str = \"\\n\".join([d['content'] for d in graded_docs])\n320\t    \n321\t    system_prompt = \"\"\"You are a hallucination grader. evaluate if the generated answer is fully grounded in the provided facts.\n322\tRespond with ONLY 'yes' if it is grounded, or 'no' if it contains hallucinations or unverified info.\"\"\"\n323\t    \n324\t    user_prompt = f\"FACTS:\\n{context_str}\\n\\nANSWER:\\n{generation}\"\n325\t    \n326\t    try:\n327\t        response = await call_model(model=state[\"model\"], messages=[\n328\t            {\"role\": \"system\", \"content\": system_prompt},\n329\t            {\"role\": \"user\", \"content\": user_prompt}\n330\t        ], temperature=0.0)\n331\t        \n332\t        is_grounded = \"yes\" in response.lower()\n333\t        return {\n334\t            \"hallucination_check\": is_grounded,\n335\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]\n336\t        }\n337\t    except Exception as e:\n338\t        logger.warning(f\"Hallucination check failed: {e}\")\n339\t        return {\"hallucination_check\": True} # Default to true on error to avoid loops\n340\t\n341\t\n342\tasync def check_answer_quality(state: AdaptiveRAGState) -> dict:\n343\t    \"\"\"Check if the answer addresses the user query.\"\"\"\n344\t    logger.info(\"--- NODE: check_answer_quality ---\")\n345\t    \n346\t    query = state[\"query\"]\n347\t    generation = state[\"generation\"]\n348\t    \n349\t    system_prompt = \"\"\"You are a quality grader. Does the following answer adequately address the original question? Is it complete and useful? \n350\tRespond with ONLY 'yes' or 'no'.\"\"\"\n351\t    \n352\t    user_prompt = f\"QUESTION: {query}\\n\\nANSWER: {generation}\"\n353\t    \n354\t    try:\n355\t        response = await call_model(model=state[\"model\"], messages=[\n356\t            {\"role\": \"system\", \"content\": system_prompt},\n357\t            {\"role\": \"user\", \"content\": user_prompt}\n358\t        ], temperature=0.0)\n359\t        \n360\t        is_adequate = \"yes\" in response.lower()\n361\t        return {\n362\t            \"answer_quality\": is_adequate,\n363\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_answer_quality\"]\n364\t        }\n365\t    except Exception as e:\n366\t        logger.warning(f\"Quality check failed: {e}\")\n367\t        return {\"answer_quality\": True}\n368\t\n369\t\n370\tasync def rewrite_query(state: AdaptiveRAGState) -> dict:\n371\t    \"\"\"Rewrite the query for better retrieval.\"\"\"\n372\t    logger.info(\"--- NODE: rewrite_query ---\")\n373\t    \n374\t    query = state[\"query\"]\n375\t    \n376\t    system_prompt = \"\"\"The following question did not produce a satisfactory answer. \n377\tRewrite it to be more specific and searchable for a vector database. \n378\tReturn ONLY the rewritten question, nothing else.\"\"\"\n379\t    \n380\t    try:\n381\t        new_query = await call_model(model=state[\"model\"], messages=[\n382\t            {\"role\": \"system\", \"content\": system_prompt},\n383\t            {\"role\": \"user\", \"content\": query}\n384\t        ])\n385\t        \n386\t        return {\n387\t            \"rewritten_query\": new_query.strip(),\n388\t            \"retry_count\": state[\"retry_count\"] + 1,\n389\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n390\t        }\n391\t    except Exception as e:\n392\t        logger.warning(f\"Query rewrite failed: {e}\")\n393\t        return {\n394\t            \"retry_count\": state[\"retry_count\"] + 1,\n395\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n396\t        }\n397\t\n398\t\n399\t# =============================================================================\n400\t# ROUTING FUNCTIONS\n401\t# =============================================================================\n402\t\n403\tdef route_query(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"retrieve_single_step\", \"retrieve_multi_hop\"]:\n404\t    \"\"\"Route after smart_router based on the classified route.\"\"\"\n405\t    route = state.get(\"route\", \"single_step\")\n406\t    if route == \"no_retrieval\":\n407\t        return \"generate_answer\"\n408\t    elif route == \"multi_hop\":\n409\t        return \"retrieve_multi_hop\"\n410\t    else:\n411\t        return \"retrieve_single_step\"\n412\t\n413\tdef after_grading(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"rewrite_query\"]:\n414\t    \"\"\"After grading, decide: generate or rewrite.\"\"\"\n415\t    graded = state.get(\"graded_documents\", [])\n416\t    if len(graded) == 0 and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n417\t        return \"rewrite_query\"\n418\t    return \"generate_answer\"\n419\t\n420\tdef after_hallucination_check(state: AdaptiveRAGState) -> Literal[\"check_answer_quality\", \"rewrite_query\"]:\n421\t    \"\"\"After hallucination check: if hallucinated and retries left, rewrite.\"\"\"\n422\t    if not state.get(\"hallucination_check\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n423\t        return \"rewrite_query\"\n424\t    return \"check_answer_quality\"\n425\t\n426\tdef after_answer_quality(state: AdaptiveRAGState) -> Literal[\"__end__\", \"rewrite_query\"]:\n427\t    \"\"\"After answer quality check: if poor and retries left, rewrite.\"\"\"\n428\t    if not state.get(\"answer_quality\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n429\t        return \"rewrite_query\"\n430\t    return \"__end__\"\n431\t\n432\tdef after_rewrite(state: AdaptiveRAGState) -> Literal[\"retrieve_single_step\", \"retrieve_multi_hop\"]:\n433\t    \"\"\"After rewrite, go back to retrieval using the original route.\"\"\"\n434\t    route = state.get(\"route\", \"single_step\")\n435\t    if route == \"multi_hop\":\n436\t        return \"retrieve_multi_hop\"\n437\t    return \"retrieve_single_step\"\n438\t\n439\t\n440\t# =============================================================================\n441\t# GRAPH CONSTRUCTION\n442\t# =============================================================================\n443\t\n444\tdef build_adaptive_rag_graph(self_check: bool = False) -> StateGraph:\n445\t    \"\"\"Build the Adaptive RAG LangGraph.\n446\t\n447\t    self_check=False (default) builds the LEAN pipeline:\n448\t        router → retrieve → grade → generate → END   (3 LLM calls)\n449\t    This is what works on a single local model in one synchronous request.\n450\t    The full self-correcting variant (post-generation hallucination + answer-\n451\t    quality grading with query-rewrite loops) adds 3+ more sequential calls and\n452\t    can loop several times — fine for fast cloud models, but on a local 12B\n453\t    reasoning model it runs for minutes and the caller's connection drops\n454\t    (\"fetch failed\"). Enable it explicitly (self_check=True + max_retries>0)\n455\t    only when the backing model is fast enough.\n456\t    \"\"\"\n457\t    graph = StateGraph(AdaptiveRAGState)\n458\t\n459\t    graph.add_node(\"smart_router\", smart_router)\n460\t    graph.add_node(\"retrieve_single_step\", retrieve_single_step)\n461\t    graph.add_node(\"retrieve_multi_hop\", retrieve_multi_hop)\n462\t    graph.add_node(\"grade_documents\", grade_documents)\n463\t    graph.add_node(\"generate_answer\", generate_answer)\n464\t    graph.add_node(\"rewrite_query\", rewrite_query)\n465\t\n466\t    graph.add_edge(START, \"smart_router\")\n467\t    graph.add_conditional_edges(\"smart_router\", route_query, {\n468\t        \"generate_answer\": \"generate_answer\",\n469\t        \"retrieve_single_step\": \"retrieve_single_step\",\n470\t        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n471\t    })\n472\t    graph.add_edge(\"retrieve_single_step\", \"grade_documents\")\n473\t    graph.add_edge(\"retrieve_multi_hop\", \"grade_documents\")\n474\t    graph.add_conditional_edges(\"grade_documents\", after_grading, {\n475\t        \"generate_answer\": \"generate_answer\",\n476\t        \"rewrite_query\": \"rewrite_query\",\n477\t    })\n478\t    graph.add_conditional_edges(\"rewrite_query\", after_rewrite, {\n479\t        \"retrieve_single_step\": \"retrieve_single_step\",\n480\t        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n481\t    })\n482\t\n483\t    if self_check:\n484\t        graph.add_node(\"check_hallucination\", check_hallucination)\n485\t        graph.add_node(\"check_answer_quality\", check_answer_quality)\n486\t        graph.add_conditional_edges(\"generate_answer\", lambda s: \"check_answer_quality\" if s[\"route\"] == \"no_retrieval\" else \"check_hallucination\", {\n487\t            \"check_hallucination\": \"check_hallucination\",\n488\t            \"check_answer_quality\": \"check_answer_quality\",\n489\t        })\n490\t        graph.add_conditional_edges(\"check_hallucination\", after_hallucination_check, {\n491\t            \"check_answer_quality\": \"check_answer_quality\",\n492\t            \"rewrite_query\": \"rewrite_query\",\n493\t        })\n494\t        graph.add_conditional_edges(\"check_answer_quality\", after_answer_quality, {\n495\t            \"__end__\": END,\n496\t            \"rewrite_query\": \"rewrite_query\",\n497\t        })\n498\t    else:\n499\t        # Lean: stop after a grounded answer — no extra LLM round-trips.\n500\t        graph.add_edge(\"generate_answer\", END)\n501\t\n502\t    return graph.compile()\n503\t\n504\t\n505\tasync def run_adaptive_rag(\n506\t    query: str,\n507\t    workspace: str = \"default\",\n508\t    model: Optional[str] = None,\n509\t    max_retries: int = 0,\n510\t    self_check: bool = False,\n511\t) -> AdaptiveRAGState:\n512\t    \"\"\"Execute the Adaptive RAG pipeline (lean by default; see build graph).\"\"\"\n513\t    # Honour local-first routing: when the caller doesn't pin a model, resolve\n514\t    # the workspace's configured chat model (Agents screen / manifest) instead\n515\t    # of a hardcoded default that may not be loaded on this machine.\n516\t    if not model:\n517\t        try:\n518\t            from ..core.models import get_active_model\n519\t            model = await get_active_model(workspace, role=\"chat\")\n520\t        except Exception:\n521\t            model = \"fastflowlm/default\"\n522\t\n523\t    graph = build_adaptive_rag_graph(self_check=self_check)\n524\t\n525\t    initial_state: AdaptiveRAGState = {\n526\t        \"query\": query,\n527\t        \"workspace\": workspace,\n528\t        \"model\": model,\n529\t        \"route\": \"single_step\",  # Will be overwritten by smart_router\n530\t        \"documents\": [],\n531\t        \"graded_documents\": [],\n532\t        \"generation\": None,\n533\t        \"hallucination_check\": None,\n534\t        \"answer_quality\": None,\n535\t        \"rewritten_query\": None,\n536\t        \"retry_count\": 0,\n537\t        \"max_retries\": max_retries,\n538\t        \"route_explanation\": \"\",\n539\t        \"execution_trace\": [],\n540\t    }\n541\t    \n542\t    result = await graph.ainvoke(initial_state)\n543\t    return result\n544\t"}]},"uuid":"ee421073-fd68-4a1b-add1-79ae1faba5a6","timestamp":"2026-06-23T08:59:38.890Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\adaptive_rag.py","content":"\"\"\"\nAdaptive RAG Pipeline — Self-correcting retrieval with Smart Router.\n\nArchitecture:\n  START → SmartRouter → [NoRetrieval | SingleStep | MultiHop] → \n  GradeDocuments → GenerateAnswer → HallucinationGrader → \n  AnswerGrader → [END | RewriteQuery → loop back]\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport json\nfrom typing import TypedDict, Optional, List, Dict, Any, Literal\n\nfrom langgraph.graph import StateGraph, START, END\n\nfrom ..core.models import call_model\nfrom ..core.graph_db import get_driver, multi_hop_traversal  # For multi-hop traversal\nfrom ..core.workspace import get_workspace_path\nfrom ..governance.lineage import track_workflow_start, track_workflow_complete\nfrom ..tools.knowledge import get_chromadb_client, get_knowledge_collection\n\nlogger = logging.getLogger(__name__)\n\n# =============================================================================\n# STATE DEFINITION\n# =============================================================================\n\nclass RetrievedDocument(TypedDict):\n    \"\"\"A single retrieved document with metadata.\"\"\"\n    content: str\n    source: str\n    relevance_score: float  # 0.0 to 1.0, set by RetrieverGrader\n\nclass AdaptiveRAGState(TypedDict):\n    \"\"\"State schema for the Adaptive RAG pipeline.\"\"\"\n    # Input\n    query: str                          # Original user query\n    workspace: str                      # Workspace for ChromaDB/Neo4j scoping\n    model: str                          # LLM model identifier (passed to call_model)\n    \n    # Routing\n    route: Literal[\"no_retrieval\", \"single_step\", \"multi_hop\"]  # Smart Router decision\n    \n    # Retrieval\n    documents: List[RetrievedDocument]   # Raw retrieved documents\n    graded_documents: List[RetrievedDocument]  # Documents that passed relevance grading\n    \n    # Generation\n    generation: Optional[str]           # Generated answer\n    \n    # Quality Control\n    hallucination_check: Optional[bool]  # True = grounded, False = hallucinated\n    answer_quality: Optional[bool]       # True = adequate, False = needs improvement\n    \n    # Self-Correction\n    rewritten_query: Optional[str]       # Refined query for retry\n    retry_count: int                     # Current retry iteration\n    max_retries: int                     # Maximum retries (default 3)\n    \n    # Metadata\n    route_explanation: str               # Why the router chose this route\n    execution_trace: List[str]           # Ordered list of nodes executed\n\n\n# =============================================================================\n# NODE FUNCTIONS\n# =============================================================================\n\nasync def smart_router(state: AdaptiveRAGState) -> dict:\n    \"\"\"Classify the query into no_retrieval, single_step, or multi_hop.\"\"\"\n    logger.info(\"--- NODE: smart_router ---\")\n    \n    system_prompt = \"\"\"You are a smart router for a RAG pipeline.\nYour goal is to classify a user query into one of three routes based on its complexity:\n\n1. `no_retrieval`: Simple factual questions or greetings that can be answered from your internal knowledge.\n   Example: \"What is the capital of France?\", \"Hi\", \"Define GDP\".\n2. `single_step`: Questions requiring a simple document lookup but not complex relational reasoning.\n   Example: \"What does the Frolov report say about AI?\", \"Who is the CEO of Company X?\".\n3. `multi_hop`: Questions requiring cross-document reasoning, entity relationships, or causal chains.\n   Example: \"How would a recession in sector X affect portfolio Y based on the filings?\".\n\nRespond ONLY with a JSON object: {\"route\": \"no_retrieval\" | \"single_step\" | \"multi_hop\", \"explanation\": \"Brief reasoning\"}\"\"\"\n\n    messages = [\n        {\"role\": \"system\", \"content\": system_prompt},\n        {\"role\": \"user\", \"content\": state[\"query\"]}\n    ]\n    \n    # Pre-initialise so the except block can't raise UnboundLocalError when\n    # call_model itself fails (e.g. the resolved provider is down / 500s). A\n    # dead LLM must degrade to single_step retrieval, not crash the pipeline.\n    response = \"\"\n    route = \"single_step\"\n    explanation = \"Defaulted to single_step\"\n    try:\n        response = await call_model(model=state[\"model\"], messages=messages, temperature=0.0)\n        # Handle cases where response might be wrapped in ```json ... ```\n        clean_response = (response or \"\").strip()\n        if clean_response.startswith(\"```json\"):\n            clean_response = clean_response[7:-3].strip()\n        elif clean_response.startswith(\"```\"):\n            clean_response = clean_response[3:-3].strip()\n\n        parsed = json.loads(clean_response)\n        route = parsed.get(\"route\", \"single_step\")\n        explanation = parsed.get(\"explanation\", \"\")\n    except Exception as e:\n        logger.warning(f\"Router fell back to single_step ({e}). Raw: {response!r}\")\n        explanation = f\"Defaulted to single_step (router LLM unavailable: {e})\"\n\n    return {\n        \"route\": route, \n        \"route_explanation\": explanation, \n        \"execution_trace\": state.get(\"execution_trace\", []) + [\"smart_router\"]\n    }\n\n\nasync def retrieve_single_step(state: AdaptiveRAGState) -> dict:\n    \"\"\"Retrieve documents from ChromaDB.\"\"\"\n    logger.info(\"--- NODE: retrieve_single_step ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    workspace = state[\"workspace\"]\n    \n    try:\n        client = get_chromadb_client(workspace)\n        collection = get_knowledge_collection(client)\n        \n        results = collection.query(\n            query_texts=[query],\n            n_results=10\n        )\n        \n        documents = []\n        if results and results[\"documents\"] and results[\"documents\"][0]:\n            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n                documents.append({\n                    \"content\": doc,\n                    \"source\": meta.get(\"source\", \"Unknown\"),\n                    \"relevance_score\": 0.0\n                })\n        \n        return {\n            \"documents\": documents,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n        }\n    except Exception as e:\n        logger.error(f\"Retrieval failed: {e}\")\n        return {\n            \"documents\": [],\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n        }\n\n\nasync def retrieve_multi_hop(state: AdaptiveRAGState) -> dict:\n    \"\"\"Retrieve from ChromaDB and perform multi-hop graph traversal.\"\"\"\n    logger.info(\"--- NODE: retrieve_multi_hop ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    workspace = state[\"workspace\"]\n    \n    # 1. ChromaDB Retrieval\n    chroma_docs = []\n    try:\n        client = get_chromadb_client(workspace)\n        collection = get_knowledge_collection(client)\n        results = collection.query(query_texts=[query], n_results=10)\n        if results and results[\"documents\"] and results[\"documents\"][0]:\n            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n                chroma_docs.append({\n                    \"content\": doc,\n                    \"source\": meta.get(\"source\", \"Unknown\"),\n                    \"relevance_score\": 0.0\n                })\n    except Exception as e:\n        logger.error(f\"ChromaDB retrieval failed in multi-hop: {e}\")\n\n    # 2. Neo4j Multi-Hop Traversal\n    graph_docs = multi_hop_traversal(query, workspace=workspace)\n    formatted_graph_docs = []\n    for gdoc in graph_docs:\n        formatted_graph_docs.append({\n            \"content\": gdoc[\"content\"],\n            \"source\": gdoc[\"source\"],\n            \"relevance_score\": 0.0\n        })\n\n    # Merge and deduplicate (by source/content simplified)\n    merged = chroma_docs + formatted_graph_docs\n    seen = set()\n    deduped = []\n    for d in merged:\n        if d[\"content\"] not in seen:\n            deduped.append(d)\n            seen.add(d[\"content\"])\n\n    return {\n        \"documents\": deduped,\n        \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_multi_hop\"]\n    }\n\n\n# Cap how many candidate docs we grade in one shot. Each extra excerpt costs\n# prompt tokens, and local NPU context windows are small; 6 keeps the single\n# grading call well inside a ~2k-token budget while still covering the top hits.\n_MAX_GRADE_DOCS = 6\n\n\nasync def grade_documents(state: AdaptiveRAGState) -> dict:\n    \"\"\"Grade retrieved docs for relevance in a SINGLE batched LLM call.\n\n    The original implementation issued one call per document (up to 10). On a\n    local NPU that degrades under sustained load that would stall or time out,\n    and because zero graded docs triggers a query rewrite it would then spiral\n    into re-retrieval + re-grading. We instead grade all candidates in one call\n    and, if the grader returns nothing usable, fall back to the top retrieved\n    docs so generation always has real context to answer/validate against.\n    \"\"\"\n    logger.info(\"--- NODE: grade_documents ---\")\n\n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    documents = state[\"documents\"][:_MAX_GRADE_DOCS]\n\n    if not documents:\n        return {\n            \"graded_documents\": [],\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"grade_documents\"],\n        }\n\n    listing = \"\\n\\n\".join(f\"[{i}] {d['content'][:600]}\" for i, d in enumerate(documents))\n    system_prompt = (\n        \"You are a relevance grader. Given a question and a numbered list of \"\n        \"document excerpts, return the indices of the excerpts that help answer \"\n        \"the question. Respond ONLY with a JSON array of integers, e.g. [0,2]. \"\n        \"If none are relevant, return [].\"\n    )\n    user_prompt = f\"QUESTION: {query}\\n\\nEXCERPTS:\\n{listing}\"\n\n    graded_documents = []\n    try:\n        response = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt},\n        ], temperature=0.0)\n\n        import re as _re\n        match = _re.search(r\"\\[[\\d,\\s]*\\]\", response or \"\")\n        if match:\n            for i in json.loads(match.group(0)):\n                if isinstance(i, int) and 0 <= i < len(documents):\n                    documents[i][\"relevance_score\"] = 1.0\n                    graded_documents.append(documents[i])\n    except Exception as e:\n        logger.warning(f\"Batched grading failed ({e}); falling back to top retrieved docs.\")\n\n    # Anti-spiral fallback: never hand generation an empty context when we DID\n    # retrieve documents. Keep the top 3 so the model can answer/validate\n    # instead of looping back into a rewrite (which multiplies local LLM calls).\n    if not graded_documents and documents:\n        for doc in documents[:3]:\n            doc[\"relevance_score\"] = 0.5\n            graded_documents.append(doc)\n\n    return {\n        \"graded_documents\": graded_documents,\n        \"execution_trace\": state.get(\"execution_trace\", []) + [\"grade_documents\"]\n    }\n\n\nasync def generate_answer(state: AdaptiveRAGState) -> dict:\n    \"\"\"Generate the answer based on context or parametric knowledge.\"\"\"\n    logger.info(\"--- NODE: generate_answer ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    route = state[\"route\"]\n    graded_docs = state[\"graded_documents\"]\n    \n    if route == \"no_retrieval\":\n        system_prompt = \"You are a helpful research assistant. Answer the question accurately based on your knowledge.\"\n        context_str = \"No external context used.\"\n    else:\n        system_prompt = \"\"\"You are a helpful research assistant. Answer the question based STRICTLY on the provided context. \nIf the context doesn't contain the answer, say so explicitly.\"\"\"\n        context_str = \"\\n\".join([f\"[Source: {d['source']}]\\n{d['content']}\" for d in graded_docs])\n\n    user_prompt = f\"CONTEXT:\\n{context_str}\\n\\nQUESTION: {query}\"\n    \n    try:\n        generation = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt}\n        ])\n        \n        return {\n            \"generation\": generation,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n        }\n    except Exception as e:\n        logger.error(f\"Generation failed: {e}\")\n        return {\n            \"generation\": f\"Error generating answer: {str(e)}\",\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n        }\n\n\nasync def check_hallucination(state: AdaptiveRAGState) -> dict:\n    \"\"\"Check if the answer is grounded in the documents.\"\"\"\n    logger.info(\"--- NODE: check_hallucination ---\")\n    \n    if state[\"route\"] == \"no_retrieval\":\n        return {\"hallucination_check\": True, \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]}\n    \n    graded_docs = state[\"graded_documents\"]\n    generation = state[\"generation\"]\n    \n    context_str = \"\\n\".join([d['content'] for d in graded_docs])\n    \n    system_prompt = \"\"\"You are a hallucination grader. evaluate if the generated answer is fully grounded in the provided facts.\nRespond with ONLY 'yes' if it is grounded, or 'no' if it contains hallucinations or unverified info.\"\"\"\n    \n    user_prompt = f\"FACTS:\\n{context_str}\\n\\nANSWER:\\n{generation}\"\n    \n    try:\n        response = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt}\n        ], temperature=0.0)\n        \n        is_grounded = \"yes\" in response.lower()\n        return {\n            \"hallucination_check\": is_grounded,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]\n        }\n    except Exception as e:\n        logger.warning(f\"Hallucination check failed: {e}\")\n        return {\"hallucination_check\": True} # Default to true on error to avoid loops\n\n\nasync def check_answer_quality(state: AdaptiveRAGState) -> dict:\n    \"\"\"Check if the answer addresses the user query.\"\"\"\n    logger.info(\"--- NODE: check_answer_quality ---\")\n    \n    query = state[\"query\"]\n    generation = state[\"generation\"]\n    \n    system_prompt = \"\"\"You are a quality grader. Does the following answer adequately address the original question? Is it complete and useful? \nRespond with ONLY 'yes' or 'no'.\"\"\"\n    \n    user_prompt = f\"QUESTION: {query}\\n\\nANSWER: {generation}\"\n    \n    try:\n        response = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt}\n        ], temperature=0.0)\n        \n        is_adequate = \"yes\" in response.lower()\n        return {\n            \"answer_quality\": is_adequate,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_answer_quality\"]\n        }\n    except Exception as e:\n        logger.warning(f\"Quality check failed: {e}\")\n        return {\"answer_quality\": True}\n\n\nasync def rewrite_query(state: AdaptiveRAGState) -> dict:\n    \"\"\"Rewrite the query for better retrieval.\"\"\"\n    logger.info(\"--- NODE: rewrite_query ---\")\n    \n    query = state[\"query\"]\n    \n    system_prompt = \"\"\"The following question did not produce a satisfactory answer. \nRewrite it to be more specific and searchable for a vector database. \nReturn ONLY the rewritten question, nothing else.\"\"\"\n    \n    try:\n        new_query = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": query}\n        ])\n        \n        return {\n            \"rewritten_query\": new_query.strip(),\n            \"retry_count\": state[\"retry_count\"] + 1,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n        }\n    except Exception as e:\n        logger.warning(f\"Query rewrite failed: {e}\")\n        return {\n            \"retry_count\": state[\"retry_count\"] + 1,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n        }\n\n\n# =============================================================================\n# ROUTING FUNCTIONS\n# =============================================================================\n\ndef route_query(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"retrieve_single_step\", \"retrieve_multi_hop\"]:\n    \"\"\"Route after smart_router based on the classified route.\"\"\"\n    route = state.get(\"route\", \"single_step\")\n    if route == \"no_retrieval\":\n        return \"generate_answer\"\n    elif route == \"multi_hop\":\n        return \"retrieve_multi_hop\"\n    else:\n        return \"retrieve_single_step\"\n\ndef after_grading(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"rewrite_query\"]:\n    \"\"\"After grading, decide: generate or rewrite.\"\"\"\n    graded = state.get(\"graded_documents\", [])\n    if len(graded) == 0 and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n        return \"rewrite_query\"\n    return \"generate_answer\"\n\ndef after_hallucination_check(state: AdaptiveRAGState) -> Literal[\"check_answer_quality\", \"rewrite_query\"]:\n    \"\"\"After hallucination check: if hallucinated and retries left, rewrite.\"\"\"\n    if not state.get(\"hallucination_check\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n        return \"rewrite_query\"\n    return \"check_answer_quality\"\n\ndef after_answer_quality(state: AdaptiveRAGState) -> Literal[\"__end__\", \"rewrite_query\"]:\n    \"\"\"After answer quality check: if poor and retries left, rewrite.\"\"\"\n    if not state.get(\"answer_quality\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n        return \"rewrite_query\"\n    return \"__end__\"\n\ndef after_rewrite(state: AdaptiveRAGState) -> Literal[\"retrieve_single_step\", \"retrieve_multi_hop\"]:\n    \"\"\"After rewrite, go back to retrieval using the original route.\"\"\"\n    route = state.get(\"route\", \"single_step\")\n    if route == \"multi_hop\":\n        return \"retrieve_multi_hop\"\n    return \"retrieve_single_step\"\n\n\n# =============================================================================\n# GRAPH CONSTRUCTION\n# =============================================================================\n\ndef build_adaptive_rag_graph(self_check: bool = False) -> StateGraph:\n    \"\"\"Build the Adaptive RAG LangGraph.\n\n    self_check=False (default) builds the LEAN pipeline:\n        router → retrieve → grade → generate → END   (3 LLM calls)\n    This is what works on a single local model in one synchronous request.\n    The full self-correcting variant (post-generation hallucination + answer-\n    quality grading with query-rewrite loops) adds 3+ more sequential calls and\n    can loop several times — fine for fast cloud models, but on a local 12B\n    reasoning model it runs for minutes and the caller's connection drops\n    (\"fetch failed\"). Enable it explicitly (self_check=True + max_retries>0)\n    only when the backing model is fast enough.\n    \"\"\"\n    graph = StateGraph(AdaptiveRAGState)\n\n    graph.add_node(\"smart_router\", smart_router)\n    graph.add_node(\"retrieve_single_step\", retrieve_single_step)\n    graph.add_node(\"retrieve_multi_hop\", retrieve_multi_hop)\n    graph.add_node(\"grade_documents\", grade_documents)\n    graph.add_node(\"generate_answer\", generate_answer)\n    graph.add_node(\"rewrite_query\", rewrite_query)\n\n    graph.add_edge(START, \"smart_router\")\n    graph.add_conditional_edges(\"smart_router\", route_query, {\n        \"generate_answer\": \"generate_answer\",\n        \"retrieve_single_step\": \"retrieve_single_step\",\n        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n    })\n    graph.add_edge(\"retrieve_single_step\", \"grade_documents\")\n    graph.add_edge(\"retrieve_multi_hop\", \"grade_documents\")\n    graph.add_conditional_edges(\"grade_documents\", after_grading, {\n        \"generate_answer\": \"generate_answer\",\n        \"rewrite_query\": \"rewrite_query\",\n    })\n    graph.add_conditional_edges(\"rewrite_query\", after_rewrite, {\n        \"retrieve_single_step\": \"retrieve_single_step\",\n        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n    })\n\n    if self_check:\n        graph.add_node(\"check_hallucination\", check_hallucination)\n        graph.add_node(\"check_answer_quality\", check_answer_quality)\n        graph.add_conditional_edges(\"generate_answer\", lambda s: \"check_answer_quality\" if s[\"route\"] == \"no_retrieval\" else \"check_hallucination\", {\n            \"check_hallucination\": \"check_hallucination\",\n            \"check_answer_quality\": \"check_answer_quality\",\n        })\n        graph.add_conditional_edges(\"check_hallucination\", after_hallucination_check, {\n            \"check_answer_quality\": \"check_answer_quality\",\n            \"rewrite_query\": \"rewrite_query\",\n        })\n        graph.add_conditional_edges(\"check_answer_quality\", after_answer_quality, {\n            \"__end__\": END,\n            \"rewrite_query\": \"rewrite_query\",\n        })\n    else:\n        # Lean: stop after a grounded answer — no extra LLM round-trips.\n        graph.add_edge(\"generate_answer\", END)\n\n    return graph.compile()\n\n\nasync def run_adaptive_rag(\n    query: str,\n    workspace: str = \"default\",\n    model: Optional[str] = None,\n    max_retries: int = 0,\n    self_check: bool = False,\n) -> AdaptiveRAGState:\n    \"\"\"Execute the Adaptive RAG pipeline (lean by default; see build graph).\"\"\"\n    # Honour local-first routing: when the caller doesn't pin a model, resolve\n    # the workspace's configured chat model (Agents screen / manifest) instead\n    # of a hardcoded default that may not be loaded on this machine.\n    if not model:\n        try:\n            from ..core.models import get_active_model\n            model = await get_active_model(workspace, role=\"chat\")\n        except Exception:\n            model = \"fastflowlm/default\"\n\n    graph = build_adaptive_rag_graph(self_check=self_check)\n\n    initial_state: AdaptiveRAGState = {\n        \"query\": query,\n        \"workspace\": workspace,\n        \"model\": model,\n        \"route\": \"single_step\",  # Will be overwritten by smart_router\n        \"documents\": [],\n        \"graded_documents\": [],\n        \"generation\": None,\n        \"hallucination_check\": None,\n        \"answer_quality\": None,\n        \"rewritten_query\": None,\n        \"retry_count\": 0,\n        \"max_retries\": max_retries,\n        \"route_explanation\": \"\",\n        \"execution_trace\": [],\n    }\n    \n    result = await graph.ainvoke(initial_state)\n    return result\n","numLines":544,"startLine":1,"totalLines":544}},"sourceToolAssistantUUID":"16c53cab-9344-43e8-a6b4-d477f55bea71","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"bb53ca51-9ebf-41e0-95b4-e8f5498f0c7a","version":"2.1.181","gitBranch":"HEAD"}
