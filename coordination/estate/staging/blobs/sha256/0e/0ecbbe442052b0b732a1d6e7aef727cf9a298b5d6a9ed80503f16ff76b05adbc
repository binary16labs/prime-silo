{"parentUuid":"e495bc9b-2cf7-496e-be46-54390da23c7c","isSidechain":false,"promptId":"7d7195a5-bb3c-4418-bcd9-8e8abbb36b18","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LnTSeHNcbriXobzQfJa6dX","type":"tool_result","content":"1\t\"\"\"\n2\tRAG Routes - Document ingestion and semantic search\n3\t\"\"\"\n4\t\n5\tfrom fastapi import APIRouter, HTTPException\n6\tfrom pydantic import BaseModel\n7\tfrom typing import Optional, List, AsyncGenerator\n8\tfrom fastapi.responses import StreamingResponse\n9\tfrom ..core.event_bus import event_bus\n10\tfrom pathlib import Path\n11\timport fitz  # PyMuPDF\n12\timport httpx\n13\t\n14\tfrom ..core.workspace import get_workspace_path\n15\tfrom ..core.extraction import extract_structured_text\n16\tfrom ..tools.knowledge import get_chromadb_client, get_knowledge_collection, heal_collection_dimension\n17\tfrom ..core.models import LOCAL_PROVIDERS, get_active_model\n18\tfrom ..core.task_manager import task_manager\n19\tfrom ..governance.lineage import track_workflow_start, track_workflow_complete, track_aer, track_workflow_fail, track_llm_call\n20\tfrom ..governance.permission_manifest import register_manifest, create_ephemeral_manifest\n21\timport uuid\n22\timport json\n23\timport logging\n24\tfrom datetime import datetime\n25\t\n26\tlogger = logging.getLogger(__name__)\n27\t\n28\trouter = APIRouter()\n29\t\n30\t\n31\tclass IngestRequest(BaseModel):\n32\t    workspace: str = \"default\"\n33\t    files: Optional[List[str]] = None\n34\t    notebook_id: Optional[str] = None\n35\t    batch_size: Optional[int] = 500\n36\t    run_id: Optional[str] = None # Optional existing run/nexus ID\n37\t    deep_synthesis: bool = False # Whether to extract triples and run clustering\n38\t    strategy: str = \"safe\" # Heuristic layer: 'safe' or 'aggressive'\n39\t    correlation_threshold: float = 0.82 # Similarity threshold for aggressive mode (raised from 0.70 — the 0.70 knee produced ~36× noise-tail edges)\n40\t    correlation_top_k: int = 32          # Max symbol matches per concept; caps edge fan-out\n41\t    correlation_use_ann: bool = True     # Use HNSW ANN index when hnswlib is installed; falls back to numpy top-K\n42\t    force_reingest: bool = False # Whether to force re-processing even if already in DB\n43\t    model: Optional[str] = None # Optional model override for synthesis\n44\t\n45\t\n46\t\n47\t\n48\tclass QueryRequest(BaseModel):\n49\t    query: str\n50\t    workspace: str = \"default\"\n51\t    top_k: int = 5\n52\t    selected_sources: Optional[List[str]] = None\n53\t    provider: Optional[str] = None\n54\t    model: Optional[str] = None\n55\t    mode: str = \"semantic\" # \"semantic\", \"graph_agent\", or \"discovery_swarm\"\n56\t    active_nexus_id: Optional[str] = None # For grounding graph agents\n57\t    run_id: Optional[str] = None\n58\t\n59\tclass AdaptiveRAGRequest(BaseModel):\n60\t    query: str\n61\t    workspace: str = \"default\"\n62\t    model: str = \"Qwen3-8B-Hybrid\"\n63\t    max_retries: int = 3\n64\t\n65\tclass AdaptiveRAGResponse(BaseModel):\n66\t    answer: Optional[str]\n67\t    route: str\n68\t    route_explanation: str\n69\t    documents_retrieved: int\n70\t    documents_relevant: int\n71\t    retry_count: int\n72\t    execution_trace: List[str]\n73\t    hallucination_check: Optional[bool]\n74\t    answer_quality: Optional[bool]\n75\t\n76\t@router.post(\"/rag/ingest\")\n77\tasync def ingest_files(request: IngestRequest):\n78\t    \"\"\"Ingest files from data_in into ChromaDB using structured extraction (Docling).\"\"\"\n79\t    run_id = request.run_id or str(uuid.uuid4())\n80\t    task = task_manager.create_task(request.workspace, \"rag_ingest\", task_id=run_id)\n81\t    \n82\t    try:\n83\t        track_workflow_start(run_id, \"rag_ingest\", request.workspace, inputs=request.files or [])\n84\t        task_manager.add_aer_entry(\n85\t            run_id, \n86\t            intent=f\"Ingesting {len(request.files) if request.files else 'all'} files from data_in\",\n87\t            observation=\"Initialization complete\",\n88\t            plan=f\"1. Extract text via Docling 2. Chunk 3. Batch upsert to ChromaDB\"\n89\t        )\n90\t    except Exception as e:\n91\t        logger.warning(\"Lineage tracking failed (init): %s\", e)\n92\t\n93\t    try:\n94\t        data_in_path = get_workspace_path(request.workspace, \"data_in\")\n95\t        if not data_in_path.exists():\n96\t            task_manager.update_task(run_id, status=\"failed\", message=\"No files found in data_in\")\n97\t            raise HTTPException(404, \"No files found in data_in\")\n98\t        \n99\t        # Get files to ingest\n100\t        if request.files:\n101\t            file_paths = [data_in_path / f for f in request.files]\n102\t        else:\n103\t            file_paths = list(data_in_path.glob(\"*.*\"))\n104\t        \n105\t        # Filter for supported types\n106\t        supported = ['.txt', '.md', '.pdf', '.docx', '.pptx', '.html']\n107\t        file_paths = [f for f in file_paths if f.suffix.lower() in supported]\n108\t        \n109\t        logger.info(f\"Ingestion started for {len(file_paths)} files in {data_in_path}\")\n110\t        \n111\t        if not file_paths:\n112\t            task_manager.update_task(run_id, status=\"failed\", message=\"No supported files found\")\n113\t            raise HTTPException(404, \"No supported files found\")\n114\t\n115\t        # Preflight: the knowledge collection embeds via the local HTTP provider\n116\t        # (LocalEmbeddingFunction → LM Studio / Lemonade / Ollama). If that\n117\t        # provider is down, every upsert silently stores zero-vectors (see\n118\t        # core/embeddings.py) and search returns garbage. Probe once and fail\n119\t        # fast with an actionable message instead of a hollow success.\n120\t        from ..core.embeddings import get_embedding_sync\n121\t        try:\n122\t            probe_vec = get_embedding_sync(\"ping\")\n123\t        except Exception as probe_e:\n124\t            probe_vec = []\n125\t            logger.warning(\"Embedding preflight raised: %s\", probe_e)\n126\t        if not any(probe_vec):\n127\t            msg = (\n128\t                \"Embedding provider unreachable — no documents were indexed. \"\n129\t                \"Start a local embedding server (LM Studio / Lemonade / Ollama) \"\n130\t                \"and retry.\"\n131\t            )\n132\t            task_manager.update_task(run_id, status=\"failed\", message=msg)\n133\t            try:\n134\t                track_workflow_fail(run_id, \"rag_ingest\", request.workspace, msg)\n135\t            except Exception:\n136\t                pass\n137\t            raise HTTPException(503, msg)\n138\t\n139\t        # Get ChromaDB client\n140\t        client = get_chromadb_client(request.workspace)\n141\t        collection_name = f\"notebook_{request.notebook_id}\" if request.notebook_id else \"knowledge\"\n142\t        collection = get_knowledge_collection(client, collection_name)\n143\t        # Self-heal a stale collection left by the pre-fix 384-dim default embedder\n144\t        # so the zero-install exe needs no manual chromadb cleanup.\n145\t        collection = heal_collection_dimension(client, collection, collection_name, probe_vec)\n146\t\n147\t        # Update task total steps\n148\t        task_manager.update_task(run_id, total_steps=len(file_paths), progress=10)\n149\t        \n150\t        ingested = []\n151\t        for idx, file_path in enumerate(file_paths):\n152\t            try:\n153\t                msg = f\"Processing {file_path.name} ({idx+1}/{len(file_paths)})...\"\n154\t                logger.info(msg)\n155\t                task_manager.update_task(\n156\t                    run_id, \n157\t                    message=msg, \n158\t                    current_step=idx+1,\n159\t                    metadata={\n160\t                        \"stage\": \"EXTRACTING\",\n161\t                        \"current_file\": file_path.name\n162\t                    }\n163\t                )\n164\t                \n165\t                # Emit AER for extraction\n166\t                try:\n167\t                    track_aer(run_id, \"rag_ingest\", request.workspace, f\"Extracting {file_path.name}\", \"Docling engine started\")\n168\t                except Exception:\n169\t                    pass\n170\t                text = extract_structured_text(file_path)\n171\t                print(f\"DEBUG: Extracted {len(text)} chars from {file_path.name}. Preview: {text[:100]}...\")\n172\t                \n173\t                # Better chunking (split by paragraphs, then size limit)\n174\t                raw_chunks = [c.strip() for c in text.split('\\n\\n') if c.strip()]\n175\t                if not raw_chunks and text.strip():\n176\t                    raw_chunks = [text.strip()]\n177\t                \n178\t                chunks = []\n179\t                max_chunk_chars = 4000\n180\t                for rc in raw_chunks:\n181\t                    if len(rc) > max_chunk_chars:\n182\t                        for i in range(0, len(rc), max_chunk_chars):\n183\t                            chunks.append(rc[i:i+max_chunk_chars])\n184\t                    else:\n185\t                        chunks.append(rc)\n186\t                \n187\t                index_error = None\n188\t                if chunks:\n189\t                    try:\n190\t                        task_manager.update_task(run_id, metadata={\"stage\": \"INDEXING\", \"current_file\": file_path.name, \"chunks\": len(chunks)})\n191\t\n192\t                        # 1. DELETE old entries for this source to ensure fresh start\n193\t                        logger.info(f\"Clearing old vectors for {file_path.name} to ensure fresh ingestion.\")\n194\t                        collection.delete(where={\"source\": file_path.name})\n195\t\n196\t                        # 2. UPLOAD in batches\n197\t                        batch_size = request.batch_size or 500\n198\t                        for i in range(0, len(chunks), batch_size):\n199\t                            batch_chunks = chunks[i:i + batch_size]\n200\t                            batch_ids = [f\"{file_path.stem}_{run_id[-4:]}_{j}\" for j in range(i, i + len(batch_chunks))]\n201\t                            batch_metadatas = [\n202\t                                {\"source\": file_path.name, \"chunk_index\": j, \"run_id\": run_id}\n203\t                                for j in range(i, i + len(batch_chunks))\n204\t                            ]\n205\t                            collection.add(documents=batch_chunks, metadatas=batch_metadatas, ids=batch_ids)\n206\t                    except Exception as index_e:\n207\t                        # An indexing failure means the file produced NO retrievable\n208\t                        # vectors — surface it instead of reporting clean success.\n209\t                        # Most common cause: the embedding provider (LM Studio /\n210\t                        # Lemonade / Ollama) is down, so LocalEmbeddingFunction\n211\t                        # returns zero-vectors or Chroma raises.\n212\t                        index_error = str(index_e)\n213\t                        logger.error(f\"Vector Indexing error for {file_path.name}: {index_e}\")\n214\t                        task_manager.add_aer_entry(run_id, \"Error\", f\"Indexing Failed {file_path.name}: {index_error}\")\n215\t                        # Do not abort the loop, let it continue to deep synthesis\n216\t                \n217\t                # 3. DEEP SYNTHESIS (Optional)\n218\t                if request.deep_synthesis:\n219\t                    try:\n220\t                        from ..synthesis.engine import parallel_extract_triples\n221\t                        from ..graph.triples import save_knowledge_triples\n222\t                        \n223\t                        track_aer(run_id, \"rag_ingest\", request.workspace, f\"Deep Synthesis for {file_path.name}\", \"Extracting triples via LLM Engine\")\n224\t                        task_manager.update_task(run_id, metadata={\"stage\": \"SYNTHESIZING\", \"current_file\": file_path.name})\n225\t                        \n226\t                        print(f\"DEBUG: STARTING Triple Extraction for {file_path.name}...\")\n227\t                        \n228\t                        # Prepare NPU-friendly chunks for synthesis (limit to 10 sections to prevent runaway extraction)\n229\t                        synth_chunks = chunks[:10] \n230\t                        sections = [{\"title\": f\"{file_path.name} Part {i+1}\", \"text\": c} for i, c in enumerate(synth_chunks) if len(c) > 100]\n231\t                        \n232\t                        triples = await parallel_extract_triples(\n233\t                            sections=sections,\n234\t                            run_id=run_id, \n235\t                            workspace=request.workspace,\n236\t                            strategy=request.strategy,\n237\t                            model=request.model,\n238\t                            timeout=300.0,\n239\t                            parallel_limit=2\n240\t\n241\t                        )\n242\t                        print(f\"DEBUG: FINISHED Triple Extraction for {file_path.name}: Found {len(triples)} triples\")\n243\t                        \n244\t                        if triples:\n245\t                            await save_knowledge_triples(request.workspace, triples, file_path.name)\n246\t                            track_aer(run_id, \"rag_ingest\", request.workspace, f\"Synthesis complete for {file_path.name}\", f\"Extracted {len(triples)} triples\")\n247\t                            \n248\t                            # 3b. Generate Librarian Wiki Article (Karpathy-style)\n249\t                            try:\n250\t                                from ..synthesis.engine import save_concept_article\n251\t                                # Use the first few triples to identify the primary concept or use the filename\n252\t                                primary_concept = file_path.stem\n253\t                                summary_prompt = f\"Summarize the core concepts of this document section in 3-4 sentences for a technical wiki:\\n\\n{text[:2000]}\"\n254\t                                from ..synthesis.engine import call_llm\n255\t                                summary = await call_llm(summary_prompt, run_id=run_id, workspace=request.workspace)\n256\t                                \n257\t                                wiki_file = await save_concept_article(\n258\t                                    workspace=request.workspace,\n259\t                                    concept_name=primary_concept,\n260\t                                    summary=summary,\n261\t                                    relationships=[t.model_dump() for t in triples[:10]],\n262\t                                    source_files=[file_path.name]\n263\t                                )\n264\t                                track_aer(run_id, \"rag_ingest\", request.workspace, f\"Wiki Generated\", f\"Saved Rationale Hub to {primary_concept}.md\")\n265\t                            except Exception as wiki_e:\n266\t                                logger.error(f\"Wiki generation error: {wiki_e}\")\n267\t                    except Exception as synth_e:\n268\t                        logger.error(f\"Deep Synthesis error: {synth_e}\")\n269\t                        track_aer(run_id, \"rag_ingest\", request.workspace, f\"Synthesis failed for {file_path.name}\", str(synth_e))\n270\t\n271\t                file_result = {\"file\": file_path.name, \"chunks\": len(chunks)}\n272\t                if index_error:\n273\t                    # Chunks were produced but none were stored — report the failure\n274\t                    # so the caller doesn't treat an empty index as a success.\n275\t                    file_result[\"indexed\"] = False\n276\t                    file_result[\"error\"] = index_error\n277\t                else:\n278\t                    file_result[\"indexed\"] = bool(chunks)\n279\t                ingested.append(file_result)\n280\t                task_manager.update_task(run_id, progress=10 + int(80 * (idx+1) / len(file_paths)))\n281\t                \n282\t            except Exception as e:\n283\t                task_manager.add_aer_entry(run_id, \"Error\", f\"Failed {file_path.name}: {str(e)}\")\n284\t                ingested.append({\"file\": file_path.name, \"error\": str(e)})\n285\t        \n286\t        # 4. FINAL CLUSTERING & CORRELATION (if deep synthesis enabled)\n287\t        if request.deep_synthesis:\n288\t            try:\n289\t                from ..graph.clustering_service import ClusteringService\n290\t                from ..synthesis.correlation import run_full_correlation_suite\n291\t                \n292\t                track_aer(run_id, \"rag_ingest\", request.workspace, \"Running Topological Clustering\", \"Community detection started (LPA)\")\n293\t                task_manager.update_task(run_id, metadata={\"stage\": \"CLUSTERING\"})\n294\t                cluster_results = await ClusteringService.run_lpa_on_workspace(request.workspace)\n295\t                \n296\t                track_aer(run_id, \"rag_ingest\", request.workspace, \"Running Knowledge-to-Code Correlation\", \"Cross-linking Concepts and Symbols\")\n297\t                task_manager.update_task(run_id, metadata={\"stage\": \"CORRELATING\"})\n298\t                correlation_results = await run_full_correlation_suite(\n299\t                    request.workspace,\n300\t                    threshold=request.correlation_threshold,\n301\t                    top_k_per_concept=request.correlation_top_k,\n302\t                    use_ann=request.correlation_use_ann,\n303\t                )\n304\t                \n305\t                track_aer(run_id, \"rag_ingest\", request.workspace, \"Deep Processing complete\", \n306\t                          f\"Clusters: {cluster_results.get('communities_found', 0)}, \" \n307\t                          f\"Safe Links: {correlation_results.get('safe_links', 0)}, \"\n308\t                          f\"Aggressive Links: {correlation_results.get('aggressive_links', 0)}\")\n309\t            except Exception as post_e:\n310\t                logger.error(f\"Post-processing error: {post_e}\")\n311\t \n312\t\n313\t        # Honest status: a file \"indexed\" only if its vectors were actually\n314\t        # stored. If every file failed to index, this run did nothing useful —\n315\t        # report it as failed so the UI surfaces it instead of a green tick.\n316\t        succeeded = [f for f in ingested if f.get(\"indexed\")]\n317\t        failed = [f for f in ingested if f.get(\"error\")]\n318\t        if succeeded:\n319\t            final_status = \"completed\" if not failed else \"completed_with_errors\"\n320\t            final_msg = (\n321\t                \"Ingestion finished successfully\" if not failed\n322\t                else f\"Ingested {len(succeeded)} file(s); {len(failed)} failed to index.\"\n323\t            )\n324\t        else:\n325\t            final_status = \"failed\"\n326\t            hint = failed[0][\"error\"] if failed else \"no chunks were produced\"\n327\t            final_msg = (\n328\t                f\"No documents were indexed ({hint}). \"\n329\t                \"If the error mentions embeddings/connection, start your local \"\n330\t                \"embedding provider (LM Studio / Lemonade / Ollama) and retry.\"\n331\t            )\n332\t\n333\t        task_manager.update_task(run_id, status=final_status, progress=100, message=final_msg)\n334\t        try:\n335\t            if final_status == \"failed\":\n336\t                track_workflow_fail(run_id, \"rag_ingest\", request.workspace, final_msg)\n337\t            else:\n338\t                track_workflow_complete(\n339\t                    run_id,\n340\t                    \"rag_ingest\",\n341\t                    request.workspace,\n342\t                    [\"extraction\", \"chunking\", \"upsert\"],\n343\t                    0,\n344\t                    outputs=[f\"chromadb:{collection_name}\"]\n345\t                )\n346\t        except Exception:\n347\t            pass\n348\t\n349\t        return {\n350\t            \"status\": final_status,\n351\t            \"message\": final_msg,\n352\t            \"run_id\": run_id,\n353\t            \"workspace\": request.workspace,\n354\t            \"ingested\": ingested,\n355\t            \"indexed_files\": len(succeeded),\n356\t            \"failed_files\": len(failed),\n357\t            \"total_documents\": collection.count()\n358\t        }\n359\t        \n360\t    except HTTPException:\n361\t        raise\n362\t    except Exception as e:\n363\t        task_manager.update_task(run_id, status=\"failed\", message=str(e))\n364\t        raise HTTPException(500, f\"Ingestion failed: {str(e)}\")\n365\t\n366\t\n367\t@router.get(\"/rag/logs\")\n368\tasync def get_rag_logs(workspace: str = \"default\"):\n369\t    \"\"\"Get the latest ingestion tasks from TaskManager.\"\"\"\n370\t    try:\n371\t        tasks = task_manager.list_tasks(workspace)\n372\t        rag_tasks = [t for t in tasks if t.type == \"rag_ingest\"]\n373\t        if not rag_tasks:\n374\t            return {\"tasks\": []}\n375\t        \n376\t        # Sort by updated_at descending\n377\t        rag_tasks.sort(key=lambda x: x.updated_at, reverse=True)\n378\t        \n379\t        return {\"tasks\": [t.model_dump() for t in rag_tasks[:5]]}\n380\t    except Exception as e:\n381\t        return {\"error\": str(e), \"tasks\": []}\n382\t\n383\t\n384\t@router.get(\"/rag/status\")\n385\tasync def get_rag_status(workspace: str = \"default\"):\n386\t    \"\"\"Get RAG status and document count\"\"\"\n387\t    try:\n388\t        client = get_chromadb_client(workspace)\n389\t        collection = get_knowledge_collection(client)\n390\t        \n391\t        # Get unique sources - optimized by only fetching metadatas\n392\t        all_data = collection.get(include=['metadatas'])\n393\t        sources = set()\n394\t        for meta in all_data['metadatas']:\n395\t            sources.add(meta.get('source', 'Unknown'))\n396\t        \n397\t        return {\n398\t            \"workspace\": workspace,\n399\t            \"total_chunks\": collection.count(),\n400\t            \"unique_documents\": len(sources),\n401\t            \"documents\": list(sources),\n402\t            \"sources\": list(sources) # Alias for consistency with graph API\n403\t        }\n404\t\n405\t    except Exception as e:\n406\t        raise HTTPException(500, f\"Status check failed: {str(e)}\")\n407\t\n408\t\n409\t@router.get(\"/rag/indexing-manifest\")\n410\tasync def get_indexing_manifest(workspace: str = \"default\"):\n411\t    \"\"\"Reconcile workspace files with ChromaDB to find unindexed or changed documents.\"\"\"\n412\t    try:\n413\t        # 1. Get indexed sources\n414\t        client = get_chromadb_client(workspace)\n415\t        collection = get_knowledge_collection(client)\n416\t        all_data = collection.get(include=['metadatas'])\n417\t        \n418\t        indexed_sources = {} # source_name -> {chunk_count, last_indexed}\n419\t        if all_data.get('metadatas'):\n420\t            for meta in all_data['metadatas']:\n421\t                if meta is None: continue\n422\t                src = meta.get('source')\n423\t                if not src: continue\n424\t                if src not in indexed_sources:\n425\t                    indexed_sources[src] = {\"chunks\": 0, \"last_indexed\": meta.get('timestamp')}\n426\t                indexed_sources[src][\"chunks\"] += 1\n427\t\n428\t        # 2. Get disk files (Recursive scan focus on data_in and root)\n429\t        data_in_path = get_workspace_path(workspace, \"data_in\")\n430\t        supported = ['.txt', '.md', '.pdf', '.docx', '.pptx', '.html', '.py', '.ts', '.json', '.sql']\n431\t        \n432\t        manifest = []\n433\t        import os\n434\t        from ..core.workspace import get_workspace_path\n435\t        \n436\t        import os\n437\t        for base_path_obj in [data_in_path]:\n438\t            base_path = str(base_path_obj)\n439\t            if not os.path.exists(base_path):\n440\t                continue\n441\t                \n442\t            for root, dirs, files in os.walk(base_path):\n443\t                # Skip some folders\n444\t                if \"chromadb\" in root or \"__pycache__\" in root or \".git\" in root:\n445\t                    continue\n446\t                \n447\t                for name in files:\n448\t                    file_path = Path(root) / name\n449\t                    ext = file_path.suffix.lower()\n450\t                    if ext not in supported:\n451\t                        continue\n452\t                        \n453\t                    # Use os.path.relpath for Windows resilience (handles c: vs C: issues)\n454\t                    rel_path_str = os.path.relpath(str(file_path), base_path)\n455\t                    source_key = name # We often use just the filename as the source key\n456\t                    \n457\t                    status = \"MISSING\"\n458\t                    chunks = 0\n459\t                    if source_key in indexed_sources:\n460\t                        status = \"ALIGNED\" # Basic check: existence. In future: hash check\n461\t                        chunks = indexed_sources[source_key][\"chunks\"]\n462\t                    \n463\t                    manifest.append({\n464\t                        \"name\": name,\n465\t                        \"path\": rel_path_str.replace(\"\\\\\", \"/\"),\n466\t                        \"status\": status,\n467\t                        \"chunks\": chunks,\n468\t                        \"size\": file_path.stat().st_size,\n469\t                        \"modified\": file_path.stat().st_mtime,\n470\t                        \"type\": ext.lstrip('.')\n471\t                    })\n472\t                    \n473\t        return {\n474\t            \"workspace\": workspace,\n475\t            \"manifest\": manifest,\n476\t            \"total_indexed\": len(indexed_sources)\n477\t        }\n478\t    except Exception as e:\n479\t        raise HTTPException(500, f\"Indexing manifest failed: {str(e)}\")\n480\t\n481\t\n482\t@router.post(\"/rag/query\")\n483\tasync def query_rag(request: QueryRequest):\n484\t    \"\"\"Test semantic search\"\"\"\n485\t    try:\n486\t        client = get_chromadb_client(request.workspace)\n487\t        collection = get_knowledge_collection(client)\n488\t        \n489\t        if collection.count() == 0:\n490\t            return {\n491\t                \"results\": [],\n492\t                \"message\": \"Knowledge base is empty\"\n493\t            }\n494\t        \n495\t        results = collection.query(\n496\t            query_texts=[request.query],\n497\t            n_results=min(request.top_k, collection.count())\n498\t        )\n499\t        \n500\t        formatted_results = []\n501\t        for doc, meta, distance in zip(\n502\t            results['documents'][0],\n503\t            results['metadatas'][0],\n504\t            results['distances'][0]\n505\t        ):\n506\t            formatted_results.append({\n507\t                \"text\": doc,\n508\t                \"source\": meta.get('source', 'Unknown'),\n509\t                \"relevance\": round((1 - distance) * 100, 1)\n510\t            })\n511\t        \n512\t\n513\t        return {\n514\t            \"query\": request.query,\n515\t            \"results\": formatted_results,\n516\t            \"count\": len(formatted_results)\n517\t        }\n518\t        \n519\t    except Exception as e:\n520\t        raise HTTPException(500, f\"Query failed: {str(e)}\")\n521\t@router.post(\"/rag/chat\")\n522\tasync def chat_rag(request: QueryRequest):\n523\t    \"\"\"RAG-augmented chat for workspace documents or Neural Graph Agent\"\"\"\n524\t    # Generate a consistent run_id for lineage tracking\n525\t    run_id = request.run_id or f\"chat-{uuid.uuid4().hex[:8]}\"\n526\t    start_time = datetime.now()\n527\t    \n528\t    # Audit trail: Include configuration details\n529\t    lineage_audit = {\n530\t        \"run_id\": run_id,\n531\t        \"workspace\": request.workspace,\n532\t        \"mode\": request.mode,\n533\t        \"provider\": request.provider,\n534\t        \"model\": request.model,\n535\t        \"top_k\": request.top_k,\n536\t        \"active_nexus_id\": request.active_nexus_id,\n537\t        \"timestamp\": start_time.isoformat()\n538\t    }\n539\t\n540\t    try:\n541\t        # Handle Graph Agent Mode (Linear)\n542\t        if request.mode == \"graph_agent\":\n543\t            # 1. Load the System Workflow Definition\n544\t            from .workflow_routes import workflow_storage\n545\t            from .studio_executor import topological_sort, StudioExecuteRequest\n546\t            \n547\t            wf_def = workflow_storage.get_workflow(\"System_GraphChatAgent\")\n548\t            if not wf_def:\n549\t                 track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, \"System_GraphChatAgent definition missing\")\n550\t                 raise HTTPException(404, \"System_GraphChatAgent workflow definition not found.\")\n551\t\n552\t            # 2. Trigger Workflow Execution\n553\t            # Map workflow definition to request nodes/edges\n554\t            nodes = wf_def.get(\"nodes\", [])\n555\t            edges = wf_def.get(\"edges\", [])\n556\t            \n557\t            # Update the LLM node with the user's specific request and provider/model choice\n558\t            for node in nodes:\n559\t                if node.get(\"type\") == \"llm\":\n560\t                    if \"config\" not in node[\"data\"]: node[\"data\"][\"config\"] = {}\n561\t                    if request.model:\n562\t                        node[\"data\"][\"config\"][\"model\"] = request.model\n563\t            \n564\t            from .studio_executor import StudioNode, StudioEdge\n565\t            pydantic_nodes = [StudioNode(**n) for n in nodes]\n566\t            pydantic_edges = [StudioEdge(**e) for e in edges]\n567\t            \n568\t            # Sort and Run\n569\t            sorted_nodes = topological_sort(pydantic_nodes, pydantic_edges)\n570\t            \n571\t            context = {\n572\t                \"message\": request.query, \n573\t                \"workspace\": request.workspace,\n574\t                \"active_nexus_id\": request.active_nexus_id\n575\t            }\n576\t            \n577\t            # PRE-CHECK: If no nexus is provided for a graph agent, fail fast to trigger UI wizard\n578\t            if not request.active_nexus_id or request.active_nexus_id == \"neural_nexus\":\n579\t                track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, \"nexus_required interruption\")\n580\t                return {\n581\t                    \"answer\": \"\",\n582\t                    \"status\": \"nexus_required\",\n583\t                    \"message\": \"Neural Graph Agent requires a grounded Nexus context selection to proceed. Use the Map or Forge to select an active Nexus.\",\n584\t                    \"run_id\": run_id,\n585\t                    \"lineage_audit\": lineage_audit\n586\t                }\n587\t\n588\t            # Security: Register ephemeral manifest for this specific chat agent run\n589\t            chat_manifest = create_ephemeral_manifest(run_id, [\"query_graph\", \"search_kb\", \"read_file\", \"get_neighbors\", \"search_knowledge_workspace\"])\n590\t            register_manifest(chat_manifest)\n591\t\n592\t            # Initial track\n593\t            track_workflow_start(run_id, \"chat_graph_agent\", request.workspace, inputs=[request.query])\n594\t            task_manager.create_task(request.workspace, \"chat_graph_agent\", task_id=run_id)\n595\t\n596\t            from .studio_executor import execute_trigger_node, execute_llm_node, execute_data_node\n597\t            final_answer = \"\"\n598\t            nodes_executed = 0\n599\t            \n600\t            for node in sorted_nodes:\n601\t                try:\n602\t                    nodes_executed += 1\n603\t                    if node.type == \"trigger\":\n604\t                        output = await execute_trigger_node(node, request.query, context)\n605\t                    elif node.type == \"llm\":\n606\t                        output = await execute_llm_node(node, context, request.workspace, run_id=run_id, agent_id=run_id)\n607\t                        if output.get(\"response\"):\n608\t                            context[\"llm_output\"] = output[\"response\"]\n609\t                            final_answer = output[\"response\"]\n610\t                    elif node.type == \"data\":\n611\t                        output = await execute_data_node(node, context, request.workspace)\n612\t                    \n613\t                    if output.get(\"error\"):\n614\t                        final_answer = f\"Agent execution stopped at node '{node.id}': {output['error']}\"\n615\t                        break\n616\t                except Exception as e:\n617\t                    track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, str(e))\n618\t                    final_answer = f\"Error in agent reasoning at node '{node.id}': {str(e)}\"\n619\t                    break\n620\t\n621\t            lineage_audit[\"nodes_executed\"] = nodes_executed\n622\t            track_workflow_complete(run_id, \"chat_graph_agent\", request.workspace, [\"reasoning\"], int((datetime.now()-start_time).total_seconds()*1000))\n623\t            task_manager.update_task(run_id, status=\"completed\" if final_answer else \"failed\", progress=100)\n624\t\n625\t            return {\n626\t                \"answer\": final_answer or \"No response generated.\",\n627\t                \"sources\": [\"Neural Graph\", \"Workspace Files\"],\n628\t                \"query\": request.query,\n629\t                \"mode\": \"graph_agent\",\n630\t                \"run_id\": run_id,\n631\t                \"lineage_audit\": lineage_audit\n632\t            }\n633\t\n634\t        # Handle Discovery Swarm Mode (Progressive)\n635\t        if request.mode == \"discovery_swarm\":\n636\t            from ..graph.discovery_swarm import run_discovery_swarm\n637\t            \n638\t            # Pre-check Nexus grounding\n639\t            if not request.active_nexus_id or request.active_nexus_id == \"neural_nexus\":\n640\t                track_workflow_fail(run_id, \"discovery_swarm\", request.workspace, \"nexus_required interruption\")\n641\t                return {\n642\t                    \"answer\": \"\",\n643\t                    \"status\": \"nexus_required\",\n644\t                    \"message\": \"Discovery Swarm requires a grounded Nexus context selection. Use the Map or Forge to select an active Nexus.\",\n645\t                    \"run_id\": run_id,\n646\t                    \"lineage_audit\": lineage_audit\n647\t                }\n648\t\n649\t            track_workflow_start(run_id, \"discovery_swarm\", request.workspace, inputs=[request.query])\n650\t            \n651\t            # Execute the Swarm\n652\t            swarm_result = await run_discovery_swarm(\n653\t                workspace=request.workspace,\n654\t                nexus_id=request.active_nexus_id,\n655\t                query=request.query,\n656\t                run_id=run_id,\n657\t                provider=request.provider,\n658\t                model=request.model\n659\t            )\n660\t            \n661\t            final_report = \"\\n\".join(swarm_result.get(\"findings\", [\"No findings generated.\"]))\n662\t            \n663\t            track_workflow_complete(run_id, \"discovery_swarm\", request.workspace, [\"scouting\", \"planning\"], int((datetime.now()-start_time).total_seconds()*1000))\n664\t            \n665\t            return {\n666\t                \"answer\": swarm_result.get(\"answer\", f\"### Discovery Report\\n\\n{final_report}\"),\n667\t                \"sources\": [\"Neural Graph\"],\n668\t                \"query\": request.query,\n669\t                \"mode\": \"discovery_swarm\",\n670\t                \"run_id\": run_id,\n671\t                \"lineage_audit\": lineage_audit\n672\t            }\n673\t\n674\t        # --- ADAPTIVE / AGENTIC MODE ---\n675\t        # The agent decides whether to retrieve (no_retrieval / single_step /\n676\t        # multi_hop), grades the retrieved chunks, and self-corrects with a\n677\t        # query rewrite if it comes up empty — instead of the legacy always-\n678\t        # prepend. Reads the same `knowledge` collection the Documents panel\n679\t        # ingests into, so ingested PDFs are visible and validatable here.\n680\t        if request.mode in (\"adaptive\", \"agent\"):\n681\t            from ..core.adaptive_rag import run_adaptive_rag\n682\t            track_workflow_start(run_id, \"chat_adaptive_rag\", request.workspace, inputs=[request.query])\n683\t            result = await run_adaptive_rag(\n684\t                query=request.query,\n685\t                workspace=request.workspace,\n686\t                model=request.model,  # None → resolved to the workspace chat model\n687\t            )\n688\t            graded = result.get(\"graded_documents\") or []\n689\t            sources = list({d.get(\"source\", \"Unknown\") for d in graded})\n690\t            answer = result.get(\"generation\") or \"No answer generated.\"\n691\t            track_workflow_complete(\n692\t                run_id, \"chat_adaptive_rag\", request.workspace,\n693\t                result.get(\"execution_trace\", []),\n694\t                int((datetime.now() - start_time).total_seconds() * 1000),\n695\t            )\n696\t            return {\n697\t                \"answer\": answer,\n698\t                \"sources\": sources,\n699\t                \"query\": request.query,\n700\t                \"mode\": \"adaptive\",\n701\t                \"route\": result.get(\"route\"),\n702\t                \"route_explanation\": result.get(\"route_explanation\", \"\"),\n703\t                \"documents_retrieved\": len(result.get(\"documents\", [])),\n704\t                \"documents_relevant\": len(graded),\n705\t                \"retry_count\": result.get(\"retry_count\", 0),\n706\t                \"execution_trace\": result.get(\"execution_trace\", []),\n707\t                \"run_id\": run_id,\n708\t                \"lineage_audit\": lineage_audit,\n709\t            }\n710\t\n711\t        # --- LEGACY / SEMANTIC MODE ---\n712\t        track_workflow_start(run_id, \"chat_semantic_rag\", request.workspace, inputs=[request.query])\n713\t        \n714\t        # 1. Retrieve context\n715\t        client = get_chromadb_client(request.workspace)\n716\t        collection = get_knowledge_collection(client)\n717\t        \n718\t        context_text = \"\"\n719\t        sources = []\n720\t        \n721\t        if collection.count() > 0:\n722\t            import re\n723\t            from pathlib import Path\n724\t            all_data = collection.get(include=['metadatas'])\n725\t            available_sources = set(meta.get('source', 'Unknown') for meta in all_data['metadatas'] if 'source' in meta)\n726\t            mentioned_sources = []\n727\t            \n728\t            if request.selected_sources and len(request.selected_sources) > 0:\n729\t                mentioned_sources = [s for s in request.selected_sources if s in available_sources]\n730\t            else:\n731\t                query_lower = request.query.lower()\n732\t                for source in available_sources:\n733\t                    source_stem = Path(source).stem.lower()\n734\t                    words = [w for w in set(re.split(r'[^a-zA-Z0-9]', source_stem)) if len(w) > 3]\n735\t                    for w in words:\n736\t                        if w in query_lower:\n737\t                            mentioned_sources.append(source)\n738\t                            break\n739\t                        \n740\t            results_list = []\n741\t            if mentioned_sources:\n742\t                k_per_source = max(3, request.top_k // len(mentioned_sources))\n743\t                for source in mentioned_sources:\n744\t                    try:\n745\t                        res = collection.query(query_texts=[request.query], n_results=min(k_per_source, collection.count()), where={\"source\": source})\n746\t                        if res['documents'] and res['documents'][0]:\n747\t                            for doc, meta in zip(res['documents'][0], res['metadatas'][0]):\n748\t                                results_list.append((doc, meta))\n749\t                    except Exception: pass\n750\t                try:\n751\t                    gen_res = collection.query(query_texts=[request.query], n_results=min(3, collection.count()))\n752\t                    if gen_res['documents'] and gen_res['documents'][0]:\n753\t                        for doc, meta in zip(gen_res['documents'][0], gen_res['metadatas'][0]):\n754\t                            results_list.append((doc, meta))\n755\t                except Exception: pass\n756\t            else:\n757\t                try:\n758\t                    res = collection.query(query_texts=[request.query], n_results=min(request.top_k, collection.count()))\n759\t                    if res['documents'] and res['documents'][0]:\n760\t                        for doc, meta in zip(res['documents'][0], res['metadatas'][0]):\n761\t                            results_list.append((doc, meta))\n762\t                except Exception: pass\n763\t\n764\t            seen_docs = set()\n765\t            for doc, meta in results_list:\n766\t                if doc not in seen_docs:\n767\t                    seen_docs.add(doc)\n768\t                    source = meta.get('source', 'Unknown')\n769\t                    context_text += f\"[Source: {source}]\\n{doc}\\n\\n\"\n770\t                    sources.append(source)\n771\t\n772\t        lineage_audit[\"selected_sources\"] = request.selected_sources\n773\t        lineage_audit[\"sources_retrieved\"] = list(set(sources))\n774\t\n775\t        # 2. Build Prompt\n776\t        system_prompt = \"You are a helpful AI assistant. Answer based on context. Cite sources [Source: filename.ext].\"\n777\t        \n778\t        # Truncate context to prevent 'Max length reached' errors\n779\t        from ..core.context_guard import ContextGuard\n780\t        profile = ContextGuard.get_profile(request.model or \"fastflowlm\")\n781\t        context_text = ContextGuard.guard_string(context_text, profile.max_rag_context_chars, \"rag_context\")\n782\t             \n783\t        content = f\"{system_prompt}\\n\\nCONTEXT:\\n{context_text if context_text else 'No documents found.'}\\n\\nQUESTION: {request.query}\\n\\nANSWER:\"\n784\t\n785\t        # 3. Call LLM\n786\t        try:\n787\t            # Resolve model via role-based orchestrator\n788\t            active_model = await get_active_model(request.workspace, role=\"chat\")\n789\t            \n790\t            from ..core.models import get_model_config\n791\t            config = get_model_config(active_model)\n792\t            provider_name = config.get(\"provider\", \"openai\")\n793\t            provider_config = LOCAL_PROVIDERS.get(provider_name, LOCAL_PROVIDERS[\"fastflowlm\"])\n794\t            model_core = config.get(\"model\", active_model).split('/')[-1]\n795\t\n796\t            chat_url = f\"{provider_config['base_url']}/chat/completions\"\n797\t            payload = {\n798\t                \"model\": model_core,\n799\t                \"messages\": [{\"role\": \"user\", \"content\": content}],\n800\t                \"temperature\": 0.7,\n801\t                \"max_tokens\": 1024\n802\t            }\n803\t            \n804\t            async with httpx.AsyncClient(timeout=300.0) as client:\n805\t                response = await client.post(chat_url, json=payload, headers={\"Content-Type\": \"application/json\"})\n806\t                \n807\t                if response.status_code == 200:\n808\t                    data = response.json()\n809\t                    \n810\t                    if \"error\" in data:\n811\t                        err_obj = data[\"error\"]\n812\t                        err_msg = err_obj.get(\"message\", str(err_obj)) if isinstance(err_obj, dict) else str(err_obj)\n813\t                        error_msg = f\"LLM Error in 200 OK: {err_msg}\"\n814\t                        track_workflow_fail(run_id, \"chat_semantic_rag\", request.workspace, error_msg)\n815\t                        raise HTTPException(503, f\"LLM Provider {provider_name} returned error: {error_msg}\")\n816\t                    \n817\t                    if \"choices\" not in data or not data[\"choices\"]:\n818\t                        error_msg = f\"LLM unexpected response format: {json.dumps(data)}\"\n819\t                        track_workflow_fail(run_id, \"chat_semantic_rag\", request.workspace, error_msg)\n820\t                        raise HTTPException(503, error_msg)\n821\t                        \n822\t                    answer = data.get(\"choices\", [{}])[0].get(\"message\", {}).get(\"content\", \"No content in LLM response.\")\n823\t                    \n824\t                    # Trace LLM Call\n825\t                    track_llm_call(run_id, model_core, provider_name, usage=data.get(\"usage\"), parent_job_name=\"chat_semantic_rag\")\n826\t                    track_workflow_complete(run_id, \"chat_semantic_rag\", request.workspace, [\"retrieval\", \"generation\"], int((datetime.now()-start_time).total_seconds()*1000))\n827\t                    \n828\t                    return {\n829\t                        \"answer\": answer,\n830\t                        \"sources\": list(set(sources)),\n831\t                        \"query\": request.query,\n832\t                        \"run_id\": run_id,\n833\t                        \"lineage_audit\": lineage_audit\n834\t                    }\n835\t                else:\n836\t                    error_msg = f\"LLM Error {response.status_code}: {response.text}\"\n837\t                    track_workflow_fail(run_id, \"chat_semantic_rag\", request.workspace, error_msg)\n838\t                    raise HTTPException(503, f\"LLM Provider {provider_name} returned error: {error_msg}\")\n839\t\n840\t        except HTTPException:\n841\t            raise\n842\t        except Exception as e:\n843\t            import traceback\n844\t            error_msg = f\"Internal chat system error (LLM Call): {str(e)}\\n{traceback.format_exc()}\"\n845\t            logger.error(error_msg)\n846\t            track_workflow_fail(run_id, \"chat_system\", request.workspace, str(e))\n847\t            raise HTTPException(500, f\"Internal chat system error. Check logs for trace: {run_id}\")\n848\t\n849\t    except HTTPException:\n850\t        raise\n851\t    except Exception as e:\n852\t        import traceback\n853\t        error_msg = f\"Internal chat system error (Main): {str(e)}\\n{traceback.format_exc()}\"\n854\t        logger.error(error_msg)\n855\t        track_workflow_fail(run_id, \"chat_system\", request.workspace, str(e))\n856\t        raise HTTPException(500, f\"Internal chat system error. Check logs for trace: {run_id}\")\n857\t\n858\t\n859\t@router.get(\"/rag/chat/events/{run_id}\")\n860\tasync def stream_chat_events(run_id: str):\n861\t    \"\"\"\n862\t    SSE endpoint: stream real-time progress events for a chat / swarm run.\n863\t    \"\"\"\n864\t    return StreamingResponse(\n865\t        event_bus.subscribe(run_id),\n866\t        media_type=\"text/event-stream\",\n867\t        headers={\n868\t            \"Cache-Control\": \"no-cache\",\n869\t            \"Connection\": \"keep-alive\",\n870\t            \"X-Accel-Buffering\": \"no\"\n871\t        }\n872\t    )\n873\t\n874\tfrom fastapi import Response\n875\t\n876\t@router.get(\"/rag/wiki/articles\")\n877\tasync def list_wiki_articles(workspace: str = \"default\"):\n878\t    \"\"\"List all Rationale Hub articles generated by synthesis.\"\"\"\n879\t    try:\n880\t        from ..core.workspace import get_workspace_path\n881\t        wiki_path = get_workspace_path(workspace) / \".benny\" / \"wiki\"\n882\t        \n883\t        if not wiki_path.exists():\n884\t            return {\"articles\": []}\n885\t            \n886\t        articles = []\n887\t        for file in wiki_path.glob(\"*.md\"):\n888\t            articles.append({\n889\t                \"name\": file.stem.replace(\"_\", \" \"),\n890\t                \"filename\": file.name,\n891\t                \"path\": str(file),\n892\t                \"modified\": file.stat().st_mtime\n893\t            })\n894\t            \n895\t        return {\"articles\": sorted(articles, key=lambda x: x[\"modified\"], reverse=True)}\n896\t    except Exception as e:\n897\t        raise HTTPException(500, f\"Failed to list wiki: {str(e)}\")\n898\t\n899\t@router.get(\"/rag/wiki/article/{filename}\")\n900\tasync def get_wiki_article(filename: str, workspace: str = \"default\"):\n901\t    \"\"\"Get content of a specific Rationale Hub article.\"\"\"\n902\t    try:\n903\t        from ..core.workspace import get_workspace_path\n904\t        wiki_path = get_workspace_path(workspace) / \".benny\" / \"wiki\"\n905\t        file_path = wiki_path / filename\n906\t        \n907\t        if not file_path.exists():\n908\t            raise HTTPException(404, \"Article not found\")\n909\t            \n910\t        with open(file_path, \"r\", encoding=\"utf-8\") as f:\n911\t            content = f.read()\n912\t            \n913\t        return {\"content\": content, \"filename\": filename}\n914\t    except HTTPException:\n915\t        raise\n916\t    except Exception as e:\n917\t        raise HTTPException(500, f\"Failed to read article: {str(e)}\")\n918\t\n919\tfrom fastapi import Response\n920\t\n921\t@router.post(\"/rag/adaptive-query\", response_model=AdaptiveRAGResponse)\n922\tasync def adaptive_rag_query(request: AdaptiveRAGRequest, response: Response):\n923\t    \"\"\"\n924\t    Adaptive RAG query — self-correcting retrieval pipeline.\n925\t    Routes queries through no_retrieval / single_step / multi_hop \n926\t    with quality grading and automatic query rewriting.\n927\t    \"\"\"\n928\t    from ..core.adaptive_rag import run_adaptive_rag\n929\t    \n930\t    try:\n931\t        result = await run_adaptive_rag(\n932\t            query=request.query,\n933\t            workspace=request.workspace,\n934\t            model=request.model,\n935\t            max_retries=request.max_retries,\n936\t        )\n937\t        \n938\t        # Set the strategy header\n939\t        response.headers[\"X-RAG-Strategy\"] = result.get(\"route\", \"single_step\")\n940\t        \n941\t        return AdaptiveRAGResponse(\n942\t            answer=result.get(\"generation\"),\n943\t            route=result.get(\"route\", \"single_step\"),\n944\t            route_explanation=result.get(\"route_explanation\", \"\"),\n945\t            documents_retrieved=len(result.get(\"documents\", [])),\n946\t            documents_relevant=len(result.get(\"graded_documents\", [])),\n947\t            retry_count=result.get(\"retry_count\", 0),\n948\t            execution_trace=result.get(\"execution_trace\", []),\n949\t            hallucination_check=result.get(\"hallucination_check\"),\n950\t            answer_quality=result.get(\"answer_quality\"),\n951\t        )\n952\t    except Exception as e:\n953\t        raise HTTPException(500, f\"Adaptive RAG failed: {str(e)}\")\n954\t\n955\t@router.post(\"/rag/correlate\")\n956\tasync def manual_correlate(\n957\t    workspace: str = \"default\",\n958\t    threshold: float = 0.82,\n959\t    top_k: int = 32,\n960\t    use_ann: bool = True,\n961\t):\n962\t    \"\"\"Manually trigger the correlation suite (Neural Spark) for a workspace.\n963\t\n964\t    Raised default threshold 0.70 → 0.82 and added top_k (bounds edges per\n965\t    concept). Set use_ann=false to force the numpy fallback even when hnswlib\n966\t    is installed.\n967\t    \"\"\"\n968\t    try:\n969\t        from ..synthesis.correlation import run_full_correlation_suite\n970\t        results = await run_full_correlation_suite(\n971\t            workspace,\n972\t            threshold=threshold,\n973\t            top_k_per_concept=top_k,\n974\t            use_ann=use_ann,\n975\t        )\n976\t        return {\n977\t            \"status\":    \"completed\",\n978\t            \"workspace\": workspace,\n979\t            \"threshold\": threshold,\n980\t            \"top_k\":     top_k,\n981\t            \"use_ann\":   use_ann,\n982\t            \"results\":   results,\n983\t        }\n984\t    except Exception as e:\n985\t        raise HTTPException(500, f\"Correlation failed: {str(e)}\")\n986\t\n987\t@router.get(\"/rag/config/context\")\n988\tasync def get_context_config(model: str = \"fastflowlm\"):\n989\t    \"\"\"Expose ContextGuard profiles to the frontend.\"\"\"\n990\t    from ..core.context_guard import ContextGuard\n991\t    profile = ContextGuard.get_profile(model)\n992\t    return {\n993\t        \"model\": model,\n994\t        \"max_total_chars\": profile.max_total_chars,\n995\t        \"max_tool_output_chars\": profile.max_tool_output_chars,\n996\t        \"max_rag_context_chars\": profile.max_rag_context_chars,\n997\t    }\n998\t"}]},"uuid":"80a0ba21-c35e-47ce-8bc8-ef8afa6007cc","timestamp":"2026-06-23T08:59:39.604Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\api\\rag_routes.py","content":"\"\"\"\nRAG Routes - Document ingestion and semantic search\n\"\"\"\n\nfrom fastapi import APIRouter, HTTPException\nfrom pydantic import BaseModel\nfrom typing import Optional, List, AsyncGenerator\nfrom fastapi.responses import StreamingResponse\nfrom ..core.event_bus import event_bus\nfrom pathlib import Path\nimport fitz  # PyMuPDF\nimport httpx\n\nfrom ..core.workspace import get_workspace_path\nfrom ..core.extraction import extract_structured_text\nfrom ..tools.knowledge import get_chromadb_client, get_knowledge_collection, heal_collection_dimension\nfrom ..core.models import LOCAL_PROVIDERS, get_active_model\nfrom ..core.task_manager import task_manager\nfrom ..governance.lineage import track_workflow_start, track_workflow_complete, track_aer, track_workflow_fail, track_llm_call\nfrom ..governance.permission_manifest import register_manifest, create_ephemeral_manifest\nimport uuid\nimport json\nimport logging\nfrom datetime import datetime\n\nlogger = logging.getLogger(__name__)\n\nrouter = APIRouter()\n\n\nclass IngestRequest(BaseModel):\n    workspace: str = \"default\"\n    files: Optional[List[str]] = None\n    notebook_id: Optional[str] = None\n    batch_size: Optional[int] = 500\n    run_id: Optional[str] = None # Optional existing run/nexus ID\n    deep_synthesis: bool = False # Whether to extract triples and run clustering\n    strategy: str = \"safe\" # Heuristic layer: 'safe' or 'aggressive'\n    correlation_threshold: float = 0.82 # Similarity threshold for aggressive mode (raised from 0.70 — the 0.70 knee produced ~36× noise-tail edges)\n    correlation_top_k: int = 32          # Max symbol matches per concept; caps edge fan-out\n    correlation_use_ann: bool = True     # Use HNSW ANN index when hnswlib is installed; falls back to numpy top-K\n    force_reingest: bool = False # Whether to force re-processing even if already in DB\n    model: Optional[str] = None # Optional model override for synthesis\n\n\n\n\nclass QueryRequest(BaseModel):\n    query: str\n    workspace: str = \"default\"\n    top_k: int = 5\n    selected_sources: Optional[List[str]] = None\n    provider: Optional[str] = None\n    model: Optional[str] = None\n    mode: str = \"semantic\" # \"semantic\", \"graph_agent\", or \"discovery_swarm\"\n    active_nexus_id: Optional[str] = None # For grounding graph agents\n    run_id: Optional[str] = None\n\nclass AdaptiveRAGRequest(BaseModel):\n    query: str\n    workspace: str = \"default\"\n    model: str = \"Qwen3-8B-Hybrid\"\n    max_retries: int = 3\n\nclass AdaptiveRAGResponse(BaseModel):\n    answer: Optional[str]\n    route: str\n    route_explanation: str\n    documents_retrieved: int\n    documents_relevant: int\n    retry_count: int\n    execution_trace: List[str]\n    hallucination_check: Optional[bool]\n    answer_quality: Optional[bool]\n\n@router.post(\"/rag/ingest\")\nasync def ingest_files(request: IngestRequest):\n    \"\"\"Ingest files from data_in into ChromaDB using structured extraction (Docling).\"\"\"\n    run_id = request.run_id or str(uuid.uuid4())\n    task = task_manager.create_task(request.workspace, \"rag_ingest\", task_id=run_id)\n    \n    try:\n        track_workflow_start(run_id, \"rag_ingest\", request.workspace, inputs=request.files or [])\n        task_manager.add_aer_entry(\n            run_id, \n            intent=f\"Ingesting {len(request.files) if request.files else 'all'} files from data_in\",\n            observation=\"Initialization complete\",\n            plan=f\"1. Extract text via Docling 2. Chunk 3. Batch upsert to ChromaDB\"\n        )\n    except Exception as e:\n        logger.warning(\"Lineage tracking failed (init): %s\", e)\n\n    try:\n        data_in_path = get_workspace_path(request.workspace, \"data_in\")\n        if not data_in_path.exists():\n            task_manager.update_task(run_id, status=\"failed\", message=\"No files found in data_in\")\n            raise HTTPException(404, \"No files found in data_in\")\n        \n        # Get files to ingest\n        if request.files:\n            file_paths = [data_in_path / f for f in request.files]\n        else:\n            file_paths = list(data_in_path.glob(\"*.*\"))\n        \n        # Filter for supported types\n        supported = ['.txt', '.md', '.pdf', '.docx', '.pptx', '.html']\n        file_paths = [f for f in file_paths if f.suffix.lower() in supported]\n        \n        logger.info(f\"Ingestion started for {len(file_paths)} files in {data_in_path}\")\n        \n        if not file_paths:\n            task_manager.update_task(run_id, status=\"failed\", message=\"No supported files found\")\n            raise HTTPException(404, \"No supported files found\")\n\n        # Preflight: the knowledge collection embeds via the local HTTP provider\n        # (LocalEmbeddingFunction → LM Studio / Lemonade / Ollama). If that\n        # provider is down, every upsert silently stores zero-vectors (see\n        # core/embeddings.py) and search returns garbage. Probe once and fail\n        # fast with an actionable message instead of a hollow success.\n        from ..core.embeddings import get_embedding_sync\n        try:\n            probe_vec = get_embedding_sync(\"ping\")\n        except Exception as probe_e:\n            probe_vec = []\n            logger.warning(\"Embedding preflight raised: %s\", probe_e)\n        if not any(probe_vec):\n            msg = (\n                \"Embedding provider unreachable — no documents were indexed. \"\n                \"Start a local embedding server (LM Studio / Lemonade / Ollama) \"\n                \"and retry.\"\n            )\n            task_manager.update_task(run_id, status=\"failed\", message=msg)\n            try:\n                track_workflow_fail(run_id, \"rag_ingest\", request.workspace, msg)\n            except Exception:\n                pass\n            raise HTTPException(503, msg)\n\n        # Get ChromaDB client\n        client = get_chromadb_client(request.workspace)\n        collection_name = f\"notebook_{request.notebook_id}\" if request.notebook_id else \"knowledge\"\n        collection = get_knowledge_collection(client, collection_name)\n        # Self-heal a stale collection left by the pre-fix 384-dim default embedder\n        # so the zero-install exe needs no manual chromadb cleanup.\n        collection = heal_collection_dimension(client, collection, collection_name, probe_vec)\n\n        # Update task total steps\n        task_manager.update_task(run_id, total_steps=len(file_paths), progress=10)\n        \n        ingested = []\n        for idx, file_path in enumerate(file_paths):\n            try:\n                msg = f\"Processing {file_path.name} ({idx+1}/{len(file_paths)})...\"\n                logger.info(msg)\n                task_manager.update_task(\n                    run_id, \n                    message=msg, \n                    current_step=idx+1,\n                    metadata={\n                        \"stage\": \"EXTRACTING\",\n                        \"current_file\": file_path.name\n                    }\n                )\n                \n                # Emit AER for extraction\n                try:\n                    track_aer(run_id, \"rag_ingest\", request.workspace, f\"Extracting {file_path.name}\", \"Docling engine started\")\n                except Exception:\n                    pass\n                text = extract_structured_text(file_path)\n                print(f\"DEBUG: Extracted {len(text)} chars from {file_path.name}. Preview: {text[:100]}...\")\n                \n                # Better chunking (split by paragraphs, then size limit)\n                raw_chunks = [c.strip() for c in text.split('\\n\\n') if c.strip()]\n                if not raw_chunks and text.strip():\n                    raw_chunks = [text.strip()]\n                \n                chunks = []\n                max_chunk_chars = 4000\n                for rc in raw_chunks:\n                    if len(rc) > max_chunk_chars:\n                        for i in range(0, len(rc), max_chunk_chars):\n                            chunks.append(rc[i:i+max_chunk_chars])\n                    else:\n                        chunks.append(rc)\n                \n                index_error = None\n                if chunks:\n                    try:\n                        task_manager.update_task(run_id, metadata={\"stage\": \"INDEXING\", \"current_file\": file_path.name, \"chunks\": len(chunks)})\n\n                        # 1. DELETE old entries for this source to ensure fresh start\n                        logger.info(f\"Clearing old vectors for {file_path.name} to ensure fresh ingestion.\")\n                        collection.delete(where={\"source\": file_path.name})\n\n                        # 2. UPLOAD in batches\n                        batch_size = request.batch_size or 500\n                        for i in range(0, len(chunks), batch_size):\n                            batch_chunks = chunks[i:i + batch_size]\n                            batch_ids = [f\"{file_path.stem}_{run_id[-4:]}_{j}\" for j in range(i, i + len(batch_chunks))]\n                            batch_metadatas = [\n                                {\"source\": file_path.name, \"chunk_index\": j, \"run_id\": run_id}\n                                for j in range(i, i + len(batch_chunks))\n                            ]\n                            collection.add(documents=batch_chunks, metadatas=batch_metadatas, ids=batch_ids)\n                    except Exception as index_e:\n                        # An indexing failure means the file produced NO retrievable\n                        # vectors — surface it instead of reporting clean success.\n                        # Most common cause: the embedding provider (LM Studio /\n                        # Lemonade / Ollama) is down, so LocalEmbeddingFunction\n                        # returns zero-vectors or Chroma raises.\n                        index_error = str(index_e)\n                        logger.error(f\"Vector Indexing error for {file_path.name}: {index_e}\")\n                        task_manager.add_aer_entry(run_id, \"Error\", f\"Indexing Failed {file_path.name}: {index_error}\")\n                        # Do not abort the loop, let it continue to deep synthesis\n                \n                # 3. DEEP SYNTHESIS (Optional)\n                if request.deep_synthesis:\n                    try:\n                        from ..synthesis.engine import parallel_extract_triples\n                        from ..graph.triples import save_knowledge_triples\n                        \n                        track_aer(run_id, \"rag_ingest\", request.workspace, f\"Deep Synthesis for {file_path.name}\", \"Extracting triples via LLM Engine\")\n                        task_manager.update_task(run_id, metadata={\"stage\": \"SYNTHESIZING\", \"current_file\": file_path.name})\n                        \n                        print(f\"DEBUG: STARTING Triple Extraction for {file_path.name}...\")\n                        \n                        # Prepare NPU-friendly chunks for synthesis (limit to 10 sections to prevent runaway extraction)\n                        synth_chunks = chunks[:10] \n                        sections = [{\"title\": f\"{file_path.name} Part {i+1}\", \"text\": c} for i, c in enumerate(synth_chunks) if len(c) > 100]\n                        \n                        triples = await parallel_extract_triples(\n                            sections=sections,\n                            run_id=run_id, \n                            workspace=request.workspace,\n                            strategy=request.strategy,\n                            model=request.model,\n                            timeout=300.0,\n                            parallel_limit=2\n\n                        )\n                        print(f\"DEBUG: FINISHED Triple Extraction for {file_path.name}: Found {len(triples)} triples\")\n                        \n                        if triples:\n                            await save_knowledge_triples(request.workspace, triples, file_path.name)\n                            track_aer(run_id, \"rag_ingest\", request.workspace, f\"Synthesis complete for {file_path.name}\", f\"Extracted {len(triples)} triples\")\n                            \n                            # 3b. Generate Librarian Wiki Article (Karpathy-style)\n                            try:\n                                from ..synthesis.engine import save_concept_article\n                                # Use the first few triples to identify the primary concept or use the filename\n                                primary_concept = file_path.stem\n                                summary_prompt = f\"Summarize the core concepts of this document section in 3-4 sentences for a technical wiki:\\n\\n{text[:2000]}\"\n                                from ..synthesis.engine import call_llm\n                                summary = await call_llm(summary_prompt, run_id=run_id, workspace=request.workspace)\n                                \n                                wiki_file = await save_concept_article(\n                                    workspace=request.workspace,\n                                    concept_name=primary_concept,\n                                    summary=summary,\n                                    relationships=[t.model_dump() for t in triples[:10]],\n                                    source_files=[file_path.name]\n                                )\n                                track_aer(run_id, \"rag_ingest\", request.workspace, f\"Wiki Generated\", f\"Saved Rationale Hub to {primary_concept}.md\")\n                            except Exception as wiki_e:\n                                logger.error(f\"Wiki generation error: {wiki_e}\")\n                    except Exception as synth_e:\n                        logger.error(f\"Deep Synthesis error: {synth_e}\")\n                        track_aer(run_id, \"rag_ingest\", request.workspace, f\"Synthesis failed for {file_path.name}\", str(synth_e))\n\n                file_result = {\"file\": file_path.name, \"chunks\": len(chunks)}\n                if index_error:\n                    # Chunks were produced but none were stored — report the failure\n                    # so the caller doesn't treat an empty index as a success.\n                    file_result[\"indexed\"] = False\n                    file_result[\"error\"] = index_error\n                else:\n                    file_result[\"indexed\"] = bool(chunks)\n                ingested.append(file_result)\n                task_manager.update_task(run_id, progress=10 + int(80 * (idx+1) / len(file_paths)))\n                \n            except Exception as e:\n                task_manager.add_aer_entry(run_id, \"Error\", f\"Failed {file_path.name}: {str(e)}\")\n                ingested.append({\"file\": file_path.name, \"error\": str(e)})\n        \n        # 4. FINAL CLUSTERING & CORRELATION (if deep synthesis enabled)\n        if request.deep_synthesis:\n            try:\n                from ..graph.clustering_service import ClusteringService\n                from ..synthesis.correlation import run_full_correlation_suite\n                \n                track_aer(run_id, \"rag_ingest\", request.workspace, \"Running Topological Clustering\", \"Community detection started (LPA)\")\n                task_manager.update_task(run_id, metadata={\"stage\": \"CLUSTERING\"})\n                cluster_results = await ClusteringService.run_lpa_on_workspace(request.workspace)\n                \n                track_aer(run_id, \"rag_ingest\", request.workspace, \"Running Knowledge-to-Code Correlation\", \"Cross-linking Concepts and Symbols\")\n                task_manager.update_task(run_id, metadata={\"stage\": \"CORRELATING\"})\n                correlation_results = await run_full_correlation_suite(\n                    request.workspace,\n                    threshold=request.correlation_threshold,\n                    top_k_per_concept=request.correlation_top_k,\n                    use_ann=request.correlation_use_ann,\n                )\n                \n                track_aer(run_id, \"rag_ingest\", request.workspace, \"Deep Processing complete\", \n                          f\"Clusters: {cluster_results.get('communities_found', 0)}, \" \n                          f\"Safe Links: {correlation_results.get('safe_links', 0)}, \"\n                          f\"Aggressive Links: {correlation_results.get('aggressive_links', 0)}\")\n            except Exception as post_e:\n                logger.error(f\"Post-processing error: {post_e}\")\n \n\n        # Honest status: a file \"indexed\" only if its vectors were actually\n        # stored. If every file failed to index, this run did nothing useful —\n        # report it as failed so the UI surfaces it instead of a green tick.\n        succeeded = [f for f in ingested if f.get(\"indexed\")]\n        failed = [f for f in ingested if f.get(\"error\")]\n        if succeeded:\n            final_status = \"completed\" if not failed else \"completed_with_errors\"\n            final_msg = (\n                \"Ingestion finished successfully\" if not failed\n                else f\"Ingested {len(succeeded)} file(s); {len(failed)} failed to index.\"\n            )\n        else:\n            final_status = \"failed\"\n            hint = failed[0][\"error\"] if failed else \"no chunks were produced\"\n            final_msg = (\n                f\"No documents were indexed ({hint}). \"\n                \"If the error mentions embeddings/connection, start your local \"\n                \"embedding provider (LM Studio / Lemonade / Ollama) and retry.\"\n            )\n\n        task_manager.update_task(run_id, status=final_status, progress=100, message=final_msg)\n        try:\n            if final_status == \"failed\":\n                track_workflow_fail(run_id, \"rag_ingest\", request.workspace, final_msg)\n            else:\n                track_workflow_complete(\n                    run_id,\n                    \"rag_ingest\",\n                    request.workspace,\n                    [\"extraction\", \"chunking\", \"upsert\"],\n                    0,\n                    outputs=[f\"chromadb:{collection_name}\"]\n                )\n        except Exception:\n            pass\n\n        return {\n            \"status\": final_status,\n            \"message\": final_msg,\n            \"run_id\": run_id,\n            \"workspace\": request.workspace,\n            \"ingested\": ingested,\n            \"indexed_files\": len(succeeded),\n            \"failed_files\": len(failed),\n            \"total_documents\": collection.count()\n        }\n        \n    except HTTPException:\n        raise\n    except Exception as e:\n        task_manager.update_task(run_id, status=\"failed\", message=str(e))\n        raise HTTPException(500, f\"Ingestion failed: {str(e)}\")\n\n\n@router.get(\"/rag/logs\")\nasync def get_rag_logs(workspace: str = \"default\"):\n    \"\"\"Get the latest ingestion tasks from TaskManager.\"\"\"\n    try:\n        tasks = task_manager.list_tasks(workspace)\n        rag_tasks = [t for t in tasks if t.type == \"rag_ingest\"]\n        if not rag_tasks:\n            return {\"tasks\": []}\n        \n        # Sort by updated_at descending\n        rag_tasks.sort(key=lambda x: x.updated_at, reverse=True)\n        \n        return {\"tasks\": [t.model_dump() for t in rag_tasks[:5]]}\n    except Exception as e:\n        return {\"error\": str(e), \"tasks\": []}\n\n\n@router.get(\"/rag/status\")\nasync def get_rag_status(workspace: str = \"default\"):\n    \"\"\"Get RAG status and document count\"\"\"\n    try:\n        client = get_chromadb_client(workspace)\n        collection = get_knowledge_collection(client)\n        \n        # Get unique sources - optimized by only fetching metadatas\n        all_data = collection.get(include=['metadatas'])\n        sources = set()\n        for meta in all_data['metadatas']:\n            sources.add(meta.get('source', 'Unknown'))\n        \n        return {\n            \"workspace\": workspace,\n            \"total_chunks\": collection.count(),\n            \"unique_documents\": len(sources),\n            \"documents\": list(sources),\n            \"sources\": list(sources) # Alias for consistency with graph API\n        }\n\n    except Exception as e:\n        raise HTTPException(500, f\"Status check failed: {str(e)}\")\n\n\n@router.get(\"/rag/indexing-manifest\")\nasync def get_indexing_manifest(workspace: str = \"default\"):\n    \"\"\"Reconcile workspace files with ChromaDB to find unindexed or changed documents.\"\"\"\n    try:\n        # 1. Get indexed sources\n        client = get_chromadb_client(workspace)\n        collection = get_knowledge_collection(client)\n        all_data = collection.get(include=['metadatas'])\n        \n        indexed_sources = {} # source_name -> {chunk_count, last_indexed}\n        if all_data.get('metadatas'):\n            for meta in all_data['metadatas']:\n                if meta is None: continue\n                src = meta.get('source')\n                if not src: continue\n                if src not in indexed_sources:\n                    indexed_sources[src] = {\"chunks\": 0, \"last_indexed\": meta.get('timestamp')}\n                indexed_sources[src][\"chunks\"] += 1\n\n        # 2. Get disk files (Recursive scan focus on data_in and root)\n        data_in_path = get_workspace_path(workspace, \"data_in\")\n        supported = ['.txt', '.md', '.pdf', '.docx', '.pptx', '.html', '.py', '.ts', '.json', '.sql']\n        \n        manifest = []\n        import os\n        from ..core.workspace import get_workspace_path\n        \n        import os\n        for base_path_obj in [data_in_path]:\n            base_path = str(base_path_obj)\n            if not os.path.exists(base_path):\n                continue\n                \n            for root, dirs, files in os.walk(base_path):\n                # Skip some folders\n                if \"chromadb\" in root or \"__pycache__\" in root or \".git\" in root:\n                    continue\n                \n                for name in files:\n                    file_path = Path(root) / name\n                    ext = file_path.suffix.lower()\n                    if ext not in supported:\n                        continue\n                        \n                    # Use os.path.relpath for Windows resilience (handles c: vs C: issues)\n                    rel_path_str = os.path.relpath(str(file_path), base_path)\n                    source_key = name # We often use just the filename as the source key\n                    \n                    status = \"MISSING\"\n                    chunks = 0\n                    if source_key in indexed_sources:\n                        status = \"ALIGNED\" # Basic check: existence. In future: hash check\n                        chunks = indexed_sources[source_key][\"chunks\"]\n                    \n                    manifest.append({\n                        \"name\": name,\n                        \"path\": rel_path_str.replace(\"\\\\\", \"/\"),\n                        \"status\": status,\n                        \"chunks\": chunks,\n                        \"size\": file_path.stat().st_size,\n                        \"modified\": file_path.stat().st_mtime,\n                        \"type\": ext.lstrip('.')\n                    })\n                    \n        return {\n            \"workspace\": workspace,\n            \"manifest\": manifest,\n            \"total_indexed\": len(indexed_sources)\n        }\n    except Exception as e:\n        raise HTTPException(500, f\"Indexing manifest failed: {str(e)}\")\n\n\n@router.post(\"/rag/query\")\nasync def query_rag(request: QueryRequest):\n    \"\"\"Test semantic search\"\"\"\n    try:\n        client = get_chromadb_client(request.workspace)\n        collection = get_knowledge_collection(client)\n        \n        if collection.count() == 0:\n            return {\n                \"results\": [],\n                \"message\": \"Knowledge base is empty\"\n            }\n        \n        results = collection.query(\n            query_texts=[request.query],\n            n_results=min(request.top_k, collection.count())\n        )\n        \n        formatted_results = []\n        for doc, meta, distance in zip(\n            results['documents'][0],\n            results['metadatas'][0],\n            results['distances'][0]\n        ):\n            formatted_results.append({\n                \"text\": doc,\n                \"source\": meta.get('source', 'Unknown'),\n                \"relevance\": round((1 - distance) * 100, 1)\n            })\n        \n\n        return {\n            \"query\": request.query,\n            \"results\": formatted_results,\n            \"count\": len(formatted_results)\n        }\n        \n    except Exception as e:\n        raise HTTPException(500, f\"Query failed: {str(e)}\")\n@router.post(\"/rag/chat\")\nasync def chat_rag(request: QueryRequest):\n    \"\"\"RAG-augmented chat for workspace documents or Neural Graph Agent\"\"\"\n    # Generate a consistent run_id for lineage tracking\n    run_id = request.run_id or f\"chat-{uuid.uuid4().hex[:8]}\"\n    start_time = datetime.now()\n    \n    # Audit trail: Include configuration details\n    lineage_audit = {\n        \"run_id\": run_id,\n        \"workspace\": request.workspace,\n        \"mode\": request.mode,\n        \"provider\": request.provider,\n        \"model\": request.model,\n        \"top_k\": request.top_k,\n        \"active_nexus_id\": request.active_nexus_id,\n        \"timestamp\": start_time.isoformat()\n    }\n\n    try:\n        # Handle Graph Agent Mode (Linear)\n        if request.mode == \"graph_agent\":\n            # 1. Load the System Workflow Definition\n            from .workflow_routes import workflow_storage\n            from .studio_executor import topological_sort, StudioExecuteRequest\n            \n            wf_def = workflow_storage.get_workflow(\"System_GraphChatAgent\")\n            if not wf_def:\n                 track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, \"System_GraphChatAgent definition missing\")\n                 raise HTTPException(404, \"System_GraphChatAgent workflow definition not found.\")\n\n            # 2. Trigger Workflow Execution\n            # Map workflow definition to request nodes/edges\n            nodes = wf_def.get(\"nodes\", [])\n            edges = wf_def.get(\"edges\", [])\n            \n            # Update the LLM node with the user's specific request and provider/model choice\n            for node in nodes:\n                if node.get(\"type\") == \"llm\":\n                    if \"config\" not in node[\"data\"]: node[\"data\"][\"config\"] = {}\n                    if request.model:\n                        node[\"data\"][\"config\"][\"model\"] = request.model\n            \n            from .studio_executor import StudioNode, StudioEdge\n            pydantic_nodes = [StudioNode(**n) for n in nodes]\n            pydantic_edges = [StudioEdge(**e) for e in edges]\n            \n            # Sort and Run\n            sorted_nodes = topological_sort(pydantic_nodes, pydantic_edges)\n            \n            context = {\n                \"message\": request.query, \n                \"workspace\": request.workspace,\n                \"active_nexus_id\": request.active_nexus_id\n            }\n            \n            # PRE-CHECK: If no nexus is provided for a graph agent, fail fast to trigger UI wizard\n            if not request.active_nexus_id or request.active_nexus_id == \"neural_nexus\":\n                track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, \"nexus_required interruption\")\n                return {\n                    \"answer\": \"\",\n                    \"status\": \"nexus_required\",\n                    \"message\": \"Neural Graph Agent requires a grounded Nexus context selection to proceed. Use the Map or Forge to select an active Nexus.\",\n                    \"run_id\": run_id,\n                    \"lineage_audit\": lineage_audit\n                }\n\n            # Security: Register ephemeral manifest for this specific chat agent run\n            chat_manifest = create_ephemeral_manifest(run_id, [\"query_graph\", \"search_kb\", \"read_file\", \"get_neighbors\", \"search_knowledge_workspace\"])\n            register_manifest(chat_manifest)\n\n            # Initial track\n            track_workflow_start(run_id, \"chat_graph_agent\", request.workspace, inputs=[request.query])\n            task_manager.create_task(request.workspace, \"chat_graph_agent\", task_id=run_id)\n\n            from .studio_executor import execute_trigger_node, execute_llm_node, execute_data_node\n            final_answer = \"\"\n            nodes_executed = 0\n            \n            for node in sorted_nodes:\n                try:\n                    nodes_executed += 1\n                    if node.type == \"trigger\":\n                        output = await execute_trigger_node(node, request.query, context)\n                    elif node.type == \"llm\":\n                        output = await execute_llm_node(node, context, request.workspace, run_id=run_id, agent_id=run_id)\n                        if output.get(\"response\"):\n                            context[\"llm_output\"] = output[\"response\"]\n                            final_answer = output[\"response\"]\n                    elif node.type == \"data\":\n                        output = await execute_data_node(node, context, request.workspace)\n                    \n                    if output.get(\"error\"):\n                        final_answer = f\"Agent execution stopped at node '{node.id}': {output['error']}\"\n                        break\n                except Exception as e:\n                    track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, str(e))\n                    final_answer = f\"Error in agent reasoning at node '{node.id}': {str(e)}\"\n                    break\n\n            lineage_audit[\"nodes_executed\"] = nodes_executed\n            track_workflow_complete(run_id, \"chat_graph_agent\", request.workspace, [\"reasoning\"], int((datetime.now()-start_time).total_seconds()*1000))\n            task_manager.update_task(run_id, status=\"completed\" if final_answer else \"failed\", progress=100)\n\n            return {\n                \"answer\": final_answer or \"No response generated.\",\n                \"sources\": [\"Neural Graph\", \"Workspace Files\"],\n                \"query\": request.query,\n                \"mode\": \"graph_agent\",\n                \"run_id\": run_id,\n                \"lineage_audit\": lineage_audit\n            }\n\n        # Handle Discovery Swarm Mode (Progressive)\n        if request.mode == \"discovery_swarm\":\n            from ..graph.discovery_swarm import run_discovery_swarm\n            \n            # Pre-check Nexus grounding\n            if not request.active_nexus_id or request.active_nexus_id == \"neural_nexus\":\n                track_workflow_fail(run_id, \"discovery_swarm\", request.workspace, \"nexus_required interruption\")\n                return {\n                    \"answer\": \"\",\n                    \"status\": \"nexus_required\",\n                    \"message\": \"Discovery Swarm requires a grounded Nexus context selection. Use the Map or Forge to select an active Nexus.\",\n                    \"run_id\": run_id,\n                    \"lineage_audit\": lineage_audit\n                }\n\n            track_workflow_start(run_id, \"discovery_swarm\", request.workspace, inputs=[request.query])\n            \n            # Execute the Swarm\n            swarm_result = await run_discovery_swarm(\n                workspace=request.workspace,\n                nexus_id=request.active_nexus_id,\n                query=request.query,\n                run_id=run_id,\n                provider=request.provider,\n                model=request.model\n            )\n            \n            final_report = \"\\n\".join(swarm_result.get(\"findings\", [\"No findings generated.\"]))\n            \n            track_workflow_complete(run_id, \"discovery_swarm\", request.workspace, [\"scouting\", \"planning\"], int((datetime.now()-start_time).total_seconds()*1000))\n            \n            return {\n                \"answer\": swarm_result.get(\"answer\", f\"### Discovery Report\\n\\n{final_report}\"),\n                \"sources\": [\"Neural Graph\"],\n                \"query\": request.query,\n                \"mode\": \"discovery_swarm\",\n                \"run_id\": run_id,\n                \"lineage_audit\": lineage_audit\n            }\n\n        # --- ADAPTIVE / AGENTIC MODE ---\n        # The agent decides whether to retrieve (no_retrieval / single_step /\n        # multi_hop), grades the retrieved chunks, and self-corrects with a\n        # query rewrite if it comes up empty — instead of the legacy always-\n        # prepend. Reads the same `knowledge` collection the Documents panel\n        # ingests into, so ingested PDFs are visible and validatable here.\n        if request.mode in (\"adaptive\", \"agent\"):\n            from ..core.adaptive_rag import run_adaptive_rag\n            track_workflow_start(run_id, \"chat_adaptive_rag\", request.workspace, inputs=[request.query])\n            result = await run_adaptive_rag(\n                query=request.query,\n                workspace=request.workspace,\n                model=request.model,  # None → resolved to the workspace chat model\n            )\n            graded = result.get(\"graded_documents\") or []\n            sources = list({d.get(\"source\", \"Unknown\") for d in graded})\n            answer = result.get(\"generation\") or \"No answer generated.\"\n            track_workflow_complete(\n                run_id, \"chat_adaptive_rag\", request.workspace,\n                result.get(\"execution_trace\", []),\n                int((