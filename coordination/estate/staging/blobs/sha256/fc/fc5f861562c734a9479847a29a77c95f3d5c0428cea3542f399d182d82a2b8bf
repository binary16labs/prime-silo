sonality_flag = bool(binding.default_personality)\n\n    engine = data.engine\n    if engine is None and binding is not None:\n        engine = binding.default_engine\n\n    from .generations import generate_speech\n\n    generation = await generate_speech(\n        models.GenerationRequest(\n            profile_id=profile.id,\n            text=data.text,\n            language=data.language or \"en\",\n            engine=engine,\n            personality=bool(personality_flag),\n        ),\n        db,\n    )\n\n    mcp_events.publish(\n        \"speak-start\",\n        {\n            \"generation_id\": getattr(generation, \"id\", None),\n            \"profile_name\": profile.name,\n            \"source\": \"rest\",\n            \"client_id\": client_id,\n        },\n    )\n    return generation\n","numLines":95,"startLine":1,"totalLines":95}},"sourceToolAssistantUUID":"4ee3c0d8-d513-4d19-b112-ee4699f75317","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\voicebox","sessionId":"e6e3b312-3205-4169-87c7-97704c572fae","version":"2.1.197","gitBranch":"HEAD"}
