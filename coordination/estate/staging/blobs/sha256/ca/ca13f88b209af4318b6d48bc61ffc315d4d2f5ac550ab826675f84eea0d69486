{"parentUuid":"cf129d72-4534-4cf5-b5f2-86aa6856bd69","isSidechain":false,"promptId":"c4150445-08a9-44bc-bcd7-4e370495a643","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016HmHTMVCpDnSbmpqeuHMjm","type":"tool_result","content":"1\t// Desktop system tray for the packaged Prime-Silo shell.\n2\t//\n3\t// Prime-Silo is a long-running cognitive-mesh shell, so it belongs in the tray\n4\t// like its Memo-Ray companion: closing the window hides to tray instead of\n5\t// quitting, and the tray menu reopens the window, opens the app in a browser,\n6\t// surfaces the registry-resolved Memo-Ray endpoint, and quits for real.\n7\t//\n8\t// Wired from main.js after the main window exists. Kept dependency-free beyond\n9\t// electron itself; the Memo-Ray status line reads apps.lock.json directly with\n10\t// a tiny inline walk-up so the tray has no cross-module import.\n11\t\n12\tconst path = require(\"node:path\");\n13\tconst fs = require(\"node:fs\");\n14\tconst { spawn } = require(\"node:child_process\");\n15\tconst { app, Tray, Menu, shell, nativeImage, dialog, ipcMain } = require(\"electron\");\n16\tconst services = require(\"./services\");\n17\t\n18\tconst PROJECT_ROOT = path.resolve(__dirname, \"../..\");\n19\tconst LOCK_FILENAME = \"apps.lock.json\";\n20\tconst LOCK_SCHEMA = \"aamp.lock/1\";\n21\tconst CONFIG_FILENAME = \"prime-silo-config.json\";\n22\t\n23\tlet tray = null;\n24\tlet currentHomeDir = null;\n25\tlet currentBennyHome = null;\n26\tlet bennyRuntimeUp = false;\n27\tlet bennyStatusTimer = null;\n28\t// Latest lifecycle phase pushed by the runtime supervisor (first-run download →\n29\t// start). \"\" = unknown; others: downloading | starting | running | degraded |\n30\t// unavailable | stopped. Drives the status line so the ~380MB first-run fetch is\n31\t// visible instead of looking hung.\n32\tlet runtimePhase = \"\";\n33\tlet menuOptions = null;\n34\t\n35\tfunction getConfigPath() {\n36\t  return path.join(app.getPath(\"userData\"), CONFIG_FILENAME);\n37\t}\n38\t\n39\tfunction readConfig() {\n40\t  try {\n41\t    const configPath = getConfigPath();\n42\t    if (fs.existsSync(configPath)) {\n43\t      return JSON.parse(fs.readFileSync(configPath, \"utf8\")) || {};\n44\t    }\n45\t  } catch {\n46\t    // ignore config read errors\n47\t  }\n48\t  return {};\n49\t}\n50\t\n51\t// Merge a patch into the on-disk config so independent settings (homeDir,\n52\t// bennyHome) never clobber each other.\n53\tfunction writeConfigPatch(patch) {\n54\t  try {\n55\t    const configPath = getConfigPath();\n56\t    fs.mkdirSync(path.dirname(configPath), { recursive: true });\n57\t    const next = { ...readConfig(), ...patch };\n58\t    fs.writeFileSync(configPath, JSON.stringify(next, null, 2), \"utf8\");\n59\t  } catch (error) {\n60\t    console.error(\"[Tray] Failed to write config:\", error);\n61\t  }\n62\t}\n63\t\n64\tfunction readHomeDirectoryConfig() {\n65\t  return readConfig().homeDir || null;\n66\t}\n67\t\n68\tfunction writeHomeDirectoryConfig(homeDir) {\n69\t  writeConfigPatch({ homeDir: homeDir || null });\n70\t}\n71\t\n72\tfunction readBennyHomeConfig() {\n73\t  return readConfig().bennyHome || null;\n74\t}\n75\t\n76\tfunction writeBennyHomeConfig(bennyHome) {\n77\t  writeConfigPatch({ bennyHome: bennyHome || null });\n78\t}\n79\t\n80\t// Open a native terminal rooted at the configured home directory. Best-effort\n81\t// and cross-platform: each branch detaches the child so quitting the tray app\n82\t// never takes the terminal with it. Spawn errors fall through to a fallback so\n83\t// a missing preferred emulator (e.g. Windows Terminal) degrades gracefully.\n84\tfunction openTerminalAt(dir) {\n85\t  if (!dir || !fs.existsSync(dir)) {\n86\t    return;\n87\t  }\n88\t  try {\n89\t    if (process.platform === \"win32\") {\n90\t      // Prefer Windows Terminal; fall back to a cmd window via the shell.\n91\t      const wt = spawn(\"wt.exe\", [\"-d\", dir], { detached: true, stdio: \"ignore\" });\n92\t      wt.on(\"error\", () => {\n93\t        const fallback = spawn(\"cmd.exe\", [\"/c\", \"start\", \"cmd.exe\", \"/K\", `cd /d \"${dir}\"`], {\n94\t          detached: true,\n95\t          stdio: \"ignore\",\n96\t          windowsVerbatimArguments: true\n97\t        });\n98\t        fallback.on(\"error\", (error) => console.error(\"[Tray] Failed to open terminal:\", error));\n99\t        fallback.unref();\n100\t      });\n101\t      wt.unref();\n102\t    } else if (process.platform === \"darwin\") {\n103\t      const child = spawn(\"open\", [\"-a\", \"Terminal\", dir], { detached: true, stdio: \"ignore\" });\n104\t      child.on(\"error\", (error) => console.error(\"[Tray] Failed to open terminal:\", error));\n105\t      child.unref();\n106\t    } else {\n107\t      // Linux: try common emulators in order; first that launches wins.\n108\t      const candidates = [\n109\t        [\"x-terminal-emulator\", []],\n110\t        [\"gnome-terminal\", [`--working-directory=${dir}`]],\n111\t        [\"konsole\", [\"--workdir\", dir]],\n112\t        [\"xfce4-terminal\", [`--working-directory=${dir}`]],\n113\t        [\"xterm\", []]\n114\t      ];\n115\t      const tryNext = (index) => {\n116\t        if (index >= candidates.length) {\n117\t          console.error(\"[Tray] No terminal emulator found to open.\");\n118\t          return;\n119\t        }\n120\t        const [command, args] = candidates[index];\n121\t        const child = spawn(command, args, { cwd: dir, detached: true, stdio: \"ignore\" });\n122\t        child.on(\"error\", () => tryNext(index + 1));\n123\t        child.unref();\n124\t      };\n125\t      tryNext(0);\n126\t    }\n127\t  } catch (error) {\n128\t    console.error(\"[Tray] Failed to open terminal:\", error);\n129\t  }\n130\t}\n131\t\n132\tfunction resolveTrayIcon() {\n133\t  const candidates = process.platform === \"win32\"\n134\t    ? [path.join(__dirname, \"../platforms/windows/icon.ico\")]\n135\t    : [\n136\t        path.join(__dirname, \"../platforms/linux/icons/32x32.png\"),\n137\t        path.join(__dirname, \"../platforms/linux/icons/icon.png\")\n138\t      ];\n139\t  for (const candidate of candidates) {\n140\t    try {\n141\t      const image = nativeImage.createFromPath(candidate);\n142\t      if (!image.isEmpty()) {\n143\t        return image;\n144\t      }\n145\t    } catch {\n146\t      // try next candidate\n147\t    }\n148\t  }\n149\t  return nativeImage.createEmpty();\n150\t}\n151\t\n152\t// Best-effort read of the registry lockfile so the tray can show where Memo-Ray\n153\t// actually listens. Returns the memo-ray url or null.\n154\tfunction readMemorayUrlFromLock() {\n155\t  let dir = PROJECT_ROOT;\n156\t  while (true) {\n157\t    const candidate = path.join(dir, LOCK_FILENAME);\n158\t    if (fs.existsSync(candidate)) {\n159\t      try {\n160\t        const lock = JSON.parse(fs.readFileSync(candidate, \"utf8\"));\n161\t        if (lock && lock.schema === LOCK_SCHEMA && lock.services) {\n162\t          const entry = lock.services[\"memo-ray/memory-graph\"];\n163\t          return entry && entry.url ? entry.url : null;\n164\t        }\n165\t      } catch {\n166\t        return null;\n167\t      }\n168\t      return null;\n169\t    }\n170\t    const parent = path.dirname(dir);\n171\t    if (parent === dir) {\n172\t      return null;\n173\t    }\n174\t    dir = parent;\n175\t  }\n176\t}\n177\t\n178\t// The runtime status line, reflecting the supervisor's lifecycle phase. The\n179\t// first-run download and start-up are surfaced so the tray never just says\n180\t// \"stopped\" while the runtime is actually being fetched/started.\n181\tfunction runtimeStatusLabel(bundledManaged) {\n182\t  switch (runtimePhase) {\n183\t    case \"downloading\":\n184\t      return \"Benny runtime: downloading runtime… (first run)\";\n185\t    case \"starting\":\n186\t      return \"Benny runtime: starting…\";\n187\t    case \"unavailable\":\n188\t      return \"Benny runtime: unavailable (retries next launch)\";\n189\t    default:\n190\t      break;\n191\t  }\n192\t  if (bennyRuntimeUp) {\n193\t    return bundledManaged ? \"Benny runtime: running (bundled)\" : \"Benny runtime: running\";\n194\t  }\n195\t  return runtimePhase === \"degraded\" ? \"Benny runtime: degraded\" : \"Benny runtime: stopped\";\n196\t}\n197\t\n198\tfunction buildMenu(options) {\n199\t  const { showMainWindow, createWindow, getBrowserUrl, requestQuit, runtime } = options;\n200\t  // When a bundled runtime is being supervised in-process, Start/Stop drive it;\n201\t  // otherwise they drive an external Benny install (services.js).\n202\t  const bundledManaged = Boolean(runtime && runtime.isManaged && runtime.isManaged());\n203\t  // The BENNY_HOME the supervisor actually uses (configured override or default).\n204\t  const managedBennyHome = bundledManaged && runtime.homeDir ? String(runtime.homeDir() || \"\") : \"\";\n205\t  const memorayUrl = readMemorayUrlFromLock();\n206\t  const template = [\n207\t    {\n208\t      label: \"Open Prime-Silo\",\n209\t      click: () => {\n210\t        showMainWindow();\n211\t        createWindow();\n212\t      }\n213\t    },\n214\t    {\n215\t      label: \"Open in browser\",\n216\t      click: () => {\n217\t        const url = getBrowserUrl();\n218\t        if (url) {\n219\t          void shell.openExternal(url);\n220\t        }\n221\t      }\n222\t    },\n223\t    { type: \"separator\" },\n224\t    {\n225\t      label: currentHomeDir\n226\t        ? `Home: ${path.basename(currentHomeDir)}`\n227\t        : \"Home: (not configured)\",\n228\t      click: () => {\n229\t        if (currentHomeDir && fs.existsSync(currentHomeDir)) {\n230\t          void shell.openPath(currentHomeDir);\n231\t        }\n232\t      }\n233\t    },\n234\t    {\n235\t      label: \"Open Terminal Here\",\n236\t      enabled: Boolean(currentHomeDir && fs.existsSync(currentHomeDir)),\n237\t      click: () => openTerminalAt(currentHomeDir)\n238\t    },\n239\t    {\n240\t      label: \"Configure Home Directory...\",\n241\t      click: async () => {\n242\t        const result = await dialog.showOpenDialog({\n243\t          title: \"Select Prime-Silo Home Directory\",\n244\t          defaultPath: currentHomeDir || PROJECT_ROOT,\n245\t          properties: [\"openDirectory\"]\n246\t        });\n247\t        if (!result.canceled && result.filePaths.length > 0) {\n248\t          const selectedPath = result.filePaths[0];\n249\t          currentHomeDir = selectedPath;\n250\t          writeHomeDirectoryConfig(selectedPath);\n251\t          if (tray) {\n252\t            tray.setContextMenu(buildMenu(options));\n253\t          }\n254\t        }\n255\t      }\n256\t    },\n257\t    { type: \"separator\" },\n258\t    // ── Benny services ──────────────────────────────────────────────────\n259\t    {\n260\t      label: runtimeStatusLabel(bundledManaged),\n261\t      enabled: false\n262\t    },\n263\t    {\n264\t      label: \"Start Benny services\",\n265\t      click: () => bundledManaged ? void runtime.start() : services.startBennyServices(currentBennyHome)\n266\t    },\n267\t    {\n268\t      label: \"Stop Benny services\",\n269\t      enabled: bennyRuntimeUp,\n270\t      click: () => bundledManaged ? void runtime.stop() : services.stopBennyServices(currentBennyHome)\n271\t    },\n272\t    {\n273\t      // In bundled mode the runtime is already initialised by the supervisor;\n274\t      // this re-runs `benny_cli init` against the bundled home using the bundled\n275\t      // Python (no external Benny needed). Otherwise drive the external install.\n276\t      label: bundledManaged ? \"Re-initialise environment\" : \"Set up environment (init + doctor)\",\n277\t      click: () => {\n278\t        if (!bundledManaged) {\n279\t          services.setupBennyEnvironment(currentBennyHome);\n280\t          return;\n281\t        }\n282\t        // `benny_cli init` requires --home and --profile; the bundle is native.\n283\t        const ctx = runtime.cliContext();\n284\t        services.openBundl