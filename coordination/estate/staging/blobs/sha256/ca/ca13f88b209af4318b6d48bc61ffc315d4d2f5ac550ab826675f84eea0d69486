t self-locates $BENNY_HOME), then falls back to PATH.\n39\tfunction resolveBennyLauncher(configuredHome) {\n40\t  const home = resolveBennyHome(configuredHome);\n41\t  const isWin = process.platform === \"win32\";\n42\t  const launcherName = isWin ? \"benny.cmd\" : \"benny\";\n43\t  if (home) {\n44\t    const binDir = path.join(home, \"bin\");\n45\t    const launcher = path.join(binDir, launcherName);\n46\t    if (fs.existsSync(launcher)) {\n47\t      return { command: launcher, home, binDir, source: \"home\" };\n48\t    }\n49\t  }\n50\t  // PATH fallback — the command exists somewhere on PATH.\n51\t  return { command: launcherName, home, binDir: home ? path.join(home, \"bin\") : \"\", source: \"path\" };\n52\t}\n53\t\n54\t// Open a native console with BENNY_HOME + bin/ on PATH, optionally running a\n55\t// command (e.g. \"up\", \"init\"). Windows is wired fully; macOS/Linux open at the\n56\t// home dir where the self-locating launchers work via ./bin/benny.\n57\tfunction openBennyConsole({ home, binDir, command = \"\" } = {}) {\n58\t  const cwd = home && fs.existsSync(home) ? home : process.cwd();\n59\t  try {\n60\t    if (process.platform === \"win32\") {\n61\t      const setEnv = [];\n62\t      if (home) setEnv.push(`set \"BENNY_HOME=${home}\"`);\n63\t      if (binDir) setEnv.push(`set \"PATH=${binDir};%PATH%\"`);\n64\t      const tail = command ? `benny ${command}` : \"\";\n65\t      const script = [...setEnv, `cd /d \"${cwd}\"`, tail].filter(Boolean).join(\" & \");\n66\t      const child = spawn(\"cmd.exe\", [\"/c\", \"start\", \"cmd.exe\", \"/k\", script], {\n67\t        detached: true, stdio: \"ignore\", windowsVerbatimArguments: true\n68\t      });\n69\t      child.on(\"error\", (error) => console.error(\"[Services] Failed to open Benny console:\", error));\n70\t      child.unref();\n71\t      return true;\n72\t    }\n73\t    const env = { ...process.env };\n74\t    if (home) env.BENNY_HOME = home;\n75\t    if (binDir) env.PATH = `${binDir}${path.delimiter}${env.PATH || \"\"}`;\n76\t    if (process.platform === \"darwin\") {\n77\t      // Terminal.app can't take inline env easily; open at home (launchers self-locate).\n78\t      const child = spawn(\"open\", [\"-a\", \"Terminal\", cwd], { detached: true, stdio: \"ignore\", env });\n79\t      child.on(\"error\", (error) => console.error(\"[Services] Failed to open Benny console:\", error));\n80\t      child.unref();\n81\t      return true;\n82\t    }\n83\t    const candidates = [\n84\t      [\"x-terminal-emulator\", []],\n85\t      [\"gnome-terminal\", [`--working-directory=${cwd}`]],\n86\t      [\"konsole\", [\"--workdir\", cwd]],\n87\t      [\"xterm\", []]\n88\t    ];\n89\t    const tryNext = (i) => {\n90\t      if (i >= candidates.length) {\n91\t        console.error(\"[Services] No terminal emulator found.\");\n92\t        return;\n93\t      }\n94\t      const [cmd, args] = candidates[i];\n95\t      const child = spawn(cmd, args, { cwd, detached: true, stdio: \"ignore\", env });\n96\t      child.on(\"error\", () => tryNext(i + 1));\n97\t      child.unref();\n98\t    };\n99\t    tryNext(0);\n100\t    return true;\n101\t  } catch (error) {\n102\t    console.error(\"[Services] Failed to open Benny console:\", error);\n103\t    return false;\n104\t  }\n105\t}\n106\t\n107\t// Start / stop services by opening a console that runs `benny up` (logs stay\n108\t// visible) / `benny down`. Setup runs `benny init` then `benny doctor`.\n109\tfunction startBennyServices(configuredHome) {\n110\t  const { home, binDir } = resolveBennyLauncher(configuredHome);\n111\t  return openBennyConsole({ home, binDir, command: \"up\" });\n112\t}\n113\t\n114\tfunction stopBennyServices(configuredHome) {\n115\t  const { home, binDir } = resolveBennyLauncher(configuredHome);\n116\t  return openBennyConsole({ home, binDir, command: \"down\" });\n117\t}\n118\t\n119\tfunction setupBennyEnvironment(configuredHome) {\n120\t  const { home, binDir } = resolveBennyLauncher(configuredHome);\n121\t  // init