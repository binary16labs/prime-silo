": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}],\n            temperature=0.4,\n            max_tokens=MAX_TOKENS_PER_TASK,\n            run_id=f\"report-{manifest.id}\",\n        ),\n        timeout=PER_CALL_TIMEOUT_S,\n    )\n    dt = time.monotonic() - t0\n    out = (out or \"\").strip()\n    print(f\"  [{task.id}] {persona or task.node_type}: {len(out)} chars in {dt:.1f}s\", flush=True)\n    return out\n\n\nasync def main(manifest_path: str) -> int:\n    manifest = benny_cli._load_manifest(manifest_path, overrides=None)\n    print(f\"[report] manifest={manifest.id} model={manifest.config.model} tasks={len(manifest.plan.tasks)}\", flush=True)\n\n    sections: dict[str, str] = {}\n    context = \"\"\n    overall_t0 = time.monotonic()\n    for wi, wave in enumerate(_wave_order(manifest)):\n        for task in wave:\n            print(f\"wave {wi}: running {task.id} ...\", flush=True)\n            try:\n                sections[task.id] = await _run_task(task, manifest, context)\n            except asyncio.TimeoutError:\n                sections[task.id] = f\"_(task {task.id} timed out after {PER_CALL_TIMEOUT_S}s)_\"\n                print(f\"  [{task.id}] TIMEOUT\", flush=True)\n            # Thread forward a trimmed handover so context stays bounded.\n            context += f\"\\n\\n## {task.id}\\n{sections[task.id][:2500]}\"\n\n    # Assemble final document (the editorial/output task's text leads if present).\n    out_files = manifest.outputs.files or [\"data_out/report.md\"]\n    out_rel = out_files[0]\n    out_path = get_workspace_path(manifest.workspace) / out_rel\n    out_path.parent.mkdir(parents=True, exist_ok=True)\n\n    body_parts = [f\"# {manifest.name}\\n\", f\"_Generated by {manifest.config.model} — direct sequential runner_\\n\"]\n    for task in manifest.plan.tasks:\n        body_parts.append(f\"\\n## {task.id}\\n\\n{sections.get(task.id, '').strip()}\\n\")\n    out_path.write_text(\"\\n\".join(body_parts), encoding=\"utf-8\")\n\n    total = time.monotonic() - overall_t0\n    words = sum(len(s.split()) for s in sections.values())\n    print(f\"\\n[report] DONE in {total:.1f}s — {words} words -> {out_path}\", flush=True)\n    print(f\"[report] target was {manifest.outputs.word_count_target} words\", flush=True)\n    return 0\n\n\nif __name__ == \"__main__\":\n    mp = sys.argv[1] if len(sys.argv) > 1 else \"manifests/togaf_sad_prime_silo.json\"\n    raise SystemExit(asyncio.run(main(mp)))\n","structuredPatch":[{"oldStart":38,"oldLines":7,"newStart":38,"newLines":23,"lines":[" # the local model writes about the REAL system instead of inventing one."," GROUNDING_FILE = os.environ.get(\"REPORT_GROUNDING\", \"\")"," ","+# Diagram authoring rules — enforced in the prompt so the model emits ONLY","+# portable diagrams. The finalize pass (report_finalize.py) validates and drops","+# anything that slips through, but getting it right here keeps the report whole.","+DIAGRAM_RULES = (","+    \"DIAGRAM RULES (follow exactly):\\n\"","+    \"- Use ONLY Mermaid in fenced ```mermaid blocks. NEVER use PlantUML, @startuml, \"","+    \"or Mermaid C4 (C4Context/C4Container/C4Component) — they do not render in most viewers.\\n\"","+    \"- Allowed diagram types only: flowchart, graph, sequenceDiagram, classDiagram, erDiagram.\\n\"","+    \"- Render C4 context/container/component views as `flowchart TB` with `subgraph` boundaries.\\n\"","+    \"- Render use-case views as `flowchart LR` (actor --> ([Use Case])).\\n\"","+    \"- NO parentheses inside node labels: write `A[Backend API - FastAPI 8005]`, not `A[API (FastAPI)]`.\\n\"","+    \"- Every node ID must be UNIQUE; use `<br/>` for line breaks inside labels.\\n\"","+    \"- In erDiagram, quote entity names that are reserved words: \\\"Class\\\", \\\"Function\\\", \\\"Order\\\", \\\"Type\\\".\\n\"","+    \"- Close every ```mermaid block with its own ``` on its own line. One diagram per block.\"","+)"," ","+"," _GROUNDING_CACHE = None"," "," "]}],"userM