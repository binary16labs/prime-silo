nif __name__ == \"__main__\":\n    mp = sys.argv[1] if len(sys.argv) > 1 else \"manifests/togaf_sad_prime_silo.json\"\n    raise SystemExit(asyncio.run(main(mp)))\n","structuredPatch":[{"oldStart":64,"oldLines":7,"newStart":64,"newLines":7,"lines":["             model,","             [{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}],","             temperature=0.4,","-            max_tokens=1800,","+            max_tokens=MAX_TOKENS_PER_TASK,","             run_id=f\"report-{manifest.id}\",","         ),","         timeout=PER_CALL_TIMEOUT_S,"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"8cef37c0-b605-42d1-ad63-6e97dee04324","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"24644cca-cf95-422d-a482-74215d3f764e","version":"2.1.187","gitBranch":"HEAD"}
