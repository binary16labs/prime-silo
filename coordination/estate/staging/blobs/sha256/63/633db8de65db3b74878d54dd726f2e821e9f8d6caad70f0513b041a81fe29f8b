{"parentUuid":"1fe74239-e404-4259-baaa-03023dc69d29","isSidechain":false,"promptId":"7ac9dae4-c708-4e0b-af85-ea0145de7109","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UaZaZp9LU62UwkWMK4AZqf","type":"tool_result","content":"1\t\"\"\"Deep-produce orchestrator — decompose → fan-out → synthesize → review.\n2\t\n3\tOne goal becomes a composite ``.aamp.view`` (a multi-panel dashboard) by:\n4\t\n5\t  1. **decompose** — one model call turns the goal into a view title + a list of\n6\t     N complementary panel specs.\n7\t  2. **fan-out** — one model call PER panel produces that panel's Markdown. This\n8\t     is where the output exceeds a single call's context / a single render: each\n9\t     panel is generated in its own budget, then assembled.\n10\t  3. **aggregate** — the panels are composed into one ``.aamp.view``.\n11\t  4. **review** — a final model call critiques coherence/gaps; the critique is\n12\t     stored on the view (advisory, not auto-applied).\n13\t\n14\tEvery model call goes through :func:`benny.core.models.call_model` (offline\n15\tguard + logging + lineage). Each stage emits a ``NODE_EXECUTION_STATE``\n16\tgovernance event tagged with the ``run_id`` so the Bridge Runs widgets render\n17\tthe fan-out, and the run is recorded in the same ``run_store`` the Runs list\n18\treads. Fan-out is sequential for now (single local endpoint = a quality win over\n19\tthe single-context ceiling); cross-machine parallelism is a later phase.\n20\t\"\"\"\n21\t\n22\tfrom __future__ import annotations\n23\t\n24\timport asyncio\n25\timport json\n26\timport re\n27\timport time\n28\timport uuid\n29\tfrom datetime import datetime\n30\tfrom typing import Any, Dict, List, Optional\n31\t\n32\tfrom ..core.manifest import RunRecord, RunStatus\n33\tfrom ..core.models import call_model, get_active_model\n34\tfrom ..core.workspace import get_workspace_path\n35\tfrom ..governance.audit import emit_governance_event\n36\t\n37\t\n38\tdef _run_store():\n39\t    \"\"\"Lazily resolve the run store. Imported on first use so merely importing\n40\t    deep_produce does not drag in benny.persistence (and its LangGraph\n41\t    checkpointer) — deep_produce only needs the run-record CRUD.\"\"\"\n42\t    from ..persistence import run_store\n43\t\n44\t    return run_store\n45\t\n46\t\n47\tDEFAULT_PANEL_COUNT = 4\n48\tMAX_PANEL_COUNT = 8\n49\tVIEW_FORMAT = \"aamp.view/1\"\n50\tMANIFEST_ID = \"deep-produce\"\n51\t\n52\t\n53\tdef _now() -> str:\n54\t    return datetime.utcnow().isoformat()\n55\t\n56\t\n57\tdef _slug(text: str, fallback: str) -> str:\n58\t    s = re.sub(r\"[^a-z0-9]+\", \"-\", str(text or \"\").lower()).strip(\"-\")\n59\t    return s or fallback\n60\t\n61\t\n62\tdef _emit_node(\n63\t    workspace: str,\n64\t    run_id: str,\n65\t    node_id: str,\n66\t    status: str,\n67\t    *,\n68\t    reasoning: str = \"\",\n69\t    response: str = \"\",\n70\t    duration_ms: Optional[int] = None,\n71\t) -> None:\n72\t    \"\"\"Emit a NODE_EXECUTION_STATE event the Runs widgets consume. The\n73\t    reasoning_trace widget renders any event whose ``data.outputs.reasoning_trace``\n74\t    is a non-empty string; lineage_timeline lists them on the run timeline.\"\"\"\n75\t    emit_governance_event(\n76\t        \"NODE_EXECUTION_STATE\",\n77\t        {\n78\t            \"run_id\": run_id,\n79\t            \"node_id\": node_id,\n80\t            \"status\": status,\n81\t            \"timestamp\": _now(),\n82\t            \"duration_ms\": duration_ms,\n83\t            \"outputs\": {\"reasoning_trace\": reasoning, \"response\": response},\n84\t        },\n85\t        workspace_id=workspace,\n86\t    )\n87\t\n88\t\n89\tdef _extract_json(text: str) -> Any:\n90\t    \"\"\"Best-effort: pull the first JSON object/array out of a model response,\n91\t    tolerating ```json fences and surrounding prose. Returns None on failure.\"\"\"\n92\t    if not text:\n93\t        return None\n94\t    fenced = re.search(r\"```(?:json)?\\s*(.+?)```\", text, re.DOTALL)\n95\t    candidate = fenced.group(1).strip() if fenced else text.strip()\n96\t    try:\n97\t        return json.loads(candidate)\n98\t    except json.JSONDecodeError:\n99\t        pass\n100\t    match = re.search(r\"(\\{.*\\}|\\[.*\\])\", candidate, re.DOTALL)\n101\t    if match:\n102\t        try:\n103\t            return json.loads(match.group(1))\n104\t        except json.JSONDecodeError:\n105\t            return None\n106\t    return None\n107\t\n108\t\n109\tdef _fallback_panels(goal: str, panel_count: int) -> Dict[str, Any]:\n110\t    titles = [\n111\t        \"Overview\",\n112\t        \"Key details\",\n113\t        \"Risks & considerations\",\n114\t        \"Next steps\",\n115\t        \"Context\",\n116\t        \"Data points\",\n117\t        \"Open questions\",\n118\t        \"Summary\",\n119\t    ]\n120\t    panels = [{\"title\": titles[i % len(titles)], \"focus\": goal} for i in range(panel_count)]\n121\t    return {\"title\": f\"{goal[:80]}\", \"panels\": panels}\n122\t\n123\t\n124\tasync def _decompose(\n125\t    goal: str, model: str, run_id: str, workspace: str, panel_count: int\n126\t) -> Dict[str, Any]:\n127\t    start = time.monotonic()\n128\t    prompt = (\n129\t        f\"You are planning a multi-panel dashboard that thoroughly answers this goal:\\n\\n\"\n130\t        f\"GOAL: {goal}\\n\\n\"\n131\t        f\"Design exactly {panel_count} complementary, non-overlapping panels that together \"\n132\t        f\"cover the goal in depth. Reply with STRICT JSON only, no prose:\\n\"\n133\t        f'{{\"title\": \"<concise dashboard title>\", \"panels\": '\n134\t        f'[{{\"title\": \"<panel title>\", \"focus\": \"<one sentence on what this panel should contain>\"}}]}}'\n135\t    )\n136\t    raw = await call_model(\n137\t        model,\n138\t        [{\"role\": \"user\", \"content\": prompt}],\n139\t        temperature=0.3,\n140\t        max_tokens=1024,\n141\t        run_id=run_id,\n142\t    )\n143\t    parsed = _extract_json(raw)\n144\t    plan: Dict[str, Any]\n145\t    if isinstance(parsed, dict) and isinstance(parsed.get(\"panels\"), list) and parsed[\"panels\"]:\n146\t        plan = parsed\n147\t    elif isinstance(parsed, list) and parsed:\n148\t        plan = {\"title\": goal[:80], \"panels\": parsed}\n149\t    else:\n150\t        plan = _fallback_panels(goal, panel_count)\n151\t    # Normalise + clamp.\n152\t    panels = []\n153\t    for spec in plan[\"panels\"][:panel_count]:\n154\t        if isinstance(spec, str):\n155\t            panels.append({\"title\": spec, \"focus\": goal})\n156\t        elif isinstance(spec, dict):\n157\t            panels.append(\n158\t                {\n159\t                    \"title\": str(spec.get(\"title\") or \"Panel\"),\n160\t                    \"focus\": str(spec.get(\"focus\") or goal),\n161\t                }\n162\t            )\n163\t    if not panels:\n164\t        panels = _fallback_panels(goal, panel_count)[\"panels\"]\n165\t    plan[\"panels\"] = panels\n166\t    plan[\"title\"] = str(plan.get(\"title\") or goal[:80])\n167\t    duration_ms = int((time.monotonic() - start) * 1000)\n168\t    _emit_node(\n169\t        workspace,\n170\t        run_id,\n171\t        \"decompose\",\n172\t        \"success\",\n173\t        reasoning=f\"Decomposed the goal into {len(panels)} panels: \"\n174\t        + \", \".join(p[\"title\"] for p in panels),\n175\t        response=json.dumps(plan),\n176\t        duration_ms=duration_ms,\n177\t    )\n178\t    return plan\n179\t\n180\t\n181\tasync def _produce_panel(\n182\t    panel: Dict[str, Any], goal: str, model: str, run_id: str, workspace: str, index: int\n183\t) -> Dict[str, Any]:\n184\t    start = time.monotonic()\n185\t    title = panel[\"title\"]\n186\t    focus = panel[\"focus\"]\n187\t    prompt = (\n188\t        f\"You are writing ONE panel of a multi-panel dashboard about:\\n{goal}\\n\\n\"\n189\t        f'This panel is titled \"{title}\". Focus: {focus}\\n\\n'\n190\t        f\"Write concise, information-dense Markdown for THIS panel only — no title \"\n191\t        f\"heading (the panel already has one), no preamble, no closing remarks.\"\n192\t    )\n193\t    content = await call_model(\n194\t        model,\n195\t        [{\"role\": \"user\", \"content\": prompt}],\n196\t        temperature=0.6,\n197\t        max_tokens=1536,\n198\t        run_id=run_id,\n199\t    )\n200\t    content = (content or \"\").strip()\n201\t    duration_ms = int((time.monotonic() - start) * 1000)\n202\t    node_id = f\"panel:{index + 1}:{_slug(title, str(index + 1))}\"\n203\t    _emit_node(\n204\t        workspace,\n205\t        run_id,\n206\t        node_id,\n207\t        \"success\",\n208\t        reasoning=f\"Produced panel '{title}' ({len(content)} chars). Focus: {focus}\",\n209\t        response=content,\n210\t        duration_ms=duration_ms,\n211\t    )\n212\t    return {\"id\": f\"panel-{index + 1}\", \"title\": title, \"type\": \"markdown\", \"markdown\": content}\n213\t\n214\t\n215\tasync def _review(view: Dict[str, Any], goal: str, model: str, run_id: str, workspace: str) -> str:\n216\t    start = time.monotonic()\n217\t    outline = \"\\n\".join(f\"- {p['title']}\" for p in view[\"panels\"])\n218\t    prompt = (\n219\t        f\"Critique this multi-panel dashboard for coverage of the goal, coherence, \"\n220\t        f\"overlap, and gaps. Be specific and brief (max ~6 bullet points).\\n\\n\"\n221\t        f\"GOAL: {goal}\\n\\nPANELS:\\n{outline}\"\n222\t    )\n223\t    try:\n224\t        critique = (\n225\t            await call_model(\n226\t                model,\n227\t                [{\"role\": \"user\", \"content\": prompt}],\n228\t                temperature=0.3,\n229\t                max_tokens=768,\n230\t                run_id=run_id,\n231\t            )\n232\t            or \"\"\n233\t        ).strip()\n234\t    except Exception as exc:  # review is advisory — never fail the run on it\n235\t        critique = f\"(review skipped: {exc})\"\n236\t    duration_ms = int((time.monotonic() - start) * 1000)\n237\t    _emit_node(\n238\t        workspace,\n239\t        run_id,\n240\t        \"review\",\n241\t        \"success\",\n242\t        reasoning=critique or \"(no critique returned)\",\n243\t        duration_ms=duration_ms,\n244\t    )\n245\t    return critique\n246\t\n247\t\n248\tdef _fanout_concurrency(model: str, panel_count: int) -> int:\n249\t    \"\"\"How many panels to produce at once: the size of the active model\n250\t    provider's endpoint pool (so multi-machine setups parallelize), clamped to\n251\t    the panel count. Defaults to 1 (sequential) when no pool is configured.\"\"\"\n252\t    try:\n253\t        from ..core.endpoints import get_endpoint_pools\n254\t        from ..core.models import get_model_config\n255\t\n256\t        provider = (get_model_config(model).get(\"provider\") or \"\").lower()\n257\t        pool = get_endpoint_pools().get(provider) or []\n258\t        return max(1, min(len(pool) or 1, panel_count))\n259\t    except Exception:\n260\t        return 1\n261\t\n262\t\n263\tdef _write_view(workspace: str, run_id: str, view: Dict[str, Any]) -> str:\n264\t    \"\"\"Persist the composite view under the workspace's agent_sandbox/views and\n265\t    return the workspace-relative path.\"\"\"\n266\t    views_dir = get_workspace_path(workspace) / \"agent_sandbox\" / \"views\"\n267\t    views_dir.mkdir(parents=True, exist_ok=True)\n268\t    filename = f\"deep-produce-{run_id}.aamp.view\"\n269\t    (views_dir / filename).write_text(json.dumps(view, indent=2), encoding=\"utf-8\")\n270\t    return f\"agent_sandbox/views/{filename}\"\n271\t\n272\t\n273\tasync def deep_produce(\n274\t    goal: str,\n275\t    workspace: str = \"default\",\n276\t    model: Optional[str] = None,\n277\t    panel_count: int = DEFAULT_PANEL_COUNT,\n278\t    run_id: Optional[str] = None,\n279\t) -> Dict[str, Any]:\n280\t    \"\"\"Run the full decompose → fan-out → aggregate → review loop. Records a run\n281\t    and emits per-stage governance events. Retur