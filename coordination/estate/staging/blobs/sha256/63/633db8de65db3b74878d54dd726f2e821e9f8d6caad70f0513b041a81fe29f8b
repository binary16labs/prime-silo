{"parentUuid":"bfdc4c63-7f29-4a3c-95e0-c9c3cf3d8d04","isSidechain":false,"promptId":"7ac9dae4-c708-4e0b-af85-ea0145de7109","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F8wvG4CZHPCb5rNLr6vxd9","type":"tool_result","content":"1\t\"\"\"\n2\tManifest runner — plan-only and manifest-driven execution for SwarmManifest.\n3\t\n4\tTwo entry points:\n5\t\n6\t  plan_from_requirement(...)  → runs planner + wave_scheduler (+ JIT pillar\n7\t                                 expansion up to max_depth) and returns a\n8\t                                 SwarmManifest WITHOUT executing any work.\n9\t\n10\t  execute_manifest(...)       → takes a SwarmManifest and runs the existing\n11\t                                 swarm graph against its pre-built plan. The\n12\t                                 planner is skipped entirely (the manifest IS\n13\t                                 the plan).\n14\t\n15\tThis preserves the plan-then-approve-then-run contract requested in the\n16\tproduct direction doc: the user can review/edit the manifest before paying\n17\tfor execution, and reruns use the exact same manifest deterministically.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport logging\n23\timport uuid\n24\tfrom datetime import datetime\n25\tfrom typing import Any, Dict, List, Optional\n26\t\n27\tfrom langgraph.checkpoint.memory import MemorySaver\n28\t\n29\tfrom ..core.manifest import (\n30\t    ManifestConfig,\n31\t    ManifestEdge,\n32\t    ManifestPlan,\n33\t    ManifestTask,\n34\t    OutputSpec,\n35\t    RunRecord,\n36\t    RunStatus,\n37\t    SwarmManifest,\n38\t    manifest_from_swarm_state,\n39\t    swarm_state_seed_from_manifest,\n40\t)\n41\tfrom ..core.state import SwarmState, create_swarm_state\n42\t\n43\tlogger = logging.getLogger(__name__)\n44\t\n45\t\n46\t# =============================================================================\n47\t# PLAN-ONLY\n48\t# =============================================================================\n49\t\n50\t\n51\tasync def plan_from_requirement(\n52\t    requirement: str,\n53\t    workspace: str = \"default\",\n54\t    model: str = None,  # Must be resolved by caller via LLM Manager\n55\t    input_files: Optional[List[str]] = None,\n56\t    output_spec: Optional[OutputSpec] = None,\n57\t    max_concurrency: int = 1,\n58\t    max_depth: int = 3,\n59\t    manifest_id: Optional[str] = None,\n60\t    name: Optional[str] = None,\n61\t) -> SwarmManifest:\n62\t    \"\"\"Drive planner + wave_scheduler to completion, then return a manifest.\n63\t\n64\t    No executor / dispatcher / aggregator runs. The returned manifest has a\n65\t    complete DAG but `plan.tasks[*].status == PENDING`.\n66\t    \"\"\"\n67\t    # Deferred import: swarm.py has heavy dependencies and we don't want them\n68\t    # to load at manifest-module import time.\n69\t    from .swarm import planner_node, wave_scheduler_node\n70\t\n71\t    manifest_id = manifest_id or f\"manifest-{uuid.uuid4().hex[:12]}\"\n72\t    planning_id = f\"plan-{uuid.uuid4().hex[:12]}\"\n73\t\n74\t    state: SwarmState = create_swarm_state(\n75\t        execution_id=planning_id,\n76\t        workspace=workspace,\n77\t        original_request=requirement,\n78\t        model=model,\n79\t        max_concurrency=max_concurrency,\n80\t        input_files=input_files,\n81\t        output_files=output_spec.files if output_spec else None,\n82\t        config={\"manifest_id\": manifest_id, \"name\": name or \"\", \"plan_only\": True},\n83\t        max_depth=max_depth,\n84\t    )\n85\t\n86\t    # 1. Macro-strategy pass.\n87\t    try:\n88\t        delta = await planner_node(state)\n89\t    except Exception as e:\n90\t        logger.exception(\"plan_from_requirement: macro planner failed\")\n91\t        raise\n92\t    state = _apply_delta(state, delta)\n93\t\n94\t    if state.get(\"status\") == \"failed\":\n95\t        raise RuntimeError(f\"Planner failed: {state.get('errors', ['unknown'])}\")\n96\t\n97\t    # 2. Compute