{"parentUuid":"c0ae2f2f-196f-425e-84f1-59d67c2b6585","isSidechain":false,"promptId":"2fabc661-9f09-4045-8f2a-decda6f488e9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XxT6ixYwizoPdw5hvAw1XA","type":"tool_result","content":"1\t\"\"\"\n2\tAdaptive RAG Pipeline — Self-correcting retrieval with Smart Router.\n3\t\n4\tArchitecture:\n5\t  START → SmartRouter → [NoRetrieval | SingleStep | MultiHop] → \n6\t  GradeDocuments → GenerateAnswer → HallucinationGrader → \n7\t  AnswerGrader → [END | RewriteQuery → loop back]\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport logging\n13\timport json\n14\tfrom typing import TypedDict, Optional, List, Dict, Any, Literal\n15\t\n16\tfrom langgraph.graph import StateGraph, START, END\n17\t\n18\tfrom ..core.models import call_model\n19\tfrom ..core.graph_db import get_driver, multi_hop_traversal  # For multi-hop traversal\n20\tfrom ..core.workspace import get_workspace_path\n21\tfrom ..governance.lineage import track_workflow_start, track_workflow_complete\n22\tfrom ..tools.knowledge import get_chromadb_client, get_knowledge_collection\n23\t\n24\tlogger = logging.getLogger(__name__)\n25\t\n26\t# =============================================================================\n27\t# STATE DEFINITION\n28\t# =============================================================================\n29\t\n30\tclass RetrievedDocument(TypedDict):\n31\t    \"\"\"A single retrieved document with metadata.\"\"\"\n32\t    content: str\n33\t    source: str\n34\t    relevance_score: float  # 0.0 to 1.0, set by RetrieverGrader\n35\t\n36\tclass AdaptiveRAGState(TypedDict):\n37\t    \"\"\"State schema for the Adaptive RAG pipeline.\"\"\"\n38\t    # Input\n39\t    query: str                          # Original user query\n40\t    workspace: str                      # Workspace for ChromaDB/Neo4j scoping\n41\t    model: str                          # LLM model identifier (passed to call_model)\n42\t    \n43\t    # Routing\n44\t    route: Literal[\"no_retrieval\", \"single_step\", \"multi_hop\"]  # Smart Router decision\n45\t    \n46\t    # Retrieval\n47\t    documents: List[RetrievedDocument]   # Raw retrieved documents\n48\t    graded_documents: List[RetrievedDocument]  # Documents that passed relevance grading\n49\t    \n50\t    # Generation\n51\t    generation: Optional[str]           # Generated answer\n52\t    \n53\t    # Quality Control\n54\t    hallucination_check: Optional[bool]  # True = grounded, False = hallucinated\n55\t    answer_quality: Optional[bool]       # True = adequate, False = needs improvement\n56\t    \n57\t    # Self-Correction\n58\t    rewritten_query: Optional[str]       # Refined query for retry\n59\t    retry_count: int                     # Current retry iteration\n60\t    max_retries: int                     # Maximum retries (default 3)\n61\t    \n62\t    # Metadata\n63\t    route_explanation: str               # Why the router chose this route\n64\t    execution_trace: List[str]           # Ordered list of nodes executed\n65\t\n66\t\n67\t# =============================================================================\n68\t# NODE FUNCTIONS\n69\t# =============================================================================\n70\t\n71\tasync def smart_router(state: AdaptiveRAGState) -> dict:\n72\t    \"\"\"Classify the query into no_retrieval, single_step, or multi_hop.\"\"\"\n73\t    logger.info(\"--- NODE: smart_router ---\")\n74\t    \n75\t    system_prompt = \"\"\"You are a smart router for a RAG pipeline.\n76\tYour goal is to classify a user query into one of three routes based on its complexity:\n77\t\n78\t1. `no_retrieval`: Simple factual questions or greetings that can be answered from your internal knowledge.\n79\t   Example: \"What is the capital of France?\", \"Hi\", \"Define GDP\".\n80\t2. `single_step`: Questions requiring a simple document lookup but not complex relational reasoning.\n81\t   Example: \"What does the Frolov report say about AI?\", \"Who is the CEO of Company X?\".\n82\t3. `multi_hop`: Questions requiring cross-document reasoning, entity relationships, or causal chains.\n83\t   Example: \"How would a recession in sector X affect portfolio Y based on the filings?\".\n84\t\n85\tRespond ONLY with a JSON object: {\"route\": \"no_retrieval\" | \"single_step\" | \"multi_hop\", \"explanation\": \"Brief reasoning\"}\"\"\"\n86\t\n87\t    messages = [\n88\t        {\"role\": \"system\", \"content\": system_prompt},\n89\t        {\"role\": \"user\", \"content\": state[\"query\"]}\n90\t    ]\n91\t    \n92\t    try:\n93\t        response = await call_model(model=state[\"model\"], messages=messages, temperature=0.0)\n94\t        # Handle cases where response might be wrapped in ```json ... ```\n95\t        clean_response = response.strip()\n96\t        if clean_response.startswith(\"```json\"):\n97\t            clean_response = clean_response[7:-3].strip()\n98\t        elif clean_response.startswith(\"```\"):\n99\t            clean_response = clean_response[3:-3].strip()\n100\t            \n101\t        parsed = json.loads(clean_response)\n102\t        route = parsed.get(\"route\", \"single_step\")\n103\t        explanation = parsed.get(\"explanation\", \"\")\n104\t    except Exception as e:\n105\t        logger.warning(f\"Router failed to parse LLM response: {e}. Response: {response}\")\n106\t        route = \"single_step\"\n107\t        explanation = \"Defaulted to single_step due to parsing error\"\n108\t\n109\t    return {\n110\t        \"route\": route, \n111\t        \"route_explanation\": explanation, \n112\t        \"execution_trace\": state.get(\"execution_trace\", []) + [\"smart_router\"]\n113\t    }\n114\t\n115\t\n116\tasync def retrieve_single_step(state: AdaptiveRAGState) -> dict:\n117\t    \"\"\"Retrieve documents from ChromaDB.\"\"\"\n118\t    logger.info(\"--- NODE: retrieve_single_step ---\")\n119\t    \n120\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n121\t    workspace = state[\"workspace\"]\n122\t    \n123\t    try:\n124\t        client = get_chromadb_client(workspace)\n125\t        collection = get_knowledge_collection(client)\n126\t        \n127\t        results = collection.query(\n128\t            query_texts=[query],\n129\t            n_results=10\n130\t        )\n131\t        \n132\t        documents = []\n133\t        if results and results[\"documents\"] and results[\"documents\"][0]:\n134\t            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n135\t                documents.append({\n136\t                    \"content\": doc,\n137\t                    \"source\": meta.get(\"source\", \"Unknown\"),\n138\t                    \"relevance_score\": 0.0\n139\t                })\n140\t        \n141\t        return {\n142\t            \"documents\": documents,\n143\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n144\t        }\n145\t    except Exception as e:\n146\t        logger.error(f\"Retrieval failed: {e}\")\n147\t        return {\n148\t            \"documents\": [],\n149\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n150\t        }\n151\t\n152\t\n153\tasync def retrieve_multi_hop(state: AdaptiveRAGState) -> dict:\n154\t    \"\"\"Retrieve from ChromaDB and perform multi-hop graph traversal.\"\"\"\n155\t    logger.info(\"--- NODE: retrieve_multi_hop ---\")\n156\t    \n157\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n158\t    workspace = state[\"workspace\"]\n159\t    \n160\t    # 1. ChromaDB Retrieval\n161\t    chroma_docs = []\n162\t    try:\n163\t        client = get_chromadb_client(workspace)\n164\t        collection = get_knowledge_collection(client)\n165\t        results = collection.query(query_texts=[query], n_results=10)\n166\t        if results and results[\"documents\"] and results[\"documents\"][0]:\n167\t            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n168\t                chroma_docs.append({\n169\t                    \"content\": doc,\n170\t                    \"source\": meta.get(\"source\", \"Unknown\"),\n171\t                    \"relevance_score\": 0.0\n172\t                })\n173\t    except Exception as e:\n174\t        logger.error(f\"ChromaDB retrieval failed in multi-hop: {e}\")\n175\t\n176\t    # 2. Neo4j Multi-Hop Traversal\n177\t    graph_docs = multi_hop_traversal(query, workspace=workspace)\n178\t    formatted_graph_docs = []\n179\t    for gdoc in graph_docs:\n180\t        formatted_graph_docs.append({\n181\t            \"content\": gdoc[\"content\"],\n182\t            \"source\": gdoc[\"source\"],\n183\t            \"relevance_score\": 0.0\n184\t        })\n185\t\n186\t    # Merge and deduplicate (by source/content simplified)\n187\t    merged = chroma_docs + formatted_graph_docs\n188\t    seen = set()\n189\t    deduped = []\n190\t    for d in merged:\n191\t        if d[\"content\"] not in seen:\n192\t            deduped.append(d)\n193\t            seen.add(d[\"content\"])\n194\t\n195\t    return {\n196\t        \"documents\": deduped,\n197\t        \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_multi_hop\"]\n198\t    }\n199\t\n200\t\n201\tasync def grade_documents(state: AdaptiveRAGState) -> dict:\n202\t    \"\"\"Grade documents for relevance.\"\"\"\n203\t    logger.info(\"--- NODE: grade_documents ---\")\n204\t    \n205\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n206\t    documents = state[\"documents\"]\n207\t    graded_documents = []\n208\t    \n209\t    for doc in documents:\n210\t        system_prompt = \"\"\"You are a relevance grader. Given a document and a user question, evaluate if the document is relevant to answering the question.\n211\tRespond with ONLY 'yes' or 'no'.\"\"\"\n212\t        \n213\t        user_prompt = f\"Question: {query}\\n\\nDocument: {doc['content']}\"\n214\t        \n215\t        try:\n216\t            response = await call_model(model=state[\"model\"], messages=[\n217\t                {\"role\": \"system\", \"content\": system_prompt},\n218\t                {\"role\": \"user\", \"content\": user_prompt}\n219\t            ], temperature=0.0)\n220\t            \n221\t            if \"yes\" in response.lower():\n222\t                doc[\"relevance_score\"] = 1.0\n223\t                graded_documents.append(doc)\n224\t        except Exception as e:\n225\t            logger.warning(f\"Grading failed for doc: {e}\")\n226\t\n227\t    return {\n228\t        \"graded_documents\": graded_documents,\n229\t        \"execution_trace\": state.get(\"execution_trace\", []) + [\"grade_documents\"]\n230\t    }\n231\t\n232\t\n233\tasync def generate_answer(state: AdaptiveRAGState) -> dict:\n234\t    \"\"\"Generate the answer based on context or parametric knowledge.\"\"\"\n235\t    logger.info(\"--- NODE: generate_answer ---\")\n236\t    \n237\t    query = state.get(\"rewritten_query\") or state[\"query\"]\n238\t    route = state[\"route\"]\n239\t    graded_docs = state[\"graded_documents\"]\n240\t    \n241\t    if route == \"no_retrieval\":\n242\t        system_prompt = \"You are a helpful research assistant. Answer the question accurately based on your knowledge.\"\n243\t        context_str = \"No external context used.\"\n244\t    else:\n245\t        system_prompt = \"\"\"You are a helpful research assistant. Answer the question based STRICTLY on the provided context. \n246\tIf the context doesn't contain the answer, say so explicitly.\"\"\"\n247\t        context_str = \"\\n\".join([f\"[Source: {d['source']}]\\n{d['content']}\" for d in graded_docs])\n248\t\n249\t    user_prompt = f\"CONTEXT:\\n{context_str}\\n\\nQUESTION: {query}\"\n250\t    \n251\t    try:\n252\t        generation = await call_model(model=state[\"model\"], messages=[\n253\t            {\"role\": \"system\", \"content\": system_prompt},\n254\t            {\"role\": \"user\", \"content\": user_prompt}\n255\t        ])\n256\t        \n257\t        return {\n258\t            \"generation\": generation,\n259\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n260\t        }\n261\t    except Exception as e:\n262\t        logger.error(f\"Generation failed: {e}\")\n263\t        return {\n264\t            \"generation\": f\"Error generating answer: {str(e)}\",\n265\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n266\t        }\n267\t\n268\t\n269\tasync def check_hallucination(state: AdaptiveRAGState) -> dict:\n270\t    \"\"\"Check if the answer is grounded in the documents.\"\"\"\n271\t    logger.info(\"--- NODE: check_hallucination ---\")\n272\t    \n273\t    if state[\"route\"] == \"no_retrieval\":\n274\t        return {\"hallucination_check\": True, \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]}\n275\t    \n276\t    graded_docs = state[\"graded_documents\"]\n277\t    generation = state[\"generation\"]\n278\t    \n279\t    context_str = \"\\n\".join([d['content'] for d in graded_docs])\n280\t    \n281\t    system_prompt = \"\"\"You are a hallucination grader. evaluate if the generated answer is fully grounded in the provided facts.\n282\tRespond with ONLY 'yes' if it is grounded, or 'no' if it contains hallucinations or unverified info.\"\"\"\n283\t    \n284\t    user_prompt = f\"FACTS:\\n{context_str}\\n\\nANSWER:\\n{generation}\"\n285\t    \n286\t    try:\n287\t        response = await call_model(model=state[\"model\"], messages=[\n288\t            {\"role\": \"system\", \"content\": system_prompt},\n289\t            {\"role\": \"user\", \"content\": user_prompt}\n290\t        ], temperature=0.0)\n291\t        \n292\t        is_grounded = \"yes\" in response.lower()\n293\t        return {\n294\t            \"hallucination_check\": is_grounded,\n295\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]\n296\t        }\n297\t    except Exception as e:\n298\t        logger.warning(f\"Hallucination check failed: {e}\")\n299\t        return {\"hallucination_check\": True} # Default to true on error to avoid loops\n300\t\n301\t\n302\tasync def check_answer_quality(state: AdaptiveRAGState) -> dict:\n303\t    \"\"\"Check if the answer addresses the user query.\"\"\"\n304\t    logger.info(\"--- NODE: check_answer_quality ---\")\n305\t    \n306\t    query = state[\"query\"]\n307\t    generation = state[\"generation\"]\n308\t    \n309\t    system_prompt = \"\"\"You are a quality grader. Does the following answer adequately address the original question? Is it complete and useful? \n310\tRespond with ONLY 'yes' or 'no'.\"\"\"\n311\t    \n312\t    user_prompt = f\"QUESTION: {query}\\n\\nANSWER: {generation}\"\n313\t    \n314\t    try:\n315\t        response = await call_model(model=state[\"model\"], messages=[\n316\t            {\"role\": \"system\", \"content\": system_prompt},\n317\t            {\"role\": \"user\", \"content\": user_prompt}\n318\t        ], temperature=0.0)\n319\t        \n320\t        is_adequate = \"yes\" in response.lower()\n321\t        return {\n322\t            \"answer_quality\": is_adequate,\n323\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_answer_quality\"]\n324\t        }\n325\t    except Exception as e:\n326\t        logger.warning(f\"Quality check failed: {e}\")\n327\t        return {\"answer_quality\": True}\n328\t\n329\t\n330\tasync def rewrite_query(state: AdaptiveRAGState) -> dict:\n331\t    \"\"\"Rewrite the query for better retrieval.\"\"\"\n332\t    logger.info(\"--- NODE: rewrite_query ---\")\n333\t    \n334\t    query = state[\"query\"]\n335\t    \n336\t    system_prompt = \"\"\"The following question did not produce a satisfactory answer. \n337\tRewrite it to be more specific and searchable for a vector database. \n338\tReturn ONLY the rewritten question, nothing else.\"\"\"\n339\t    \n340\t    try:\n341\t        new_query = await call_model(model=state[\"model\"], messages=[\n342\t            {\"role\": \"system\", \"content\": system_prompt},\n343\t            {\"role\": \"user\", \"content\": query}\n344\t        ])\n345\t        \n346\t        return {\n347\t            \"rewritten_query\": new_query.strip(),\n348\t            \"retry_count\": state[\"retry_count\"] + 1,\n349\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n350\t        }\n351\t    except Exception as e:\n352\t        logger.warning(f\"Query rewrite failed: {e}\")\n353\t        return {\n354\t            \"retry_count\": state[\"retry_count\"] + 1,\n355\t            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n356\t        }\n357\t\n358\t\n359\t# =============================================================================\n360\t# ROUTING FUNCTIONS\n361\t# =============================================================================\n362\t\n363\tdef route_query(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"retrieve_single_step\", \"retrieve_multi_hop\"]:\n364\t    \"\"\"Route after smart_router based on the classified route.\"\"\"\n365\t    route = state.get(\"route\", \"single_step\")\n366\t    if route == \"no_retrieval\":\n367\t        return \"generate_answer\"\n368\t    elif route == \"multi_hop\":\n369\t        return \"retrieve_multi_hop\"\n370\t    else:\n371\t        return \"retrieve_single_step\"\n372\t\n373\tdef after_grading(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"rewrite_query\"]:\n374\t    \"\"\"After grading, decide: generate or rewrite.\"\"\"\n375\t    graded = state.get(\"graded_documents\", [])\n376\t    if len(graded) == 0 and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n377\t        return \"rewrite_query\"\n378\t    return \"generate_answer\"\n379\t\n380\tdef after_hallucination_check(state: AdaptiveRAGState) -> Literal[\"check_answer_quality\", \"rewrite_query\"]:\n381\t    \"\"\"After hallucination check: if hallucinated and retries left, rewrite.\"\"\"\n382\t    if not state.get(\"hallucination_check\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n383\t        return \"rewrite_query\"\n384\t    return \"check_answer_quality\"\n385\t\n386\tdef after_answer_quality(state: AdaptiveRAGState) -> Literal[\"__end__\", \"rewrite_query\"]:\n387\t    \"\"\"After answer quality check: if poor and retries left, rewrite.\"\"\"\n388\t    if not state.get(\"answer_quality\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n389\t        return \"rewrite_query\"\n390\t    return \"__end__\"\n391\t\n392\tdef after_rewrite(state: AdaptiveRAGState) -> Literal[\"retrieve_single_step\", \"retrieve_multi_hop\"]:\n393\t    \"\"\"After rewrite, go back to retrieval using the original route.\"\"\"\n394\t    route = state.get(\"route\", \"single_step\")\n395\t    if route == \"multi_hop\":\n396\t        return \"retrieve_multi_hop\"\n397\t    return \"retrieve_single_step\"\n398\t\n399\t\n400\t# =============================================================================\n401\t# GRAPH CONSTRUCTION\n402\t# =============================================================================\n403\t\n404\tdef build_adaptive_rag_graph() -> StateGraph:\n405\t    \"\"\"Build the Adaptive RAG LangGraph.\"\"\"\n406\t    graph = StateGraph(AdaptiveRAGState)\n407\t    \n408\t    # Add nodes\n409\t    graph.add_node(\"smart_router\", smart_router)\n410\t    graph.add_node(\"retrieve_single_step\", retrieve_single_step)\n411\t    graph.add_node(\"retrieve_multi_hop\", retrieve_multi_hop)\n412\t    graph.add_node(\"grade_documents\", grade_documents)\n413\t    graph.add_node(\"generate_answer\", generate_answer)\n414\t    graph.add_node(\"check_hallucination\", check_hallucination)\n415\t    graph.add_node(\"check_answer_quality\", check_answer_quality)\n416\t    graph.add_node(\"rewrite_query\", rewrite_query)\n417\t    \n418\t    # Edges\n419\t    graph.add_edge(START, \"smart_router\")\n420\t    graph.add_conditional_edges(\"smart_router\", route_query, {\n421\t        \"generate_answer\": \"generate_answer\",\n422\t        \"retrieve_single_step\": \"retrieve_single_step\",\n423\t        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n424\t    })\n425\t    graph.add_edge(\"retrieve_single_step\", \"grade_documents\")\n426\t    graph.add_edge(\"retrieve_multi_hop\", \"grade_documents\")\n427\t    graph.add_conditional_edges(\"grade_documents\", after_grading, {\n428\t        \"generate_answer\": \"generate_answer\",\n429\t        \"rewrite_query\": \"rewrite_query\",\n430\t    })\n431\t    \n432\t    # For generate_answer, skip hallucination check if no_retrieval\n433\t    graph.add_conditional_edges(\"generate_answer\", lambda s: \"check_answer_quality\" if s[\"route\"] == \"no_retrieval\" else \"check_hallucination\", {\n434\t        \"check_hallucination\": \"check_hallucination\",\n435\t        \"check_answer_quality\": \"check_answer_quality\",\n436\t    })\n437\t    \n438\t    graph.add_conditional_edges(\"check_hallucination\", after_hallucination_check, {\n439\t        \"check_answer_quality\": \"check_answer_quality\",\n440\t        \"rewrite_query\": \"rewrite_query\",\n441\t    })\n442\t    \n443\t    graph.add_conditional_edges(\"check_answer_quality\", after_answer_quality, {\n444\t        \"__end__\": END,\n445\t        \"rewrite_query\": \"rewrite_query\",\n446\t    })\n447\t    \n448\t    graph.add_conditional_edges(\"rewrite_query\", after_rewrite, {\n449\t        \"retrieve_single_step\": \"retrieve_single_step\",\n450\t        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n451\t    })\n452\t    \n453\t    return graph.compile()\n454\t\n455\t\n456\tasync def run_adaptive_rag(\n457\t    query: str,\n458\t    workspace: str = \"default\",\n459\t    model: str = \"Qwen3-8B-Hybrid\",\n460\t    max_retries: int = 3\n461\t) -> AdaptiveRAGState:\n462\t    \"\"\"Execute the Adaptive RAG pipeline.\"\"\"\n463\t    graph = build_adaptive_rag_graph()\n464\t    \n465\t    initial_state: AdaptiveRAGState = {\n466\t        \"query\": query,\n467\t        \"workspace\": workspace,\n468\t        \"model\": model,\n469\t        \"route\": \"single_step\",  # Will be overwritten by smart_router\n470\t        \"documents\": [],\n471\t        \"graded_documents\": [],\n472\t        \"generation\": None,\n473\t        \"hallucination_check\": None,\n474\t        \"answer_quality\": None,\n475\t        \"rewritten_query\": None,\n476\t        \"retry_count\": 0,\n477\t        \"max_retries\": max_retries,\n478\t        \"route_explanation\": \"\",\n479\t        \"execution_trace\": [],\n480\t    }\n481\t    \n482\t    result = await graph.ainvoke(initial_state)\n483\t    return result\n484\t"}]},"uuid":"69dc8190-cf30-4dc6-b568-5373dc5bef6d","timestamp":"2026-06-20T17:13:15.345Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\adaptive_rag.py","content":"\"\"\"\nAdaptive RAG Pipeline — Self-correcting retrieval with Smart Router.\n\nArchitecture:\n  START → SmartRouter → [NoRetrieval | SingleStep | MultiHop] → \n  GradeDocuments → GenerateAnswer → HallucinationGrader → \n  AnswerGrader → [END | RewriteQuery → loop back]\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport json\nfrom typing import TypedDict, Optional, List, Dict, Any, Literal\n\nfrom langgraph.graph import StateGraph, START, END\n\nfrom ..core.models import call_model\nfrom ..core.graph_db import get_driver, multi_hop_traversal  # For multi-hop traversal\nfrom ..core.workspace import get_workspace_path\nfrom ..governance.lineage import track_workflow_start, track_workflow_complete\nfrom ..tools.knowledge import get_chromadb_client, get_knowledge_collection\n\nlogger = logging.getLogger(__name__)\n\n# =============================================================================\n# STATE DEFINITION\n# =============================================================================\n\nclass RetrievedDocument(TypedDict):\n    \"\"\"A single retrieved document with metadata.\"\"\"\n    content: str\n    source: str\n    relevance_score: float  # 0.0 to 1.0, set by RetrieverGrader\n\nclass AdaptiveRAGState(TypedDict):\n    \"\"\"State schema for the Adaptive RAG pipeline.\"\"\"\n    # Input\n    query: str                          # Original user query\n    workspace: str                      # Workspace for ChromaDB/Neo4j scoping\n    model: str                          # LLM model identifier (passed to call_model)\n    \n    # Routing\n    route: Literal[\"no_retrieval\", \"single_step\", \"multi_hop\"]  # Smart Router decision\n    \n    # Retrieval\n    documents: List[RetrievedDocument]   # Raw retrieved documents\n    graded_documents: List[RetrievedDocument]  # Documents that passed relevance grading\n    \n    # Generation\n    generation: Optional[str]           # Generated answer\n    \n    # Quality Control\n    hallucination_check: Optional[bool]  # True = grounded, False = hallucinated\n    answer_quality: Optional[bool]       # True = adequate, False = needs improvement\n    \n    # Self-Correction\n    rewritten_query: Optional[str]       # Refined query for retry\n    retry_count: int                     # Current retry iteration\n    max_retries: int                     # Maximum retries (default 3)\n    \n    # Metadata\n    route_explanation: str               # Why the router chose this route\n    execution_trace: List[str]           # Ordered list of nodes executed\n\n\n# =============================================================================\n# NODE FUNCTIONS\n# =============================================================================\n\nasync def smart_router(state: AdaptiveRAGState) -> dict:\n    \"\"\"Classify the query into no_retrieval, single_step, or multi_hop.\"\"\"\n    logger.info(\"--- NODE: smart_router ---\")\n    \n    system_prompt = \"\"\"You are a smart router for a RAG pipeline.\nYour goal is to classify a user query into one of three routes based on its complexity:\n\n1. `no_retrieval`: Simple factual questions or greetings that can be answered from your internal knowledge.\n   Example: \"What is the capital of France?\", \"Hi\", \"Define GDP\".\n2. `single_step`: Questions requiring a simple document lookup but not complex relational reasoning.\n   Example: \"What does the Frolov report say about AI?\", \"Who is the CEO of Company X?\".\n3. `multi_hop`: Questions requiring cross-document reasoning, entity relationships, or causal chains.\n   Example: \"How would a recession in sector X affect portfolio Y based on the filings?\".\n\nRespond ONLY with a JSON object: {\"route\": \"no_retrieval\" | \"single_step\" | \"multi_hop\", \"explanation\": \"Brief reasoning\"}\"\"\"\n\n    messages = [\n        {\"role\": \"system\", \"content\": system_prompt},\n        {\"role\": \"user\", \"content\": state[\"query\"]}\n    ]\n    \n    try:\n        response = await call_model(model=state[\"model\"], messages=messages, temperature=0.0)\n        # Handle cases where response might be wrapped in ```json ... ```\n        clean_response = response.strip()\n        if clean_response.startswith(\"```json\"):\n            clean_response = clean_response[7:-3].strip()\n        elif clean_response.startswith(\"```\"):\n            clean_response = clean_response[3:-3].strip()\n            \n        parsed = json.loads(clean_response)\n        route = parsed.get(\"route\", \"single_step\")\n        explanation = parsed.get(\"explanation\", \"\")\n    except Exception as e:\n        logger.warning(f\"Router failed to parse LLM response: {e}. Response: {response}\")\n        route = \"single_step\"\n        explanation = \"Defaulted to single_step due to parsing error\"\n\n    return {\n        \"route\": route, \n        \"route_explanation\": explanation, \n        \"execution_trace\": state.get(\"execution_trace\", []) + [\"smart_router\"]\n    }\n\n\nasync def retrieve_single_step(state: AdaptiveRAGState) -> dict:\n    \"\"\"Retrieve documents from ChromaDB.\"\"\"\n    logger.info(\"--- NODE: retrieve_single_step ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    workspace = state[\"workspace\"]\n    \n    try:\n        client = get_chromadb_client(workspace)\n        collection = get_knowledge_collection(client)\n        \n        results = collection.query(\n            query_texts=[query],\n            n_results=10\n        )\n        \n        documents = []\n        if results and results[\"documents\"] and results[\"documents\"][0]:\n            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n                documents.append({\n                    \"content\": doc,\n                    \"source\": meta.get(\"source\", \"Unknown\"),\n                    \"relevance_score\": 0.0\n                })\n        \n        return {\n            \"documents\": documents,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n        }\n    except Exception as e:\n        logger.error(f\"Retrieval failed: {e}\")\n        return {\n            \"documents\": [],\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_single_step\"]\n        }\n\n\nasync def retrieve_multi_hop(state: AdaptiveRAGState) -> dict:\n    \"\"\"Retrieve from ChromaDB and perform multi-hop graph traversal.\"\"\"\n    logger.info(\"--- NODE: retrieve_multi_hop ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    workspace = state[\"workspace\"]\n    \n    # 1. ChromaDB Retrieval\n    chroma_docs = []\n    try:\n        client = get_chromadb_client(workspace)\n        collection = get_knowledge_collection(client)\n        results = collection.query(query_texts=[query], n_results=10)\n        if results and results[\"documents\"] and results[\"documents\"][0]:\n            for doc, meta in zip(results[\"documents\"][0], results[\"metadatas\"][0]):\n                chroma_docs.append({\n                    \"content\": doc,\n                    \"source\": meta.get(\"source\", \"Unknown\"),\n                    \"relevance_score\": 0.0\n                })\n    except Exception as e:\n        logger.error(f\"ChromaDB retrieval failed in multi-hop: {e}\")\n\n    # 2. Neo4j Multi-Hop Traversal\n    graph_docs = multi_hop_traversal(query, workspace=workspace)\n    formatted_graph_docs = []\n    for gdoc in graph_docs:\n        formatted_graph_docs.append({\n            \"content\": gdoc[\"content\"],\n            \"source\": gdoc[\"source\"],\n            \"relevance_score\": 0.0\n        })\n\n    # Merge and deduplicate (by source/content simplified)\n    merged = chroma_docs + formatted_graph_docs\n    seen = set()\n    deduped = []\n    for d in merged:\n        if d[\"content\"] not in seen:\n            deduped.append(d)\n            seen.add(d[\"content\"])\n\n    return {\n        \"documents\": deduped,\n        \"execution_trace\": state.get(\"execution_trace\", []) + [\"retrieve_multi_hop\"]\n    }\n\n\nasync def grade_documents(state: AdaptiveRAGState) -> dict:\n    \"\"\"Grade documents for relevance.\"\"\"\n    logger.info(\"--- NODE: grade_documents ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    documents = state[\"documents\"]\n    graded_documents = []\n    \n    for doc in documents:\n        system_prompt = \"\"\"You are a relevance grader. Given a document and a user question, evaluate if the document is relevant to answering the question.\nRespond with ONLY 'yes' or 'no'.\"\"\"\n        \n        user_prompt = f\"Question: {query}\\n\\nDocument: {doc['content']}\"\n        \n        try:\n            response = await call_model(model=state[\"model\"], messages=[\n                {\"role\": \"system\", \"content\": system_prompt},\n                {\"role\": \"user\", \"content\": user_prompt}\n            ], temperature=0.0)\n            \n            if \"yes\" in response.lower():\n                doc[\"relevance_score\"] = 1.0\n                graded_documents.append(doc)\n        except Exception as e:\n            logger.warning(f\"Grading failed for doc: {e}\")\n\n    return {\n        \"graded_documents\": graded_documents,\n        \"execution_trace\": state.get(\"execution_trace\", []) + [\"grade_documents\"]\n    }\n\n\nasync def generate_answer(state: AdaptiveRAGState) -> dict:\n    \"\"\"Generate the answer based on context or parametric knowledge.\"\"\"\n    logger.info(\"--- NODE: generate_answer ---\")\n    \n    query = state.get(\"rewritten_query\") or state[\"query\"]\n    route = state[\"route\"]\n    graded_docs = state[\"graded_documents\"]\n    \n    if route == \"no_retrieval\":\n        system_prompt = \"You are a helpful research assistant. Answer the question accurately based on your knowledge.\"\n        context_str = \"No external context used.\"\n    else:\n        system_prompt = \"\"\"You are a helpful research assistant. Answer the question based STRICTLY on the provided context. \nIf the context doesn't contain the answer, say so explicitly.\"\"\"\n        context_str = \"\\n\".join([f\"[Source: {d['source']}]\\n{d['content']}\" for d in graded_docs])\n\n    user_prompt = f\"CONTEXT:\\n{context_str}\\n\\nQUESTION: {query}\"\n    \n    try:\n        generation = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt}\n        ])\n        \n        return {\n            \"generation\": generation,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n        }\n    except Exception as e:\n        logger.error(f\"Generation failed: {e}\")\n        return {\n            \"generation\": f\"Error generating answer: {str(e)}\",\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"generate_answer\"]\n        }\n\n\nasync def check_hallucination(state: AdaptiveRAGState) -> dict:\n    \"\"\"Check if the answer is grounded in the documents.\"\"\"\n    logger.info(\"--- NODE: check_hallucination ---\")\n    \n    if state[\"route\"] == \"no_retrieval\":\n        return {\"hallucination_check\": True, \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]}\n    \n    graded_docs = state[\"graded_documents\"]\n    generation = state[\"generation\"]\n    \n    context_str = \"\\n\".join([d['content'] for d in graded_docs])\n    \n    system_prompt = \"\"\"You are a hallucination grader. evaluate if the generated answer is fully grounded in the provided facts.\nRespond with ONLY 'yes' if it is grounded, or 'no' if it contains hallucinations or unverified info.\"\"\"\n    \n    user_prompt = f\"FACTS:\\n{context_str}\\n\\nANSWER:\\n{generation}\"\n    \n    try:\n        response = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt}\n        ], temperature=0.0)\n        \n        is_grounded = \"yes\" in response.lower()\n        return {\n            \"hallucination_check\": is_grounded,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_hallucination\"]\n        }\n    except Exception as e:\n        logger.warning(f\"Hallucination check failed: {e}\")\n        return {\"hallucination_check\": True} # Default to true on error to avoid loops\n\n\nasync def check_answer_quality(state: AdaptiveRAGState) -> dict:\n    \"\"\"Check if the answer addresses the user query.\"\"\"\n    logger.info(\"--- NODE: check_answer_quality ---\")\n    \n    query = state[\"query\"]\n    generation = state[\"generation\"]\n    \n    system_prompt = \"\"\"You are a quality grader. Does the following answer adequately address the original question? Is it complete and useful? \nRespond with ONLY 'yes' or 'no'.\"\"\"\n    \n    user_prompt = f\"QUESTION: {query}\\n\\nANSWER: {generation}\"\n    \n    try:\n        response = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": user_prompt}\n        ], temperature=0.0)\n        \n        is_adequate = \"yes\" in response.lower()\n        return {\n            \"answer_quality\": is_adequate,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"check_answer_quality\"]\n        }\n    except Exception as e:\n        logger.warning(f\"Quality check failed: {e}\")\n        return {\"answer_quality\": True}\n\n\nasync def rewrite_query(state: AdaptiveRAGState) -> dict:\n    \"\"\"Rewrite the query for better retrieval.\"\"\"\n    logger.info(\"--- NODE: rewrite_query ---\")\n    \n    query = state[\"query\"]\n    \n    system_prompt = \"\"\"The following question did not produce a satisfactory answer. \nRewrite it to be more specific and searchable for a vector database. \nReturn ONLY the rewritten question, nothing else.\"\"\"\n    \n    try:\n        new_query = await call_model(model=state[\"model\"], messages=[\n            {\"role\": \"system\", \"content\": system_prompt},\n            {\"role\": \"user\", \"content\": query}\n        ])\n        \n        return {\n            \"rewritten_query\": new_query.strip(),\n            \"retry_count\": state[\"retry_count\"] + 1,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n        }\n    except Exception as e:\n        logger.warning(f\"Query rewrite failed: {e}\")\n        return {\n            \"retry_count\": state[\"retry_count\"] + 1,\n            \"execution_trace\": state.get(\"execution_trace\", []) + [\"rewrite_query\"]\n        }\n\n\n# =============================================================================\n# ROUTING FUNCTIONS\n# =============================================================================\n\ndef route_query(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"retrieve_single_step\", \"retrieve_multi_hop\"]:\n    \"\"\"Route after smart_router based on the classified route.\"\"\"\n    route = state.get(\"route\", \"single_step\")\n    if route == \"no_retrieval\":\n        return \"generate_answer\"\n    elif route == \"multi_hop\":\n        return \"retrieve_multi_hop\"\n    else:\n        return \"retrieve_single_step\"\n\ndef after_grading(state: AdaptiveRAGState) -> Literal[\"generate_answer\", \"rewrite_query\"]:\n    \"\"\"After grading, decide: generate or rewrite.\"\"\"\n    graded = state.get(\"graded_documents\", [])\n    if len(graded) == 0 and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n        return \"rewrite_query\"\n    return \"generate_answer\"\n\ndef after_hallucination_check(state: AdaptiveRAGState) -> Literal[\"check_answer_quality\", \"rewrite_query\"]:\n    \"\"\"After hallucination check: if hallucinated and retries left, rewrite.\"\"\"\n    if not state.get(\"hallucination_check\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n        return \"rewrite_query\"\n    return \"check_answer_quality\"\n\ndef after_answer_quality(state: AdaptiveRAGState) -> Literal[\"__end__\", \"rewrite_query\"]:\n    \"\"\"After answer quality check: if poor and retries left, rewrite.\"\"\"\n    if not state.get(\"answer_quality\", True) and state.get(\"retry_count\", 0) < state.get(\"max_retries\", 3):\n        return \"rewrite_query\"\n    return \"__end__\"\n\ndef after_rewrite(state: AdaptiveRAGState) -> Literal[\"retrieve_single_step\", \"retrieve_multi_hop\"]:\n    \"\"\"After rewrite, go back to retrieval using the original route.\"\"\"\n    route = state.get(\"route\", \"single_step\")\n    if route == \"multi_hop\":\n        return \"retrieve_multi_hop\"\n    return \"retrieve_single_step\"\n\n\n# =============================================================================\n# GRAPH CONSTRUCTION\n# =============================================================================\n\ndef build_adaptive_rag_graph() -> StateGraph:\n    \"\"\"Build the Adaptive RAG LangGraph.\"\"\"\n    graph = StateGraph(AdaptiveRAGState)\n    \n    # Add nodes\n    graph.add_node(\"smart_router\", smart_router)\n    graph.add_node(\"retrieve_single_step\", retrieve_single_step)\n    graph.add_node(\"retrieve_multi_hop\", retrieve_multi_hop)\n    graph.add_node(\"grade_documents\", grade_documents)\n    graph.add_node(\"generate_answer\", generate_answer)\n    graph.add_node(\"check_hallucination\", check_hallucination)\n    graph.add_node(\"check_answer_quality\", check_answer_quality)\n    graph.add_node(\"rewrite_query\", rewrite_query)\n    \n    # Edges\n    graph.add_edge(START, \"smart_router\")\n    graph.add_conditional_edges(\"smart_router\", route_query, {\n        \"generate_answer\": \"generate_answer\",\n        \"retrieve_single_step\": \"retrieve_single_step\",\n        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n    })\n    graph.add_edge(\"retrieve_single_step\", \"grade_documents\")\n    graph.add_edge(\"retrieve_multi_hop\", \"grade_documents\")\n    graph.add_conditional_edges(\"grade_documents\", after_grading, {\n        \"generate_answer\": \"generate_answer\",\n        \"rewrite_query\": \"rewrite_query\",\n    })\n    \n    # For generate_answer, skip hallucination check if no_retrieval\n    graph.add_conditional_edges(\"generate_answer\", lambda s: \"check_answer_quality\" if s[\"route\"] == \"no_retrieval\" else \"check_hallucination\", {\n        \"check_hallucination\": \"check_hallucination\",\n        \"check_answer_quality\": \"check_answer_quality\",\n    })\n    \n    graph.add_conditional_edges(\"check_hallucination\", after_hallucination_check, {\n        \"check_answer_quality\": \"check_answer_quality\",\n        \"rewrite_query\": \"rewrite_query\",\n    })\n    \n    graph.add_conditional_edges(\"check_answer_quality\", after_answer_quality, {\n        \"__end__\": END,\n        \"rewrite_query\": \"rewrite_query\",\n    })\n    \n    graph.add_conditional_edges(\"rewrite_query\", after_rewrite, {\n        \"retrieve_single_step\": \"retrieve_single_step\",\n        \"retrieve_multi_hop\": \"retrieve_multi_hop\",\n    })\n    \n    return graph.compile()\n\n\nasync def run_adaptive_rag(\n    query: str,\n    workspace: str = \"default\",\n    model: str = \"Qwen3-8B-Hybrid\",\n    max_retries: int = 3\n) -> AdaptiveRAGState:\n    \"\"\"Execute the Adaptive RAG pipeline.\"\"\"\n    graph = build_adaptive_rag_graph()\n    \n    initial_state: AdaptiveRAGState = {\n        \"query\": query,\n        \"workspace\": workspace,\n        \"model\": model,\n        \"route\": \"single_step\",  # Will be overwritten by smart_router\n        \"documents\": [],\n        \"graded_documents\": [],\n        \"generation\": None,\n        \"hallucination_check\": None,\n        \"answer_quality\": None,\n        \"rewritten_query\": None,\n        \"retry_count\": 0,\n        \"max_retries\": max_retries,\n        \"route_explanation\": \"\",\n        \"execution_trace\": [],\n    }\n    \n    result = await graph.ainvoke(initial_state)\n    return result\n","numLines":484,"startLine":1,"totalLines":484}},"sourceToolAssistantUUID":"c0ae2f2f-196f-425e-84f1-59d67c2b6585","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"50d606f7-67d3-4645-8504-2cafd7318b4d","version":"2.1.181","gitBranch":"HEAD","slug":"recursive-growing-sun"}
{"parentUuid":"c0ae2f2f-196f-425e-84f1-59d67c2b6585","isSidechain":false,"promptId":"2fabc661-9f09-4045-8f2a-decda6f488e9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N3ytjzFECohTvv87E65BRG","type":"tool_result","content":"1\t\"\"\"\n2\tChat Routes - RAG-powered chat interface for notebook-scoped Q&A\n3\t\"\"\"\n4\t\n5\tfrom fastapi import APIRouter, HTTPException\n6\tfrom pydantic import BaseModel\n7\tfrom typing import List, Optional\n8\tfrom datetime import datetime\n9\tfrom pathlib import Path\n10\timport json\n11\t\n12\t\n13\tfrom ..core.workspace import get_workspace_path\n14\tfrom ..tools.knowledge import get_chromadb_client\n15\tfrom ..core.models import call_model, get_model_config, get_active_model\n16\tfrom ..core.manifest import should_trigger_swarm\n17\tfrom ..governance.lineage import track_workflow_start, track_workflow_complete, track_llm_call\n18\timport uuid\n19\t\n20\t\n21\trouter = APIRouter()\n22\t\n23\t\n24\tclass SourceCitation(BaseModel):\n25\t    source: str\n26\t    chunk_index: int\n27\t    relevance: float\n28\t    text: str\n29\t\n30\t\n31\tclass ChatMessage(BaseModel):\n32\t    role: str  # \"user\" or \"assistant\"\n33\t    content: str\n34\t    timestamp: datetime\n35\t    sources: Optional[List[SourceCitation]] = None\n36\t\n37\t\n38\tclass ChatRequest(BaseModel):\n39\t    notebook_id: str\n40\t    message: str\n41\t    temperature: float = 0.7\n42\t    top_k: int = 20  # Number of RAG chunks to retrieve\n43\t\n44\t\n45\tclass ChatResponse(BaseModel):\n46\t    message: str\n47\t    sources: List[SourceCitation]\n48\t    context_snippets: List[str]\n49\t    consider_swarm: bool = False\n50\t    swarm_reason: Optional[str] = None\n51\t\n52\t\n53\tdef get_chat_history_file(notebook_id: str, workspace: str = \"default\") -> Path:\n54\t    \"\"\"Get path to chat history file for a notebook\"\"\"\n55\t    notebook_dir = get_workspace_path(workspace) / \"notebooks\" / notebook_id\n56\t    notebook_dir.mkdir(parents=True, exist_ok=True)\n57\t    return notebook_dir / \"chat_history.json\"\n58\t\n59\t\n60\tdef load_chat_history(notebook_id: str, workspace: str = \"default\") -> List[ChatMessage]:\n61\t    \"\"\"Load chat history for a notebook\"\"\"\n62\t    history_file = get_chat_history_file(notebook_id, workspace)\n63\t    \n64\t    if not history_file.exists():\n65\t        return []\n66\t    \n67\t    try:\n68\t        data = json.loads(history_file.read_text())\n69\t        return [ChatMessage(**msg) for msg in data]\n70\t    except Exception as e:\n71\t        print(f\"Error loading chat history: {e}\")\n72\t        return []\n73\t\n74\t\n75\tdef save_chat_history(notebook_id: str, history: List[ChatMessage], workspace: str = \"default\"):\n76\t    \"\"\"Save chat history for a notebook\"\"\"\n77\t    history_file = get_chat_history_file(notebook_id, workspace)\n78\t    data = [msg.model_dump(mode='json') for msg in history]\n79\t    history_file.write_text(json.dumps(data, indent=2, default=str))\n80\t\n81\t\n82\tdef retrieve_context(notebook_id: str, query: str, top_k: int, workspace: str = \"default\") -> List[SourceCitation]:\n83\t    \"\"\"Retrieve relevant context from notebook's ChromaDB collection\"\"\"\n84\t    try:\n85\t        client = get_chromadb_client(workspace)\n86\t        collection_name = f\"notebook_{notebook_id}\"\n87\t        \n88\t        try:\n89\t            collection = client.get_collection(collection_name)\n90\t        except Exception:\n91\t            # Collection doesn't exist yet\n92\t            return []\n93\t        \n94\t        if collection.count() == 0:\n95\t            return []\n96\t        \n97\t        # Query ChromaDB\n98\t        import re\n99\t        from pathlib import Path\n100\t        all_data = collection.get(include=['metadatas'])\n101\t        available_sources = set(meta.get('source', 'Unknown') for meta in all_data['metadatas'] if 'source' in meta)\n102\t        \n103\t        mentioned_sources = []\n104\t        query_lower = query.lower()\n105\t        for source in available_sources:\n106\t            source_stem = Path(source).stem.lower()\n107\t            words = [w for w in set(re.split(r'[^a-zA-Z0-9]', source_stem)) if len(w) > 3]\n108\t            for w in words:\n109\t                if w in query_lower:\n110\t                    mentioned_sources.append(source)\n111\t                    break\n112\t                    \n113\t        results_list = []\n114\t        \n115\t        if mentioned_sources:\n116\t            k_per_source = max(3, top_k // len(mentioned_sources))\n117\t            for source in mentioned_sources:\n118\t                try:\n119\t                    res = collection.query(\n120\t                        query_texts=[query],\n121\t                        n_results=min(k_per_source, collection.count()),\n122\t                        where={\"source\": source}\n123\t                    )\n124\t                    if res['documents'] and res['documents'][0]:\n125\t                        for doc, meta, distance in zip(res['documents'][0], res['metadatas'][0], res['distances'][0]):\n126\t                            results_list.append((doc, meta, distance))\n127\t                except Exception:\n128\t                    pass\n129\t            \n130\t            try:\n131\t                gen_res = collection.query(\n132\t                    query_texts=[query],\n133\t                    n_results=min(3, collection.count())\n134\t                )\n135\t                if gen_res['documents'] and gen_res['documents'][0]:\n136\t                    for doc, meta, distance in zip(gen_res['documents'][0], gen_res['metadatas'][0], gen_res['distances'][0]):\n137\t                        results_list.append((doc, meta, distance))\n138\t            except Exception:\n139\t                pass\n140\t        else:\n141\t            try:\n142\t                res = collection.query(\n143\t                    query_texts=[query],\n144\t                    n_results=min(top_k, collection.count())\n145\t                )\n146\t                if res['documents'] and res['documents'][0]:\n147\t                    for doc, meta, distance in zip(res['documents'][0], res['metadatas'][0], res['distances'][0]):\n148\t                        results_list.append((doc, meta, distance))\n149\t            except Exception:\n150\t                pass\n151\t\n152\t        # Format results as source citations\n153\t        citations = []\n154\t        seen_docs = set()\n155\t        for doc, meta, distance in results_list:\n156\t            if doc not in seen_docs:\n157\t                seen_docs.add(doc)\n158\t                citation = SourceCitation(\n159\t                    source=meta.get('source', 'Unknown'),\n160\t                    chunk_index=meta.get('chunk_index', 0),\n161\t                    relevance=round((1 - distance) * 100, 1),\n162\t                    text=doc\n163\t                )\n164\t                citations.append(citation)\n165\t        \n166\t        return citations\n167\t        \n168\t    except Exception as e:\n169\t        print(f\"Error retrieving context: {e}\")\n170\t        return []\n171\t\n172\t\n173\tdef build_prompt(query: str, context: List[SourceCitation], history: List[ChatMessage]) -> str:\n174\t    \"\"\"Build prompt with context and conversation history\"\"\"\n175\t    # Build context section\n176\t    context_text = \"\\n\\n\".join([\n177\t        f\"[Source: {c.source}, Relevance: {c.relevance}%]\\n{c.text}\"\n178\t        for c in context\n179\t    ])\n180\t    \n181\t    # Build conversation history (last 5 messages)\n182\t    history_text = \"\"\n183\t    if history:\n184\t        recent_history = history[-5:]  # Last 5 messages\n185\t        for msg in recent_history:\n186\t            role = \"User\" if msg.role == \"user\" else \"Assistant\"\n187\t            history_text += f\"{role}: {msg.content}\\n\\n\"\n188\t    \n189\t    # Construct final prompt. NB: keep backslash escapes OUT of the f-string\n190\t    # expression parts — that is a SyntaxError on Python 3.11 (the bundled\n191\t    # zero-install runtime), only legal on 3.12+.\n192\t    history_block = (\"CONVERSATION HISTORY:\\n\" + history_text) if history_text else \"\"\n193\t    prompt = f\"\"\"You are a helpful AI assistant answering questions about documents in a notebook.\n194\t\n195\t{history_block}\n196\tCONTEXT FROM DOCUMENTS:\n197\t{context_text if context_text else \"No relevant context found in documents.\"}\n198\t\n199\tUSER QUESTION:\n200\t{query}\n201\t\n202\tINSTRUCTIONS:\n203\t- Answer based on the provided context from documents\n204\t- If the context doesn't contain relevant information, say so\n205\t- Cite sources by mentioning the document name (e.g., \"According to report.pdf...\")\n206\t- Be concise and accurate\n207\t- If asked to summarize, cover the main points from all relevant sources\n208\t\n209\tANSWER:\"\"\"\n210\t    \n211\t    return prompt\n212\t\n213\t\n214\t@router.post(\"/query\")\n215\tasync def query_chat(request: ChatRequest, workspace: str = \"default\"):\n216\t    \"\"\"Send a message and get RAG-augmented response\"\"\"\n217\t    try:\n218\t        # Load chat history\n219\t        history = load_chat_history(request.notebook_id, workspace)\n220\t        \n221\t        # Retrieve context from ChromaDB\n222\t        context = retrieve_context(\n223\t            request.notebook_id,\n224\t            request.message,\n225\t            request.top_k,\n226\t            workspace\n227\t        )\n228\t        \n229\t        # Build prompt with context and history\n230\t        prompt = build_prompt(request.message, context, history)\n231\t        \n232\t        # Unified Audit Tracking\n233\t        run_id = f\"chat_{str(uuid.uuid4())[:12]}\"\n234\t        session_ref = f\"notebook_{request.notebook_id}\"\n235\t        try:\n236\t            track_workflow_start(\n237\t                run_id,\n238\t                \"notebook_chat\",\n239\t                workspace,\n240\t                inputs=[session_ref] + [c.source for c in context],\n241\t                outputs=[f\"chat_reply_{run_id}\"],\n242\t            )\n243\t        except Exception:\n244\t            pass  # lineage is best-effort\n245\t\n246\t        # Call LLM\n247\t        try:\n248\t            # Resolve model via role-based orchestrator\n249\t            active_model = await get_active_model(workspace, role=\"chat\")\n250\t            \n251\t            assistant_message = await call_model(\n252\t                model=active_model,\n253\t                messages=[{\"role\": \"user\", \"content\": prompt}],\n254\t                temperature=request.temperature,\n255\t                run_id=run_id\n256\t            )\n257\t            \n258\t            track_workflow_complete(\n259\t                run_id, \n260\t                \"notebook_chat\", \n261\t                workspace, \n262\t                [\"rag_retrieval\", \"generation\"], \n263\t                0,\n264\t                outputs=[f\"chat_reply_{run_id}\"]\n265\t            )\n266\t            \n267\t        except Exception as e:\n268\t            # Fallback if LLM fails\n269\t            if context:\n270\t                assistant_message = f\"I found {len(context)} relevant passages from your documents, but I'm having trouble generating a response. Here's what I found:\\n\\n\"\n271\t                for i, c in enumerate(context[:3], 1):\n272\t                    assistant_message += f\"{i}. From {c.source}:\\n{c.text[:200]}...\\n\\n\"\n273\t            else:\n274\t                assistant_message = \"I couldn't find any relevant information in your documents to answer this question.\"\n275\t        \n276\t        # Save user message to history\n277\t        user_msg = ChatMessage(\n278\t            role=\"user\",\n279\t            content=request.message,\n280\t            timestamp=datetime.now()\n281\t        )\n282\t        history.append(user_msg)\n283\t        \n284\t        # Save assistant message to history with sources\n285\t        assistant_msg = ChatMessage(\n286\t            role=\"assistant\",\n287\t            content=assistant_message,\n288\t            timestamp=datetime.now(),\n289\t            sources=context\n290\t        )\n291\t        history.append(assistant_msg)\n292\t        \n293\t        # Save updated history\n294\t        save_chat_history(request.notebook_id, history, workspace)\n295\t        \n296\t        # Extract context snippets for UI\n297\t        context_snippets = [c.text[:300] + \"...\" if len(c.text) > 300 else c.text for c in context]\n298\t\n299\t        # Swarm trigger hint — if the request looks like it warrants fan-out\n300\t        # planning, tell the UI so it can offer a \"Plan as workflow\" button.\n301\t        sources_as_files = [c.source for c in context] if context else []\n302\t        consider_swarm, swarm_reason = should_trigger_swarm(\n303\t            message=request.message,\n304\t            input_files=sources_as_files,\n305\t        )\n306\t\n307\t        return ChatResponse(\n308\t            message=assistant_message,\n309\t            sources=context,\n310\t            context_snippets=context_snippets,\n311\t            consider_swarm=consider_swarm,\n312\t            swarm_reason=swarm_reason if consider_swarm else None,\n313\t        )\n314\t        \n315\t    except Exception as e:\n316\t        raise HTTPException(500, f\"Chat query failed: {str(e)}\")\n317\t\n318\t\n319\t@router.get(\"/history/{notebook_id}\")\n320\tasync def get_chat_history(notebook_id: str, workspace: str = \"default\", limit: int = 100):\n321\t    \"\"\"Retrieve conversation history for a notebook\"\"\"\n322\t    try:\n323\t        history = load_chat_history(notebook_id, workspace)\n324\t        \n325\t        # Return most recent messages (up to limit)\n326\t        recent = history[-limit:] if len(history) > limit else history\n327\t        \n328\t        return {\n329\t            \"notebook_id\": notebook_id,\n330\t            \"messages\": [msg.model_dump() for msg in recent],\n331\t            \"total_count\": len(history)\n332\t        }\n333\t        \n334\t    except Exception as e:\n335\t        raise HTTPException(500, f\"Failed to retrieve chat history: {str(e)}\")\n336\t\n337\t\n338\t@router.delete(\"/history/{notebook_id}\")\n339\tasync def clear_chat_history(notebook_id: str, workspace: str = \"default\"):\n340\t    \"\"\"Clear conversation history for a notebook\"\"\"\n341\t    try:\n342\t        history_file = get_chat_history_file(notebook_id, workspace)\n343\t        history_file.write_text(\"[]\")\n344\t        \n345\t        return {\n346\t            \"status\": \"cleared\",\n347\t            \"notebook_id\": notebook_id\n348\t        }\n349\t        \n350\t    except Exception as e:\n351\t        raise HTTPException(500, f\"Failed to clear chat history: {str(e)}\")\n352\t"}]},"uuid":"344ff389-925d-4452-9abd-3667aaaf097c","timestamp":"2026-06-20T17:13:15.357Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\api\\chat_routes.py","content":"\"\"\"\nChat Routes - RAG-powered chat interface for notebook-scoped Q&A\n\"\"\"\n\nfrom fastapi import APIRouter, HTTPException\nfrom pydantic import BaseModel\nfrom typing import List, Optional\nfrom datetime import datetime\nfrom pathlib import Path\nimport json\n\n\nfrom ..core.workspace import get_workspace_path\nfrom ..tools.knowledge import get_chromadb_client\nfrom ..core.models import call_model, get_model_config, get_active_model\nfrom ..core.manifest import should_trigger_swarm\nfrom ..governance.lineage import track_workflow_start, track_workflow_complete, track_llm_call\nimport uuid\n\n\nrouter = APIRouter()\n\n\nclass SourceCitation(BaseModel):\n    source: str\n    chunk_index: int\n    relevance: float\n    text: str\n\n\nclass ChatMessage(BaseModel):\n    role: str  # \"user\" or \"assistant\"\n    content: str\n    timestamp: datetime\n    sources: Optional[List[SourceCitation]] = None\n\n\nclass ChatRequest(BaseModel):\n    notebook_id: str\n    message: str\n    temperature: float = 0.7\n    top_k: int = 20  # Number of RAG chunks to retrieve\n\n\nclass ChatResponse(BaseModel):\n    message: str\n    sources: List[SourceCitation]\n    context_snippets: List[str]\n    consider_swarm: bool = False\n    swarm_reason: Optional[str] = None\n\n\ndef get_chat_history_file(notebook_id: str, workspace: str = \"default\") -> Path:\n    \"\"\"Get path to chat history file for a notebook\"\"\"\n    notebook_dir = get_workspace_path(workspace) / \"notebooks\" / notebook_id\n    notebook_dir.mkdir(parents=True, exist_ok=True)\n    return notebook_dir / \"chat_history.json\"\n\n\ndef load_chat_history(notebook_id: str, workspace: str = \"default\") -> List[ChatMessage]:\n    \"\"\"Load chat history for a notebook\"\"\"\n    history_file = get_chat_history_file(notebook_id, workspace)\n    \n    if not history_file.exists():\n        return []\n    \n    try:\n        data = json.loads(history_file.read_text())\n        return [ChatMessage(**msg) for msg in data]\n    except Exception as e:\n        print(f\"Error loading chat history: {e}\")\n        return []\n\n\ndef save_chat_history(notebook_id: str, history: List[ChatMessage], workspace: str = \"default\"):\n    \"\"\"Save chat history for a notebook\"\"\"\n    history_file = get_chat_history_file(notebook_id, workspace)\n    data = [msg.model_dump(mode='json') for msg in history]\n    history_file.write_text(json.dumps(data, indent=2, default=str))\n\n\ndef retrieve_context(notebook_id: str, query: str, top_k: int, workspace: str = \"default\") -> List[SourceCitation]:\n    \"\"\"Retrieve relevant context from notebook's ChromaDB collection\"\"\"\n    try:\n        client = get_chromadb_client(workspace)\n        collection_name = f\"notebook_{notebook_id}\"\n        \n        try:\n            collection = client.get_collection(collection_name)\n        except Exception:\n            # Collection doesn't exist yet\n            return []\n        \n        if collection.count() == 0:\n            return []\n        \n        # Query ChromaDB\n        import re\n        from pathlib import Path\n        all_data = collection.get(include=['metadatas'])\n        available_sources = set(meta.get('source', 'Unknown') for meta in all_data['metadatas'] if 'source' in meta)\n        \n        mentioned_sources = []\n        query_lower = query.lower()\n        for source in available_sources:\n            source_stem = Path(source).stem.lower()\n            words = [w for w in set(re.split(r'[^a-zA-Z0-9]', source_stem)) if len(w) > 3]\n            for w in words:\n                if w in query_lower:\n                    mentioned_sources.append(source)\n                    break\n                    \n        results_list = []\n        \n        if mentioned_sources:\n            k_per_source = max(3, top_k // len(mentioned_sources))\n            for source in mentioned_sources:\n                try:\n                    res = collection.query(\n                        query_texts=[query],\n                        n_results=min(k_per_source, collection.count()),\n                        where={\"source\": source}\n                    )\n                    if res['documents'] and res['documents'][0]:\n                        for doc, meta, distance in zip(res['documents'][0], res['metadatas'][0], res['distances'][0]):\n                            results_list.append((doc, meta, distance))\n                except Exception:\n                    pass\n            \n            try:\n                gen_res = collection.query(\n                    query_texts=[query],\n                    n_results=min(3, collection.count())\n                )\n                if gen_res['documents'] and gen_res['documents'][0]:\n                    for doc, meta, distance in zip(gen_res['documents'][0], gen_res['metadatas'][0], gen_res['distances'][0]):\n                        results_list.append((doc, meta, distance))\n            except Exception:\n                pass\n        else:\n            try:\n                res = collection.query(\n                    query_texts=[query],\n                    n_results=min(top_k, collection.count())\n                )\n                if res['documents'] and res['documents'][0]:\n                    for doc, meta, distance in zip(res['documents'][0], res['metadatas'][0], res['distances'][0]):\n                        results_list.append((doc, meta, distance))\n            except Exception:\n                pass\n\n        # Format results as source citations\n        citations = []\n        seen_docs = set()\n        for doc, meta, distance in results_list:\n            if doc not in seen_docs:\n                seen_docs.add(doc)\n                citation = SourceCitation(\n                    source=meta.get('source', 'Unknown'),\n                    chunk_index=meta.get('chunk_index', 0),\n                    relevance=round((1 - distance) * 100, 1),\n                    text=doc\n                )\n                citations.append(citation)\n        \n        return citations\n        \n    except Exception as e:\n        print(f\"Error retrieving context: {e}\")\n        return []\n\n\ndef build_prompt(query: str, context: List[SourceCitation], history: List[ChatMessage]) -> str:\n    \"\"\"Build prompt with context and conversation history\"\"\"\n    # Build context section\n    context_text = \"\\n\\n\".join([\n        f\"[Source: {c.source}, Relevance: {c.relevance}%]\\n{c.text}\"\n        for c in context\n    ])\n    \n    # Build conversation history (last 5 messages)\n    history_text = \"\"\n    if history:\n        recent_history = history[-5:]  # Last 5 messages\n        for msg in recent_history:\n            role = \"User\" if msg.role == \"user\" else \"Assistant\"\n            history_text += f\"{role}: {msg.content}\\n\\n\"\n    \n    # Construct final prompt. NB: keep backslash escapes OUT of the f-string\n    # expression parts — that is a SyntaxError on Python 3.11 (the bundled\n    # zero-install runtime), only legal on 3.12+.\n    history_block = (\"CONVERSATION HISTORY:\\n\" + history_text) if history_text else \"\"\n    prompt = f\"\"\"You are a helpful AI assistant answering questions about documents in a notebook.\n\n{history_block}\nCONTEXT FROM DOCUMENTS:\n{context_text if context_text else \"No relevant context found in documents.\"}\n\nUSER QUESTION:\n{query}\n\nINSTRUCTIONS:\n- Answer based on the provided context from documents\n- If the context doesn't contain relevant information, say so\n- Cite sources by mentioning the document name (e.g., \"According to report.pdf...\")\n- Be concise and accurate\n- If asked to summarize, cover the main points from all relevant sources\n\nANSWER:\"\"\"\n    \n    return prompt\n\n\n@router.post(\"/query\")\nasync def query_chat(request: ChatRequest, workspace: str = \"default\"):\n    \"\"\"Send a message and get RAG-augmented response\"\"\"\n    try:\n        # Load chat history\n        history = load_chat_history(request.notebook_id, workspace)\n        \n        # Retrieve context from ChromaDB\n        context = retrieve_context(\n            request.notebook_id,\n            request.message,\n            request.top_k,\n            workspace\n        )\n        \n        # Build prompt with context and history\n        prompt = build_prompt(request.message, context, history)\n        \n        # Unified Audit Tracking\n        run_id = f\"chat_{str(uuid.uuid4())[:12]}\"\n        session_ref = f\"notebook_{request.notebook_id}\"\n        try:\n            track_workflow_start(\n                run_id,\n                \"notebook_chat\",\n                workspace,\n                inputs=[session_ref] + [c.source for c in context],\n                outputs=[f\"chat_reply_{run_id}\"],\n            )\n        except Exception:\n            pass  # lineage is best-effort\n\n        # Call LLM\n        try:\n            # Resolve model via role-based orchestrator\n            active_model = await get_active_model(workspace, role=\"chat\")\n            \n            assistant_message = await call_model(\n                model=active_model,\n                messages=[{\"role\": \"user\", \"content\": prompt}],\n                temperature=request.temperature,\n                run_id=run_id\n            )\n            \n            track_workflow_complete(\n                run_id, \n                \"notebook_chat\", \n                workspace, \n                [\"rag_retrieval\", \"generation\"], \n                0,\n                outputs=[f\"chat_reply_{run_id}\"]\n            )\n            \n        except Exception as e:\n            # Fallback if LLM fails\n            if context:\n                assistant_message = f\"I found {len(context)} relevant passages from your documents, but I'm having trouble generating a response. Here's what I found:\\n\\n\"\n                for i, c in enumerate(context[:3], 1):\n                    assistant_message += f\"{i}. From {c.source}:\\n{c.text[:200]}...\\n\\n\"\n            else:\n                assistant_message = \"I couldn't find any relevant information in your documents to answer this question.\"\n        \n        # Save user message to history\n        user_msg = ChatMessage(\n            role=\"user\",\n            content=request.message,\n            timestamp=datetime.now()\n        )\n        history.append(user_msg)\n        \n        # Save assistant message to history with sources\n        assistant_msg = ChatMessage(\n            role=\"assistant\",\n            content=assistant_message,\n            timestamp=datetime.now(),\n            sources=context\n        )\n        history.append(assistant_msg)\n        \n        # Save updated history\n        save_chat_history(request.notebook_id, history, workspace)\n        \n        # Extract context snippets for UI\n        context_snippets = [c.text[:300] + \"...\" if len(c.text) > 300 else c.text for c in context]\n\n        # Swarm trigger hint — if the request looks like it warrants fan-out\n        # planning, tell the UI so it can offer a \"Plan as workflow\" button.\n        sources_as_files = [c.source for c in context] if context else []\n        consider_swarm, swarm_reason = should_trigger_swarm(\n            message=request.message,\n            input_files=sources_as_files,\n        )\n\n        return ChatResponse(\n            message=assistant_message,\n            sources=context,\n            context_snippets=context_snippets,\n            consider_swarm=consider_swarm,\n            swarm_reason=swarm_reason if consider_swarm else None,\n        )\n        \n    except Exception as e:\n        raise HTTPException(500, f\"Chat query failed: {str(e)}\")\n\n\n@router.get(\"/history/{notebook_id}\")\nasync def get_chat_history(notebook_id: str, workspace: str = \"default\", limit: int = 100):\n    \"\"\"Retrieve conversation history for a notebook\"\"\"\n    try:\n        history = load_chat_history(notebook_id, workspace)\n        \n        # Return most recent messages (up to limit)\n        recent = history[-limit:] if len(history) > limit else history\n        \n        return {\n            \"notebook_id\": notebook_id,\n            \"messages\": [msg.model_dump() for msg in recent],\n            \"total_count\": len(history)\n        }\n        \n    except Exception as e:\n        raise HTTPException(500, f\"Failed to retrieve chat history: {str(e)}\")\n\n\n@router.delete(\"/history/{notebook_id}\")\nasync def clear_chat_history(notebook_id: str, workspace: str = \"default\"):\n    \"\"\"Clear conversation history for a notebook\"\"\"\n    try:\n        history_file = get_chat_history_file(notebook_id, workspace)\n        history_file.write_text(\"[]\")\n        \n        return {\n            \"status\": \"cleared\",\n            \"notebook_id\": notebook_id\n        }\n        \n    except Exception as e:\n        raise HTTPException(500, f\"Failed to clear chat history: {str(e)}\")\n","numLines":352,"startLine":1,"totalLines":352}},"sourceToolAssistantUUID":"c0ae2f2f-196f-425e-84f1-59d67c2b6585","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"50d606f7-67d3-4645-8504-2cafd7318b4d","version":"2.1.181","gitBranch":"HEAD","slug":"recursive-growing-sun"}
