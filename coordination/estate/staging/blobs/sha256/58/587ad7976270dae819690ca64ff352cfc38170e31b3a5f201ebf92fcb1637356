{"parentUuid":"148894e1-6272-42e7-97bc-b92103e7910f","isSidechain":false,"promptId":"30d26bdd-0c1f-4886-9efc-825c4997ccbc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016XNvNcynqZxGyqiZCKYnFs","type":"tool_result","content":"1\t// Bundled Benny runtime supervisor for the packaged desktop shell.\n2\t//\n3\t// The self-contained runtime (embeddable Python + baked deps + Neo4j + JRE) is\n4\t// downloaded + extracted into a per-user dir on FIRST LAUNCH (see\n5\t// packaging/desktop/runtime_fetch.js + packaging/scripts/pack-runtime-bundle.js)\n6\t// rather than shipped inside the installer — packing ~600MB of executables via\n7\t// electron-builder/NSIS is unreliable on Windows (Defender locks PE files\n8\t// mid-copy; that broke v1.2.8). Once present, this module starts and supervises\n9\t// it so the EXE is zero-install: ordered start of native Neo4j then the FastAPI\n10\t// server, health-gated, with crash-restart and graceful shutdown.\n11\t//\n12\t// It is ADDITIVE and conditional — it only takes over when:\n13\t//   (a) a managed bundle dir is configured (the per-user runtime dir), AND\n14\t//   (b) RUNTIME_BASE_URL is unset / the default localhost:8005, AND\n15\t//   (c) config.useBundledRuntime is not false.\n16\t// On first run it fetches the bundle; if that can't complete (e.g. offline) it\n17\t// no-ops gracefully and retries next launch, preserving server/dev mode\n18\t// (node space serve, standalone `benny up`) and the \"point at a remote Benny\"\n19\t// mode (RUNTIME_BASE_URL set).\n20\t//\n21\t// The spawn, probe and fetch layers are injectable so the ordering / restart /\n22\t// stop / first-run-fetch logic is unit-testable without real processes (see tests).\n23\t\n24\tconst path = require(\"node:path\");\n25\tconst fs = require(\"node:fs\");\n26\tconst { spawn } = require(\"node:child_process\");\n27\tconst { ensureRuntimeBundle } = require(\"./runtime_fetch\");\n28\t\n29\tconst DEFAULT_API_PORT = 8005;\n30\tconst DEFAULT_NEO4J_HTTP_PORT = 7474;\n31\tconst DEFAULT_RUNTIME_BASE_URLS = new Set([\n32\t  \"\",\n33\t  \"http://127.0.0.1:8005\",\n34\t  \"http://localhost:8005\"\n35\t]);\n36\t\n37\t/* ── pure helpers (unit-tested) ──────────────────────────────────────── */\n38\t\n39\t// Find the shipped runtime bundle, if any.\n40\tfunction resolveBundleDir(resourcesPath, here = __dirname) {\n41\t  const candidates = [\n42\t    resourcesPath ? path.join(resourcesPath, \"runtime-bundle\") : \"\",\n43\t    path.join(here, \"..\", \"runtime-bundle\")\n44\t  ];\n45\t  for (const candidate of candidates) {\n46\t    try {\n47\t      if (candidate && fs.existsSync(path.join(candidate, \"bundle.json\"))) {\n48\t        return candidate;\n49\t      }\n50\t    } catch {\n51\t      // try next\n52\t    }\n53\t  }\n54\t  return \"\";\n55\t}\n56\t\n57\t// Resolve the writable BENNY_HOME the bundled runtime should use. A user can\n58\t// relocate it via the tray (\"Configure Benny Home…\", persisted as config.bennyHome);\n59\t// otherwise we fall back to the per-user default the shell passes in.\n60\tfunction resolveManagedBennyHome(defaultHome, config = {}) {\n61\t  const configured = String(config.bennyHome || \"\").trim();\n62\t  return configured || defaultHome || \"\";\n63\t}\n64\t\n65\t// Decide whether the supervisor should manage a local runtime.\n66\tfunction shouldUseBundledRuntime({ bundleDir, env = {}, config = {} } = {}) {\n67\t  if (!bundleDir) {\n68\t    return { use: false, reason: \"no-bundle\" };\n69\t  }\n70\t  const runtimeBaseUrl = String(env.RUNTIME_BASE_URL || \"\").trim().replace(/\\/+$/, \"\");\n71\t  if (!DEFAULT_RUNTIME_BASE_URLS.has(runtimeBaseUrl)) {\n72\t    return { use: false, reason: \"remote-runtime\" };\n73\t  }\n74\t  if (config.useBundledRuntime === false) {\n75\t    return { use: false, reason: \"disabled-by-config\" };\n76\t  }\n77\t  return { use: true, reason: \"ok\" };\n78\t}\n79\t\n80\t// A bundle is usable only when the real binaries are present (a manifest-only\n81\t// dev build ships just bundle.json + requirements → must NOT be spawned).\n82\tfunction isBundleComplete(bundleDir, platform = process.platform) {\n83\t  if (!bundleDir) return false;\n84\t  const p = bundlePaths(bundleDir, platform);\n85\t  return [p.python, p.neo4jBin, p.javaHome, p.benny].every((target) => {\n86\t    try { return fs.existsSync(target); } catch { return false; }\n87\t  });\n88\t}\n89\t\n90\t// Platform-specific paths inside the bundle.\n91\tfunction bundlePaths(bundleDir, platform = process.platform) {\n92\t  const isWin = platform === \"win32\";\n93\t  return {\n94\t    python: path.join(bundleDir, \"python\", isWin ? \"python.exe\" : path.join(\"bin\", \"python3\")),\n95\t    java: path.join(bundleDir, \"jre\", \"bin\", isWin ? \"java.exe\" : \"java\"),\n96\t    javaHome: path.join(bundleDir, \"jre\"),\n97\t    neo4jHome: path.join(bundleDir, \"neo4j\"),\n98\t    neo4jBin: path.join(bundleDir, \"neo4j\", \"bin\", isWin ? \"neo4j.bat\" : \"neo4j\"),\n99\t    site: path.join(bundleDir, \"site\"),\n100\t    benny: path.join(bundleDir, \"benny\")\n101\t  };\n102\t}\n103\t\n104\t// Render a Neo4j 5 config that points data/logs into the writable BENNY_HOME and\n105\t// disables auth (single-user local DB → the API connects with its defaults).\n106\tfunction renderNeo4jConf(bennyHome) {\n107\t  const graph = path.join(bennyHome, \"data\", \"graph\").replace(/\\\\/g, \"/\");\n108\t  return [\n109\t    `server.directories.data=${graph}/data`,\n110\t    `server.directories.logs=${graph}/logs`,\n111\t    \"server.default_listen_address=127.0.0.1\",\n112\t    \"server.bolt.listen_address=:7687\",\n113\t    \"server.http.listen_address=:7474\",\n114\t    \"dbms.security.auth_enabled=false\",\n115\t    \"\"\n116\t  ].join(\"\\n\");\n117\t}\n118\t\n119\t// Build the spawn spec for native Neo4j (JRE + conf under BENNY_HOME).\n120\tfunction buildNeo4jSpawn({ bundleDir, bennyHome, platform = process.platform, env = {} }) {\n121\t  const p = bundlePaths(bundleDir, platform);\n122\t  const confDir = path.join(bennyHome, \"neo4j-conf\");\n123\t  return {\n124\t    command: p.neo4jBin,\n125\t    args: [\"console\"],\n126\t    env: {\n127\t      ...env,\n128\t      JAVA_HOME: p.javaHome,\n129\t      NEO4J_HOME: p.neo4jHome,\n130\t      NEO4J_CONF: confDir\n131\t    },\n132\t    confDir\n133\t  };\n134\t}\n135\t\n136\t// Build the spawn spec for the FastAPI server via the bundled Python.\n137\tfunction buildApiSpawn({ bundleDir, bennyHome, platform = process.platform, env = {}, hmacKey = \"\" }) {\n138\t  const p = bundlePaths(bundleDir, platform);\n139\t  const pythonPath = [p.site, p.benny].join(path.delimiter);\n140\t  const childEnv = {\n141\t    ...env,\n142\t    BENNY_HOME: bennyHome,\n143\t    PYTHONPATH: pythonPath,\n144\t    NEO4J_URI: env.NEO4J_URI || \"bolt://localhost:7687\"\n145\t  };\n146\t  if (hmacKey) {\n147\t    childEnv.BENNY_HMAC_KEY = hmacKey;\n148\t  }\n149\t  return {\n150\t    command: p.python,\n151\t    args: [\"-m\", \"uvicorn\", \"benny.api.server:app\", \"--host\", \"127.0.0.1\", \"--port\", String(DEFAULT_API_PORT)],\n152\t    env: childEnv\n153\t  };\n154\t}\n155\t\n156\t// Read the per-install HMAC key written by `benny init` (home.py), if present.\n157\tfunction readInstallHmacKey(bennyHome) {\n158\t  try {\n159\t    const value = fs.readFileSync(path.join(bennyHome, \"state\", \"hmac-key\"), \"utf8\").trim();\n160\t    return value || \"\";\n161\t  } catch {\n162\t    return \"\";\n163\t  }\n164\t}\n165\t\n166\tfunction delay(ms) {\n167\t  return new Promise((resolve) => setTimeout(resolve, ms));\n168\t}\n169\t\n170\t/* ── default real spawn / probe / init implementations ───────────────── */\n171\t\n172\t// Resolve how to actually invoke a spawn spec. On Windows, Node refuses to\n173\t// spawn a .bat/.cmd directly (EINVAL — CVE-2024-27980), and neo4j ships as\n174\t// neo4j.bat. Route batch files through cmd.exe with verbatim args; `cmd /s /c`\n175\t// strips the outer quote pair, so a path with spaces (\"Program Files\\Space\n176\t// Agent\") survives. (Using shell:true with an args array is deprecated, DEP0190,\n177\t// so we build the command line ourselves.) Pure + exported for unit testing.\n178\tfunction resolveSpawnInvocation(spec, platform = process.platform) {\n179\t  const isWinBatch = platform === \"win32\" && /\\.(bat|cmd)$/i.test(spec.command || \"\");\n180\t  if (isWinBatch) {\n181\t    const line = [`\"${spec.command}\"`, ...(spec.args || [])].join(\" \");\n182\t    return {\n183\t      command: \"cmd.exe\",\n184\t      args: [\"/d\", \"/s\", \"/c\", line],\n185\t      options: { env: spec.env, stdio: \"ignore\", detached: false, windowsHide: true, windowsVerbatimArguments: true }\n186\t    };\n187\t  }\n188\t  return {\n189\t    command: spec.command,\n190\t    args: spec.args,\n191\t    options: { env: spec.env, stdio: \"ignore\", detached: false, windowsHide: true }\n192\t  };\n193\t}\n194\t\n195\tfunction defaultSpawn(_name, spec) {\n196\t  const inv = resolveSpawnInvocation(spec);\n197\t  // Capture child stdout/stderr to a log file so failures in the bundled runtime\n198\t  // are diagnosable (the alternative, stdio:\"ignore\", hid real errors — e.g. a\n199\t  // missing dep or a Neo4j bind failure — behind a silent dead process).\n200\t  if (spec.logFile) {\n201\t    try {\n202\t      fs.mkdirSync(path.dirname(spec.logFile), { recursive: true });\n203\t      const fd = fs.openSync(spec.logFile, \"a\");\n204\t      inv.options.stdio = [\"ignore\", fd, fd];\n205\t    } catch { /* fall back to whatever resolveSpawnInvocation set */ }\n206\t  }\n207\t  return spawn(inv.command, inv.args, inv.options);\n208\t}\n209\t\n210\tasync function defaultProbe(service) {\n211\t  const url = service === \"neo4j\"\n212\t    ? `http://127.0.0.1:${DEFAULT_NEO4J_HTTP_PORT}`\n213\t    : `http://127.0.0.1:${DEFAULT_API_PORT}/api/health`;\n214\t  const controller = new AbortController();\n215\t  const timer = setTimeout(() => controller.abort(), 1500);\n216\t  try {\n217\t    const response = await fetch(url, { signal: controller.signal });\n218\t    return response.ok || response.status === 401; // neo4j http answers even pre-auth\n219\t  } catch {\n220\t    return false;\n221\t  } finally {\n222\t    clearTimeout(timer);\n223\t  }\n224\t}\n225\t\n226\t/* ── supervisor ──────────────────────────────────────────────────────── */\n227\t\n228\t/**\n229\t * Create a runtime supervisor. Most collaborators are injectable for testing:\n230\t *   spawnFn(name, spec) -> child (EventEmitter w/ .kill(signal), .pid)\n231\t *   probeFn(service) -> Promise<boolean>     (\"neo4j\" | \"api\")\n232\t *   initFn({ bundleDir, bennyHome }) -> Promise<void>   (first-run benny init)\n233\t */\n234\tfunction createRuntimeSupervisor(options = {}) {\n235\t  const {\n236\t    resourcesPath = \"\",\n237\t    bennyHome: defaultBennyHome,\n238\t    config = {},\n239\t    env = process.env,\n240\t    platform = process.platform,\n241\t    spawnFn = defaultSpawn,\n242\t    probeFn = defaultProbe,\n243\t    initFn = defaultInit,\n244\t    logger = console,\n245\t    readyTimeoutMs = 60000,\n246\t    probeIntervalMs = 1000,\n247\t    maxRestarts = 5,\n248\t    backoffMsFn = (attempt) => Math.min(15000, 1000 * 2 ** (attempt - 1)),\n249\t    isBundleCompleteFn = isBundleComplete,\n250\t    killTreeFn = hardKillChild,\n251\t    appVersion = \"\",\n252\t    fetchFn = ensureRuntimeBundle,\n253\t    onStatus = null\n254\t  } = options;\n255\t\n256\t  const bundleDir = options.bundleDir || resolveBundleDir(resourcesPath);\n257\t  const bennyHome = resolveManagedBennyHome(defaultBennyHome, config);\n258\t  const children = new Map(); // service -> { child, spec, restarts }\n259\t  let stopping = false;\n260\t  let started = false;\n261\t\n262\t  // Whether we WANT to manage a bundled runtime. Completeness is checked\n263\t  // separately (after the first-run fetch) because the bundle is downloaded\n264\t  // lazily, not shipped — so \"not present yet\" must not disable management.\n265\t  function gate() {\n266\t    return shouldUseBundledRuntime({ bundleDir, env, config });\n267\t  }\n268\t\n269\t  async function waitReady(service) {\n270\t    const deadline = Date.now() + readyTimeoutMs;\n271\t    while (Date.now() < deadline) {\n272\t      if (stopping) return false;\n273\t      if (await probeFn(service)) return true;\n274\t      await delay(probeIntervalMs);\n275\t    }\n276\t    return false;\n277\t  }\n278\t\n279\t  function attachRestart(service, spec) {\n280\t    const entry = children.get(service);\n281\t    if (!entry || !entry.child || typeof entry.child.once !== \"function\") return;\n282\t    entry.child.once(\"exit\", (code, signal) => {\n283\t      if (stopping) return;\n284\t      entry.restarts = (entry.restarts || 0) + 1;\n285\t      if (entry.restarts > maxRestarts) {\n286\t        logger.error?.(`[runtime] ${service} exited (${signal || code}) and exceeded ${maxRestarts} restarts; giving up.`);\n287\t        return;\n288\t      }\n289\t      const backoff = backoffMsFn(entry.restarts);\n290\t      logger.warn?.(`[runtime] ${service} exited (${signal || code}); restarting in ${backoff}ms (attempt ${entry.restarts}).`);\n291\t      setTimeout(() => {\n292\t        if (stopping) return;\n293\t        void launch(service, spec);\n294\t      }, backoff);\n295\t    });\n296\t  }\n297\t\n298\t  function launch(service, spec) {\n299\t    const child = spawnFn(service, spec);\n300\t    const prev = children.get(service);\n301\t    children.set(service, { child, spec, restarts: prev ? prev.restarts : 0 });\n302\t    attachRestart(service, spec);\n303\t    return child;\n304\t  }\n305\t\n306\t  async function start() {\n307\t    const decision = gate();\n308\t    if (!decision.use) {\n309\t      logger.log?.(`[runtime] Not managing a bundled runtime (${decision.reason}).`);\n310\t      return { managed: false, reason: decision.reason };\n311\t    }\n312\t    if (started) {\n313\t      return { managed: true, reason: \"already-started\" };\n314\t    }\n315\t    started = true;\n316\t    stopping = false;\n317\t\n318\t    // First launch: download + extract the runtime bundle into the per-user dir\n319\t    // if it isn't already there. Idempotent (a version marker short-circuits) and\n320\t    // non-fatal — if it can't complete (offline), we no-op and retry next launch.\n321\t    if (!isBundleCompleteFn(bundleDir, platform) && fetchFn && appVersion) {\n322\t      logger.log?.(\"[runtime] runtime not installed yet; downloading on first launch…\");\n323\t      onStatus?.({ phase: \"downloading\" });\n324\t      try {\n325\t        const result = await fetchFn({ destDir: bundleDir, version: appVersion, platform, logger });\n326\t        if (!result || !result.ok) {\n327\t          logger.warn?.(`[runtime] runtime download did not complete (${result ? result.reason : \"error\"}).`);\n328\t        }\n329\t      } catch (error) {\n330\t        logger.warn?.(`[runtime] runtime download error: ${error.message || error}`);\n331\t      }\n332\t    }\n333\t\n334\t    // If the bundle still isn't complete (e.g. offline first run), don't try to\n335\t    // spawn anything — the shell runs in proxy mode; we retry on the next launch.\n336\t    if (!isBundleCompleteFn(bundleDir, platform)) {\n337\t      started = false;\n338\t      logger.warn?.(\"[runtime] bundled runtime unavailable; will retry on next launch.\");\n339\t      onStatus?.({ phase: \"unavailable\" });\n340\t      return { managed: false, reason: \"bundle-unavailable\" };\n341\t    }\n342\t    onStatus?.({ phase: \"starting\" });\n343\t\n344\t    // First-run: initialise the writable BENNY_HOME (dirs, config, hmac-key).\n345\t    try {\n346\t      fs.mkdirSync(bennyHome, { recursive: true });\n347\t      if (!fs.existsSync(path.join(bennyHome, \"state\", \"hmac-key\"))) {\n348\t        await initFn({ bundleDir, bennyHome, platform, env });\n349\t      }\n350\t    } catch (error) {\n351\t      logger.warn?.(`[runtime] benny init skipped: ${error.message || error}`);\n352\t    }\n353\t\n354\t    const logDir = path.join(bennyHome, \"logs\");\n355\t    try { fs.mkdirSync(logDir, { recursive: true }); } catch { /* best-effort */ }\n356\t\n357\t    // Neo4j first (the API connects to it lazily, but graphs need it up).\n358\t    const neo4jSpec = buildNeo4jSpawn({ bundleDir, bennyHome, platform, env });\n359\t    neo4jSpec.logFile = path.join(logDir, \"neo4j.log\");\n360\t    try {\n361\t      fs.mkdirSync(neo4jSpec.confDir, { recursive: true });\n362\t      fs.writeFileSync(path.join(neo4jSpec.confDir, \"neo4j.conf\"), renderNeo4jConf(bennyHome), \"utf8\");\n363\t    } catch (error) {\n364\t      logger.warn?.(`[runtime] could not write neo4j.conf: ${error.message || error}`);\n365\t    }\n366\t    launch(\"neo4j\", neo4jSpec);\n367\t    const neo4jReady = await waitReady(\"neo4j\");\n368\t    if (!neo4jReady) {\n369\t      logger.warn?.(\"[runtime] Neo4j did not report healthy in time; graphs may be unavailable until it does.\");\n370\t    }\n371\t\n372\t    // Then the API.\n373\t    const apiSpec = buildApiSpawn({\n374\t      bundleDir, bennyHome, platform, env, hmacKey: readInstallHmacKey(bennyHome)\n375\t    });\n376\t    apiSpec.logFile = path.join(logDir, \"api.log\");\n377\t    launch(\"api\", apiSpec);\n378\t    const apiReady = await waitReady(\"api\");\n379\t\n380\t    onStatus?.({ phase: apiReady ? \"running\" : \"degraded\", neo4jReady, apiReady });\n381\t    return {\n382\t      managed: true,\n383\t      reason: \"started\",\n384\t      neo4jReady,\n385\t      apiReady,\n386\t      services: [...children.keys()]\n387\t    };\n388\t  }\n389\t\n390\t  async function stop({ graceMs = 6000 } = {}) {\n391\t    stopping = true;\n392\t    const entries = [...children.values()];\n393\t    children.clear();\n394\t    started = false;\n395\t    await Promise.all(entries.map(({ child }) => stopChild(child, graceMs, logger, { platform, killTree: killTreeFn })));\n396\t    onStatus?.({ phase: \"stopped\" });\n397\t  }\n398\t\n399\t  async function restart() {\n400\t    await stop();\n401\t    return start();\n402\t  }\n403\t\n404\t  return {\n405\t    bundleDir,\n406\t    bennyHome,\n407\t    get managed() { return gate().use; },\n408\t    gate,\n409\t    start,\n410\t    stop,\n411\t    restart,\n412\t    // Everything the tray needs to open a console wired to the BUNDLED Python +\n413\t    // this install's BENNY_HOME (so \"Open Benny CLI\" works with zero external\n414\t    // install). `complete` is false for a manifest-only dev build.\n415\t    cliContext() {\n416\t      const p = bundlePaths(bundleDir, platform);\n417\t      return {\n418\t        python: p.python,\n419\t        site: p.site,\n420\t        benny: p.benny,\n421\t        bennyHome,\n422\t        complete: Boolean(bundleDir) && isBundleCompleteFn(bundleDir, platform)\n423\t      };\n424\t    },\n425\t    status() {\n426\t      return { managed: gate().use, started, services: [...children.keys()] };\n427\t    }\n428\t  };\n429\t}\n430\t\n431\t// Hard-kill a child. On Windows, kill the whole process TREE: the bundled Neo4j\n432\t// runs as cmd.exe → neo4j.bat → java, and killing only cmd.exe orphans java\n433\t// (which keeps holding bolt 7687, breaking the next launch). taskkill /T does\n434\t// the tree; /F forces it.\n435\tfunction hardKillChild(child) {\n436\t  try {\n437\t    if (process.platform === \"win32\" && child && child.pid) {\n438\t      spawn(\"taskkill\", [\"/PID\", String(child.pid), \"/T\", \"/F\"], { stdio: \"ignore\", windowsHide: true });\n439\t    } else if (child && typeof child.kill === \"function\") {\n440\t      child.kill(\"SIGKILL\");\n441\t    }\n442\t  } catch { /* ignore */ }\n443\t}\n444\t\n445\tfunction stopChild(child, graceMs, logger = console, { platform = process.platform, killTree = hardKillChild } = {}) {\n446\t  return new Promise((resolve) => {\n447\t    if (!child || typeof child.kill !== \"function\") {\n448\t      resolve();\n