n521\t\n522\t    // Upload each accepted file through the runtime's /files/upload endpoint —\n523\t    // the same path Benny's ingestion expects — then refresh statuses. Files\n524\t    // land in data_in as MISSING (staged, not yet ingested) until the operator\n525\t    // runs Ingest. Unsupported types are rejected client-side with a clear note.\n526\t    async uploadFiles(fileList) {\n527\t      const all = fileList ? Array.from(fileList) : [];\n528\t      if (!all.length) return;\n529\t      const accepted = all.filter((f) =>\n530\t        UPLOAD_EXTENSIONS.some((ext) => String(f.name || \"\").toLowerCase().endsWith(ext))\n531\t      );\n532\t      const rejected = all.length - accepted.length;\n533\t      if (!accepted.length) {\n534\t        this.ingestNote = `No supported files. Allowed types: ${UPLOAD_EXTENSIONS.join(\", \")}.`;\n535\t        return;\n536\t      }\n537\t      this.uploading = true;\n538\t      this.ingestNote = `Uploading ${accepted.length} file${accepted.length === 1 ? \"\" : \"s\"}…`;\n539\t      let ok = 0;\n540\t      const errors = [];\n541\t      for (const file of accepted) {\n542\t        try {\n543\t          const form = new FormData();\n544\t          form.append(\"file\", file, file.name);\n545\t          // No explicit Content-Type — the browser sets the multipart boundary.\n546\t          await readRuntimeJson(await runtimeFetch(\n547\t            `/files/upload?workspace=${encodeURIComponent(this.workspace)}`,\n548\t            { method: \"POST\", body: form }\n549\t          ));\n550\t          ok += 1;\n551\t        } catch (err) {\n552\t          errors.push(`${file.name}: ${err && err.message ? err.message : String(err)}`);\n553\t        }\n554\t      }\n555\t      this.uploading = false;\n556\t      const parts = [];\n557\t      if (ok) parts.push(`Uploaded ${ok} file${ok === 1 ? \"\" : \"s\"}.`);\n558\t      if (rejected) parts.push(`Skipped ${rejected} unsupported file${rejected === 1 ? \"\" : \"s\"}.`);\n559\t      if