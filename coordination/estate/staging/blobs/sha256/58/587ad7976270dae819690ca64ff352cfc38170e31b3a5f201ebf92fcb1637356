637\t                k_per_source = max(3, request.top_k // len(mentioned_sources))\n638\t                for source in mentioned_sources:\n639\t                    try:\n640\t                        res = collection.query(query_texts=[request.query], n_results=min(k_per_source, collection.count()), where={\"source\": source})\n641\t                        if res['documents'] and res['documents'][0]:\n642\t                            for doc, meta in zip(res['documents'][0], res['metadatas'][0]):\n643\t                                results_list.append((doc, meta))\n644\t                    except Exception: pass\n645\t                try:\n646\t                    gen_res = collection.query(query_texts=[request.query], n_results=min(3, collection.count()))\n647\t                    if gen_res['documents'] and gen_res['documents'][0]:\n648\t                        for doc, meta in zip(gen_res['documents'][0], gen_res['metadatas'][0]):\n649\t                            results_list.append((doc, meta))\n650\t                except Exception: pass\n651\t            else:\n652\t                try:\n653\t                    res = collection.query(query_texts=[request.query], n_results=min(request.top_k, collection.count()))\n654\t                    if res['documents'] and res['documents'][0]:\n655\t                        for doc, meta in zip(res['documents'][0], res['metadatas'][0]):\n656\t                            results_list.append((doc, meta))\n657\t                except Exception: pass\n658\t\n659\t            seen_docs = set()\n660\t            for doc, meta in results_list:\n661\t                if doc not in seen_docs:\n662\t                    seen_docs.add(doc)\n663\t                    source = meta.get('source', 'Unknown')\n664\t                    context_text += f\"[Source: {source}]\\n{doc}\\n\\n\"\n665\t                    sources.append(source)\n666\t\n667\t        lineage_audit[\"selected_sources\"] = request.selected_sources\n668\t        lineage_audit[\"sources_retrieved\"] = list(set(sources))\n669\t\n670\t        # 2. Build Prompt\n671\t        system_prompt = \"You are a helpful AI assistant. Answer based on context. Cite sources [Source: filename.ext].\"\n672\t        \n673\t        # Truncate context to prevent 'Max length reached' errors\n674\t        from ..core.context_guard import ContextGuard\n675\t        profile = ContextGuard.get_profile(request.model or \"fastflowlm\")\n676\t        context_text = ContextGuard.guard_string(context_text, profile.max_rag_context_chars, \"rag_context\")\n677\t             \n678\t        content = f\"{system_prompt}\\n\\nCONTEXT:\\n{context_text if context_text else 'No documents found.'}\\n\\nQUESTION: {request.query}\\n\\nANSWER:\"\n679\t\n680\t        # 3. Call LLM\n681\t        try:\n682\t            # Resolve model via role-based orchestrator\n683\t            active_model = await get_active_model(request.workspace, role=\"chat\")\n684\t            \n685\t            from ..core.models import get_model_config\n686\t            config = get_model_config(active_model)\n687\t            provider_name = config.get(\"provider\", \"openai\")\n688\t            provider_config = LOCAL_PROVIDERS.get(provider_name, LOCAL_PROVIDERS[\"fastflowlm\"])\n689\t            model_core = config.get(\"model\", active_model).split('/')[-1]\n690\t\n691\t            chat_url = f\"{provider_config['base_url']}/chat/completions\"\n692\t            payload = {\n693\t                \"model\": model_core,\n694\t                \"messages\": [{\"role\": \"user\", \"content\": content}],\n695\t                \"temperature\": 0.7,\n696\t                \"max_tokens\": 1024\n697\t            }\n698\t            \n699\t            async with httpx.AsyncClient(timeout=300.0) as client:\n700\t                response = await client.post(chat_url, json=payload, headers={\"Content-Type\": \"application/json\"})\n701\t                \n702\t                if response.status_code == 200:\n703\