concept; caps edge fan-out\n41\t    correlation_use_ann: bool = True     # Use HNSW ANN index when hnswlib is installed; falls back to numpy top-K\n42\t    force_reingest: bool = False # Whether to force re-processing even if already in DB\n43\t    model: Optional[str] = None # Optional model override for synthesis\n44\t\n45\t\n46\t\n47\t\n48\tclass QueryRequest(BaseModel):\n49\t    query: str\n50\t    workspace: str = \"default\"\n51\t    top_k: int = 5\n52\t    selected_sources: Optional[List[str]] = None\n53\t    provider: Optional[str] = None\n54\t    model: Optional[str] = None\n55\t    mode: str = \"semantic\" # \"semantic\", \"graph_agent\", or \"discovery_swarm\"\n56\t    active_nexus_id: Optional[str] = None # For grounding graph agents\n57\t    run_id: Optional[str] = None\n58\t\n59\tclass AdaptiveRAGRequest(BaseModel):\n60\t    query: str\n61\t    workspace: str = \"default\"\n62\t    model: str = \"Qwen3-8B-Hybrid\"\n63\t    max_retries: int = 3\n64\t\n65\tclass AdaptiveRAGResponse(BaseModel):\n66\t    answer: Optional[str]\n67\t    route: str\n68\t    route_explanation: str\n69\t    documents_retrieved: int\n70\t    documents_relevant: int\n71\t    retry_count: int\n72\t    execution_trace: List[str]\n73\t    hallucination_check: Optional[bool]\n74\t    answer_quality: Optional[bool]\n75\t\n76\t@router.post(\"/rag/ingest\")\n77\tasync def ingest_files(request: IngestRequest):\n78\t    \"\"\"Ingest files from data_in into ChromaDB using structured extraction (Docling).\"\"\"\n79\t    run_id = request.run_id or str(uuid.uuid4())\n80\t    task = task_manager.create_task(request.workspace, \"rag_ingest\", task_id=run_id)\n81\t    \n82\t    try:\n83\t        track_workflow_start(run_id, \"rag_ingest\", request.workspace, inputs=request.files or [])\n84\t        task_manager.add_aer_entry(\n85\t            run_id, \n86\t            intent=f\"Ingesting {len(request.files) if request.files else 'all'} files from data_in\",\n87\t            observation=\"Initialization complete\",\n88\t            plan=f\"1. Extract text via Docling 2. Chunk 3. Batch upsert to ChromaDB\"\n89\t        )\n90\t    except Exception as e:\n91\t        logger.warning(\"Lineage tracking failed (init): %s\", e)\n92\t\n93\t    try:\n94\t        data_in_path = get_workspace_path(request.workspace, \"data_in\")\n95\t        if not data_in_path.exists():\n96\t            task_manager.update_task(run_id, status=\"failed\", message=\"No files found in data_in\")\n97\t            raise HTTPException(404, \"No files found in data_in\")\n98\t        \n99\t        # Get files to ingest\n100\t        if request.files:\n101\t            file_paths = [data_in_path / f for f in request.files]\n102\t        else:\n103\t            file_paths = list(data_in_path.glob(\"*.*\"))\n104\t        \n105\t        # Filter for supported types\n106\t        supported = ['.txt', '.md', '.pdf', '.docx', '.pptx', '.html']\n107\t        file_paths = [f for f in file_paths if f.suffix.lower() in supported]\n108\t        \n109\t        logger.info(f\"Ingestion started for {len(file_paths)} files in {data_in_path}\")\n110\t        \n111\t        if not file_paths:\n112\t            task_manager.update_task(run_id, status=\"failed\", message=\"No supported files found\")\n113\t            raise HTTPException(404, \"No supported files found\")\n114\t        \n115\t        # Get ChromaDB client\n116\t        client = get_chromadb_client(request.workspace)\n117\t        collection_name = f\"notebook_{request.notebook_id}\" if request.notebook_id else \"knowledge\"\n118\t        collection = client.get_or_create_collection(collection_name)\n119\t\n120\t        # Update task total steps\n121\t        task_manager.update_task(run_id, total_steps=len(file_paths), progress=10)\n122\t        \n123\t        ingested = []\n124\t        for idx, file_path in enumerate(file_paths):\n125\t            try:\n126\t                msg = f\"Processing {file_path.name} ({idx+1}/{len(file_paths)})...\"\n127\t                logger.info(msg)\n128\t                task_manager.update_task(\n129\t                    run_id, \n130\t                    message=msg, \n131\t                    current_step=idx+1,\n132\t                    metadata={\n133\t                        \"stage\": \"EXTRACTING\",\n134\t                        \"current_file\": file_path.name\n135\t                    }\n136\t                )\n137\t                \n138\t                # Emit AER for extraction\n139\t                try:\n140\t                    track_aer(run_id, \"rag_ingest\", request.workspace, f\"Extracting {file_path.name}\", \"Docling engine started\")\n141\t                except Exception:\n142\t                    pass\n143\t                text = extract_structured_text(file_path)\n144\t                print(f\"DEBUG: Extracted {len(text)} chars from {file_path.name}. Preview: {text[:100]}...\")\n145\t                \n146\t                # Better chunking (split by paragraphs, then size limit)\n147\t                raw_chunks = [c.strip() for c in text.split('\\n\\n') if c.strip()]\n148\t                if not raw_chunks and text.strip():\n149\t                    raw_chunks = [text.strip()]\n150\t                \n151\t                chunks = []\n152\t                max_chunk_chars = 4000\n153\t                for rc in raw_chunks:\n154\t                    if len(rc) > max_chunk_chars:\n155\t                        for i in range(0, len(rc), max_chunk_chars):\n156\t                            chunks.append(rc[i:i+max_chunk_chars])\n157\t                    else:\n158\t                        chunks.append(rc)\n159\t                \n160\t                if chunks:\n161\t                    try:\n162\t                        task_manager.update_task(run_id, metadata={\"stage\": \"INDEXING\", \"current_file\": file_path.name, \"chunks\": len(chunks)})\n163\t                        \n164\t                        # 1. DELETE old entries for this source to ensure fresh start\n165\t                        logger.info(f\"Clearing old vectors for {file_path.name} to ensure fresh ingestion.\")\n166\t                        collection.delete(where={\"source\": file_path.name})\n167\t\n168\t                        # 2. UPLOAD in batches\n169\t                        batch_size = request.batch_size or 500\n170\t                        for i in range(0, len(chunks), batch_size):\n171\t                            batch_chunks = chunks[i:i + batch_size]\n172\t                            batch_ids = [f\"{file_path.stem}_{run_id[-4:]}_{j}\" for j in range(i, i + len(batch_chunks))]\n173\t                            batch_metadatas = [\n174\t                                {\"source\": file_path.name, \"chunk_index\": j, \"run_id\": run_id} \n175\t                                for j in range(i, i + len(batch_chunks))\n176\t                            ]\n177\t                            collection.add(documents=batch_chunks, metadatas=batch_metadatas, ids=batch_ids)\n178\t                    except Exception as index_e:\n179\t                        logger.error(f\"Vector Indexing error for {file_path.name}: {index_e}\")\n180\t                        task_manager.add_aer_entry(run_id, \"Error\", f\"Indexing Failed {file_path.name}: {str(index_e)}\")\n181\t                        # Do not abort the loop, let it continue to deep synthesis\n182\t                \n183\t                # 3. DEEP SYNTHESIS (Optional)\n184\t                if request.deep_synthesis:\n185\t                    try:\n186\t                        from ..synthesis.engine import parallel_extract_triples\n187\t                        from ..graph.triples import save_knowledge_triples\n188\t                        \n189\t                        track_aer(run_id, \"rag_ingest\", request.workspace, f\"Deep Synthesis for {file_path.name}\", \"Extracting triples via LLM Engine\")\n190\t                        task_manager.update_task(run_id, metadata={\"stage\": \"SYNTHESIZING\", \"current_file\": file_path.name})\n191\t                        \n192\t                        print(f\"DEBUG: STARTING Triple Extraction for {file_path.name}...\")\n193\t                        \n194\t                        # Prepare NPU-friendly chunks for synthesis (limit to 10 sections to prevent runaway extraction)\n195\t                        synth_chunks = chunks[:10] \n196\t                        sections = [{\"title\": f\"{file_path.name} Part {i+1}\", \"text\": c} for i, c in enumerate(synth_chunks) if len(c) > 100]\n197\t                        \n198\t                        triples = await parallel_extract_triples(\n199\t                            sections=sections,\n200\t                            run_id=run_id, \n201\t                            workspace=request.workspace,\n202\t                            strategy=request.strategy,\n203\t                            model=request.model,\n204\t                            timeout=300.0,\n205\t                            parallel_limit=2\n206\t\n207\t                        )\n208\t                        print(f\"DEBUG: FINISHED Triple Extraction for {file_path.name}: Found {len(triples)} triples\")\n209\t                        \n210\t                        if triples:\n211\t                            await save_knowledge_triples(request.workspace, triples, file_path.name)\n212\t                            track_aer(run_id, \"rag_ingest\", request.workspace, f\"Synthesis complete for {file_path.name}\", f\"Extracted {len(triples)} triples\")\n213\t                            \n214\t                            # 3b. Generate Librarian Wiki Article (Karpathy-style)\n215\t                            try:\n216\t                                from ..synthesis.engine import save_concept_article\n217\t                                # Use the first few triples to identify the primary concept or use the filename\n218\t                                primary_concept = file_path.stem\n219\t                                summary_prompt = f\"Summarize the core concepts of this document section in 3-4 sentences for a technical wiki:\\n\\n{text[:2000]}\"\n220\t                                from ..synthesis.engine import call_llm\n221\t                                summary = await call_llm(summary_prompt, run_id=run_id, workspace=request.workspace)\n222\t                                \n223\t                                wiki_file = await save_concept_article(\n224\t                                    workspace=request.workspace,\n225\t                                    concept_name=primary_concept,\n226\t                                    summary=summary,\n227\t                                    relationships=[t.model_dump() for t in triples[:10]],\n228\t                                    source_files=[file_path.name]\n229\t                                )\n230\t                                track_aer(run_id, \"rag_ingest\", request.workspace, f\"Wiki Generated\", f\"Saved Rationale Hub to {primary_concept}.md\")\n231\t                            except Exception as wiki_e:\n232\t                                logger.error(f\"Wiki generation error: {wiki_e}\")\n233\t                    except Exception as synth_e:\n234\t                        logger.error(f\"Deep Synthesis error: {synth_e}\")\n235\t                        track_aer(run_id, \"rag_ingest\", request.workspace, f\"Synthesis failed for {file_path.name}\", str(synth_e))\n236\t\n237\t                ingested.append({\"file\": file_path.name, \"chunks\": len(chunks)})\n238\t                task_manager.update_task(run_id, progress=10 + int(80 * (idx+1) / len(file_paths)))\n239\t                \n240\t            except Exception as e:\n241\t                task_manager.add_aer_entry(run_id, \"Error\", f\"Failed {file_path.name}: {str(e)}\")\n242\t                ingested.append({\"file\": file_path.name, \"error\": str(e)})\n243\t        \n244\t        # 4. FINAL CLUSTERING & CORRELATION (if deep synthesis enabled)\n245\t        if request.deep_synthesis:\n246\t            try:\n247\t                from ..graph.clustering_service import ClusteringService\n248\t                from ..synthesis.correlation import run_full_correlation_suite\n249\t                \n250\t                track_aer(run_id, \"rag_ingest\", request.workspace, \"Running Topological Clustering\", \"Community detection started (LPA)\")\n251\t                task_manager.update_task(run_id, metadata={\"stage\": \"CLUSTERING\"})\n252\t                cluster_results = await ClusteringService.run_lpa_on_workspace(request.workspace)\n253\t                \n254\t                track_aer(run_id, \"rag_ingest\", request.workspace, \"Running Knowledge-to-Code Correlation\", \"Cross-linking Concepts and Symbols\")\n255\t                task_manager.update_task(run_id, metadata={\"stage\": \"CORRELATING\"})\n256\t                correlation_results = await run_full_correlation_suite(\n257\t                    request.workspace,\n258\t                    threshold=request.correlation_threshold,\n259\t                    top_k_per_concept=request.correlation_top_k,\n260\t                    use_ann=request.correlation_use_ann,\n261\t                )\n262\t                \n263\t                track_aer(run_id, \"rag_ingest\", request.workspace, \"Deep Processing complete\", \n264\t                          f\"Clusters: {cluster_results.get('communities_found', 0)}, \" \n265\t                          f\"Safe Links: {correlation_results.get('safe_links', 0)}, \"\n266\t                          f\"Aggressive Links: {correlation_results.get('aggressive_links', 0)}\")\n267\t            except Exception as post_e:\n268\t                logger.error(f\"Post-processing error: {post_e}\")\n269\t \n270\t\n271\t        task_manager.update_task(run_id, status=\"completed\", progress=100, message=\"Ingestion finished successfully\")\n272\t        try:\n273\t            track_workflow_complete(\n274\t                run_id, \n275\t                \"rag_ingest\", \n276\t                request.workspace, \n277\t                [\"extraction\", \"chunking\", \"upsert\"], \n278\t                0, \n279\t                outputs=[f\"chromadb:{collection_name}\"]\n280\t            ) \n281\t        except Exception:\n282\t            pass\n283\t        \n284\t        return {\n285\t            \"status\": \"completed\",\n286\t            \"run_id\": run_id,\n287\t            \"workspace\": request.workspace,\n288\t            \"ingested\": ingested,\n289\t            \"total_documents\": collection.count()\n290\t        }\n291\t        \n292\t    except HTTPException:\n293\t        raise\n294\t    except Exception as e:\n295\t        task_manager.update_task(run_id, status=\"failed\", message=str(e))\n296\t        raise HTTPException(500, f\"Ingestion failed: {str(e)}\")\n297\t\n298\t\n299\t@router.get(\"/rag/logs\")\n300\tasync def get_rag_logs(workspace: str = \"default\"):\n301\t    \"\"\"Get the latest ingestion tasks from TaskManager.\"\"\"\n302\t    try:\n303\t        tasks = task_manager.list_tasks(workspace)\n304\t        rag_tasks = [t for t in tasks if t.type == \"rag_ingest\"]\n305\t        if not rag_tasks:\n306\t            return {\"tasks\": []}\n307\t        \n308\t        # Sort by updated_at descending\n309\t        rag_tasks.sort(key=lambda x: x.updated_at, reverse=True)\n310\t        \n311\t        return {\"tasks\": [t.model_dump() for t in rag_tasks[:5]]}\n312\t    except Exception as e:\n313\t        return {\"error\": str(e), \"tasks\": []}\n314\t\n315\t\n316\t@router.get(\"/rag/status\")\n317\tasync def get_rag_status(workspace: str = \"default\"):\n318\t    \"\"\"Get RAG status and document count\"\"\"\n319\t    try:\n320\t        client = get_chromadb_client(workspace)\n321\t        collection = client.get_or_create_collection(\"knowledge\")\n322\t        \n323\t        # Get unique sources - optimized by only fetching metadatas\n324\t        all_data = collection.get(include=['metadatas'])\n325\t        sources = set()\n326\t        for meta in all_data['metadatas']:\n327\t            sources.add(meta.get('source', 'Unknown'))\n328\t        \n329\t        return {\n330\t            \"workspace\": workspace,\n331\t            \"total_chunks\": collection.count(),\n332\t            \"unique_documents\": len(sources),\n333\t            \"documents\": list(sources),\n334\t            \"sources\": list(sources) # Alias for consistency with graph API\n335\t        }\n336\t\n337\t    except Exception as e:\n338\t        raise HTTPException(500, f\"Status check failed: {str(e)}\")\n339\t\n340\t\n341\t@router.get(\"/rag/indexing-manifest\")\n342\tasync def get_indexing_manifest(workspace: str = \"default\"):\n343\t    \"\"\"Reconcile workspace files with ChromaDB to find unindexed or changed documents.\"\"\"\n344\t    try:\n345\t        # 1. Get indexed sources\n346\t        client = get_chromadb_client(workspace)\n347\t        collection = client.get_or_create_collection(\"knowledge\")\n348\t        all_data = collection.get(include=['metadatas'])\n349\t        \n350\t        indexed_sources = {} # source_name -> {chunk_count, last_indexed}\n351\t        if all_data.get('metadatas'):\n352\t            for meta in all_data['metadatas']:\n353\t                if meta is None: continue\n354\t                src = meta.get('source')\n355\t                if not src: continue\n356\t                if src not in indexed_sources:\n357\t                    indexed_sources[src] = {\"chunks\": 0, \"last_indexed\": meta.get('timestamp')}\n358\t                indexed_sources[src][\"chunks\"] += 1\n359\t\n360\t        # 2. Get disk files (Recursive scan focus on data_in and root)\n361\t        data_in_path = get_workspace_path(workspace, \"data_in\")\n362\t        supported = ['.txt', '.md', '.pdf', '.docx', '.pptx', '.html', '.py', '.ts', '.json', '.sql']\n363\t        \n364\t        manifest = []\n365\t        import os\n366\t        from ..core.workspace import get_workspace_path\n367\t        \n368\t        import os\n369\t        for base_path_obj in [data_in_path]:\n370\t            base_path = str(base_path_obj)\n371\t            if not os.path.exists(base_path):\n372\t                continue\n373\t                \n374\t            for root, dirs, files in os.walk(base_path):\n375\t                # Skip some folders\n376\t                if \"chromadb\" in root or \"__pycache__\" in root or \".git\" in root:\n377\t                    continue\n378\t                \n379\t                for name in files:\n380\t                    file_path = Path(root) / name\n381\t                    ext = file_path.suffix.lower()\n382\t                    if ext not in supported:\n383\t                        continue\n384\t                        \n385\t                    # Use os.path.relpath for Windows resilience (handles c: vs C: issues)\n386\t                    rel_path_str = os.path.relpath(str(file_path), base_path)\n387\t                    source_key = name # We often use just the filename as the source key\n388\t                    \n389\t                    status = \"MISSING\"\n390\t                    chunks = 0\n391\t                    if source_key in indexed_sources:\n392\t                        status = \"ALIGNED\" # Basic check: existence. In future: hash check\n393\t                        chunks = indexed_sources[source_key][\"chunks\"]\n394\t                    \n395\t                    manifest.append({\n396\t                        \"name\": name,\n397\t                        \"path\": rel_path_str.replace(\"\\\\\", \"/\"),\n398\t                        \"status\": status,\n399\t                        \"chunks\": chunks,\n400\t                        \"size\": file_path.stat().st_size,\n401\t                        \"modified\": file_path.stat().st_mtime,\n402\t                        \"type\": ext.lstrip('.')\n403\t                    })\n404\t                    \n405\t        return {\n406\t            \"workspace\": workspace,\n407\t            \"manifest\": manifest,\n408\t            \"total_indexed\": len(indexed_sources)\n409\t        }\n410\t    except Exception as e:\n411\t        raise HTTPException(500, f\"Indexing manifest failed: {str(e)}\")\n412\t\n413\t\n414\t@router.post(\"/rag/query\")\n415\tasync def query_rag(request: QueryRequest):\n416\t    \"\"\"Test semantic search\"\"\"\n417\t    try:\n418\t        client = get_chromadb_client(request.workspace)\n419\t        collection = client.get_or_create_collection(\"knowledge\")\n420\t        \n421\t        if collection.count() == 0:\n422\t            return {\n423\t                \"results\": [],\n424\t                \"message\": \"Knowledge base is empty\"\n425\t            }\n426\t        \n427\t        results = collection.query(\n428\t            query_texts=[request.query],\n429\t            n_results=min(request.top_k, collection.count())\n430\t        )\n431\t        \n432\t        formatted_results = []\n433\t        for doc, meta, distance in zip(\n434\t            results['documents'][0],\n435\t            results['metadatas'][0],\n436\t            results['distances'][0]\n437\t        ):\n438\t            formatted_results.append({\n439\t                \"text\": doc,\n440\t                \"source\": meta.get('source', 'Unknown'),\n441\t                \"relevance\": round((1 - distance) * 100, 1)\n442\t            })\n443\t        \n444\t\n445\t        return {\n446\t            \"query\": request.query,\n447\t            \"results\": formatted_results,\n448\t            \"count\": len(formatted_results)\n449\t        }\n450\t        \n451\t    except Exception as e:\n452\t        raise HTTPException(500, f\"Query failed: {str(e)}\")\n453\t@router.post(\"/rag/chat\")\n454\tasync def chat_rag(request: QueryRequest):\n455\t    \"\"\"RAG-augmented chat for workspace documents or Neural Graph Agent\"\"\"\n456\t    # Generate a consistent run_id for lineage tracking\n457\t    run_id = request.run_id or f\"chat-{uuid.uuid4().hex[:8]}\"\n458\t    start_time = datetime.now()\n459\t    \n460\t    # Audit trail: Include configuration details\n461\t    lineage_audit = {\n462\t        \"run_id\": run_id,\n463\t        \"workspace\": request.workspace,\n464\t        \"mode\": request.mode,\n465\t        \"provider\": request.provider,\n466\t        \"model\": request.model,\n467\t        \"top_k\": request.top_k,\n468\t        \"active_nexus_id\": request.active_nexus_id,\n469\t        \"timestamp\": start_time.isoformat()\n470\t    }\n471\t\n472\t    try:\n473\t        # Handle Graph Agent Mode (Linear)\n474\t        if request.mode == \"graph_agent\":\n475\t            # 1. Load the System Workflow Definition\n476\t            from .workflow_routes import workflow_storage\n477\t            from .studio_executor import topological_sort, StudioExecuteRequest\n478\t            \n479\t            wf_def = workflow_storage.get_workflow(\"System_GraphChatAgent\")\n480\t            if not wf_def:\n481\t                 track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, \"System_GraphChatAgent definition missing\")\n482\t                 raise HTTPException(404, \"System_GraphChatAgent workflow definition not found.\")\n483\t\n484\t            # 2. Trigger Workflow Execution\n485\t            # Map workflow definition to request nodes/edges\n486\t            nodes = wf_def.get(\"nodes\", [])\n487\t            edges = wf_def.get(\"edges\", [])\n488\t            \n489\t            # Update the LLM node with the user's specific request and provider/model choice\n490\t            for node in nodes:\n491\t                if node.get(\"type\") == \"llm\":\n492\t                    if \"config\" not in node[\"data\"]: node[\"data\"][\"config\"] = {}\n493\t                    if request.model:\n494\t                        node[\"data\"][\"config\"][\"model\"] = request.model\n495\t            \n496\t            from .studio_executor import StudioNode, StudioEdge\n497\t            pydantic_nodes = [StudioNode(**n) for n in nodes]\n498\t            pydantic_edges = [StudioEdge(**e) for e in edges]\n499\t            \n500\t            # Sort and Run\n501\t            sorted_nodes = topological_sort(pydantic_nodes, pydantic_edges)\n502\t            \n503\t            context = {\n504\t                \"message\": request.query, \n505\t                \"workspace\": request.workspace,\n506\t                \"active_nexus_id\": request.active_nexus_id\n507\t            }\n508\t            \n509\t            # PRE-CHECK: If no nexus is provided for a graph agent, fail fast to trigger UI wizard\n510\t            if not request.active_nexus_id or request.active_nexus_id == \"neural_nexus\":\n511\t                track_workflow_fail(run_id, \"chat_graph_agent\", request.workspace, \"nexus_required interruption\")\n512\t                return {\n513\t                    \"answer\": \"\",\n514\t                    \"status\": \"nexus_required\",\n515\t                    \"message\": \"Neural Graph Agent requires a grounded Nexus context selection to proceed. Use the Map or Forge to select an active Nexus.\",\n516\t                    \"run_id\": run_id,\n517\t                    \"lineage_audit\": lineage_audit\n518\t                }\n519\t\n520\t            # Security: Register ephemeral manifest for this specific chat agent run\n521\t            chat_manifest = create_ephemeral_manifest(run_id, [\"query_graph\", \"search_kb\", \"read_file\", \"get_neighbors\", \"search_knowledge_workspace\"])\n522\t            register_manifest(chat_manifest)\n523\t\n524\t            # Initial track\n525\t            track_workflow_start(run_id, \"chat_graph_agent\", request.workspace, inputs=[request.query])\n526\t            task_manager.create_task(request.workspace, \"chat_graph_agent\", task_id=run_id)\n527\t\n528\t            from .studio_executor import execute_trigger_node, 