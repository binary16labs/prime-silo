dget } from \"../widgets/memoray/lineage_graph/index.js\";\n31\timport { createCodeGraphCanvasWidget } from \"../widgets/codegraph/canvas/index.js\";\n32\timport { createSynopticWebWidget } from \"../widgets/kg3d/synoptic_web/index.js\";\n33\timport { createDagCanvasWidget } from \"../widgets/dag/canvas/index.js\";\n34\timport { createLineageTimelineWidget } from \"../widgets/run/lineage_timeline/index.js\";\n35\timport { createReasoningTraceWidget } from \"../widgets/run/reasoning_trace/index.js\";\n36\timport { createThreeRenderer } from \"../widgets/three_renderer/index.js\";\n37\timport { mapManifestToDagData } from \"../manifest_explorer/manifest-mapping.js\";\n38\timport { createBridgeContext, bridgeDeepLink } from \"./bridge-context.js\";\n39\t\n40\texport const MODES = [\n41\t  { id: \"pulse\", label: \"Pulse\", icon: \"monitoring\" },\n42\t  { id: \"memory\", label: \"Memory\", icon: \"bubble_chart\" },\n43\t  { id: \"documents\", label: \"Documents\", icon: \"description\" },\n44\t  { id: \"code\", label: \"Code 3D\", icon: \"account_tree\" },\n45\t  { id: \"flows\", label: \"Flows\", icon: \"alt_route\" },\n46\t  { id: \"runs\", label: \"Runs\", icon: \"timeline\" }\n47\t];\n48\t\n49\t// Mode-aware Benny suggestion chips. `instruction` is the human-facing intent;\n50\t// bridge-context appends the live mode/selection/workspace before dispatch.\n51\texport const CHIPS = {\n52\t  pulse: [\n53\t    { label: \"Tour this project\", instruction: \"Give me a tour of this project: what Benny is, the workflows I have, and where to start. Load the project-guide skill.\" },\n54\t    { label: \"What did I work on?\", instruction: \"Summarise what I worked on most recently across my agent sessions and git activity.\" },\n55\t    { label: \"Is the mesh healthy?\", instruction: \"Check the integration conformance and tell me if anything has drifted, with the owner file to fix.\" }\n56\t  ],\n57\t  memory: [\n58\t    { label: \"What did I work on?\", instruction: \"Summarise my most recent agent sessions and link the most relevant ones.\" },\n59\t    { label: \"Sessions that touched a file…\", instruction: \"Find which sessions touched a file I name and link each one.\" }\n60\t  ],\n61\t  documents: [\n62\t    { label: \"Ingest these docs\", instruction: \"Walk me through ingesting the documents in the current workspace into the knowledge graph as semantic triples.\" },\n63\t    { label: \"What's in this workspace?\", instruction: \"Summarise the documents and concepts in the current workspace.\" },\n64\t    { label: \"Query the docs\", instruction: \"Answer a question using the ingested documents in the current workspace.\" }\n65\t  ],\n66\t  code: [\n67\t    { label: \"Explain this graph\", instruction: \"Explain the code graph I'm looking at and the role of the selected node.\" },\n68\t    { label: \"What depends on this?\", instruction: \"Describe what depends on the selected code node and what it depends on.\" }\n69\t  ],\n70\t  flows: [\n71\t    { label: \"Help me phrase a requirement\", instruction: \"Help me phrase a clear requirement for a pipeline I can then plan and run.\" },\n72\t    { label: \"Re-run the last manifest\", instruction: \"Re-run the most recent manifest and report the outcome.\" }\n73\t  ],\n74\t  runs: [\n75\t    { label: \"Explain this run\", instruction: \"Explain what happened in the selected run, step by step.\" },\n76\t    { label: \"Why did it fail?\", instruction: \"If the selected run failed, diagnose the likely cause from its lineage.\" }\n77\t  ]\n78\t};\n79\t\n80\t// File types Benny's ingestion pipeline accepts for upload (mirrors the\n81\t// runtime's /api/files/upload allow-list). Drag-drop and the picker filter to\n82\t// these before sending so the operator gets an immediate, honest rejection.\n83\texport const UPLOAD_EXTENSIONS = [\".pdf\", \".txt\", \".md\", \".json\"];\n84\t\n85\t/* ── pure helpers (unit-tested) ──────────────────────────────────────── */\n86\t\n87\t// Map the runtime indexing-manifest status onto an operator-facing label.\n88\t// ALIGNED  = the file's chunks are present in the knowledge graph (ingested).\n89\t// MISSING  = on disk but not yet ingested.\n90\t// STAGED   = present in data_in but outside the indexing manifest (e.g. an\n91\t//            unsupported type, or freshly uploaded before the next rescan).\n92\texport function fileStatusLabel(status) {\n93\t  switch (status) {\n94\t    case \"ALIGNED\": return \"Ingested\";\n95\t    case \"MISSING\": return \"Not ingested\";\n96\t    case \"STAGED\": return \"Staged\";\n97\t    default: return status || \"Unknown\";\n98\t  }\n99\t}\n100\t\n101\texport function fileStatusClass(status) {\n102\t  switch (status) {\n103\t    case \"ALIGNED\": return \"is-ingested\";\n104\t    case \"MISSING\": return \"is-pending\";\n105\t    default: return \"is-staged\";\n106\t  }\n107\t}\n108\t\n109\t// Merge the data_in listing with the indexing manifest into one rows array the\n110\t// Documents view renders. Pure so the merge logic is unit-testable without a\n111\t// runtime. `dataIn` entries may be strings or {name} objects.\n112\texport function mergeFileStatus(dataIn, manifest) {\n113\t  const rows = Array.isArray(dataIn) ? dataIn : [];\n114\t  const byName = new Map();\n115\t  for (const entry of Array.isArray(manifest) ? manifest : []) {\n116\t    if (entry && entry.name) byName.set(entry.name, entry);\n117\t  }\n118\t  return rows.map((f) => {\n119\t    const name = typeof f === \"string\" ? f : (f && f.name) || \"\";\n120\t    const m = byName.get(name);\n121\t    if (m) {\n122\t      return { name, status: m.status || \"MISSING\", chunks: m.chunks || 0, type: m.type || \"\" };\n123\t    }\n124\t    return { name, status: \"STAGED\", chunks: 0, type: \"\" };\n125\t  });\n126\t}\n127\t\n128\texport function readQuery(hash) {\n129\t  const out = { mode: \"\", id: \"\" };\n130\t  try {\n131\t    const h = typeof hash === \"string\" ? hash : (typeof window !== \"undefined\" && window.