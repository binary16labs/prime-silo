e: 0.62rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 999px; white-space: nowrap; }\n    .tag-fair { background: rgba(139,156,139,0.15); color: var(--accent-sage); border: 1px solid rgba(139,156,139,0.3); }\n    .tag-worst { background: rgba(219,83,63,0.12); color: var(--accent-rust); border: 1px solid rgba(219,83,63,0.3); }\n    .scn-pct { font-family: var(--font-serif); font-size: 1.5rem; font-weight: 600; }\n    .scn-pct.win { color: var(--accent-sage); }\n    .scn-pct.nowin { color: var(--accent-rust); }\n    .bars { margin: 1rem 0 0.6rem; display: grid; gap: 0.5rem; }\n    .barrow { display: grid; grid-template-columns: 130px 1fr 90px; align-items: center; gap: 0.8rem; font-size: 0.78rem; }\n    .barrow .lbl { color: var(--text-muted); font-family: var(--font-mono); }\n    .track { height: 14px; background: var(--bg-code); border-radius: 7px; overflow: hidden; }\n    .fill { height: 100%; border-radius: 7px; transition: width 0.8s ease; }\n    .fill.no { background: linear-gradient(90deg, #b5432f, var(--accent-rust)); }\n    .fill.yes { background: linear-gradient(90deg, #6f7e6f, var(--accent-sage)); }\n    .val { font-family: var(--font-mono); text-align: right; color: var(--text-main); }\n    .scn-note { font-size: 0.82rem; color: var(--text-muted); margin-top: 0.7rem; }\n    .scn-note.control { color: var(--accent-taupe); }\n    /* repro */\n    pre { background: var(--bg-code); border: 1px solid var(--border-light); border-radius: 8px; padding: 1rem 1.2rem; font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-main); overflow-x: auto; }\n    .foot { color: var(--text-muted); font-size: 0.8rem; margin-top: 2rem; text-align: center; }\n  </style>\n</head>\n<body>\n  <div class=\"wrap\">\n    <a class=\"back\" href=\"./\">&larr; Memo-Ray</a>\n    <h1>Token Audit — <span class=\"em\">independent validation</span></h1>\n    <p class=\"lede\">Does the Memo-Ray MCP layer actually cut the tokens an agent spends re-ingesting session history? This page reports a measured answer — including the cases where it doesn't.</p>\n\n    <div class=\"card headline\">\n      <div class=\"eyebrow\">Headline · fair scenarios only</div>\n      <div class=\"big\" id=\"hl-pct\">—</div>\n      <div class=\"sub\">input-token reduction vs. direct file access</div>\n      <div class=\"tokens\" id=\"hl-tokens\"></div>\n    </div>\n\n    <div class=\"card\">\n      <div class=\"eyebrow\">Methodology</div>\n      <ul class=\"meth\">\n        <li><span class=\"tick\">✓</span><span><b>Real tokenizer.</b> Counts via <span id=\"m-counter\" class=\"mono\"></span> — not a <span class=\"mono\">length/4</span> heuristic.</span></li>\n        <li><span class=\"tick\">✓</span><span><b>No injected constants.</b> Only the actual payload each arm puts into context is counted; the shared prompt cancels.</span></li>\n        <li><span class=\"tick\">✓</span><span><b>Input tokens only.</b> No model call is made, so output tokens are not estimated — and the &ldquo;Token Tax&rdquo; is an input-token claim.</span></li>\n        <li><span class=\"tick\">✓</span><span><b>Strawman excluded.</b> Worst-case baselines are shown but kept out of the headline so the number can't be inflated.</span></li>\n      </ul>\n      <div class=\"caveat\" id=\"m-caveat\"></div>\n    </div>\n\n    <div class=\"eyebrow\" style=\"margin: 2rem 0 0.8rem;\">Per-scenario</div>\n    <div id=\"scenarios\"></div>\n\n    <div class=\"card\">\n      <div class=\"eyebrow\">Reproduce it</div>\n      <pre># subscriber-friendly: offline Claude tokenizer, no key, no spend\ncd mcp-server &amp;&amp; node run_benchmark_v2.js\n\n# exact numbers: set a key (count_tokens is free)\nANTHROPIC_API_KEY=sk-ant-... node run_benchmark_v2.js</pre>\n    </div>\n\n    <p class=\"foot\" id=\"foot\"></p>\n  </div>\n\n  <script src=\"./token_audit_v2.js\"></script>\n  <script>\n    (function () {\n      var d = window.tokenAuditData;\n      var root = document.getElementById('scenarios');\n      if (!d) { root.innerHTML = '<div class=\"card\">No audit data found. Run <span class=\"mono\">node run_benchmark_v2.js</span> to generate it.</div>'; return; }\n\n      document.getElementById('hl-pct').textContent = d.headline.savingsPercent + '%';\n      document.getElementById('hl-tokens').textContent =\n        d.headline.totalNoMcpInputTokens.toLocaleString() + ' → ' + d.headline.totalMcpInputTokens.toLocaleString() +\n        ' tokens across ' + d.headline.fairScenarioCount + ' fair scenarios';\n      document.getElementById('m-counter').textContent = d.methodology.counter;\n      var cav = document.getElementById('m-caveat');\n      if (d.methodology.offlineCaveat) { cav.textContent = d.methodology.offlineCaveat; }\n      else { cav.textContent = 'Exact count_tokens numbers — authoritative for the configured model.'; }\n\n      d.summary.forEach(function (s) {\n        var pctOfNo = s.noMcpInputTokens > 0 ? Math.round((s.mcpInputTokens / s.noMcpInputTokens) * 100) : 0;\n        var win = s.mcpWins;\n        var isControl = s.baseline === 'fair' && !win;\n        var el = document.createElement('div');\n        el.className = 'scn';\n        el.innerHTML =\n          '<div class=\"scn-head\">' +\n            '<div style=\"display:flex;align-items:center;gap:0.7rem;flex-wrap:wrap;\">' +\n              '<span class=\"scn-name\">' + s.name + '</span>' +\n              '<span class=\"tag ' + (s.baseline === 'fair' ? 'tag-fair\">fair baseline' : 'tag-worst\">worst-case baseline') + '</span>' +\n            '</div>' +\n            '<span class=\"scn-pct ' + (win ? 'win' : 'nowin') + '\">' + s.savingsPercent + '%</span>' +\n          '</div>' +\n          '<div class=\"bars\">' +\n            '<div class=\"barrow\"><span class=\"lbl\">direct files</span><div class=\"track\"><div class=\"fill no\" style=\"width:100%\"></div></div><span class=\"val\">' + s.noMcpInputTokens.toLocaleString() + '</span></div>' +\n            '<div class=