{"parentUuid":"3bb98021-03c4-49ca-827a-54fc6444a3b7","isSidechain":false,"promptId":"db8bec93-5bf0-40a7-b290-8690f0038739","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Sqd9Mopxresko34QmNwVpi","type":"tool_result","content":"1\t\"\"\"\n2\tWorkspace Isolation - Multi-tenant workspace management\n3\t\"\"\"\n4\t\n5\tfrom pathlib import Path\n6\tfrom typing import Optional, List, Dict, Any\n7\timport os\n8\timport yaml\n9\timport json\n10\t\n11\tfrom .schema import WorkspaceManifest\n12\t\n13\t\n14\t# Resolve workspace root: prefer $BENNY_HOME/workspaces when the env var is set\n15\t# (i.e. when the API was launched via `benny up`); fall back to a relative\n16\t# \"workspace\" dir for plain dev-server runs from the project root.\n17\t_benny_home = os.environ.get(\"BENNY_HOME\")\n18\tWORKSPACE_ROOT = Path(_benny_home) / \"workspaces\" if _benny_home else Path(\"workspace\")\n19\t\n20\t\n21\tdef get_workspace_path(workspace_id: str = \"default\", subdir: str = \"\") -> Path:\n22\t    \"\"\"\n23\t    Get workspace-scoped path for multi-tenant isolation.\n24\t    Strictly validates that the path is within WORKSPACE_ROOT to prevent traversal.\n25\t    \n26\t    Args:\n27\t        workspace_id: Workspace identifier\n28\t        subdir: Subdirectory within workspace (data_in, data_out, chromadb, etc.)\n29\t        \n30\t    Returns:\n31\t        Absolute path to the workspace directory or subdirectory\n32\t    \"\"\"\n33\t    # 1. Resolve potential traversal before joining\n34\t    # We use .resolve() to satisfy traversal checks\n35\t    root_abs = WORKSPACE_ROOT.resolve()\n36\t    \n37\t    # Construct the target path\n38\t    target = root_abs / str(workspace_id)\n39\t    if subdir:\n40\t        target = target / str(subdir)\n41\t        \n42\t    target_abs = target.resolve()\n43\t    \n44\t    # 2. Strict validation: Target must be a child of root_abs\n45\t    try:\n46\t        common = os.path.commonpath([str(root_abs), str(target_abs)])\n47\t        if common != str(root_abs):\n48\t            raise PermissionError(f\"Path traversal attempt detected: {workspace_id}/{subdir}\")\n49\t    except ValueError:\n50\t        raise PermissionError(f\"Invalid workspace path: {workspace_id}/{subdir}\")\n51\t        \n52\t    return target_abs\n53\t\n54\t\n55\t# =============================================================================\n56\t# Agent Sandbox (ADR-001) — restricted write surface for agent-authored content\n57\t# =============================================================================\n58\t#\n59\t# The agent has full *read* access across the workspace, but its *writes* are\n60\t# confined to ``agent_sandbox/`` and its four declared subdirectories. Every\n61\t# write is gated by ``benny.api.agent_scope.agent_scope_guard`` middleware and\n62\t# lineage-emitted as a ``process=agent_authorship`` triple lineage event.\n63\t#\n64\t# Promotion to the deterministic side follows:\n65\t#     drafts/<file>  →  HITL review  →  sign_manifest()  →  manifests/  →  run\n66\t\n67\tAGENT_SANDBOX_DIR = \"agent_sandbox\"\n68\tAGENT_SANDBOX_SUBDIRS = (\"views\", \"notes\", \"drafts\", \"skills\")\n69\t\n70\t\n71\tdef get_agent_sandbox_path(workspace_id: str = \"default\", subdir: str = \"\") -> Path:\n72\t    \"\"\"Return the absolute path to the workspace's agent sandbox or a subdir.\n73\t\n74\t    ``subdir`` must be one of :data:`AGENT_SANDBOX_SUBDIRS` when provided.\n75\t    Path traversal attempts raise ``PermissionError`` via\n76\t    :func:`get_workspace_path`'s strict validation.\n77\t    \"\"\"\n78\t    if subdir and subdir not in AGENT_SANDBOX_SUBDIRS:\n79\t        raise ValueError(\n80\t            f\"Unknown agent_sandbox subdir {subdir!r}; \"\n81\t            f\"expected one of {AGENT_SANDBOX_SUBDIRS}\"\n82\t        )\n83\t    relative = AGENT_SANDBOX_DIR\n84\t    if subdir:\n85\t        relative = f\"{AGENT_SANDBOX_DIR}/{subdir}\"\n86\t    return get_workspace_path(workspace_id, relative)\n87\t\n88\t\n89\tPINNED_VIEWS_DIR = \"views\"\n90\t\n91\t# =============================================================================\n92\t# Session Checkpoints (ADR-001 Phase H) — draft + pinned paths\n93\t# =============================================================================\n94\t#\n95\t# Draft checkpoints live inside the agent sandbox:\n96\t#     ``$BENNY_HOME/workspaces/<ws>/agent_sandbox/checkpoints/``\n97\t# Pinned (HMAC-signed) checkpoints live outside the sandbox at:\n98\t#     ``$BENNY_HOME/workspaces/<ws>/checkpoints/``\n99\t#\n100\t# The split mirrors draft views (``agent_sandbox/views/``) vs pinned views\n101\t# (``views/``) introduced in Phase D3 / F2.\n102\t\n103\tCHECKPOINT_DRAFT_SUBDIR = \"checkpoints\"\n104\tCHECKPOINT_PINNED_DIR = \"checkpoints\"\n105\t\n106\t\n107\tdef get_checkpoint_draft_dir(workspace_id: str = \"default\") -> Path:\n108\t    \"\"\"Return the absolute path to the workspace's *draft* checkpoints directory.\n109\t\n110\t    Draft checkpoints live inside ``agent_sandbox/checkpoints/``. The agent has\n111\t    write access here (via ``AgentScopeMiddleware``). Pinning moves a checkpoint\n112\t    to the canonical location outside the sandbox.\n113\t    \"\"\"\n114\t    return get_agent_sandbox_path(workspace_id) / CHECKPOINT_DRAFT_SUBDIR\n115\t\n116\t\n117\tdef get_checkpoint_pinned_dir(workspace_id: str = \"default\") -> Path:\n118\t    \"\"\"Return the absolute path to the workspace's *pinned* checkpoints directory.\n119\t\n120\t    Pinned checkpoints live at ``$BENNY_HOME/workspaces/<ws>/checkpoints/``\n121\t    (outside the agent sandbox). ``AgentScopeMiddleware`` 403s every\n122\t    agent-scoped POST to ``/api/checkpoints/pin`` — pinning is human-only.\n123\t    \"\"\"\n124\t    return get_workspace_path(workspace_id, CHECKPOINT_PINNED_DIR)\n125\t\n126\t\n127\tdef get_pinned_views_path(workspace_id: str = \"default\") -> Path:\n128\t    \"\"\"Return the absolute path to the workspace's *pinned* views directory.\n129\t\n130\t    ADR-001 Phase F2: pinned views live OUTSIDE the agent sandbox at\n131\t    ``$BENNY_HOME/workspaces/<ws>/views/``. The agent cannot reach them —\n132\t    `AgentScopeMiddleware` 403s every agent-scoped POST that does not target\n133\t    `/api/agent_sandbox/*`. Pinning is a human-only promotion: the human\n134\t    reviews an agent draft from `agent_sandbox/views/`, the runtime signs\n135\t    it, embeds the signature, and writes it here for replayable use.\n136\t    \"\"\"\n137\t    return get_workspace_path(workspace_id, PINNED_VIEWS_DIR)\n138\t\n139\t\n140\tdef is_within_agent_sandbox(workspace_id: str, candidate: Path | str) -> bool:\n141\t    \"\"\"Return True iff *candidate* resolves to a path inside the workspace's\n142\t    agent sandbox. Used by :mod:`benny.api.agent_scope` to authorise writes\n143\t    from callers carrying ``X-Benny-Agent-Scope: sandbox``.\n144\t    \"\"\"\n145\t    try:\n146\t        sandbox = get_agent_sandbox_path(workspace_id).resolve()\n147\t    except PermissionError:\n148\t        return False\n149\t    try:\n150\t        candidate_abs = Path(candidate).resolve()\n151\t    except (OSError, ValueError):\n152\t        return False\n153\t    try:\n154\t        common = os.path.commonpath([str(sandbox), str(candidate_abs)])\n155\t    except ValueError:\n156\t        # Different drives on Windows, etc.\n157\t        return False\n158\t    return common == str(sandbox)\n159\t\n160\t\n161\tdef ensure_workspace_structure(workspace_id: str = \"default\") -> dict:\n162\t    \"\"\"\n163\t    Create workspace directory structure and initial manifest if it doesn't exist.\n164\t    \"\"\"\n165\t    base = get_workspace_path(workspace_id)\n166\t    subdirs = [\n167\t        \"agents\", \"chromadb\", \"data_in\", \"data_out\", \"reports\", \"skills\", \"runs\", \"staging\",\n168\t        \"live/sources\", \"live/cache\", \"live/runs\",\n169\t        # ADR-001: agent sandbox — restricted agent-write surface\n170\t        f\"{AGENT_SANDBOX_DIR}/views\",\n171\t        f\"{AGENT_SANDBOX_DIR}/notes\",\n172\t        f\"{AGENT_SANDBOX_DIR}/drafts\",\n173\t        f\"{AGENT_SANDBOX_DIR}/skills\",\n174\t        # Phase H: session checkpoints (draft inside sandbox, pinned outside)\n175\t        f\"{AGENT_SANDBOX_DIR}/checkpoints\",\n176\t    ]\n177\t    \n178\t    created = []\n179\t    for subdir in subdirs:\n180\t        path = base / subdir\n181\t        if not path.exists():\n182\t            path.mkdir(parents=True, exist_ok=True)\n183\t            created.append(subdir)\n184\t    \n185\t    # Initialize manifest if missing\n186\t    manifest_path = base / \"manifest.yaml\"\n187\t    if not manifest_path.exists():\n188\t        manifest = WorkspaceManifest(version=\"1.0.0\")\n189\t        with open(manifest_path, \"w\", encoding=\"utf-8\") as f:\n190\t            yaml.dump(manifest.dict(), f, sort_keys=False)\n191\t        created.append(\"manifest.yaml\")\n192\t    \n193\t    # Create default Operating Manuals if they don't exist\n194\t    _create_default_manual(base / \"SOUL.md\", \"\"\"# Name\n195\tBenny\n196\t\n197\t# Purpose\n198\tEnterprise cognitive mesh orchestration platform for structured knowledge work.\n199\t\n200\t# Communication Style\n201\tProfessional, precise, and transparent. Always explain reasoning.\n202\t\n203\t# Core Values\n204\t- Accuracy over speed\n205\t- Transparency in all reasoning\n206\t- Human oversight for critical decisions\n207\t- Data privacy and security\n208\t\n209\t# Boundaries\n210\t- Never modify production data without explicit human approval\n211\t- Always cite sources when providing information\n212\t- Escalate to human reviewers when confidence is below 70%\n213\t- Never expose credentials or sensitive information in outputs\n214\t\"\"\")\n215\t\n216\t    _create_default_manual(base / \"USER.md\", \"\"\"# Organization\n217\t[Your Organization Name]\n218\t\n219\t# Authorized Personnel\n220\t- [Admin Name] (Admin)\n221\t\n222\t# Domain Context\n223\t[Describe your business