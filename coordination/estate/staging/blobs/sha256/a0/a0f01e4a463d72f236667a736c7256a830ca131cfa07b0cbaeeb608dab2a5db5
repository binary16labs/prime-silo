{"parentUuid":"1bdc3bd6-b1e7-44d2-ac71-43b73eb06e43","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\graph\\kg3d\\ontology.py","snippet":"1\timport json\n2\timport hashlib\n3\timport uuid\n4\tfrom typing import Dict, List, Any, Optional\n5\tfrom pathlib import Path\n6\tfrom ...core.graph_db import get_full_graph\n7\tfrom .schema import Node, Edge, NodeMetrics, NodeCategory, EdgeKind\n8\t\n9\tFIXTURE_PATH = (\n10\t    Path(__file__).parent.parent.parent.parent\n11\t    / \"tests\"\n12\t    / \"fixtures\"\n13\t    / \"kg3d\"\n14\t    / \"ml_knowledge_graph_v1.json\"\n15\t)\n16\t\n17\t\n18\tclass Graph:\n19\t    def __init__(self, nodes: List[Node], edges: List[Edge]):\n20\t        self.nodes = nodes\n21\t        self.edges = edges\n22\t\n23\t\n24\tasync def load_default_ontology(workspace: Optional[str] = None) -> Graph:\n25\t    \"\"\"\n26\t    Loads the ontology.\n27\t    If a workspace is provided, it attempts to fetch live data from Neo4j.\n28\t    Otherwise, it falls back to the canonical ML ontology fixture.\n29\t    \"\"\"\n30\t    if workspace:\n31\t        try:\n32\t            # show_all=True: the 3D ontology needs the COMPLETE graph, not a\n33\t            # paged slice. The default LIMIT (page_size=200) silently dropped\n34\t            # nodes (notably the Source nodes), which dangled every SOURCED_FROM\n35\t            # edge → a \"disconnected\" graph, and truncated descendant_ratio so\n36\t            # every node collapsed to aot_layer 5 (flat hierarchy).\n37\t            raw_data = get_full_graph(workspace=workspace, show_all=True)\n38\t\n39\t            if raw_data.get(\"nodes\"):\n40\t                nodes = []\n41\t                # Map Neo4j nodes to KG3D Node schema\n42\t                for n in raw_data[\"nodes\"]:\n43\t                    # Determine category based on labels and properties\n44\t                    label_list = n.get(\"labels\", [])\n45\t                    main_label = label_list[0] if label_list else \"Concept\"\n46\t\n47\t                    category = NodeCategory.CONCEPT\n48\t                    if \"Source\" in label_list:\n49\t                        category = NodeCategory.DOCUMENTATION\n50\t                    elif n.get(\"node_type\"):\n51\t                        try:\n52\t                            category = NodeCategory(n[\"node_type\"].lower())\n53\t                        except ValueError:\n54\t                            category = NodeCategory.CONCEPT\n55\t\n56\t                    # Create minimal metrics (will be recalculated by metrics.py)\n57\t                    metrics = NodeMetrics(\n58\t                        pagerank=0.0,\n59\t                        degree=0,\n60\t                        betweenness=0.0,\n61\t                        descendant_ratio=0.0,\n62\t                        prerequisite_ratio=0.0,\n63\t                        reachability_ratio=0.0,\n64\t                    )\n65\t\n66\t                    nodes.append(\n67\t                        Node(\n68\t                            id=str(n[\"id\"]),\n69\t                            canonical_name=n.get(\"name\", \"Unknown\"),\n70\t                            display_name=n.get(\"name\", \"Unknown\"),\n71\t                            category=category,\n72\t                            aot_layer=3,  # Default, metrics.py will update this\n73\t                            metrics=metrics,\n74\t                            source_refs=[n.get(\"source_doc\")] if n.get(\"source_doc\") else [],\n75\t                        )\n76\t                    )\n77\t\n78\t                edges = []\n79\t                for e in raw_data.get(\"edges\", []):\n80\t                    # Map edge type to EdgeKind\n81\t                    kind = EdgeKind.REFERENCES\n82\t                    if e.get(\"type\") == \"PREREQUISITE_FOR\":\n83\t                        kind = EdgeKind.PREREQUISITE\n84\t                    elif e.get(\"type\") == \"CONFLICTS_WITH\":\n85\t                        kind = EdgeKind.CONTRADICTS\n86\t\n87\t                    edges.append(\n88\t                        Edge(\n89\t                            id=str(uuid.uuid4())[:8],\n90\t                            source_id=str(e[\"source\"]),\n91\t                            target_id=str(e[\"target\"]),\n92\t                            kind=kind,\n93\t                            weight=e.get(\"confidence\", 1.0),\n94\t                        )\n95\t                    )\n96\t\n97\t                return Graph(nodes=nodes, edges=edges)\n98\t        except Exception as e:\n99\t            print(f\"FAILED TO LOAD LIVE ONTOLOGY FOR WORKSPACE {workspace}: {e}\")\n100\t            # Fallback to fixture if Neo4j fails or is empty\n101\t\n102\t    # Fallback to fixture\n103\t    if not FIXTURE_PATH.exists():\n104\t        return Graph(nodes=[], edges=[])  # Total empty if fixture missing too\n105\t\n106\t    with open(FIXTURE_PATH, \"r\") as f:\n107\t        data = json.load(f)\n108\t\n109\t    nodes = [Node(**n) for n in data.get(\"nodes\", [])]\n110\t    edges = [Edge(**e) for e in data.get(\"edges\", [])]\n111\t\n112\t    return Graph(nodes=nodes, edges=edges)\n113\t\n114\t\n115\tdef _enum_value(v) -> str:\n116\t    return v.value if hasattr(v, \"value\") else str(v)\n117\t\n118\t\n119\tdef content_hash(graph: Graph) -> str:\n120\t    \"\"\"\n121\t    Returns a SHA-256 hash of the *structural* graph content.\n122\t\n123\t    Only stable identity fields are hashed — node id/category and edge\n124\t    endpoints/kind/weight. Volatile fields (the per-load random edge `id` and the\n125\t    `created_at`/`updated_at` timestamps stamped at construction time) are\n126\t    deliberately excluded; including them made the hash change on every load, so\n127\t    the metrics cache never hit and `compute_all` re-ran on every request.\n128\t    \"\"\"\n129\t    nodes_data = sorted(\n130\t        (\n131\t            {\n132\t                \"id\": n.id,\n133\t                \"name\": n.canonical_name,\n134\t                \"display\": n.display_name,\n135\t                \"category\": _enum_value(n.category),\n136\t            }\n137\t            for n in graph.nodes\n138\t        ),\n139\t        key=lambda x: x[\"id\"],\n140\t    )\n141\t    edges_data = sorted(\n142\t        (\n143\t            {\"s\": e.source_id, \"t\": e.target_id, \"k\": _enum_value(e.kind), \"w\": e.weight}\n144\t            for e in graph.edges\n145\t        ),\n146\t        key=lambda x: (x[\"s\"], x[\"t\"], x[\"k\"]),\n147\t    )\n148\t\n149\t    combined = json.dumps({\"nodes\": nodes_data, \"edges\": edges_data}, sort_keys=True)\n150\t    return hashlib.sha256(combined.encode()).hexdigest()"},"type":"attachment","uuid":"c297e828-ba7f-491a-af78-b3053c84107a","timestamp":"2026-06-28T10:28:20.245Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"b5bb1984-4ef6-4dd6-8984-6e589fd772ec","version":"2.1.187","gitBranch":"HEAD"}
{"parentUuid":"c297e828-ba7f-491a-af78-b3053c84107a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\graph_db.py","snippet":"1\t\"\"\"\n2\tGraph Database Connection - Neo4j integration for the Synthesis Knowledge Engine.\n3\t\n4\tProvides connection management and core Cypher query helpers for the\n5\trelational graph, embedding storage, and synthesis operations.\n6\t\"\"\"\n7\t\n8\timport os\n9\timport json\n10\timport logging\n11\tfrom contextlib import contextmanager\n12\tfrom typing import Optional, Dict, Any, List, Tuple\n13\tfrom neo4j import GraphDatabase\n14\t\n15\tlogger = logging.getLogger(__name__)\n16\t\n17\t# =============================================================================\n18\t# CONNECTION CONFIGURATION\n19\t# =============================================================================\n20\t\n21\tNEO4J_URI = os.environ.get(\"NEO4J_URI\", \"bolt://localhost:7687\")\n22\tNEO4J_USER = os.environ.get(\"NEO4J_USER\", \"neo4j\")\n23\tNEO4J_PASSWORD = os.environ.get(\"NEO4J_PASSWORD\", \"password\")\n24\t\n25\t_driver = None\n26\t\n27\t\n28\tdef get_driver():\n29\t    \"\"\"Get or create Neo4j driver singleton with connection pooling.\"\"\"\n30\t    global _driver\n31\t    if _driver is None:\n32\t        _driver = GraphDatabase.driver(\n33\t            NEO4J_URI,\n34\t            auth=(NEO4J_USER, NEO4J_PASSWORD),\n35\t            max_connection_pool_size=16,  # Reduced from 50 for Windows stability (PBR-001)\n36\t            connection_acquisition_timeout=30,\n37\t        )\n38\t    return _driver\n39\t\n40\t\n41\tdef close_driver():\n42\t    \"\"\"Close the Neo4j driver.\"\"\"\n43\t    global _driver\n44\t    if _driver:\n45\t        _driver.close()\n46\t        _driver = None\n47\t\n48\t\n49\t@contextmanager\n50\tdef read_session():\n51\t    \"\"\"Context manager for read-only database sessions.\"\"\"\n52\t    driver = get_driver()\n53\t    session = driver.session()\n54\t    try:\n55\t        yield session\n56\t    finally:\n57\t        session.close()\n58\t\n59\t\n60\t@contextmanager\n61\tdef write_session():\n62\t    \"\"\"Context manager for write database sessions.\"\"\"\n63\t    driver = get_driver()\n64\t    session = driver.session()\n65\t    try:\n66\t        yield session\n67\t    finally:\n68\t        session.close()\n69\t\n70\t\n71\tdef introspect_schema(workspace: str = \"default\") -> dict:\n72\t    \"\"\"\n73\t    Inspect the live Neo4j schema to determine available labels, relationship types,\n74\t    and the distribution of entity types within a workspace.\n75\t    Used by SchemaAdapter to generate correct Cypher queries.\n76\t    \"\"\"\n77\t    with read_session() as session:\n78\t        # 1. All labels in the database\n79\t        labels_result = session.run(\"CALL db.labels() YIELD label RETURN collect(label) as labels\")\n80\t        labels = labels_result.single()[\"labels\"]\n81\t\n82\t        # 2. All relationship types\n83\t        rel_result = session.run(\n84\t            \"CALL db.relationshipTypes() YIELD relationshipType RETURN collect(relationshipType) as types\"\n85\t        )\n86\t        rel_types = rel_result.single()[\"types\"]\n87\t\n88\t        # 3. Entity type distribution within this workspace\n89\t        dist_result = session.run(\n90\t            \"\"\"\n91\t            MATCH (n {workspace: $workspace})\n92\t            WITH labels(n) as label_set, n.type as type_prop\n93\t            RETURN label_set, type_prop, count(*) as cnt\n94\t            ORDER BY cnt DESC\n95\t        \"\"\",\n96\t            workspace=workspace,\n97\t        )\n98\t\n99\t        distribution = {}\n100\t        for record in dist_result:\n101\t            key = f\"{record['label_set']}:{record['type_prop']}\"\n102\t            distribution[key] = record[\"cnt\"]\n103\t\n104\t        return {\n105\t            \"labels\": labels,\n106\t            \"relationship_types\": rel_types,\n107\t            \"entity_type_distribution\": distribution,\n108\t            \"workspace\": workspace,\n109\t        }\n110\t\n111\t\n112\tdef verify_connectivity() -> dict:\n113\t    \"\"\"Verify Neo4j is reachable and return server info.\"\"\"\n114\t    from neo4j.exceptions import ServiceUnavailable, AuthError\n115\t\n116\t    try:\n117\t        driver = get_driver()\n118\t        driver.verify_connectivity()\n119\t        with read_session() as session:\n120\t            result = session.run(\"RETURN 1 AS ping\")\n121\t            record = result.single()\n122\t            return {\"status\": \"connected\", \"ping\": record[\"ping\"], \"uri\": NEO4J_URI}\n123\t    except ServiceUnavailable:\n124\t        return {\n125\t            \"status\": \"unavailable\",\n126\t            \"error\": \"Could not connect to Neo4j. Is the server running on \" + NEO4J_URI + \"?\",\n127\t            \"uri\": NEO4J_URI,\n128\t        }\n129\t    except AuthError:\n130\t        return {\n131\t            \"status\": \"auth_error\",\n132\t            \"error\": \"Neo4j authentication failed. Check your username and password.\",\n133\t            \"uri\": NEO4J_URI,\n134\t        }\n135\t    except Exception as e:\n136\t        return {\"status\": \"error\", \"error\": str(e), \"uri\": NEO4J_URI}\n137\t\n138\t\n139\t# =============================================================================\n140\t# SCHEMA INITIALISATION\n141\t# =============================================================================\n142\t\n143\t# Track detected embedding dimensions for auto-detection\n144\t_detected_embedding_dims: Optional[int] = None\n145\t\n146\t\n147\tdef init_schema():\n148\t    \"\"\"\n149\t    Create constraints and indexes for the knowledge graph.\n150\t\n151\t    Node labels:\n152\t        - Concept: core idea/entity extracted from documents\n153\t        - Source: the originating document\n154\t\n155\t    Relationship types:\n156\t        - RELATES_TO: explicit relationship with a pre