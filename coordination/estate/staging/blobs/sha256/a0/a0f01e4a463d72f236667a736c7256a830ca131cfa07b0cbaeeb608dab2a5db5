f not path.exists():\n274\t        try:\n275\t            path.write_text(content.strip(), encoding=\"utf-8\")\n276\t        except Exception as e:\n277\t            # We don't want task saving to crash the main process\n278\t            import logging\n279\t            logging.error(f\"TaskManager persistence failed for {path}: {e}\")\n280\t\n281\t\n282\t_DEFAULT_SOURCE_MANIFESTS = {\n283\t    \"tmdb.yaml\": \"\"\"\\\n284\tsource_id: tmdb\n285\tname: \"The Movie Database\"\n286\tversion: \"3\"\n287\tbase_url: \"https://api.themoviedb.org/3\"\n288\tentity_types: [movie, tv_show, person]\n289\tauth:\n290\t  type: api_key\n291\t  env_var: TMDB_API_KEY\n292\trate_limit:\n293\t  requests_per_second: 40\n294\tconfidence_default: 0.95\n295\tenabled: true\n296\texamples:\n297\t  - entity_name: \"Inception\"\n298\t    entity_type: movie\n299\t    expected_triples:\n300\t      - [Inception, directed_by, \"Christopher Nolan\"]\n301\t      - [Inception, released_on, \"2010-07-16\"]\n302\t      - [Inception, has_genre, \"Science Fiction\"]\n303\t      - [Inception, has_runtime_minutes, \"148\"]\n304\t  - entity_name: \"Breaking Bad\"\n305\t    entity_type: tv_show\n306\t    expected_triples:\n307\t      - [Breaking Bad, created_by, \"Vince Gilligan\"]\n308\t      - [Breaking Bad, first_aired_on, \"2008-01-20\"]\n309\t      - [Breaking Bad, has_genre, Drama]\n310\t\"\"\",\n311\t    \"spotify.yaml\": \"\"\"\\\n312\tsource_id: spotify\n313\tname: \"Spotify Web API\"\n314\tversion: \"v1\"\n315\tbase_url: \"https://api.spotify.com/v1\"\n316\tentity_types: [track, artist, album]\n317\tauth:\n318\t  type: oauth2_client_credentials\n319\t  env_var_client_id: SPOTIFY_CLIENT_ID\n320\t  env_var_client_secret: SPOTIFY_CLIENT_SECRET\n321\t  token_url: \"https://accounts.spotify.com/api/token\"\n322\trate_limit:\n323\t  requests_per_second: 10\n324\tconfidence_default: 0.92\n325\tenabled: true\n326\texamples:\n327\t  - entity_name: \"Bohemian Rhapsody\"\n328\t    entity_type: track\n329\t   