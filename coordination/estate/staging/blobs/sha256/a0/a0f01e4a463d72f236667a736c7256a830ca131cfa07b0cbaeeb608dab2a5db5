{"parentUuid":"c34bdffa-0ecd-4347-a826-18d4cc73d05b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\api\\etl_routes.py","snippet":"1\t\"\"\"\n2\tETL Routes - Staging and Conversion Pipeline\n3\t\"\"\"\n4\t\n5\timport shutil\n6\t\n7\tfrom fastapi import APIRouter, File, HTTPException, UploadFile\n8\t\n9\tfrom ..core.extraction import extract_structured_text\n10\tfrom ..core.workspace import get_workspace_path\n11\tfrom ..governance.lineage import track_file_conversion\n12\t\n13\trouter = APIRouter()\n14\t\n15\t# Raw types we know how to convert into markdown for data_in.\n16\tSUPPORTED_RAW = {\".txt\", \".md\", \".pdf\", \".docx\", \".pptx\", \".html\"}\n17\t\n18\t\n19\tdef promote_staged_files(workspace: str = \"default\") -> list[str]:\n20\t    \"\"\"Convert any raw files sitting in ``staging/`` into markdown in ``data_in/``.\n21\t\n22\t    Idempotent: a staged file is skipped when its converted ``.md`` already\n23\t    exists in ``data_in`` and is at least as new as the source. Returns the\n24\t    list of filenames converted on this call.\n25\t\n26\t    This is the shared promotion step so that callers (e.g. ``/rag/ingest``)\n27\t    can guarantee ``data_in`` reflects everything the user has staged, instead\n28\t    of racing a separate conversion pass. Failures on a single file are logged\n29\t    and skipped — one bad upload must not block the rest of the batch.\n30\t    \"\"\"\n31\t    staging_dir = get_workspace_path(workspace, \"staging\")\n32\t    if not staging_dir.exists():\n33\t        return []\n34\t\n35\t    data_in_dir = get_workspace_path(workspace, \"data_in\")\n36\t    data_in_dir.mkdir(parents=True, exist_ok=True)\n37\t\n38\t    converted: list[str] = []\n39\t    for staged_path in staging_dir.glob(\"*.*\"):\n40\t        if not staged_path.is_file():\n41\t            continue\n42\t        if staged_path.suffix.lower() not in SUPPORTED_RAW:\n43\t            continue\n44\t\n45\t        md_out_path = data_in_dir / f\"{staged_path.stem}.md\"\n46\t        if md_out_path.exists() and md_out_path.stat().st_mtime >= staged_path.stat().st_mtime:\n47\t            continue  # already converted and up to date\n48\t\n49\t        try:\n50\t            text = extract_structured_text(staged_path)\n51\t            with open(md_out_path, \"w\", encoding=\"utf-8\") as f:\n52\t                f.write(text)\n53\t            try:\n54\t                track_file_conversion(\n55\t                    input_path=f\"staging/{staged_path.name}\",\n56\t                    output_path=f\"data_in/{md_out_path.name}\",\n57\t                    workspace=workspace,\n58\t                )\n59\t            except Exception as lineage_err:\n60\t                print(f\"Warning: Failed to emit lineage for conversion: {lineage_err}\")\n61\t            converted.append(staged_path.name)\n62\t        except Exception as e:\n63\t            print(f\"Warning: Failed to convert staged file {staged_path.name}: {e}\")\n64\t\n65\t    return converted\n66\t\n67\t\n68\t@router.post(\"/stage-and-convert\")\n69\tasync def stage_and_convert_file(file: UploadFile = File(...), workspace: str = \"default\"):\n70\t    \"\"\"Explicit ETL Pipeline Step: Upload a RAW file to staging, convert to markdown, output to data_in\"\"\"\n71\t    try:\n72\t        staging_dir = get_workspace_path(workspace, \"staging\")\n73\t        staging_dir.mkdir(parents=True, exist_ok=True)\n74\t\n75\t        staged_path = staging_dir / file.filename\n76\t\n77\t        with open(staged_path, \"wb\") as buffer:\n78\t            shutil.copyfileobj(file.file, buffer)\n79\t\n80\t        # Parse it safely into UTF-8 text using Docling\n81\t        text = extract_structured_text(staged_path)\n82\t\n83\t        markdown_filename = f\"{staged_path.stem}.md\"\n84\t        data_in_dir = get_workspace_path(workspace, \"data_in\")\n85\t        data_in_dir.mkdir(parents=True, exist_ok=True)\n86\t        md_out_path = data_in_dir / markdown_filename\n87\t\n88\t        with open(md_out_path, \"w\", encoding=\"utf-8\") as f:\n89\t            f.write(text)\n90\t\n91\t        # Emit dataset transformation event to Marquez OpenLineage\n92\t        try:\n93\t            track_file_conversion(\n94\t                input_path=f\"staging/{file.filename}\",\n95\t                output_path=f\"data_in/{markdown_filename}\",\n96\t                workspace=workspace,\n97\t            )\n98\t        except Exception as lineage_err:\n99\t            print(f\"Warning: Failed to emit lineage for conversion: {lineage_err}\")\n100\t\n101\t        return {\n102\t            \"status\": \"converted\",\n103\t            \"original_filename\": file.filename,\n104\t            \"markdown_filename\": markdown_filename,\n105\t            \"path\": str(md_out_path),\n106\t            \"size\": md_out_path.stat().st_size,\n107\t        }\n108\t\n109\t    except Exception as e:\n110\t        raise HTTPException(500, f\"Stage and convert failed: {str(e)}\")"},"type":"attachment","uuid":"9bc57d14-b3c0-4f99-9b27-3bcb8dcb1411","timestamp":"2026-06-28T08:34:32.958Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"b5bb1984-4ef6-4dd6-8984-6e589fd772ec","version":"2.1.187","gitBranch":"HEAD"}
