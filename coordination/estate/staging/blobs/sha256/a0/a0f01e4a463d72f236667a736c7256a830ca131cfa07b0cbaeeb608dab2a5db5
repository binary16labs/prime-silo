{"parentUuid":"2f991fd2-fcbd-4052-82e4-243690a8e302","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\tests\\graph\\kg3d\\test_metrics.py","snippet":"1\t\n2\timport pytest\n3\t\n4\tfrom benny.graph.kg3d.cache import get_cached_metrics, init_cache, save_metrics_to_cache\n5\tfrom benny.graph.kg3d.metrics import compute_all, update_node_aot_layers\n6\tfrom benny.graph.kg3d.ontology import load_default_ontology\n7\t\n8\t\n9\t@pytest.mark.asyncio\n10\tasync def test_kg3d_f2_metrics_contract():\n11\t    graph = await load_default_ontology()\n12\t    metrics = compute_all(graph)\n13\t\n14\t    assert len(metrics) == len(graph.nodes)\n15\t    for node_id, m in metrics.items():\n16\t        assert m.pagerank >= 0\n17\t        assert m.degree >= 0\n18\t        assert m.betweenness >= 0\n19\t        assert 0 <= m.descendant_ratio <= 1\n20\t\n21\t\n22\t@pytest.mark.asyncio\n23\tasync def test_metrics_cache_invalidation():\n24\t    init_cache()\n25\t    graph = await load_default_ontology()\n26\t    metrics = compute_all(graph)\n27\t\n28\t    save_metrics_to_cache(graph, metrics)\n29\t    # The content hash must be stable across reads so the cache actually hits —\n30\t    # otherwise compute_all re-runs on every request (the /kg3d/ontology 500).\n31\t    cached = get_cached_metrics(graph)\n32\t    assert cached is not None\n33\t    assert len(cached) == len(metrics)\n34\t\n35\t    # Modify graph content (mock change) — the hash must change so stale metrics\n36\t    # are not served.\n37\t    graph.nodes[0].canonical_name = \"Modified Name\"\n38\t    cached_missing = get_cached_metrics(graph)\n39\t    assert cached_missing is None\n40\t\n41\t\n42\tdef test_large_graph_metrics_are_bounded():\n43\t    \"\"\"\n44\t    Regression for the /kg3d/ontology 500: on a graph well above the exact\n45\t    betweenness threshold, compute_all must use the sampled approximation and\n46\t    finish quickly instead of running an O(V*E) sweep that blows the HTTP\n47\t    timeout. Builds a synthetic graph in-process (no Neo4j).\n48\t    \"\"\"\n49\t    import time\n50\t    import uuid\n51\t\n52\t    from benny.graph.kg3d.metrics import BETWEENNESS_EXACT_MAX_NODES, compute_all\n53\t    from benny.graph.kg3d.ontology import Graph\n54\t    from benny.graph.kg3d.schema import Edge, EdgeKind, Node, NodeCategory, NodeMetrics\n55\t\n56\t    n = BETWEENNESS_EXACT_MAX_NODES + 1500  # safely into the sampled regime\n57\t    zero = NodeMetrics(\n58\t        pagerank=0,\n59\t        degree=0,\n60\t        betweenness=0,\n61\t        descendant_ratio=0,\n62\t        prerequisite_ratio=0,\n63\t        reachability_ratio=0,\n64\t    )\n65\t    nodes = [\n66\t        Node(\n67\t            id=str(i),\n68\t            canonical_name=f\"n{i}\",\n69\t            display_name=f\"n{i}\",\n70\t            category=NodeCategory.CONCEPT,\n71\t            aot_layer=3,\n72\t            metrics=zero,\n73\t        )\n74\t        for i in range(n)\n75\t    ]\n76\t    # A connected-ish chain plus some fan-out so betweenness is non-trivial.\n77\t    edges = []\n78\t    for i in range(n - 1):\n79\t        edges.append(\n80\t            Edge(\n81\t                id=str(uuid.uuid4())[:8],\n82\t                source_id=str(i),\n83\t                target_id=str(i + 1),\n84\t                kind=EdgeKind.REFERENCES,\n85\t                weight=1.0,\n86\t            )\n87\t        )\n88\t\n89\t    start = time.time()\n90\t    metrics = compute_all(Graph(nodes=nodes, edges=edges))\n91\t    elapsed = time.time() - start\n92\t\n93\t    assert len(metrics) == n\n94\t    # Generous bound: exact weighted betweenness on this size takes tens of\n95\t    # seconds; the sampled path is a few seconds even on slow CI.\n96\t    assert elapsed < 15, f\"compute_all too slow for a large graph: {elapsed:.1f}s\"\n97\t    for m in metrics.values():\n98\t        assert m.betweenness >= 0\n99\t        assert 0 <= m.descendant_ratio <= 1\n100\t\n101\t\n102\t@pytest.mark.asyncio\n103\tasync def test_aot_layer_update():\n104\t    graph = await load_default_ontology()\n105\t    metrics = compute_all(graph)\n106\t    update_node_aot_layers(graph, metrics)\n107\t\n108\t    from collections import Counter\n109\t\n110\t    from benny.graph.kg3d.schema import aot_layer_for\n111\t\n112\t    for node in graph.nodes:\n113\t        assert 1 <= node.aot_layer <= 5\n114\t\n115\t    # When the descendant-ratio bins are NOT degenerate, layers follow the spec.\n116\t    # (The fixture is a real hierarchy, so this branch is exercised.)\n117\t    spec = Counter(aot_layer_for(n.metrics.descendant_ratio) for n in graph.nodes)\n118\t    if graph.nodes and spec.most_common(1)[0][1] < 0.9 * len(graph.nodes):\n119\t        for node in graph.nodes:\n120\t            assert node.aot_layer == aot_layer_for(node.metrics.descendant_ratio)\n121\t\n122\t\n123\t@pytest.mark.asyncio\n124\tasync def test_aot_layer_degenerate_fallback_spreads():\n125\t    \"\"\"A flat/shallow graph (like extracted knowledge triples) collapses every\n126\t    node onto layer 5 under descendant_ratio; the fallback must spread nodes\n127\t    across layers by centrality instead of leaving them stacked on one level.\"\"\"\n128\t    import uuid\n129\t\n130\t    from benny.graph.kg3d.ontology import Graph\n131\t    from benny.graph.kg3d.schema import Edge, EdgeKind, Node, NodeCategory, NodeMetrics\n132\t\n133\t    zero = NodeMetrics(\n134\t        pagerank=0.0,\n135\t        degree=0,\n136\t        betweenness=0.0,\n137\t        descendant_ratio=0.0,\n138\t        prerequisite_ratio=0.0,\n139\t        reachability_ratio=0.0,\n140\t    )\n141\t    n = 30\n142\t    nodes = [\n143\t        Node(\n144\t            id=str(i),\n145\t            canonical_name=f\"n{i}\",\n146\t            display_name=f\"n{i}\",\n147\t            category=NodeCategory.CONCEPT,\n148\t            aot_layer=3,\n149\t            metrics=zero,\n150\t        )\n151\t        for i in range(n)\n152\t    ]\n153\t    # Hub-and-spoke: everything points to node 0 (a sink). Out-reachability is\n154\t    # ~1/n for the spokes and 0 for the hub → all bin to layer 5 (degenerate).\n155\t    edges = [\n156\t        Edge(\n157\t            id=str(uuid.uuid4())[:8],\n158\t            source_id=str(i),\n159\t            target_id=\"0\",\n160\t            kind=EdgeKind.REFERENCES,\n161\t            weight=1.0,\n162\t        )\n163\t        for i in range(1, n)\n164\t    ]\n165\t    graph = Graph(nodes=nodes, edges=edges)\n166\t    metrics = compute_all(graph)\n167\t    update_node_aot_layers(graph, metrics)\n168\t\n169\t    layers = {node.aot_layer for node in graph.nodes}\n170\t    assert all(1 <= node.aot_layer <= 5 for node in graph.nodes)\n171\t    assert len(layers) > 1, \"degenerate flat graph should spread across multiple layers\""},"type":"attachment","uuid":"1d465258-f5f3-4aa2-9aa1-3f3846fd1c34","timestamp":"2026-06-28T10:38:06.862Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"b5bb1984-4ef6-4dd6-8984-6e589fd772ec","version":"2.1.187","gitBranch":"HEAD"}
