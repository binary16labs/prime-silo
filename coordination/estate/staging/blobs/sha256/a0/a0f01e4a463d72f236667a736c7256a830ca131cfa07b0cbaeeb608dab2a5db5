{"parentUuid":"e8b30798-9e21-4492-9a9c-1961bdd25c1e","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\api\\rag_routes.py","snippet":"1\t\"\"\"\n2\tRAG Routes - Document ingestion and semantic search\n3\t\"\"\"\n4\t\n5\timport json\n6\timport logging\n7\timport uuid\n8\tfrom datetime import datetime\n9\tfrom pathlib import Path\n10\tfrom typing import List, Optional\n11\t\n12\timport httpx\n13\tfrom fastapi import APIRouter, HTTPException\n14\tfrom fastapi.responses import StreamingResponse\n15\tfrom pydantic import BaseModel\n16\t\n17\tfrom ..core.event_bus import event_bus\n18\tfrom ..core.extraction import extract_structured_text\n19\tfrom ..core.models import LOCAL_PROVIDERS, get_active_model\n20\tfrom ..core.task_manager import task_manager\n21\tfrom ..core.workspace import get_workspace_path\n22\tfrom ..governance.lineage import (\n23\t    track_aer,\n24\t    track_llm_call,\n25\t    track_workflow_complete,\n26\t    track_workflow_fail,\n27\t    track_workflow_start,\n28\t)\n29\tfrom ..governance.permission_manifest import create_ephemeral_manifest, register_manifest\n30\tfrom ..tools.knowledge import (\n31\t    get_chromadb_client,\n32\t    get_knowledge_collection,\n33\t    heal_collection_dimension,\n34\t)\n35\t\n36\tlogger = logging.getLogger(__name__)\n37\t\n38\trouter = APIRouter()\n39\t\n40\t\n41\tclass IngestRequest(BaseModel):\n42\t    workspace: str = \"default\"\n43\t    files: Optional[List[str]] = None\n44\t    notebook_id: Optional[str] = None\n45\t    batch_size: Optional[int] = 500\n46\t    run_id: Optional[str] = None  # Optional existing run/nexus ID\n47\t    deep_synthesis: bool = False  # Whether to extract triples and run clustering\n48\t    strategy: str = \"safe\"  # Heuristic layer: 'safe' or 'aggressive'\n49\t    correlation_threshold: float = (\n50\t        0.82  # Similarity threshold for aggressive mode (raised from 0.70 — the 0.70 knee produced