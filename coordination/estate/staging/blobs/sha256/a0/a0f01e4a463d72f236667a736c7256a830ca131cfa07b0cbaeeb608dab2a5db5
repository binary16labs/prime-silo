{"parentUuid":"64dc0f0c-68da-4c9a-9037-9c389b8f4136","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\graph\\kg3d\\metrics.py","snippet":"1\timport logging\n2\timport networkx as nx\n3\tfrom typing import Dict\n4\tfrom .schema import Node, Edge, NodeMetrics, aot_layer_for\n5\tfrom .ontology import Graph\n6\t\n7\tlogger = logging.getLogger(__name__)\n8\t\n9\t# Exact all-pairs betweenness is O(V*E) and on a multi-thousand-node graph takes\n10\t# tens of seconds — long enough to blow the HTTP timeout and surface as a 500.\n11\t# Above this node count we switch to a sampled approximation (Brandes over k\n12\t# pivots), which is ~15-20x faster and visually indistinguishable for layout.\n13\tBETWEENNESS_EXACT_MAX_NODES = 800\n14\tBETWEENNESS_SAMPLE_K = 400\n15\t\n16\t\n17\tdef _safe_pagerank(G: nx.DiGraph) -> Dict[str, float]:\n18\t    \"\"\"PageRank that degrades to zeros instead of raising (e.g. non-convergence).\"\"\"\n19\t    if len(G) == 0:\n20\t        return {}\n21\t    try:\n22\t        return nx.pagerank(G, weight=\"weight\")\n23\t    except nx.PowerIterationFailedConvergence:\n24\t        try:\n25\t            return nx.pagerank(G, weight=\"weight\", max_iter=500, tol=1e-4)\n26\t        except Exception as e:  # noqa: BLE001 - last-resort guard\n27\t            logger.warning(\"pagerank did not converge; defaulting to 0: %s\", e)\n28\t            return {}\n29\t    except Exception as e:  # noqa: BLE001 - last-resort guard\n30\t        logger.warning(\"pagerank failed; defaulting to 0: %s\", e)\n31\t        return {}\n32\t\n33\t\n34\tdef _safe_betweenness(G: nx.DiGraph) -> Dict[str, float]:\n35\t    \"\"\"Betweenness centrality, bounded so large graphs stay interactive.\"\"\"\n36\t    n = len(G)\n37\t    if n == 0:\n38\t        return {}\n39\t    try:\n40\t        if n <= BETWEENNESS_EXACT_MAX_NODES:\n41\t            return nx.betweenness_centrality(G, weight=\"weight\")\n42\t        k = min(BETWEENNESS_SAMPLE_K, n)\n43\t        logger.info(\"Graph has %d nodes; using sampled betweenness (k=%d)\", n, k)\n44\t        # Unweighted + sampled: the dominant cost is the all-pairs shortest-path\n45\t        # sweep, so we cap it at k pivot nodes with a fixed seed for determinism.\n46\t        return nx.betweenness_centrality(G, k=k, seed=42)\n47\t    except Exception as e:  # noqa: BLE001 - last-resort guard\n48\t        logger.warning(\"betweenness failed; defaulting to 0: %s\", e)\n49\t        return {}\n50\t\n51\t\n52\tdef compute_all(graph: Graph) -> Dict[str, NodeMetrics]:\n53\t    \"\"\"\n54\t    Computes all GC-centric graph metrics for the KG3D-001 requirement.\n55\t    Uses networkx for core algorithms. Every metric is guarded so a single\n56\t    failure degrades to zeros rather than 500-ing the ontology endpoint.\n57\t    \"\"\"\n58\t    G = nx.DiGraph()\n59\t    for node in graph.nodes:\n60\t        G.add_node(node.id)\n61\t    for edge in graph.edges:\n62\t        G.add_edge(edge.source_id, edge.target_id, weight=edge.weight, kind=edge.kind)\n63\t\n64\t    # 1. Pagerank\n65\t    pagerank = _safe_pagerank(G)\n66\t\n67\t    # 2. Degree\n68\t    degree = dict(G.degree())\n69\t\n70\t    # 3. Betweenness (bounded for large graphs)\n71\t    betweenness = _safe_betweenness(G)\n72\t\n73\t    # 4. Descendant ratio (reachable nodes / total nodes)\n74\t    total_nodes = len(graph.nodes)\n75\t    descendant_ratio = {}\n76\t\n77\t    # 5. Prerequisite ratio (incoming edges / total edges)\n78\t    total_edges = len(graph.edges)\n79\t    prerequisite_ratio = {}\n80\t\n81\t    # 6. Reachability ratio (nodes reachable from this node / total nodes)\n82\t    # (Descendant ratio and reachability ratio are effectively the same in this schema)\n83\t\n84\t    for node_id in G.nodes:\n85\t        # Reachable nodes (descendants)\n86\t        reachable = nx.descendants(G, node_id)\n87\t        dr = len(reachable) / total_nodes if total_nodes > 1 else 0.0\n88\t        descendant_ratio[node_id] = dr\n89\t\n90\t        # Prerequisites (incoming nodes)\n91\t        prereqs = list(G.predecessors(node_id))\n92\t        pr_ratio = len(prereqs) / total_edges if total_edges > 0 else 0.0\n93\t        prerequisite_ratio[node_id] = pr_ratio\n94\t\n95\t    metrics_map = {}\n96\t    for node in graph.nodes:\n97\t        node_id = node.id\n98\t        # Clamp to the schema's bounds (pagerank/betweenness >= 0; ratios in\n99\t        # [0, 1]) so a pathological value can never trip a NodeMetrics validator\n100\t        # and 500 the whole ontology response.\n101\t        dr = min(1.0, max(0.0, descendant_ratio.get(node_id, 0.0)))\n102\t        pr = min(1.0, max(0.0, prerequisite_ratio.get(node_id, 0.0)))\n103\t        metrics_map[node_id] = NodeMetrics(\n104\t            pagerank=max(0.0, pagerank.get(node_id, 0.0)),\n105\t            degree=degree.get(node_id, 0),\n106\t            betweenness=max(0.0, betweenness.get(node_id, 0.0)),\n107\t            descendant_ratio=dr,\n108\t            prerequisite_ratio=pr,\n109\t            reachability_ratio=dr,  # Mapping both to dr for simplicity\n110\t        )\n111\t\n112\t    return metrics_map\n113\t\n114\t\n115\tdef update_node_aot_layers(graph: Graph, metrics: Dict[str, NodeMetrics]):\n116\t    \"\"\"Assign each node's ``aot_layer``.\n117\t\n118\t    Primary model (KG3D-F13): bin by ``descendant_ratio`` (out-reachability),\n119\t    which works when the graph is a real abstraction DAG. But extracted\n120\t    knowledge graphs are frequently *shallow/flat* — concepts link to a source\n121\t    sink and to a few peers, so almost no node reaches >10% of the graph and\n122\t    every node collapses onto layer 5 (a flat, detached-looking hierarchy).\n123\t\n124\t    When the descendant bins are degenerate (≥90% of nodes on one layer) we fall\n125\t    back to a centrality-quantile layering (PageRank, then degree as a tiebreak)\n126\t    so the hierarchy still spreads across all 5 layers —