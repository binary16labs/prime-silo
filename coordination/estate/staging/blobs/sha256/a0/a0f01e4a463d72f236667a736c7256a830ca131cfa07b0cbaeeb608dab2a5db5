3\t    base,\n34\t    archive: `${base}.tar.gz`,\n35\t    sha256: `${base}.tar.gz.sha256`,\n36\t    manifest: `${base}.json`\n37\t  };\n38\t}\n39\t\n40\t// https://github.com/<owner>/<repo>/releases/download/v<version>/<asset>\n41\tfunction resolveAssetUrl({ owner = DEFAULT_OWNER, repo = DEFAULT_REPO, version, asset }) {\n42\t  const tag = String(version || \"\").startsWith(\"v\") ? String(version) : `v${version}`;\n43\t  return `https://github.com/${owner}/${repo}/releases/download/${tag}/${asset}`;\n44\t}\n45\t\n46\tfunction markerPath(destDir) {\n47\t  return path.join(destDir, MARKER_FILE);\n48\t}\n49\t\n50\tfunction readMarker(destDir) {\n51\t  try {\n52\t    return JSON.parse(fs.readFileSync(markerPath(destDir), \"utf8\"));\n53\t  } catch {\n54\t    return null;\n55\t  }\n56\t}\n57\t\n58\tfunction writeMarker(destDir, data) {\n59\t  fs.mkdirSync(destDir, { recursive: true });\n60\t  fs.writeFileSync(\n61\t    markerPath(destDir),\n62\t    JSON.stringify({ ...data, installed_at: new Date().toISOString() }, null, 2)\n63\t  );\n64\t}\n65\t\n66\t// A correctly-installed bundle for `version` is present iff the marker matches\n67\t// the wanted version AND the runtime entry points still exist on disk.\n68\tfunction isBundleInstalled(\n69\t  destDir,\n70\t  version,\n71\t  existsFn = fs.existsSync,\n72\t  platform = process.platform\n73\t) {\n74\t  const marker = readMarker(destDir);\n75\t  if (!marker || String(marker.app_version) !== String(version)) {\n76\t    return false;\n77\t  }\n78\t  const py = platform === \"win32\" ? \"python/python.exe\" : \"python/bin/python3\";\n79\t  return [py, \"benny\", \"neo4j\", \"jre\"].every((rel) => existsFn(path.join(destDir, rel)));\n80\t}\n81\t\n82\t/* ── default I/O collaborators (overridable for tests) ───────────────── */\n83\t\n84\tasync function defaultDownload(url, destPath) {\n85\t  const response = await fetch(url, { redirect: \"follow\" });\n86\t  if (!response.ok || !response.body) {\n87\t    throw new Error(`Download failed ${url} (${response.status})`);\n88\t  }\n89\t  fs.mkdirSync(path.dirname(destPath), { recursive: true });\n90\t  const hash = createHash(\"sha256\");\n91\t  const tmp = `${destPath}.part`;\n92\t  await pipeline(\n93\t    Readable.fromWeb(response.body),\n94\t    async function* (source) {\n95\t      for await (const chunk of source) {\n96\t        hash.update(chunk);\n97\t        yield chunk;\n98\t      }\n99\t    },\n100\t    fs.createWriteStream(tmp)\n101\t  );\n102\t  fs.renameSync(tmp, destPath);\n103\t  return hash.digest(\"hex\");\n104\t}\n105\t\n106\tasync function defaultFetchText(url) {\n107\t  const response = await fetch(url, { redirect: \"follow\" });\n108\t  if (!response.ok) {\n109\t    throw new Error(`Fetch failed ${url} (${response.status})`);\n110\t  }\n111\t  return response.text();\n112\t}\n113\t\n114\tfunction defaultExtract(archivePath, destDir) {\n115\t  fs.mkdirSync(destDir, { recursive: true });\n116\t  // tar handles .tar.gz on Windows 10+, macOS and Linux.\n117\t  execFileSync(\"tar\", [\"-xzf\", archivePath, \"-C\", destDir], { stdio: \"ignore\" });\n118\t}\n119\t\n120\t// \"<sha256>  <filename>\" → \"<sha256>\"\n121\tfunction parseSha256Sidecar(text) {\n122\t  const token = String(text || \"\")\n123\t    .trim()\n124\t    .split(/\\s+/)[0];\n125\t  return /^[0-9a-f]{64}$/i.test(token) ? token.toLowerCase() : \"\";\n126\t}\n127\t\n128\t/* ── main ────────────────────────────────────────────────────────────── */\n129\t\n130\t/**\n131\t * Ensure the runtime bundle for `version` is installed under `destDir`,\n132\t * downloading + extracting the matching release asset on first run.\n133\t *\n134\t * Returns { ok, reason, destDir }. Never throws: a network/extract failure\n135\t * resolves to ok:false so the supervisor can degrade gracefully (the app still\n136\t * runs in proxy/remote mode) and retry on the next launch.\n137\t *\n138\t * Injectables (all optional): downloadFn, fetchTextFn, extractFn, existsFn,\n139\t * logger, owner, repo, expectedSha256, cacheDir.\n140\t */\n141\tasync function ensureRuntimeBundle(opts = {}) {\n142\t  const {\n143\t    destDir,\n144\t    version,\n145\t    platform = process.platform,\n146\t    arch = process.arch,\n147\t    owner = DEFAULT_OWNER,\n148\t    repo = DEFAULT_REPO,\n149\t    downloadFn = defaultDownload,\n150\t    fetchTextFn = defaultFetchText,\n151\t    extractFn = defaultExtract,\n152\t    existsFn = fs.existsSync,\n153\t    logger = console,\n154\t    cacheDir = path.join(os.tmpdir(), \"ps-runtime-fetch\")\n155\t  } = opts;\n156\t\n157\t  if (!destDir || !version) {\n158\t    return { ok: false, reason: \"bad-args\", destDir };\n159\t  }\n160\t\n161\t  if (isBundleInstalled(destDir, version, existsFn, platform)) {\n162\t    return { ok: true, reason: \"already-present\", destDir };\n163\t  }\n164\t\n165\t  const names = runtimeBundleAssetNames(platform, arch);\n166\t\n167\t  // Resolve the expected checksum: caller override, else the .sha256 sidecar.\n168\t  let expectedSha = String(opts.expectedSha256 || \"\").toLowerCase();\n169\t  if (!expectedSha) {\n170\t    try {\n171\t      expectedSha = parseSha256Sidecar(\n172\t        await fetchTextFn(resolveAssetUrl({ owner, repo, version, asset: names.sha256 }))\n173\t      );\n174\t    } catch (error) {\n175\t      logger.warn &&\n176\t        logger.warn(`[runtime-fetch] checksum sidecar unavailable: ${error.message || error}`);\n177\t    }\n178\t  }\n179\t\n180\t  const archiveUrl = resolveAssetUrl({ owner, repo, version, asset: names.archive });\n181\t  fs.mkdirSync(cacheDir, { recursive: true });\n182\t  const archivePath = path.join(cacheDir, names.archive);\n183\t\n184\t  let gotSha;\n185\t  try {\n186\t    logger.log && logger.log(`[runtime-fetch] downloading ${names.archive} …`);\n187\t    gotSha = await downloadFn(archiveUrl, archivePath);\n188\t  } catch (error) {\n189\t    logger.error && logger.error(`[runtime-fetch] download failed: ${error.message || error}`);\n190\t    return { 