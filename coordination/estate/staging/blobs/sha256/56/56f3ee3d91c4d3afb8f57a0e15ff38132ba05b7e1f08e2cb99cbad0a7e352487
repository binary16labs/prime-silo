{"parentUuid":"d5c8eb75-2c7c-411b-b51a-289da2f5b914","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\.worktrees\\Q0\\runtime\\benny\\api\\agent_scope.py","snippet":"1\t\"\"\"ADR-001 — Agent scope guard.\n2\t\n3\tThe Prime-Silo shell fork (ADR-001) introduces a determinism boundary: the\n4\tin-browser agent runtime has *full read* access across Benny's API surface but\n5\tits *writes* are restricted to the workspace's ``agent_sandbox/`` subtree.\n6\t\n7\tCallers identify themselves via the ``X-Benny-Agent-Scope`` header:\n8\t\n9\t============   =================  ============================================\n10\tHeader value   Reads              Writes\n11\t============   =================  ============================================\n12\tabsent         per existing RBAC  per existing RBAC (human user)\n13\t``read_only``  full               rejected (HTTP 403)\n14\t``sandbox``    full               only to the dedicated sandbox route prefix\n15\t============   =================  ============================================\n16\t\n17\tThe sandbox route prefix is a deliberate single chokepoint:\n18\t``/api/agent_sandbox/...``. Routing every agent write through one prefix is\n19\tsimpler and safer than per-request path inspection across two-dozen route\n20\tmodules — there is exactly one place to audit. ``GET``/``HEAD``/``OPTIONS``\n21\tare never gated by this middleware so the agent can read freely.\n22\t\n23\tEvery accepted sandbox write is lineage-emitted as\n24\t``process=agent_authorship`` via :func:`benny.governance.lineage.emit_agent_authorship`,\n25\tmaking the agent's authoring history itself auditable.\n26\t\"\"\"\n27\t\n28\tfrom __future__ import annotations\n29\t\n30\timport hashlib\n31\timport hmac\n32\timport os\n33\tfrom pathlib import Path\n34\t\n35\tfrom fastapi import Request, Response\n36\tfrom starlette.middleware.base import BaseHTTPMiddleware\n37\t\n38\t# Reads are unrestricted — only mutating verbs are gated.\n39\t_MUTATING_METHODS = frozenset({\"POST\", \"PUT\", \"PATCH\", \"DELETE\"})\n40\t\n41\t# Single chokepoint for agent-authored writes. ``benny.api.agent_sandbox_routes``\n42\t# implements the endpoints behind this prefix.\n43\tAGENT_SANDBOX_PREFIX = \"/api/agent_sandbox\"\n44\t\n45\t# Header values recognised by the guard. Anything else is treated as \"absent\"\n46\t# (i.e. a normal authenticated human user) and falls through to the existing\n47\t# governance / RBAC checks.\n48\tSCOPE_SANDBOX = \"sandbox\"\n49\tSCOPE_READ_ONLY = \"read_only\"\n50\t\n51\t_VALID_SCOPES = frozenset({SCOPE_SANDBOX, SCOPE_READ_ONLY})\n52\t\n53\t# Restrictiveness order (most restrictive first). The effective scope of a\n54\t# request is the *most* restrictive of the credential-derived scope and the\n55\t# header-declared scope, so a caller can never widen the confinement its\n56\t# credential pins it to — only narrow it further.\n57\t_RESTRICTIVENESS = {SCOPE_READ_ONLY: 2, SCOPE_SANDBOX: 1}\n58\t\n59\t# ADR-001 confused-deputy fix: the space-agent shell injects a distinct,\n60\t# sandbox-bound API key on the /api/agent-runtime proxy path. Whenever a request\n61\t# authenticates with THAT key, its scope is pinned to ``sandbox`` here —\n62\t# server-side, independent of any X-Benny-Agent-Scope header — so the boundary\n63\t# holds even if the header is forged or stripped. The trusted/human key carries\n64\t# no key-derived scope and falls through to header behaviour (back-compat).\n65\t#\n66\t# Q0: no shipped default remains. Resolution: env BENNY_AGENT_API_KEY, else\n67\t# derive from the per-install keystore via HMAC-SHA256(installKeyBytes,\n68\t# b\"benny-agent-scope\") hex — this MUST match server/lib/runtime_proxy.js's\n69\t# resolveBennyAgentApiKey byte-for-byte (cross-language parity pinned by a test).\n70\t_AGENT_SCOPE_DERIVATION_LABEL = b\"benny-agent-scope\"\n71\t\n72\t\n73\tdef _install_key_bytes() -> bytes | None:\n74\t    \"\"\"Resolve the per-install keystore content as bytes: hex-decoded if the\n75\t    stored value is valid hex, else its raw utf-8 bytes.\"\"\"\n76\t    benny_home = os.environ.get(\"BENNY_HOME\")\n77\t    if not benny_home:\n78\t        return None\n79\t    from ..portable.home import read_install_hmac_key\n80\t\n81\t    value = read_install_hmac_key(Path(benny_home))\n82\t    if not value:\n83\t        return None\n84\t    try:\n85\t        decoded = bytes.fromhex(value)\n86\t        if decoded and decoded.hex() == value.lower():\n87\t            return decoded\n88\t    except ValueError:\n89\t        pass\n90\t    return value.encode(\"utf-8\")\n91\t\n92\t\n93\tdef resolve_benny_api_key() -> str:\n94\t    \"\"\"Single resolution path (Q0) for the trusted/human key: env BENNY_API_KEY\n95\t    -> per-install keystore ($BENNY_HOME/state/hmac-key) -> fail fast. No\n96\t    shipped default remains. Canonical for the runtime API (server.py aliases\n97\t    this); consumer scripts duplicate the same three steps per their contracts.\"\"\"\n98\t    value = os.environ.get(\"BENNY_API_KEY\")\n99\t    if value:\n100\t        return value\n101\t\n102\t    benny_home = os.environ.get(\"BENNY_HOME\")\n103\t    if benny_home:\n104\t        from ..portable.home import read_install_hmac_key\n105\t\n106\t        keystore_value = read_install_hmac_key(Path(benny_home))\n107\t        if keystore_value:\n108\t            return keystore_value\n109\t\n110\t    raise RuntimeError(\n111\t        \"BENNY_API_KEY is not set and no per-install key was found at \"\n112\t        \"<BENNY_HOME>/state/hmac-key. Set the BENNY_API_KEY environment variable, \"\n113\t        \"or run `benny init` to generate a per-install keystore.\"\n114\t    )\n115\t\n116\t\n117\tdef derive_agent_api_key_from_install_key(install_key_bytes: bytes) -> str:\n118\t    \"\"\"HMAC-SHA256(install_key_bytes, b\"benny-agent-scope\") hex. Exposed for the\n119\t    cross-language parity test against server/lib/runtime_proxy.js.\"\"\"\n120\t    return hmac.new(install_key_bytes, _AGENT_SCOPE_DERIVATION_LABEL, hashlib.sha256).hexdigest()\n121\t\n122\t\n123\tdef _agent_api_key() -> str | None:\n124\t    \"\"\"Resolve the sandbox-bound agent key: env override, else derived from the\n125\t    per-install keystore. Returns ``None`` if neither is available (no install\n126\t    key yet) — callers must treat that as \"no agent key configured\", not as a\n127\t    match against an empty string.\"\"\"\n128\t    env_value = os.environ.get(\"BENNY_AGENT_API_KEY\")\n129\t    if env_value:\n130\t        return env_value\n131\t    install_key_bytes = _install_key_bytes()\n132\t    if install_key_bytes is None:\n133\t        return None\n134\t    return derive_agent_api_key_from_install_key(install_key_bytes)\n135\t\n136\t\n137\tdef _effective_scope(request: Request) -> str:\n138\t    \"\"\"Resolve the request's effective agent scope.\n139\t\n140\t    Combines the credential-derived scope (sandbox, when the sandbox-bound agent\n141\t    key authenticated the call) with the header-declared scope, taking whichever\n142\t    is *more* restrictive. Returns ``\"\"`` for unscoped human traffic.\n143\t    \"\"\"\n144\t    candidates: list[str] = []\n145\t\n146\t    agent_key = _agent_api_key()\n147\t    if agent_key is not None and request.headers.get(\"X-Benny-API-Key\", \"\") == agent_key:\n148\t        candidates.append(SCOPE_SANDBOX)\n149\t\n150\t    header_scope = request.headers.get(\"X-Benny-Agent-Scope\", \"\").strip().lower()\n151\t    if header_scope in _VALID_SCOPES:\n152\t        candidates.append(header_scope)\n153\t\n154\t    if not candidates:\n155\t        return \"\"\n156\t\n157\t    return max(candidates, key=lambda s: _RESTRICTIVENESS[s])\n158\t\n159\t\n160\tclass AgentScopeMiddleware(BaseHTTPMiddleware):\n161\t    \"\"\"Enforce the ADR-001 read/write boundary for agent-scoped requests.\"\"\"\n162\t\n163\t    async def dispatch(self, request: Request, call_next):\n164\t        scope = _effective_scope(request)\n165\t\n166\t        # Human / unscoped traffic — defer entirely to the existing\n167\t        # GovernanceMiddleware + per-route auth.\n168\t        if scope == \"\":\n169\t            return await call_next(request)\n170\t\n171\t        # Reads are always allowed for both agent scopes.\n172\t        if request.method.upper() not in _MUTATING_METHODS:\n173\t            return await call_next(request)\n174\t\n175\t        # read_only scope — no writes anywhere.\n176\t        if scope == SCOPE_READ_ONLY:\n177\t            return _forbidden(\"Agent scope 'read_only' may not perform mutating requests.\")\n178\t\n179\t        # sandbox scope — writes only inside the agent_sandbox route prefix.\n180\t        path = request.url.path\n181\t        if path == AGENT_SANDBOX_PREFIX or path.startswith(AGENT_SANDBOX_PREFIX + \"/\"):\n182\t            return await call_next(request)\n183\t\n\n... [9 lines truncated] ..."},"type":"attachment","uuid":"2b45a2b5-3840-4262-af69-c332141f8c4f","timestamp":"2026-07-06T18:28:51.332Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\.worktrees\\Q0\\runtime","sessionId":"582c4e26-01f1-4102-97ab-e4ff48bca677","version":"2.1.197","gitBranch":"HEAD"}
