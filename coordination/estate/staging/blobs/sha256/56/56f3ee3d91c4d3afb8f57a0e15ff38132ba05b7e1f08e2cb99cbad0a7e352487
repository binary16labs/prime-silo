nstall signing key: {exc}\")\n125\t\n126\t    if _sys.platform == \"win32\" and loop_type == \"SelectorEventLoop\":\n127\t        print(\n128\t            \"⚠ WARNING: Server is running on SelectorEventLoop on Windows. \"\n129\t            \"File descriptor errors may occur under load.\"\n130\t        )\n131\t\n132\t    yield\n133\t    # Shutdown: Clean up\n134\t    print(\"Neo4j driver closed\")\n135\t\n136\t\n137\tapp = FastAPI(\n138\t    title=\"Benny Neural Nexus API\",\n139\t    description=\"Cognitive Mesh Engine for Software Synthesis\",\n140\t    version=\"1.0.0\",\n141\t    lifespan=lifespan,\n142\t)\n143\t\n144\t\n145\t# Governance Middleware (FR-5: RBAC Enforcement)\n146\tclass GovernanceMiddleware(BaseHTTPMiddleware):\n147\t    async def dispatch(self, request: Request, call_next):\n148\t        # 1. Path Whitelist (Health, SSE, Docs)\n149\t        path = request.url.path\n150\t        if path == \"/\" or path.startswith(\"/docs\") or path.startswith(\"/openapi.json\"):\n151\t            return await call_next(request)\n152\t\n153\t        for white_path in GOVERNANCE_WHITELIST:\n154\t            if path.startswith(white_path):\n155\t                return await call_next(request)\n156\t\n157\t        # 2. Extract API Key\n158\t        api_key = request.headers.get(\"X-Benny-API-Key\")\n159\t        if not api_key:\n160\t            return Response(\n161\t                content='{\"detail\":\"Unauthorized: X-Benny-API-Key required\"}',\n162\t                status_code=401,\n163\t                media_type=\"application/json\",\n164\t            )\n165\t\n166\t        # 3. RBAC Check (PBR-001 Phase 3)\n167\t        # Simplified for now: just check if key exists. Full implementation in Phase 8.\n168\t        try:\n169\t            expected_key = _resolve_benny_api_key()\n170\t        except RuntimeError as exc:\n171\t            return Response(\n172\t                content=f'{{\"detail\":\"Server misconfigured: {exc}\"}}',\n173\t                status_code=500,\n174\t                media_type=\"application/json\",\n175\t            )\n176\t        if api_key != expected_key:\n177\t            return Response(\n178\t                content='{\"detail\":\"Forbidden: Invalid API Key\"}',\n179\t                status_code=403,\n180\t                media_type=\"application/json\",\n181\t            )\n182\t\n183\t        return await call_next(request)\n184\t\n185\t\n186\t# app.add_middleware(GovernanceMiddleware)\n187\t\n188\t# ADR-001: Agent scope guard — restricts X-Benny-Agent-Scope=sandbox writes\n189\t# to /api/agent_sandbox/. Reads are unrestricted for agent scopes; human\n190\t# (unscoped) traffic falls through to GovernanceMiddleware untouched.\n191\tapp.add_middleware(AgentScopeMiddleware)\n192\t\n193\t# Enable CORS for Benny Studio (UX-REC-001)\n194\tapp.add_middleware(\n195\t    CORSMiddleware,\n\n... [95 lines truncated] ..."},"type":"attachment","uuid":"52d12aa8-54a8-4d22-a8cf-90ee15c88db2","timestamp":"2026-07-06T18:28:51.333Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\.worktrees\\Q0\\runtime","sessionId":"582c4e26-01f1-4102-97ab-e4ff48bca677","version":"2.1.197","gitBranch":"HEAD"}
