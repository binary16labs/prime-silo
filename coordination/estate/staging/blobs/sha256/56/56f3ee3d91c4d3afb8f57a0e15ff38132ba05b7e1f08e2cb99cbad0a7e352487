{"parentUuid":"af081f61-3f37-4b8e-84da-1d8d95a67f9a","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\.worktrees\\Q0\\server\\lib\\runtime_proxy.js","snippet":"1\t// ADR-001 Phase D — Benny runtime proxy.\n2\t//\n3\t// Forwards shell requests to the Benny FastAPI runtime (default\n4\t// http://127.0.0.1:8005) over two distinct, server-authoritative facades:\n5\t//\n6\t//   • /api/runtime/<path>        — HUMAN path. Strips /api/runtime, injects the\n7\t//     trusted BENNY_API_KEY, and *strips* any client X-Benny-Agent-Scope. A\n8\t//     human-driven request runs under Benny's normal RBAC (no agent scope).\n9\t//\n10\t//   • /api/agent-runtime/<path>  — AGENT path. Strips /api/agent-runtime,\n11\t//     injects the sandbox-bound BENNY_AGENT_API_KEY, and *sets* the agent\n12\t//     scope to \"sandbox\" server-side, overwriting whatever the client sent.\n13\t//\n14\t// Why two paths (ADR-001 confused-deputy fix): the determinism boundary used to\n15\t// be a client-set X-Benny-Agent-Scope header, so any authenticated caller could\n16\t// omit it and reach Benny with full trust. Scope is now bound to a credential\n17\t// the *proxy* injects, never to a header the browser controls. Benny's\n18\t// AgentScopeMiddleware additionally pins the agent key to sandbox scope so the\n19\t// boundary holds even if this proxy is misconfigured.\n20\t//\n21\t//   RESIDUAL GAP: both paths are same-origin, so in-page JS can still choose to\n22\t//   call /api/runtime instead of /api/agent-runtime. Closing that requires the\n23\t//   browser agent runtime to execute isolated from human JS (sandboxed\n24\t//   worker/iframe) — tracked in architecture/ADR-001 follow-up. This proxy\n25\t//   makes the boundary credential-bound; isolation makes it unbypassable.\n26\t//\n27\t// Configuration (env):\n28\t//   RUNTIME_BASE_URL     Default: \"http://127.0.0.1:8005\"\n29\t//   BENNY_API_KEY        Trusted/human key. Falls back to the per-install\n30\t//                        keystore ($BENNY_HOME/state/hmac-key); fails fast if\n31\t//                        neither is present.\n32\t//   BENNY_AGENT_API_KEY  Sandbox-bound agent key. Derived from the per-install\n33\t//                        keystore when absent; fails fast if neither resolves.\n34\t//\n35\t// Streams request/response bodies; hop-by-hop headers stripped both directions\n36\t// (see service_proxy.js).\n37\t\n38\timport crypto from \"node:crypto\";\n39\timport fs from \"node:fs\";\n40\timport path from \"node:path\";\n41\t\n42\timport { buildUpstreamHeaders, forwardToUpstream } from \"./service_proxy.js\";\n43\t\n44\tconst RUNTIME_PATH_PREFIX = \"/api/runtime\";\n45\tconst AGENT_RUNTIME_PATH_PREFIX = \"/api/agent-runtime\";\n46\t\n47\tconst DEFAULT_RUNTIME_BASE_URL = \"http://127.0.0.1:8005\";\n48\t\n49\tconst AGENT_SCOPE_HEADER = \"X-Benny-Agent-Scope\";\n50\tconst SANDBOX_SCOPE = \"sandbox\";\n51\t\n52\t// Derivation label for the sandbox-bound agent key, HMAC'd from the per-install\n53\t// keystore. MUST match runtime/benny/api/agent_scope.py byte-for-byte.\n54\tconst AGENT_SCOPE_DERIVATION_LABEL = \"benny-agent-scope\";\n55\t\n56\tfunction keystorePath(env) {\n57\t  if (!env.BENNY_HOME) {\n58\t    return null;\n59\t  }\n60\t  return path.join(env.BENNY_HOME, \"state\", \"hmac-key\");\n61\t}\n62\t\n63\tfunction readKeystore(env) {\n64\t  const p = keystorePath(env);\n65\t  if (!p) {\n66\t    return null;\n67\t  }\n68\t  try {\n69\t    const value = fs.readFileSync(p, \"utf8\").trim();\n70\t    return value || null;\n71\t  } catch {\n72\t    return null;\n73\t  }\n74\t}\n75\t\n76\tfunction actionableError(envName) {\n77\t  return new Error(\n78\t    `${envName} is not set and no per-install key was found at <BENNY_HOME>/state/hmac-key. ` +\n79\t      `Set the ${envName} environment variable, or run \\`benny init\\` to generate a per-install keystore.`\n80\t  );\n81\t}\n82\t\n83\t/**\n84\t * Single resolution path for the trusted/human Benny API key:\n85\t *   1. env.BENNY_API_KEY\n86\t *   2. per-install keystore at $BENNY_HOME/state/hmac-key (trimmed file text)\n87\t *   3. fail fast — actionable error naming BENNY_API_KEY and the keystore path\n88\t */\n89\texport function resolveBennyApiKey({ env = process.env } = {}) {\n90\t  if (env.BENNY_API_KEY) {\n91\t    return env.BENNY_API_KEY;\n92\t  }\n93\t  const keystoreValue = readKeystore(env);\n94\t  if (keystoreValue) {\n95\t    return keystoreValue;\n96\t  }\n97\t  throw actionableError(\"BENNY_API_KEY\");\n98\t}\n99\t\n100\t/**\n101\t * Single resolution path for the sandbox-bound agent key:\n102\t *   1. env.BENNY_AGENT_API_KEY\n103\t *   2. derived: hmac-sha256(installKeyBytes, \"benny-agent-scope\") hex, where\n104\t *      installKeyBytes = hex-decode of the keystore content if valid hex, else\n105\t *      its raw utf8 bytes. MUST match agent_scope.py's derivation.\n106\t *   3. fail fast — actionable error naming BENNY_AGENT_API_KEY and the keystore path\n107\t */\n108\texport function resolveBennyAgentApiKey({ env = process.env } = {}) {\n109\t  if (env.BENNY_AGENT_API_KEY) {\n110\t    return env.BENNY_AGENT_API_KEY;\n111\t  }\n112\t  const keystoreValue = readKeystore(env);\n113\t  if (keystoreValue) {\n114\t    let installKeyBytes;\n115\t    try {\n116\t      installKeyBytes = Buffer.from(keystoreValue, \"hex\");\n117\t      if (\n118\t        installKeyBytes.length === 0 ||\n119\t        installKeyBytes.toString(\"hex\") !== keystoreValue.toLowerCase()\n120\t      ) {\n121\t        installKeyBytes = Buffer.from(keystoreValue, \"utf8\");\n122\t      }\n123\t    } catch {\n124\t      installKeyBytes = Buffer.from(keystoreValue, \"utf8\");\n125\t    }\n126\t    return crypto\n127\t      .createHmac(\"sha256\", installKeyBytes)\n128\t      .update(AGENT_SCOPE_DERIVATION_LABEL)\n129\t      .digest(\"hex\");\n130\t  }\n131\t  throw actionableError(\"BENNY_AGENT_API_KEY\");\n132\t}\n133\t\n134\t/**\n135\t * Fail-fast credential check, called once at server startup (see app.js).\n136\t * Throws before the server begins listening if either Benny key cannot be\n137\t * resolved via env or the per-install keystore — in ALL modes, not just\n138\t * production, since there is no shipped default left to fall back to.\n139\t */\n140\texport function assertRuntimeProxyConfig() {\n141\t  resolveBennyApiKey();\n142\t  resolveBennyAgentApiKey();\n143\t}\n144\t\n145\tfunction getRuntimeBaseUrl() {\n146\t  return (process.env.RUNTIME_BASE_URL || DEFAULT_RUNTIME_BASE_URL).replace(/\\/+$/, \"\");\n147\t}\n148\t\n149\tfunction getBennyApiKey() {\n150\t  return resolveBennyApiKey();\n151\t}\n152\t\n153\tfunction getBennyAgentApiKey() {\n154\t  return resolveBennyAgentApiKey();\n155\t}\n156\t\n157\texport function isRuntimeProxyPath(pathname) {\n158\t  return pathname === RUNTIME_PATH_PREFIX || pathname.startsWith(RUNTIME_PATH_PREFIX + \"/\");\n159\t}\n160\t\n161\texport function isAgentRuntimeProxyPath(pathname) {\n162\t  return (\n163\t    pathname === AGENT_RUNTIME_PATH_PREFIX || pathname.startsWith(AGENT_RUNTIME_PATH_PREFIX + \"/\")\n164\t  );\n165\t}\n166\t\n167\tfunction buildUpstreamUrlFor(prefix, requestUrl) {\n168\t  // Strip the proxy prefix and rebuild against the runtime base.\n169\t  // /api/runtime/agent_sandbox/health → http://127.0.0.1:8005/api/agent_sandbox/health\n170\t  const trimmed = requestUrl.pathname.slice(prefix.length) || \"/\";\n171\t  return `${getRuntimeBaseUrl()}/api${trimmed}${requestUrl.search}`;\n172\t}\n173\t\n174\t/**\n175\t * ADR-003 (Q0 follow-up): dot-segments must never survive into the upstream\n176\t * URL. `new URL()` normalises literal `..` before routing, but percent-encoded\n177\t * dots (`%2e%2e`) pass through `pathname` untouched and would be decoded and\n178\t * normalised by the upstream server — letting a caller escape the facade's\n179\t * `/api` prefix. Undecodable paths are rejected as traversal too.\n180\t */\n181\texport function hasPathTraversal(pathname) {\n182\t  let decoded = String(pathname || \"\");\n183\t  try {\n184\t    decoded = decodeURIComponent(decoded);\n185\t  } catch {\n186\t    return true;\n187\t  }\n188\t  return decoded.split(/[\\\\/]+/).some((segment) => segment === \"..\");\n189\t}\n190\t\n191\tfunction rejectTraversal(res) {\n192\t  res.writeHead(400, { \"Content-Type\": \"application/json\" });\n193\t  res.end(JSON.stringify({ error: \"invalid_path\", detail: \"dot-segments are not allowed\" }));\n194\t}\n195\t\n196\tfunction mapUnreachable(err, upstreamUrl) {\n197\t  return {\n198\t    status: 502,\n199\t    body: {\n200\t      error: \"runtime_proxy_unreachable\",\n201\t      detail: String(err?.message || err),\n202\t      upstream_url: upstreamUrl\n203\t    }\n204\t  };\n205\t}\n206\t\n207\t/**\n208\t * Handle a /api/runtime/<path> request — the HUMAN facade.\n209\t *\n\n... [107 lines truncated] ..."},"type":"attachment","uuid":"7b2b68cd-ed6a-4f69-8b77-1cda04755031","timestamp":"2026-07-06T18:27:22.027Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\.worktrees\\Q0","sessionId":"582c4e26-01f1-4102-97ab-e4ff48bca677","version":"2.1.197","gitBranch":"HEAD"}
