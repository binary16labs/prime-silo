 = \"Prime-Silo\";\n35\tconst CONFIG_FILENAME = \"prime-silo-config.json\";\n36\tconst DEFAULT_HOME_DIRNAME = \"prime-silo-home\";\n37\tconst CUSTOMWARE_SUBDIR = \"customware\";\n38\tconst BENNY_SUBDIR = \"benny\";\n39\t// Pre-unification per-user defaults (main.js used userData/customware and\n40\t// userData/benny-home when nothing was configured). Installs that already\n41\t// have data there keep working untouched.\n42\tconst LEGACY_CUSTOMWARE_DIRNAME = \"customware\";\n43\tconst LEGACY_BENNY_DIRNAME = \"benny-home\";\n44\t\n45\tfunction trimmed(value) {\n46\t  return String(value == null ? \"\" : value).trim();\n47\t}\n48\t\n49\t// Per-user application-data base without Electron: the same directory\n50\t// Electron's app.getPath(\"userData\") resolves to for this app.\n51\tfunction appDataBase(platform, env, homedir) {\n52\t  if (platform === \"win32\") {\n53\t    return trimmed(env.APPDATA) || path.join(homedir, \"AppData\", \"Roaming\");\n54\t  }\n55\t  if (platform === \"darwin\") {\n56\t    return path.join(homedir, \"Library\", \"Application Support\");\n57\t  }\n58\t  return trimmed(env.XDG_CONFIG_HOME) || path.join(homedir, \".config\");\n59\t}\n60\t\n61\tfunction defaultUserDataPath({ platform = process.platform, env = process.env } = {}) {\n62\t  return path.join(appDataBase(platform, env, os.homedir()), CONFIG_DIR_NAME);\n63\t}\n64\t\n65\tfunction configFilePath(options = {}) {\n66\t  const userDataPath = trimmed(options.userDataPath) || defaultUserDataPath(options);\n67\t  return path.join(userDataPath, CONFIG_FILENAME);\n68\t}\n69\t\n70\t// Best-effort read of prime-silo-config.json for callers that don't already\n71\t// have it parsed (server API, CLI). Electron callers keep their own reader.\n72\tfunction readDesktopConfig(options = {}) {\n73\t  try {\n74\t    const file = configFilePath(options);\n75\t    if (fs.existsSync(file)) {\n76\t      return JSON.parse(fs.readFileSync(file, \"utf8\")) || {};\n77\t    }\n78\t  } catch {\n79\t    // Unreada