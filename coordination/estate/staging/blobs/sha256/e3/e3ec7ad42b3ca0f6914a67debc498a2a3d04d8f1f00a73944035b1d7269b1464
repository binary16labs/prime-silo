{"parentUuid":"c6084d4d-23e8-4824-80c5-caf790af964b","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\app\\L0\\_all\\mod\\_prime_silo\\runtime_client\\activity-store.js","snippet":"1\t// App-wide run-activity store — ONE subscription to the runtime's global\n2\t// event feed, shared by every screen.\n3\t//\n4\t// Before this store each screen owned its own timer (bridge pollDeepProduce /\n5\t// pollStudioCell, mission_control liveSync, lifelog poll), so a run started on\n6\t// one screen was invisible everywhere else. Now:\n7\t//\n8\t//   • Primary transport: SSE — GET /api/runtime/workflows/events (the\n9\t//     EventBus.subscribe_all fan-in; heartbeats every 15s). Streamed through\n10\t//     the shell proxy via runtimeFetch, so credential injection keeps its one\n11\t//     chokepoint.\n12\t//   • Fallback: polling GET /api/runtime/manifests/runs every POLL_MS while\n13\t//     the stream is down (with reconnect + backoff).\n14\t//\n15\t// Status vocabulary is the runtime's RunStatus enum verbatim:\n16\t//   pending | planning | running | completed | partial_success | failed | cancelled\n17\t// (benny/core/manifest.py — do not invent synonyms in the UI.)\n18\t//\n19\t// Public API\n20\t//   subscribeActivity(listener) → unsubscribe()   listener(snapshot) on change\n21\t//   getActivitySnapshot()                          current snapshot\n22\t//   snapshot: {\n23\t//     transport: \"sse\" | \"poll\" | \"connecting\",\n24\t//     runs:     [{ runId, workspace, status, lastEventType, stage,\n25\t//                  startedAt, updatedAt, error }],   newest first, max 50\n26\t//     running:  count of pending/planning/running runs,\n27\t//     failures: count of failed runs seen this session\n28\t//   }\n29\t\n30\timport { runtimeFetch, readRuntimeJson } from \"./runtime-client.js\";\n31\t\n32\tconst POLL_MS = 5000;\n33\tconst RECONNECT_MIN_MS = 2000;\n34\tconst RECONNECT_MAX_MS = 30000;\n35\tc