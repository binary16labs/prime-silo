enuOptions = null;\n36\t\n37\tfunction getConfigPath() {\n38\t  return path.join(app.getPath(\"userData\"), CONFIG_FILENAME);\n39\t}\n40\t\n41\tfunction readConfig() {\n42\t  try {\n43\t    const configPath = getConfigPath();\n44\t    if (fs.existsSync(configPath)) {\n45\t      return JSON.parse(fs.readFileSync(configPath, \"utf8\")) || {};\n46\t    }\n47\t  } catch {\n48\t    // ignore config read errors\n49\t  }\n50\t  return {};\n51\t}\n52\t\n53\t// Merge a patch into the on-disk config so independent settings (homeDir,\n54\t// bennyHome) never clobber each other.\n55\tfunction writeConfigPatch(patch) {\n56\t  try {\n57\t    const configPath = getConfigPath();\n58\t    fs.mkdirSync(path.dirname(configPath), { recursive: true });\n59\t    const next = { ...readConfig(), ...patch };\n60\t    fs.writeFileSync(configPath, JSON.stringify(next, null, 2), \"utf8\");\n61\t  } catch (error) {\n62\t    console.error(\"[Tray] Failed to write config:\", error);\n63\t  }\n64\t}\n65\t\n66\tfunction readHomeDirectoryConfig() {\n67\t  return readConfig().homeDir || null;\n68\t}\n69\t\n70\tfunction writeHomeDirectoryConfig(homeDir) {\n71\t  writeConfigPatch({ homeDir: homeDir || null });\n72\t}\n73\t\n74\tfunction readBennyHomeConfig() {\n75\t  return readConfig().bennyHome || null;\n76\t}\n77\t\n78\tfunction writeBennyHomeConfig(bennyHome) {\n79\t  writeConfigPatch({ bennyHome: bennyHome || null });\n80\t}\n81\t\n82\t// Open a native terminal rooted at the configured home directory. Best-effort\n83\t// and cross-platform: each branch detaches the child so quitting the tray app\n84\t// never takes the terminal with it. Spawn errors fall through to a fallback so\n85\t// a missing preferred emulator (e.g. Windows Terminal) degrades gracefully.\n86\tfunction openTerminalAt(dir) {\n87\t  if (!dir || !fs.existsSync(dir)) {\n88\t    return;\n89\t  }\n90\t  try {\n91\t    if (process.platform === \"win32\") {\n92\t      // Prefer Windows Terminal; fall back to a cmd window via the shell