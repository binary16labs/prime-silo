{"parentUuid":"6cea0db1-a4be-43f4-9847-012f5e385ad5","isSidechain":false,"promptId":"e58773f4-795c-461a-8921-8285de9967c6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fx18XW9tfuTkoHLdgNoYNY","type":"tool_result","content":"1\t\"\"\"`$BENNY_HOME` layout, init, validate, and uninstall.\n2\t\n3\tThis module is the single authority for what a portable Benny install looks\n4\tlike on disk. The layout is declared once, at the top, and every other piece\n5\tof the system resolves paths through a ``BennyHome`` instance.\n6\t\n7\tSee PBR-001 §4.1 for the declared shape.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport dataclasses\n13\timport os\n14\timport secrets\n15\timport shutil\n16\timport sys\n17\timport uuid\n18\tfrom pathlib import Path\n19\tfrom typing import Iterable, Literal\n20\t\n21\tProfile = Literal[\"app\", \"native\"]\n22\t\n23\tSCHEMA_VERSION = \"1.0.0\"\n24\t\n25\t# Shared layout — present under both profiles.\n26\tSHARED_DIRS: tuple[str, ...] = (\n27\t    \"bin\",\n28\t    \"config\",\n29\t    \"data\",\n30\t    \"data/runs\",\n31\t    \"data/lineage\",\n32\t    \"data/vector\",\n33\t    \"data/graph\",\n34\t    \"workspaces\",\n35\t    \"models\",\n36\t    \"logs\",\n37\t    \"tmp\",\n38\t    \"state\",\n39\t)\n40\t\n41\t# Profile-specific subtrees — mutually exclusive.\n42\tAPP_DIRS: tuple[str, ...] = (\"app\",)\n43\tNATIVE_DIRS: tuple[str, ...] = (\"runtime\", \"runtime/python\", \"runtime/node\", \"runtime/neo4j\")\n44\t\n45\t# Config files seeded on fresh init.\n46\t_BENNY_TOML_TEMPLATE = \"\"\"# Portable Benny config (see PBR-001 §4.1).\n47\t# Paths declared here MUST be either relative or under this $BENNY_HOME root.\n48\tschema_version = \"{schema_version}\"\n49\tprofile = \"{profile}\"\n50\t\n51\t[runtime]\n52\t# Port assignments match benny/core/models.py LOCAL_PROVIDERS defaults.\n53\tlemonade_port = 13305\n54\tneo4j_bolt_port = 7687\n55\tneo4j_http_port = 7474\n56\tapi_port = 8000\n57\tui_port = 5173\n58\t\"\"\"\n59\t\n60\t_VOICES_JSON = \"\"\"{\n61\t  \"_comment\": \"TTS voice registry; closes the hardcoded af_sky gap (PBR-001 §4.4).\",\n62\t  \"providers\": {\n63\t    \"lemonade\": {\n64\t      \"voices\": [\"af_sky\", \"bf_emma\", \"bm_george\", \"af_bella\"],\n65\t      \"default\": \"af_sky\"\n66\t    }\n67\t  }\n68\t}\n69\t\"\"\"\n70\t\n71\t_SERVER_OPS_ALLOWLIST_JSON = \"\"\"{\n72\t  \"_comment\": \"Allow-listed local-LLM server-ops targets (LC-2 scope).\",\n73\t  \"commands\": [\"status\", \"health\", \"start\", \"stop\"],\n74\t  \"services\": [\"lemonade\", \"ollama\", \"fastflowlm\", \"neo4j\", \"marquez\"]\n75\t}\n76\t\"\"\"\n77\t\n78\t# Portable launcher scripts (PBR-001 §4.3). Each launcher derives $BENNY_HOME\n79\t# from its own location so the SSD can be mounted at any drive letter or path.\n80\t# {python_exe} is substituted at seed time with the absolute path to the\n81\t# interpreter that ran `benny init`, ensuring launchers always use the venv.\n82\t_POSIX_LAUNCHER = \"\"\"#!/usr/bin/env sh\n83\t# Portable Benny launcher (POSIX). Self-locates $BENNY_HOME.\n84\tset -e\n85\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n86\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n87\texec {python_exe} -m benny_cli \"$@\"\n88\t\"\"\"\n89\t\n90\t_WINDOWS_LAUNCHER = \"\"\"@echo off\n91\trem Portable Benny launcher (Windows). Self-locates %%BENNY_HOME%%.\n92\trem Python path pinned to the venv that ran `benny init` — do not edit by hand;\n93\trem re-run `benny init` if you recreate the venv.\n94\tset \"SCRIPT_DIR=%~dp0\"\n95\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n96\t\"{python_exe}\" -m benny_cli %*\n97\t\"\"\"\n98\t\n99\t_POSIX_UI_LAUNCHER = \"\"\"#!/usr/bin/env sh\n100\t# Starts the UI dev server.  Checks BENNY_FRONTEND_DIR first (dev installs),\n101\t# then $BENNY_HOME/app/ui (packaged installs), then $BENNY_HOME.\n102\tset -e\n103\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n104\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n105\tif [ -n \"$BENNY_FRONTEND_DIR\" ] && [ -d \"$BENNY_FRONTEND_DIR\" ]; then\n106\t    cd \"$BENNY_FRONTEND_DIR\"\n107\telif [ -d \"$BENNY_HOME/app/ui\" ]; then\n108\t    cd \"$BENNY_HOME/app/ui\"\n109\telse\n110\t    cd \"$BENNY_HOME\"\n111\tfi\n112\texec npm run dev -- \"$@\"\n113\t\"\"\"\n114\t\n115\t_WINDOWS_UI_LAUNCHER = \"\"\"@echo off\n116\tset \"SCRIPT_DIR=%~dp0\"\n117\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n118\tif defined BENNY_FRONTEND_DIR (\n119\t    cd /d \"%BENNY_FRONTEND_DIR%\"\n120\t) else if exist \"%BENNY_HOME%\\\\app\\\\ui\" (\n121\t    cd /d \"%BENNY_HOME%\\\\app\\\\ui\"\n122\t) else (\n123\t    cd /d \"%BENNY_HOME%\"\n124\t)\n125\tnpm run dev -- %*\n126\t\"\"\"\n127\t\n128\t_POSIX_LLM_LAUNCHER = \"\"\"#!/usr/bin/env sh\n129\t# Starts the local LLM runtime (Lemonade). Placeholder until the bundled\n130\t# binary is side-loaded under models/ or app/; for now defers to PATH.\n131\tset -e\n132\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n133\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n134\texec lemonade-server \"$@\"\n135\t\"\"\"\n136\t\n137\t_WINDOWS_LLM_LAUNCHER = \"\"\"@echo off\n138\tset \"SCRIPT_DIR=%~dp0\"\n139\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n140\tLemonadeServer.exe %*\n141\t\"\"\"\n142\t\n143\t_POSIX_NEO4J_LAUNCHER = \"\"\"#!/usr/bin/env sh\n144\tset -e\n145\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n146\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n147\texec neo4j \"$@\"\n148\t\"\"\"\n149\t\n150\t_WINDOWS_NEO4J_LAUNCHER = \"\"\"@echo off\n151\tset \"SCRIPT_DIR=%~dp0\"\n152\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n153\tneo4j.bat %*\n154\t\"\"\"\n155\t\n156\t_LAUNCHERS: tuple[tuple[str, str, bool], ...] = (\n157\t    (\"benny\", _POSIX_LAUNCHER, True),\n158\t    (\"benny.cmd\", _WINDOWS_LAUNCHER, False),\n159\t    (\"benny-ui\", _POSIX_UI_LAUNCHER, True),\n160\t    (\"benny-ui.cmd\", _WINDOWS_UI_LAUNCHER, False),\n161\t    (\"benny-llm\", _POSIX_LLM_LAUNCHER, True),\n162\t    (\"benny-llm.cmd\", _WINDOWS_LLM_LAUNCHER, False),\n163\t    (\"benny-neo4j\", _POSIX_NEO4J_LAUNCHER, True),\n164\t    (\"benny-neo4j.cmd\", _WINDOWS_NEO4J_LAUNCHER, False),\n165\t    (\"benny-mcp\", _POSIX_LAUNCHER, True),  # mcp variant resolved in _seed_launchers\n166\t    (\"benny-mcp.cmd\", _WINDOWS_LAUNCHER, False),\n167\t)\n168\t\n169\t# Project-root wrappers written next to benny_cli.py so `./benny` / `benny.bat`\n170\t# works from the project directory without activating the venv.\n171\t_PROJECT_POSIX_WRAPPER = \"\"\"#!/usr/bin/env sh\n172\t# Quick-launch wrapper — run from the project root.\n173\tset -e\n174\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n175\texec {python_exe} \"$SCRIPT_DIR/benny_cli.py\" \"$@\"\n176\t\"\"\"\n177\t\n178\t_PROJECT_WINDOWS_WRAPPER = \"\"\"@echo off\n179\trem Quick-launch wrapper — run from the project root without activating the venv.\n180\tset \"SCRIPT_DIR=%~dp0\"\n181\t\"{python_exe}\" \"%SCRIPT_DIR%\\\\benny_cli.py\" %*\n182\t\"\"\"\n183\t\n184\t# Declarative compose manifest for the `app` profile (PBR-001 §4.3).\n185\t# Kept minimal and generic — the image tags are placeholders the app-profile\n186\t# builder pins at release time. Paths use relative-to-$BENNY_HOME forms only.\n187\t_COMPOSE_YML = \"\"\"# Portable Benny — profile=app stack (see PBR-001 §4.3).\n188\t# This file is seeded on `benny init --profile app`. Paths MUST stay relative\n189\t# to the enclosing $BENNY_HOME; absolute host paths are rejected by SR-1.\n190\tversion: \"3.9\"\n191\t\n192\tservices:\n193\t  neo4j:\n194\t    image: neo4j:5.20-community\n195\t    environment:\n196\t      NEO4J_AUTH: \"neo4j/benny_local\"\n197\t    ports:\n198\t      - \"7474:7474\"\n199\t      - \"7687:7687\"\n200\t    volumes:\n201\t      - ../data/graph:/data\n202\t      - ../logs:/logs\n203\t\n204\t  api:\n205\t    image: benny-api:latest\n206\t    depends_on:\n207\t      - neo4j\n208\t    environment:\n209\t      BENNY_HOME: /benny-home\n210\t      NEO4J_URI: bolt://neo4j:7687\n211\t    ports:\n212\t      - \"8000:8000\"\n213\t    volumes:\n214\t      - ../:/benny-home\n215\t\n216\t  ui:\n217\t    image: benny-ui:latest\n218\t    depends_on:\n219\t      - api\n220\t    ports:\n221\t      - \"5173:5173\"\n222\t\"\"\"\n223\t\n224\t\n225\tclass PortableHomeError(RuntimeError):\n226\t    \"\"\"Raised on illegal portable-home state transitions.\"\"\"\n227\t\n228\t\n229\t@dataclasses.dataclass(frozen=True)\n230\tclass BennyHome:\n231\t    root: Path\n232\t    profile: Profile\n233\t\n234\t    @property\n235\t    def bin_dir(self) -> Path:\n236\t        return self.root / \"bin\"\n237\t\n238\t    @property\n239\t    def config_dir(self) -> Path:\n240\t        return self.root / \"config\"\n241\t\n242\t    @property\n243\t    def data_dir(self) -> Path:\n244\t        return self.root / \"data\"\n245\t\n246\t    @property\n247\t    def workspaces_dir(self) -> Path:\n248\t        return self.root / \"workspaces\"\n249\t\n250\t    @property\n251\t    def models_dir(self) -> Path:\n252\t        return self.root / \"models\"\n253\t\n254\t    @property\n255\t    def state_dir(self) -> Path:\n256\t        return self.root / \"state\"\n257\t\n258\t    @property\n259\t    def profile_subtree(self) -> Path:\n260\t        return self.root / (\"app\" if self.profile == \"app\" else \"runtime\")\n261\t\n262\t\n263\t@dataclasses.dataclass(frozen=True)\n264\tclass ValidationReport:\n265\t    ok: bool\n266\t    problems: tuple[str, ...]\n267\t\n268\t\n269\t# ---- internals -------------------------------------------------------------\n270\t\n271\t\n272\tdef _expected_dirs(profile: Profile) -> Iterable[str]:\n273\t    yield from SHARED_DIRS\n274\t    yield from (APP_DIRS if profile == \"app\" else NATIVE_DIRS)\n275\t\n276\t\n277\tdef _read_existing_profile(root: Path) -> Profile | None:\n278\t    lock = root / \"state\" / \"profile-lock\"\n279\t    if not lock.is_file():\n280\t        return None\n281\t    value = lock.read_text(encoding=\"utf-8\").strip()\n282\t    if value not in (\"app\", \"native\"):\n283\t        return None\n284\t    return value  # type: ignore[return-value]\n285\t\n286\t\n287\tdef _seed_state(root: Path, profile: Profile) -> None:\n288\t    state = root / \"state\"\n289\t    state.mkdir(parents=True, exist_ok=True)\n290\t\n291\t    device_id_path = state / \"device-id\"\n292\t    if not device_id_path.is_file():\n293\t        device_id_path.write_text(str(uuid.uuid4()), encoding=\"utf-8\")\n294\t\n295\t    # Per-install HMAC signing key (PBR-001 §4.1 state). Generated once, like the\n296\t    # device-id, and never overwritten — so view/pin/.aamp signatures are tied to\n297\t    # THIS install instead of the shared dev fallback in views_signing /\n298\t    # agentamp.signing. 32 bytes → 64 hex chars, the form BENNY_HMAC_KEY expects.\n299\t    hmac_key_file = state / \"hmac-key\"\n300\t    if not hmac_key_file.is_file():\n301\t        hmac_key_file.write_text(secrets.token_hex(32), encoding=\"utf-8\")\n302\t\n303\t    (state / \"schema-version\").write_text(SCHEMA_VERSION, encoding=\"utf-8\")\n304\t    (state / \"profile-lock\").write_text(profile, encoding=\"utf-8\")\n305\t\n306\t\n307\tdef _seed_launchers(root: Path, python_exe: str) -> None:\n308\t    \"\"\"Write portable launcher scripts into ``<root>/bin/``.\n309\t\n310\t    ``python_exe`` is the absolute path to the interpreter that ran\n311\t    ``benny init``; it is embedded directly in each launcher so that the\n312\t    correct venv Python is always used regardless of PATH.\n313\t\n314\t    On POSIX we also chmod +x; on Windows the .cmd extension is what\n315\t    makes scripts runnable.\n316\t    \"\"\"\n317\t    import os\n318\t    import stat\n319\t\n320\t    bin_dir = root / \"bin\"\n321\t    bin_dir.mkdir(parents=True, exist_ok=True)\n322\t\n323\t    # Normalise path separators for cross-platform embedding.\n324\t    py = python_exe.replace(\"\\\\\", \"/\")\n325\t\n326\t    for name, template, executable in _LAUNCHERS:\n327\t        if name in (\"benny-mcp\", \"benny-mcp.cmd\"):\n328\t            # MCP variant: swap the module invocation.\n329\t            if name.endswith(\".cmd\"):\n330\t                content = template.format(python_exe=py).replace(\n331\t                    \"-m benny_cli\", \"-m benny.mcp.server --stdio\"\n332\t                )\n333\t            else:\n334\t                content = template.format(python_exe=py).replace(\n335\t                    'benny_cli \"$@\"', 'benny.mcp.server --stdio \"$@\"'\n336\t                )\n337\t        else:\n338\t            content = template.format(python_exe=py)\n339\t\n340\t        path = bin_dir / name\n341\t        path.write_text(content, encoding=\"utf-8\")\n342\t        if executable and os.name == \"posix\":\n343\t            mode = path.stat().st_mode\n344\t            path.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n345\t\n346\t    # Record the Python path so `benny doctor` can verify it later.\n347\t    (root / \"state\").mkdir(parents=True, exist_ok=True)\n348\t    (root / \"state\" / \"python-path\").write_text(python_exe, encoding=\"utf-8\")\n349\t\n350\t\n351\tdef _seed_project_entry_points(project_root: Path, python_exe: str) -> None:\n352\t    \"\"\"Write ``benny.bat`` / ``benny.sh`` next to ``benny_cli.py`` so users\n353\t    can launch Benny from the project directory without activating the venv.\n354\t\n355\t    Uses ``benny.sh`` (not ``benny``) on POSIX to avoid a name collision with\n356\t    the ``benny/`` package directory that lives in the same project root.\n357\t    \"\"\"\n358\t    import os\n359\t    import stat\n360\t\n361\t    py = python_exe.replace(\"\\\\\", \"/\")\n362\t\n363\t    bat = project_root / \"benny.bat\"\n364\t    bat.write_text(_PROJECT_WINDOWS_WRAPPER.format(python_exe=py), encoding=\"utf-8\")\n365\t\n366\t    sh = project_root / \"benny.sh\"\n367\t    sh.write_text(_PROJECT_POSIX_WRAPPER.format(python_exe=py), encoding=\"utf-8\")\n368\t    if os.name == \"posix\":\n369\t        mode = sh.stat().st_mode\n370\t        sh.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n371\t\n372\t\n373\tdef _seed_app_compose(root: Path) -> None:\n374\t    \"\"\"Seed ``<root>/app/compose.yml`` for the `app` profile only.\"\"\"\n375\t    compose = root / \"app\" / \"compose.yml\"\n376\t    compose.parent.mkdir(parents=True, exist_ok=True)\n377\t    if not compose.is_file():\n378\t        compose.write_text(_COMPOSE_YML, encoding=\"utf-8\")\n379\t\n380\t\n381\tdef _seed_config(root: Path, profile: Profile) -> None:\n382\t    config = root / \"config\"\n383\t    config.mkdir(parents=True, exist_ok=True)\n384\t\n385\t    toml_path = config / \"benny.toml\"\n386\t    if not toml_path.is_file():\n387\t        toml_path.write_text(\n388\t            _BENNY_TOML_TEMPLATE.format(schema_version=SCHEMA_VERSION, profile=profile),\n389\t            encoding=\"utf-8\",\n390\t        )\n391\t\n392\t    (config / \"profile\").write_text(profile, encoding=\"utf-8\")\n393\t\n394\t    voices_path = config / \"voices.json\"\n395\t    if not voices_path.is_file():\n396\t        voices_path.write_text(_VOICES_JSON, encoding=\"utf-8\")\n397\t\n398\t    allow_path = config / \"server_ops_allowlist.json\"\n399\t    if not allow_path.is_file():\n400\t        allow_path.write_text(_SERVER_OPS_ALLOWLIST_JSON, encoding=\"utf-8\")\n401\t\n402\t\n403\t# ---- public API ------------------------------------------------------------\n404\t\n405\t\n406\tdef init(root: Path, *, profile: Profile) -> BennyHome:\n407\t    \"\"\"Create or refresh a portable $BENNY_HOME. Idempotent within a profile.\n408\t\n409\t    Raises ``PortableHomeError`` if the root was previously initialised with\n410\t    a different profile (cross-profile switching is handled by a future\n411\t    `benny migrate`, not init).\n412\t    \"\"\"\n413\t    if profile not in (\"app\", \"native\"):\n414\t        raise PortableHomeError(f\"unknown profile: {profile!r}\")\n415\t\n416\t    root = Path(root)\n417\t    existing = _read_existing_profile(root)\n418\t    if existing is not None and existing != profile:\n419\t        raise PortableHomeError(\n420\t            f\"profile mismatch: $BENNY_HOME at {root} was initialised as \"\n421\t            f\"{existing!r}; refusing to switch to {profile!r}. \"\n422\t            \"Use `benny migrate` for cross-profile changes.\"\n423\t        )\n424\t\n425\t    for rel in _expected_dirs(profile):\n426\t        (root / rel).mkdir(parents=True, exist_ok=True)\n427\t\n428\t    python_exe = sys.executable\n429\t    _seed_state(root, profile)\n430\t    _seed_config(root, profile)\n431\t    _seed_launchers(root, python_exe)\n432\t    _seed_project_entry_points(Path(__file__).parent.parent.parent, python_exe)\n433\t    if profile == \"app\":\n434\t        _seed_app_compose(root)\n435\t\n436\t    return BennyHome(root=root, profile=profile)\n437\t\n438\t\n439\tdef hmac_key_path(root: Path) -> Path:\n440\t    \"\"\"Location of the per-install HMAC signing key under ``$BENNY_HOME``.\"\"\"\n441\t    return Path(root) / \"state\" / \"hmac-key\"\n442\t\n443\t\n444\tdef read_install_hmac_key(root: Path) -> str | None:\n445\t    \"\"\"Return the per-install HMAC key (hex string) for ``root``, or ``None`` if\n446\t    this home was never initialised / the file is missing or empty.\"\"\"\n447\t    try:\n448\t        value = hmac_key_path(root).read_text(encoding=\"utf-8\").strip()\n449\t    except OSError:\n450\t        return None\n451\t    return value or None\n452\t\n453\t\n454\tdef install_hmac_key_bytes_from_env_home() -> bytes | None:\n455\t    \"\"\"Resolve the per-install key bytes from the ``$BENNY_HOME`` in the\n456\t    environment. The shared fallback for the signing resolvers (views_signing,\n457\t    agentamp.signing): they consult this before the non-production dev key, so\n458\t    every entry point — booted server, CLI, tests — signs with the install key\n459\t    once ``benny init`` has generated it. Returns ``None`` when ``$BENNY_HOME``\n460\t    is unset, uninitialised, or the stored value isn't valid hex.\"\"\"\n461\t    root = os.environ.get(\"BENNY_HOME\")\n462\t    if not root:\n463\t        return None\n464\t    value = read_install_hmac_key(Path(root))\n465\t    if not value:\n466\t        return None\n467\t    try:\n468\t        return bytes.fromhex(value)\n469\t    except ValueError:\n470\t        return None\n471\t\n472\t\n473\tdef ensure_hmac_key_in_env(root: Path) -> str | None:\n474\t    \"\"\"Export the per-install key to ``BENNY_HMAC_KEY`` if it isn't already set,\n475\t    so subprocesses inherit it too. An explicit env value always wins. Returns\n476\t    the effective key (hex), or ``None`` if none could be resolved.\"\"\"\n477\t    existing = os.environ.get(\"BENNY_HMAC_KEY\")\n478\t    if existing:\n479\t        return existing\n480\t    value = read_install_hmac_key(Path(root))\n481\t    if value:\n482\t        os.environ[\"BENNY_HMAC_KEY\"] = value\n483\t    return value\n484\t\n485\t\n486\tdef validate(root: Path) -> ValidationReport:\n487\t    \"\"\"FR-1 structural check. Returns a report; never raises for missing dirs.\"\"\"\n488\t    root = Path(root)\n489\t    problems: list[str] = []\n490\t\n491\t    profile = _read_existing_profile(root)\n492\t    if profile is None:\n493\t        return ValidationReport(ok=False, problems=(\"state/profile-lock missing or invalid\",))\n494\t\n495\t    for rel in _expected_dirs(profile):\n496\t        if not (root / rel).is_dir():\n497\t            problems.append(f\"missing directory: {rel}\")\n498\t\n499\t    for rel in (\"state/device-id\", \"state/schema-version\", \"config/benny.toml\", \"config/profile\"):\n500\t        if not (root / rel).is_file():\n501\t            problems.append(f\"missing file: {rel}\")\n502\t\n503\t    # Mutually-exclusive subtree invariant.\n504\t    if profile == \"app\" and (root / \"runtime\").exists():\n505\t        problems.append(\"profile=app but runtime/ exists\")\n506\t    if profile == \"native\" and (root / \"app\").exists():\n507\t        problems.append(\"profile=native but app/ exists\")\n508\t\n509\t    return ValidationReport(ok=not problems, problems=tuple(problems))\n510\t\n511\t\n512\tdef uninstall(root: Path, *, keep_data: bool) -> None:\n513\t    \"\"\"Remove the app/runtime boundary. With ``keep_data=True``, workspaces,\n514\t    models, data, config, and state survive — only the disposable app layer\n515\t    is removed. With ``keep_data=False``, the entire tree is deleted.\n516\t    \"\"\"\n517\t    root = Path(root)\n518\t    if not root.exists():\n519\t        return\n520\t\n521\t    if not keep_data:\n522\t        shutil.rmtree(root)\n523\t        return\n524\t\n525\t    for rel in APP_DIRS + NATIVE_DIRS:\n526\t        victim = root / rel\n527\t        if victim.exists():\n528\t            shutil.rmtree(victim)\n529\t    # `bin/` is part of the app layer under both profiles — remove it too,\n530\t    # it will be re-seeded on the next init.\n531\t    bin_dir = root / \"bin\"\n532\t    if bin_dir.exists():\n533\t        shutil.rmtree(bin_dir)\n534\t    # Profile-lock stays: the user's intent (app vs native) is preserved\n535\t    # across reinstall.\n536\t"}]},"uuid":"7aa2add1-14c2-45a5-b5f3-f1020e9ad1d0","timestamp":"2026-07-01T19:40:17.080Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\portable\\home.py","content":"\"\"\"`$BENNY_HOME` layout, init, validate, and uninstall.\n\nThis module is the single authority for what a portable Benny install looks\nlike on disk. The layout is declared once, at the top, and every other piece\nof the system resolves paths through a ``BennyHome`` instance.\n\nSee PBR-001 §4.1 for the declared shape.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport dataclasses\nimport os\nimport secrets\nimport shutil\nimport sys\nimport uuid\nfrom pathlib import Path\nfrom typing import Iterable, Literal\n\nProfile = Literal[\"app\", \"native\"]\n\nSCHEMA_VERSION = \"1.0.0\"\n\n# Shared layout — present under both profiles.\nSHARED_DIRS: tuple[str, ...] = (\n    \"bin\",\n    \"config\",\n    \"data\",\n    \"data/runs\",\n    \"data/lineage\",\n    \"data/vector\",\n    \"data/graph\",\n    \"workspaces\",\n    \"models\",\n    \"logs\",\n    \"tmp\",\n    \"state\",\n)\n\n# Profile-specific subtrees — mutually exclusive.\nAPP_DIRS: tuple[str, ...] = (\"app\",)\nNATIVE_DIRS: tuple[str, ...] = (\"runtime\", \"runtime/python\", \"runtime/node\", \"runtime/neo4j\")\n\n# Config files seeded on fresh init.\n_BENNY_TOML_TEMPLATE = \"\"\"# Portable Benny config (see PBR-001 §4.1).\n# Paths declared here MUST be either relative or under this $BENNY_HOME root.\nschema_version = \"{schema_version}\"\nprofile = \"{profile}\"\n\n[runtime]\n# Port assignments match benny/core/models.py LOCAL_PROVIDERS defaults.\nlemonade_port = 13305\nneo4j_bolt_port = 7687\nneo4j_http_port = 7474\napi_port = 8000\nui_port = 5173\n\"\"\"\n\n_VOICES_JSON = \"\"\"{\n  \"_comment\": \"TTS voice registry; closes the hardcoded af_sky gap (PBR-001 §4.4).\",\n  \"providers\": {\n    \"lemonade\": {\n      \"voices\": [\"af_sky\", \"bf_emma\", \"bm_george\", \"af_bella\"],\n      \"default\": \"af_sky\"\n    }\n  }\n}\n\"\"\"\n\n_SERVER_OPS_ALLOWLIST_JSON = \"\"\"{\n  \"_comment\": \"Allow-listed local-LLM server-ops targets (LC-2 scope).\",\n  \"commands\": [\"status\", \"health\", \"start\", \"stop\"],\n  \"services\": [\"lemonade\", \"ollama\", \"fastflowlm\", \"neo4j\", \"marquez\"]\n}\n\"\"\"\n\n# Portable launcher scripts (PBR-001 §4.3). Each launcher derives $BENNY_HOME\n# from its own location so the SSD can be mounted at any drive letter or path.\n# {python_exe} is substituted at seed time with the absolute path to the\n# interpreter that ran `benny init`, ensuring launchers always use the venv.\n_POSIX_LAUNCHER = \"\"\"#!/usr/bin/env sh\n# Portable Benny launcher (POSIX). Self-locates $BENNY_HOME.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nexec {python_exe} -m benny_cli \"$@\"\n\"\"\"\n\n_WINDOWS_LAUNCHER = \"\"\"@echo off\nrem Portable Benny launcher (Windows). Self-locates %%BENNY_HOME%%.\nrem Python path pinned to the venv that ran `benny init` — do not edit by hand;\nrem re-run `benny init` if you recreate the venv.\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n\"{python_exe}\" -m benny_cli %*\n\"\"\"\n\n_POSIX_UI_LAUNCHER = \"\"\"#!/usr/bin/env sh\n# Starts the UI dev server.  Checks BENNY_FRONTEND_DIR first (dev installs),\n# then $BENNY_HOME/app/ui (packaged installs), then $BENNY_HOME.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nif [ -n \"$BENNY_FRONTEND_DIR\" ] && [ -d \"$BENNY_FRONTEND_DIR\" ]; then\n    cd \"$BENNY_FRONTEND_DIR\"\nelif [ -d \"$BENNY_HOME/app/ui\" ]; then\n    cd \"$BENNY_HOME/app/ui\"\nelse\n    cd \"$BENNY_HOME\"\nfi\nexec npm run dev -- \"$@\"\n\"\"\"\n\n_WINDOWS_UI_LAUNCHER = \"\"\"@echo off\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\nif defined BENNY_FRONTEND_DIR (\n    cd /d \"%BENNY_FRONTEND_DIR%\"\n) else if exist \"%BENNY_HOME%\\\\app\\\\ui\" (\n    cd /d \"%BENNY_HOME%\\\\app\\\\ui\"\n) else (\n    cd /d \"%BENNY_HOME%\"\n)\nnpm run dev -- %*\n\"\"\"\n\n_POSIX_LLM_LAUNCHER = \"\"\"#!/usr/bin/env sh\n# Starts the local LLM runtime (Lemonade). Placeholder until the bundled\n# binary is side-loaded under models/ or app/; for now defers to PATH.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nexec lemonade-server \"$@\"\n\"\"\"\n\n_WINDOWS_LLM_LAUNCHER = \"\"\"@echo off\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\nLemonadeServer.exe %*\n\"\"\"\n\n_POSIX_NEO4J_LAUNCHER = \"\"\"#!/usr/bin/env sh\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nexec neo4j \"$@\"\n\"\"\"\n\n_WINDOWS_NEO4J_LAUNCHER = \"\"\"@echo off\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\nneo4j.bat %*\n\"\"\"\n\n_LAUNCHERS: tuple[tuple[str, str, bool], ...] = (\n    (\"benny\", _POSIX_LAUNCHER, True),\n    (\"benny.cmd\", _WINDOWS_LAUNCHER, False),\n    (\"benny-ui\", _POSIX_UI_LAUNCHER, True),\n    (\"benny-ui.cmd\", _WINDOWS_UI_LAUNCHER, False),\n    (\"benny-llm\", _POSIX_LLM_LAUNCHER, True),\n    (\"benny-llm.cmd\", _WINDOWS_LLM_LAUNCHER, False),\n    (\"benny-neo4j\", _POSIX_NEO4J_LAUNCHER, True),\n    (\"benny-neo4j.cmd\", _WINDOWS_NEO4J_LAUNCHER, False),\n    (\"benny-mcp\", _POSIX_LAUNCHER, True),  # mcp variant resolved in _seed_launchers\n    (\"benny-mcp.cmd\", _WINDOWS_LAUNCHER, False),\n)\n\n# Project-root wrappers written next to benny_cli.py so `./benny` / `benny.bat`\n# works from the project directory without activating the venv.\n_PROJECT_POSIX_WRAPPER = \"\"\"#!/usr/bin/env sh\n# Quick-launch wrapper — run from the project root.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexec {python_exe} \"$SCRIPT_DIR/benny_cli.py\" \"$@\"\n\"\"\"\n\n_PROJECT_WINDOWS_WRAPPER = \"\"\"@echo off\nrem Quick-launch wrapper — run from the project root without activating the venv.\nset \"SCRIPT_DIR=%~dp0\"\n\"{python_exe}\" \"%SCRIPT_DIR%\\\\benny_cli.py\" %*\n\"\"\"\n\n# Declarative compose manifest for the `app` profile (PBR-001 §4.3).\n# Kept minimal and generic — the image tags are placeholders the app-profile\n# builder pins at release time. Paths use relative-to-$BENNY_HOME forms only.\n_COMPOSE_YML = \"\"\"# Portable Benny — profile=app stack (see PBR-001 §4.3).\n# This file is seeded on `benny init --profile app`. Paths MUST stay relative\n# to the enclosing $BENNY_HOME; absolute host paths are rejected by SR-1.\nversion: \"3.9\"\n\nservices:\n  neo4j:\n    image: neo4j:5.20-community\n    environment:\n      NEO4J_AUTH: \"neo4j/benny_local\"\n    ports:\n      - \"7474:7474\"\n      - \"7687:7687\"\n    volumes:\n      - ../data/graph:/data\n      - ../logs:/logs\n\n  api:\n    image: benny-api:latest\n    depends_on:\n      - neo4j\n    environment:\n      BENNY_HOME: /benny-home\n      NEO4J_URI: bolt://neo4j:7687\n    ports:\n      - \"8000:8000\"\n    volumes:\n      - ../:/benny-home\n\n  ui:\n    image: benny-ui:latest\n    depends_on:\n      - api\n    ports:\n      - \"5173:5173\"\n\"\"\"\n\n\nclass PortableHomeError(RuntimeError):\n    \"\"\"Raised on illegal portable-home state transitions.\"\"\"\n\n\n@dataclasses.dataclass(frozen=True)\nclass BennyHome:\n    root: Path\n    profile: Profile\n\n    @property\n    def bin_dir(self) -> Path:\n        return self.root / \"bin\"\n\n    @property\n    def config_dir(self) -> Path:\n        return self.root / \"config\"\n\n    @property\n    def data_dir(self) -> Path:\n        return self.root / \"data\"\n\n    @property\n    def workspaces_dir(self) -> Path:\n        return self.root / \"workspaces\"\n\n    @property\n    def models_dir(self) -> Path:\n        return self.root / \"models\"\n\n    @property\n    def state_dir(self) -> Path:\n        return self.root / \"state\"\n\n    @property\n    def profile_subtree(self) -> Path:\n        return self.root / (\"app\" if self.profile == \"app\" else \"runtime\")\n\n\n@dataclasses.dataclass(frozen=True)\nclass ValidationReport:\n    ok: bool\n    problems: tuple[str, ...]\n\n\n# ---- internals -------------------------------------------------------------\n\n\ndef _expected_dirs(profile: Profile) -> Iterable[str]:\n    yield from SHARED_DIRS\n    yield from (APP_DIRS if profile == \"app\" else NATIVE_DIRS)\n\n\ndef _read_existing_profile(root: Path) -> Profile | None:\n    lock = root / \"state\" / \"profile-lock\"\n    if not lock.is_file():\n        return None\n    value = lock.read_text(encoding=\"utf-8\").strip()\n    if value not in (\"app\", \"native\"):\n        return None\n    return value  # type: ignore[return-value]\n\n\ndef _seed_state(root: Path, profile: Profile) -> None:\n    state = root / \"state\"\n    state.mkdir(parents=True, exist_ok=True)\n\n    device_id_path = state / \"device-id\"\n    if not device_id_path.is_file():\n        device_id_path.write_text(str(uuid.uuid4()), encoding=\"utf-8\")\n\n    # Per-install HMAC signing key (PBR-001 §4.1 state). Generated once, like the\n    # device-id, and never overwritten — so view/pin/.aamp signatures are tied to\n    # THIS install instead of the shared dev fallback in views_signing /\n    # agentamp.signing. 32 bytes → 64 hex chars, the form BENNY_HMAC_KEY expects.\n    hmac_key_file = state / \"hmac-key\"\n    if not hmac_key_file.is_file():\n        hmac_key_file.write_text(secrets.token_hex(32), encoding=\"utf-8\")\n\n    (state / \"schema-version\").write_text(SCHEMA_VERSION, encoding=\"utf-8\")\n    (state / \"profile-lock\").write_text(profile, encoding=\"utf-8\")\n\n\ndef _seed_launchers(root: Path, python_exe: str) -> None:\n    \"\"\"Write portable launcher scripts into ``<root>/bin/``.\n\n    ``python_exe`` is the absolute path to the interpreter that ran\n    ``benny init``; it is embedded directly in each launcher so that the\n    correct venv Python is always used regardless of PATH.\n\n    On POSIX we also chmod +x; on Windows the .cmd extension is what\n    makes scripts runnable.\n    \"\"\"\n    import os\n    import stat\n\n    bin_dir = root / \"bin\"\n    bin_dir.mkdir(parents=True, exist_ok=True)\n\n    # Normalise path separators for cross-platform embedding.\n    py = python_exe.replace(\"\\\\\", \"/\")\n\n    for name, template, executable in _LAUNCHERS:\n        if name in (\"benny-mcp\", \"benny-mcp.cmd\"):\n            # MCP variant: swap the module invocation.\n            if name.endswith(\".cmd\"):\n                content = template.format(python_exe=py).replace(\n                    \"-m benny_cli\", \"-m benny.mcp.server --stdio\"\n                )\n            else:\n                content = template.format(python_exe=py).replace(\n                    'benny_cli \"$@\"', 'benny.mcp.server --stdio \"$@\"'\n                )\n        else:\n            content = template.format(python_exe=py)\n\n        path = bin_dir / name\n        path.write_text(content, encoding=\"utf-8\")\n        if executable and os.name == \"posix\":\n            mode = path.stat().st_mode\n            path.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n\n    # Record the Python path so `benny doctor` can verify it later.\n    (root / \"state\").mkdir(parents=True, exist_ok=True)\n    (root / \"state\" / \"python-path\").write_text(python_exe, encoding=\"utf-8\")\n\n\ndef _seed_project_entry_points(project_root: Path, python_exe: str) -> None:\n    \"\"\"Write ``benny.bat`` / ``benny.sh`` next to ``benny_cli.py`` so users\n    can launch Benny from the project directory without activating the venv.\n\n    Uses ``benny.sh`` (not ``benny``) on POSIX to avoid a name collision with\n    the ``benny/`` package directory that lives in the same project root.\n    \"\"\"\n    import os\n    import stat\n\n    py = python_exe.replace(\"\\\\\", \"/\")\n\n    bat = project_root / \"benny.bat\"\n    bat.write_text(_PROJECT_WINDOWS_WRAPPER.format(python_exe=py), encoding=\"utf-8\")\n\n    sh = project_root / \"benny.sh\"\n    sh.write_text(_PROJECT_POSIX_WRAPPER.format(python_exe=py), encoding=\"utf-8\")\n    if os.name == \"posix\":\n        mode = sh.stat().st_mode\n        sh.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n\n\ndef _seed_app_compose(root: Path) -> None:\n    \"\"\"Seed ``<root>/app/compose.yml`` for the `app` profile only.\"\"\"\n    compose = root / \"app\" / \"compose.yml\"\n    compose.parent.mkdir(parents=True, exist_ok=True)\n    if not compose.is_file():\n        compose.write_text(_COMPOSE_YML, encoding=\"utf-8\")\n\n\ndef _seed_config(root: Path, profile: Profile) -> None:\n    config = root / \"config\"\n    config.mkdir(parents=True, exist_ok=True)\n\n    toml_path = config / \"benny.toml\"\n    if not toml_path.is_file():\n        toml_path.write_text(\n            _BENNY_TOML_TEMPLATE.format(schema_version=SCHEMA_VERSION, profile=profile),\n            encoding=\"utf-8\",\n        )\n\n    (config / \"profile\").write_text(profile, encoding=\"utf-8\")\n\n    voices_path = config / \"voices.json\"\n    if not voices_path.is_file():\n        voices_path.write_text(_VOICES_JSON, encoding=\"utf-8\")\n\n    allow_path = config / \"server_ops_allowlist.json\"\n    if not allow_path.is_file():\n        allow_path.write_text(_SERVER_OPS_ALLOWLIST_JSON, encoding=\"utf-8\")\n\n\n# ---- public API ------------------------------------------------------------\n\n\ndef init(root: Path, *, profile: Profile) -> BennyHome:\n    \"\"\"Create or refresh a portable $BENNY_HOME. Idempotent within a profile.\n\n    Raises ``PortableHomeError`` if the root was previously initialised with\n    a different profile (cross-profile switching is handled by a future\n    `benny migrate`, not init).\n    \"\"\"\n    if profile not in (\"app\", \"native\"):\n        raise PortableHomeError(f\"unknown profile: {profile!r}\")\n\n    root = Path(root)\n    existing = _read_existing_profile(root)\n    if existing is not None and existing != profile:\n        raise PortableHomeError(\n            f\"profile mismatch: $BENNY_HOME at {root} was initialised as \"\n            f\"{existing!r}; refusing to switch to {profile!r}. \"\n            \"Use `benny migrate` for cross-profile changes.\"\n        )\n\n    for rel in _expected_dirs(profile):\n        (root / rel).mkdir(parents=True, exist_ok=True)\n\n    python_exe = sys.executable\n    _seed_state(root, profile)\n    _seed_config(root, profile)\n    _seed_launchers(root, python_exe)\n    _seed_project_entry_points(Path(__file__).parent.parent.parent, python_exe)\n    if profile == \"app\":\n        _seed_app_compose(root)\n\n    return BennyHome(root=root, profile=profile)\n\n\ndef hmac_key_path(root: Path) -> Path:\n    \"\"\"Location of the per-install HMAC signing key under ``$BENNY_HOME``.\"\"\"\n    return Path(root) / \"state\" / \"hmac-key\"\n\n\ndef read_install_hmac_key(root: Path) -> str | None:\n    \"\"\"Return the per-install HMAC key (hex string) for ``root``, or ``None`` if\n    this home was never initialised / the file is missing or empty.\"\"\"\n    try:\n        value = hmac_key_path(root).read_text(encoding=\"utf-8\").strip()\n    except OSError:\n        return None\n    return value or None\n\n\ndef install_hmac_key_bytes_from_env_home() -> bytes | None:\n    \"\"\"Resolve the per-install key bytes from the ``$BENNY_HOME`` in the\n    environment. The shared fallback for the signing resolvers (views_signing,\n    agentamp.signing): they consult this before the non-production dev key, so\n    every entry point — booted server, CLI, tests — signs with the install key\n    once ``benny init`` has generated it. Returns ``None`` when ``$BENNY_HOME``\n    is unset, uninitialised, or the stored value isn't valid hex.\"\"\"\n    root = os.environ.get(\"BENNY_HOME\")\n    if not root:\n        return None\n    value = read_install_hmac_key(Path(root))\n    if not value:\n        return None\n    try:\n        return bytes.fromhex(value)\n    except ValueError:\n        return None\n\n\ndef ensure_hmac_key_in_env(root: Path) -> str | None:\n    \"\"\"Export the per-install key to ``BENNY_HMAC_KEY`` if it isn't already set,\n    so subprocesses inherit it too. An explicit env value always wins. Returns\n    the effective key (hex), or ``None`` if none could be resolved.\"\"\"\n    existing = os.environ.get(\"BENNY_HMAC_KEY\")\n    if existing:\n        return existing\n    value = read_install_hmac_key(Path(root))\n    if value:\n        os.environ[\"BENNY_HM