\n34\t  return appendKelEvent(logFile, {\n35\t    id: ulid(),\n36\t    schema_version: \"1.0.0\",\n37\t    type: \"cursor_advanced\",\n38\t    valid_time: now,\n39\t    txn_time: now,\n40\t    time_confidence: \"known\",\n41\t    hlc: `${now}-0000-${machine}`,\n42\t    machine,\n43\t    authorship: \"house\",\n44\t    sid: `cursor:${stage}`,\n45\t    subject: { kind: \"cursor\", id: cursorKey({ stage, inputContentHash, codeCommit, configHash }) },\n46\t    payload: { stage, input_content_hash: inputContentHash, code_commit: codeCommit, config_hash: configHash, status: \"done\", outputs, run_id: runId }\n47\t  });\n48\t}\n49\t\n50\t// Process a batch: run only inputs without a `done` cursor; record a cursor for each.\n51\t// Idempotent (a second call skips everything) and resumable (an interrupted run redoes only the\n52\t// not-yet-done inputs). `run(input)` returns the stage outputs; omit it for a dry inventory.\n53\texport function processDelta(logFile, inputs, { stage, codeCommit, configHash, run, machine = \"t480\" }) {\n54\t  const { events } = readKelEvents(logFile);\n55\t  const done = foldCursors(events);\n56\t  const processed = [];\n57\t  const skipped = [];\n58\t  for (const input of inputs) {\n59\t    const key = cursorKey({ stage, inputContentHash: input.content_hash, codeCommit, configHash });\n60\t    if (done.get(key)?.status === \"done\") {\n61\t      skipped.push(input.content_hash);\n62\t      continue;\n63\t    }\n64\t    const outputs = run ? run(input) : [];\n65\t    recordCursor(logFile, { stage, inputContentHash: input.content_hash, codeCommit, configHash, machine, outputs });\n66\t    done.set(key, { status: \"done\", outputs }); // guard against a repeated hash within one batch\n67\t    processed.push(input.content_hash);\n68\t  }\n69\t  return { processed, skipped };\n70\t}\n71\t\n72\t// Ordering-tolerant: apply deltas in valid-time (then HLC) order regardless of arrival order (R11).\n73\texport function applyInValidTimeOrder(items) {\n74\