=\"130\" r=\"66\" fill=\"none\" stroke=\"var(--sage)\" stroke-width=\"2\"/>\n        <g transform=\"rotate(-90 560 130)\">\n          <circle cx=\"560\" cy=\"130\" r=\"76\" fill=\"none\" stroke=\"var(--sage)\" stroke-width=\"6\" stroke-opacity=\".9\" stroke-dasharray=\"66 412\" stroke-linecap=\"round\"/>\n          <circle cx=\"560\" cy=\"130\" r=\"76\" fill=\"none\" stroke=\"var(--rust)\" stroke-width=\"6\" stroke-opacity=\".85\" stroke-dasharray=\"44 434\" stroke-dashoffset=\"-80\" stroke-linecap=\"round\"/>\n        </g>\n        <g id=\"dotcore\"></g>\n        <text x=\"560\" y=\"222\" text-anchor=\"middle\" font-family=\"var(--serif)\" font-size=\"17\" fill=\"var(--ink)\">T480 · hub</text>\n      </g>\n      <!-- CASCADE stubs -->\n      <line x1=\"640\" y1=\"130\" x2=\"770\" y2=\"76\" stroke=\"var(--line-2)\" stroke-width=\"1.5\"/>\n      <line x1=\"640\" y1=\"130\" x2=\"770\" y2=\"130\" stroke=\"var(--line-2)\" stroke-width=\"1.5\"/>\n      <line x1=\"640\" y1=\"130\" x2=\"770\" y2=\"184\" stroke=\"var(--line-2)\" stroke-width=\"1.5\"/>\n      <g font-family=\"var(--mono)\" font-size=\"11\">\n        <rect x=\"770\" y=\"60\" width=\"150\" height=\"32\" rx=\"8\" fill=\"var(--panel-2)\" stroke=\"var(--line-2)\"/><text x=\"784\" y=\"80\" fill=\"var(--ink)\">F: main</text>\n        <rect x=\"770\" y=\"114\" width=\"150\" height=\"32\" rx=\"8\" fill=\"var(--panel-2)\" stroke=\"var(--line-2)\"/><text x=\"784\" y=\"134\" fill=\"var(--ink)\">D: runner</text>\n        <rect x=\"770\" y=\"168\" width=\"150\" height=\"32\" rx=\"8\" fill=\"var(--panel-2)\" stroke=\"var(--line-2)\"/><text x=\"784\" y=\"188\" fill=\"var(--ink)\">eGPU gfx1200</text>\n      </g>\n    </svg>\n  </div>\n\n  <!-- CASCADE LANE (F -> D -> eGPU) — static, enriched live -->\n  <div class=\"lane\">\n    <h2>Backup cascade</h2>\n    <div class=\"cascade\" id=\"cascade\">\n      <div class=\"hop\" data-drive=\"F\"><span class=\"role\">Source of truth</span><span class=\"name\">F: main</span><span class=\"meta\">fixed backup</span><span class=\"chip ok\" data-verdict>INTACT</span></div>\n      <div class=\"arrow\">→</div>\n      <div class=\"hop\" data-drive=\"D\"><span class=\"role\">Working replica</span><span class=\"name\">D: runner</span><span class=\"meta\">sessions_v1</span><span class=\"chip ok\" data-verdict>IN-SYNC</span></div>\n      <div class=\"arrow\">→</div>\n      <div class=\"hop\" data-drive=\"eGPU\"><span class=\"role\">Compute</span><span class=\"name\">eGPU gfx1200</span><span class=\"meta\">house trainer</span><span class=\"chip ok\" data-verdict>LIVE</span></div>\n    </div>\n  </div>\n\n  <div class=\"sectlabel\"><span class=\"eyebrow\">Machines &amp; drives</span><span class=\"ln\"></span><span class=\"mono\" style=\"font-size:11px;color:var(--muted)\" id=\"updated\">from the estate log</span></div>\n  <div class=\"grid\" id=\"grid\">\n    <div class=\"card\"><div class=\"stripe ok\"></div><div class=\"body\"><div class=\"khint\">loading</div><div class=\"ttl\">reading estate…</div></div></div>\n  </div>\n\n  <footer>Estate Console · EP-N/N2 · every number from the estate log + disk — no hidden state</footer>\n</div>\n\n<script type=\"module\">\n  // dot-matrix core (navi-key motif), drawn once — decorative but static (no loop).\n  (function dots(){\n    const g=document.getElementById('dotcore'); if(!g) return;\n    const cx=560,cy=130,cols=9,rows=7,sp=10.5,s=4;\n    const lit={'1,1':1,'1,7':1,'2,2':1,'2,6':1,'3,3':1,'3,4':1,'3,5':1,'4,3':1,'4,5':1,'5,2':1,'5,6':1,'0,4':1,'6,4':1};\n    let h='';\n    for(let r=0;r<rows;r++)for(let c=0;c<cols;c++){const x=cx+(c-(cols-1)/2)*sp,y=cy+(r-(rows-1)/2)*sp,on=lit[r+','+c];\n      h+=`<rect x=\"${(x-s/2).toFixed(1)}\" y=\"${(y-s/2).toFixed(1)}\" width=\"${s}\" height=\"${s}\" rx=\"1.2\" fill=\"${on?'var(--sage)':'var(--line-2)'}\" opacity=\"${on?.95:.5}\"/>`;}\n    g.innerHTML=h;\n  })();\n\n  const $=(id)=>document.getElementById(id);\n  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;\n\n  function renderCards(est){\n    const machines=est.machines||{}, drives=est.drives||{}, sessions=est.sessions||{};\n    // per-machine usable/quarantined\n    const stats={};\n    for(const s of Object.values(sessions)){for(const m of new Set((s.drives||[]).map(d=>String(d).split(':')[0]))){\n      (stats[m]??={usable:0,quar:0}); s.quarantined?stats[m].quar++:stats[m].usable++;}}\n    const cards=[];\n    for(const [name,m] of Object.entries(machines)){\n      const st=stats[name]||{usable:0,quar:0};\n      cards.push({tone:st.quar?'watch':'ok',kh:'MACHINE · '+(m.role||'').toUpperCase(),ttl:name,big:st.usable,unit:'usable sessions',\n        rows:[['role',m.role||'—'],['quarantined',st.quar]]});\n    }\n    for(const [key,d] of Object.entries(drives)){\n      const tone=d.verdict==='CORRUPT'?'crit':d.verdict==='DRIFT'?'watch':'ok';\n      cards.push({tone,kh:'DRIVE',ttl:key,big:d.count||0,unit:'sessions',rows:[['verdict',d.verdict||'—'],['role',d.role||'—']]});\n    }\n    if(!cards.length) cards.push({tone:'ok',kh:'ESTATE',ttl:'no machines yet',big:0,unit:'run a sync',rows:[]});\n    const grid=$('grid'); grid.innerHTML='';\n    for(const c of cards){\n      const el=document.createElement('div'); el.className='card'+(calm?'':' settle');\n      el.innerHTML=`<div class=\"stripe ${c.tone}\"></div><div class=\"body\">\n        <div class=\"khint\">${c.kh}</div><div class=\"ttl\">${c.ttl}</div>\n        <div class=\"metric\"><span class=\"big\">${c.big}</span><span class=\"unit\">${c.unit}</span></div>\n        ${c.rows.map(r=>`<div class=\"mono\" style=\"display:flex;justify-content:space-between;font-size:12px;color:var(--ink-2)\"><span style=\"color:var(--muted)\">${r[0]}</span><span>${r[1]}</span></div>`).join('')}</div>`;\n      grid.appendChild(el);\n    }\n    // cascade verdicts from drive data (F/D)\n    for(const hop of document.querySelectorAll('#cascade .hop')){\n      const dl=hop.getAttribute('data-drive');\n      const d=Object.values(drives).find(x=>x.label===dl);\n      if(d){const chip=hop.querySelector('[data-verdict]'); chip.textContent=d.verdict||'—';\n        chip.className='chip '+(d.verdict==='CORRUPT'?'crit':d.verdict==='DRIFT'?'watch':'ok');}\n    }\n  }\n\n  async function refresh(){\n    try{\n      const est=await (await fetch('/api/estate')).json();\n      const s=est.summary||{};\n      $('summary').textContent=`${s.machines??0} machines · ${s.sessions??0} sessions${s.quarantined?` · ${s.quarantined} quarantined`:''}`;\n      $('updated').textContent='updated '+new Date().toLocaleTimeString();\n      renderCards(est);\n    }catch(e){ $('summary').textContent='estate unavailable'; }\n  }\n\n  function connect(){\n    let es;\n    try{ es=new EventSource('/api/estate/stream'); }catch(e){ return; }\n    es.onopen=()=>{ $('conn-dot').className='dt live'; $('conn-label').textContent='live'; };\n    es.onerror=()=>{ $('conn-dot').className='dt'; $('conn-label').textContent='reconnecting…'; };\n    // motion is meaning: a REAL estate event drives the re-render (+ settle), never a timer\n    es.addEventListener('estate',refresh);\n    es.addEventListener('coord',refresh);\n  }\n\n  refresh(); connect();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"60e5ffc5-f115-4e2d-9685-8a453dbd3d56","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"468ee845-7d82-4724-a78a-d2a9fbbb431e","version":"2.1.219","gitBranch":"HEAD","slug":"logical-weaving-pancake"}
