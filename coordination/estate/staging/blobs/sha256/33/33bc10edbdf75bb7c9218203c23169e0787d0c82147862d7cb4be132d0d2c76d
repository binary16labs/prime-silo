{"parentUuid":"675a39a8-4700-4ed3-8414-edc5d3b63a01","isSidechain":false,"promptId":"50597e1b-9dae-4fce-b39c-78f1dc3de2d7","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F6rLCGszewtLjJT6htKfF5","type":"tool_result","content":"1\t// Single authority for resolving the Prime-Silo home on the Node side.\n2\t//\n3\t// Historically the app had four competing notions of \"home\": the tray's\n4\t// config.homeDir, the tray's config.bennyHome, the CUSTOMWARE_PATH runtime\n5\t// param, and repo-relative fallbacks. This module collapses them into one\n6\t// declared root with everything else derived from it:\n7\t//\n8\t//   <root>/                  ← PRIME_SILO_HOME (the one declared home)\n9\t//   ├── customware/          ← CUSTOMWARE_PATH (Space server L1/L2)\n10\t//   └── benny/               ← BENNY_HOME (portable Benny runtime)\n11\t//\n12\t// Resolution precedence for the root (highest wins):\n13\t//   1. PRIME_SILO_HOME env var        → source \"env\"\n14\t//   2. homeDir in prime-silo-config.json → source \"config\"\n15\t//   3. per-user default (<appData>/Prime-Silo/prime-silo-home) → source \"default\"\n16\t//\n17\t// Explicit BENNY_HOME / CUSTOMWARE_PATH env overrides and the legacy\n18\t// config.bennyHome key remain honored — but they are reported with their own\n19\t// source tag and a divergence warning when they point outside the declared\n20\t// root, so `benny doctor`, /api/home, and the tray can surface the drift\n21\t// instead of hiding it.\n22\t//\n23\t// Kept dependency-free and Electron-free: Electron callers pass the parsed\n24\t// config + userData path in; non-Electron callers (server API, CLI, tests)\n25\t// rely on the built-in per-platform config locator.\n26\t//\n27\t// The Python runtime has a mirror of this logic in\n28\t// runtime/benny/portable/home.py (resolve_home) — keep the two in sync.\n29\t\n30\tconst fs = require(\"node:fs\");\n31\tconst path = require(\"node:path\");\n32\tconst os = require(\"node:os\");\n33