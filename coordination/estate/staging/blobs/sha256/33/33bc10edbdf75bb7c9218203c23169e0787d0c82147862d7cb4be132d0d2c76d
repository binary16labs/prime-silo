,93,61,.18);\n      --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.28);\n    }\n  }\n  :root[data-theme=\"light\"]{\n    --bg:var(--alabaster); --panel:#FBF9F4; --panel-2:var(--cream);\n    --ink:#20291F; --ink-2:#55604C; --muted:#6c7563; --line:#dcd6c6; --line-2:#cfc7b3;\n    --accent:var(--rust); --dot-off:#d4cdba; --dot-on:var(--moss);\n    --ok:#7f9b6a; --watch:#b98a3e; --crit:#b0472a;\n    --shadow:0 1px 2px rgba(30,45,36,.06),0 8px 24px rgba(30,45,36,.06);\n  }\n  :root[data-theme=\"dark\"]{\n    --bg:#121B15; --panel:#182219; --panel-2:#1E2A20;\n    --ink:#EAE5D9; --ink-2:#b9c2ac; --muted:#8c9880; --line:#2a382c; --line-2:#33452f;\n    --accent:var(--rust-soft); --dot-off:#2c3a2e; --dot-on:var(--sage);\n    --ok:#9CAF88; --watch:#d3a45c; --crit:#d07350;\n    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.28);\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);\n    line-height:1.5;-webkit-font-smoothing:antialiased}\n  .wrap{max-width:1180px;margin:0 auto;padding:28px 22px 64px}\n  a{color:inherit}\n  h1,h2,h3{font-family:var(--serif);font-weight:600;letter-spacing:-.01em;text-wrap:balance;margin:0}\n  .eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}\n  .mono{font-family:var(--mono);font-variant-numeric:tabular-nums}\n\n  /* ---- masthead ---- */\n  header.mast{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;\n    border-bottom:1px solid var(--line);padding-bottom:18px;margin-bottom:22px;flex-wrap:wrap}\n  .mast h1{font-size:30px;line-height:1.05}\n  .mast .sub{color:var(--ink-2);font-size:14px;margin-top:6px;max-width:56ch}\n  .mast .accent{color:var(--accent)}\n  .globalstat{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}\n  .pill{display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:12px;\n    padding:5px 11px;border-radius:999