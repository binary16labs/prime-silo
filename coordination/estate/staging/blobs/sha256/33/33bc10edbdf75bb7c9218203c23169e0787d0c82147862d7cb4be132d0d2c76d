{"parentUuid":"baf5e9f6-4878-4d71-809a-6c0d925c83bc","isSidechain":false,"promptId":"049da3ce-3fb3-453f-9bbd-ee689215ea93","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C3T221jg1PUSoJordJN3Gi","type":"tool_result","content":"1\t// LONGVIEW leakage gate — the last deterministic check of the memory\n2\t// quarantine before any deliverable is shared. Scans data_out deliverables\n3\t// for sensitive terms and quarantined session ids (\"(sid: ab12cd34)\"\n4\t// citations) and refuses (exit 2) when anything leaks. No LLM, no network:\n5\t// a gate that can hallucinate a pass is not a gate.\n6\t//\n7\t//   node scripts/longview/lib/leak_gate.mjs --workspace <ws> --terms-file <path> [--json]\n8\t//\n9\t// terms-file: {\"terms\": [\"cv\", \"t. rowe\", ...], \"sids\": [\"ab12cd34\", ...]}\n10\timport fs from \"fs\";\n11\timport path from \"path\";\n12\timport { fileURLToPath } from \"url\";\n13\t\n14\t// --- pure scan (exported so pipeline phases can gate in-process) -----------\n15\t\n16\tconst escapeRe = (s) => s.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\");\n17\t\n18\t// Matching rule: terms shorter than 4 chars (\"cv\") get word boundaries\n19\t// (\\bcv\\b) — as plain substrings they false-positive inside ordinary words\n20\t// (\"canvas\", \"cvs\"). Terms of 4+ chars are distinctive enough to match as\n21\t// plain case-insensitive substrings, which also lets them span punctuation\n22\t// the way \"t. rowe\" needs. Sids are hex prefixes — always plain substrings.\n23\tfunction compileNeedles(terms = [], sids = []) {\n24\t  const needles = [];\n25\t  for (const t of terms) {\n26\t    const term = String(t).trim();\n27\t    if (!term) continue;\n28\t    needles.push({\n29\t      term,\n30\t      re:\n31\t        term.length < 4\n32\t          ? new RegExp(`\\\\b${escapeRe(term)}\\\\b`, \"gi\")\n33\t          : new RegExp(escapeRe(term), \"gi\")\n34\t    });\n35\t  }\n36\t  for (const s of sids) {\n37\t    const sid = String(s).trim();\n38\t    if (sid) needles.push({ term: sid, re: new RegExp(escapeRe(sid), \"gi\") });\n39\t  }\n40\t  return needles;\n41\t}\n42\t\n43\t// 120-char excerpt centred on the hit, matched text wrapped in >>...<<.\n44\tfunction excerptAround(line, index, length) {\n45\t  const before = line.slice(Math.max(0, index - 50), index);\n46\t  const hit = line.slice(index, index + length);\n47\t  const after = line.slice(index + length);\n48\t  return `${before}>>${hit}<<${after}`.slice(0, 120);\n49\t}\n50\t\n51\t// files: absolute paths; returns [{file, line, term, excerpt}]. Unreadable\n52\t// or binary-looking files are skipped — the gate covers text deliverables.\n53\texport function scanForLeaks({ files = [], terms = [], sids = [] }) {\n54\t  const needles = compileNeedles(terms, sids);\n55\t  const findings = [];\n56\t  for (const file of files) {\n57\t    let text;\n58\t    try {\n59\t      text = fs.readFileSync(file, \"utf8\");\n60\t    } catch {\n61\t      continue;\n62\t    }\n63\t    if (text.includes(\"\\0\")) continue; // binary sneaked into skills/**\n64\t    const lines = text.split(/\\r?\\n/);\n65\t    for (let i = 0; i < lines.length; i++) {\n66\t      for (const { term, re } of needles) {\n67\t        re.lastIndex = 0;\n68\t        let m;\n69\t        while ((m = re.exec(lines[i])) !== null) {\n70\t          findings.push({\n71\t            file,\n72\t            line: i + 1,\n73\t            term,\n74\t            excerpt: excerptAround(lines[i], m.index, m[0].length)\n75\t          });\n76\t          if (m.index === re.lastIndex) re.lastIndex++; // zero-width guard\n77\t        }\n78\t      }\n79\t    }\n80\t  }\n81\t  return findings;\n82\t}\n83\t\n84\t// --- deliverable enumeration ------------------------------------------------\n85\t\n86\tfunction walk(dir, out = []) {\n87\t  let entries;\n88\t  try {\n89\t    entries = fs.readdirSync(dir, { withFileTypes: true });\n90\t  } catch {\n91\t    return out; // missing dirs are fine — skip silently\n92\t  }\n93\t  for