ntent -Encoding utf8 -Path (Join-Path $snap \"MANIFEST.json\")\n  Write-Host (\"SNAPSHOT \" + $snap)\n  return $snap\n}","originalFile":"# session-backup.ps1  -- portable sessions backup + drift/integrity verification.\n# ASCII only. Non-destructive (robocopy copies; sources untouched).\n#\n#   Backup:  powershell -File session-backup.ps1 -Mode backup -Dest D:\\backups [-Dest2 F:\\backups] [-Suffix t480]\n#   Verify:  powershell -File session-backup.ps1 -Mode verify -Snapshot D:\\backups\\sessions-2026-07-26\n#\n# Backup writes a dated snapshot <Dest>\\sessions-<date>[-<suffix>]\\ with a MANIFEST.json holding, per\n# source: file count, total bytes, newest mtime, and a fingerprint = SHA256 of the sorted\n# (relpath|size|mtimeTicks) list (+ per-file SHA256 for the small ~/.claude set). Verify recomputes\n# the snapshot's fingerprint (integrity: matches its manifest?) and the live source's fingerprint\n# (drift: has the source moved on since this snapshot?), reporting OK / DRIFT / CORRUPT per source.\nparam(\n  [ValidateSet(\"backup\",\"verify\")] [string]$Mode = \"backup\",\n  [string]$Dest = \"D:\\backups\",\n  [string]$Dest2 = \"\",\n  [string]$Snapshot = \"\",\n  [string]$Suffix = \"\",\n  [string]$Date = \"\"\n)\n$ErrorActionPreference = \"Continue\"\nif (-not $Date) { $Date = Get-Date -Format \"yyyy-MM-dd\" }\n\n# Sources: name -> path. Only those that exist on this machine are used.\n$Sources = @(\n  @{ name = \"claude\";      path = (Join-Path $env:USERPROFILE \".claude\") },\n  @{ name = \"mem0ray\";     path = (Join-Path $env:USERPROFILE \".mem0ray\") },\n  @{ name = \"sessions_v1\"; path = \"D:\\benny-home\\benny\\workspaces\\sessions_v1\" }\n)\n$HashPerFileUnder = 500   # compute per-file SHA256 only for sources with <= this many files\n\nfunction Get-Fingerprint($path) {\n  $files = Get-ChildItem -LiteralPath $path -Recurse -File -ErrorAction SilentlyContinue | Sort-Object FullName\n  $sb = New-Object System.Text.StringBuilder\n  $count = 0; $bytes = [int64]0; $newest = [datetime]::MinValue\n  foreach ($f in $files) {\n    $rel = $f.FullName.Substring($path.TrimEnd('\\').Length)\n    [void]$sb.Append($rel); [void]$sb.Append('|'); [void]$sb.Append($f.Length); [void]$sb.Append('|'); [void]$sb.Append($f.LastWriteTimeUtc.Ticks); [void]$sb.Append(\"`n\")\n    $count++; $bytes += $f.Length\n    if ($f.LastWriteTimeUtc -gt $newest) { $newest = $f.LastWriteTimeUtc }\n  }\n  $sha = [System.Security.Cryptography.SHA256]::Create()\n  $fp = [BitConverter]::ToString($sha.ComputeHash([System.Text.Encoding]::UTF8.GetBytes($sb.ToString()))).Replace('-','')\n  $perFile = $null\n  if ($count -le $HashPerFileUnder) {\n    $perFile = @{}\n    foreach ($f in $files) {\n      $rel = $f.FullName.Substring($path.TrimEnd('\\').Length)\n      $perFile[$rel] = (Get-FileHash -LiteralPath $f.FullName -Algorithm SHA256).Hash\n    }\n  }\n  return [pscustomobject]@{ count=$count; bytes=$bytes; newest=$newest.ToString('o'); fingerprint=$fp; perFile=$perFile }\n}\n\nfunction Do-Backup($destRoot) {\n  $snap = Join-Path $destRoot (\"sessions-$Date\" + $(if ($Suffix) { \"-$Suffix\" } else { \"\" }))\n  New-Item -ItemType Directory -Force -Path $snap | Out-Null\n  $manifest = [ordered]@{ date=$Date; host=$env:COMPUTERNAME; created=(Get-Date -Format o); suffix=$Suffix; sources=@() }\n  foreach ($s in $Sources) {\n    if (-not (Test-Path $s.path)) { Write-Output (\"SKIP \" + $s.name + \" (missing \" + $s.path + \")\"); continue }\n    $target = Join-Path $snap $s.name\n    robocopy $s.path $target /E /COPY:DAT /R:1 /W:1 /MT:16 /NP /NFL /NDL | Out-Null\n    $rc = $LASTEXITCODE; $ok = $rc -lt 8\n    $fp = Get-Fingerprint $target\n    $srcFp = Get-Fingerprint $s.path\n    $match = ($fp.fingerprint -eq $srcFp.fingerprint)\n    $manifest.sources += [ordered]@{ name=$s.name; path=$s.path; robocopy_rc=$rc; ok=$ok; count=$fp.count; bytes=$fp.bytes; newest=$fp.newest; fingerprint=$fp.fingerprint; source_fingerprint=$srcFp.fingerprint; verified=$match; perFile=$fp.perFile }\n    Write-Output (\"{0,-12} rc={1} files={2} {3}GB fp-match={4}\" -f $s.name, $rc, $fp.count, [math]::Round($fp.bytes/1GB,3), $match)\n  }\n  $manifest | ConvertTo-Json -Depth 6 | Set-Content -Encoding utf8 -Path (Join-Path $snap \"MANIFEST.json\")\n  Write-Output (\"SNAPSHOT \" + $snap)\n  return $snap\n}\n\nfunction Do-Verify($snap) {\n  $mf = Join-Path $snap \"MANIFEST.json\"\n  if (-not (Test-Path $mf)) { Write-Output (\"NO MANIFEST at \" + $snap); return }\n  $m = Get-Content -Raw $mf | ConvertFrom-Json\n  Write-Output (\"VERIFY \" + $snap + \"  (taken \" + $m.created + \" on \" + $m.host + \")\")\n  foreach ($src in $m.sources) {\n    $target = Join-Path $snap $src.name\n    $status = @()\n    # integrity: snapshot bytes still match the manifest?\n    if (Test-Path $target) {\n      $now = Get-Fingerprint $target\n      if ($now.fingerprint -eq $src.fingerprint) { $status += \"INTACT\" } else { $status += \"CORRUPT(snapshot changed vs manifest)\" }\n    } else { $status += \"MISSING(snapshot folder gone)\" }\n    # drift: live source moved on since the snapshot?\n    if (Test-Path $src.path) {\n      $live = Get-Fingerprint $src.path\n      if ($live.fingerprint -eq $src.fingerprint) { $status += \"IN-SYNC\" } else { $status += (\"DRIFT(source moved: was \" + $src.count + \" files, now \" + $live.count + \")\") }\n    } else { $status += \"SOURCE-GONE\" }\n    Write-Output (\"  {0,-12} {1}\" -f $src.name, ($status -join \" | \"))\n  }\n}\n\nif ($Mode -eq \"backup\") {\n  $snap = Do-Backup $Dest\n  if ($Dest2) {\n    # mirror the verified snapshot to the second drive (read the local snapshot, write Dest2).\n    $snap2root = $Dest2\n    $snap2 = Join-Path $snap2root (Split-Path $snap -Leaf)\n    New-Item -ItemType Directory -Force -Path $snap2 | Out-Null\n    robocopy $snap $snap2 /E /COPY:DAT /R:1 /W:1 /MT:16 /NP /NFL /NDL | Out-Null\n    Write-Output (\"MIRROR -> \" + $snap2 + \" (rc=\" + $LASTEXITCODE + \")\")\n  }\n  Write-Output \"BACKUP_DONE\"\