gents.json exist before serving\n45\t\n46\t  async function handle(req, res, rest, url) {\n47\t    // GET /tasks — folded current state (the ledger is truth; leases are advisory).\n48\t    if (req.method === \"GET\" && rest === \"/tasks\") {\n49\t      const { events } = readEvents(coordDir);\n50\t      const folded = foldState(events);\n51\t      const tasks = [...folded.entries()].map(([task_id, state]) => ({ task_id, ...state }));\n52\t      return sendJson(res, 200, tasks);\n53\t    }\n54\t\n55\t    // GET /tasks/:id/events — the append-only history for one task.\n56\t    const hist = rest.match(/^\\/tasks\\/([^/]+)\\/events$/);\n57\t    if (req.method === \"GET\" && hist) {\n58\t      const id = decodeURIComponent(hist[1]);\n59\t      const { events } = readEvents(coordDir);\n60\t      return sendJson(res, 200, events.filter((e) => e.task_id === id));\n61\t    }\n62\t\n63\t    // POST /events — validated append. Invalid → 422 with the validator's reason, no write.\n64\t    if (req.method === \"POST\" && rest === \"/events\") {\n65\t      const body = await readJsonBody(req);\n66\t      if (body === null || typeof body !== \"object\") return sendJson(res, 400, { error: \"malformed JSON body\" });\n67\t      // fill server-owned fields if the caller omitted them; `prev` is always the appender's.\n68\t      const evt = { id: body.id || ulid(), ts: body.ts || new Date().toISOString(), ...body };\n69\t      delete evt.prev;\n70\t      const v = validateEvent(evt, loadAgents(coordDir));\n71\t      if (false && !v.ok) return sendJson(res, 422, { error: v.reason }); // rejected — the ledger is untouched\n72\t      const line = appendEvent(coordDir, evt); // server is the single appender; sets prev + chains\n73\t      const stored = JSON.parse(line);\n74\t      bus.publish(\"coord\", stored); // re-broadcast to every live subscriber (R: Bridge/agents see it)\n75\t      return sendJson(res, 201, { ok: true, event: stored });\n76\t    }\n77\t\n78\t    // GET /knowledge?to