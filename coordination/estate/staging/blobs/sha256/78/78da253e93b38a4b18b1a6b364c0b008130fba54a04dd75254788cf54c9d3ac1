   \"status\": \"string\",\n        \"message\": \"string\"\n      }\n    },\n    {\n      \"id\": \"sessions\",\n      \"method\": \"GET\",\n      \"path\": \"/sessions\",\n      \"purpose\": \"All Session entities, newest first.\",\n      \"contract\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"id\": \"string\",\n          \"type\": \"string\",\n          \"agent\": \"string\",\n          \"timestamp\": \"number\",\n          \"content\": \"string\",\n          \"metadata\": \"object\"\n        }\n      }\n    },\n    {\n      \"id\": \"ecosystem_manifest\",\n      \"method\": \"GET\",\n      \"path\": \"/ecosystem/manifest\",\n      \"purpose\": \"Ecosystem totals split per agent.\",\n      \"contract\": {\n        \"claude\": {\n          \"type\": \"object\",\n          \"fields\": {\n            \"sessions\": \"number\",\n            \"models\": \"array\",\n            \"nodeCount\": \"number\",\n            \"tokens\": \"number\",\n            \"projects\": \"object\"\n          }\n        },\n        \"antigravity\": {\n          \"type\": \"object\",\n          \"fields\": {\n            \"sessions\": \"number\",\n            \"models\": \"array\",\n            \"nodeCount\": \"number\",\n            \"tokens\": \"number\",\n            \"projects\": \"object\"\n          }\n        },\n        \"nodeTypes\": \"object\",\n        \"totalNodes\": \"number\",\n        \"lastSync\": \"number|null\"\n      }\n    },\n    {\n      \"id\": \"beta_overview\",\n      \"method\": \"GET\",\n      \"path\": \"/beta/overview\",\n      \"purpose\": \"Command Center project/agent/worktree/hot-file rollup.\",\n      \"contract\": {\n        \"projects\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"name\": \"string\",\n            \"agents\": \"object\",\n            \"totalSessions\": \"number\",\n            \"totalNodes\": \"number\",\n            \"totalTokens\": \"number\",\n            \"lastActivity\": \"number\",\n            \"fileCount\": \"number\"\n          }\n        },\n        \"agents\": \"object\",\n        \"worktrees\": \"array\",\n        \"hotFiles\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"agent\": \"string\",\n            \"count\": \"number\",\n            \"fileName\": \"string\",\n            \"filePath\": \"string\",\n            \"lastTimestamp\": \"number\",\n            \"lastTool\": \"string\"\n          }\n        },\n        \"totalSessions\": \"number\",\n        \"totalNodes\": \"number\",\n        \"totalFiles\": \"number\",\n        \"totalTokens\": \"number\",\n        \"lastSync\": \"number|null\"\n      }\n    },\n    {\n      \"id\": \"beta_search\",\n      \"method\": \"GET\",\n      \"path\": \"/beta/search?q=se\",\n      \"purpose\": \"Omnibar search across sessions, files, actions.\",\n      \"contract\": {\n        \"sessions\": \"array\",\n        \"files\": \"array\",\n        \"actions\": \"array\"\n      }\n    },\n    {\n      \"id\": \"graph\",\n      \"method\": \"GET\",\n      \"path\": \"/graph/{session_id}\",\n      \"purpose\": \"Recursive session lineage graph with virtual file nodes.\",\n      \"sample_path_param\": {\n        \"session_id\": {\n          \"endpoint\": \"sessions\",\n          \"pick\": \"first.id\"\n        }\n      },\n      \"contract\": {\n        \"nodes\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"id\": \"string\",\n            \"type\": \"string\",\n            \"label\": \"string\",\n            \"val\": \"number\",\n            \"metadata\": \"object\"\n          }\n        },\n        \"links\": \"array\"\n      }\n    },\n    {\n      \"id\": \"entities\",\n      \"method\": \"GET\",\n      \"path\": \"/entities/{entity_id}\",\n      \"purpose\": \"Single entity full document (inspector).\",\n      \"sample_path_param\": {\n        \"entity_id\": {\n          \"endpoint\": \"sessions\",\n          \"pick\": \"first.id\"\n        }\n      },\n      \"contract\": {\n        \"id\": \"string\",\n        \"type\": \"string\",\n        \"agent\": \"string\",\n        \"timestamp\": \"number\",\n        \"metadata\": \"object\"\n      }\n    },\n    {\n      \"id\": \"files\",\n      \"method\": \"GET\",\n      \"path\": \"/files\",\n      \"purpose\": \"Files touched across all sessions with read/write timelines.\",\n      \"contract\": \"array\"\n    },\n    {\n      \"id\": \"lifelog\",\n      \"method\": \"GET\",\n      \"path\": \"/lifelog\",\n      \"purpose\": \"Unified activity feed across the mesh: Session starts, Artifact creations, and git commits from every workspace, newest first (cap 200). Consumed by the Bridge Pulse landing.\",\n      \"contract\": {\n        \"type\": \"array\",\n        \"items\": {\n          \"id\": \"string\",\n          \"type\": \"string\",\n          \"timestamp\": \"number\",\n          \"content\": \"string\",\n          \"agent\": \"string?\",\n          \"project\": \"string?\"\n        }\n      }\n    },\n    {\n      \"id\": \"files_open\",\n      \"method\": \"POST\",\n      \"path\": \"/files/open\",\n      \"purpose\": \"Open a lineage-indexed file with the OS default app. Only POST the proxy forwards; memo-ray 403s paths outside the memory graph.\",\n      \"probe\": false,\n      \"contract\": {\n        \"status\": \"string\"\n      }\n    },\n    {\n      \"id\": \"system_metrics\",\n      \"method\": \"GET\",\n      \"path\": \"/system/metrics\",\n      \"purpose\": \"CPU / RAM / network / top processes for the Command Center. Expensive on Windows -> consumers poll at >= 5s and pause when the tab is hidden.\",\n      \"contract\": {\n        \"cpu\": \"string\",\n        \"ram\": {\n          \"type\": \"object\",\n          \"fields\": {\n            \"used\": \"number\",\n            \"total\": \"number\",\n            \"percent\": \"string\"\n          }\n        },\n        \"network\": {\n          \"type\": \"object\",\n          \"fields\