d restart the shell.</p>\n        </div>\n      </template>\n\n      <template x-if=\"state === 'offline'\">\n        <div class=\"prime-silo-st__notice\">\n          <h2>Memo-Ray is offline</h2>\n          <p>Boot the memory-graph server with <code>scripts/memoray.ps1</code>, then retry.</p>\n          <button type=\"button\" class=\"prime-silo-st__btn\" @click=\"retry()\">Retry</button>\n        </div>\n      </template>\n\n      <template x-if=\"state === 'error'\">\n        <div class=\"prime-silo-st__notice prime-silo-st__notice--error\">\n          <h2>Step-through failed to load</h2>\n          <p x-text=\"error\"></p>\n          <button type=\"button\" class=\"prime-silo-st__btn\" @click=\"retry()\">Retry</button>\n        </div>\n      </template>\n\n      <template x-if=\"state === 'loading'\">\n        <div class=\"prime-silo-st__notice\">\n          <p class=\"prime-silo-st__muted\">Loading timeline…</p>\n        </div>\n      </template>\n\n      <!-- Session picker (no ?session_id deep-link) -->\n      <template x-if=\"state === 'picking'\">\n        <div class=\"prime-silo-st__picker\">\n          <h2>Choose a session to step through</h2>\n          <div class=\"prime-silo-st__picker-list\">\n            <template x-for=\"s in sessions\" :key=\"s.id\">\n              <button type=\"button\" class=\"prime-silo-st__picker-item\" @click=\"pickSession(s.id)\">\n                <span class=\"prime-silo-st__picker-title\" x-text=\"s.content || 'Untitled'\"></span>\n                <span class=\"prime-silo-st__picker-sub\">\n                  <span x-text=\"s.agent\"></span> ·\n                  <span x-text=\"s.metadata && s.metadata.project ? s.metadata.project : '—'\"></span>\n                </span>\n              </button>\n            </template>\n            <p class=\"prime-silo-st__muted\" x-show=\"sessions.length === 0\">No sessions recorded.</p>\n          </div>\n        </div>\n      </template>\n\n      <template x-if=\"state === 'ready'\">\n  