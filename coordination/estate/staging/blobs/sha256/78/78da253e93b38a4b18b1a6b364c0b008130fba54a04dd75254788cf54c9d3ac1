\tfunction escapeHtml(text) {\n36\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n37\t}\n38\t\n39\t// Memo-Ray organic palette, by node type.\n40\tconst NODE_TYPE_COLORS = {\n41\t  Session: \"#c4a882\",\n42\t  \"User Input\": \"#c4a882\",\n43\t  Thought: \"#9caf88\",\n44\t  Message: \"#8a9aa4\",\n45\t  \"Tool Call\": \"#6b8068\",\n46\t  \"Tool Result\": \"#6b8068\",\n47\t  Artifact: \"#8a9aa4\",\n48\t  default: \"#6b7378\"\n49\t};\n50\t\n51\tconst BAND_WIDTH = 150;\n52\tconst BAND_GAP = 40;\n53\tconst ROW_GAP = 26;\n54\tconst NODE_RADIUS = 7;\n55\tconst ARTIFACT_W = 90;\n56\tconst ARTIFACT_H = 22;\n57\tconst TOP_PADDING = 30;\n58\tconst LEFT_PADDING = 24;\n59\tconst SVG_MIN_HEIGHT = 260;\n60\t\n61\tfunction ensureClient(options) {\n62\t  if (options && options.memorayClient) {\n63\t    return options.memorayClient;\n64\t  }\n65\t  return { memorayFetch, readMemorayJson };\n66\t}\n67\t\n68\tfunction colorFor(type) {\n69\t  return NODE_TYPE_COLORS[type] || NODE_TYPE_COLORS.default;\n70\t}\n71\t\n72\tfunction isArtifact(node) {\n73\t  return node && node.type === \"Artifact\";\n74\t}\n75\t\n76\tfunction nodeLabel(node) {\n77\t  if (!node) return \"(node)\";\n78\t  return node.label || node.metadata?.fileName || node.type || node.id || \"(node)\";\n79\t}\n80\t\n81\t/**\n82\t * Compute a depth-layered layout from {nodes, links}.\n83\t *\n84\t * Depth is the BFS distance from the root (the session node, or the node\n85\t * with no incoming link). Nodes at the same depth stack vertically. Returns\n86\t * { positions: {id: {x,y,node,depth}}, edges: [{source,target}], width,\n87\t * height }. Robust to cycles and orphan nodes (orphans land at depth 0).\n88\t */\n89\texport function computeLayout(nodes, links) {\n90\t  const safeNodes = Array.isArray(nodes) ? nodes : [];\n91\t  const safeLinks = Array.isArray(links) ? links : [];\n92\t  const byId = new Map(safeNodes.map((n) => [n.id, n]));\n93\t\n94\t  // Build adjacency + indegr