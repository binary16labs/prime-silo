  <input\n                          type=\"text\"\n                          value={form[key]}\n                          onChange={e => setForm({ ...form, [key]: e.target.value })}\n                          className=\"setup-input\"\n                          placeholder=\"Absolute directory path...\"\n                          style={{ flex: 1 }}\n                        />\n                        <button\n                          type=\"button\"\n                          onClick={() => handleOpenPath(form[key])}\n                          className=\"setup-open-btn\"\n                          disabled={!isOk}\n                          title=\"Open in File Explorer\"\n                        >\n                          📂 Open\n                        </button>\n                      </div>\n                    )}\n                  </div>\n\n                  {!isOk && (\n                    <div className=\"setup-troubleshoot-area\">\n                      <button\n                        type=\"button\"\n                        onClick={() => toggleTroubleshoot(key)}\n                        className=\"setup-troubleshoot-toggle\"\n                      >\n                        {showTroubleshoot[key] ? 'Hide Probing Info ▲' : 'Show Probing Info ▼'}\n                      </button>\n                      \n                      {showTroubleshoot[key] && (\n                        <div className=\"setup-troubleshoot-logs\">\n                          <p style={{ margin: '0 0 0.5rem 0', fontWeight: 'bold' }}>Paths checked during startup:</p>\n                          {info.probed.map((prob, i) => (\n                            <div key={i} className=\"setup-probed-item\">\n                              <span className={`probed-dot ${prob.exists ? 'found' : 'missing'}`} />\n                              <span className=\"probed-path\" title={prob.path}>{prob.path}</span>\n                              <span className=\"probed-result\">{prob.exists ? '(found)' : '(not found)'}</span>\n                            </div>\n                          ))}\n                        </div>\n                      )}\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n\n          {report && report.mem0ray && (\n            <div className=\"setup-field-card is-valid\" style={{ gridColumn: '1 / -1', background: 'rgba(255,255,255,0.02)', border: '1px dashed rgba(255,255,255,0.1)', marginTop: '1rem' }}>\n              <div className=\"setup-field-header\">\n                <label className=\"setup-field-label\">Mem0Ray System Storage</label>\n                <span className=\"setup-status-badge status-ok\">✓ Active</span>\n              </div>\n              <p className=\"setup-field-desc\">Internal settings configuration file and sync database directory for the Mem0Ray dashboard itself.</p>\n              \n              <div style={{ display: 'flex', flexDirection: 'column', gap: '0.75rem', marginTop: '0.75rem' }}>\n                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: 'rgba(255,255,255,0.02)', padding: '0.5rem 0.75rem', borderRadius: '6px' }}>\n                  <span style={{ fontSize: '0.85rem', opacity: 0.7, fontFamily: 'monospace' }}>Config: {report.mem0ray.configPath}</span>\n                  {report.mem0ray.configExists && (\n                    <button\n                      type=\"button\"\n                      onClick={() => handleOpenPath(report.mem0ray.configPath)}\n                      className=\"setup-open-btn\"\n                      style={{ padding: '4px 10px', fontSize: '0.8rem' }}\n                    >\n                      📂 Open File\n                    </button>\n                  )}\n                </div>\n                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', background: 'rgba(255,255,255,0.02)', padding: '0.5rem 0.75rem', borderRadius: '6px' }}>\n                  <span style={{ fontSize: '0.85rem', opacity: 0.7, fontFamily: 'monospace' }}>Database: {report.mem0ray.dataDir}</span>\n                  {report.mem0ray.dataExists && (\n                    <button\n                      type=\"button\"\n                      onClick={() => handleOpenPath(report.mem0ray.dataDir)}\n                      className=\"setup-open-btn\"\n                      style={{ padding: '4px 10px', fontSize: '0.8rem' }}\n                    >\n                      📂 Open Folder\n                    </button>\n                  )}\n                </div>\n              </div>\n            </div>\n          )}\n\n          <div className=\"setup-actions\">\n            <button\n              type=\"button\"\n              onClick={fetchStatus}\n              className=\"setup-btn-secondary\"\n              disabled={saving}\n            >\n              🔄 Rescan System\n            </button>\n            <button\n              type=\"submit\"\n              className=\"setup-btn-primary\"\n              disabled={saving}\n            >\n              {saving ? 'Launching...' : '🚀 Launch Mission Control'}\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n}\n","numLines":337,"startLine":1,"totalLines":337}},"sourceToolAssistantUUID":"ca0ea678-3c58-45d1-b281-020c4594eedc","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"2273c372-b009-4668-8ae4-e7ffd0aad7d6","version":"2.1.181","gitBranch":"HEAD"}
