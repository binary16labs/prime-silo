{"parentUuid":"008879cb-bcf6-4148-b598-4cbfacb76848","isSidechain":false,"promptId":"128a8bf8-833a-4aed-8bcc-ef8ac6432b14","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J55iNWBkoY9Gy7LAbiY95c","type":"tool_result","content":"1\t// Phase M1 — `memoray.overview_cards` widget.\n2\t//\n3\t// The Command Center: a vanilla port of memo-ray's OverviewGrid.jsx into the\n4\t// Phase C widget-factory contract. Renders ecosystem totals, system metrics,\n5\t// capabilities, worktrees, the file heatmap, and recent sessions from the\n6\t// Memo-Ray API (proxied through the shell at /api/memoray).\n7\t//\n8\t// Read-only — every call is a GET. By ADR-001 this lives in the review zone\n9\t// and is agent-safe.\n10\t//\n11\t// Public API\n12\t//   createOverviewCardsWidget(host, props, options)\n13\t//     props   — {\n14\t//       onSelectSession?: (sessionId) => void,\n15\t//       metricsIntervalMs?: number   // default 5000\n16\t//     }\n17\t//     options — { memorayClient?: { memorayFetch, readMemorayJson } }\n18\t//\n19\t// Returns { update, refresh, destroy }. destroy() clears the metrics\n20\t// interval and the visibilitychange listener — the exact lifecycle bug\n21\t// class we fixed in the React original (expensive si.processes() polling).\n22\t//\n23\t// Field contract note: the hot-files heatmap reads `fileName`/`filePath`\n24\t// (NOT `path`). This matches the declared contract in\n25\t// manifests/integrations/memoray.integration.json (beta_overview.hotFiles)\n26\t// — the integration audit's payload_contracts check guards this.\n27\t\n28\timport {\n29\t  memorayFetch,\n30\t  readMemorayJson,\n31\t  isMemorayOffline,\n32\t  isMemorayDisabled\n33\t} from \"../../../memoray_client/memoray-client.js\";\n34\t\n35\tconst HTML_ESCAPES = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" };\n36\t\n37\tfunction escapeHtml(text) {\n38\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n39\t}\n40\t\n41\tfunction basename(p) {\n42\t  return (\n43\t    String(p || \"\")\n44\t      .split(/[\\\\/]/)\n45\t      .pop() || \"\"\n46\t  );\n47\t}\n48\t\n49\tfunction formatBytes(bytes) {\n50\t  if (!bytes || bytes === 0) return \"0 B\";\n51\t  const k = 1024;\n52\t  const sizes = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\"];\n53\t  const i = Math.floor(Math.log(bytes) / Math.log(k));\n54\t  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;\n55\t}\n56\t\n57\tfunction ensureClient(options) {\n58\t  if (options && options.memorayClient) {\n59\t    return options.memorayClient;\n60\t  }\n61\t  return { memorayFetch, readMemorayJson };\n62\t}\n63\t\n64\tfunction deriveRecentSessions(overview) {\n65\t  if (!overview || !Array.isArray(overview.projects)) return [];\n66\t  let all = [];\n67\t  for (const project of overview.projects) {\n68\t    for (const agent of Object.values(project.agents || {})) {\n69\t      all = all.concat((agent.sessions || []).map((s) => ({ ...s, projectName: project.name })));\n70\t    }\n71\t  }\n72\t  return all.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0)).slice(0, 5);\n73\t}\n74\t\n75\t/* ── card renderers (string templates → innerHTML) ───────────────────── */\n76\t\n77\tfunction renderMetricsCard(metrics) {\n78\t  if (!metrics) {\n79\t    return cardShell(\"System resources\", `<div class=\"mray-oc__muted\">Loading sensors…</div>`);\n80\t  }\n81\t  const cpu = escapeHtml(metrics.cpu);\n82\t  const ramPct = escapeHtml(metrics.ram?.percent);\n83\t  const body = `\n84\t    <div class=\"mray-oc__meter\">\n85\t      <div class=\"mray-oc__meter-head\"><span>CPU load</span><span class=\"mray-oc__accent-sage\">${cpu}%</span></div>\n86\t      <div class=\"mray-oc__bar\"><div class=\"mray-oc__bar-fill mray-oc__fill-sage\" style=\"width:${cpu}%\"></div></div>\n87\t    </div>\n88\t    <div class=\"mray-oc__meter\">\n89\t      <div class=\"mray-oc__meter-head\"><span>Memory (RAM)</span><span class=\"mray-oc__accent-taupe\">${formatBytes(metrics.ram?.used)} / ${formatBytes(metrics.ram?.total)}</span></div>\n90\t      <div class=\"mray-oc__bar\"><div class=\"mray-oc__bar-fill mray-oc__fill-taupe\" style=\"width:${ramPct}%\"></div></div>\n91\t    </div>\n92\t    <div class=\"mray-oc__net\">\n93\t      <span>↓ RX <strong>${formatBytes(metrics.network?.rxSec)}/s</strong></span>\n94\t      <span>↑ TX <strong>${formatBytes(metrics.network?.txSec)}/s</strong></span>\n95\t    </div>`;\n96\t  return cardShell(\"System resources\", body);\n97\t}\n98\t\n99\tfunction renderProcessesCard(metrics) {\n100\t  if (!metrics || !Array.isArray(metrics.processes)) {\n101\t    return cardShell(\"Top processes\", `<div class=\"mray-oc__muted\">Loading process table…</div>`);\n102\t  }\n103\t  const rows = metrics.processes\n104\t    .map(\n105\t      (p) => `\n106\t    <div class=\"mray-oc__proc\">\n107\t      <span class=\"mray-oc__mono\">${escapeHtml(p.name)}</span>\n108\t      <span class=\"mray-oc__proc-stats\">${escapeHtml(p.cpu)}% · ${escapeHtml(p.mem)} MB</span>\n109\t    </div>`\n110\t    )\n111\t    .join(\"\");\n112\t  return cardShell(\"Top processes\", rows || `<div class=\"mray-oc__muted\">No processes.</div>`);\n113\t}\n114\t\n115\tfunction renderEcosystemCard(overview) {\n116\t  const body = `\n117\t    <div class=\"mray-oc__stat\"><span>Active worktrees</span><strong>${Number(overview.worktrees?.length || 0)}</strong></div>\n118\t    <div class=\"mray-oc__stat\"><span>Total sessions</span><strong>${Number(overview.totalSessions || 0)}</strong></div>\n119\t    <div class=\"mray-oc__stat\"><span>Total tokens</span><strong class=\"mray-oc__accent-golden\">${Number(overview.totalTokens || 0).toLocaleString()}</strong></div>`;\n120\t  return cardShell(\"Workspace ecosystem\", body);\n121\t}\n122\t\n123\tfunction renderCapabilitiesCard(caps) {\n124\t  if (!caps) {\n125\t    return wideCardShell(\n126\t      \"System capabilities\",\n127\t      `<div class=\"mray-oc__muted\">Scanning registries…</div>`\n128\t    );\n129\t  }\n130\t  const plugins =\n131\t    (caps.antigravity?.plugins || [])\n132\t      .map((p) => `<span class=\"mray-oc__chip\">${escapeHtml(p)}</span>`)\n133\t      .join(\"\") || `<span class=\"mray-oc__muted\">No custom plugins.</span>`;\n134\t  const mcp =\n135\t    (caps.claude?.mcpServers || [])\n136\t      .map(\n137\t        (m) => `\n138\t    <div class=\"mray-oc__chip mray-oc__chip--stack\">\n139\t      <strong>${escapeHtml(m.name)}</strong>\n140\t      <span class=\"mray-oc__mono mray-oc__chip-sub\">${escapeHtml(m.command)}</span>\n141\t    </div>`\n142\t      )\n143\t      .join(\"\") || `<span class=\"mray-oc__muted\">No MCP servers.</span>`;\n144\t  const perms =\n145\t    (caps.antigravity?.permissions || [])\n146\t      .map((perm) => {\n147\t        const isCmd = String(perm).startsWith(\"command\");\n148\t        const label = isCmd ? \"EXECUTE\" : \"READ/WRITE\";\n149\t        const value = String(perm).replace(/^(command|read_file|write_file)\\(|\\)$/g, \"\");\n150\t        return `<div class=\"mray-oc__chip mray-oc__chip--stack\"><span class=\"mray-oc__chip-tag\">${label}</span><span class=\"mray-oc__mono\">${escapeHtml(value)}</span></div>`;\n151\t      })\n152\t      .join(\"\") || `<span class=\"mray-oc__muted\">No global permissions.</span>`;\n153\t\n154\t  const body = `\n155\t    <div class=\"mray-oc__caps\">\n156\t      <div class=\"mray-oc__caps-col\"><h4 class=\"mray-oc__accent-slate\">Antigravity plugins</h4><div class=\"mray-oc__chips\">${plugins}</div></div>\n157\t      <div class=\"mray-oc__caps-col\"><h4 class=\"mray-oc__accent-golden\">Claude MCP servers</h4><div class=\"mray-oc__chips\">${mcp}</div></div>\n158\t      <div class=\"mray-oc__caps-col\"><h4 class=\"mray-oc__accent-rust\">Security scopes</h4><div class=\"mray-oc__chips\">${perms}</div></div>\n159\t    </div>`;\n160\t  return wideCardShell(\"System capabilities\", body);\n161\t}\n162\t\n163\tfunction renderWorktreesCard(overview) {\n164\t  const items =\n165\t    (overview.worktrees || [])\n166\t      .map(\n167\t        (wt) => `\n168\t    <div class=\"mray-oc__wt\">\n169\t      <div class=\"mray-oc__wt-branch\">${escapeHtml(wt.branch || \"(detached)\")}</div>\n170\t      <div class=\"mray-oc__wt-repo\">Repo: ${escapeHtml(basename(wt.baseRepo) || \"Unknown\")}</div>\n171\t      <div class=\"mray-oc__wt-meta\"><span>${wt.createdAt ? escapeHtml(new Date(wt.createdAt).toLocaleDateString()) : \"—\"}</span></div>\n172\t    </div>`\n173\t      )\n174\t      .join(\"\") || `<span class=\"mray-oc__muted\">No active isolated environments.</span>`;\n175\t  return cardShell(\n176\t    \"Active git worktrees\",\n177\t    `<div class=\"mray-oc__scroll\">${items}</div>`,\n178\t    \"mray-oc__card--span1\"\n179\t  );\n180\t}\n181\t\n182\tfunction renderHeatmapCard(overview) {\n183\t  const hot = Array.isArray(overview.hotFiles) ? overview.hotFiles.slice(0, 10) : [];\n184\t  if (hot.length === 0) {\n185\t    return cardShell(\n186\t      \"File memory heatmap\",\n187\t      `<span class=\"mray-oc__muted\">No file memory compiled yet.</span>`,\n188\t      \"mray-oc__card--span2\"\n189\t    );\n190\t  }\n191\t  const maxCount = overview.hotFiles[0].count || 1;\n192\t  const rows = hot\n193\t    .map((file, idx) => {\n194\t      const heatPct = (file.count / maxCount) * 100;\n195\t      const isClaude = String(file.agent || \"\").toLowerCase() === \"claude\";\n196\t      const label = basename(file.fileName || file.filePath) || \"Unknown file\";\n197\t      return `\n198\t      <div class=\"mray-oc__heat-row\">\n199\t        <span class=\"mray-oc__heat-rank\">#${idx + 1}</span>\n200\t        <div class=\"mray-oc__heat-bar\">\n201\t          <div class=\"mray-oc__heat-fill ${isClaude ? \"mray-oc__heat-fill--claude\" : \"mray-oc__heat-fill--anti\"}\" style=\"width:${heatPct}%\"></div>\n202\t          <span class=\"mray-oc__heat-label\" title=\"${escapeHtml(file.filePath || \"\")}\">${escapeHtml(label)}</span>\n203\t        </div>\n204\t        <span class=\"mray-oc__heat-count ${isClaude ? \"mray-oc__accent-golden\" : \"mray-oc__accent-slate\"}\">${Number(file.count)}×</span>\n205\t      </div>`;\n206\t    })\n207\t    .join(\"\");\n208\t  return cardShell(\"File memory heatmap\", rows, \"mray-oc__card--span2\");\n209\t}\n210\t\n211\tfunction renderRecentCard(overview) {\n212\t  const recent = deriveRecentSessions(overview);\n213\t  const rows =\n214\t    recent\n215\t      .map(\n216\t        (s) => `\n217\t    <button type=\"button\" class=\"mray-oc__session\" data-session-id=\"${escapeHtml(s.id)}\">\n218\t      <span class=\"mray-oc__session-main\">\n219\t        <span class=\"mray-oc__session-title\">${escapeHtml(s.title || \"Untitled session\")}</span>\n220\t        <span class=\"mray-oc__session-proj\">Project: ${escapeHtml(s.projectName || \"—\")}</span>\n221\t      </span>\n222\t      <span class=\"mray-oc__session-meta\">\n223\t        <span>${s.timestamp ? escapeHtml(new Date(s.timestamp).toLocaleString()) : \"—\"}</span>\n224\t        <span class=\"mray-oc__accent-golden\">${Number(s.nodes || 0)} steps</span>\n225\t      </span>\n226\t    </button>`\n227\t      )\n228\t      .join(\"\") || `<span class=\"mray-oc__muted\">No recent activity.</span>`;\n229\t  return cardShell(\"Recent agent activity\", rows, \"mray-oc__card--full\");\n230\t}\n231\t\n232\tfunction cardShell(title, body, extraClass = \"\") {\n233\t  return `<section class=\"mray-oc__card ${extraClass}\"><h3 class=\"mray-oc__card-title\">${escapeHtml(title)}</h3><div class=\"mray-oc__card-body\">${body}</div></section>`;\n234\t}\n235\t\n236\tfunction wideCardShell(title, body) {\n237\t  return cardShell(title, body, \"mray-oc__card--full\");\n238\t}\n239\t\n240\t/* ── factory ─────────────────────────────────────────────────────────── */\n241\t\n242\texport function createOverviewCardsWidget(host, initialProps = {}, options = {}) {\n243\t  if (!host || typeof host.querySelector !== \"function\") {\n244\t    throw new Error(\"createOverviewCardsWidget: host must be an HTMLElement.\");\n245\t  }\n246\t\n247\t  const client = ensureClient(options);\n248\t  let props = { metricsIntervalMs: 5000, ...initialProps };\n249\t  let aborted = false;\n250\t  let overview = null;\n251\t  let capabilities = null;\n252\t  let metrics = null;\n253\t  let metricsTimer = null;\n254\t\n255\t  host.classList.add(\"mray-oc\");\n256\t\n257\t  function renderState(stateHtml) {\n258\t    host.innerHTML = `<div class=\"mray-oc__state\">${stateHtml}</div>`;\n259\t  }\n260\t\n261\t  function renderCards() {\n262\t    if (aborted) return;\n263\t    host.innerHTML = `\n264\t      <div class=\"mray-oc__grid\">\n265\t        ${renderMetricsCard(metrics)}\n266\t        ${renderProcessesCard(metrics)}\n267\t        ${renderEcosystemCard(overview)}\n268\t        ${renderCapabilitiesCard(capabilities)}\n269\t        ${renderWorktreesCard(overview)}\n270\t        ${renderHeatmapCard(overview)}\n271\t        ${renderRecentCard(overview)}\n272\t      </div>`;\n273\t    wireSessionClicks();\n274\t  }\n275\t\n276\t  function wireSessionClicks() {\n277\t    if (typeof props.onSelectSession !== \"function\") return;\n278\t    host.querySelectorAll(\"[data-session-id]\").forEach((el) => {\n279\t      el.addEventListener(\"click\", () => props.onSelectSession(el.getAttribute(\"data-session-id\")));\n280\t    });\n281\t  }\n282\t\n283\t  async function loadStatic() {\n284\t    renderState(`<p class=\"mray-oc__loading\">Initializing Command Center…</p>`);\n285\t    try {\n286\t      const [ov, caps] = await Promise.all([\n287\t        client.readMemorayJson(await client.memorayFetch(\"/beta/overview\")),\n288\t        client.readMemorayJson(await client.memorayFetch(\"/system/capabilities\")).catch(() => null)\n289\t      ]);\n290\t      if (aborted) return;\n291\t      overview = ov;\n292\t      capabilities = caps;\n293\t      renderCards();\n294\t    } catch (err) {\n295\t      if (aborted) return;\n296\t      if (isMemorayDisabled(err)) {\n297\t        renderState(\n298\t          `<p class=\"mray-oc__offline\">Memo-Ray is disabled. Enable it in the configuration wizard or with <code>node space set MEMORAY_ENABLED=true</code>.</p>`\n299\t        );\n300\t      } else if (isMemorayOffline(err)) {\n301\t        renderState(\n302\t          `<p class=\"mray-oc__offline\">Memo-Ray is offline. Boot it with <code>scripts/memoray.ps1</code> and refresh.</p>`\n303\t        );\n304\t      } else {\n305\t        renderState(\n306\t          `<p class=\"mray-oc__error\">Command Center failed to load: ${escapeHtml(err.message)}</p>`\n307\t        );\n308\t      }\n309\t    }\n310\t  }\n311\t\n312\t  async function pollMetrics() {\n313\t    if (aborted || (typeof document !== \"undefined\" && document.visibilityState === \"hidden\"))\n314\t      return;\n315\t    try {\n316\t      const next = await client.readMemorayJson(await client.memorayFetch(\"/system/metrics\"));\n317\t      if (aborted) return;\n318\t      metrics = next;\n319\t      // Re-render only the two metric cards if cards are already mounted.\n320\t      const grid = host.querySelector(\".mray-oc__grid\");\n321\t      if (grid) {\n322\t        const cards = grid.querySelectorAll(\".mray-oc__card\");\n323\t        if (cards[0]) cards[0].outerHTML = renderMetricsCard(metrics);\n324\t        const refreshed = host.querySelectorAll(\".mray-oc__card\");\n325\t        if (refreshed[1]) refreshed[1].outerHTML = renderProcessesCard(metrics);\n326\t      }\n327\t    } catch {\n328\t      // Metrics are best-effort; ignore transient failures so the static\n329\t      // cards stay up. A hard outage surfaces via loadStatic().\n330\t    }\n331\t  }\n332\t\n333\t  function startMetricsPolling() {\n334\t    pollMetrics();\n335\t    metricsTimer = setInterval(\n336\t      pollMetrics,\n337\t      Math.max(2000, Number(props.metricsIntervalMs) || 5000)\n338\t    );\n339\t    if (typeof document !== \"undefined\") {\n340\t      document.addEventListener(\"visibilitychange\", pollMetrics);\n341\t    }\n342\t  }\n343\t\n344\t  function update(nextProps) {\n345\t    props = { ...props, ...nextProps };\n346\t    if (overview) renderCards();\n347\t  }\n348\t\n349\t  function refresh() {\n350\t    return loadStatic();\n351\t  }\n352\t\n353\t  function destroy() {\n354\t    aborted = true;\n355\t    if (metricsTimer) clearInterval(metricsTimer);\n356\t    metricsTimer = null;\n357\t    if (typeof document !== \"undefined\") {\n358\t      document.removeEventListener(\"visibilitychange\", pollMetrics);\n359\t    }\n360\t    host.classList.remove(\"mray-oc\");\n361\t    host.innerHTML = \"\";\n362\t  }\n363\t\n364\t  loadStatic().then(() => {\n365\t    if (!aborted) startMetricsPolling();\n366\t  });\n367\t\n368\t  return {\n369\t    update,\n370\t    refresh,\n371\t    destroy,\n372\t    get overview() {\n373\t      return overview;\n374\t    }\n375\t  };\n376\t}\n377\t\n378\texport const __testing = {\n379\t  deriveRecentSessions,\n380\t  renderHeatmapCard,\n381\t  renderCapabilitiesCard,\n382\t  formatBytes,\n383\t  basename\n384\t};\n385\t"}]},"uuid":"a0659555-cce4-430b-a89a-29888d99b1db","timestamp":"2026-06-27T06:49:08.953Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\app\\L0\\_all\\mod\\_prime_silo\\widgets\\memoray\\overview_cards\\index.js","content":"// Phase M1 — `memoray.overview_cards` widget.\n//\n// The Command Center: a vanilla port of memo-ray's OverviewGrid.jsx into the\n// Phase C widget-factory contract. Renders ecosystem totals, system metrics,\n// capabilities, worktrees, the file heatmap, and recent sessions from the\n// Memo-Ray API (proxied through the shell at /api/memoray).\n//\n// Read-only — every call is a GET. By ADR-001 this lives in the review zone\n// and is agent-safe.\n//\n// Public API\n//   createOverviewCardsWidget(host, props, options)\n//     props   — {\n//       onSelectSession?: (sessionId) => void,\n//       metricsIntervalMs?: number   // default 5000\n//     }\n//     options — { memorayClient?: { memorayFetch, readMemorayJson } }\n//\n// Returns { update, refresh, destroy }. destroy() clears the metrics\n// interval and the visibilitychange listener — the exact lifecycle bug\n// class we fixed in the React original (expensive si.processes() polling).\n//\n// Field contract note: the hot-files heatmap reads `fileName`/`filePath`\n// (NOT `path`). This matches the declared contract in\n// manifests/integrations/memoray.integration.json (beta_overview.hotFiles)\n// — the integration audit's payload_contracts check guards this.\n\nimport {\n  memorayFetch,\n  readMemorayJson,\n  isMemorayOffline,\n  isMemorayDisabled\n} from \"../../../memoray_client/memoray-client.js\";\n\nconst HTML_ESCAPES = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" };\n\nfunction escapeHtml(text) {\n  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n}\n\nfunction basename(p) {\n  return (\n    String(p || \"\")\n      .split(/[\\\\/]/)\n      .pop() || \"\"\n  );\n}\n\nfunction formatBytes(bytes) {\n  if (!bytes || bytes === 0) return \"0 B\";\n  const k = 1024;\n  const sizes = [\"B\", \"KB\", \"MB\", \"GB\", \"TB\"];\n  const i = Math.floor(Math.log(bytes) / Math.log(k));\n  return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;\n}\n\nfunction ensureClient(options) {\n  if (options && options.memorayClient) {\n    return options.memorayClient;\n  }\n  return { memorayFetch, readMemorayJson };\n}\n\nfunction deriveRecentSessions(overview) {\n  if (!overview || !Array.isArray(overview.projects)) return [];\n  let all = [];\n  for (const project of overview.projects) {\n    for (const agent of Object.values(project.agents || {})) {\n      all = all.concat((agent.sessions || []).map((s) => ({ ...s, projectName: project.name })));\n    }\n  }\n  return all.sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0)).slice(0, 5);\n}\n\n/* ── card renderers (string templates → innerHTML) ───────────────────── */\n\nfunction renderMetricsCard(metrics) {\n  if (!metrics) {\n    return cardShell(\"System resources\", `<div class=\"mray-oc__muted\">Loading sensors…</div>`);\n  }\n  const cpu = escapeHtml(metrics.cpu);\n  const ramPct = escapeHtml(metrics.ram?.percent);\n  const body = `\n    <div class=\"mray-oc__meter\">\n      <div class=\"mray-oc__meter-head\"><span>CPU load</span><span class=\"mray-oc__accent-sage\">${cpu}%</span></div>\n      <div class=\"mray-oc__bar\"><div class=\"mray-oc__bar-fill mray-oc__fill-sage\" style=\"width:${cpu}%\"></div></div>\n    </div>\n    <div class=\"mray-oc__meter\">\n      <div class=\"mray-oc__meter-head\"><span>Memory (RAM)</span><span class=\"mray-oc__accent-taupe\">${formatBytes(metrics.ram?.used)} / ${formatBytes(metrics.ram?.total)}</span></div>\n      <div class=\"mray-oc__bar\"><div class=\"mray-oc__bar-fill mray-oc__fill-taupe\" style=\"width:${ramPct}%\"></div></div>\n    </div>\n    <div class=\"mray-oc__net\">\n      <span>↓ RX <strong>${formatBytes(metrics.network?.rxSec)}/s</strong></span>\n      <span>↑ TX <strong>${formatBytes(metrics.network?.txSec)}/s</strong></span>\n    </div>`;\n  return cardShell(\"System resources\", body);\n}\n\nfunction renderProcessesCard(metrics) {\n  if (!metrics || !Array.isArray(metrics.processes)) {\n    return cardShell(\"Top processes\", `<div class=\"mray-oc__muted\">Loading process table…</div>`);\n  }\n  const rows = metrics.processes\n    .map(\n      (p) => `\n    <div class=\"mray-oc__proc\">\n      <span class=\"mray-oc__mono\">${escapeHtml(p.name)}</span>\n      <span class=\"mray-oc__proc-stats\">${escapeHtml(p.cpu)}% · ${escapeHtml(p.mem)} MB</span>\n    </div>`\n    )\n    .join(\"\");\n  return cardShell(\"Top processes\", rows || `<div class=\"mray-oc__muted\">No processes.</div>`);\n}\n\nfunction renderEcosystemCard(overview) {\n  const body = `\n    <div class=\"mray-oc__stat\"><span>Active worktrees</span><strong>${Number(overview.worktrees?.length || 0)}</strong></div>\n    <div class=\"mray-oc__stat\"><span>Total sessions</span><strong>${Number(overview.totalSessions || 0)}</strong></div>\n    <div class=\"mray-oc__stat\"><span>Total tokens</span><strong class=\"mray-oc__accent-golden\">${Number(overview.totalTokens || 0).toLocaleString()}</strong></div>`;\n  return cardShell(\"Workspace ecosystem\", body);\n}\n\nfunction renderCapabilitiesCard(caps) {\n  if (!caps) {\n    return wideCardShell(\n      \"System capabilities\",\n      `<div class=\"mray-oc__muted\">Scanning registries…</div>`\n    );\n  }\n  const plugins =\n    (caps.antigravity?.plugins || [])\n      .map((p) => `<span class=\"mray-oc__chip\">${escapeHtml(p)}</span>`)\n      .join(\"\") || `<span class=\"mray-oc__muted\">No custom plugins.</span>`;\n  const mcp =\n    (caps.claude?.mcpServers || [])\n      .map(\n        (m) => `\n    <div class=\"mray-oc__chip mray-oc__chip--stack\">\n      <strong>${escapeHtml(m.name)}</strong>\n      <span class=\"mray-oc__mono mray-oc__chip-sub\">${escapeHtml(m.command)}</span>\n    </div>`\n      )\n      .join(\"\") || `<span class=\"mray-oc__muted\">No MCP servers.</span>`;\n  const perms =\n    (caps.antigravity?.permissions || [])\n      .map((perm) => {\n        const isCmd = String(perm).startsWith(\"command\");\n        const label = isCmd ? \"EXECUTE\" : \"READ/WRITE\";\n        const value = String(perm).replace(/^(command|read_file|write_file)\\(|\\)$/g, \"\");\n        return `<div class=\"mray-oc__chip mray-oc__chip--stack\"><span class=\"mray-oc__chip-tag\">${label}</span><span class=\"mray-oc__mono\">${escapeHtml(value)}</span></div>`;\n      })\n      .join(\"\") || `<span class=\"mray-oc__muted\">No global permissions.</span>`;\n\n  const body = `\n    <div class=\"mray-oc__caps\">\n      <div class=\"mray-oc__caps-col\"><h4 class=\"mray-oc__accent-slate\">Antigravity plugins</h4><div class=\"mray-oc__chips\">${plugins}</div></div>\n      <div class=\"mray-oc__caps-col\"><h4 class=\"mray-oc__accent-golden\">Claude MCP servers</h4><div class=\"mray-oc__chips\">${mcp}</div></div>\n      <div class=\"mray-oc__caps-col\"><h4 class=\"mray-oc__accent-rust\">Security scopes</h4><div class=\"mray-oc__chips\">${perms}</div></div>\n    </div>`;\n  return wideCardShell(\"System capabilities\", body);\n}\n\nfunction renderWorktreesCard(overview) {\n  const items =\n    (overview.worktrees || [])\n      .map(\n        (wt) => `\n    <div class=\"mray-oc__wt\">\n      <div class=\"mray-oc__wt-branch\">${escapeHtml(wt.branch || \"(detached)\")}</div>\n      <div class=\"mray-oc__wt-repo\">Repo: ${escapeHtml(basename(wt.baseRepo) || \"Unknown\")}</div>\n      <div class=\"mray-oc__wt-meta\"><span>${wt.createdAt ? escapeHtml(new Date(wt.createdAt).toLocaleDateString()) : \"—\"}</span></div>\n    </div>`\n      )\n      .join(\"\") || `<span class=\"mray-oc__muted\">No active isolated environments.</span>`;\n  return cardShell(\n    \"Active git worktrees\",\n    `<div class=\"mray-oc__scroll\">${items}</div>`,\n    \"mray-oc__card--span1\"\n  );\n}\n\nfunction renderHeatmapCard(overview) {\n  const hot = Array.isArray(overview.hotFiles) ? overview.hotFiles.slice(0, 10) : [];\n  if (hot.length === 0) {\n    return cardShell(\n      \"File memory heatmap\",\n      `<span class=\"mray-oc__muted\">No file memory compiled yet.</span>`,\n      \"mray-oc__card--span2\"\n    );\n  }\n  const maxCount = overview.hotFiles[0].count || 1;\n  const rows = hot\n    .map((file, idx) => {\n      const heatPct = (file.count / maxCount) * 100;\n      const isClaude = String(file.agent || \"\").toLowerCase() === \"claude\";\n      const label = basename(file.fileName || file.filePath) || \"Unknown file\";\n      return `\n      <div class=\"mray-oc__heat-row\">\n        <span class=\"mray-oc__heat-rank\">#${idx + 1}</span>\n        <div class=\"mray-oc__heat-bar\">\n          <div class=\"mray-oc__heat-fill ${isClaude ? \"mray-oc__heat-fill--claude\" : \"mray-oc__heat-fill--anti\"}\" style=\"width:${heatPct}%\"></div>\n          <span class=\"mray-oc__heat-label\" title=\"${escapeHtml(file.filePath || \"\")}\">${escapeHtml(label)}</span>\n        </div>\n        <span class=\"mray-oc__heat-count ${isClaude ? \"mray-oc__accent-golden\" : \"mray-oc__accent-slate\"}\">${Number(file.count)}×</span>\n      </div>`;\n    })\n    .join(\"\");\n  return cardShell(\"File memory heatmap\", rows, \"mray-oc__card--span2\");\n}\n\nfunction renderRecentCard(overview) {\n  const recent = deriveRecentSessions(overview);\n  const rows =\n    recent\n      .map(\n        (s) => `\n    <button type=\"button\" class=\"mray-oc__session\" data-session-id=\"${escapeHtml(s.id)}\">\n      <span class=\"mray-oc__session-main\">\n        <span class=\"mray-oc__session-title\">${escapeHtml(s.title || \"Untitled session\")}</span>\n        <span class=\"mray-oc__session-proj\">Project: ${escapeHtml(s.projectName || \"—\")}</span>\n      </span>\n      <span class=\"mray-oc__session-meta\">\n        <span>${s.timestamp ? escapeHtml(new Date(s.timestamp).toLocaleString()) : \"—\"}</span>\n        <span class=\"mray-oc__accent-golden\">${Number(s.nodes || 0)} steps</span>\n      </span>\n    </button>`\n      )\n      .join(\"\") || `<span class=\"mray-oc__muted\">No recent activity.</span>`;\n  return cardShell(\"Recent agent activity\", rows, \"mray-oc__card--full\");\n}\n\nfunction cardShell(title, body, extraClass = \"\") {\n  return `<section class=\"mray-oc__card ${extraClass}\"><h3 class=\"mray-oc__card-title\">${escapeHtml(title)}</h3><div class=\"mray-oc__card-body\">${body}</div></section>`;\n}\n\nfunction wideCardShell(title, body) {\n  return cardShell(title, body, \"mray-oc__card--full\");\n}\n\n/* ── factory ─────────────────────────────────────────────────────────── */\n\nexport function createOverviewCardsWidget(host, initialProps = {}, options = {}) {\n  if (!host || typeof host.querySelector !== \"function\") {\n    throw new Error(\"createOverviewCardsWidget: host must be an HTMLElement.\");\n  }\n\n  const client = ensureClient(options);\n  let props = { metricsIntervalMs: 5000, ...initialProps };\n  let aborted = false;\n  let overview = null;\n  let capabilities = null;\n  let metrics = null;\n  let metricsTimer = null;\n\n  host.classList.add(\"mray-oc\");\n\n  function renderState(stateHtml) {\n    host.innerHTML = `<div class=\"mray-oc__state\">${stateHtml}</div>`;\n  }\n\n  function renderCards() {\n    if (aborted) return;\n    host.innerHTML = `\n      <div class=\"mray-oc__grid\">\n        ${renderMetricsCard(metrics)}\n        ${renderProcessesCard(metrics)}\n        ${renderEcosystemCard(overview)}\n        ${renderCapabilitiesCard(capabilities)}\n        ${renderWorktreesCard(overview)}\n        ${renderHeatmapCard(overview)}\n        ${renderRecentCard(overview)}\n      </div>`;\n    wireSessionClicks();\n  }\n\n  function wireSessionClicks() {\n    if (typeof props.onSelectSession !== \"function\") return;\n    host.querySelectorAll(\"[data-session-id]\").forEach((el) => {\n      el.addEventListener(\"click\", () => props.onSelectSession(el.getAttribute(\"data-session-id\")));\n    });\n  }\n\n  async function loadStatic() {\n    renderState(`<p class=\"mray-oc__loading\">Initializing Command Center…</p>`);\n    try {\n      const [ov, caps] = await Promise.all([\n        client.readMemorayJson(await client.memorayFetch(\"/beta/overview\")),\n        client.readMemorayJson(await client.memorayFetch(\"/system/capabilities\")).catch(() => null)\n      ]);\n      if (aborted) return;\n      overview = ov;\n      capabilities = caps;\n      renderCards();\n    } catch (err) {\n      if (aborted) return;\n      if (isMemorayDisabled(err)) {\n        renderState(\n          `<p class=\"mray-oc__offline\">Memo-Ray is disabled. Enable it in the configuration wizard or with <code>node space set MEMORAY_ENABLED=true</code>.</p>`\n        );\n      } else if (isMemorayOffline(err)) {\n        renderState(\n          `<p class=\"mray-oc__offline\">Memo-Ray is offline. Boot it with <code>scripts/memoray.ps1</code> and refresh.</p>`\n        );\n      } else {\n        renderState(\n          `<p class=\"mray-oc__error\">Command Center failed to load: ${escapeHtml(err.message)}</p>`\n        );\n      }\n    }\n  }\n\n  async function pollMetrics() {\n    if (aborted || (typeof document !== \"undefined\" && document.visibilityState === \"hidden\"))\n      return;\n    try {\n      const next = await client.readMemorayJson(await client.memorayFetch(\"/system/metrics\"));\n      if (aborted) return;\n      metrics = next;\n      // Re-render only the two metric cards if cards are already mounted.\n      const grid = host.querySelector(\".mray-oc__grid\");\n      if (grid) {\n        const cards = grid.querySelectorAll(\".mray-oc__card\");\n        if (cards[0]) cards[0].outerHTML = renderMetricsCard(metrics);\n        const refreshed = host.querySelectorAll(\".mray-oc__card\");\n        if (refreshed[1]) refreshed[1].outerHTML = renderProcessesCard(metrics);\n      }\n    } catch {\n      // Metrics are best-effort; ignore transient failures so the static\n      // cards stay up. A hard outage surfaces via loadStatic().\n    }\n  }\n\n  function startMetricsPolling() {\n    pollMetrics();\n    metricsTimer = setInterval(\n      pollMetrics,\n      Math.max(2000, Number(props.metricsIntervalMs) || 5000)\n    );\n    if (typeof document !== \"undefined\") {\n      document.addEventListener(\"visibilitychange\", pollMetrics);\n    }\n  }\n\n  function update(nextProps) {\n    props = { ...props, ...nextProps };\n    if (overview) renderCards();\n  }\n\n  function refresh() {\n    return loadStatic();\n  }\n\n  function destroy() {\n    aborted = true;\n    if (metricsTimer) clearInterval(metricsTimer);\n    metricsTimer = null;\n    if (typeof document !== \"undefined\") {\n      document.removeEventListener(\"visibilitychange\", pollMetrics);\n    }\n    host.classList.remove(\"mray-oc\");\n    host.innerHTML = \"\";\n  }\n\n  loadStatic().then(() => {\n    if (!aborted) startMetricsPolling();\n  });\n\n  return {\n    update,\n    refresh,\n    destroy,\n    get overview() {\n      return overview;\n    }\n  };\n}\n\nexport const __testing = {\n  deriveRecentSessions,\n  renderHeatmapCard,\n  renderCapabilitiesCard,\n  formatBytes,\n  basename\n};\n","numLines":385,"startLine":1,"totalLines":385}},"sourceToolAssistantUUID":"008879cb-bcf6-4148-b598-4cbfacb76848","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"2273c372-b009-4668-8ae4-e7ffd0aad7d6","version":"2.1.181","gitBranch":"HEAD"}
