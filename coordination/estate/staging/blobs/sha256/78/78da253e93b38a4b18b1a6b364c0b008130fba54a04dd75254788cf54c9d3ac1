docker\"));\n42\t}\n43\t\n44\t// ── opencode serve ──────────────────────────────────────────────────────────\n45\tlet opencodeProc = null;\n46\t\n47\tfunction startOpencodeServe() {\n48\t  if (!opencodeAvailable()) return false;\n49\t  if (opencodeProc && !opencodeProc.killed) return true;\n50\t  try {\n51\t    opencodeProc = spawn(\"opencode\", [\"serve\", \"--port\", String(OPENCODE_SERVE_PORT)], {\n52\t      detached: false,\n53\t      stdio: \"ignore\"\n54\t    });\n55\t    opencodeProc.on(\"exit\", () => {\n56\t      opencodeProc = null;\n57\t    });\n58\t    opencodeProc.on(\"error\", (e) => {\n59\t      console.error(\"[OpenStudio] opencode serve failed:\", e.message);\n60\t      opencodeProc = null;\n61\t    });\n62\t    return true;\n63\t  } catch (e) {\n64\t    console.error(\"[OpenStudio] opencode serve error:\", e.message);\n65\t    return false;\n66\t  }\n67\t}\n68\t\n69\tfunction stopOpencodeServe() {\n70\t  if (opencodeProc && !opencodeProc.killed) {\n71\t    try {\n72\t      opencodeProc.kill();\n73\t    } catch {\n74\t      /* ignore */\n75\t    }\n76\t  }\n77\t  opencodeProc = null;\n78\t}\n79\t\n80\tfunction isOpencodeServeRunning() {\n81\t  return Boolean(opencodeProc && !opencodeProc.killed);\n82\t}\n83\t\n84\t// ── open-notebook (docker compose) ──────────────────────────────────────────\n85\t// The compose file lives outside this repo (the operator's machine). We persist\n86\t// its path via the desktop config patch passed in. A per-install encryption key\n87\t// is generated once and exported into the child env so the compose no longer\n88\t// needs the hardcoded `OPEN_NOTEBOOK_ENCRYPTION_KEY=benny`.\n89\t\n90\tfunction ensureEncryptionKey(readConfig, writeConfigPatch) {\n91\t  const cfg = readConfig() || {};\n92\t  if (cfg.openNotebookEncryptionKey) return cfg.openNotebookEncryptionKey;\n93\t  const key = crypto.randomBytes(24).toString(\"base64url\");\n94\t  writeConfigPatch({ openNotebookEncryptionKey: key });\n95\t  return key;\n96\t}\n9