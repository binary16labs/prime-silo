ds.has(d)) bands.set(d, []);\n147\t    bands.get(d).push(n);\n148\t  }\n149\t\n150\t  const positions = {};\n151\t  let maxRows = 0;\n152\t  for (const [d, bucket] of bands) {\n153\t    bucket.sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));\n154\t    if (bucket.length > maxRows) maxRows = bucket.length;\n155\t    bucket.forEach((node, row) => {\n156\t      positions[node.id] = {\n157\t        x: LEFT_PADDING + d * (BAND_WIDTH + BAND_GAP),\n158\t        y: TOP_PADDING + row * ROW_GAP,\n159\t        depth: d,\n160\t        node\n161\t      };\n162\t    });\n163\t  }\n164\t\n165\t  const edges = [];\n166\t  for (const link of safeLinks) {\n167\t    const source = typeof link.source === \"object\" ? link.source.id : link.source;\n168\t    const target = typeof link.target === \"object\" ? link.target.id : link.target;\n169\t    if (positions[source] && positions[target]) {\n170\t      edges.push({ source, target });\n171\t    }\n172\t  }\n173\t\n174\t  const maxDepth = bands.size > 0 ? Math.max(...bands.keys()) : 0;\n175\t  const width = LEFT_PADDING * 2 + (maxDepth + 1) * (BAND_WIDTH + BAND_GAP);\n176\t  const height = Math.max(SVG_MIN_HEIGHT, TOP_PADDING * 2 + maxRows * ROW_GAP);\n177\t\n178\t  return { positions, edges, width, height };\n179\t}\n180\t\n181\t/* ── default 2D SVG renderer ─────────────────────────────────────────── */\n182\t\n183\tfunction createDefaultRenderer() {\n184\t  let svg = null;\n185\t  let onSelect = null;\n186\t\n187\t  function mount(hostEl, layout, props) {\n188\t    onSelect = props && props.onSelect;\n189\t    svg = document.createElementNS(SVG_NS, \"svg\");\n190\t    svg.setAttribute(\"class\", \"mray-lg__svg\");\n191\t    hostEl.appendChild(svg);\n192\t    update(layout, props);\n193\t    return { update, dispose };\n194\t  }\n195\t\n196\t  function update(layout, props) {\n197\t    if (!svg) return;\n198\t    onSelect = (props && props.onSelect) || onSelect;\n199\t    const { positions, edges, width, height } = layout;\n200\t    svg.setAttribute(\"viewBox\", `0 0 ${width} ${height}`);\n201\t    svg.setAttribute(\"width\", String(width));\n202\t    svg.setAttribute(\"height\", String(height));\n203\t    while (svg.firstChild) svg.removeChild(svg.firstChild);\n204\t\n205\t    // edges first (under nodes)\n206\t    for (const edge of edges) {\n207\t      const a = positions[edge.source];\n208\t      const b = positions[edge.target];\n209\t      if (!a || !b) continue;\n210\t      const line = document.createElementNS(SVG_NS, \"line\");\n211\t      line.setAttribute(\"x1\", String(a.x));\n212\t      line.setAttribute(\"y1\", String(a.y));\n213\t      line.setAttribute(\"x2\", String(b.x));\n214\t      line.setAttribute(\"y2\", String(b.y));\n215\t      line.setAttribute(\"class\", \"mray-lg__edge\");\n216\t      svg.appendChild(line);\n217\t    }\n218\t\n219\t    // nodes\n220\t    for (const pos of Object.values(positions)) {\n221\t      const node = pos.node;\n222\t      const color = colorFor(node.type);\n223\t      const group = document.createElementNS(SVG_NS, \"g\");\n224\t      group.setAttribute(\"class\", \"mray-lg__node\");\n225\t      group.setAttribute(\"tabindex\", \"0\");\n226\t      group.setAttribute(\"role\", \"button\");\n227\t      group.dataset.nodeId = node.id;\n228\t      group.setAttribute(\"aria-label\", `${node.type}: ${nodeLabel(node)}`);\n229\t\n230\t      if (isArtifact(node)) {\n231\t        const rect = document.createElementNS(SVG_NS, \"rect\");\n232\t        rect.setAttribute(\"x\", String(pos.x - ARTIFACT_W / 2));\n233\t        rect.setAttribute(\"y\", String(pos.y - ARTIFACT_H / 2));\n234\t        rect.setAttribute(\"width\", String(ARTIFACT_W));\n235\t        rect.setAttribute(\"height\", String(ARTIFACT_H));\n236\t        rect.setAttribute(\"rx\", \"5\");\n237\t        rect.setAttribute(\"fill\", color);\n238\t        rect.setAttribute(\"fill-opacity\", node.metadata?.isVirtual ? \"0.35\" : \"0.7\");\n239\t        rect.setAttribute(\"stroke\", color);\n2