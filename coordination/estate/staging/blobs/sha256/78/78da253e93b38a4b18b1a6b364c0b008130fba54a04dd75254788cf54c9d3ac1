{"parentUuid":"52e22ce7-f341-457e-97f7-7f6191882430","isSidechain":false,"promptId":"093b6b1c-7c7d-4d6e-9baa-ca668b0b9695","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Xpe8LJcLy6TemqdNSTtdWf","type":"tool_result","content":"1\t// Phase M1 — Memo-Ray memory-graph proxy.\n2\t//\n3\t// Forwards /api/memoray/<path> requests from the space-agent shell to the\n4\t// Memo-Ray Express server (default http://127.0.0.1:3030). Memo-Ray is the\n5\t// memory graph of the cognitive mesh — the third first-class graph beside\n6\t// the knowledge graph (documents) and code graph (AST). The shell page,\n7\t// the onscreen-agent `memory-recall` skill, and the `node space memory`\n8\t// CLI all consume Memo-Ray through this one chokepoint, so the endpoint\n9\t// is configurable in exactly one place.\n10\t//\n11\t// The integration is declared in manifests/integrations/memoray.integration.json\n12\t// (schema aamp.integration/1); this module is the `shell_proxy` node of that\n13\t// manifest's process map. Drift between this file and the manifest is a\n14\t// conformance finding (`GET /api/integration_audit`).\n15\t//\n16\t// The proxy:\n17\t//   • Strips the /api/memoray prefix: /api/memoray/beta/overview\n18\t//     → <base>/api/beta/overview.\n19\t//   • Whitelists methods: GET on any path, POST only on /files/open\n20\t//     (Memo-Ray validates open targets against its indexed lineage\n21\t//     server-side — paths outside the memory graph get a 403 upstream).\n22\t//     Everything else → 405.\n23\t//   • Returns 404 {error:\"memoray_disabled\"} when MEMORAY_ENABLED is off,\n24\t//     502 {error:\"memoray_unreachable\"} with a boot hint when the upstream\n25\t//     is down — the page renders both as friendly first-class screens.\n26\t//   • Server-to-server fetch carries no Origin header, so Memo-Ray's\n27\t//     localhost-only CORS policy never applies; browser callers stay on\n28\t//     the shell origin.\n29\t//\n30\t// Configuration resolution per key (most specific wins):\n31\t//   1. Runtime params MEMORAY_ENABLED / MEMORAY_BASE_URL when set by a\n32\t//      launch arg, stored .env value, or process env (commands/params.yaml\n33\t//      owns the schema; `node space get/set MEMORAY_BASE_URL` manages it).\n34\t//   2. The wizard manifest prime-silo.config.json `memoray` block.\n35\t//   3. The app-registry lockfile (apps.lock.json) — the port the resolver\n36\t//      assigned memo-ray on this machine, so a port change propagates without\n37\t//      touching prime-silo config.\n38\t//   4. Defaults: enabled, http://127.0.0.1:3030.\n39\t\n40\timport fs from \"node:fs/promises\";\n41\timport fsSync from \"node:fs\";\n42\timport path from \"node:path\";\n43\t\n44\timport { lockServiceUrl } from \"./registry_lock.js\";\n45\timport { buildUpstreamHeaders, forwardToUpstream } from \"./service_proxy.js\";\n46\t\n47\tconst MEMORAY_PATH_PREFIX = \"/api/memoray\";\n48\t\n49\tconst DEFAULT_MEMORAY_BASE_URL = \"http://127.0.0.1:3030\";\n50\tconst DEFAULT_MEMORAY_ENABLED = true;\n51\t\n52\tconst CONFIG_MANIFEST_FILENAME = \"prime-silo.config.json\";\n53\t\n54\t// Memo-Ray's only mutating endpoint the shell is allowed to reach. Opening\n55\t// a file is lineage-validated upstream; nothing else may POST through.\n56\tconst POST_PATH_WHITELIST = new Set([\"/files/open\"]);\n57\t\n58\tconst BOOT_HINT =\n59\t  \"Memo-Ray is not running. Boot it with scripts/memoray.ps1 (or scripts/memoray.sh), or point MEMORAY_BASE_URL at a running instance.\";\n60\t\n61\texport function isMemorayProxyPath(pathname) {\n62\t  return pathname === MEMORAY_PATH_PREFIX || pathname.startsWith(MEMORAY_PATH_PREFIX + \"/\");\n63\t}\n64\t\n65\t// prime-silo.config.json `memoray` block, cached in memory and invalidated by\n66\t// an fs.watch listener — NOT re-stat'd per request. Under concurrent proxy load\n67\t// the hot path is a pure O(1) memory read; the manifest is only re-read when the\n68\t// watcher fires (a wizard edit) or the TTL safety 