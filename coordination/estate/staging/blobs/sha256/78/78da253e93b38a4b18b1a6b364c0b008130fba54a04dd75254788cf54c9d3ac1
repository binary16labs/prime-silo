{"parentUuid":"2c8a5c51-bcfc-488c-a57f-1b55fa08c754","isSidechain":false,"promptId":"f21b9f40-fb0d-4a59-a87b-1aa152da5cd9","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CNg4VkzjLXMAqiTcszsTpx","type":"tool_result","content":"1\t// Organic 2D force-graph drop-in renderer.\n2\t//\n3\t// Slots into `memoray.lineage_graph`, `kg3d.synoptic_web`, and\n4\t// `codegraph.canvas` via the same `options.renderer = { mount, update,\n5\t// dispose }` hook that `three_renderer` uses. The widget cores stay\n6\t// dependency-free (default 2D SVG); callers that want the living, organic\n7\t// graph — the Memo-Ray look (force-simulated motion, node glow, animated\n8\t// trace particles on the active path, a corner minimap) — pass an instance\n9\t// returned by `createForceGraph2DRenderer()` and the widget never learns the\n10\t// graphing library exists.\n11\t//\n12\t// ## Offline by design\n13\t//\n14\t// Unlike `three_renderer` (which lazy-loads `3d-force-graph` from a CDN), the\n15\t// 2D library is **vendored locally** at `vendor/force-graph.module.js` (a\n16\t// self-contained esbuild bundle of vasturiano/force-graph with every d3 /\n17\t// lodash dependency inlined — zero bare imports, see vendor/README.md). The\n18\t// default loader dynamic-imports that local path, so the renderer works with\n19\t// no network at all. The import is still lazy (only on first mount) so pages\n20\t// that never open a graph pay nothing.\n21\t//\n22\t// Tests inject `options.loader = () => Promise<ForceGraph>` so the node runner\n23\t// never touches the vendored bundle or the DOM.\n24\t//\n25\t// ## Layout contract (shared with three_renderer)\n26\t//\n27\t//   • `memoray.lineage_graph` → positions carry { x, y, depth, node }\n28\t//   • `kg3d.synoptic_web`     → positions carry { x, y, radius, layer, color, node }\n29\t//   • `codegraph.canvas`      → positions carry { x, y, radius, type, color, node }\n30\t//\n31\t// `layoutToGraphData(layout, physics)` normalises all three into the\n32\t// `{ nodes, links }` shape force-graph expects. Lineage positions carry no\n33\t// colour/radius, so colour is derived from the node's `type` via the Memo-Ray\n34\t// palette and size from a per-type default. `physics === \"pinned\"` fixes\n35\t// fx/fy (frozen layout); `\"fluid\"` only seeds x/y and lets the simulation run\n36\t// (the organic motion).\n37\t//\n38\t// ## Click / hover\n39\t//\n40\t// Both conventions are honoured: the per-mount `props.onSelect(id)` used by\n41\t// the SVG renderers, and the factory `options.onNodeClick(id, node)` used by\n42\t// the Bridge's `makeThreeRenderer`-style wiring. Whichever is present fires.\n43\t\n44\tconst DEFAULT_VENDOR_URL = new URL(\"./vendor/force-graph.module.js\", import.meta.url).href;\n45\tconst DEFAULT_BACKGROUND = \"transparent\";\n46\t\n47\t// Memo-Ray organic palette, by node type (mirrors OrganicGraph.jsx PALETTE\n48\t// and lineage_graph's NODE_TYPE_COLORS — earth tones, sage/moss/golden).\n49\tconst PALETTE = {\n50\t  \"User Input\": \"#b8a898\",\n51\t  Thought: \"#8b9c8b\",\n52\t  Message: \"#8b9c8b\",\n53\t  \"Tool Call\": \"#6a8a6a\",\n54\t  \"Tool Result\": \"#6a8a6a\",\n55\t  Artifact: \"#8a9aa4\",\n56\t  Session: \"#c4a882\",\n57\t  \"System Init\": \"#5a6a5e\",\n58\t  Error: \"#c47a6a\"\n59\t};\n60\tconst DEFAULT_NODE_COLOR = \"#6b7378\";\n61\tconst HIGHLIGHT_COLOR = \"#db533f\"; // rust red, matches Memo-Ray\n62\tconst LINK_COLOR = \"rgba(138,154,164,0.12)\";\n63\tconst LABEL_COLOR = \"rgba(232,236,233,0.7)\";\n64\tconst DEFAULT_NODE_VAL = 6;\n65\t\n66\tconst HTML_ESCAPES = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" };\n67\tfunction escapeHtml(text) {\n68\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n69\t}\n70\t\n71\tfunction colorFor(entry) {\n72\t  if (entry && typeof entry.color === \"string\" && entry.color) return entry.color;\n73\t  const type = (entry && (entry.type || (entry.node && entry.node.type))) || null;\n74\t  return (type && PALETTE[type]) || DEFAULT_NODE_COLOR;\n75\t}\n76\t\n77\t// Last path segment, so a File node reads \"auth.py\" on the canvas instead of\n78\t// the full \"/src/app/services/auth.py\". Trailing slashes are trimmed first.\n79\tfunction basename(value) {\n80\t  const str = String(value).replace(/[\\\\/]+$/, \"\");\n81\t  const seg = str.split(/[\\\\/]/).pop();\n82\t  return seg || str;\n83\t}\n84\t\n85\tfunction looksLikePath(value) {\n86\t  return typeof value === \"string\" && /[\\\\/]/.test(value) && !/\\s/.test(value);\n87\t}\n88\t\n89\t// Human-readable label shown on the canvas. Mirrors the field priority each\n90\t// widget's own SVG renderer uses, unified across all three graph shapes:\n91\t//   • kg3d (Documents):  display_name → canonical_name → …\n92\t//   • codegraph (Code):  name → label → path(basename) → …\n93\t//   • memoray (Memory):  content / label / type\n94\t// so nodes never fall back to a raw id or bare type when a real name exists.\n95\tfunction labelFor(entry) {\n96\t  const safe = entry && typeof entry === \"object\" ? entry : {};\n97\t  const node = safe.node && typeof safe.node === \"object\" ? safe.node : {};\n98\t  const named =\n99\t    node.display_name ||\n100\t    node.canonical_name ||\n101\t    node.name ||\n102\t    node.title ||\n103\t    node.label ||\n104\t    node.content ||\n105\t    safe.label;\n106\t  if (named) return basename(String(named).trim());\n107\t  const path = node.path || safe.path;\n108\t  if (path) return basename(path);\n109\t  const id = safe.id || node.id;\n110\t  if (id != null) return looksLikePath(id) ? basename(id) : String(id);\n111\t  return node.type || safe.type || \"node\";\n112\t}\n113\t\n114\t// The full, unambiguous identifier — surfaced in the hover tooltip so the\n115\t// human-friendly canvas label never costs you the ability to tell two\n116\t// similarly-named nodes apart (e.g. two auth.py in different folders).\n117\tfunction identifierFor(entry) {\n118\t  const safe = entry && typeof entry === \"object\" ? entry : {};\n119\t  const node = safe.node && typeof safe.node === \"object\" ? safe.node : {};\n120\t  return String(node.path || node.canonical_name || node.id || safe.id || \"\");\n121\t}\n122\t\n123\t/**\n124\t * Convert a widget layout (lineage / kg3d / codegraph shape) into force-graph's\n125\t * `{ nodes, links }` payload. Exported for testing.\n126\t */\n127\texport function layoutToGraphData(layout, physicsMode = \"fluid\") {\n128\t  const positions =\n129\t    layout && typeof layout === \"object\" && layout.positions ? layout.positions : {};\n130\t  const edgesRaw = layout && Array.isArray(layout.edges) ? layout.edges : [];\n131\t\n132\t  const nodes = Object.entries(positions).map(([id, entry]) => {\n133\t    const safe = entry && typeof entry === \"object\" ? entry : {};\n134\t    const type = safe.type || (safe.node && safe.node.type) || null;\n135\t    const node = {\n136\t      id,\n137\t      type,\n138\t      color: colorFor(safe),\n139\t      // `val` drives the node radius. Pre-computed radii from the 2D layout map\n140\t      // directly; lineage carries none, so fall back to a readable default.\n141\t      val: typeof safe.radius === \"number\" ? safe.radius : DEFAULT_NODE_VAL,\n142\t      // Friendly name for the canvas; full identifier for the hover tooltip.\n143\t      label: labelFor(safe),\n144\t      ident: identifierFor(safe)\n145\t    };\n146\t    if (physicsMode === \"pinned\") {\n147\t      if (typeof safe.x === \"number\") node.fx = safe.x;\n148\t      if (typeof safe.y === \"number\") node.fy = safe.y;\n149\t    } else {\n150\t      // Seed positions so the sim iterates from the layered layout instead of\n151\t      // exploding from random — the organic settle still happens, just from a\n152\t      // sane starting point.\n153\t      if (typeof safe.x === \"number\") node.x = safe.x;\n154\t      if (typeof safe.y === \"number\") node.y = safe.y;\n155\t    }\n156\t    if (safe.layer != null) node.layer = safe.layer;\n157\t    if (typeof safe.depth === \"number\") node.depth = safe.depth;\n158\t    if (safe.node) node._original = safe.node;\n159\t    return node;\n160\t  });\n161\t\n162\t  const links = edgesRaw\n163\t    .filter((edge) => edge && edge.source != null && edge.target != null)\n164\t    .map((edge) => {\n165\t      const link = { source: String(edge.source), target: String(edge.target) };\n166\t      if (typeof edge.color === \"string\" && edge.color) link.color = edge.color;\n167\t      if (edge.type != null) link.type = edge.type;\n168\t      if (edge.kind != null) link.kind = edge.kind;\n169\t      if (typeof edge.weight === \"number\") link.weight = edge.weight;\n170\t      return link;\n171\t    });\n172\t\n173\t  return { nodes, links };\n174\t}\n175\t\n176\t/**\n177\t * `focusedLayer` (kg3d) visibility predicate — shared with three_renderer's\n178\t * semantics. Exported for testing.\n179\t */\n180\texport function nodeMatchesProps(node, props) {\n181\t  if (!node || !props) return true;\n182\t  const focus = props.focusedLayer;\n183\t  if (focus && node.layer != null && node.layer !== focus) return false;\n184\t  return true;\n185\t}\n186\t\n187\t// Which node id(s) are \"in scope\" — the active selection, glowing rust red.\n188\tfunction highlightIdsFromProps(props) {\n189\t  if (!props) return [];\n190\t  const ids = [];\n191\t  if (Array.isArray(props.highlightNodeIds)) ids.push(...props.highlightNodeIds);\n192\t  if (props.highlightNodeId) ids.push(props.highlightNodeId);\n193\t  if (props.selectedNodeId) ids.push(props.selectedNodeId);\n194\t  return ids.filter(Boolean).map(String);\n195\t}\n196\t\n197\tasync function defaultLoader(vendorUrl) {\n198\t  const mod = await import(/* @vite-ignore */ vendorUrl);\n199\t  return (mod && (mod.default || mod.ForceGraph || mod)) || null;\n200\t}\n201\t\n202\t/**\n203\t * Build a renderer instance compatible with the widget pluggable-renderer\n204\t * hook. The returned object exposes `mount`; the handle returned by `mount`\n205\t * exposes `update` and `dispose`. Multiple mounts off one factory are\n206\t * independent — each owns its own force-graph instance.\n207\t */\n208\texport function createForceGraph2DRenderer(options = {}) {\n209\t  const vendorUrl =\n210\t    typeof options.vendorUrl === \"string\" && options.vendorUrl ? options.vendorUrl : DEFAULT_VENDOR_URL;\n211\t  const loader =\n212\t    typeof options.loader === \"function\" ? options.loader : () => defaultLoader(vendorUrl);\n213\t  const backgroundColor =\n214\t    typeof options.backgroundColor === \"string\" ? options.backgroundColor : DEFAULT_BACKGROUND;\n215\t  const physicsMode = typeof options.physicsMode === \"string\" ? options.physicsMode : \"fluid\";\n216\t  const factoryOnNodeClick =\n217\t    typeof options.onNodeClick === \"function\" ? options.onNodeClick : null;\n218\t  const showMinimap = options.minimap !== false;\n219\t\n220\t  function mount(host, layout, props) {\n221\t    if (!host || typeof host.querySelector !== \"function\") {\n222\t      throw new Error(\"createForceGraph2DRenderer.mount: host must be an HTMLElement.\");\n223\t    }\n224\t\n225\t    const state = {\n226\t      host,\n227\t      inner: null, // absolutely-positioned layer force-graph mounts into\n228\t      instance: null,\n229\t      disposed: false,\n230\t      highlight: highlightIdsFromProps(props),\n231\t      minimapCanvas: null,\n232\t      minimapTimer: null,\n233\t      resizeObserver: null,\n234\t      win: null,\n235\t      onWinResize: null,\n236\t      lastW: 0,\n237\t      lastH: 0,\n238\t      hasFitted: false,\n239\t      refitTimer: null,\n240\t      pending: { layout, props }\n241\t    };\n242\t\n243\t    function isHot(id) {\n244\t      return state.highlight.includes(String(id));\n245\t    }\n246\t\n247\t    // ── node paint (ported from OrganicGraph.jsx) ──\n248\t    function paintNode(node, ctx, globalScale) {\n249\t      const hot = isHot(node.id);\n250\t      const color = hot ? HIGHLIGHT_COLOR : node.color || DEFAULT_NODE_COLOR;\n251\t      const size = (node.val || DEFAULT_NODE_VAL) * (hot ? 2.2 : 1);\n252\t\n253\t      ctx.save();\n254\t      if (node.type === \"Session\" || node.type === \"Artifact\" || hot) {\n255\t        ctx.shadowColor = hot ? HIGHLIGHT_COLOR : color;\n256\t        ctx.shadowBlur = hot ? 36 : 12;\n257\t      }\n258\t      ctx.beginPath();\n259\t      if (node.type === \"Artifact\") {\n260\t        const r = size * 0.4;\n261\t        const x = node.x - size;\n262\t        const y = node.y - size;\n263\t        const w = size * 2;\n264\t        const h = size * 2;\n265\t        ctx.moveTo(x + r, y);\n266\t        ctx.arcTo(x + w, y, x + w, y + h, r);\n267\t        ctx.arcTo(x + w, y + h, x, y + h, r);\n268\t        ctx.arcTo(x, y + h, x, y, r);\n269\t        ctx.arcTo(x, y, x + w, y, r);\n270\t      } else {\n271\t        ctx.arc(node.x, node.y, size, 0, 2 * Math.PI);\n272\t      }\n273\t      ctx.fillStyle = color;\n274\t      ctx.globalAlpha = hot ? 1 : 0.85;\n275\t      ctx.fill();\n276\t      ctx.globalAlpha = 1;\n277\t      ctx.lineWidth = Math.max(size * 0.12, 0.5);\n278\t      ctx.strokeStyle = hot\n279\t        ? \"rgba(255,255,255,0.9)\"\n280\t        : `rgba(232,236,233,${node.type === \"Session\" ? 0.4 : 0.15})`;\n281\t      ctx.stroke();\n282\t      ctx.restore();\n283\t\n284\t      if (hot) {\n285\t        ctx.save();\n286\t        ctx.beginPath();\n287\t        const pulse = Math.sin(Date.now() / 250) * 0.5 + 0.5;\n288\t        const pulseRadius = size * (1.2 + pulse * 0.5);\n289\t        ctx.arc(node.x, node.y, pulseRadius, 0, 2 * Math.PI);\n290\t        ctx.strokeStyle = HIGHLIGHT_COLOR;\n291\t        ctx.lineWidth = 1.5 / globalScale;\n292\t        ctx.globalAlpha = 0.6 - pulse * 0.45;\n293\t        ctx.stroke();\n294\t        ctx.restore();\n295\t      }\n296\t\n297\t      // Show labels sooner (was zoom > 1.2 — too late to read a docs/code graph\n298\t      // at a normal fit) and let a bit more text through so names aren't clipped\n299\t      // to nothing. Highlighted nodes always label.\n300\t      if (globalScale > 0.55 || hot) {\n301\t        const fontSize = Math.max(11 / globalScale, 4.5);\n302\t        ctx.font = hot\n303\t          ? `bold ${fontSize + 1}px Inter, system-ui`\n304\t          : `500 ${fontSize}px Inter, system-ui`;\n305\t        ctx.textAlign = \"center\";\n306\t        ctx.textBaseline = \"top\";\n307\t        ctx.fillStyle = hot ? HIGHLIGHT_COLOR : LABEL_COLOR;\n308\t        const label = String(node.label || node.type || node.id);\n309\t        const maxChars = Math.max(12, Math.floor(28 * Math.min(globalScale / 1.5, 1.6)));\n310\t        const text = label.length > maxChars ? label.substring(0, maxChars) + \"…\" : label;\n311\t        ctx.fillText(text, node.x, node.y + size + 2);\n312\t      }\n313\t    }\n314\t\n315\t    function linkHot(link) {\n316\t      const s = typeof link.source === \"object\" ? link.source.id : link.source;\n317\t      const t = typeof link.target === \"object\" ? link.target.id : link.target;\n318\t      return { s: isHot(s), t: isHot(t) };\n319\t    }\n320\t\n321\t    function sizeToHost() {\n322\t      if (!state.instance || !state.host) return;\n323\t      if (typeof state.host.getBoundingClientRect !== \"function\") return;\n324\t      const rect = state.host.getBoundingClientRect();\n325\t      const w = Math.round(rect.width > 0 ? rect.width : 600);\n326\t      const h = Math.round(rect.height > 0 ? rect.height : 400);\n327\t      // Only push new dimensions when they actually changed. force-graph's own\n328\t      // canvas lives in an absolutely-positioned inner layer (so it can never\n329\t      // drive the host's height), but skipping no-op resizes keeps the\n330\t      // ResizeObserver from ever entering a measure→set→measure cycle.\n331\t      if (w === state.lastW && h === state.lastH) return;\n332\t      state.lastW = w;\n333\t      state.lastH = h;\n334\t      if (typeof state.instance.width === \"function\") state.instance.width(w);\n335\t      if (typeof state.instance.height === \"function\") state.instance.height(h);\n336\t    }\n337\t\n338\t    // A panel that just became visible (Alpine x-show display:none → block) is\n339\t    // often measured before layout flushes, so the very first getBoundingClientRect\n340\t    // can report a partial size — leaving the canvas stuck in a corner of the\n341\t    // frame. Re-measure across the next few frames so the canvas grows to fill\n342\t    // the stage once layout settles. (Mirrors OrganicGraph.jsx's rAF re-measure.)\n343\t    function scheduleResize() {\n344\t      sizeToHost();\n345\t      if (typeof requestAnimationFrame === \"function\") requestAnimationFrame(sizeToHost);\n346\t      for (const delay of [60, 200, 450]) setTimeout(sizeToHost, delay);\n347\t    }\n348\t\n349\t    // Re-frame the whole graph centered in the current viewport. force-graph\n350\t    // keeps the same world-center across a canvas resize, so without this the\n351\t    // content drifts to one side (\"the graph says on the right\") when the\n352\t    // window changes size. Debounced so a drag-resize settles to one refit, and\n353\t    // only fired on resize / first settle — NOT on data updates, so selecting a\n354\t    // node never yanks the camera.\n355\t    function refit(duration = 400) {\n356\t      if (!state.instance || typeof state.instance.zoomToFit !== \"function\") return;\n357\t      try {\n358\t        state.instance.zoomToFit(duration, 40);\n359\t      } catch {\n360\t        /* positions not ready yet */\n361\t      }\n362\t    }\n363\t    function scheduleRefit() {\n364\t      if (state.refitTimer) clearTimeout(state.refitTimer);\n365\t      state.refitTimer = setTimeout(() => refit(400), 220);\n366\t    }\n367\t\n368\t    function applyData() {\n369\t      if (state.disposed || !state.instance) return;\n370\t      const data = layoutToGraphData(state.pending.layout, physicsMode);\n371\t      state.highlight = highlightIdsFromProps(state.pending.props);\n372\t      const props = state.pending.props || {};\n373\t      // Honour layer filtering by dropping hidden nodes/links before they reach\n374\t      // the sim (cheaper than per-frame visibility for a 2D canvas).\n375\t      const visibleNodes = data.nodes.filter((n) => nodeMatchesProps(n, props));\n376\t      const visibleIds = new Set(visibleNodes.map((n) => n.id));\n377\t      const visibleLinks = data.links.filter(\n378\t        (l) => visibleIds.has(String(l.source)) && visibleIds.has(String(l.target))\n379\t      );\n380\t      state.instance.graphData({ nodes: visibleNodes, links: visibleLinks });\n381\t    }\n382\t\n383\t    function fireClick(node) {\n384\t      if (!node) return;\n385\t      // The widgets pass a per-mount `props.onSelect`; the Bridge factory wiring\n386\t      // passes `options.onNodeClick`. Prefer the per-mount handler so the two\n387\t      // conventions don't double-fire when both are present (they route to the\n388\t      // same selection logic). Fall back to the factory handler otherwise.\n389\t      const onSelect = state.pending && state.pending.props && state.pending.props.onSelect;\n390\t      if (typeof onSelect === \"function\") onSelect(node.id, node._original || node);\n391\t      else if (factoryOnNodeClick) factoryOnNodeClick(node.id, node._original || node);\n392\t    }\n393\t\n394\t    function fireHover(node) {\n395\t      const onHover = state.pending && state.pending.props && state.pending.props.onHover;\n396\t      if (typeof onHover === \"function\") onHover(node ? node.id : null, node);\n397\t    }\n398\t\n399\t    function drawMinimap() {\n400\t      const cv = state.minimapCanvas;\n401\t      const inst = state.instance;\n402\t      if (!cv || !inst || state.disposed) return;\n403\t      const ctx = cv.getContext(\"2d\");\n404\t      const W = cv.width;\n405\t      const H = cv.height;\n406\t      ctx.clearRect(0, 0, W, H);\n407\t      ctx.fillStyle = \"rgba(18,22,20,0.82)\";\n408\t      ctx.fillRect(0, 0, W, H);\n409\t      const gd = typeof inst.graphData === \"function\" ? inst.graphData() : null;\n410\t      const nodes = (gd && gd.nodes ? gd.nodes : []).filter(\n411\t        (n) => typeof n.x === \"number\" && typeof n.y === \"number\"\n412\t      );\n413\t      if (!nodes.length) return;\n414\t      let minX = Infinity;\n415\t      let maxX = -Infinity;\n416\t      let minY = Infinity;\n417\t      let maxY = -Infinity;\n418\t      for (const n of nodes) {\n419\t        if (n.x < minX) minX = n.x;\n420\t        if (n.x > maxX) maxX = n.x;\n421\t        if (n.y < minY) minY = n.y;\n422\t        if (n.y > maxY) maxY = n.y;\n423\t      }\n424\t      const pad = 6;\n425\t      const gw = maxX - minX || 1;\n426\t      const gh = maxY - minY || 1;\n427\t      const scale = Math.min((W - 2 * pad) / gw, (H - 2 * pad) / gh);\n428\t      const ox = (W - gw * scale) / 2;\n429\t      const oy = (H - gh * scale) / 2;\n430\t      const tx = (x) => ox + (x - minX) * scale;\n431\t      const ty = (y) => oy + (y - minY) * scale;\n432\t      for (const n of nodes) {\n433\t        const hot = isHot(n.id);\n434\t        ctx.beginPath();\n435\t        ctx.arc(tx(n.x), ty(n.y), hot ? 3 : 1, 0, 2 * Math.PI);\n436\t        ctx.fillStyle = hot ? HIGHLIGHT_COLOR : n.color || DEFAULT_NODE_COLOR;\n437\t        ctx.fill();\n438\t      }\n439\t      try {\n440\t        const c = typeof inst.centerAt === \"function\" ? inst.centerAt() : null;\n441\t        const k = typeof inst.zoom === \"function\" ? inst.zoom() : null;\n442\t        const rect = state.host.getBoundingClientRect();\n443\t        if (c && k && rect.width && rect.height) {\n444\t          const vw = rect.width / k;\n445\t          const vh = rect.height / k;\n446\t          ctx.strokeStyle = \"rgba(232,236,233,0.55)\";\n447\t          ctx.lineWidth = 1;\n448\t          ctx.strokeRect(tx(c.x - vw / 2), ty(c.y - vh / 2), vw * scal