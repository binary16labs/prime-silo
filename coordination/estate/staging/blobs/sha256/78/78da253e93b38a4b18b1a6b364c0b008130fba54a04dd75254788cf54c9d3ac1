0.4rem;\n  max-width: 760px;\n}\n\n.prime-silo-st__picker-item {\n  display: flex;\n  flex-direction: column;\n  gap: 0.15rem;\n  text-align: left;\n  background: var(--surface-raised);\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-sm);\n  color: var(--text-primary);\n  cursor: pointer;\n  padding: 0.6rem 0.8rem;\n}\n\n.prime-silo-st__picker-item:hover {\n  border-color: var(--sage);\n}\n\n.prime-silo-st__picker-title {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.prime-silo-st__picker-sub {\n  font-size: 0.78rem;\n  color: var(--text-tertiary);\n}\n\n/* ── player ─────────────────────────────────────────────────── */\n.prime-silo-st__player {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.prime-silo-st__controls {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n\n.prime-silo-st__toggles,\n.prime-silo-st__nav {\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.prime-silo-st__toggle,\n.prime-silo-st__nav-btn,\n.prime-silo-st__speed {\n  background: var(--surface-raised);\n  border: 1px solid var(--border-default);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  cursor: pointer;\n  font-size: 0.82rem;\n  padding: 0.35rem 0.7rem;\n}\n\n.prime-silo-st__toggle.is-on,\n.prime-silo-st__play.is-on {\n  border-color: var(--sage);\n  color: var(--sage);\n  background: var(--sage-dim);\n}\n\n.prime-silo-st__nav-btn:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.prime-silo-st__progress {\n  font-size: 0.82rem;\n  color: var(--text-tertiary);\n  margin-left: 0.5rem;\n}\n\n.prime-silo-st__play {\n  min-width: 78px;\n}\n\n/* ── milestone scrubber ─────────────────────────────────────── */\n.prime-silo-st__milestones {\n  display: flex;\n  gap: 1px;\n  height: 10px;\n  flex: 0 0 auto;\n}\n\n.prime-silo-st__seg {\n  flex: 1 1 auto;\n  min-width: 1px;\n  background: var(--surface-hover);\n  cursor: pointer;\n  border-radius: 1px;\n}\n\n.prime-silo-st__seg.past {\n  background: var(--moss);\n}\n\n.prime-silo-st__seg.is-milestone {\n  background: var(--golden);\n}\n\n.prime-silo-st__seg.active {\n  background: var(--text-primary);\n  transform: scaleY(1.6);\n}\n\n/* ── stage ──────────────────────────────────────────────────── */\n.prime-silo-st__stage {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: grid;\n  grid-template-columns: 1fr;\n  gap: 1rem;\n}\n\n.prime-silo-st__stage.has-map {\n  grid-template-columns: minmax(420px, 1fr) 1fr;\n}\n\n.prime-silo-st__card {\n  min-height: 0;\n  overflow-y: auto;\n  border: 1px solid var(--border-subtle);\n  border-radius: var(--radius-md);\n  background: var(--surface-raised);\n  padding: 1.25rem 1.5rem;\n}\n\n.prime-silo-st__hero {\n  font-size: 1.3rem;\n  line-height: 1.4;\n  color: var(--text-primary);\n  margin-bottom: 0.9rem;\n}\n\n.prime-silo-st__meta {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.6rem;\n  font-size: 0.82rem;\n  color: var(--text-tertiary);\n  margin-bottom: 0.6rem;\n}\n\n.prime-silo-st__agent {\n  font-weight: 600;\n  color: var(--text-secondary);\n}\n.prime-silo-st__agent.claude {\n  color: var(--golden);\n}\n.prime-silo-st__agent.antigravity {\n  color: var(--slate);\n}\n\n.prime-silo-st__why-btn {\n  background: transparent;\n  border: 1px solid var(--border-default);\n  border-radius: var(--radius-sm);\n  color: var(--text-secondary);\n  cursor: pointer;\n  font-size: 0.76rem;\n  padding: 0.15rem 0.5rem;\n}\n\n.prime-silo-st__why {\n  background: var(--sage-dim);\n  border-left: 3px solid var(--sage);\n  border-radius: var(--radius-sm);\n  padding: 0.6rem 0.8rem;\n  margin-bottom: 0.8rem;\n  font-size: 0.9rem;\n  color: var(--text-secondary);\n}\n\n.prime-silo-st__content {\n  font-size: 0.85rem;\n}\n\n.prime-silo-st__content pre {\n  white-space: pre-wrap;\n  word-break: break-word;\n  background: var(--surfac