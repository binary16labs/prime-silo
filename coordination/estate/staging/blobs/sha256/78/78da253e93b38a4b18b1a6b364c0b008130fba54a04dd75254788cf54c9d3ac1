es\": [\"PORT\"],\n      \"health\": {\n        \"endpoint\": \"ecosystem_manifest\",\n        \"expect\": \"totalNodes\"\n      },\n      \"owner\": {\n        \"repo\": \"memo-ray\",\n        \"path\": \"agent-os-dashboard/server/index.js\"\n      }\n    },\n    {\n      \"id\": \"shell_proxy\",\n      \"kind\": \"proxy\",\n      \"produces\": \"/api/memoray/<path> on the shell origin (GET any, POST /files/open only)\",\n      \"consumes\": [\"MEMORAY_ENABLED\", \"MEMORAY_BASE_URL\", \"memoray.enabled\", \"memoray.base_url\"],\n      \"owner\": {\n        \"repo\": \"prime-silo\",\n        \"path\": \"server/lib/memoray_proxy.js\"\n      }\n    },\n    {\n      \"id\": \"memoray_client\",\n      \"kind\": \"client\",\n      \"produces\": \"memorayFetch/readMemorayJson browser helpers\",\n      \"consumes\": [],\n      \"owner\": {\n        \"repo\": \"prime-silo\",\n        \"path\": \"app/L0/_all/mod/_prime_silo/memoray_client/memoray-client.js\"\n      }\n    },\n    {\n      \"id\": \"widget_overview_cards\",\n      \"kind\": \"widget\",\n      \"produces\": \"memoray.overview_cards Command Center widget\",\n      \"consumes\": [\"beta_overview\", \"system_metrics\", \"system_capabilities\", \"ecosystem_manifest\"],\n      \"owner\": {\n        \"repo\": \"prime-silo\",\n        \"path\": \"app/L0/_all/mod/_prime_silo/widgets/memoray/overview_cards/index.js\"\n      }\n    },\n    {\n      \"id\": \"widget_lineage_graph\",\n      \"kind\": \"widget\",\n      \"produces\": \"memoray.lineage_graph session lineage widget (2D SVG default, pluggable renderer)\",\n      \"consumes\": [\"graph\", \"entities\"],\n      \"owner\": {\n        \"repo\": \"prime-silo\",\n        \"path\": \"app/L0/_all/mod/_prime_silo/widgets/memoray/lineage_graph/index.js\"\n      }\n    },\n    {\n      \"id\": \"memory_page\",\n      \"kind\": \"page\",\n      \"produces\": \"#/_prime_silo/memory review-zone shell page\",\n      \"consumes\": [\"sessions\", \"beta_search\", \"sync\", \"