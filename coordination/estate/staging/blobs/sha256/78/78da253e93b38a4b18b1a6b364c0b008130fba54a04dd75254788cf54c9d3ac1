lass=\"{ 'is-on': narrator }\"\n                @click=\"toggleNarrator()\"\n                x-text=\"narrator ? '🔊 Narrator on' : '🔈 Narrator off'\"\n              ></button>\n              <button\n                type=\"button\"\n                class=\"prime-silo-st__toggle\"\n                :class=\"{ 'is-on': showMap }\"\n                @click=\"toggleMap()\"\n                x-text=\"showMap ? '🗺️ Hide map' : '🗺️ Show map'\"\n              ></button>\n              <button\n                type=\"button\"\n                class=\"prime-silo-st__toggle\"\n                :class=\"{ 'is-on': tracking }\"\n                x-show=\"showMap\"\n                @click=\"tracking = !tracking\"\n                x-text=\"tracking ? '🎥 Tracking' : '🕊️ Free roam'\"\n              ></button>\n              <span class=\"prime-silo-st__progress\"\n                >Step <span x-text=\"timeline.length ? stepIndex + 1 : 0\"></span> of\n                <span x-text=\"timeline.length\"></span\n              ></span>\n            </div>\n\n            <div class=\"prime-silo-st__nav\">\n              <button\n                type=\"button\"\n                class=\"prime-silo-st__nav-btn\"\n                @click=\"prev()\"\n                :disabled=\"stepIndex === 0\"\n              >\n                ←\n              </button>\n              <button\n                type=\"button\"\n                class=\"prime-silo-st__nav-btn prime-silo-st__play\"\n                :class=\"{ 'is-on': isPlaying }\"\n                @click=\"togglePlay()\"\n                :disabled=\"stepIndex >= timeline.length - 1\"\n                x-text=\"isPlaying ? '⏸ Pause' : '▶ Play'\"\n              ></button>\n              <select\n                class=\"prime-silo-st__speed\"\n                x-model.number=\"speed\"\n                @change=\"onSpeedChange()\"\n                title=\"Playback speed (steps per second)\"\n              >\n                <option value=\"1\">1×</option>\n                <option value=\"2\">2×</option>\n                <option value=\"5\">5×</option>\n                <option value=\"10\">10×</option>\n                <option value=\"20\">20×</option>\n              </select>\n              <button\n                type=\"button\"\n                class=\"prime-silo-st__nav-btn\"\n                @click=\"next()\"\n                :disabled=\"stepIndex >= timeline.length - 1\"\n              >\n                →\n              </button>\n            </div>\n          </div>\n\n          <!-- Milestone scrubber -->\n          <div class=\"prime-silo-st__milestones\">\n            <template x-for=\"seg in milestoneSegments\" :key=\"seg.idx\">\n              <div\n                class=\"prime-silo-st__seg\"\n                :class=\"segClass(seg)\"\n                @click=\"setStep(seg.idx)\"\n              ></div>\n            </template>\n          </div>\n\n          <template x-if=\"timeline.length === 0\">\n            <p class=\"prime-silo-st__muted\">No actions found for this session.</p>\n          </template>\n\n          <!-- Stage: action card + map -->\n          <div class=\"prime-silo-st__stage\" :class=\"{ 'has-map': showMap }\" x-show=\"timeline.length > 0\">\n            <div class=\"prime-silo-st__card\">\n              <div class=\"prime-silo-st__hero\" x-text=\"heroText\"></div>\n              <div class=\"prime-silo-st__meta\" x-show=\"current\">\n                <span\n                  class=\"prime-silo-st__agent\"\n                  :class=\"current && current.agent ? current.agent.toLowerCase() : ''\"\n                  x-text=\"current ? current.agent : ''\"\n                ></span>\n                <span x-text=\"current ? formatTime(current.timestamp) : ''\"></span>\n                <span x-show=\"current && current.fileName\" x-text=\"current ? '📄 ' + current.fileName : ''\"></span>\n                <span x-show=\"current && current.toolName\" x-text=\"current ? '🔧 ' + current.toolName : ''\">