{"parentUuid":"b6a68e75-3f45-4e97-ae49-120290aa2869","isSidechain":false,"promptId":"76000644-3315-41ac-95ed-c508ea0016f3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011JaQcawYaNAcZR1GfK11SQ","type":"tool_result","content":"1\t\"\"\"\n2\tSynthesis Engine - LLM-powered triple extraction, embedding, and structural synthesis.\n3\t\n4\tThis module contains the three \"Logic Layers\":\n5\t  A. Relational Graph (NER + Relation Extraction -> triples)\n6\t  B. Conceptual Cluster (Dual-model embedding -> Venn clustering)\n7\t  C. Synthesis Layer (Structural Isomorphism detection)\n8\t\"\"\"\n9\t\n10\timport asyncio\n11\timport json\n12\timport logging\n13\timport os\n14\timport re\n15\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n16\t\n17\timport httpx\n18\t\n19\tfrom ..core.models import LOCAL_PROVIDERS, call_model\n20\tfrom ..core.schema import IngestionEvent, IngestionEventType, KnowledgeTriple, SynthesisConfig\n21\t\n22\tlogger = logging.getLogger(__name__)\n23\t\n24\t# Module-level shared httpx client for connection reuse\n25\t_shared_client: Optional[httpx.AsyncClient] = None\n26\t\n27\t\n28\tdef _get_shared_client() -> httpx.AsyncClient:\n29\t    \"\"\"Get or create a shared httpx client with connection pooling.\"\"\"\n30\t    global _shared_client\n31\t    if _shared_client is None or _shared_client.is_closed:\n32\t        _shared_client = httpx.AsyncClient(\n33\t            timeout=httpx.Timeout(300.0, connect=10.0),\n34\t            limits=httpx.Limits(max_connections=20, max_keepalive_connections=10),\n35\t        )\n36\t    return _shared_client\n37\t\n38\t\n39\t# =============================================================================\n40\t# A. RELATIONAL GRAPH - Triple Extraction via LLM\n41\t# =============================================================================\n42\t\n43\tTRIPLE_EXTRACTION_PROMPT = \"\"\"You are a knowledge graph extraction engine.\n44\tGiven the following text, extract ALL meaningful knowledge triples in the form:\n45\t  (Subject, Predicate, Object)\n46\t\n47\tRules:\n48\t- Subject and Object should be concise noun phrases (concepts, entities, processes).\n49\t- Predicate should be a verb phrase describing the relationship.\n50\t- Extract as many triples as you can find. Be thorough.\n51\t- CROSS-LINKING: If the text describes a design decision, architecture, or pattern, try to link it to potential code symbols or files (e.g., \"AuthenticationService\", \"schema.py\").\n52\t- If the text mentions a source document name, include triples that reference it.\n53\t\n54\tOutput format (STRICT):\n55\t- Respond with ONLY the XML below. Start your reply directly with <triples>.\n56\t- Do NOT use Markdown, bullet/numbered lists, prose, code fences, or <think> tags.\n57\t- Every tag must be well-formed: <object>value</object> (never <object(value)</object>).\n58\t\n59\t<triples>\n60\t  <triple>\n61\t    <subject>Dopamine</subject>\n62\t    <subject_type>Biology</subject_type>\n63\t    <predicate>drives</predicate>\n64\t    <object>reward-seeking behavior</object>\n65\t    <object_type>Concept</object_type>\n66\t    <citation>Dopamine is responsible for...</citation>\n67\t    <confidence>0.95</confidence>\n68\t  </triple>\n69\t</triples>\n70\t\n71\tTEXT:\n72\t{text}\n73\t\n74\tXML TRIPLES:\"\"\"\n75\t\n76\t\n77\tDIRECTED_EXTRACTION_PROMPT = \"\"\"You are an L2 expert reading a specific section of a document.\n78\tYour goal is to extract ALL core points, arguments, or mechanisms made in this section.\n79\t\n80\t{direction_prompt}\n81\t\n82\tRules for Extraction:\n83\t1. Extract as many meaningful triples as you can find. Be thorough.\n84\t2. Filter out any noise; only extract points structurally relevant to the direction (if provided).\n85\t3. \"subject_type\" and \"object_type\" should categorize the entity (e.g., Person, Theory, Technology, Organization, Location, Event, Concept).\n86\t4. \"citation\" must be the exact short sentence/excerpt from the text that justifies the claim.\n87\t5. \"confidence\" should be a score from 0.0 to 1.0 (1.0 = proven/stated as fact, 0.5 = hypothesized).\n88\t\n89\tTEXT SECTION: {section_title}\n90\t{text}\n91\t\n92\tOutput format (STRICT): respond with ONLY the XML block below, starting\n93\tdirectly with <triples>. No Markdown, lists, prose, code fences, or <think>\n94\ttags. Every tag must be well-formed (<object>value</object>). Example:\n95\t<triples>\n96\t  <triple>\n97\t    <subject>Dopamine</subject>\n98\t    <subject_type>Biology</subject_type>\n99\t    <predicate>drives</predicate>\n100\t    <object>Reward-Seeking Behavior</object>\n101\t    <object_type>Concept</object_type>\n102\t    <citation>Dopamine is responsible for the reward-seeking loop in mammalian brains.</citation>\n103\t    <confidence>0.9</confidence>\n104\t  </triple>\n105\t  <triple>\n106\t    <subject>Prefrontal Cortex</subject>\n107\t    <subject_type>Biology</subject_type>\n108\t    <predicate>modulates</predicate>\n109\t    <object>impulse control</object>\n110\t    <object_type>Process</object_type>\n111\t    <citation>The prefrontal cortex acts as a top-down modulator for impulsive actions.</citation>\n112\t    <confidence>0.85</confidence>\n113\t  </triple>\n114\t</triples>\n115\t\n116\tXML:\"\"\"\n117\t\n118\t\n119\tCONFLICT_DETECTION_PROMPT = \"\"\"You are a logical consistency checker.\n120\tGiven the following set of knowledge triples already in the graph, and a NEW set of triples about to be added, identify any CONFLICTS (contradictions) between the existing and new triples.\n121\t\n122\tA conflict exists when:\n123\t- Two triples make opposing claims about the same subject-object pair\n124\t- A new triple directly contradicts an existing one\n125\t\n126\tEXISTING TRIPLES:\n127\t{existing}\n128\t\n129\tNEW TRIPLES:\n130\t{new_triples}\n131\t\n132\tReturn an XML block of conflicts. If no conflicts, return <conflicts></conflicts>.\n133\tEach conflict object should have <concept_a>, <concept_b>, and <description>.\n134\t\n135\tExample:\n136\t<conflicts>\n137\t  <conflict>\n138\t    <concept_a>A</concept_a>\n139\t    <concept_b>B</concept_b>\n140\t    <description>Contradiction explanation...</description>\n141\t  </conflict>\n142\t</conflicts>\n143\t\n144\tXML CONFLICTS:\"\"\"\n145\t\n146\t\n147\tSYNTHESIS_PROMPT = \"\"\"You are a cross-domain synthesis engine that finds structural isomorphisms -\n148\tpatterns that repeat across different fields.\n149\t\n150\tGiven the following set of concepts and their relationships, identify any\n151\tSTRUCTURAL ANALOGIES (isomorphisms) between concepts from different domains.\n152\t\n153\tAn analogy exists when:\n154\t- Two systems from different fields share the same underlying pattern or structure\n155\t- The way one system works is mathematically or structurally similar to another\n156\t- E.g. how a forest fire spreads (Biology) is similar to how a viral tweet spreads (Sociology)\n157\t\n158\tKNOWLEDGE GRAPH:\n159\t{graph_summary}\n160\t\n161\tReturn an XML block of analogies. If no analogies found, return <analogies></analogies>.\n162\tEach analogy should use the tags <concept_a>, <concept_b>, <description>, and <pattern>.\n163\t\n164\tExample:\n165\t<analogies>\n166\t  <analogy>\n167\t    <concept_a>A</concept_a>\n168\t    <concept_b>B</concept_b>\n169\t    <description>Analogy explanation...</description>\n170\t    <pattern>Pattern Name</pattern>\n171\t  </analogy>\n172\t</analogies>\n173\t\n174\tXML ANALOGIES:\"\"\"\n175\t\n176\t\n177\tCROSS_DOMAIN_PROMPT = \"\"\"You are a cross-domain analogy engine.\n178\tGiven the concept \"{concept}\" and its relationships below, explain how this concept\n179\tmaps to the domain of \"{target_domain}\".\n180\t\n181\tCONCEPT RELATIONSHIPS:\n182\t{relationships}\n183\t\n184\tProvide:\n185\t1. The analogous concept in {target_domain}\n186\t2. How the structural pattern maps\n187\t3. Key similarities and differences\n188\t\n189\tBe specific and insightful. Format as XML:\n190\t<analogy>\n191\t  <analogous_concept>...</analogous_concept>\n192\t  <mapping>...</mapping>\n193\t  <similarities>...</similarities>\n194\t  <differences>...</differences>\n195\t</analogy>\n196\t\n197\tXML:\"\"\"\n198\t\n199\t\n200\tCOMMUNITY_NAMING_PROMPT = \"\"\"You are a topological expert.\n201\tGiven the following list of concepts and relationships discovered in a specific \"Semantic Neighborhood\" (community) of a knowledge graph, provide a concise, descriptive name for this community.\n202\t\n203\tCOMMUNITY CONCEPTS:\n204\t{concepts}\n205\t\n206\tGUIDELINES:\n207\t1. The name should be exactly 2-4 words.\n208\t2. It should capture the \"essence\" of the cluster (e.g., \"Neural Execution Layer\", \"User Data Governance\", \"Asynchronous Messaging Patterns\").\n209\t3. Avoid generic names like \"Group 1\" or \"System Cluster\".\n210\t\n211\tReturn ONLY an XML block:\n212\t<community>\n213\t  <community_name>...</community_name>\n214\t  <justification>...</justification>\n215\t</community>\n216\t\n217\tXML:\"\"\"\n218\t\n219\t\n220\t# =============================================================================\n221\t# ADAPTIVE CHUNKING\n222\t# =============================================================================\n223\t\n224\t\n225\tdef estimate_tokens(text: str) -> int:\n226\t    \"\"\"Estimate token count from character length (~4 chars per token).\"\"\"\n227\t    return max(1, len(text) // 4)\n228\t\n229\t\n230\tdef adaptive_truncate(text: str, max_tokens: int = 4000) -> str:\n231\t    \"\"\"\n232\t    Truncate text to fit within a token budget, preferring to break at\n233\t    sentence boundaries rather than mid-sentence.\n234\t    \"\"\"\n235\t    max_chars = max_tokens * 4\n236\t    if len(text) <= max_chars:\n237\t        return text\n238\t\n239\t    # Try to break at the last sentence boundary within the budget\n240\t    truncated = text[:max_chars]\n241\t    last_period = truncated.rfind(\". \")\n242\t    last_newline = truncated.rfind(\"\\n\")\n243\t    break_at = max(last_period, last_newline)\n244\t\n245\t    if break_at > max_chars * 0.6:  # Only break at boundary if we keep >60% of content\n246\t        return truncated[: break_at + 1]\n247\t    return truncated\n248\t\n249\t\n250\t# =============================================================================\n251\t# LLM CALL WITH RETRY\n252\t# =============================================================================\n253\t\n254\t\n255\tasync def call_llm(\n256\t    prompt: str,\n257\t    provider: str = \"lemonade\",\n258\t    model: Optional[str] = None,\n259\t    timeout: Optional[float] = None,\n260\t    config: Optional[SynthesisConfig] = None,\n261\t    run_id: Optional[str] = None,\n262\t    workspace: Optional[str] = None,\n263\t    role: str = \"default\",\n264\t) -> str:\n265\t    \"\"\"\n266\t    Consolidated LLM call with retry and exponential backoff.\n267\t    Utilizes the core dispatcher for OpenAI, LiteLLM, and LiteRT.\n268\t    \"\"\"\n269\t    cfg = config or SynthesisConfig()\n270\t\n271\t    # Priority 1: Use explicitly provided model\n272\t    # Priority 2: Auto-resolve via active workspace manifest OR swarm manifest\n273\t    if not model and (workspace or run_id):\n274\t        try:\n275\t            from ..core.models import get_active_model\n276\t\n277\t            model = await get_active_model(workspace or \"default\", role=role, run_id=run_id)\n278\t        except Exception:\n279\t            pass\n280\t\n281\t    # Resolve model string (e.g., \"ollama/llama3\")\n282\t    if model and \"/\" in model:\n283\t        full_model = model\n284\t    elif model:\n285\t        full_model = f\"{provider}/{model}\"\n286\t    else:\n287\t        # Final safety fallback: use provider/default and let executor resolve\n288\t        full_model = f\"{provider}/default\"\n289\t\n290\t    last_error = None\n291\t    for attempt in range(cfg.max_retries):\n292\t        try:\n293\t            return await call_model(\n294\t                model=full_model,\n295\t                messages=[{\"role\": \"user\", \"content\": prompt}],\n296\t                temperature=0.3,\n297\t                # Cap output so input+output fits small local context windows\n298\t                # (FLM/NPU models are often 2048 tok). call_model defaults to\n299\t                # 2048 output, which overflowed qwen3.5-9b-FLM → \"no choices\".\n300\t                # 768 is ample for a JSON triple array.\n301\t                max_tokens=768,\n302\t                timeout=timeout,\n303\t                run_id=run_id,\n304\t                # Thread the workspace AND role through so the profile-aware\n305\t                # thinking suppression fires for synthesis: a 'capable' reasoning\n306\t                # model on the graph_synthesis role auto-runs with /no_think (no\n307\t                # operator toggle needed), while 'fragile' FLM models are left\n308\t                # alone. Without this, reasoning models burn the whole token\n309\t                # budget on <think> → no parseable JSON → an empty graph.\n310\t                workspace_id=workspace,\n311\t                role=role,\n312\t            )\n313\t        except Exception as e:\n314\t            last_error = e\n315\t            if attempt < cfg.max_retries - 1:\n316\t                delay = cfg.retry_base_delay * (2**attempt)\n317\t                logger.warning(\n318\t                    \"LLM call attempt %d/%d failed (%s). Retrying in %.1fs...\",\n319\t                    attempt + 1,\n320\t                    cfg.max_retries,\n321\t                    str(e)[:100],\n322\t                    delay,\n323\t                )\n324\t                await asyncio.sleep(delay)\n325\t            else:\n326\t                logger.error(\n327\t                    \"LLM call failed after %d attempts for role '%s': %s\",\n328\t                    cfg.max_retries,\n329\t                    role,\n330\t                    last_error,\n331\t                )\n332\t                if run_id:\n333\t                    from ..core.task_manager import task_manager\n334\t\n335\t                    task_manager.add_aer_entry(\n336\t                        run_id,\n337\t                        intent=f\"LLM Call ({role})\",\n338\t                        observation=\"Final retry failed\",\n339\t                        inference=str(last_error),\n340\t                    )\n341\t\n342\t    raise last_error\n343\t\n344\t\n345\t# =============================================================================\n346\t# ROBUST JSON PARSING\n347\t# =============================================================================\n348\t\n349\t\n350\tdef _extract_xml_field(tag: str, s: str) -> Optional[str]:\n351\t    \"\"\"Extract an XML field value, tolerating the malformed tags local models\n352\t    emit. Tries, in order: a well-formed ``<tag>..</tag>``; an open tag with\n353\t    attributes ``<tag x=..>..</tag>``; and a broken open tag with no closing\n354\t    ``>`` such as ``<object(reasoning, tool use)</object>`` (observed from\n355\t    qwen3.5-9b). Returns the cleaned inner value or ``None``.\"\"\"\n356\t    for pat in (\n357\t        rf\"<{tag}>(.*?)</{tag}>\",\n358\t        rf\"<{tag}\\s[^>]*>(.*?)</{tag}>\",\n359\t        rf\"<{tag}\\b(.*?)</{tag}>\",\n360\t    ):\n361\t        m = re.search(pat, s, re.IGNORECASE | re.DOTALL)\n362\t        if m:\n363\t            v = m.group(1).strip()\n364\t            # Broken-open-tag capture can lead with a stray '>' or wrap the\n365\t            # value in the parens the model used in place of '>' .. '<'.\n366\t            if v.startswith(\">\"):\n367\t                v = v[1:].strip()\n368\t            if v.startswith(\"(\") and v.endswith(\")\"):\n369\t                v = v[1:-1].strip()\n370\t            return v\n371\t    return None\n372\t\n373\t\n374\tdef _parse_json_from_llm(text: str) -> Tuple[Any, str]:\n375\t    \"\"\"\n376\t    Robustly extract JSON from LLM output that may contain markdown fences,\n377\t    <think> reasoning blocks, or truncated arrays.\n378\t    Returns (parsed_data, thinking_string).\n379\t    \"\"\"\n380\t    thinking = \"\"\n381\t    # Extract and strip all think blocks\n382\t    cleaned = text\n383\t    think_blocks = re.findall(r\"<think>(.*?)</think>\", cleaned, re.DOTALL)\n384\t    if think_blocks:\n385\t        thinking = \"\\n---\\n\".join([t.strip() for t in think_blocks])\n386\t        cleaned = re.sub(r\"<think>.*?</think>\", \"\", cleaned, flags=re.DOTALL).strip()\n387\t    else:\n388\t        # Fallback for unclosed think block\n389\t        think_match = re.search(r\"<think>(.*)\", cleaned, re.DOTALL)\n390\t        if think_match:\n391\t            thinking = think_match.group(1).strip()\n392\t            cleaned = re.sub(r\"<think>.*\", \"\", cleaned, flags=re.DOTALL).strip()\n393\t\n394\t    # Strip markdown code fences (more robustly)\n395\t    if \"```\" in cleaned:\n396\t        # Try to find content inside ```json ... ``` or just ``` ... ```\n397\t        fence_matches = re.findall(r\"```(?:json)?\\s*\\n?(.*?)\\n?```\", cleaned, re.DOTALL)\n398\t        if fence_matches:\n399\t            # If multiple code blocks, join them or pick the largest?\n400\t            # Usually we want the largest or the first one that is valid.\n401\t            # We'll try to process the whole thing below anyway.\n402\t            pass\n403\t        else:\n404\t            # Fallback: just strip all lines starting with ```\n405\t            lines = cleaned.split(\"\\n\")\n406\t            lines = [l for l in lines if not l.strip().startswith(\"```\")]\n407\t            cleaned = \"\\n\".join(lines).strip()\n408\t\n409\t    # ---------------------------------------------------------\n410\t    # NEW: Indestructible XML Parsing for Rigid Operating Model\n411\t    # ---------------------------------------------------------\n412\t    # If the prompt used XML tags (e.g. <triples>), we parse it via regex to avoid strict syntax errors.\n413\t    xml_data = []\n414\t\n415\t    # 1. Triples\n416\t    if \"<triple>\" in cleaned:\n417\t        for triple_match in re.finditer(\n418\t            r\"<triple>(.*?)</triple>\", cleaned, re.IGNORECASE | re.DOTALL\n419\t        ):\n420\t            t_str = triple_match.group(1)\n421\t            triple = {}\n422\t            for tag in [\n423\t                \"subject\",\n424\t                \"subject_type\",\n425\t                \"predicate\",\n426\t                \"object\",\n427\t                \"object_type\",\n428\t                \"citation\",\n429\t                \"confidence\",\n430\t            ]:\n431\t                val = _extract_xml_field(tag, t_str)\n432\t                if val is not None:\n433\t                    if tag == \"confidence\":\n434\t                        try:\n435\t                            val = float(val)\n436\t                        except:\n437\t                            val = 1.0\n438\t                    triple[tag] = val\n439\t            if \"subject\" in triple and \"object\" in triple:\n440\t                xml_data.append(triple)\n441\t        if xml_data:\n442\t            return xml_data, thinking\n443\t\n444\t    # 2. Conflicts / Analogies (generic list of objects)\n445\t    for root_tag, item_tag in [(\"conflicts\", \"conflict\"), (\"analogies\", \"analogy\")]:\n446\t        if f\"<{item_tag}>\" in cleaned:\n447\t            for match in re.finditer(\n448\t                rf\"<{item_tag}>(.*?)</{item_tag}>\", cleaned, re.IGNORECASE | re.DOTALL\n449\t            ):\n450\t                i_str = match.group(1)\n451\t                item = {}\n452\t                # Extract any child tags generically\n453\t                for tag_match in re.finditer(r\"<([a-zA-Z0-9_]+)>(.*?)</\\1>\", i_str, re.DOTALL):\n454\t                    item[tag_match.group(1).lower()] = tag_match.group(2).strip()\n455\t                if item:\n456\t                    xml_data.append(item)\n457\t            if xml_data:\n458\t                return xml_data, thinking\n459\t\n460\t    # 3. Community (single object)\n461\t    if \"<community_name>\" in cleaned:\n462\t        comm = {}\n463\t        for tag in [\"community_name\", \"justification\", \"analogous_concept\", \"mapping\"]:\n464\t            m = re.search(rf\"<{tag}>(.*?)</{tag}>\", cleaned, re.IGNORECASE | re.DOTALL)\n465\t            if m:\n466\t                comm[tag] = m.group(1).strip()\n467\t        if comm:\n468\t            return comm, thinking\n469\t\n470\t    # ---------------------------------------------------------\n471\t    # JSON Parsing Fallback\n472\t    # ---------------------------------------------------------\n473\t    def score_json(data: Any) -> int:\n474\t        \"\"\"Score JSON based on its complexity/usefulness.\"\"\"\n475\t        if isinstance(data, list):\n476\t            # Bonus for lists as we usually expect arrays of triples\n477\t            return len(data) * 10 + 5\n478\t        if isinstance(data, dict):\n479\t            return len(data.keys())\n480\t        return 0\n481\t\n482\t    best_data = []\n483\t    max_score = -1\n484\t\n485\t    # Try parsing the whole thing first\n486\t    try:\n487\t        data = json.loads(cleaned)\n488\t        max_score = score_json(data)\n489\t        best_data = data\n490\t    except:\n491\t        pass\n492\t\n493\t    # Find all possible start positions for JSON objects or arrays\n494\t    for match in re.finditer(r\"\\{|\\[\", cleaned):\n495\t        start_idx = match.start()\n496\t        start_char = cleaned[start_idx]\n497\t        end_char = \"}\" if start_char == \"{\" else \"]\"\n498\t\n499\t        # Look for the last occurrence of the matching end bracket\n500\t        # and work backwards to find the largest valid JSON.\n501\t        end_matches = list(re.finditer(re.escape(end_char), cleaned[start_idx:]))\n502\t        for end_match in reversed(end_matches):\n503\t            current_end_idx = start_idx + end_match.end()\n504\t            json_str = cleaned[start_idx:current_end_idx]\n505\t\n506\t            # Clean up trailing commas\n507\t            json_str = re.sub(r\",\\s*([\\]}])\", r\"\\1\", json_str)\n508\t\n509\t            try:\n510\t                data = json.loads(json_str)\n511\t                score = score_json(data)\n512\t                if score > max_score:\n513\t                    max_score = score\n514\t                    best_data = data\n515\t            except:\n516\t                continue\n517\t\n518\t    # Final fallback for truncated JSON\n519\t    if max_score <= 5:  # If we only found empty lists or dicts, try harder\n520\t        first_start = re.search(r\"\\{|\\[\", cleaned)\n521\t        if first_start:\n522\t            start_idx = first_start.start()\n523\t            json_str = cleaned[start_idx:]\n524\t\n525\t            # Very aggressive truncation recovery: try adding combinations of closing brackets\n526\t            for i in range(1, 6):\n527\t                for trial_suffix in [\"}\", \"]\", \"}]\", \"]}\", \"}}] \", \"}]}]\"]:\n528\t                    trial = json_str + (trial_suffix * i)\n529\t                    try:\n530\t                        trial_clean = re.sub(r\",\\s*([\\]}])\", r\"\\1\", trial)\n531\t                        data = json.loads(trial_clean)\n532\t                        score = score_json(data)\n533\t                        if score > max_score:\n534\t                            max_score = score\n535\t                            best_data = data\n536\t                    except:\n537\t                        continue\n538\t\n539\t    if max_score > -1:\n540\t        return best_data, thinking\n541\t\n542\t    logger.warning(\"Failed to parse JSON from LLM output (%d chars).\", len(text))\n543\t    # Optionally save the raw output for inspection. Gated behind BENNY_DEBUG_LLM\n544\t    # and written to the system temp dir — the old unconditional os.getcwd()\n545\t    # dump littered the repo/working dir with failed_llm_output_*.txt files.\n546\t    if os.environ.get(\"BENNY_DEBUG_LLM\"):\n547\t        try:\n548\t            import tempfile\n549\t\n550\t            debug_path = os.path.join(\n551\t                tempfile.gettempdir(),\n552\t                f\"failed_llm_output_{int(asyncio.get_event_loop().time())}.txt\",\n553\t            )\n554\t            with open(debug_path, \"w\", encoding=\"utf-8\") as f:\n555\t                f.write(text)\n556\t            logger.info(\"Saved failed LLM output to %s\", debug_path)\n557\t        except Exception:\n558\t            pass\n559\t    return [], thinking\n560\t\n561\t\n562\t# =============================================================================\n563\t# DEDUPLICATION & QUALITY FILTERING\n564\t# =============================================================================\n565\t\n566\t\n567\tdef deduplicate_triples(triples: List[KnowledgeTriple]) -> List[KnowledgeTriple]:\n568\t    \"\"\"Remove near-duplicate triples using normalized subject|predicate|object keys.\"\"\"\n569\t    seen = set()\n570\t    unique = []\n571\t    for t in triples:\n572\t        key = t.normalized_key\n573\t        if key not in seen:\n574\t            seen.add(key)\n575\t            unique.append(t)\n576\t        else:\n577\t            logger.debug(\"Deduplicated triple: %s\", key)\n578\t    if len(triples) != len(unique):\n579\t        logger.info(\n580\t            \"Deduplication: %d -> %d triples (removed %d duplicates)\",\n581\t            len(triples),\n582\t            len(unique),\n583\t            len(triples) - len(unique),\n584\t        )\n585\t    return unique\n586\t\n587\t\n588\tdef filter_by_confidence(\n589\t    triples: List[KnowledgeTriple], min_confidence: float = 0.3\n590\t) -> List[KnowledgeTriple]:\n591\t    \"\"\"Discard low-confidence triples below the threshold.\"\"\"\n592\t    filtered = [t for t in triples if t.confidence >= min_confidence]\n593\t    removed = len(triples) - len(filtered)\n594\t    if removed:\n595\t        logger.info(\n596\t            \"Confidence filter: removed %d low-confidence triples (threshold=%.2f)\",\n597\t            removed,\n598\t            min_confidence,\n599\t        )\n600\t    return filtered\n601\t\n602\t\n603\tdef _validate_and_convert_triples(\n604\t    raw_triples: Any,\n605\t    section_title: str = \"\",\n606\t    config: Optional[SynthesisConfig] = None,\n607\t    model_id: str = \"unknown\",\n608\t    strategy: str = \"safe\",\n609\t) -> List[KnowledgeTriple]:\n610\t    \"\"\"Convert raw LLM JSON output into validated KnowledgeTriple models.\"\"\"\n611\t    cfg = config or SynthesisConfig()\n612\t\n613\t    if not isinstance(raw_triples, list):\n614\t        return []\n615\t\n616\t    valid = []\n617\t    for t in raw_triples:\n618\t        if isinstance(t, dict) and \"subject\" in t and \"predicate\" in t and \"object\" in t:\n619\t            try:\n620\t                triple = KnowledgeTriple(\n621\t                    subject=t.get(\"subject\", \"\"),\n622\t                    subject_type=t.get(\"subject_type\", \"Concept\"),\n623\t                    predicate=t.get(\"predicate\", \"\"),\n624\t                    object=t.get(\"object\", \"\"),\n625\t                    object_type=t.get(\"object_type\", \"Concept\"),\n626\t                    citation=t.get(\"citation\", \"\"),\n627\t                    confidence=float(t.get(\"confidence\", 1.0)),\n628\t                    section_title=section_title or t.get(\"section_title\", \"\"),\n629\t                    model_id=model_id,\n630\t                    strategy=strategy,\n631\t                )\n632\t                valid.append(triple)\n633\t            except Exception as e:\n634\t                logger.debug(\"Skipping invalid triple: %s\", e)\n635\t\n636\t    # Apply confidence filter\n637\t    valid = filter_by_confidence(valid, cfg.min_confidence)\n638\t\n639\t    return valid\n640\t\n641\t\n642\t# =============================================================================\n643\t# TRIPLE EXTRACTION\n644\t# =============================================================================\n645\t\n646\t\n647\tasync def extract_triples(\n648\t    text: str,\n649\t    source_name: str = \"unknown\",\n650\t    run_id: Optional[str] = None,\n651\t    workspace: Optional[str] = \"default\",\n652\t    config: Optional[SynthesisConfig] = None,\n653\t    strategy: str = \"safe\",\n654\t    timeout: Optional[float] = None,\n655\t) -> List[KnowledgeTriple]:\n656\t    \"\"\"\n657\t    Extract knowledge triples from text using the configured LLM.\n658\t    Uses adaptive chunking instead of hardcoded truncation.\n659\t    \"\"\"\n660\t    cfg = config or SynthesisConfig()\n661\t\n662\t    # Use adaptive chunking to fit the model's context window\n663\t    safe_text = adaptive_truncate(text, cfg.max_context_tokens)\n664\t    prompt = TRIPLE_EXTRACTION_PROMPT.format(text=safe_text)\n665\t\n666\t    try:\n667\t        # Resolve model_id to track provenance\n668\t        from ..core.models import get_active_model\n669\t\n670\t        resolved_model = await get_active_model(workspace)\n671\t\n672\t        # Pass workspace and role to ensure manifest-level model selection\n673\t        raw = await call_llm(\n674\t            prompt,\n675\t            run_id=run_id,\n676\t            workspace=workspace,\n677\t            config=cfg,\n678\t            role=\"graph_synthesis\",\n679\t            timeout=timeout,\n680\t        )\n681\t\n682\t        # Robustly parse JSON and capture any reasoning/thinking blocks\n683\t        triples_data, thinking = _parse_json_from_llm(raw)\n684\t\n685\t        if thinking and run_id:\n686\t            from ..core.task_manager import task_manager\n687\t\n688\t            task_manager.add_aer_entry(\n689\t                run_id,\n690\t                intent=f\"Synthesis extraction for {source_name}\",\n691\t                observation=\"Reasoning detected\",\n692\t                inference=thinking,\n693\t            )\n694\t\n695\t        return _validate_and_convert_triples(\n696\t            triples_data,\n697\t            section_title=source_name,\n698\t            config=cfg,\n699\t            model_id=resolved_model,\n700\t            strategy=strategy,\n701\t        )\n702\t\n703\t    except Exception as e:\n704\t        logger.error(f\"Extraction failed for {source_name}: {e}\")\n705\t        return []\n706\t\n707\t\n708\tasync def name_community(\n709\t    concepts: List[str], workspace: str = \"default\", run_id: Optional[str] = None\n710\t) -> Dict[str, str]:\n711\t    \"\"\"\n712\t    Generate a concise name and justification for a semantic community.\n713\t    \"\"\"\n714\t    prompt = COMMUNITY_NAMING_PROMPT.format(concepts=\", \".join(concepts[:50]))\n715\t    try:\n716\t        raw = await call_llm(prompt, run_id=run_id, workspace=workspace)\n717\t        data, thinking = _parse_json_from_llm(raw)\n718\t        if isinstance(data, dict) and \"community_name\" in data:\n719\t            return data\n720\t        return {\"community_name\": f\"Community {concepts[0][:10]}\", \"justification\": \"Fallback name\"}\n721\t    except Exception as e:\n722\t        logger.error(f\"Community naming failed: {e}\")\n723\t        return {\"community_name\": \"Unknown Cluster\", \"justification\": str(e)}\n724\t\n725\t\n726\tasync def extract_directed_triples_from_section(\n727\t    text: str,\n728\t    section_title: str,\n729\t    direction: str = \"\",\n730\t    workspace: str = \"default\",\n731\t    run_id: Optional[str] = None,\n732\t    provider: str = \"lemonade\",\n733\t    model: str = None,\n734\t    strategy: str = \"safe\",\n735\t    inference_delay: float = 0.5,\n736\t    timeout: Optional[float] = None,\n737\t    config: Optional[SynthesisConfig] = None,\n738\t) -> List[KnowledgeTriple]:\n739\t    \"\"\"\n740\t    Extract L2 points from a document section, optionally influenced by user direction.\n741\t    \"\"\"\n742\t    cfg = config or SynthesisConfig()\n743\t\n744\t    # Optional delay to protect local NPU/CPU from thermal throttling\n745\t    actual_delay = inference_delay if inference_delay > 0 else cfg.inference_delay\n746\t    if actual_delay > 0:\n747\t        await asyncio.sleep(actual_delay)\n748\t\n749\t    safe_text = adaptive_truncate(text, cfg.max_context_tokens)\n750\t\n751\t    dir_prompt = \"\"\n752\t    if direction.strip():\n753\t        dir_prompt = f\"DIRECTION / INTENT:\\nThe user is specifically looking for: '{direction}'. Focus heavily on points that help answer this intent.\"\n754\t\n755\t    prompt = DIRECTED_EXTRACTION_PROMPT.format(\n756\t        direction_prompt=dir_prompt, section_title=section_title, text=safe_text\n757\t    )\n758\t\n759\t    # Resolve model_id to track provenance\n760\t    from ..core.models import get_active_model\n761\t\n762\t    resolved_model = await get_active_model(workspace)\n763\t\n764\t    raw = await call_llm(\n765\t        prompt,\n766\t        provider=provider,\n767\t        model=model or resolved_model,\n768\t        timeout=timeout,\n769\t        config=cfg,\n770\t        run_id=run_id,\n771\t        role=\"graph_synthesis\",\n772\t        # Thread the workspace so the per-model thinking toggle reaches call_model;\n773\t        # without it, reasoning models (e.g. Qwen3-8B-Hybrid) keep thinking and\n774\t        # emit no parseable JSON → empty knowledge graph.\n775\t        workspace=workspace,\n776\t    )\n777\t\n778\t    raw_triples, thinking = _parse_json_from_llm(raw)\n779\t\n780\t    if thinking and run_id:\n781\t        from ..core.task_manager import task_manager\n782\t\n783\t        task_manager.add_aer_entry(\n784\t            run_id,\n785\t            intent=f\"Extracting section: {section_title}\",\n786\t            observation=\"Reasoning detected\",\n787\t            inference=thinking,\n788\t        )\n789\t\n790\t    return _validate_and_convert_triples(\n791\t        raw_triples,\n792\t        section_title=section_title,\n793\t        config=cfg,\n794\t        model_id=resolved_model,\n795\t        strategy=strategy,\n796\t    )\n797\t\n798\t\n799\tasync def parallel_extract_triples(\n800\t    sections: List[Dict[str, str]],\n801\t    direction: str = \"\",\n802\t    provider: str = \"lemonade\",\n803\t    model: str = None,\n804\t    parallel_limit: Optional[int] = None,\n805\t    inference_delay: float = 0.5,\n806\t    timeout: Optional[float] = None,\n807\t    config: Optional[SynthesisConfig] = None,\n808\t    event_callback: Optional[Callable] = None,\n809\t    workspace: str = \"default\",\n810\t    run_id: Optional[str] = None,\n811\t    **kwargs,\n812\t) -> List[KnowledgeTriple]:\n813\t    \"\"\"\n814\t    Process multiple document sections in parallel for high-performance ingestion.\n815\t    Uses an asyncio.Semaphore to prevent overloading the LLM provider.\n816\t    Emits progress events via event_callback if provided.\n817\t    \"\"\"\n818\t    cfg = config or SynthesisConfig()\n819\t    actual_limit = parallel_limit or cfg.parallel_limit\n820\t    semaphore = asyncio.Semaphore(actual_limit)\n821\t    total = len(sections)\n822\t\n823\t    async def wrapped_extract(idx: int, section: Dict[str, str]):\n824\t        async with semaphore:\n825\t            logger.info(\"Extracting section %d/%d: %s\", idx + 1, total, section[\"title\"])\n826\t            if event_callback:\n827\t                await event_callback(\n828\t                    IngestionEvent(\n829\t                        event=IngestionEventType.SECTION_PROGRESS,\n830\t                        message=f\"Processing section {idx + 1}/{total}: {section['title']}\",\n831\t                        data={\"current\": idx + 1, \"total\": total, \"section\": section[\"title\"]},\n832\t                    )\n833\t                )\n834\t            return await extract_directed_triples_from_section(\n835\t                text=section[\"text\"],\n836\t                section_title=section[\"title\"],\n837\t                direction=direction,\n838\t                provider=provider,\n839\t                model=model,\n840\t                inference_delay=inference_delay,\n841\t                timeout=timeout,\n842\t                config=cfg,\n843\t                run_id=run_id,\n844\t                workspace=workspace,\n845\t            )\n846\t\n847\t    # Launch parallel tasks\n848\t    tasks = [wrapped_extract(i, section) for i, section in enumerate(sections)]\n849\t    results = await asyncio.gather(*tasks, return_exceptions=True)\n850\t\n851\t    # Flatten results, handling exceptions gracefully\n852\t    flat_triples: List[KnowledgeTriple] = []\n853\t    for i, result in enumerate(results):\n854\t        if isinstance(result, Exception):\n855\t            logger.error(\"Section %d extraction failed: %s\", i + 1, result)\n856\t        elif isinstance(result, list):\n857\t            flat_triples.extend(result)\n858\t\n859\t    # Deduplicate across all sections\n860\t    if cfg.deduplicate:\n861\t        flat_triples = deduplicate_triples(flat_triples)\n862\t\n863\t    if event_callback:\n864\t        await event_callback(\n865\t            IngestionEvent(\n866\t                event=IngestionEventType.TRIPLES_EXTRACTED,\n867\t                message=f\"Extraction complete: {len(flat_triples)} triples\",\n868\t                data={\"count\": len(flat_triples)},\n869\t            )\n870\t        )\n871\t\n872\t    return flat_triples\n873\t\n874\t\n875\t# =============================================================================\n876\t# CONFLICT DETECTION\n877\t# =============================================================================\n878\t\n879\t\n880\tasync def detect_conflicts(\n881\t    existing_triples: List[Any],\n882\t    new_triples: List[Any],\n883\t    workspace: str = \"default\",\n884\t    provider: str = \"lemonade\",\n885\t    model: str = None,\n886\t    timeout: Optional[float] = None,\n887\t    config: Optional[SynthesisConfig] = None,\n888\t    run_id: Optional[str] = None,\n889\t) -> List[Dict[str, str]]:\n890\t    \"\"\"Detect logical conflicts between existing and new triples.\"\"\"\n891\t    cfg = config or SynthesisConfig()\n892\t\n893\t    if not existing_triples or not new_triples:\n894\t        return []\n895\t\n896\t    # Serialize triples for prompt — handle both KnowledgeTriple and raw dicts/lists\n897\t    def serialize(triples, limit):\n898\t        items = triples[:limit]\n899\t        serialized = []\n900\t        for t in items:\n901\t            if isinstance(t, KnowledgeTriple):\n902\t                serialized.append(t.model_dump())\n903\t            elif isinstance(t, dict):\n904\t                serialized.append(t)\n905\t            elif isinstance(t, list) and len(t) >= 3:\n906\t                serialized.append({\"subject\": t[0], \"predicate\": t[1], \"object\": t[2]})\n907\t        return serialized\n908\t\n909\t    prompt = CONFLICT_DETECTION_PROMPT.format(\n910\t        existing=json.dumps(serialize(existing_triples, cfg.max_conflict_triples)),\n911\t        new_triples=json.dumps(serialize(new_triples, cfg.max_conflict_triples)),\n912\t    )\n913\t\n914\t    try:\n915\t        raw = await call_llm(\n916\t            prompt,\n917\t            provider=provider,\n918\t            model=model,\n919\t            timeout=timeout,\n920\t            config=cfg,\n921\t            workspace=workspace,\n922\t            run_id=run_id,\n923\t        )\n924\t\n925\t        conflicts, thinking = _parse_json_from_llm(raw)\n926\t\n927\t        if thinking and run_id:\n928\t            from ..core.task_manager import task_manager\n929\t\n930\t            task_manager.add_aer_entry(\n931\t                run_id,\n932\t                intent=\"Detecting conflicts\",\n933\t                observation=\"Reasoning detected\",\n934\t                inference=thinking,\n935\t            )\n936\t\n937\t        if not isinstance(conflicts, list):\n938\t            return []\n939\t\n940\t        return [c for c in conflicts if isinstance(c, dict) and \"concept_a\" in c]\n941\t    except Exception as e:\n942\t        logger.warning(\"Conflict detection bypassed: LLM call failed (%s)\", e)\n943\t        return []\n944\t\n945\t\n946\t# =============================================================================\n947\t# SYNTHESIS & ANALOGIES\n948\t# =============================================================================\n949\t\n950\t\n951\tasync def find_synthesis(\n952\t    graph_summary: str,\n953\t    workspace: str = \"default\",\n954\t    provider: str = \"lemonade\",\n955\t    model: str = None,\n956\t    timeout: Optional[float] = None,\n957\t    config: Optional[SynthesisConfig] = None,\n958\t    run_id: Optional[str] = None,\n959\t) -> List[Dict[str, str]]:\n960\t    \"\"\"Find structural isomorphisms in the knowledge graph.\"\"\"\n961\t    cfg = config or SynthesisConfig()\n962\t    prompt = SYNTHESIS_PROMPT.format(graph_summary=graph_summary)\n963\t\n964\t    raw = await call_llm(\n965\t        prompt,\n966\t        provider=provider,\n967\t        model=model,\n968\t        timeout=timeout,\n969\t        config=cfg,\n970\t        workspace=workspace,\n971\t        run_id=run_id,\n972\t    )\n973\t\n974\t    analogies, thinking = _parse_json_from_llm(raw)\n975\t\n976\t    if thinking and run_id:\n977\t        from ..core.task_manager import task_manager\n978\t\n979\t        task_manager.add_aer_entry(\n980\t            run_id,\n981\t            intent=\"Searching for synthesis/analogies\",\n982\t            observation=\"Reasoning detected\",\n983\t            inference=thinking,\n984\t        )\n985\t\n986\t    if not isinstance(analogies, list):\n987\t        return []\n988\t\n989\t    return [a for a in analogies if isinstance(a, dict) and \"concept_a\" in a]\n990\t\n991\t\n992\tasync def cross_domain_analogy(\n993\t    concept: str,\n994\t    relationships: str,\n995\t    target_domain: str,\n996\t    workspace: str = \"default\",\n997\t    provider: str = \"lemonade\",\n998\t    model: str = None,\n999\t    timeout: Optional[float] = None,\n1000\t    config: Optional[SynthesisConfig] = None,\n1001\t    run_id: Optional[str] = None,\n1002\t) -> Dict[str, Any]:\n1003\t    \"\"\"Map a concept into a different domain.\"\"\"\n1004\t    cfg = config or SynthesisConfig()\n1005\t    prompt = CROSS_DOMAIN_PROMPT.format(\n1006\t        concept=concept, relationships=relationships, target_domain=target_domain\n1007\t    )\n1008\t\n1009\t    raw = await call_llm(\n1010\t        prompt,\n1011\t        provider=provider,\n1012\t        model=model,\n1013\t        timeout=timeout,\n1014\t        config=cfg,\n1015\t        workspace=workspace,\n1016\t        run_id=run_id,\n1017\t    )\n1018\t\n1019\t    result, thinking = _parse_json_from_llm(raw)\n1020\t\n1021\t    if thinking and run_id:\n1022\t        from ..core.task_manager import task_manager\n1023\t\n1024\t        task_manager.add_aer_entry(\n1025\t            run_id,\n1026\t            intent=f\"Generating cross-domain analogy: {target_domain}\",\n1027\t            observation=\"Reasoning detected\",\n1028\t            inference=thinking,\n1029\t        )\n1030\t\n1031\t    if isinstance(result, dict):\n1032\t        return result\n1033\t    return {\"error\": \"Could not generate cross-domain analogy\", \"raw\": raw}\n1034\t\n1035\t\n1036\t# =============================================================================\n1037\t# B. CONCEPTUAL CLUSTER - Dual-Model Embedding\n1038\t# =============================================================================\n1039\t\n1040\t\n1041\tasync def get_embedding(\n1042\t    text: str,\n1043\t    provider: str = \"local\",\n1044\t    model: str = None,\n1045\t    workspace: Optional[str] = None,\n1046\t    role: str = \"graph_synthesis\",\n1047\t) -> List[float]:\n1048\t    \"\"\"\n1049\t    Get a vector embedding for text using either a local or cloud provider.\n1050\t\n1051\t    Providers:\n1052\t        - \"local\" / \"ollama\": Uses ollama's embedding endpoint\n1053\t        - \"openai\": Uses OpenAI text-embedding-3-small\n1054\t    \"\"\"\n1055\t    if provider == \"openai\":\n1056\t        return await _get_openai_embedding(text, model or \"text-embedding-3-small\")\n1057\t\n1058\t    # Resolve 'local' to the actual active provider if possible\n1059\t    if provider == \"local\":\n1060\t        try:\n1061\t            from ..core.models import get_active_model\n1062\t\n1063\t            active_id = await get_active_model(\n1064\t                workspace_id=workspace or \"default\", role=\"graph_synthesis\"\n1065\t            )\n1066\t            if \"/\" in active_id:\n1067\t                provider = active_id.split(\"/\")[0]\n1068\t            else:\n1069\t                provider = \"lemonade\"  # Default fallback for local\n1070\t        except Exception:\n1071\t            provider = \"ollama\"  # Final fallback\n1072\t\n1073\t    if provider == \"ollama\":\n1074\t        return await _get_ollama_embedding(text, model or \"nomic-embed-text\")\n1075\t    else:\n1076\t        # For 'lemonade', 'fastflowlm', or other OpenAI-compatible local endpoints\n1077\t        return await _get_generic_local_embedding(text, provider, model)\n1078\t\n1079\t\n1080\tasync def _get_generic_local_embedding(text: str, provider: str, model: str = None) -> List[float]:\n1081\t    \"\"\"Get embedding from an OpenAI-compatible local AI endpoint (e.g. Lemonade).\"\"\"\n1082\t    provider_config = LOCAL_PROVIDERS.get(provider)\n1083\t    if not provider_config:\n1084\t        raise ValueError(f\"Unknown local provider for embedding: {provider}\")\n1085\t\n1086\t    api_base = provider_config[\"base_url\"]\n1087\t    url = f\"{api_base}/embeddings\"\n1088\t\n1089\t    model_name = model.split(\"/\")[-1] if model else \"default\"\n1090\t\n1091\t    # FastFlowLM and Lemonade throw errors if a Chat model is passed to the Embeddings endpoint.\n1092\t    if provider == \"lemonade\" and model_name == \"default\":\n1093\t        model_name = \"nomic-embed-text-v1-GGUF\"\n1094\t\n1095\t    client = _get_shared_client()\n1096\t    try:\n1097\t        response = await client.post(url, json={\"model\": model_name, \"input\": text})\n1098\t        if response.status_code == 200:\n1099\t            data = response.json()\n1100\t            return data[\"data\"][0][\"embedding\"]\n1101\t        else:\n1102\t            logger.warning(f\"{provider} embedding failed ({response.status_code}): {response.text}\")\n1103\t            return [0.0] * 768\n1104\t    except Exception as e:\n1105\t        logger.error(f\"Failed to connect to {provider} embedding endpoint: {e}\")\n1106\t        return [0.0] * 768\n1107\t\n1108\t\n1109\tasync def _get_ollama_embedding(text: str, model: str = \"nomic-embed-text\") -> List[float]:\n1110\t    \"\"\"Get embedding from Ollama /api/embeddings endpoint.\"\"\"\n1111\t    url = \"http://localhost:11434/api/embeddings\"\n1112\t    client = _get_shared_client()\n1113\t    response = await client.post(url, json={\"model\": model, \"prompt\": text})\n1114\t    if response.status_code == 200:\n1115\t        data = response.json()\n1116\t        return data.get(\"embedding\", [])\n1117\t    else:\n1118\t        raise Exception(f\"Ollama embedding failed: {response.status_code}\")\n1119\t\n1120\t\n1121\tasync def _get_openai_embedding(text: str, model: str = \"text-embedding-3-small\") -> List[float]:\n1122\t    \"\"\"Get embedding from OpenAI API.\"\"\"\n1123\t    import openai\n1124\t\n1125\t    client_obj = openai.AsyncOpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\", \"\"))\n1126\t    response = await client_obj.embeddings.create(input=text, model=model)\n1127\t    return response.data[0].embedding\n1128\t\n1129\t\n1130\tasync def batch_embed_concepts(\n1131\t    concepts: List[str],\n1132\t    provider: str = \"local\",\n1133\t    model: str = None,\n1134\t    batch_size: int = 16,\n1135\t    event_callback: Optional[Any] = None,\n1136\t    workspace: Optional[str] = None,\n1137\t) -> Dict[str, List[float]]:\n1138\t    \"\"\"\n1139\t    Embed multiple concepts concurrently with database-backed caching.\n1140\t\n1141\t    Logic:\n1142\t    1. Check Neo4j for existing embeddings for these concepts in this workspace.\n1143\t    2. Only send missing ones to the LLM provider.\n1144\t    3. Save newly generated embeddings back to Neo4j.\n1145\t    \"\"\"\n1146\t    from ..core.graph_db import read_session, write_session\n1147\t\n1148\t    results: Dict[str, List[float]] = {}\n1149\t    missing_concepts: List[str] = []\n1150\t\n1151\t    # 1. Check Cache (Neo4j)\n1152\t    if workspace:\n1153\t        logger.info(\"Embedding Cache: checking Neo4j for %d existing vectors...\", len(concepts))\n1154\t        with read_session() as session:\n1155\t            # We check both Concepts (by name) and CodeEntities (by name: summary)\n1156\t            # This is a broad check for anything in the workspace with an embedding.\n1157\t            query = \"\"\"\n1158\t            MATCH (n {workspace: $ws})\n1159\t            WHERE n.embedding IS NOT NULL AND (n.name IN $names OR (n.name + ': ' + coalesce(n.summary, '')) IN $names)\n1160\t            RETURN n.name as name, n.summary as summary, n.embedding as embedding\n1161\t            \"\"\"\n1162\t            cache_res = session.run(query, ws=workspace, names=concepts)\n1163\t            for rec in cache_res:\n1164\t                key = rec[\"name\"]\n1165\t                # Match the 'name: summary' format used in correlation\n1166\t                if rec[\"summary\"] and f\"{rec['name']}: {rec['summary']}\" in concepts:\n1167\t                    key = f\"{rec['name']}: {rec['summary']}\"\n1168\t                results[key] = rec[\"embedding\"]\n1169\t\n1170\t        logger.info(\"Embedding Cache: found %d/%d vectors in Neo4j\", len(results), len(concepts))\n1171\t\n1172\t    missing_concepts = [c for c in concepts if c not in results]\n1173\t    if not missing_concepts:\n1174\t        return results\n1175\t\n1176\t    # 2. Embed Missing via LLM\n1177\t    logger.info(\n1178\t        \"Embedding: sending %d missing items to %s provider...\", len(missing_concepts), provider\n1179\t    )\n1180\t    semaphore = asyncio.Semaphore(batch_size)\n1181\t    total = len(missing_concepts)\n1182\t    completed = 0\n1183\t\n1184\t    async def embed_one(concept: str):\n1185\t        nonlocal completed\n1186\t        async with semaphore:\n1187\t            try:\n1188\t                embedding = await get_embedding(\n1189\t                    concept, provider=provider, model=model, workspace=workspace\n1190\t                )\n1191\t                results[concept] = embedding\n1192\t                completed += 1\n1193\t                if event_callback:\n1194\t                    await event_callback(\n1195\t                        IngestionEvent(\n1196\t                            event=IngestionEventType.SECTION_PROGRESS,\n1197\t                            message=f\"Embedded {completed}/{total} new items\",\n1198\t                            data={\"current\": completed, \"total\": total},\n1199\t                        )\n1200\t                    )\n1201\t\n1202\t                # 3. Save back to Neo4j (Async/Background)\n1203\t                if workspace:\n1204\t                    # We determine if it's a Concept or CodeEntity by splitting\n1205\t                    is_symbol = \": \" in concept\n1206\t                    name = concept.split(\": \")[0] if is_symbol else concept\n1207\t                    summary = concept.split(\": \")[1] if is_symbol else None\n1208\t\n1209\t                    with write_session() as w_session:\n1210\t                        save_query = \"\"\"\n1211\t                        MATCH (n {workspace: $ws, name: $name})\n1212\t                        WHERE ($summary IS NULL OR n.summary = $summary)\n1213\t                        SET n.embedding = $embedding\n1214\t                        \"\"\"\n1215\t                        w_session.run(\n1216\t                            save_query,\n1217\t                            ws=workspace,\n1218\t                            name=name,\n1219\t                            summary=summary,\n1220\t                            embedding=embedding,\n1221\t                        )\n1222\t\n1223\t            except Exception as e:\n1224\t                logger.error(f\"Failed to embed '{concept[:30]}...': {e}\")\n1225\t                results[concept] = [0.0] * 768\n1226\t\n1227\t    tasks = [embed_one(c) for c in missing_concepts]\n1228\t    await asyncio.gather(*tasks)\n1229\t    return results\n1230\t\n1231\t\n1232\tasync def compute_cluster_similarities(\n1233\t    concepts: List[str], workspace: str = \"default\", threshold: float = 0.75\n1234\t) -> List[Dict[str, Any]]:\n1235\t    \"\"\"\n1236\t    Compute pairwise similarities for a list of concepts using their stored embeddings.\n1237\t    Returns pairs above the threshold - this powers the \"Venn\" clustering.\n1238\t    \"\"\"\n1239\t    from math import sqrt\n1240\t\n1241\t    from ..core.graph_db import get_driver\n1242\t\n1243\t    driver = get_driver()\n1244\t    embeddings = {}\n1245\t\n1246\t    with driver.session() as session:\n1247\t        for concept in concepts:\n1248\t            result = session.run(\n1249\t                \"\"\"\n1250\t                MATCH (c:Concept {name: $name, workspace: $workspace})\n1251\t                RETURN c.embedding AS embedding\n1252\t            \"\"\",\n1253\t                name=concept,\n1254\t                workspace=workspace,\n1255\t            )\n1256\t            record = result.single()\n1257\t            if record and record[\"embedding\"]:\n1258\t                embeddings[concept] = record[\"embedding\"]\n1259\t\n1260\t    # Pairwise cosine similarity\n1261\t    def cosine_sim(a, b):\n1262\t        dot = sum(x * y for x, y in zip(a, b))\n1263\t        na = sqrt(sum(x * x for x in a))\n1264\t        nb = sqrt(sum(x * x for x in b))\n1265\t        return dot / (na * nb) if (na and nb) else 0.0\n1266\t\n1267\t    clusters = []\n1268\t    concept_list = list(embeddings.keys())\n1269\t    for i in range(len(concept_list)):\n1270\t        for j in range(i + 1, len(concept_list)):\n1271\t            sim = cosine_sim(embeddings[concept_list[i]], embeddings[concept_list[j]])\n1272\t            if sim >= threshold:\n1273\t                clusters.append(\n1274\t                    {\n1275\t                        \"concept_a\": concept_list[i],\n1276\t                        \"concept_b\": concept_list[j],\n1277\t                        \"similarity\": round(sim, 4),\n1278\t                    }\n1279\t                )\n1280\t\n1281\t    clusters.sort(key=lambda x: x[\"similarity\"], reverse=True)\n1282\t    return clusters\n1283\t\n1284\t\n1285\t# =============================================================================\n1286\t# C. LIBRARIAN - Synthesis Wiki Persistence (Karpathy-style)\n1287\t# =============================================================================\n1288\t\n1289\t\n1290\tasync def save_concept_article(\n1291\t    workspace: str,\n1292\t    concept_name: str,\n1293\t    summary: str,\n1294\t    relationships: List[Dict[str, str]],\n1295\t    source_files: List[str],\n1296\t) -> str:\n1297\t    \"\"\"\n1298\t    Generate and save a 'Rationale Hub' article as a Markdown file in .benny/wiki/.\n1299\t    This creates the permanent 'Compounding Artifact' record.\n1300\t    \"\"\"\n1301\t    from ..core.workspace import get_workspace_path\n1302\t\n1303\t    wiki_path = get_workspace_path(workspace) / \".benny\" / \"wiki\"\n1304\t    wiki_path.mkdir(parents=True, exist_ok=True)\n1305\t\n1306\t    filename = re.sub(r\"[^a-zA-Z0-9]\", \"_\", concept_name) + \".md\"\n1307\t    file_path = wiki_path / filename\n1308\t\n1309\t    # Format relationships for the wiki\n1310\t    rel_md = \"\\n\".join(\n1311\t        [\n1312\t            f\"- **{r['predicate'].title()}**: {r['object']} ({r['object_type']})\"\n1313\t            for r in relationships\n1314\t        ]\n1315\t    )\n1316\t    sources_md = \"\\n\".join([f\"- {s}\" for s in source_files])\n1317\t\n1318\t    content = f\"\"\"# {concept_name}\n1319\t\n1320\t## 💡 Rationale Summary\n1321\t{summary}\n1322\t\n1323\t## 🔗 Semantic Connections (Knowledge Graph)\n1324\t{rel_md}\n1325\t\n1326\t## 📂 Source Context (Lineage)\n1327\t{sources_md}\n1328\t\n1329\t---\n1330\t*Generated by Benny Synthesis Engine. This is a Compounding Rationale Hub.*\n1331\t\"\"\"\n1332\t\n1333\t    with open(file_path, \"w\", encoding=\"utf-8\") as f:\n1334\t        f.write(content.strip())\n1335\t\n1336\t    return str(file_path)\n1337\t"}]},"uuid":"40d335fa-acb6-4091-ab67-55b7e176e7f1","timestamp":"2026-06-28T15:14:00.282Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\synthesis\\engine.py","content":"\"\"\"\nSynthesis Engine - LLM-powered triple extraction, embedding, and structural synthesis.\n\nThis module contains the three \"Logic Layers\":\n  A. Relational Graph (NER + Relation Extraction -> triples)\n  B. Conceptual Cluster (Dual-model embedding -> Venn clustering)\n  C. Synthesis Layer (Structural Isomorphism detection)\n\"\"\"\n\nimport asyncio\nimport json\nimport logging\nimport os\nimport re\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\nimport httpx\n\nfrom ..core.models import LOCAL_PROVIDERS, call_model\nfrom ..core.schema import IngestionEvent, IngestionEventType, KnowledgeTriple, SynthesisConfig\n\nlogger = logging.getLogger(__name__)\n\n# Module-level shared httpx client for connection reuse\n_shared_client: Optional[httpx.AsyncClient] = None\n\n\ndef _get_shared_client() -> httpx.AsyncClient:\n    \"\"\"Get or create a shared httpx client with connection pooling.\"\"\"\n    global _shared_client\n    if _shared_client is None or _shared_client.is_closed:\n        _shared_client = httpx.AsyncClient(\n            timeout=httpx.Timeout(300.0, connect=10.0),\n            limits=httpx.Limits(max_connections=20, max_keepalive_connections=10),\n        )\n    return _shared_client\n\n\n# =============================================================================\n# A. RELATIONAL GRAPH - Triple Extraction via LLM\n# =============================================================================\n\nTRIPLE_EXTRACTION_PROMPT = \"\"\"You are a knowledge graph extraction engine.\nGiven the following text, extract ALL meaningful knowledge triples in the form:\n  (Subject, Predicate, Object)\n\nRules:\n- Subject and Object should be concise noun phrases (concepts, entities, processes).\n- Predicate should be a verb phrase describing the relationship.\n- Extract as many triples as you can find. Be thorough.\n- CROSS-LINKING: If the text describes a design decision, architecture, or pattern, try to link it to potential code symbols or files (e.g., \"AuthenticationService\", \"schema.py\").\n- If the text mentions a source document name, include triples that reference it.\n\nOutput format (STRICT):\n- Respond with ONLY the XML below. Start your reply directly with <triples>.\n- Do NOT use Markdown, bullet/numbered lists, prose, code fences, or <think> tags.\n- Every tag must be well-formed: <object>value</object> (never <object(value)</object>).\n\n<triples>\n  <triple>\n    <subject>Dopamine</subject>\n    <subject_type>Biology</subject_type>\n    <predicate>drives</predicate>\n    <object>reward-seeking behavior</object>\n    <object_type>Concept</object_type>\n    <citation>Dopamine is responsible for...</citation>\n    <confidence>0.95</confidence>\n  </triple>\n</triples>\n\nTEXT:\n{text}\n\nXML TRIPLES:\"\"\"\n\n\nDIRECTED_EXTRACTION_PROMPT = \"\"\"You are an L2 expert reading a specific section of a document.\nYour goal is to extract ALL core points, arguments, or mechanisms made in this section.\n\n{direction_prompt}\n\nRules for Extraction:\n1. Extract as many meaningful triples as you can find. Be thorough.\n2. Filter out any noise; only extract points structurally relevant to the direction (if provided).\n3. \"subject_type\" and \"object_type\" should categorize the entity (e.g., Person, Theory, Technology, Organization, Location, Event, Concept).\n4. \"citation\" must be the exact short sentence/excerpt from the text that justifies the claim.\n5. \"confidence\" should be a score from 0.0 to 1.0 (1.0 = proven/stated as fact, 0.5 = hypothesized).\n\nTEXT SECTION: {section_title}\n{text}\n\nOutput format (STRICT): respond with ONLY the XML block below, starting\ndirectly with <triples>. No Markdown, lists, prose, code fences, or <think>\ntags. Every tag must be well-formed (<object>value</object>). Example:\n<triples>\n  <triple>\n    <subject>Dopamine</subject>\n    <subject_type>Biology</subject_type>\n    <predicate>drives</predicate>\n    <object>Reward-Seeking Behavior</object>\n    <object_type>Concept</object_type>\n    <citation>Dopamine is responsible for the reward-seeking loop in mammalian brains.</citation>\n    <confidence>0.9</confidence>\n  </triple>\n  <triple>\n    <subject>Prefrontal Cortex</subject>\n    <subject_type>Biology</subject_type>\n    <predicate>modulates</predicate>\n    <object>impulse control</object>\n    <object_type>Process</object_type>\n    <citation>The prefrontal cortex acts as a top-down modulator for impulsive actions.</citation>\n    <confidence>0.85</confidence>\n  </triple>\n</triples>\n\nXML:\"\"\"\n\n\nCONFLICT_DETECTION_PROMPT = \"\"\"You are a logical consistency checker.\nGiven the following set of knowledge triples already in the graph, and a NEW set of triples about to be added, identify any CONFLICTS (contradictions) between the existing and new triples.\n\nA conflict exists when:\n- Two triples make opposing claims about the same subject-object pair\n- A new triple directly contradicts an existing one\n\nEXISTING TRIPLES:\n{existing}\n\nNEW TRIPLES:\n{new_triples}\n\nReturn an XML block of conflicts. If no conflicts, return <conflicts></conflicts>.\nEach conflict object should have <concept_a>, <concept_b>, and <description>.\n\nExample:\n<conflicts>\n  <conflict>\n    <concept_a>A</concept_a>\n    <concept_b>B</concept_b>\n    <description>Contradiction explanation...</description>\n  </conflict>\n</conflicts>\n\nXML CONFLICTS:\"\"\"\n\n\nSYNTHESIS_PROMPT = \"\"\"You are a cross-domain synthesis engine that finds structural isomorphisms -\npatterns that repeat across different fields.\n\nGiven the following set of concepts and their relationships, identify any\nSTRUCTURAL ANALOGIES (isomorphisms) between concepts from different domains.\n\nAn analogy exists when:\n- Two systems from different fields share the same underlying pattern or structure\n- The way one system works is mathematically or structurally similar to another\n- E.g. how a forest fire spreads (Biology) is similar to how a viral tweet spreads (Sociology)\n\nKNOWLEDGE GRAPH:\n{graph_summary}\n\nReturn an XML block of analogies. If no analogies found, return <analogies></analogies>.\nEach analogy should use the tags <concept_a>, <concept_b>, <description>, and <pattern>.\n\nExample:\n<analogies>\n  <analogy>\n    <concept_a>A</concept_a>\n    <concept_b>B</concept_b>\n    <description>Analogy explanation...</description>\n    <pattern>Pattern Name</pattern>\n  </analogy>\n</analogies>\n\nXML ANALOGIES:\"\"\"\n\n\nCROSS_DOMAIN_PROMPT = \"\"\"You are a cross-domain analogy engine.\nGiven the concept \"{concept}\" and its relationships below, explain how this concept\nmaps to the domain of \"{target_domain}\".\n\nCONCEPT RELATIONSHIPS:\n{relationships}\n\nProvide:\n1. The analogous concept in {target_domain}\n2. How the structural pattern maps\n3. Key similarities and differences\n\nBe specific and insightful. Format as XML:\n<analogy>\n  <analogous_concept>...</analogous_concept>\n  <mapping>...</mapping>\n  <similarities>...</similarities>\n  <differences>...</differences>\n</analogy>\n\nXML:\"\"\"\n\n\nCOMMUNITY_NAMING_PROMPT = \"\"\"You are a topological expert.\nGiven the following list of concepts and relationships discovered in a specific \"Semantic Neighborhood\" (community) of a knowledge graph, provide a concise, descriptive name for this community.\n\nCOMMUNITY CONCEPTS:\n{concepts}\n\nGUIDELINES:\n1. The name should be exactly 2-4 words.\n2. It should capture the \"essence\" of the cluster (e.g., \"Neural Execution Layer\", \"User Data Governance\", \"Asynchronous Messaging Patterns\").\n3. Avoid generic names like \"Group 1\" or \"System Cluster\".\n\nReturn ONLY an XML block:\n<community>\n  <community_name>...</community_name>\n  <justification>...</justification>\n</community>\n\nXML:\"\"\"\n\n\n# =============================================================================\n# ADAPTIVE CHUNKING\n# =============================================================================\n\n\ndef estimate_tokens(text: str) -> int:\n    \"\"\"Estimate token count from character length (~4 chars per token).\"\"\"\n    return max(1, len(text) // 4)\n\n\ndef adaptive_truncate(text: str, max_tokens: int = 4000) -> str:\n    \"\"\"\n    Truncate text to fit within a token budget, preferring to break at\n    sentence boundaries rather than mid-sentence.\n    \"\"\"\n    max_chars = max_tokens * 4\n    if len(text) <= max_chars:\n        return text\n\n    # Try to break at the last sentence boundary within the budget\n    truncated = text[:max_chars]\n    last_period = truncated.rfind(\". \")\n    last_newline = truncated.rfind(\"\\n\")\n    break_at = max(last_period, last_newline)\n\n    if break_at > max_chars * 0.6:  # Only break at boundary if we keep >60% of content\n        return truncated[: break_at + 1]\n    return truncated\n\n\n# =============================================================================\n# LLM CALL WITH RETRY\n# =============================================================================\n\n\nasync def call_llm(\n    prompt: str,\n    provider: str = \"lemonade\",\n    model: Optional[str] = None,\n    timeout: Optional[float] = None,\n    config: Optional[SynthesisConfig] = None,\n    run_id: Optional[str] = None,\n    workspace: Optional[str] = None,\n    role: str = \"default\",\n) -> str:\n    \"\"\"\n    Consolidated LLM call with retry and exponential backoff.\n    Utilizes the core dispatcher for OpenAI, LiteLLM, and LiteRT.\n    \"\"\"\n    cfg = config or SynthesisConfig()\n\n    # Priority 1: Use explicitly provided model\n    # Priority 2: Auto-resolve via active workspace manifest OR swarm manifest\n    if not model and (workspace or run_id):\n        try:\n            from ..core.models import get_active_model\n\n            model = await get_active_model(workspace or \"default\", role=role, run_id=run_id)\n        except Exception:\n            pass\n\n    # Resolve model string (e.g., \"ollama/llama3\")\n    if model and \"/\" in model:\n        full_model = model\n    elif model:\n        full_model = f\"{provider}/{model}\"\n    else:\n        # Final safety fallback: use provider/default and let executor resolve\n        full_model = f\"{provider}/default\"\n\n    last_error = None\n    for attempt in range(cfg.max_retries):\n        try:\n            return await call_model(\n                model=full_model,\n                messages=[{\"role\": \"user\", \"content\": prompt}],\n                temperature=0.3,\n                # Cap output so input+output fits small local context windows\n                # (FLM/NPU models are often 2048 tok). call_model defaults to\n                # 2048 output, which overflowed qwen3.5-9b-FLM → \"no choices\".\n                # 768 is ample for a JSON triple array.\n                max_tokens=768,\n                timeout=timeout,\n                run_id=run_id,\n                # Thread the workspace AND role through so the profile-aware\n                # thinking suppression fires for synthesis: a 'capable' reasoning\n                # model on the graph_synthesis role auto-runs with /no_think (no\n                # operator toggle needed), while 'fragile' FLM models are left\n                # alone. Without this, reasoning models burn the whole token\n                # budget on <think> → no parseable JSON → an empty graph.\n                workspace_id=workspace,\n                role=role,\n            )\n        except Exception as e:\n            last_error = e\n            if attempt < cfg.max_retries - 1:\n                delay = cfg.retry_base_delay * (2**attempt)\n                logger.warning(\n                    \"LLM call attempt %d/%d failed (%s). Retrying in %.1fs...\",\n                    attempt + 1,\n                    cfg.max_retries,\n                    str(e)[:100],\n                    delay,\n                )\n                await asyncio.sleep(delay)\n            else:\n                logger.error(\n                    \"LLM call failed after %d attempts for role '%s': %s\",\n                    cfg.max_retries,\n                    role,\n                    last_error,\n                )\n                if run_id:\n                    from ..core.task_manager import task_manager\n\n                    task_manager.add_aer_entry(\n                        run_id,\n                        intent=f\"LLM Call ({role})\",\n                        observation=\"Final retry failed\",\n                        inference=str(last_error),\n                    )\n\n    raise last_error\n\n\n# =============================================================================\n# ROBUST JSON PARSING\n# =============================================================================\n\n\ndef _extract_xml_field(tag: str, s: str) -> Optional[str]:\n    \"\"\"Extract an XML field value, tolerating the malformed tags local models\n    emit. Tries, in order: a well-formed ``<tag>..</tag>``; an open tag with\n    attributes ``<tag x=..>..</tag>``; and a broken open tag with no closing\n    ``>`` such as ``<object(reasoning, tool use)</object>`` (observed from\n    qwen3.5-9b). Returns the cleaned inner value or ``None``.\"\"\"\n    for pat in (\n        rf\"<{tag}>(.*?)</{tag}>\",\n        rf\"<{tag}\\s[^>]*>(.*?)</{tag}>\",\n        rf\"<{tag}\\b(.*?)</{tag}>\",\n    ):\n        m = re.search(pat, s, re.IGNORECASE | re.DOTALL)\n        if m:\n            v = m.group(1).strip()\n            # Broken-open-tag capture can lead with a stray '>' or wrap the\n            # value in the parens the model used in place of '>' .. '<'.\n            if v.startswith(\">\"):\n                v = v[1:].strip()\n            if v.startswith(\"(\") and v.endswith(\")\"):\n                v = v[1:-1].strip()\n            return v\n    return None\n\n\ndef _parse_json_from_llm(text: str) -> Tuple[Any, str]:\n    \"\"\"\n    Robustly extract JSON from LLM output that may contain markdown fences,\n    <think> reasoning blocks, or truncated arrays.\n    Returns (parsed_data, thinking_string).\n    \"\"\"\n    thinking = \"\"\n    # Extract and strip all think blocks\n    cleaned = text\n    think_blocks = re.findall(r\"<think>(.*?)</think>\", cleaned, re.DOTALL)\n    if think_blocks:\n        thinking = \"\\n---\\n\".join([t.strip() for t in think_blocks])\n        cleaned = re.sub(r\"<think>.*?</think>\", \"\", cleaned, flags=re.DOTALL).strip()\n    else:\n        # Fallback for unclosed think block\n        think_match = re.search(r\"<think>(.*)\", cleaned, re.DOTALL)\n        if think_match:\n            thinking = think_match.group(1).strip()\n            cleaned = re.sub(r\"<think>.*\", \"\", cleaned, flags=re.DOTALL).strip()\n\n    # Strip markdown code fences (more robustly)\n    if \"```\" in cleaned:\n        # Try to find content inside ```json ... ``` or just ``` ... ```\n        fence_matches = re.findall(r\"```(?:json)?\\s*\\n?(.*?)\\n?```\", cleaned, re.DOTALL)\n        if fence_matches:\n            # If multiple code blocks, join them or pick the largest?\n            # Usually we want the largest or the first one that is valid.\n            # We'll try to process the whole thing below anyway.\n            pass\n        else:\n            # Fallback: just strip all lines starting with ```\n            lines = cleaned.split(\"\\n\")\n            lines = [l for l in lines if not l.strip().startswith(\"```\")]\n            cleaned = \"\\n\".join(lines).strip()\n\n    # ---------------------------------------------------------\n    # NEW: Indestructible XML Parsing for Rigid Operating Model\n    # ---------------------------------------------------------\n    # If the prompt used XML tags (e.g. <triples>), we parse it via regex to avoid strict syntax errors.\n    xml_data = []\n\n    # 1. Triples\n    if \"<triple>\" in cleaned:\n        for triple_match in re.finditer(\n            r\"<triple>(.*?)</triple>\", cleaned, re.IGNORECASE | re.DOTALL\n        ):\n            t_str = triple_match.group(1)\n            triple = {}\n            for tag in [\n                \"subject\",\n                \"subject_type\",\n                \"predicate\",\n                \"object\",\n                \"object_type\",\n                \"citation\",\n                \"confidence\",\n            ]:\n                val = _extract_xml_field(tag, t_str)\n                if val is not None:\n                    if tag == \"confidence\":\n                        try:\n                            val = float(val)\n                        except:\n                            val = 1.0\n                    triple[tag] = val\n            if \"subject\" in triple and \"object\" in triple:\n                xml_data.append(triple)\n        if xml_data:\n            return xml_data, thinking\n\n    # 2. Conflicts / Analogies (generic list of objects)\n    for root_tag, item_tag in [(\"conflicts\", \"conflict\"), (\"analogies\", \"analogy\")]:\n        if f\"<{item_tag}>\" in cleaned:\n            for match in re.finditer(\n                rf\"<{item_tag}>(.*?)</{item_tag}>\", cleaned, re.IGNORECASE | re.DOTALL\n            ):\n                i_str = match.group(1)\n                item = {}\n                # Extract any child tags generically\n                for tag_match in re.finditer(r\"<([a-zA-Z0-9_]+)>(.*?)</\\1>\", i_str, re.DOTALL):\n                    item[tag_match.group(1).lower()] = tag_match.group(2).strip()\n                if item:\n                    xml_data.append(item)\n            if xml_data:\n                return xml_data, thinking\n\n    # 3. Community (single object)\n    if \"<community_name>\" in cleaned:\n        comm = {}\n        for tag in [\"community_name\", \"justification\", \"analogous_concept\", \"mapping\"]:\n            m = re.search(rf\"<{tag}>(.*?)</{tag}>\", cleaned, re.IGNORECASE | re.DOTALL)\n            if m:\n                comm[tag] = m.group(1).strip()\n        if comm:\n            return comm, thinking\n\n    # ---------------------------------------------------------\n    # JSON Parsing Fallback\n    # ---------------------------------------------------------\n    def score_json(data: Any) -> int:\n        \"\"\"Score JSON based on its complexity/usefulness.\"\"\"\n        if isinstance(data, list):\n            # Bonus for lists as we usually expect arrays of triples\n            return len(data) * 10 + 5\n        if isinstance(data, dict):\n            return len(data.keys())\n        return 0\n\n    best_data = []\n    max_score = -1\n\n    # Try parsing the whole thing first\n    try:\n        data = json.loads(cleaned)\n        max_score = score_json(data)\n        best_data = data\n    except:\n        pass\n\n    # Find all possible start positions for JSON objects or arrays\n    for match in re.finditer(r\"\\{|\\[\", cleaned):\n        start_idx = match.start()\n        start_char = cleaned[start_idx]\n        end_char = \"}\" if start_char == \"{\" else \"]\"\n\n        # Look for the last occurrence of the matching end bracket\n        # and work backwards to find the largest valid JSON.\n        end_matches = list(re.finditer(re.escape(end_char), cleaned[start_idx:]))\n        for end_match in reversed(end_matches):\n            current_end_idx = start_idx + end_match.end()\n            json_str = cleaned[start_idx:current_end_idx]\n\n            # Clean up trailing commas\n            json_str = re.sub(r\",\\s*([\\]}])\", r\"\\1\", json_str)\n\n            try:\n                data = json.loads(json_str)\n                score = score_json(data)\n                if score > max_score:\n                    max_score = score\n                    best_data = data\n            except:\n                continue\n\n    # Final fallback for truncated JSON\n    if max_score <= 5:  # If we only found empty lists or dicts, try harder\n        first_start = re.search(r\"\\{|\\[\", cleaned)\n        if first_start:\n            start_idx = first_start.start()\n            json_str = cleaned[start_idx:]\n\n            # Very aggressive truncation recovery: try adding combinations of closing brackets\n            for i in range(1, 6):\n                for trial_suffix in [\"}\", \"]\", \"}]\", \"]}\", \"}}] \", \"}]}]\"]:\n                    trial = json_str + (trial_suffix * i)\n                    try:\n                        trial_clean = re.sub(r\",\\s*([\\]}])\", r\"\\1\", trial)\n                        data = json.loads(trial_clean)\n                        score = score_json(data)\n                        if score > max_score:\n                            max_score = score\n                            best_data = data\n                    except:\n                        continue\n\n    if max_score > -1:\n        return best_data, thinking\n\n    logger.warning(\"Failed to parse JSON from LLM output (%d chars).\", len(text))\n    # Optionally save the raw output for inspection. Gated behind BENNY_DEBUG_LLM\n    # and written to the system temp dir — the old unconditional os.getcwd()\n    # dump littered the repo/working dir with failed_llm_output_*.txt files.\n    if os.environ.get(\"BENNY_DEBUG_LLM\"):\n        try:\n            import tempfile\n\n            debug_path = os.path.join(\n                tempfile.gettempdir(),\n                f\"failed_llm_output_{int(asyncio.get_event_loop().time())}.txt\",\n            )\n            with open(debug_path, \"w\", encoding=\"utf-8\") as f:\n                f.write(text)\n            logger.info(\"Saved failed LLM output to %s\", debug_path)\n        except Exception:\n            pass\n    return [], thinking\n\n\n# =============================================================================\n# DEDUPLICATION & QUALITY FILTERING\n# =============================================================================\n\n\ndef deduplicate_triples(triples: List[KnowledgeTriple]) -> List[KnowledgeTriple]:\n    \"\"\"Remove near-duplicate triples using normalized subject|predicate|object keys.\"\"\"\n    seen = set()\n    unique = []\n    for t in triples:\n        key = t.normalized_key\n        if key not in seen:\n            seen.add(key)\n            unique.append(t)\n        else:\n            logger.debug(\"Deduplicated triple: %s\", key)\n    if len(triples) != len(unique):\n        logger.info(\n            \"Deduplication: %d -> %d triples (removed %d duplicates)\",\n            len(triples),\n            len(unique),\n            len(triples) - len(unique),\n        )\n    return unique\n\n\ndef filter_by_confidence(\n    triples: List[KnowledgeTriple], min_confidence: float = 0.3\n) -> List[KnowledgeTriple]:\n    \"\"\"Discard low-confidence triples below the threshold.\"\"\"\n    filtered = [t for t in triples if t.confidence >= min_confidence]\n    removed = len(triples) - len(filtered)\n    if removed:\n        logger.info(\n            \"Confidence filter: removed %d low-confidence triples (threshold=%.2f)\",\n            removed,\n            min_confidence,\n        )\n    return filtered\n\n\ndef _validate_and_convert_triples(\n    raw_triples: Any,\n    section_title: str = \"\",\n    config: Optional[SynthesisConfig] = None,\n    model_id: str = \"unknown\",\n    strategy: str = \"safe\",\n) -> List[KnowledgeTriple]:\n    \"\"\"Convert raw LLM JSON output into validated KnowledgeTriple models.\"\"\"\n    cfg = config or SynthesisConfig()\n\n    if not isinstance(raw_triples, list):\n        return []\n\n    valid = []\n    for t in raw_triples:\n        if isinstance(t, dict) and \"subject\" in t and \"predicate\" in t and \"object\" in t:\n            try:\n                triple = KnowledgeTriple(\n                    subject=t.get(\"subject\", \"\"),\n                    subject_type=t.get(\"subject_type\", \"Concept\"),\n                    predicate=t.get(\"predicate\", \"\"),\n                    object=t.get(\"object\", \"\"),\n                    object_type=t.get(\"object_type\", \"Concept\"),\n                    citation=t.get(\"citation\", \"\"),\n                    confidence=float(t.get(\"confidence\", 1.0)),\n                    section_title=section_title or t.get(\"section_title\", \"\"),\n                    model_id=model_id,\n                    strategy=strategy,\n                )\n                valid.append(triple)\n            except Exception as e:\n                logger.debug(\"Skipping invalid triple: %s\", e)\n\n    # Apply confidence filter\n    valid = filter_by_confidence(valid, cfg.min_confidence)\n\n    return valid\n\n\n# =============================================================================\n# TRIPLE EXTRACTION\n# =============================================================================\n\n\nasync def extract_triples(\n    text: str,\n    source_name: str = \"unknown\",\n    run_id: Optional[str] = None,\n    workspace: Optional[str] = \"default\",\n    config: Optional[SynthesisConfig] = None,\n    strategy: str = \"safe\",\n    timeout: Optional[float] = None,\n) -> List[KnowledgeTriple]:\n    \"\"\"\n    Extract knowledge triples from text using the configured LLM.\n    Uses adaptive chunking instead of hardcoded truncation.\n    \"\"\"\n    cfg = config or SynthesisConfig()\n\n    # Use adaptive chunking to fit the model's context window\n    safe_text = adaptive_truncate(text, cfg.max_context_tokens)\n    prompt = TRIPLE_EXTRACTION_PROMPT.format(text=safe_text)\n\n    try:\n        # Resolve model_id to track provenance\n        from ..core.models import get_active_model\n\n        resolved_model = await get_active_model(workspace)\n\n        # Pass workspace and role to ensure manifest-level model selection\n        raw = await call_llm(\n            prompt,\n            run_id=run_id,\n            workspace=workspace,\n            config=cfg,\n            role=\"graph_synthesis\",\n            timeout=timeout,\n        )\n\n        # Robustly parse JSON and capture any reasoning/thinking blocks\n        triples_data, thinking = _parse_json_from_llm(raw)\n\n        if thinking and run_id:\n            from ..core.task_manager import task_manager\n\n            task_manager.add_aer_entry(\n                run_id,\n                intent=f\"Synthesis extraction for {source_name}\",\n                observation=\"Reasoning detected\",\n                inference=thinking,\n            )\n\n        return _validate_and_convert_triples(\n            triples_data,\n            section_title=source_name,\n            config=cfg,\n            model_id=resolved_model,\n            strategy=strategy,\n        )\n\n    except Exception as e:\n        logger.error(f\"Extraction failed for {source_name}: {e}\")\n        return []\n\n\nasync def name_community(\n    concepts: List[str], workspace: str = \"default\", run_id: Optional[str] = None\n) -> Dict[str, str]:\n    \"\"\"\n    Generate a concise name and justification for a semantic community.\n    \"\"\"\n    prompt = COMMUNITY_NAMING_PROMPT.format(concepts=\", \".join(concepts[:50]))\n    try:\n        raw = await call_llm(prompt, run_id=run_id, workspace=workspace)\n        data, thinking = _parse_json_from_llm(raw)\n        if isinstance(data, dict) and \"community_name\" in data:\n            return data\n        return {\"community_name\": f\"Community {concepts[0][:10]}\", \"justification\": \"Fallback name\"}\n    except Exception as e:\n        logger.error(f\"Community naming failed: {e}\")\n        return {\"community_name\": \"Unknown Cluster\", \"justification\": str(e)}\n\n\nasync def extract_directed_triples_from_section(\n    text: str,\n    section_title: str,\n    direction: str = \"\",\n    workspace: str = \"default\",\n    run_id: Optional[str] = None,\n    provider: str = \"lemonade\",\n    model: str = None,\n    strategy: str = \"safe\",\n    inference_delay: float = 0.5,\n    timeout: Optional[float] = None,\n    config: Optional[SynthesisConfig] = None,\n) -> List[KnowledgeTriple]:\n    \"\"\"\n    Extract L2 points from a document section, optionally influenced by user direction.\n    \"\"\"\n    cfg = config or SynthesisConfig()\n\n    # Optional delay to protect local NPU/CPU from thermal throttling\n    actual_delay = inference_delay if inference_delay > 0 else cfg.inference_delay\n    if actual_delay > 0:\n        await asyncio.sleep(actual_delay)\n\n    safe_text = adaptive_truncate(text, cfg.max_context_tokens)\n\n    dir_prompt = \"\"\n    if direction.strip():\n        dir_prompt = f\"DIRECTION / INTENT:\\nThe user is specifically looking for: '{direction}'. Focus heavily on points that help answer this intent.\"\n\n    prompt = DIRECTED_EXTRACTION_PROMPT.format(\n        direction_prompt=dir_prompt, section_title=section_title, text=safe_text\n    )\n\n    # Resolve model_id to track provenance\n    from ..core.models import get_active_model\n\n    resolved_model = await get_active_model(workspace)\n\n    raw = await call_llm(\n        prompt,\n        provider=provider,\n        model=model or resolved_model,\n        timeout=timeout,\n        config=cfg,\n        run_id=run_id,\n        role=\"graph_synthesis\",\n        # Thread the workspace so the per-model thinking toggle reaches call_model;\n        # without it, reasoning models (e.g. Qwen3-8B-Hybrid) keep thinking and\n        # emit no parseable JSON → empty knowledge graph.\n        workspace=workspace,\n    )\n\n    raw_triples, thinking = _parse_json_from_llm(raw)\n\n    if thinking and run_id:\n        from ..core.task_manager import task_manager\n\n        task_manager.add_aer_entry(\n            run_id,\n            intent=f\"Extracting section: {section_title}\",\n            observation=\"Reasoning detected\",\n            inference=thinking,\n        )\n\n    return _validate_and_convert_triples(\n        raw_triples,\n        section_title=section_title,\n        config=cfg,\n        model_id=resolved_model,\n        strategy=strategy,\n    )\n\n\nasync def parallel_extract_triples(\n    sections: List[Dict[str, str]],\n    direction: str = \"\",\n    provider: str = \"lemonade\",\n    model: str = None,\n    parallel_limit: Optional[int] = None,\n    inference_delay: float = 0.5,\n    timeout: Optional[float] = None,\n    config: Optional[SynthesisConfig] = None,\n    event_callback: Optional[Callable] = None,\n    workspace: str = \"default\",\n    run_id: Optional[str] = None,\n    **kwargs,\n) -> List[KnowledgeTriple]:\n    \"\"\"\n    Process multiple document sections in parallel for high-performance ingestion.\n    Uses an asyncio.Semaphore to prevent overloading the LLM provider.\n    Emits progress events via event_callback if provided.\n    \"\"\"\n    cfg = config or SynthesisConfig()\n    actual_limit = parallel_limit or cfg.parallel_limit\n    semaphore = asyncio.Semaphore(actual_limit)\n    total = len(sections)\n\n    async def wrapped_extract(idx: int, section: Dict[str, str]):\n        async with semaphore:\n            logger.info(\"Extracting section %d/%d: %s\", idx + 1, total, section[\"title\"])\n            if event_callback:\n                await event_callback(\n                    IngestionEvent(\n                        event=IngestionEventType.SECTION_PROGRESS,\n                        message=f\"Processing section {idx + 1}/{total}: {section['title']}\",\n                        data={\"current\": idx + 1, \"total\": total, \"section\": section[\"title\"]},\n                    )\n                )\n            return await extract_directed_triples_from_section(\n                text=section[\"text\"],\n                section_title=section[\"title\"],\n                direction=direction,\n                provider=provider,\n                model=model,\n                inference_delay=inference_delay,\n                timeout=timeout,\n                config=cfg,\n                run_id=run_id,\n                workspace=workspace,\n            )\n\n    # Launch parallel tasks\n    tasks = [wrapped_extract(i, section) for i, section in enumerate(sections)]\n    results = await asyncio.gather(*tasks, return_exceptions=True)\n\n    # Flatten results, handling exceptions gracefully\n    flat_triples: List[KnowledgeTriple] = []\n    for i, result in enumerate(results):\n        if isinstance(result, Exception):\n            logger.error(\"Section %d extraction failed: %s\", i + 1, result)\n        elif isinstance(result, list):\n            flat_triples.extend(result)\n\n    # Deduplicate across all sections\n    if cfg.deduplicate:\n        flat_triples = deduplicate_triples(flat_triples)\n\n    if event_callback:\n        await event_callback(\n            IngestionEvent(\n                event=IngestionEventType.TRIPLES_EXTRACTED,\n                message=f\"Extraction complete: {len(flat_triples)} triples\",\n                data={\"count\": len(flat_triples)},\n            )\n        )\n\n    return flat_triples\n\n\n# =============================================================================\n# CONFLICT DETECTION\n# =============================================================================\n\n\nasync def detect_conflicts(\n    existing_triples: List[Any],\n    new_triples: List[Any],\n    workspace: str = \"default\",\n    provider: str = \"lemonade\",\n    model: str = None,\n    timeout: Optional[float] = None,\n    config: Optional[SynthesisConfig] = None,\n    run_id: Optional[str] = None,\n) -> List[Dict[str, str]]:\n    \"\"\"Detect logical conflicts between existing and new triples.\"\"\"\n    cfg = config or SynthesisConfig()\n\n    if not existing_triples or not new_triples:\n        return []\n\n    # Serialize triples for prompt — handle both KnowledgeTriple and raw dicts/lists\n    def serialize(triples, limit):\n        items = triples[:limit]\n        serialized = []\n        for t in items:\n            if isinstance(t, KnowledgeTriple):\n                serialized.append(t.model_dump())\n            elif isinstance(t, dict):\n                serialized.append(t)\n            elif isinstance(t, list) and len(t) >= 3:\n                serialized.append({\"subject\": t[0], \"predicate\": t[1], \"object\": t[2]})\n        return serialized\n\n    prompt = CONFLICT_DETECTION_PROMPT.format(\n        existing=json.dumps(serialize(existing_triples, cfg.max_conflict_triples)),\n        new_triples=json.dumps(serialize(new_triples, cfg.max_conflict_triples)),\n    )\n\n    try:\n        raw = await call_llm(\n            prompt,\n            provider=provider,\n            model=model,\n            timeout=timeout,\n            config=cfg,\n            workspace=workspace,\n            run_id=run_id,\n        )\n\n        conflicts, thinking = _parse_json_from_llm(raw)\n\n        if thinking and run_id:\n            from ..core.task_manager import task_manager\n\n            task_manager.add_aer_entry(\n                run_id,\n                intent=\"Detecting conflicts\",\n                observation=\"Reasoning detected\",\n                inference=thinking,\n            )\n\n        if not isinstance(conflicts, list):\n            return []\n\n        return [c for c in conflicts if isinstance(c, dict) and \"concept_a\" in c]\n    except Exception as e:\n        logger.warning(\"Conflict detection bypassed: LLM call failed (%s)\", e)\n        return []\n\n\n# =============================================================================\n# SYNTHESIS & ANALOGIES\n# =============================================================================\n\n\nasync def find_synthesis(\n    graph_summary: str,\n    workspace: str = \"default\",\n    provider: str = \"lemonade\",\n    model: str = None,\n    timeout: Optional[float] = None,\n    config: Optional[SynthesisConfig] = None,\n    run_id: Optional[str] = None,\n) -> List[Dict[str, str]]:\n    \"\"\"Find structural isomorphisms in the knowledge graph.\"\"\"\n    cfg = config or SynthesisConfig()\n    prompt = SYNTHESIS_PROMPT.format(graph_summary=graph_summary)\n\n    raw = await call_llm(\n        prompt,\n        provider=provider,\n        model=model,\n        timeout=timeout,\n        config=cfg,\n        workspace=workspace,\n        run_id=run_id,\n    )\n\n    analogies, thinking = _parse_json_from_llm(raw)\n\n    if thinking and run_id:\n        from ..core.task_manager import task_manager\n\n        task_manager.add_aer_entry(\n            run_id,\n            intent=\"Searching for synthesis/analogies\",\n            observation=\"Reasoning detected\",\n            inference=thinking,\n        )\n\n    if not isinstance(analogies, list):\n        return []\n\n    return [a for a in analogies if isinstance(a, dict) and \"concept_a\" in a]\n\n\nasync def cross_domain_analogy(\n    concept: str,\n    relationships: str,\n    target_domain: str,\n    workspace: str = \"default\",\n    provider: str = \"lemonade\",\n    model: str = None,\n    timeout: Optional[float] = None,\n    config: Optional[SynthesisConfig] = None,\n    run_id: Optional[str] = None,\n) -> Dict[str, Any]:\n    \"\"\"Map a concept into a different domain.\"\"\"\n    cfg = config or SynthesisConfig()\n    prompt = CROSS_DOMAIN_PROMPT.format(\n        concept=concept, relationships=relationships, target_domain=target_domain\n    )\n\n    raw = await call_llm(\n        prompt,\n        provider=provider,\n        model=model,\n        timeout=timeout,\n        config=cfg,\n        workspace=workspace,\n        run_id=run_id,\n    )\n\n    result, thinking = _parse_json_from_llm(raw)\n\n    if thinking and run_id:\n        from ..core.task_manager import task_manager\n\n        task_manager.add_aer_entry(\n            run_id,\n            intent=f\"Generating cross-domain analogy: {target_domain}\",\n            observation=\"Reasoning detected\",\n            inference=thinking,\n        )\n\n    if isinstance(result, dict):\n        return result\n    return {\"error\": \"Could not generate cross-domain analogy\", \"raw\": raw}\n\n\n# =============================================================================\n# B. CONCEPTUAL CLUSTER - Dual-Model Embedding\n# =============================================================================\n\n\nasync def get_embedding(\n    text: str,\n    provider: str = \"local\",\n    model: str = None,\n    workspace: Optional[str] = None,\n    role: str = \"graph_synthesis\",\n) -> List[float]:\n    \"\"\"\n    Get a vector embedding for text using either a local or cloud provider.\n\n    Providers:\n        - \"local\" / \"ollama\": Uses ollama's embedding endpoint\n        - \"openai\": Uses OpenAI text-embedding-3-small\n    \"\"\"\n    if provider == \"openai\":\n        return await _get_openai_embedding(text, model or \"text-embedding-3-small\")\n\n    # Resolve 'local' to the actual active provider if possible\n    if provider == \"local\":\n        try:\n            from ..core.models import get_active_model\n\n            active_id = await get_active_model(\n                workspace_id=workspace or \"default\", role=\"graph_synthesis\"\n            )\n            if \"/\" in active_id:\n                provider = active_id.split(\"/\")[0]\n            else:\n                provider = \"lemonade\"  # Default fallback for local\n        except Exception:\n            provider = \"ollama\"  # Final fallback\n\n    if provider == \"ollama\":\n        return await _get_ollama_embedding(text, model or \"nomic-embed-text\")\n    else:\n        # For 'lemonade', 'fastflowlm', or other OpenAI-compatible local endpoints\n        return await _get_generic_local_embedding(text, provider, model)\n\n\nasync def _get_generic_local_embedding(text: str, provider: str, model: str = None) -> List[float]:\n    \"\"\"Get embedding from an OpenAI-compatible local AI endpoint (e.g. Lemonade).\"\"\"\n    provider_config = LOCAL_PROVIDERS.get(provider)\n    if not provider_config:\n        raise ValueError(f\"Unknown local provider for embedding: {provider}\")\n\n    api_base = provider_config[\"base_url\"]\n    url = f\"{api_base}/embeddings\"\n\n    model_name = model.split(\"/\")[-1] if model else \"default\"\n\n    # FastFlowLM and Lemonade throw errors if a Chat model is passed to the Embeddings endpoint.\n    if provider == \"lemonade\" and model_name == \"default\":\n        model_name = \"nomic-embed-text-v1-GGUF\"\n\n    client = _get_shared_client()\n    try:\n        response = await client.post(url, json={\"model\": model_name, \"input\": text})\n        if response.status_code == 200:\n            data = response.json()\n            return data[\"data\"][0][\"embedding\"]\n        else:\n            logger.warning(f\"{provider} embedding failed ({response.status_code}): {response.text}\")\n            return [0.0] * 768\n    except Exception as e:\n        logger.error(f\"Failed to connect to {provider} embedding endpoint: {e}\")\n        return [0.0] * 768\n\n\nasync def _get_ollama_embedding(text: str, model: str = \"nomic-embed-text\") -> List[float]:\n    \"\"\"Get embedding from Ollama /api/embeddings endpoint.\"\"\"\n    url = \"http://localhost:11434/api/embeddings\"\n    client = _get_shared_client()\n    response = await client.post(url, json={\"model\": model, \"prompt\": text})\n    if response.status_code == 200:\n        data = response.json()\n        return data.get(\"embedding\", [])\n    else:\n        raise Exception(f\"Ollama embedding failed: {response.status_code}\")\n\n\nasync def _get_openai_embedding(text: str, model: str = \"text-embedding-3-small\") -> List[float]:\n    \"\"\"Get embedding from OpenAI API.\"\"\"\n    import openai\n\n    client_obj = openai.AsyncOpenAI(api_key=os.environ.get(\"OPENAI_API_KEY\", \"\"))\n    response = await client_obj.embeddings.create(input=text, model=model)\n    return response.data[0].embedding\n\n\nasync def batch_embed_concepts(\n    concepts: List[str],\n    provider: str = \"local\",\n    model: str = None,\n    batch_size: int = 16,\n    event_callback: Optional[Any] = None,\n    workspace: Optional[str] = None,\n) -> Dict[str, List[float]]:\n    \"\"\"\n    Embed multiple concepts concurrently with database-backed caching.\n\n    Logic:\n    1. Check Neo4j for existing embeddings for these concepts in this workspace.\n    2. Only send missing ones to the LLM provider.\n    3. Save newly generated embeddings back to Neo4j.\n    \"\"\"\n    from ..core.graph_db import read_session, write_session\n\n    results: Dict[str, List[float]] = {}\n    missing_concepts: List[str] = []\n\n    # 1. Check Cache (Neo4j)\n    if workspace:\n        logger.info(\"Embedding Cache: checking Neo4j for %d existing vectors...\", len(concepts))\n        with read_session() as session:\n            # We check both Concepts (by name) and CodeEntities (by name: summary)\n            # This is a broad check for anything in the workspace with an embedding.\n            query = \"\"\"\n            MATCH (n {workspace: $ws})\n            WHERE n.embedding IS NOT NULL AND (n.name IN $names OR (n.name + ': ' + coalesce(n.summary, '')) IN $names)\n            RETURN n.name as name, n.summary as summary, n.embedding as embedding\n            \"\"\"\n            cache_res = session.run(query, ws=workspace, names=concepts)\n            for rec in cache_res:\n                key = rec[\"name\"]\n                # Match the 'name: summary' format used in correlation\n                if rec[\"summary\"] and f\"{rec['name']}: {rec['summary']}\" in concepts:\n                    key = f\"{rec['name']}: {rec['summary']}\"\n                results[key] = rec[\"embedding\"]\n\n        logger.info(\"Embedding Cache: found %d/%d vectors in Neo4j\", len(results), len(concepts))\n\n    missing_concepts = [c for c in concepts if c not in results]\n    if not missing_concepts:\n        return results\n\n    # 2. Embed Missing via LLM\n    logger.info(\n        \"Embedding: sending %d missing items to %s provider...\", len(missing_concepts), provider\n    )\n    semaphore = asyncio.Semaphore(batch_size)\n    total = len(missing_concepts)\n    completed = 0\n\n    async def embed_one(concept: str):\n        nonlocal completed\n        async with semaphore:\n            try:\n                embedding = await get_embedding(\n                    concept, provider=provider, model=model, workspace=workspace\n                )\n                results[concept] = embedding\n                completed += 1\n                if event_callback:\n                    await event_callback(\n                        IngestionEvent(\n                            event=IngestionEventType.SECTION_PROGRESS,\n                            message=f\"Embedded {completed}/{total} new items\",\n                            data={\"current\": completed, \"total\": total},\n                        )\n                    )\n\n                # 3. Save back to Neo4j (Async/Background)\n                if workspace:\n                    # We determine if it's a Concept or CodeEntity by splitting\n                    is_symbol = \": \" in concept\n                    name = concept.split(\": \")[0] if is_symbol else concept\n                    summary = concept.split(\": \")[1] if is_symbol else None\n\n                    with write_session() as w_session:\n                        save_query = \"\"\"\n                        MATCH (n {workspace: $ws, name: $name})\n                        WHERE ($summary IS NULL OR n.summary = $summary)\n                        SET n.embedding = $embedding\n                        \"\"\"\n                        w_session.run(\n                            save_query,\n                            ws=workspace,\n                            name=name,\n                            summary=summary,\n                            embedding=embedding,\n                        )\n\n            except Exception as e:\n                logger.error(f\"Failed to embed '{concept[:30]}...': {e}\")\n                results[concept] = [0.0] * 768\n\n    tasks = [embed_one(c) for c in missing_concepts]\n    await asyncio.gather(*tasks)\n    return results\n\n\nasync def compute_cluster_similarities(\n    concepts: List[str], workspace: str = \"default\", threshold: float = 0.75\n) -> List[Dict[str, Any]]:\n    \"\"\"\n    Compute pairwise similarities for a list of concepts using their stored embeddings.\n    Returns pairs above the threshold - this powers the \"Venn\" clustering.\n    \"\"\"\n    from math import sqrt\n\n    from ..core.graph_db import get_driver\n\n    driver = get_driver()\n    embeddings = {}\n\n    with driver.session() as session:\n        for concept in concepts:\n            result = session.run(\n                \"\"\"\n                MATCH (c:Concept {name: $name, workspace: $workspace})\n                RETURN c.embedding AS embedding\n            \"\"\",\n                name=concept,\n                workspace=workspace,\n            )\n            record = result.single()\n            if record and record[\"embedding\"]:\n                embeddings[concept] = record[\"embedding\"]\n\n    # Pairwise cosine similarity\n    def cosine_sim(a, b):\n        dot = sum(x * y for x, y in zip(a, b))\n        na = sqrt(sum(x * x for x in a))\n        nb = sqrt(sum(x * x for x in b))\n        return dot / (na * nb) if (na and nb) else 0.0\n\n    clusters = []\n    concept_list = list(embeddings.keys())\n    for i in range(len(concept_list)):\n        for j in range(i + 1, len(concept_list)):\n            sim = cosine_sim(embeddings[concept_list[i]], embeddings[concept_list[j]])\n            if sim >= threshold:\n                clusters.append(\n                    {\n                        \"concept_a\": concept_list[i],\n                        \"concept_b\": concept_list[j],\n                        \"similarity\": round(sim, 4),\n                    }\n                )\n\n    clusters.sort(key=lambda x: x[\"similarity\"], reverse=True)\n    return clusters\n\n\n# =============================================================================\n# C. LIBRARIAN - Synthesis Wiki Persistence (Karpathy-style)\n# =============================================================================\n\n\nasync def save_concept_article(\n    workspace: str,\n    concept_name: str,\n    summary: str,\n    relationships: List[Dict[str, str]],\n    source_files: List[str],\n) -> str:\n    \"\"\"\n    Generate and save a 'Rationale Hub' article as a Markdown file in .benny/wiki/.\n    This creates the permanent 'Compounding Artifact' record.\n    \"\"\"\n    from ..core.workspace import get_workspace_path\n\n    wiki_path = get_workspace_path(workspace) / \".benny\" / \"wiki\"\n    wiki_path.mkdir(parents=True, exist_ok=True)\n\n    filename = re.sub(r\"[^a-zA-Z0-9]\", \"_\", concept_name) + \".md\"\n    file_path = wiki_path / filename\n\n    # Format relationships for the wiki\n    rel_md = \"\\n\".join(\n        [\n            f\"- **{r['predicate'].title()}**: {r['object']} ({r['object_type']})\"\n            for r in relationships\n        ]\n    )\n    sources_md = \"\\n\".join([f\"- {s}\" for s in source_files])\n\n    content = f\"\"\"# {concept_name}\n\n## 💡 Rationale Summary\n{summary}\n\n## 🔗 Semantic Connections (Knowledge Graph)\n{rel_md}\n\n## 📂 Source Context (Lineage)\n{sources_md}\n\n---\n*Generated by Benny Synthesis Engine. This is a Compounding Rationale Hub.*\n\"\"\"\n\n    with open(file_path, \"w\", encoding=\"utf-8\") as f:\n        f.write(content.strip())\n\n    return str(file_path)\n","numLines":1337,"startLine":1,"totalLines":1337}},"sourceToolAssistantUUID":"b6a68e75-3f45-4e97-ae49-120290aa2869","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"8a533f4f-52c1-4883-9f06-3b7e51d615ce","version":"2.1.187","gitBranch":"HEAD"}
