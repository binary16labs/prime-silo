AJOR}`\n221\t    },\n222\t    entry: {\n223\t      python: isWin ? \"python/python.exe\" : \"python/bin/python3\",\n224\t      java: isWin ? \"jre/bin/java.exe\" : \"jre/bin/java\",\n225\t      neo4j: isWin ? \"neo4j/bin/neo4j.bat\" : \"neo4j/bin/neo4j\",\n226\t      api: \"-m uvicorn benny.api.server:app --host 127.0.0.1 --port 8005\"\n227\t    }\n228\t  };\n229\t}\n230\t\n231\t/* ── heavy I/O (CI / local build only) ───────────────────────────────── */\n232\t\n233\tfunction ensureDir(dir) {\n234\t  fs.mkdirSync(dir, { recursive: true });\n235\t}\n236\t\n237\tfunction fileSha256(filePath) {\n238\t  const hash = createHash(\"sha256\");\n239\t  hash.update(fs.readFileSync(filePath));\n240\t  return hash.digest(\"hex\");\n241\t}\n242\t\n243\t// Download to cache if missing (verifying any pinned hash), else reuse; always\n244\t// return the file's sha256 so a local build surfaces the hashes to pin.\n245\tasync function ensureArchive(url, destPath, expectedSha256 = \"\") {\n246\t  if (fs.existsSync(destPath)) {\n247\t    const digest = fileSha256(destPath);\n248\t    if (expectedSha256 && digest.toLowerCase() !== expectedSha256.toLowerCase()) {\n249\t      fs.rmSync(destPath, { force: true });\n250\t    } else {\n251\t      return digest;\n252\t    }\n253\t  }\n254\t  return downloadFile(url, destPath, expectedSha256);\n255\t}\n256\t\n257\tasync function downloadFile(url, destPath, expectedSha256 = \"\") {\n258\t  const response = await fetch(url, { redirect: \"follow\" });\n259\t  if (!response.ok || !response.body) {\n260\t    throw new Error(`Download failed ${url} (${response.status})`);\n261\t  }\n262\t  ensureDir(path.dirname(destPath));\n263\t  const hash = createHash(\"sha256\");\n264\t  const tmp = `${destPath}.part`;\n265\t  await pipeline(\n266\t    Readable.fromWeb(response.body),\n267\t    async function* (source) {\n268\t      for await (const chunk of source) {\n269\t        hash.update(chunk);\n270\t        yield chunk;\n271\t      }\n272\t    },\n273\t    fs.createWriteStream(tmp)\n274\t  );\n275\t  const digest = hash.digest(\"hex\");\n276\t  if (expectedSha256 && digest.toLowerCase() !== expectedSha256.toLowerCase()) {\n277\t    fs.rmSync(tmp, { force: true });\n278\t    throw new Error(`Checksum mismatch for ${url}: got ${digest}`);\n279\t  }\n280\t  fs.renameSync(tmp, destPath);\n281\t  return digest;\n282\t}\n283\t\n284\t// Extract a .tar.gz or .zip into a temp dir, then move the single top-level\n285\t// directory's contents to `targetDir` (flatten the version-named wrapper dir).\n286\t// Resolve the tar binary. On Windows we MUST use the bundled bsdtar\n287\t// (System32\\tar.exe): if Git for Windows is installed, its GNU tar shadows\n288\t// bsdtar on PATH, and GNU tar misreads a Windows archive path like\n289\t// \"C:\\Users\\...\" as a remote host spec (\"C:\" → host) and fails with\n290\t// \"Cannot connect to C: resolve failed\". bsdtar handles drive-letter paths\n291\t// (and both .tar.gz and .zip) correctly.\n292\tfunction tarBin(platform = process.platform) {\n293\t  if (platform === \"win32\") {\n294\t    return path.join(process.env.SystemRoot || \"C:\\\\Windows\", \"System32\", \"tar.exe\");\n295\t  }\n296\t  return \"tar\";\n297\t}\n298\t\n299\tfunction extractAndFlatten(archivePath, targetDir, platform = process.platform) {\n300\t  const tmp = fs.mkdtempSync(path.join(os.tmpdir(), \"ps-extract-\"));\n301\t  const isZip = /\\.zip$/i.test(archivePath);\n302\t  try {\n303\t    if (isZip && platform !== \"win32\" && platform !== \"darwin\") {\n304\t      execFileSync(\"unzip\", [\"-q\", archivePath, \"-d\", tmp], { stdio: \"ignore\" });\n305\t    } else {\n306\t      // bsdtar (Windows 10+/macOS) handles both .tar.gz and .zip; GNU tar handles .tar.gz.\n307\t      execFileSync(tarBin(platform), [\"-xf\", archivePath, \"-C\", tmp], { stdio: \"ignore\" });\n308\t    }\n309\t    const entries = fs.readdirSync(tmp);\n310\t    const roots = entries.filter((e) => fs.statSync(path.join(tmp, e)).isDirectory());\n311\t    const sourceDir = roots.length === 1 ? path.join(tmp, roots[0]) : tmp;\n312\t    ensureDir(path.dirname(targetDir));\n313\t    fs.rmSync(targetDir, { recursive: true, force: true });\n314\t    fs.cpSync(sourceDir, targetDir, { recursive: true });\n315\t  } finally {\n316\t    fs.rmSync(tmp, { recursive: true, force: true });\n317\t  }\n318\t}\n319\t\n320\tfunction pipInstall(pythonExe, requirements, siteDir) {\n321\t  // Start from a clean site/ — `pip install --target` does NOT replace existing\n322\t  // packages (it warns \"already exists, specify --upgrade\" and skips them), so a\n323\t  // re-run over a previous (e.g. un-slimmed) bundle would silently keep stale\n324\t  // deps. Fresh CI checkouts are empty, but local rebuilds and any cached site/\n325\t  // must be wiped so the bundle contains exactly `requirements`.\n326\t  fs.rmSync(siteDir, { recursive: true, force: true });\n327\t  ensureDir(siteDir);\n328\t  const reqFile = path.join(siteDir, \"..\", \"requirements.runtime.txt\");\n329\t  fs.writeFileSync(reqFile, requirements.join(\"\\n\") + \"\\n\", \"utf8\");\n330\t  execFileSync(pythonExe, [\"-m\", \"pip\", \"install\", \"--upgrade\", \"pip\"], { stdio: \"inherit\" });\n331\t  execFileSync(\n332\t    pythonExe,\n333\t    [\"-m\", \"pip\", \"install\", \"--no-input\", \"--target\", siteDir, \"-r\", reqFile],\n334\t    { stdio: \"inherit\" }\n335\t  );\n336\t}\n337\t\n338\tfunction copyBennySource(projectRoot, bennyDir) {\n339\t  ensureDir(bennyDir);\n340\t  fs.cpSync(path.join(projectRoot, \"runtime\", \"benny\"), path.join(bennyDir, \"benny\"), {\n341\t    recursive: true,\n342\t    filter: (src) => !/[\\\\/](__pycache__|\\.pytest_cache|\\.mypy_cache)$/.test(src)\n343\t  });\n344\t  fs.copyFileSync(\n345\t    path.join(projectRoot, \"runtime\", \"benny_cli.py\"),\n346\t    path.join(bennyDir, \"benny_cli.py\")\n347\t  );\n348\t  // Ship runtime/configs alongside (model_profiles.json resolves to\n349\t  // <bundle>/benny/configs/ via model_profiles.py parents[2]/configs). Optional\n350\t  // overrides — built-in defaults still apply when a file is absent.\n351\t  const configsSrc = path.join(projectRoot, \"runtime\", \"configs\");\n352\t  if (fs.existsSync(configsSrc)) {\n353\t    fs.cpSync(configsSrc, path.join(bennyDir, \"configs\"), {\n354\t      recursive: true,\n355\t      filter: (src) => !/[\\\\/](__pycache__)$/.test(src)\n356\t    });\n357\t  }\n358\t}\n359\t\n360\t/**\n361\t * Assemble the runtime bundle for one platform/arch.\n362\t * @param {{platformKey?:string, platform?:string, arch?:string, projectRoot?:string, outDir?:string, manifestOnly?:boolean}} opts\n363\t */\n364\tasync function buildRuntimeBundle(opts = {}) {\n365\t  const platform = opts.platform || process.platform;\n366\t  const arch = opts.arch || process.arch;\n367\t  const projectRoot = opts.projectRoot || DEFAULT_PROJECT_ROOT;\n368\t  const outDir = opts.outDir || path.join(projectRoot, \"packaging\", \"runtime-bundle\");\n369\t  const manifestOnly = Boolean(opts.manifestOnly);\n370\t\n371\t  ensureDir(outDir);\n372\t  const manifest = buildBundleManifest({ platform, arch, projectRoot });\n373\t  // The bundle installs the curated minimal set (see BUNDLE_RUNTIME_REQUIREMENTS),\n374\t  // NOT the full server requirements — the full set overflows NSIS's payload.\n375\t  const requirements = bundleRuntimeRequirements();\n376\t\n377\t  if (manifestOnly) {\n378\t    fs.writeFileSync(\n379\t      path.join(outDir, \"requirements.runtime.txt\"),\n380\t      requirements.join(\"\\n\") + \"\\n\",\n381\t      \"utf8\"\n382\t    );\n383\t    fs.writeFileSync(path.join(outDir, \"bundle.json\"), JSON.stringify(manifest, null, 2));\n384\t    return { outDir, manifest, requirements, manifestOnly: true };\n385\t  }\n386\t\n387\t  const cacheDir = path.join(os.tmpdir(), \"ps-runtime-cache\");\n388\t  ensureDir(cacheDir);\n389\t  const sha256 = {};\n390\t\n391\t  // 1. Python.\n392\t  const python = resolvePythonBuild(platform, arch);\n393\t  const pyArchive = path.join(\n394\t    cacheDir,\n395\t    path.basename(new URL(python.url).pathname) || \"python.tar.gz\"\n396\t  );\n397\t  sha256.python = await ensureArchive(python.url, pyArchive, python.sha256);\n398\t  extractAndFlatten(pyArchive, path.join(outDir, \"python\"), platform);\n399\t\n400\t  // 2. Deps into site/, benny source.\n401\t  const pythonExe = path.join(\n402\t    outDir,\n403\t    \"python\",\n404\t    platform === \"win32\" ? \"python.exe\" : path.join(\"bin\", \"python3\")\n405\t  );\n406\t  pipInstall(pythonExe, requirements, path.join(outDir, \"site\"));\n407\t  copyBennySource(projectRoot, path.join(outDir, \"benny\"));\n408\t\n409\t  // 3. Neo4j + JRE.\n410\t  const neo4j = resolveNeo4jBuild(platform);\n411\t  const neoArchive = path.join(cacheDir, path.basename(new URL(neo4j.url).pathname));\n412\t  sha256.neo4j = await ensureArchive(neo4j.url, neoArchive, neo4j.sha256);\n413\t  extractAndFlatten(neoArchive, path.join(outDir, \"neo4j\"), platform);\n414\t\n415\t  const jre = resolveJreBuild(platform, arch);\n416\t  const jreArchive = path.join(\n417\t    cacheDir,\n418\t    `temurin-${JRE_MAJOR}-${platform}-${arch}.${platform === \"win32\" ? \"zip\" : \"tar.gz\"}`\n419\t  );\n420\t  sha256.jre = await ensureArchive(jre.url, jreArchive, jre.sha256);\n421\t  extractAndFlatten(jreArchive, path.join(outDir, \"jre\"), platform);\n422\t\n423\t  // Record the downloaded archive hashes — pin these into the *_BUILDS tables\n424\t  // before production. A local build surfaces them here.\n425\t  manifest.sha256 = sha256;\n426\t  fs.writeFileSync(path.join(outDir, \"bundle.json\"), JSON.stringify(manifest, null, 2));\n427\t  console.log(\"Runtime bundle component sha256 (pin these before deploy):\");\n428\t  for (const [name, digest] of Object.entries(sha256)) {\n429\t    console.log(`  ${name}: ${digest}`);\n430\t  }\n431\t  return { outDir, manifest, requirements, sha256, manifestOnly: false };\n432\t}\n433\t\n434\tmodule.exports = {\n435\t  buildRuntimeBundle,\n436\t  tarBin,\n437\t  resolvePythonBuild,\n438\t  resolveNeo4jBuild,\n439\t  resolveJreBuild,\n440\t  filterRuntimeRequirements,\n441\t  bundleRuntimeRequirements,\n442\t  buildBundleManifest,\n443\t  BUNDLE_RUNTIME_REQUIREMENTS,\n444\t  BUNDLE_EXCLUDED_PACKAGES,\n445\t  PYTHON_VERSION,\n446\t  NEO4J_VERSION\n447\t};\n448\t\n449\tif (require.main === module) {\n450\t  const args = process.argv.slice(2);\n451\t  const manifestOnly = args.includes(\"--manifest-only\");\n452\t  buildRuntimeBundle({ manifestOnly })\n453\t    .then((r) => {\n454\t      const m = r.manifest;\n455\t      console.log(\n456\t        `Runtime bundle (${m.platform}/${m.arch})${r.manifestOnly ? \" [manifest-only]\" : \"\"} at ${path.relative(DEFAULT_PROJECT_ROOT, r.outDir)}`\n457\t      );\n458\t      console.log(\n459\t        `  python ${m.components.python} · neo4j ${m.components.neo4j} · ${m.components.jre} · ${r.requirements.length} deps`\n460\t      );\n461\t    })\n462\t    .catch((error) => {\n463\t      console.error(error.message || error);\n464\t      process.exitCode = 1;\n465\t    });\n466\t}\n467\t"}]},"uuid":"457fd3e6-27ba-4820-a876-d2754e1ddb04","timestamp":"2026-06-28T15:48:43.143Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\packaging\\scripts\\assemble-runtime-bundle.js","content":"#!/usr/bin/env node\n\n// Assemble the self-contained Benny runtime bundle shipped inside the desktop\n// package so the EXE is zero-install. The bundle (see\n// packaging/desktop/runtime_supervisor.js, which spawns it) contains:\n//\n//   python/   embeddable standalone Python (python-build-standalone), arch-matched\n//   site/     baked site-packages: runtime deps (native wheels for THIS OS/arch)\n//   benny/    the runtime source (runtime/benny + benny_cli.py)\n//   neo4j/    Neo4j Community, unpacked\n//   jre/      Temurin JRE 17 (runs Neo4j), arch-matched\n//   bundle.json   manifest (versions, platform/arch, entry points)\n//\n// Native wheels (chromadb/hnswlib/tree-sitter/…) must be built on the target\n// runner, so this runs inside each platform's CI build step (and locally on a\n// matching host). Windows-x64 is wired first; other targets are Phase 2.\n//\n// Heavy network/extraction steps run only on a real build. `--manifest-only`\n// writes just the filtered requirements + bundle.json (for dry runs / tests /\n// non-target platforms) so the rest of the desktop build never breaks.\n\nconst fs = require(\"node:fs\");\nconst path = require(\"node:path\");\nconst os = require(\"node:os\");\nconst { createHash } = require(\"node:crypto\");\nconst { Readable } = require(\"node:stream\");\nconst { pipeline } = require(\"node:stream/promises\");\nconst { execFileSync } = require(\"node:child_process\");\n\nconst DEFAULT_PROJECT_ROOT = path.resolve(__dirname, \"../..\");\n\n// Pinned component versions. NOTE: sha256 values must be pinned per asset before\n// production (left \"\" here = verify-if-present). The Windows-x64 download URLs\n// are real; other platform rows are filled in Phase 2.\nconst PYTHON_RELEASE = \"20240814\";\nconst PYTHON_VERSION = \"3.11.9\";\nconst NEO4J_VERSION = \"5.23.0\";\nconst JRE_MAJOR = \"17\";\n\nconst PYTHON_BUILDS = {\n  \"win32:x64\": {\n    url: `https://github.com/astral-sh/python-build-standalone/releases/download/${PYTHON_RELEASE}/cpython-${PYTHON_VERSION}+${PYTHON_RELEASE}-x86_64-pc-windows-msvc-install_only.tar.gz`,\n    // Pinned from the verified local zero-install build (version-stable URL).\n    sha256: \"4c71d25731214b8a960d1d87510f24179d819249c5b434aaf7135818421b6215\"\n  }\n  // Phase 2: darwin:arm64, darwin:x64, linux:x64, linux:arm64, win32:arm64\n};\n\nconst NEO4J_BUILDS = {\n  // Pinned from the verified local zero-install build (version-stable URL).\n  win32: {\n    url: `https://dist.neo4j.org/neo4j-community-${NEO4J_VERSION}-windows.zip`,\n    sha256: \"d43151ba7104aa38da57426151468b602c32a6119a5089576a02781cd6f8250d\"\n  }\n  // Phase 2: darwin/linux → neo4j-community-<v>-unix.tar.gz\n};\n\n// Adoptium \"latest GA\" binary endpoints (redirect to the asset). NOTE: this URL\n// is a MOVING target — it resolves to whatever 17.x GA is current, so we cannot\n// pin a sha256 here (it would hard-fail the next time Adoptium bumps the patch).\n// Left verify-if-present; to pin, switch to a fixed-asset/version URL first.\n// (Reference: the 2026-06 local build resolved to\n//  sha256 79a598e1fbb4e16582d92c4ee22280a3c4d72fd52606e1e46b1223c0fe53b0da.)\nconst JRE_BUILDS = {\n  \"win32:x64\": {\n    url: `https://api.adoptium.net/v3/binary/latest/${JRE_MAJOR}/ga/windows/x64/jre/hotspot/normal/eclipse`,\n    sha256: \"\"\n  }\n  // Phase 2: mac/linux x64+arm64\n};\n\n/* ── pure helpers (unit-tested) ──────────────────────────────────────── */\n\nfunction platformArchKey(platform, arch) {\n  return `${platform}:${arch}`;\n}\n\nfunction resolvePythonBuild(platform, arch) {\n  const build = PYTHON_BUILDS[platformArchKey(platform, arch)];\n  if (!build) {\n    throw new Error(`No pinned Python build for ${platform}/${arch} (Phase 2).`);\n  }\n  return build;\n}\n\nfunction resolveNeo4jBuild(platform) {\n  const build =\n    NEO4J_BUILDS[platform] ||\n    (platform === \"darwin\" || platform === \"linux\"\n      ? { url: `https://dist.neo4j.org/neo4j-community-${NEO4J_VERSION}-unix.tar.gz`, sha256: \"\" }\n      : null);\n  if (!build) {\n    throw new Error(`No Neo4j build for ${platform} (Phase 2).`);\n  }\n  return build;\n}\n\nfunction resolveJreBuild(platform, arch) {\n  const build = JRE_BUILDS[platformArchKey(platform, arch)];\n  if (!build) {\n    throw new Error(`No pinned JRE build for ${platform}/${arch} (Phase 2).`);\n  }\n  return build;\n}\n\n// The runtime dependency set the *downloaded* runtime bundle installs.\n//\n// Since v1.2.9 the bundle is NOT packed into the installer — it ships as a\n// separate release asset the app fetches on first launch (see\n// packaging/scripts/p