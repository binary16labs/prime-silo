itertlm\",\n98\t        \"provider\": \"litert\",\n99\t        \"cost_per_1k\": 0.0,\n100\t        \"use_for\": [\"on-device\", \"offline\", \"npu-accelerated\", \"testing\", \"gemma-4\"]\n101\t    },\n102\t    \"voice_speed\": {\n103\t        \"model\": \"openai/qwen3-tk-4b-FLM\",\n104\t        \"provider\": \"lemonade\",\n105\t        \"cost_per_1k\": 0.0,\n106\t        \"use_for\": [\"voice\", \"speed\", \"high_speed\", \"low_latency\"]\n107\t    },\n108\t    # ---------------------------------------------------------------------------\n109\t    # NVIDIA NIM — OpenAI-compatible cloud inference\n110\t    # API key: NVIDIA_API_KEY env var (never stored in registry)\n111\t    # Browse full catalogue: https://build.nvidia.com/explore/reasoning\n112\t    # ---------------------------------------------------------------------------\n113\t    \"nvidia/deepseek-ai/deepseek-r1\": {\n114\t        \"provider\": \"nvidia_nim\",\n115\t        \"model\": \"deepseek-ai/deepseek-r1\",\n116\t        \"cost_per_1k\": 0.004,\n117\t        \"use_for\": [\"reasoning\", \"cloud\", \"nvidia\", \"thinking\"]\n118\t    },\n119\t    \"nvidia/deepseek-ai/deepseek-v3\": {\n120\t        \"provider\": \"nvidia_nim\",\n121\t        \"model\": \"deepseek-ai/deepseek-v3\",\n122\t        \"cost_per_1k\": 0.0004,\n123\t        \"use_for\": [\"general\", \"cloud\", \"nvidia\"]\n124\t    },\n125\t    \"nvidia/meta/llama-3.3-70b-instruct\": {\n126\t        \"provider\": \"nvidia_nim\",\n127\t        \"model\": \"meta/llama-3.3-70b-instruct\",\n128\t        \"cost_per_1k\": 0.00077,\n129\t        \"use_for\": [\"general\", \"cloud\", \"nvidia\", \"instruction\"]\n130\t    },\n131\t    \"nvidia/mistralai/mistral-large-2-instruct\": {\n132\t        \"provider\": \"nvidia_nim\",\n133\t        \"model\": \"mistralai/mistral-large-2-instruct\",\n134\t        \"cost_per_1k\": 0.002,\n135\t        \"use_for\": [\"general\", \"cloud\", \"nvidia\"]\n136\t    },\n137\t    \"nvidia/google/gemma-3-27b-it\": {\n138\t        \"provider\": \"nvidia_nim\",\n139\t        \"model\": \"google/gemma-3-27b-it\",\n140\t        \"cost_per_1k\": 0.0002,\n141\t        \"use_for\": [\"general\", \"cloud\", \"nvidia\"]\n142\t    },\n143\t    # AOS-001 OQ-1 (2026-04-26): default model for all AOS personas.\n144\t    # Exact Lemonade model name confirmed at Phase 0 wire-up — adjust the\n145\t    # \"model\" string below if the Lemonade catalogue uses a different slug.\n146\t    # Fallback: alias resolves to \"local_lemonade\" if qwen3_5_9b is absent.\n147\t    \"qwen3_5_9b\": {\n148\t        \"model\": \"openai/Qwen3-8B-Instruct-FLM\",\n149\t        \"provider\": \"lemonade\",\n150\t        \"cost_per_1k\": 0.0,\n151\t        \"use_for\": [\"sdlc\", \"offline\", \"planner\", \"architect\", \"aos_default\"]\n152\t    }\n153\t}\n154\t\n155\t\n156\t# =============================================================================\n157\t# PORTABILITY / OFFLINE HARDENING (PBR-001 Phase 3)\n158\t# =============================================================================\n159\t\n160\t# Prefixes that identify a model string as pointing at a local provider.\n161\t# ``litert`` is the only one that doesn't carry a live process — it's an\n162\t# on-device inference engine — but it is still \"local\" for the purposes of\n163\t# offline/local-only policy.\n164\t_LOCAL_PREFIXES: tuple[str, ...] = tuple(f\"{name}/\" for name in LOCAL_PROVIDERS.keys())\n165\t\n166\t\n167\tdef is_local_model(model_name: str) -> bool:\n168\t    \"\"\"Return True if ``model_name`` is served by a local provider.\"\"\"\n169\t    if model_name.startswith(_LOCAL_PREFIXES) or model_name.startswith(\"litert/\"):\n170\t        return True\n171\t\n172\t    # nvidia/ prefix is always a remote cloud provider\n173\t    if model_name.startswith(\"nvidia/\"):\n174\t        return False\n175\t\n176\t    # Check if it's a registry key pointing to a local provider\n177\t    if model_name in MODEL_REGISTRY:\n178\t        provider = MODEL_REGISTRY[model_name].get(\"provider\", \"\").lower()\n179\t        return provider in LOCAL_PROVIDERS or provider == \"litert\"\n180\t\n181\t    return False\n182\t\n183\t\n184\tdef _offline_enabled() -> bool:\n185\t    \"\"\"Return True if the BENNY_OFFLINE kill-switch is active.\"\"\"\n186\t    return os.environ.get(\"BENNY_OFFLINE\", \"\").lower() in (\"1\", \"true\", \"yes\")\n187\t\n188\t\n189\tclass OfflineRefusal(Exception):\n190\t    \"\"\"Raised when a non-local model is requested while offline mode is active.\"\"\"\n191\t\n192\t# =============================================================================\n193\t# MODEL RESOLUTION\n194\t# =============================================================================\n195\t\n196\tdef get_model_config(model_id: str) -> Dict[str, Any]:\n197\t    \"\"\"Resolve a model ID to a provider and configuration.\"\"\"\n198\t    if model_id in MODEL_REGISTRY:\n199\t        config = dict(MODEL_REGISTRY[model_id])\n200\t        # Enrich cloud-provider registry entries with base_url / api_key_env\n201\t        provider = config.get(\"provider\", \"\")\n202\t        if provider in CLOUD_PROVIDERS and \"base_url\" not in config:\n203\t            config.update({\n204\t                \"base_url\": CLOUD_PROVIDERS[provider][\"base_url\"],\n205\t                \"api_key_env\": CLOUD_PROVIDERS[provider][\"api_key_env\"],\n206\t            })\n207\t        return config\n208\t    \n209\t    # Handle direct provider/model strings\n210\t    if \"/\" in model_id:\n211\t        provider, model = model_id.split(\"/\", 1)\n212\t        config = {\n213\t            \"provider\": provider,\n214\t            \"model\": model,\n215\t            \"cost_per_1k\": 0.0\n216\t        }\n217\t        # Inject base_url for local providers if not in registry\n218\t        if provider in LOCAL_PROVIDERS:\n219\t            config[\"base_url\"] = LOCAL_PROVIDERS[provider][\"base_url\"]\n220\t        # nvidia/org/model-name — everything after \"nvidia/\" is the NIM model slug\n221\t        elif provider == \"nvidia\":\n222\t            nim = CLOUD_PROVIDERS[\"nvidia_nim\"]\n223\t            config[\"provider\"] = \"nvidia_nim\"\n224\t            config[\"model\"] = model          # full slug e.g. \"deepseek-ai/deepseek-r1\"\n225\t            config[\"base_url\"] = nim[\"base_url\"]\n226\t            config[\"api_key_env\"] = nim[\"api_key_env\"]\n227\t        return config\n228\t    \n229\t    return {\n230\t        \"provider\": \"openai\",\n231\t        \"model\": model_id,\n232\t        \"cost_per_1k\": 0.0\n233\t    }\n234\t\n235\tasync def get_active_model(workspace_id: str = \"default\", role: str = \"chat\", run_id: Optional[str] = None) -> str:\n236\t    \"\"\"Determine which model is currently 'active' for a role in a workspace.\"\"\"\n237\t    # Priority -1: Global environment override\n238\t    env_default = os.environ.get(\"BENNY_DEFAULT_MODEL\")\n239\t    if env_default:\n240\t        return env_default\n241\t\n242\t    # Priority 0: Check for an active swarm manifest snapshot in the run_store\n243\t    if run_id:\n244\t        try:\n245\t            from ..persistence.run_store import get_run\n246\t            record = get_run(run_id)\n247\t            if record and record.manifest_snapshot:\n248\t                # SwarmManifest.config.model is the primary override\n249\t                cfg = record.manifest_snapshot.get(\"config\", {})\n250\t                if cfg.get(\"model\"):\n251\t                    return cfg[\"model\"]\n252\t                # Fallback to variables.model\n253\t                vrs = record.manifest_snapshot.get(\"variables\", {})\n254\t                if vrs.get(\"model\"):\n255\t                    return vrs[\"model\"]\n256\t        except Exception as e:\n257\t            logger.debug(f\"RunStore lookup failed for {run_id}: {e}\")\n258\t\n259\t    try:\n260\t        from .workspace import load_manifest\n261\t        manifest = load_manifest(workspace_id)\n262\t        \n263\t        # 1. Check role-specific mapping\n264\t        if hasattr(manifest, \"model_roles\") and role in manifest.model_roles:\n265\t            return manifest.model_roles[role]\n266\t            \n267\t        # 2. Check workspace default\n268\t        if hasattr(manifest, \"default_model\") and manifest.default_model:\n269\t            return manifest.default_model\n270\t    except Exception as e:\n271\t        logger.debug(f\"Manifest load failed for {workspace_id}: {e}\")\n272\t    \n273\t    # 3. Auto-detect local providers (Heartbeat probe)\n274\t    # Increased timeout (5.0s) to handle busy local NPUs/CPUs (PBR-001 Phase 3)\n275\t    for provider_name, config in LOCAL_PROVIDERS.items():\n276\t        try:\n277\t            # OpenAI-compatible model list lives at <base_url>/models (e.g.\n278\t            # http://localhost:1234/v1/models). The old `.replace(\"/v1\",\"/models\")`\n279\t            # STRIPPED the /v1 segment → hit a 404 path, so local chat models were\n280\t            # never detected and routing leaked to openai/gpt-4o (which has no key\n281\t            # in a local/bundled install → \"Missing OPENAI_API_KEY\").\n282\t            models_url = config[\"base_url\"].rstrip(\"/\") + \"/models\"\n283\t            async with httpx.AsyncClient(timeout=5.0) as client:\n284\t                resp = await client.get(models_url)\n285\t                if resp.status_code == 200:\n286\t                    data = resp.json()\n287\t                    models = data.get(\"data\", [])\n288\t                    if models:\n289\t                        model_id = models[0].get(\"id\")\n290\t                        return f\"{provider_name}/{model_id}\"\n291\t        except Exception:\n292\t            pass\n293\t\n294\t    # 4. Global fallback — stay local-first.\n295\t    # Leaking to a cloud model here means an offline/bundled install silently\n296\t    # fails with \"Missing OPENAI_API_KEY\" (the synthesis path carries no key).\n297\t    # Only use the cloud default when we're online AND a key is actually present.\n298\t    if workspace_id != \"default\":\n299\t        return \"lemonade/default\"\n300\t    if _offline_enabled() or not os.environ.get(\"OPENAI_API_KEY\"):\n301\t        return \"lemonade/default\"\n302\t    return \"openai/gpt-4o\"\n303\t\n304\t# =============================================================================\n305\t# LOGGING & AUDIT\n306\t# =============================================================================\n307\t\n308\tdef log_llm_call(data: Dict[str, Any]):\n309\t    \"\"\"Log LLM call metadata to a JSONL file for audit and fine-tuning.\"\"\"\n310\t    log_file = os.path.join(\"logs\", \"llm_calls.jsonl\")\n311\t    os.makedirs(\"logs\", exist_ok=True)\n312\t    with open(log_file, \"a\", encoding=\"utf-8\") as f:\n313\t        f.write(json.dumps(data) + \"\\n\")\n314\t\n315\t# =============================================================================\n316\t# CORE DISPATCHER\n317\t# =============================================================================\n318\t\n319\tasync def _await_if_needed(obj):\n320\t    if hasattr(obj, '__await__'):\n321\t        return await obj\n322\t    return obj\n323\t\n324\tdef _run_completion(**kwargs):\n325\t    \"\"\"Sync wrapper for litellm.completion to allow easy patching.\"\"\"\n326\t    return completion(**kwargs)\n327\t\n328\tdef _thinking_disabled(model: str, actual_model: str, workspace_id: str) -> bool:\n329\t    \"\"\"True if the operator explicitly toggled this model to 'off' in the Agents\n330\t    screen (manifest model_thinking). Back-compat wrapper around the tri-state\n331\t    override; the full profile-aware decision lives in model_profiles.\"\"\"\n332\t    return _operator_thinking_override(model, actual_model, workspace_id) is True\n333\t\n334\t\n335\tdef _operator_thinking_override(model: str, actual_model: str, workspace_id: str):\n336\t    \"\"\"Tri-state operator override from manifest.model_thinking: True ('off' →\n337\t    suppress), False ('on' → keep), or None (no explicit override → defer to the\n338\t    model profile). Compares on the BARE model id so a toggle set as\n339\t    \"Qwen3-8B-Hybrid\" matches a prefixed call \"lemonade/Qwen3-8B-Hybrid\".\"\"\"\n340\t    try:\n341\t        from .workspace import load_manifest\n342\t        prefs = getattr(load_manifest(workspace_id), \"model_thinking\", {}) or {}\n343\t    except Exception:\n344\t        return None\n345\t    if not prefs:\n346\t        return None\n347\t    model_bare = {key.split(\"/\")[-1] for key in (model, actual_model) if key}\n348\t    for pref_key, value in prefs.items():\n349\t        if pref_key.split(\"/\")[-1] in model_bare:\n350\t            if value == \"off\":\n351\t                return True\n352\t            if value == \"on\":\n353\t                return False\n354\t    return None\n355\t\n356\t\n357\tasync def call_model(\n358\t    model: str,\n359\t    messages: List[Dict[str, str]],\n360\t    temperature: float = 0.7,\n361\t    max_tokens: int = 2048,\n362\t    fallbacks: Optional[List[str]] = None,\n363\t    timeout: Optional[float] = None,\n364\t    run_id: Optional[str] = None,\n365\t    authorized_tools: Optional[List[str]] = None,\n366\t    workspace_id: Optional[str] = None,\n367\t    role: Optional[str] = None,\n368\t) -> str:\n369\t    \"\"\"\n370\t    Main entry point for LLM inference.\n371\t    Handles LiteRT (local), LiteLLM (cloud/local), and system prompt augmentation.\n372\t    \"\"\"\n373\t    print(f\"DEBUG: call_model(model='{model}', run_id='{run_id}')\")\n374\t    \n375\t    # 0. RESOLVE REGISTRY KEY (Ensures LiteLLM doesn't see 'local_lemonade')\n376\t    actual_model = model\n377\t    if model in MODEL_REGISTRY:\n378\t        config = MODEL_REGISTRY[model]\n379\t        actual_model = config.get(\"model\", model)\n380\t        provider = config.get(\"provider\", \"\").lower()\n381\t        if \"/\" not in actual_model and provider:\n382\t             actual_model = f\"{provider}/{actual_model}\"\n383\t        print(f\"DEBUG: Resolved registry key '{model}' to '{actual_model}'\")\n384\t    \n385\t    start_ts = datetime.datetime.now()\n386\t    log_data = {\n387\t        \"ts\": start_ts.isoformat(),\n388\t        \"run_id\": run_id,\n389\t        \"model\": model,\n390\t        \"ok\": False\n391\t    }\n392\t\n393\t    # 1. OFFLINE KILL-SWITCH (PBR-001 Phase 3)\n394\t    if _offline_enabled() and not is_local_model(model):\n395\t        raise OfflineRefusal(\n396\t            f\"BENNY_OFFLINE is set; refusing to call non-local model: {model}\"\n397\t        )\n398\t\n399\t    # 2. SYSTEM PROMPT AUGMENTATION\n400\t    # Prefer an explicitly-passed workspace_id (e.g. from the synthesis engine,\n401\t    # whose extraction prompts carry no \"workspace:\" system marker). Fall back to\n402\t    # parsing it out of a system message for callers that embed it there.\n403\t    if not workspace_id:\n404\t        workspace_id = \"default\"\n405\t        for msg in messages:\n406\t            if msg.get(\"role\") == \"system\" and \"workspace:\" in msg.get(\"content\", \"\"):\n407\t                import re\n408\t                match = re.search(r\"workspace:\\s*(\\S+)\", msg[\"content\"])\n409\t                if match:\n410\t                    workspace_id = match.group(1)\n411\t                    break\n412\t    \n413\t    from ..governance.operating_manual import build_system_prompt_augmentation\n414\t    augmentation = build_system_prompt_augmentation(workspace_id, tools=authorized_tools)\n415\t    if augmentation:\n416\t        system_found = False\n417\t        for i, msg in enumerate(messages):\n418\t            if msg.get(\"role\") == \"system\":\n419\t                messages[i][\"content\"] = augmentation + msg.get(\"content\", \"\")\n420\t                system_found = True\n421\t                break\n422\t        if not system_found:\n423\t            messages.insert(0, {\"role\": \"system\", \"content\": augmentation})\n424\t\n425\t    # 2b. THINKING SUPPRESSION (profile-aware, default-safe)\n426\t    # The model profile classifies each model as capable / fragile / none; for a\n427\t    # 'capable' model on a structured role (e.g. graph_synthesis) hidden reasoning\n428\t    # is auto-suppressed so triple extraction gets parseable JSON — no operator\n429\t    # toggle required. 'fragile' (FLM) models are never touched (/no_think empties\n430\t    # them). An explicit Agents-screen toggle (model_thinking) still wins for\n431\t    # capable/none models. Suppression uses BOTH the Qwen \"/no_think\" soft\n432\t    # directive and chat_template_kwargs.enable_thinking=false so the local-executor\n433\t    # and LiteLLM paths both inherit it.\n434\t    think_extra = None\n435\t    from .model_profiles import should_suppress_thinking\n436\t    _override = _operator_thinking_override(model, actual_model, workspace_id)\n437\t    if should_suppress_thinking(model, actual_model, workspace_id, role, operator_override=_override):\n438\t        for i in range(len(messages) - 1, -1, -1):\n439\t            if messages[i].get(\"role\") == \"user\":\n440\t                messages[i][\"content\"] = \"/no_think\\n\" + messages[i].get(\"content\", \"\")\n441\t                break\n442\t        think_extra = {\"chat_template_kwargs\": {\"enable_thinking\": False}}\n443\t\n444\t    # 3. RESOLVE TIMEOUT\n445\t    actual_timeout = timeout\n446\t    if actual_timeout is None:\n447\t        env_timeout = os.environ.get(\"BENNY_LLM_TIMEOUT\")\n448\t        if env_timeout:\n449\t            actual_timeout = float(env_timeout)\n450\t        else:\n451\t            try:\n452\t                from .workspace import load_manifest\n453\t                manifest = load_manifest(workspace_id)\n454\t                actual_timeout = getattr(manifest, \"llm_timeout\", 300.0)\n455\t            except Exception:\n456\t                actual_timeout = 300.0\n457\t\n458\t    # 4. LITERT ROUTING (Local On-Device)\n459\t    if actual_model.startswith(\"litert/\"):\n460\t        try:\n461\t            model_id = actual_model.split(\"/\")[-1]\n462\t            engine = LiteRTEngine()\n463\t            response = await engine.generate(model_id, messages, temperature, max_tokens)\n464\t            log_data[\"ok\"] = True\n465\t            log_data[\"provider\"] = \"litert\"\n466\t            log_data[\"duration_ms\"] = int((datetime.datetime.now() - start_ts).total_seconds() * 1000)\n467\t            log_llm_call(log_data)\n468\t            return response\n469\t        except Exception as e:\n470\t            log_data[\"error\"] = str(e)\n471\t            log_llm_call(log_data)\n472\t            raise\n473\t\n474\t    # 5. LOCAL EXECUTOR SHORT-CIRCUIT (PBR-001 Phase 5)\n475\t    # If the model is local, we bypass LiteLLM to ensure reliability\n476\t    if is_local_model(model) or is_local_model(actual_model):\n477\t        # Resolve to a specific provider/model string if it's a registry key\n478\t        config = get_model_config(model)\n479\t        provider = config.get(\"provider\", \"\").lower()\n480\t        model_id = config.get(\"model\", \"\")\n481\t        \n482\t        lookup_str = model\n483\t        if \"/\" not in model and provider:\n484\t            lookup_str = f\"{provider}/{model_id}\"\n485\t            \n486\t        executor = resolve_executor(lookup_str)\n487\t        print(f\"DEBUG: is_local_model=True, lookup='{lookup_str}', executor={executor}\")\n488\t        if executor:\n489\t            system_msg = None\n490\t            user_msg = \"\"\n491\t            for msg in messages:\n492\t                if msg.get(\"role\") == \"system\":\n493\t                    system_msg = msg.get(\"content\")\n494\t                elif msg.get(\"role\") == \"user\":\n495\t                    user_msg = msg.get(\"content\", \"\")\n496\t            \n497\t            try:\n498\t                content = await executor.generate(\n499\t                    prompt=user_msg,\n500\t                    system=system_msg,\n501\t                    temperature=temperature,\n502\t                    max_tokens=max_tokens,\n503\t                    run_id=run_id,\n504\t                    timeout=actual_timeout or 300.0,\n505\t                    extra_body=think_extra,\n506\t                )\n507\t                \n508\t                log_data[\"ok\"] = True\n509\t                log_data[\"provider\"] = f\"local/{executor.provider_name}\"\n510\t                log_data[\"duration_ms\"] = int((datetime.datetime.now() - start_ts).total_seconds() * 1000)\n511\t                try:\n512\t                    log_data[\"tokens_in\"] = executor.count_tokens(user_msg + (system_msg or \"\"))\n513\t                    log_data[\"tokens_out\"] = executor.count_tokens(content)\n514\t                except Exception: pass\n515\t                log_llm_call(log_data)\n516\t                return content\n517\t            except Exception as e:\n518\t                log_data[\"error\"] = str(e)\n519\t                log_data[\"duration_ms\"] = int((datetime.datetime.now() - start_ts).total_seconds() * 1000)\n520\t                log_llm_call(log_data)\n521\t                raise\n522\t\n523\t    # 6. LITELLM DISPATCHER (Cloud)\n524\t    try:\n525\t        config = get_model_config(model)\n526\t        provider = config.get(\"provider\", \"openai\").lower()\n527\t\n528\t        # Multi-endpoint fan-out: if a worker pool is configured for this local\n529\t        # provider (BENNY_MODEL_ENDPOINTS / BENNY_<PROVIDER>_ENDPOINTS), round-robin\n530\t        # this call across the pool so concurrent fan-out lands on different\n531\t        # machines instead of serializing on one model server. No pool → unchanged.\n532\t        if config.get(\"base_url\") and provider in LOCAL_PROVIDERS:\n533\t            from .endpoints import resolve_endpoint\n534\t            config[\"base_url\"] = resolve_endpoint(provider, config[\"base_url\"])\n535\t\n536\t        # Ensure we use the model ID without the provider prefix for the actual call\n537\t        litellm_model = actual_model\n538\t        if \"/\" in litellm_model and (provider in [\"lemonade\", \"ollama\", \"fastflowlm\", \"lmstudio\"] or \"base_url\" in config):\n539\t            litellm_model = litellm_model.split(\"/\")[-1]\n540\t        \n541\t        # Normalize local providers for LiteLLM if they somehow leaked here\n542\t        local_mapping = [\"lemonade\", \"fastflowlm\", \"lmstudio\", \"ollama\"]\n543\t        if provider in local_mapping or \"base_url\" in config:\n544\t            if not litellm_model.startswith(\"openai/\"):\n545\t                litellm_model = f\"openai/{litellm_model}\"\n546\t\n547\t        # NOTE: we do NOT auto-inject \"/no_think\" by name heuristic — some\n548\t        # thinking models (Qwen3-8B-Hybrid) need it while others (qwen3.5-9b-FLM)\n549\t        # return EMPTY with it. It is now driven explicitly per-model by the\n550\t        # Agents thinking toggle (think_extra, applied in section 2b above).\n551\t        kwargs = {\n552\t            \"model\": litellm_model,\n553\t            \"messages\": messages,\n554\t            \"temperature\": temperature,\n555\t            \"max_tokens\": max_tokens,\n556\t            \"fallbacks\": fallbacks or []\n557\t        }\n558\t        if think_extra:\n559\t            kwargs[\"extra_body\"] = think_extra\n560\t\n561\t        if \"base_url\" in config and config[\"base_url\"]:\n562\t            kwargs[\"api_base\"] = config[\"base_url\"]\n563\t            kwargs[\"base_url\"] = config[\"base_url\"] # Double-bagging for OpenAI v1\n564\t            kwargs[\"custom_llm_provider\"] = \"openai\" # Force OpenAI-compatible mode\n565\t        \n566\t        # 6a. TOOL RESOLUTION\n567\t        if authorized_tools:\n568\t            from .skill_registry import registry\n569\t            tool_schemas = registry.get_tool_schemas(authorized_tools, workspace_id)\n570\t            if tool_schemas:\n571\t                kwargs[\"tools\"] = tool_schemas\n572\t        \n573\t        # Inject API key — cloud providers read from env; local providers use sentinel.\n574\t        if provider == \"nvidia_nim\":\n575\t            # Key comes from env — never hardcoded. Warn clearly if missing.\n576\t            nvidia_key = os.environ.get(\n577\t                config.get(\"api_key_env\", \"NVIDIA_API_KEY\"), \"\"\n578\t            )\n579\t            if not nvidia_key:\n580\t                logger.warning(\n581\t                    \"NVIDIA_API_KEY is not set. NVIDIA NIM calls will be rejected. \"\n582\t                    \"Set it with: [Environment]::SetEnvironmentVariable('NVIDIA_API_KEY','nvapi-...','User')\"\n583\t                )\n584\t            kwargs[\"api_key\"] = nvidia_key or \"not-set\"\n585\t            kwargs[\"custom_llm_provider\"] = \"openai\"   # NIM is OpenAI-compatible\n586\t        elif \"api_key\" in config and config[\"api_key\"]:\n587\t            kwargs[\"api_key\"] = config[\"api_key\"]\n588\t        elif provider in local_mapping or \"api_base\" in kwargs:\n589\t            kwargs[\"api_key\"] = \"not-needed\"\n590\t\n591\t\n592\t        if actual_timeout:\n593\t            kwargs[\"timeout\"] = actual_timeout\n594\t\n595\t        # 6b. EXECUTION LOOP (Handles Tool Calls)\n596\t        max_steps = 5\n597\t        current_step = 0\n598\t        final_content = \"\"\n599\t        \n600\t        while current_step < max_steps:\n601\t            current_step += 1\n602\t            print(f\"DEBUG: Calling model={model} (step {current_step}) via LiteLLM as {litellm_model} @ {kwargs.get('api_base')}\")\n603\t            \n604\t            response = await _await_if_needed(_run_completion(**kwargs))\n605\t\n606\t            if isinstance(response, str):\n607\t                final_content = response\n608\t                break\n609\t            \n610\t            # Extract message\n611\t            if hasattr(response, \"choices\") and len(response.choices) > 0:\n612\t                message = response.choices[0].message\n613\t            elif isinstance(response, dict) and \"choices\" in response and len(response[\"choices\"]) > 0:\n614\t                message = response[\"choices\"][0].get(\"message\")\n615\t            else:\n616\t                final_content = str(response)\n617\t                break\n618\t                \n619\t            messages.append(message)\n620\t            \n621\t            # Handle Tool Calls\n622\t            tool_calls = getattr(message, \"tool_calls\", None) or (message.get(\"tool_calls\") if isinstance(message, dict) else None)\n623\t            if tool_calls:\n624\t                from .skill_registry import registry\n625\t                for tc in tool_calls:\n626\t                    func_name = tc.function.name if hasattr(tc, \"function\") else tc.get(\"function\", {}).get(\"name\")\n627\t                    call_id = tc.id if hasattr(tc, \"id\") else tc.get(\"id\")\n628\t                    args_str = tc.function.arguments if hasattr(tc, \"function\") else tc.get(\"function\", {}).get(\"arguments\", \"{}\")\n629\t                    \n630\t                    try:\n631\t                        args = json.loads(args_str)\n632\t                        print(f\"DEBUG: Executing tool '{func_name}' with args: {args}\")\n633\t                        \n634\t                        # Execute skill\n635\t                        result = await registry.execute_skill(\n636\t                            func_name, \n637\t                            workspace_id, \n638\t                            agent_id=run_id, \n639\t                            **args\n640\t                        )\n641\t                        \n642\t                        messages.append({\n643\t                            \"role\": \"tool\",\n644\t                            \"tool_call_id\": call_id,\n645\t                            \"name\": func_name,\n646\t                            \"content\": str(result)\n647\t                        })\n648\t                    except Exception as te:\n649\t                        print(f\"DEBUG: Tool execution failed: {te}\")\n650\t                        messages.append({\n651\t                            \"role\": \"tool\",\n652\t                            \"tool_call_id\": call_id,\n653\t                            \"name\": func_name,\n654\t                            \"content\": f\"Error: {str(te)}\"\n655\t                        })\n656\t                # Update kwargs with new messages for next iteration\n657\t                kwargs[\"messages\"] = messages\n658\t            else:\n659\t                # No more tool calls, we are done\n660\t                final_content = message.content if hasattr(message, \"content\") else message.get(\"content\", \"\")\n661\t                break\n662\t        \n663\t        # Final result from the loop\n664\t        response_obj = response\n665\t        content = final_content\n666\t        \n667\t        # Usage Tracking\n668\t        try:\n669\t             usage = response_obj.get(\"usage\", {}) if hasattr(response_obj, \"get\") else getattr(response_obj, \"usage\", {})\n670\t             usage_data = usage if isinstance(usage, dict) else (usage.model_dump() if hasattr(usage, 'model_dump') else dict(usage))\n671\t             \n672\t             event_bus.emit(run_id, \"resource_usage\", {\n673\t                 \"model\": litellm_model,\n674\t                 \"provider\": provider,\n675\t                 \"usage\": usage_data,\n676\t                 \"duration_ms\": int((datetime.datetime.now() - start_ts).total_seconds() * 1000),\n677\t                 \"timestamp\": datetime.datetime.now().isoformat()\n678\t             })\n679\t             \n680\t             log_data[\"ok\"] = True\n681\t             log_data[\"provider\"] = provider\n682\t             log_data[\"tokens_in\"] = usage_data.get(\"prompt_tokens\", 0)\n683\t             log_data[\"tokens_out\"] = usage_data.get(\"completion_tokens\", 0)\n684\t             log_data[\"duration_ms\"] = int((datetime.datetime.now() - start_ts).total_seconds() * 1000)\n685\t             log_llm_call(log_data)\n686\t        except Exception: pass\n687\t\n688\t        if not content:\n689\t            logger.warning(f\"Model {model} returned an empty response (run_id={run_id})\")\n690\t\n691\t        return content\n692\t\n693\t    except Exception as e:\n694\t        log_data[\"error\"] = str(e)\n695\t        log_data[\"duration_ms\"] = int((datetime.datetime.now() - start_ts).total_seconds() * 1000)\n696\t        log_llm_call(log_data)\n697\t        \n698\t        if fallbacks:\n699\t            for fallback in fallbacks:\n700\t                try:\n701\t                    return await call_model(fallback, messages, temperature, max_tokens, timeout=timeout, run_id=run_id)\n702\t                except: continue\n703\t        raise e\n704\t"}]},"uuid":"68179a86-1260-40be-9afc-d006147cbd88","timestamp":"2026-06-28T15:14:00.504Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\models.py","content":"\"\"\"\nMulti-Model Orchestration - LiteLLM integration with local/cloud providers\n\"\"\"\n\nimport os\nimport httpx\nfrom typing import Optional, Dict, Any, List\nfrom litellm import completion\nimport logging\nfrom .litert_engine import LiteRTEngine\nimport datetime\nfrom .event_bus import event_bus\nimport json\n\n# Local Executor imports (added for direct access)\nfrom .local_executor import resolve_executor\n\nlogger = logging.getLogger(__name__)\n\n# Registry of local providers and their base URLs\nLOCAL_PROVIDERS = {\n    \"ollama\": {\n        \"port\": 11434,\n        \"base_url\": \"http://localhost:11434/v1\",\n        \"doc_url\": \"https://ollama.com\",\n    },\n    \"lemonade\": {\n        \"port\": 13305,\n        \"base_url\": \"http://127.0.0.1:13305/api/v1\",\n        \"docs\": \"https://github.com/skybluecycology/lemonade\",\n        \"startup_cmd\": \"LemonadeServer.exe serve --port 13305\",\n        \"check_url\": \"http://127.0.0.1:13305/api/v1/models\"\n    },\n    \"fastflowlm\": {\n        \"port\": 52625,\n        \"base_url\": \"http://localhost:52625/v1\",\n        \"docs\": \"https://github.com/skybluecycology/fastflow\",\n    },\n    \"lmstudio\": {\n        \"port\": 1234,\n        \"base_url\": \"http://localhost:1234/v1\",\n        \"docs\": \"https://lmstudio.ai\",\n    }\n}\n\n# ---------------------------------------------------------------------------\n# Cloud providers with custom base URLs (OpenAI-compatible APIs).\n# API keys are read from env vars at call time — never stored here.\n# ---------------------------------------------------------------------------\nCLOUD_PROVIDERS = {\n    \"nvidia_nim\": {\n        \"base_url\": \"https://integrate.api.nvidia.com/v1\",\n        \"api_key_env\": \"NVIDIA_API_KEY\",\n        \"docs\": \"https://build.nvidia.com/explore/reasoning\",\n        \"offline_safe\": False,  # requires internet — blocked by BENNY_OFFLINE=1\n    },\n}\n\nMODEL_REGISTRY = {\n    # Cloud providers\n    \"openai/gpt-4o\": {\n        \"provider\": \"openai\",\n        \"model\": \"gpt-4o\",\n        \"cost_per_1k\": 0.03\n    },\n    \"anthropic/claude-3-sonnet\": {\n        \"provider\": \"anthropic\",\n        \"model\": \"claude-3-sonnet-20240229\",\n        \"cost_per_1k\": 0.015\n    },\n    # Local models for privacy and cost savings\n    \"local_lemonade\": {\n        \"model\": \"qwen3.5-9b-FLM\",\n        \"provider\": \"lemonade\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"offline\", \"sensitive_data\", \"testing\", \"reasoning\", \"content_generation\"]\n    },\n    \"local_ollama\": {\n        \"model\": \"ollama/llama3\",\n        \"provider\": \"ollama\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"offline\", \"sensitive_data\"]\n    },\n    \"local_fastflow\": {\n        \"model\": \"openai/deepseek-r1:8b\",\n        \"provider\": \"fastflowlm\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"intel_npu\", \"offline\", \"testing\", \"reasoning\"]\n    },\n    \"local_lmstudio\": {\n        \"model\": \"openai/Gemma-4-E4B-it-GGUF\", # Optimized ID for Lemonade-compatible requests\n        \"provider\": \"lmstudio\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"offline\", \"sensitive_data\", \"testing\", \"reasoning\"]\n    },\n    \"local_litert\": {\n        \"model\": \"litert/gemma-4-E4B-it.litertlm\",\n        \"provider\": \"litert\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"on-device\", \"offline\", \"npu-accelerated\", \"testing\", \"gemma-4\"]\n    },\n    \"voice_speed\": {\n        \"model\": \"openai/qwen3-tk-4b-FLM\",\n        \"provider\": \"lemonade\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"voice\", \"speed\", \"high_speed\", \"low_latency\"]\n    },\n    # ---------------------------------------------------------------------------\n    # NVIDIA NIM — OpenAI-compatible cloud inference\n    # API key: NVIDIA_API_KEY env var (never stored in registry)\n    # Browse full catalogue: https://build.nvidia.com/explore/reasoning\n    # ---------------------------------------------------------------------------\n    \"nvidia/deepseek-ai/deepseek-r1\": {\n        \"provider\": \"nvidia_nim\",\n        \"model\": \"deepseek-ai/deepseek-r1\",\n        \"cost_per_1k\": 0.004,\n        \"use_for\": [\"reasoning\", \"cloud\", \"nvidia\", \"thinking\"]\n    },\n    \"nvidia/deepseek-ai/deepseek-v3\": {\n        \"provider\": \"nvidia_nim\",\n        \"model\": \"deepseek-ai/deepseek-v3\",\n        \"cost_per_1k\": 0.0004,\n        \"use_for\": [\"general\", \"cloud\", \"nvidia\"]\n    },\n    \"nvidia/meta/llama-3.3-70b-instruct\": {\n        \"provider\": \"nvidia_nim\",\n        \"model\": \"meta/llama-3.3-70b-instruct\",\n        \"cost_per_1k\": 0.00077,\n        \"use_for\": [\"general\", \"cloud\", \"nvidia\", \"instruction\"]\n    },\n    \"nvidia/mistralai/mistral-large-2-instruct\": {\n        \"provider\": \"nvidia_nim\",\n        \"model\": \"mistralai/mistral-large-2-instruct\",\n        \"cost_per_1k\": 0.002,\n        \"use_for\": [\"general\", \"cloud\", \"nvidia\"]\n    },\n    \"nvidia/google/gemma-3-27b-it\": {\n        \"provider\": \"nvidia_nim\",\n        \"model\": \"google/gemma-3-27b-it\",\n        \"cost_per_1k\": 0.0002,\n        \"use_for\": [\"general\", \"cloud\", \"nvidia\"]\n    },\n    # AOS-001 OQ-1 (2026-04-26): default model for all AOS personas.\n    # Exact Lemonade model name confirmed at Phase 0 wire-up — adjust the\n    # \"model\" string below if the Lemonade catalogue uses a different slug.\n    # Fallback: alias resolves to \"local_lemonade\" if qwen3_5_9b is absent.\n    \"qwen3_5_9b\": {\n        \"model\": \"openai/Qwen3-8B-Instruct-FLM\",\n        \"provider\": \"lemonade\",\n        \"cost_per_1k\": 0.0,\n        \"use_for\": [\"sdlc\", \"offline\", \"planner\", \"architect\", \"aos_default\"]\n    }\n}\n\n\n# =============================================================================\n# PORTABILITY / OFFLINE HARDENING (PBR-001 Phase 3)\n# =============================================================================\n\n# Prefixes that identify a model string as pointing at a local provider.\n# ``litert`` is the only one that doesn't carry a live process — it's an\n# on-device inference engine — but it is still \"local\" for the purposes of\n# offline/local-only policy.\n_LOCAL_PREFIXES: tuple[str, ...] = tuple(f\"{name}/\" for name in LOCAL_PROVIDERS.keys())\n\n\ndef is_local_model(model_name: str) -> bool:\n    \"\"\"Return True if ``model_name`` is served by a local provider.\"\"\"\n    if model_name.startswith(_LOCAL_PREFIXES) or model_name.startswith(\"litert/\"):\n        return True\n\n    # nvidia/ prefix is always a remote cloud provider\n    if model_name.startswith(\"nvidia/\"):\n        return False\n\n    # Check if it's a registry key pointing to a local provider\n    if model_name in MODEL_REGISTRY:\n        provider = MODEL_REGISTRY[model_name].get(\"provider\", \"\").lower()\n        return provider in LOCAL_PROVIDERS or provider == \"litert\"\n\n    return False\n\n\ndef _offline_enabled() -> bool:\n    \"\"\"Return True if the BENNY_OFFLINE kill-switch is active.\"\"\"\n    return os.environ.get(\"BENNY_OFFLINE\", \"\").lower() in (\"1\", \"true\", \"yes\")\n\n\nclass OfflineRefusal(Exception):\n    \"\"\"Raised when a non-local model is requested while offline mode is active.\"\"\"\n\n# =============================================================================\n# MODEL RESOLUTION\n# =============================================================================\n\ndef get_model_config(model_id: str) -> Dict[str, Any]:\n    \"\"\"Resolve a model ID to a provider and configuration.\"\"\"\n    if model_id in MODEL_REGISTRY:\n        config = dict(MODEL_REGISTRY[model_id])\n        # Enrich cloud-provider registry entries with base_url / api_key_env\n        provider = config.get(\"provider\", \"\")\n        if provider in CLOUD_PROVIDERS and \"base_url\" not in config:\n            config.update({\n                \"base_url\": CLOUD_PROVIDERS[provider][\"base_url\"],\n                \"api_key_env\": CLOUD_PROVIDERS[provider][\"api_key_env\"],\n            })\n        return config\n    \n    # Handle direct provider/model strings\n    if \"/\" in model_id:\n        provider, model = model_id.split(\"/\", 1)\n        config = {\n            \"provider\": provider,\n            \"model\": model,\n            \"cost_per_1k\": 0.0\n        }\n        # Inject base_url for local providers if not in registry\n        if provider in LOCAL_PROVIDERS:\n            config[\"base_url\"] = LOCAL_PROVIDERS[provider][\"base_url\"]\n        # nvidia/org/model-name — everything after \"nvidia/\" is the NIM model slug\n        elif provider == \"nvidia\":\n            nim = CLOUD_PROVIDERS[\"nvidia_nim\"]\n            config[\"provider\"] = \"nvidia_nim\"\n            config[\"model\"] = model          # full slug e.g. \"deepseek-ai/deepseek-r1\"\n            config[\"base_url\"] = nim[\"base_url\"]\n            config[\"api_key_env\"] = nim[\"api_key_env\"]\n        return config\n    \n    return {\n        \"provider\": \"openai\",\n        \"model\": model_id,\n        \"cost_per_1k\": 0.0\n    }\n\nasync def get_active_model(workspace_id: str = \"default\", role: str = \"chat\", run_id: Optional[str] = None) -> str:\n    \"\"\"Determine which model is currently 'active' for a role in a workspace.\"\"\"\n    # Priority -1: Global environment override\n    env_default = os.environ.get(\"BENNY_DEFAULT_MODEL\")\n    if env_default:\n        return env_default\n\n    # Priority 0: Check for an active swarm manifest snapshot in the run_store\n    if run_id:\n        try:\n            from ..persistence.run_store import get_run\n            record = get_run(run_id)\n            if record and record.manifest_snapshot:\n                # SwarmManifest.config.model is the primary override\n                cfg = record.manifest_snapshot.get(\"config\", {})\n                if cfg.get(\"model\"):\n                    return cfg[\"model\"]\n                # Fallback to variables.model\n                vrs = record.manifest_snapshot.get(\"variables\", {})\n                if vrs.get(\"model\"):\n                    return vrs[\"model\"]\n        except Exception as e:\n            logger.debug(f\"RunStore lookup failed for {run_id}: {e}\")\n\n    try:\n        from .workspace import load_manifest\n        manifest = load_manifest(workspace_id)\n        \n        # 1. Check role-specific mapping\n        if hasattr(manifest, \"model_roles\") and role in manifest.model_roles:\n            return manifest.model_roles[role]\n            \n        # 2. Check workspace default\n        if hasattr(manifest, \"default_model\") and manifest.default_model:\n            return manifest.default_model\n    except Exception as e:\n        logger.debug(f\"Manifest load failed for {workspace_id}: {e}\")\n    \n    # 3. Auto-detect local providers (Heartbeat probe)\n    # Increased timeout (5.0s) to handle busy local NPUs/CPUs (PBR-001 Phase 3)\n    for provider_name, config in LOCAL_PROVIDERS.items():\n        try:\n            # OpenAI-compatible model list lives at <base_url>/models (e.g.\n            # http://localhost:1234/v1/models). The old `.replace(\"/v1\",\"/models\")`\n            # STRIPPED the /v1 segment → hit a 404 path, so local chat models were\n            # never detected and routing leaked to openai/gpt-4o (which has no key\n            # in a local/bundled install → \"Missing OPENAI_API_KEY\").\n            models_url = config[\"base_url\"].rstrip(\"/\") + \"/models\"\n            async with httpx.AsyncClient(timeout=5.0) as client:\n                resp = await client.get(models_url)\n                if resp.status_code == 200:\n                    data = resp.json()\n                    models = data.get(\"data\", [])\n                    if models:\n                        model_id = models[0].get(\"id\")\n                        return f\"{provider_name}/{model_id}\"\n        except Exception:\n            pass\n\n    # 4. Global fallback — stay local-first.\n    # Leaking to a cloud model here means an offline/bundled install silently\n    # fails with \"Missing OPENAI_API_KEY\" (the synthesis path carries no key).\n    # Only use the cloud default when we're online AND a key is actually present.\n    if workspace_id != \"default\":\n        return \"lemonade/default\"\n    if _offline_enabled() or not os.environ.get(\"OPENAI_API_KEY\"):\n        return \"lemonade/default\"\n    return \"openai/gpt-4o\"\n\n# =============================================================================\n# LOGGING & AUDIT\n# =============================================================================\n\ndef log_llm_call(data: Dict[str, Any]):\n    \"\"\"Log LLM call metadata to a JSONL file for audit and fine-tuning.\"\"\"\n    log_file = os.path.join(\"logs\", \"llm_calls.jsonl\")\n    os.makedirs(\"logs\", exist_ok=True)\n    with open(log_file, \"a\", encoding=\"utf-8\") as f:\n        f.write(json.dumps(data) + \"\\n\")\n\n# =============================================================================\n# CORE DISPATCHER\n# =============================================================================\n\nasync def _await_if_needed(obj):\n    if hasattr(obj, '__await__'):\n        return await obj\n    return obj\n\ndef _run_completion(**kwargs):\n    \"\"\"Sync wrapper for litellm.completion to allow easy patching.\"\"\"\n    return completion(**kwargs)\n\ndef _thinking_disabled(model: str, actual_model: str, workspace_id: str) -> bool:\n    \"\"\"True if the operator explicitly toggled this model to 'off' in the Agents\n    screen (manifest model_thinking). Back-compat wrapper around the tri-state\n    override; the full profile-aware decision lives in model_profiles.\"\"\"\n    return _operator_thinking_override(model, actual_model, workspace_id) is True\n\n\ndef _operator_thinking_override(model: str, actual_model: str, workspace_id: str):\n    \"\"\"Tri-state operator override from manifest.model_thinking: True ('off' →\n    suppress), False ('on' → keep), or None (no explicit override → defer to the\n    model profile). Compares on the BARE model id so a toggle set as\n    \"Qwen3-8B-Hybrid\" matches a prefixed call \"lemonade/Qwen3-8B-Hybrid\".\"\"\"\n    try:\n        from .workspace import load_manifest\n        prefs = getattr(load_manifest(workspace_id), \"model_thinking\", {}) or {}\n    except Exception:\n        return None\n    if not prefs:\n        return None\n    model_bare = {key.split(\"/\")[-1] for key in (model, actual_model) if key}\n    for pref_key, value in prefs.items():\n        if pref_key.split(\"/\")[-1] in model_bare:\n            if value == \"off\":\n                return True\n            if value == \"on\":\n                return False\n    return None\n\n\nasync def call_model(\n    model: str,\n    messages: List[Dict[str, str]],\n    temperature: float = 0.7,\n    max_tokens: int = 2048,\n    fallbacks: Optional[List[str]] = None,\n    timeout: Optional[float] = None,\n    run_id: Optional[str] = None,\n    authorized_tools: Optional[List[str]] = None,\n    workspace_id: Optional[str] = None,\n    role: Optional[str] = None,\n) -> str:\n    \"\"\"\n    Main entry point for LLM inference.\n    Handles LiteRT (local), LiteLLM (cloud/local), and system prompt augmentation.\n    \"\"\"\n    print(f\"DEBUG: call_model(model='{model}', run_id='{run_id}')\")\n    \n    # 0. RESOLVE REGISTRY KEY (Ensures LiteLLM doesn't see 'local_lemonade')\n    actual_model = model\n    if model in MODEL_REGISTRY:\n        config = MODEL_REGISTRY[model]\n        actual_model = config.get(\"model\", model)\n        provider = config.get(\"provider\", \"\").lower()\n        if \"/\" not in actual_model and provider:\n             actual_model = f\"{provider}/{actual_model}\"\n        print(f\"DEBUG: Resolved registry key '{model}' to '{actual_model}'\")\n    \n    start_ts = datetime.datetime.now()\n    log_data = {\n        \"ts\": start_ts.isoformat(),\n        \"run_id\": run_id,\n        \"model\": model,\n        \"ok\": False\n    }\n\n    # 1. OFFLINE KILL-SWITCH (PBR-001 Phase 3)\n    if _offline_enabled() and not is_local_model(model):\n        raise OfflineRefusal(\n            f\"BENNY_OFFLINE is set; refusing to call non-local model: {model}\"\n        )\n\n    # 2. SYSTEM PROMPT AUGMENTATION\n    # Prefer an explicitly-passed workspace_id (e.g. from the synthesis engine,\n    # whose extraction prompts carry no \"workspace:\" system marker). Fall back to\n    # parsing it out of a system message for callers that embed it there.\n    if not workspace_id:\n        workspace_id = \"default\"\n        for msg in mes