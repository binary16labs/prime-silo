t: str, completion: str, duration_ms: int):\n101\t        \"\"\"Emit resource_usage to the event bus for UI tracking.\"\"\"\n102\t        if not run_id:\n103\t            return\n104\t\n105\t        usage = {\n106\t            \"prompt_tokens\": self.count_tokens(prompt),\n107\t            \"completion_tokens\": self.count_tokens(completion),\n108\t            \"total_tokens\": self.count_tokens(prompt) + self.count_tokens(completion),\n109\t        }\n110\t\n111\t        event_bus.emit(\n112\t            run_id,\n113\t            \"resource_usage\",\n114\t            {\n115\t                \"model\": self.model_id,\n116\t                \"provider\": f\"local/{self.provider_name}\",\n117\t                \"usage\": usage,\n118\t                \"duration_ms\": duration_ms,\n119\t                \"timestamp\": time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime()),\n120\t            },\n121\t        )\n122\t\n123\t\n124\tclass BaseOpenAICompatibleExecutor(BaseLocalExecutor):\n125\t    \"\"\"HTTP-based executor for OpenAI-compatible local servers.\"\"\"\n126\t\n127\t    def __init__(\n128\t        self, model_id: str, provider_name: str, base_url: str, api_key: str = \"not-needed\"\n129\t    ):\n130\t        super().__init__(model_id, provider_name)\n131\t        self.base_url = base_url.rstrip(\"/\")\n132\t        self.api_key = api_key\n133\t        # Use a longer default timeout for local models (LC-5.4)\n134\t        self.timeout = float(os.environ.get(\"BENNY_LLM_TIMEOUT\", \"900\"))\n135\t\n136\t    async def generate(\n137\t        self, prompt: Content, system: Optional[str] = None, run_id: Optional[str] = None, **kwargs\n138\t    ) -> str:\n139\t        start_ts = time.time()\n140\t        # ``prompt`` may be a plain string OR a list of OpenAI multimodal parts\n141\t        # (vision calls, VIS-001). Pass it through to ``content`` verbatim — local\n142\t        # OpenAI-compatible servers (Lemonade/FLM confirmed via OQ-1) accept list\n143\t        # content. Only the token/usage bookkeeping needs the flattened text.\n144\t        prompt_text = _as_text(prompt)\n145\t        messages = []\n146\t        if system:\n147\t            messages.append({\"role\": \"system\", \"content\": system})\n148\t        messages.append({\"role\": \"user\", \"content\": prompt})\n149\t\n150\t        async with httpx.AsyncClient(timeout=self.timeout) as client:\n151\t            payload = {\n152\t                \"model\": self.model_id,\n153\t                \"messages\": messages,\n154\t                \"temperature\": kwargs.get(\"temperature\", 0.7),\n155\t                \"max_tokens\": kwargs.get(\"max_tokens\", 4000),\n156\t                \"stream\": False,\n157\t            }\n158\t\n159\t            if \"frequency_penalty\" in kwargs:\n160\t                payload[\"frequency_penalty\"] = kwargs[\"frequency_penalty\"]\n161\t            if \"presence_penalty\" in kwargs:\n162\t                payload[\"presence_penalty\"] = kwargs[\"presence_penalty\"]\n163\t            if \"repetition_penalty\" in kwargs:\n164\t                payload[\"repetition_penalty\"] = kwargs[\"repetition_penalty\"]\n165\t            # extra_body merges provider-specific keys into the OpenAI payload —\n166\t            # used to pass chat_template_kwargs.enable_thinking for the per-model\n167\t            # thinking toggle. Unknown keys are ignored by most local servers.\n168\t            extra = kwargs.get(\"extra_body\")\n169\t            if isinstance(extra, dict):\n170\t                payload.update(extra)\n171\t\n172\t            json_payload = payload\n173\t            resp = await client.post(\n174\t                f\"{self.base_url}/chat/completions\",\n175\t                headers={\"Authorization\": f\"Bearer {self.api_key}\"},\n176\t                json=json_payload,\n177\t            )\n178\t            resp.raise_for_status()\n179\t            data = resp.json()\n180\t            # Defensive: some local servers (notably Lemonade with the FLM\n181\t            # recipe) return HTTP 200 with an error envelope instead of an\n182\t            # OpenAI ``choices`` payload — e.g. ``{\"error\": {\"details\":\n183\t            # {\"response\": {\"error\": {\"message\": \"Max length reached!\"}}}}}``.\n184\t            # Surface that upstream message instead of leaking ``KeyError:\n185\t            # 'choices'`` to the caller.\n186\t            if \"choices\" not in data:\n187\t                upstream = \"\"\n188\t                err = data.get(\"error\") if isinstance(data, dict) else None\n189\t                if isinstance(err, dict):\n190\t                    inner = (\n191\t                        err.get(\"details\", {}).get(\"response\", {}).get(\"error\", {})\n192\t                        if isinstance(err.get(\"details\"), dict)\n193\t                        else {}\n194\t                    )\n195\t                    upstream = (\n196\t                        (inner.get(\"message\") if isinstance(inner, dict) else None)\n\n... [160 lines truncated] ..."},"type":"attachment","uuid":"13a77c7c-279a-4182-a0e8-151b2e15f55a","timestamp":"2026-06-28T21:29:37.246Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"8a533f4f-52c1-4883-9f06-3b7e51d615ce","version":"2.1.187","gitBranch":"HEAD"}
