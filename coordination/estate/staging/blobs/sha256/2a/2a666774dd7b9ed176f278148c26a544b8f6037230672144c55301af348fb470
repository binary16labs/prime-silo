\"md\",\n    \"spec\":     \"Counts of visual elements detected, classified by type, surrogates generated, validation pass/fail (+ caption fallbacks), enriched docs produced, and figure-derived triples + Sections written.\"\n  },\n\n  \"config\": {\n    \"model\":           \"${synthesis_model}\",\n    \"vlm_model\":       \"${vlm_model}\",\n    \"max_concurrency\": 2,\n    \"max_depth\":       3,\n    \"skills_allowed\":  [\"extract_docmodel\", \"classify_elements\", \"describe_visuals\", \"validate_surrogates\", \"stitch_enriched\", \"rag_ingest\", \"validate_vision\"]\n  },\n\n  \"execution\": {\n    \"run_folder_template\":   \"${benny_home}/workspace/${workspace}/runs/vision-${run_id}\",\n    \"wave_isolation\":        true,\n    \"stop_on_first_failure\": true,\n\n    \"api\": {\n      \"base\":         \"${api_base}\",\n      \"auth_header\":  \"X-Benny-API-Key\",\n      \"auth_value\":   \"${api_key}\",\n      \"content_type\": \"application/json\"\n    },\n\n    \"preflight\": {\n      \"method\":       \"GET\",\n      \"path\":         \"/api/system/pulse\",\n      \"timeout_s\":    5,\n      \"on_fail_hint\": \"Start the server first: benny up --home $BENNY_HOME\"\n    },\n\n    \"resume\": {\n      \"enabled\":         true,\n      \"strategy\":        \"prior_run_folder\",\n      \"from_run_id\":     \"${resume_from_run_id}\",\n      \"scan_glob\":       \"task_*.json\",\n      \"skip_if_status\":  [\"done\", \"completed\", \"completed_after_timeout\", \"reused\", \"cached\"],\n      \"always_rerun\":    [\"generate_report\"],\n      \"rehydrate_emits\": true\n    },\n\n    \"governance\": {\n      \"lineage_enabled\":  true,\n      \"lineage_endpoint\": \"http://localhost:3010\",\n      \"gdpr_record\":      true,\n      \"audit_events\":     true,\n      \"sha256_seal\":      true\n    }\n  },\n\n  \"plan\": {\n    \"tasks\": [\n      {\n        \"id\": \"docmodel_extract\",\n        \"description\": \"[DETERMINISTIC] [NEW — VIS-001 Phase 0] Parse each ingestible doc into Docling's element tree (type/page/bbox/reading-order). Export tables to JSON, persist a crop per picture keyed by content-hash, and write workspace/.benny/docmodel/<source>.json. No VLM.\",\n        \"skill_hint\": \"extract_docmodel\",\n        \"wave\": 0,\n        \"complexity\": \"medium\",\n        \"node_type\": \"task\",\n        \"files_touched\": [\"${staging_dir}/\", \"${data_in_dir}/\", \"${docmodel_dir}/\"],\n        \"execution\": {\n          \"kind\": \"blocking_with_task_fallback\",\n          \"generate_run_id_as\": \"task_run_id\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"path\":   \"/api/vision/docmodel\",\n            \"body\": {\n              \"workspace\": \"${workspace}\",\n              \"run_id\":    \"${task_run_id}\",\n              \"emit_crops\": true\n            },\n            \"timeout\": { \"connect\": 10, \"read\": 1200, \"write\": 120, \"pool\": 10 }\n          },\n          \"fallback_on_timeout\": {\n            \"method\":  \"GET\",\n            \"path\":    \"/api/tasks/tasks/${task_run_id}\",\n            \"timeout_s\": 10,\n            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n            \"success_result\": { \"status\": \"completed_after_timeout\", \"docmodels\": \"$.total_steps\", \"task_id\": \"${task_run_id}\" }\n          },\n          \"emits\": { \"visual_elements\": \"$.visual_elements\", \"docmodel_paths\": \"$.docmodels\" }\n        }\n      },\n\n      {\n        \"id\": \"classify_elements\",\n        \"description\": \"[DETERMINISTIC] [NEW — VIS-001 Phase 2] Classify each visual element into a treatment type (illustration | diagram | chart | table | formula) using the Docling picture classifier and/or a cheap VLM routing prompt above ${classify_threshold}. Tables/formulas bypass the VLM describer.\",\n        \"skill_hint\": \"classify_elements\",\n        \"dependencies\": [\"docmodel_extract\"],\n        \"wave\": 1,\n        \"complexity\": \"low\",\n        \"node_type\": \"task\",\n        \"inputs_from\": {\n          \"visual_elements\": { \"source_task\": \"docmodel_extract\", \"emits_key\": \"visual_elements\" }\n        },\n        \"execution\": {\n          \"kind\": \"blocking\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"path\":   \"/api/vision/classify\",\n            \"body\": {\n              \"workspace\": \"${workspace}\",\n              \"threshold\": \"${classify_threshold}\",\n              \"elements\":  \"${inputs.visual_elements}\"\n            },\n            \"timeout\": { \"connect\": 10, \"read\": 600, \"write\": 60, \"pool\": 10 }\n          },\n          \"emits\": { \"typed_elements\": \"$.typed_elements\" }\n        }\n      },\n\n      {\n        \"id\": \"describe_visuals\",\n        \"description\": \"[AGENTIC/VISION] [NEW — VIS-001 Phase 1+2] Run the type-routed describer ladder via the multimodal call_model path: illustration→caption, diagram→${diagram_format} (Mermaid/PlantUML), chart→data-series JSON + description. Content-hash cached — unchanged crops are reused, never re-described.\",\n        \"skill_hint\": \"describe_visuals\",\n        \"assigned_model\": \"${vlm_model}\",\n        \"dependencies\": [\"classify_elements\"],\n        \"wave\": 2,\n        \"complexity\": \"high\",\n        \"node_type\": \"task\",\n        \"inputs_from\": {\n          \"typed_elements\": { \"source_task\": \"classify_elements\", \"emits_key\": \"typed_elements\" }\n        },\n        \"execution\": {\n          \"kind\": \"blocking_with_task_list_fallback\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"path\":   \"/api/vision/describe\",\n            \"body\": {\n              \"workspace\":      \"${workspace}\",\n              \"vlm_model\":      \"${vlm_model}\",\n              \"diagram_format\": \"${diagram_format}\",\n              \"elements\":       \"${inputs.typed_elements}\"\n            },\n            \"timeout\": { \"connect\": 10, \"read\": 2400, \"write\": 60, \"pool\": 10 }\n          },\n          \"fallback_on_timeout\": {\n            \"method\":              \"GET\",\n            \"path\":                \"/api/tasks\",\n            \"params\":              { \"workspace\": \"${workspace}\" },\n            \"timeout_s\":           10,\n            \"filter_type\":         \"vision\",\n            \"sort_by\":             \"updated_at\",\n            \"order\":               \"desc\",\n            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n            \"success_result\":      { \"status\": \"completed_after_timeout\", \"task_id\": \"$.task_id\", \"message\": \"$.message\" }\n          },\n          \"emits\": { \"surrogates\": \"$.surrogates\" }\n        }\n      },\n\n      {\n        \"id\": \"validate_surrogates\",\n        \"description\": \"[DETERMINISTIC] [NEW — VIS-001 Phase 2] Gate every surrogate: Mermaid/PlantUML must pass a headless parse; chart/table JSON must validate against schema. A surrogate that fails degrades to a plain caption — it is NEVER reported as success (no hollow success).\",\n        \"skill_hint\": \"validate_surrogates\",\n        \"dependencies\": [\"describe_visuals\"],\n        \"wave\": 3,\n        \"complexity\": \"low\",\n        \"node_type\": \"task\",\n        \"inputs_from\": {\n          \"surrogates\": { \"source_task\": \"describe_visuals\", \"emits_key\": \"surrogates\" }\n        },\n        \"execution\": {\n          \"kind\": \"validate\",\n          \"request\": {\n            \"method\":    \"POST\",\n            \"path\":      \"/api/vision/validate\",\n            \"body\":      { \"workspace\": \"${workspace}\", \"surrogates\": \"${inputs.surrogates}\", \"diagram_format\": \"${diagram_format}\" },\n            \"timeout_s\": 300\n          },\n          \"assertion\": {\n            \"select\":        \"$.surrogates[?(@.validated == true)]\",\n            \"require_count\": \">= 1\",\n            \"fail_message\":  \"No surrogate passed validation. Check describe_visuals output and the ${diagram_format} parser; everything fell back to captions.\"\n          },\n          \"emit_on_success\": { \"validated_surrogates\": \"$.surrogates\", \"validated_count\": \"$.surrogates[?(@.validated == true)] | length\", \"caption_fallbacks\": \"$.fallback_count\" }\n        }\n      },\n\n      {\n        \"id\": \"stitch_enriched\",\n        \"description\": \"[DETERMINISTIC] [NEW — VIS-001 Phase 3] Replace each visual element with its validated surrogate at the element's original reading-order position and write enriched markdown into ${data_in_dir}/ (overwriting the visually-blind version). Each surrogate keeps node_id/page/bbox/crop provenance for downstream Section anchoring.\",\n        \"skill_hint\": \"stitch_enriched\",\n        \"dependencies\": [\"validate_surrogates\"],\n        \"wave\": 4,\n        \"complexity\": \"medium\",\n        \"node_type\": \"task\",\n        \"files_touched\": [\"${data_in_dir}/\"],\n        \"inputs_from\": {\n          \"validated_surrogates\": { \"source_task\": \"validate_surrogates\", \"emits_key\": \"validated_surrogates\" }\n        },\n        \"execution\": {\n          \"kind\": \"blocking\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"path\":   \"/api/vision/stitch\",\n            \"body\":   { \"workspace\": \"${workspace}\", \"surrogates\": \"${inputs.validated_surrogates}\", \"target_dir\": \"${data_in_dir}\" },\n            \"timeout\": { \"connect\": 10, \"read\": 600, \"write\": 120, \"pool\": 10 }\n          },\n          \"emits\": { \"enriched_docs\": \"$.enriched_docs\" }\n        }\n      },\n\n      {\n        \"id\": \"rag_ingest\",\n        \"description\": \"[DETERMINISTIC] [EXISTING] Chunk and embed the ENRICHED docs into ChromaDB. Unchanged from knowledge_enrichment_pipeline — it now sees figure surrogates and table JSON inline, not a visually-blind doc.\",\n        \"skill_hint\": \"rag_ingest\",\n        \"dependencies\": [\"stitch_enriched\"],\n        \"wave\": 5,\n        \"complexity\": \"medium\",\n        \"node_type\": \"task\",\n        \"inputs_from\": {\n          \"enriched_docs\": { \"source_task\": \"stitch_enriched\", \"emits_key\": \"enriched_docs\" }\n        },\n        \"execution\": {\n          \"kind\": \"blocking_with_task_fallback\",\n          \"generate_run_id_as\": \"task_run_id\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"path\":   \"/api/rag/ingest\",\n            \"body\": {\n              \"workspace\":      \"${workspace}\",\n              \"deep_synthesis\": false,\n              \"run_id\":         \"${task_run_id}\",\n              \"files\":          \"${inputs.enriched_docs}\"\n            },\n            \"timeout\": { \"connect\": 10, \"read\": 1800, \"write\": 120, \"pool\": 10 }\n          },\n          \"fallback_on_timeout\": {\n            \"method\":  \"GET\",\n            \"path\":    \"/api/tasks/tasks/${task_run_id}\",\n            \"timeout_s\": 10,\n            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n            \"success_result\": { \"status\": \"completed_after_timeout\", \"rag_chunks\": \"$.total_steps\", \"task_id\": \"${task_run_id}\" }\n          }\n        }\n      },\n\n      {\n        \"id\": \"deep_synthesis\",\n        \"description\": \"[AGENTIC] [EXISTING] Build the PageIndex tree over the enriched corpus and fan triple extraction over its Section leaves (ADR-002). Figure-derived triples now exist and inherit Section + page provenance.\",\n        \"skill_hint\": \"rag_ingest\",\n        \"assigned_model\": \"${synthesis_model}\",\n        \"dependencies\": [\"rag_ingest\"],\n        \"wave\": 6,\n        \"complexity\": \"high\",\n        \"node_type\": \"task\",\n        \"execution\": {\n          \"kind\": \"blocking_with_task_list_fallback\",\n          \"request\": {\n            \"method\": \"POST\",\n            \"path\":   \"/api/graph/synthesize\",\n            \"body\":   { \"workspace\": \"${workspace}\", \"model\": \"${synthesis_model}\" },\n            \"timeout\": { \"connect\": 10, \"read\": 1800, \"write\": 60, \"pool\": 10 }\n          },\n          \"fallback_on_timeout\": {\n            \"method\":              \"GET\",\n            \"path\":                \"/api/tasks\",\n            \"params\":              { \"workspace\": \"${workspace}\" },\n            \"timeout_s\":           10,\n            \"filter_type\":         \"synthesis\",\n            \"sort_by\":             \"updated_at\",\n            \"order\":               \"desc\",\n            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n            \"success_result\":      { \"status\": \"completed_after_timeout\", \"task_id\": \"$.task_id\", \"message\": \"$.message\" }\n          }\n        }\n      },\n\n      {\n        \"id\": \"validate_vision\",\n        \"description\": \"[DETERMINISTIC] [NEW — VIS-001 Phase 3] Prove the figures made it into the graph: query for triples/Sections whose source element type is a figure/diagram/chart/table. Fail if zero figure-derived facts exist.\",\n        \"skill_hint\": \"validate_vision\",\n        \"dependencies\": [\"deep_synthesis\"],\n        \"wave\": 7,\n        \"complexity\": \"low\",\n        \"node_type\": \"task\",\n        \"execution\": {\n          \"kind\": \"validate\",\n          \"request\": {\n            \"method\":    \"GET\",\n            \"path\":      \"/api/graph/stats\",\n            \"params\":    { \"workspace\": \"${workspace}\", \"include_element_types\": true },\n            \"timeout_s\": 30\n          },\n          \"assertion\": {\n            \"select\":        \"$.sections[?(@.source_element_type in ['picture','diagram','chart','table'])]\",\n            \"require_count\": \">= 1\",\n            \"fail_message\":  \"Zero figure-derived Sections in '${workspace}'. The vision stages produced no graph content — check stitch_enriched wrote enriched docs and deep_synthesis ran over them.\"\n          },\n          \"emit_on_success\": { \"figure_sections\": \"$ | length\" }\n        }\n      },\n\n      {\n        \"id\": \"generate_report\",\n        \"description\": \"[AGENTIC] [EXISTING-style] Write vision_ingestion_report.md: elements detected/classified, surrogates by type, validation pass-rate + caption fallbacks, enriched docs, and figure-derived triples/Sections.\",\n        \"skill_hint\": \"rag_ingest\",\n        \"assigned_model\": \"${synthesis_model}\",\n        \"dependencies\": [\"validate_vision\"],\n        \"wave\": 7,\n        \"complexity\": \"medium\",\n        \"node_type\": \"output\",\n        \"files_touched\": [\"${data_out_dir}/vision_ingestion_report.md\"],\n        \"execution\": {\n          \"kind\": \"report\",\n          \"stats_request\": {\n            \"method\":    \"GET\",\n            \"path\":      \"/api/graph/stats\",\n            \"params\":    { \"workspace\": \"${workspace}\" },\n            \"timeout_s\": 30\n          },\n          \"output\": {\n            \"path\":        \"${outputs.base_dir}/vision_ingestion_report.md\",\n            \"format\":      \"md\",\n            \"template_id\": \"vision_ingestion_report_default\"\n          }\n        }\n      }\n    ],\n\n    \"edges\": [\n      { \"id\": \"e_doc_classify\",  \"source\": \"docmodel_extract\",    \"target\": \"classify_elements\",   \"label\": \"visual elements\",      \"animated\": true },\n      { \"id\": \"e_classify_desc\", \"source\": \"classify_elements\",   \"target\": \"describe_visuals\",    \"label\": \"typed elements\",       \"animated\": true },\n      { \"id\": \"e_desc_val\",      \"source\": \"describe_visuals\",    \"target\": \"validate_surrogates\", \"label\": \"surrogates\",           \"animated\": true },\n      { \"id\": \"e_val_stitch\",    \"source\": \"validate_surrogates\", \"target\": \"stitch_enriched\",     \"label\": \"validated surrogates\", \"animated\": true },\n      { \"id\": \"e_stitch_rag\",    \"source\": \"stitch_enriched\",     \"target\": \"rag_ingest\",          \"label\": \"enriched docs\",        \"animated\": true },\n      { \"id\": \"e_rag_synth\",     \"source\": \"rag_ingest\",          \"target\": \"deep_synthesis\",      \"label\": \"indexed corpus\",       \"animated\": true },\n      { \"id\": \"e_synth_val\",     \"source\": \"deep_synthesis\",      \"target\": \"validate_vision\",     \"label\": \"figure triples\",       \"animated\": true },\n      { \"id\": \"e_val_report\",    \"source\": \"validate_vision\",     \"target\": \"generate_report\",     \"label\": \"validated\",            \"animated\": true }\n    ],\n\n    \"waves\": [\n      [\"docmodel_extract\"],\n      [\"classify_elements\"],\n      [\"describe_visuals\"],\n      [\"validate_surrogates\"],\n      [\"stitch_enriched\"],\n      [\"rag_ingest\"],\n      [\"deep_synthesis\"],\n      [\"validate_vision\", \"generate_report\"]\n    ],\n\n    \"ascii_dag\": \"docmodel_extract → classify_elements → describe_visuals[VLM] → validate_surrogates → stitch_enriched ┐\\n                                                                                                  │\\n  ┌──────────────────────────────────────────────────────────────────┘\\n  └→ rag_ingest → deep_synthesis → validate_vision → generate_report\"\n  },\n\n  \"tags\": [\"vision\", \"ingestion\", \"multimodal\", \"knowledge-graph\", \"template\", \"vis-001\"],\n\n  \"metadata\": {\n    \"template\":     true,\n    \"generated_by\": \"ADR-003 / VIS-001\",\n    \"related\":      [\"architecture/ADR-003-vision-augmented-ingestion.md\", \"docs/requirements/13/project_plan.md\"],\n    \"notes\": \"DESIGN-TIME CONTRACT. The /api/vision/* endpoints + extract_docmodel/classify_elements/describe_visuals/validate_surrogates/stitch_enriched/validate_vision skills are VIS-001 deliverables (Phases 0–3); rag_ingest + deep_synthesis reuse the existing knowledge_enrichment pipeline. Inspect with: benny enrich --manifest manifests/templates/vision_ingestion_pipeline.json (dry) ; run a single wave once its skills land. Set vlm_model=${vlm_fallback} if OQ-1 shows FLM lacks image_url support.\"\n  }\n}\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"9e302e1a-81a7-4821-aa96-31984ee633ab","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"8a533f4f-52c1-4883-9f06-3b7e51d615ce","version":"2.1.187","gitBranch":"HEAD"}
