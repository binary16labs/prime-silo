     \"model\": \"google/gemma-3-27b-it\",\n138\t        \"cost_per_1k\": 0.0002,\n139\t        \"use_for\": [\"general\", \"cloud\", \"nvidia\"],\n140\t    },\n141\t    # AOS-001 OQ-1 (2026-04-26): default model for all AOS personas.\n142\t    # Exact Lemonade model name confirmed at Phase 0 wire-up — adjust the\n143\t    # \"model\" string below if the Lemonade catalogue uses a different slug.\n144\t    # Fallback: alias resolves to \"local_lemonade\" if qwen3_5_9b is absent.\n145\t    \"qwen3_5_9b\": {\n146\t        \"model\": \"openai/Qwen3-8B-Instruct-FLM\",\n147\t        \"provider\": \"lemonade\",\n148\t        \"cost_per_1k\": 0.0,\n149\t        \"use_for\": [\"sdlc\", \"offline\", \"planner\", \"architect\", \"aos_default\"],\n150\t    },\n151\t    # VIS-001 / ADR-003: local vision-language model for the `vision` role\n152\t    # (figure/diagram/chart/table description). OQ-1 (2026-06-28) confirmed\n153\t    # qwen3vl-it-4b-FLM on Lemonade accepts OpenAI `image_url` content and truly\n154\t    # sees images. Workspaces route a role here via manifest model_roles[\"vision\"].\n155\t    \"qwen3vl\": {\n156\t        \"model\": \"qwen3vl-it-4b-FLM\",\n157\t        \"provider\": \"lemonade\",\n158\t        \"cost_per_1k\": 0.0,\n159\t        \"use_for\": [\"vision\", \"offline\", \"image\", \"diagram\", \"chart\", \"ocr\"],\n160\t    },\n161\t}\n162\t\n163\t\n164\t# =============================================================================\n165\t# PORTABILITY / OFFLINE HARDENING (PBR-001 Phase 3)\n166\t# =============================================================================\n167\t\n168\t# Prefixes that identify a model string as pointing at a local provider.\n169\t# ``litert`` is the only one that doesn't carry a live process — it's an\n170\t# on-device inference engine — but it is still \"local\" for the purposes of\n171\t# offline/local-only policy.\n172\t_LOCAL_PREFIXES: tuple[str, ...] = tuple(f\"{name}/\" for name in LOCAL_PROVIDERS.keys())\n173\t\n174\t\n175\tdef is_local_model(model_name: str) -> bool:\n176\t    \"\"\"Return True if ``model_name`` is served by a local provider.\"\"\"\n177\t    if model_name.startswith(_LOCAL_PREFIXES) or model_name.startswith(\"litert/\"):\n178\t        return True\n179\t\n180\t    # nvidia/ prefix is always a remote cloud provider\n181\t    if model_name.startswith(\"nvidia/\"):\n182\t        return False\n183\t\n184\t    # Check if it's a registry key pointing to a local provider\n185\t    if model_name in MODEL_REGISTRY:\n186\t        provider = MODEL_REGISTRY[model_name].get(\"provider\", \"\").lower()\n187\t        return provider in LOCAL_PROVIDERS or provider == \"litert\"\n188\t\n189\t    return False\n190\t\n191\t\n192\tdef _offline_enabled() -> bool:\n193\t    \"\"\"Return True if the BENNY_OFFLINE kill-switch is active.\"\"\"\n194\t    return os.environ.get(\"BENNY_OFFLINE\", \"\").lower() in (\"1\", \"true\", \"yes\")\n195\t\n196\t\n197\tclass OfflineRefusal(Exception):\n198\t    \"\"\"Raised when a non-local model is requested while offline mode is active.\"\"\"\n199\t\n200\t\n201\t# =============================================================================\n202\t# MODEL RESOLUTION\n\n... [578 lines truncated] ..."},"type":"attachment","uuid":"b724227f-318c-416e-beaa-380a1e6ae232","timestamp":"2026-06-28T21:29:37.246Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"8a533f4f-52c1-4883-9f06-3b7e51d615ce","version":"2.1.187","gitBranch":"HEAD"}
{"parentUuid":"b724227f-318c-416e-beaa-380a1e6ae232","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\local_executor.py","snippet":"1\t\"\"\"\n2\tLocal LLM Executor (LC-1..4) - Direct, short-circuit inference for local models.\n3\t\"\"\"\n4\t\n5\tfrom __future__ import annotations\n6\t\n7\timport json\n8\timport logging\n9\timport os\n10\timport time\n11\tfrom typing import Any, AsyncIterator, Dict, List, Optional, Protocol, Union\n12\t\n13\timport httpx\n14\timport tiktoken\n15\t\n16\tfrom .event_bus import event_bus\n17\tfrom .litert_engine import LiteRTEngine\n18\t\n19\tlogger = logging.getLogger(__name__)\n20\t\n21\t# A chat \"content\" is either a plain string or a list of OpenAI multimodal parts\n22\t# (``{\"type\": \"text\", ...}`` / ``{\"type\": \"image_url\", ...}``). Vision calls\n23\t# (VIS-001 / ADR-003) send the list form; everything else stays a string.\n24\tContent = Union[str, List[Dict[str, Any]]]\n25\t\n26\t\n27\tdef _as_text(content: Content) -> str:\n28\t    \"\"\"Flatten chat content to plain text for token counting / usage logging.\n29\t\n30\t    For multimodal list content this keeps only the ``text`` parts — image parts\n31\t    have no token-countable text here. A plain string passes straight through.\n32\t    \"\"\"\n33\t    if isinstance(content, list):\n34\t        return \"\\n\".join(\n35\t            p.get(\"text\", \"\") for p in content if isinstance(p, dict) and p.get(\"type\") == \"text\"\n36\t        )\n37\t    return content or \"\"\n38\t\n39\t\n40\tdef _is_multimodal(content: Content) -> bool:\n41\t    \"\"\"True if content is the list form carrying at least one image part.\"\"\"\n42\t    return isinstance(content, list) and any(\n43\t        isinstance(p, dict) and p.get(\"type\") == \"image_url\" for p in content\n44\t    )\n45\t\n46\t\n47\t# =============================================================================\n48\t# PROTOCOL