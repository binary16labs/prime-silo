{"parentUuid":"94bb5afe-1a7a-417c-846f-f52800afcf30","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\vision_describe.py","snippet":"1\t\"\"\"\n2\tVision describer ladder + multi-model review loop (VIS-001 / ADR-003 Phase 2).\n3\t\n4\tTurns a DocModel visual element (a crop + its caption/context from Phase 0) into a\n5\tvalidated textual **surrogate**, using more than one model so the result is\n6\tgreater than any single pass:\n7\t\n8\t  1. classify   — illustration | diagram | chart (label + caption heuristics)\n9\t  2. describe    — qwen3vl (vision) produces the surrogate from the crop, grounded\n10\t                   by the caption + surrounding text\n11\t  3. validate    — programmatic check (Mermaid parses / JSON valid) — no hollow success\n12\t  4. review      — qwen3-9b (text) cross-checks the surrogate against the document's\n13\t                   OWN text, scores it, flags missing/hallucinated parts, proposes a fix\n14\t  5. refine      — vision model regenerates given the critique (bounded iterations)\n15\t  6. best wins   — highest-scoring VALID surrogate, else a plain caption fallback\n16\t\n17\tAll model calls go through ``call_model`` (ADR-001 / VIS-SEC3). The vision and\n18\treviewer models are parameters so the workflow is reusable across documents.\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\timport logging\n24\timport os\n25\timport re\n26\timport shutil\n27\timport subprocess\n28\timport tempfile\n29\tfrom pathlib import Path\n30\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n31\t\n32\tfrom .models import call_model\n33\tfrom .vision import vision_message\n34\t\n35\tlogger = logging.getLogger(__name__)\n36\t\n37\tDEFAULT_VLM = \"lemonade/qwen3vl-it-4b-FLM\"\n38\tDEFAULT_REVIEWER = \"lemonade/qwen3.5-9b-FLM\"\n39\t\n40\t# DocItemLabel values that are decorative vs. technical. docling already emits a\n41\t# distinct ``chart`` label; everything else under ``picture`` we sub-classify.\n42\t_DIAGRAM_HINTS = (\n43\t    \"figure\",\n44\t    \"diagram\",\n45\t    \"architecture\",\n46\t    \"cycle\",\n47\t    \"framework\",\n48\t    \"model\",\n49\t    \"flow\",\n50\t    \"process\",\n51\t    \"metamodel\",\n52\t    \"structure\",\n53\t    \"relationship\",\n54\t    \"overview\",\n55\t)\n56\t_CHART_HINTS = (\"chart\", \"graph\", \"plot\", \"trend\", \"distribution\", \"histogram\", \"bar \", \"pie\")\n57\t\n58\t\n59\t# =============================================================================\n60\t# CLASSIFICATION\n61\t# =============================================================================\n62\t\n63\t\n64\tdef classify_visual(label: str, caption: str = \"\") -> str:\n65\t    \"\"\"Decide the treatment type for a visual element.\n66\t\n67\t    ``chart`` (docling label) → chart. Otherwise use caption keywords to tell a\n68\t    technical *diagram* from a decorative *illustration*; default to diagram in a\n69\t    technical document since that is the high-value case.\n70\t    \"\"\"\n71\t    cap = (caption or \"\").lower()\n72\t    if label == \"chart\" or any(h in cap for h in _CHART_HINTS):\n73\t        return \"chart\"\n74\t    if any(h in cap for h in _DIAGRAM_HINTS):\n75\t        return \"diagram\"\n76\t    # A captioned \"Figure N\" in a standards doc is almost always a diagram.\n77\t    if re.search(r\"\\bfig(?:ure)?\\b\", cap):\n78\t        return \"diagram\"\n79\t    return \"illustration\"\n80\t\n81\t\n82\t# =============================================================================\n83\t# MERMAID EXTRACTION + VALIDATION (programmatic \"test the outcome\")\n84\t# =============================================================================\n85\t\n86\t_MERMAID_HEADERS = (\n87\t    \"flowchart\",\n88\t    \"graph\",\n89\t    \"sequencediagram\",\n90\t    \"classdiagram\",\n91\t    \"statediagram\",\n92\t    \"erdiagram\",\n93\t    \"journey\",\n94\t    \"gantt\",\n95\t    \"mindmap\",\n96\t    \"timeline\",\n97\t    \"C4Context\",\n98\t)\n99\t\n100\t\n101\tdef extract_code(text: str, lang: str = \"mermaid\") -> str:\n102\t    \"\"\"Pull a fenced ``code block (any of ```mermaid / ``` / ```json) or, failing\n103\t    that, return the stripped text. Drops <think> blocks local models emit, and —\n104\t    for Mermaid — strips the invalid ``#`` comments/notes local models like to add\n105\t    (Mermaid comments are ``%%``, and a stray ``# Note:`` line hard-fails mmdc).\"\"\"\n106\t    if not text:\n107\t        return \"\"\n108\t    text = re.sub(r\"<think>.*?</think>\", \"\", text, flags=re.DOTALL | re.IGNORECASE).strip()\n109\t    m = re.search(rf\"```{lang}\\s*\\n?(.*?)```\", text, re.DOTALL | re.IGNORECASE)\n110\t    if not m:\n111\t        m = re.search(r\"```\\s*\\n?(.*?)```\", text, re.DOTALL)\n112\t    code = (m.group(1) if m else text).strip()\n113\t    if lang == \"mermaid\":\n114\t        code = _sanitize_mermaid(code)\n115\t    return code\n116\t\n117\t\n118\tdef _sanitize_mermaid(code: str) -> str:\n119\t    \"\"\"Remove Mermaid-invalid ``#`` comment lines and trailing `` # ...`` inline\n120\t    notes (the ``\\\\s#\\\\s`` form won't touch a real ``A[C#]`` label).\"\"\"\n121\t    out = []\n122\t    for line in code.splitlines():\n123\t        if line.lstrip().startswith(\"#\"):\n124\t            continue\n125\t        line = re.sub(r\"\\s+#\\s.*$\", \"\", line)  # strip \" # note\" tails\n126\t        if line.strip():\n127\t            out.append(line)\n128\t    return \"\\n\".join(out).strip()\n129\t\n130\t\n131\tdef validate_mermaid(code: str) -> Tuple[bool, str]:\n132\t    \"\"\"Permissive structural PRE-FILTER for Mermaid source — the authoritative gate\n133\t    is ``render_validate_mermaid`` (mmdc). Calibrated against the real renderer: it\n134\t    only rejects what definitely will not render (no/empty header, no edges,\n135\t    unbalanced subgraph/end, prose instead of code). It deliberately does NOT\n136\t    reject things mmdc actually accepts (dotted ids, `A --|x|--> B` labels); those\n137\t    are quality concerns handled by the prompt + reviewer, not validity. Returns\n138\t    (ok, reason).\"\"\"\n139\t    if not code or not code.strip():\n140\t        return False, \"empty\"\n141\t    lines = [l.rstrip() for l in code.strip().splitlines() if l.strip()]\n142\t    header = lines[0].strip().lower()\n143\t    if not header.startswith(tuple(h.lower() for h in _MERMAID_HEADERS)):\n144\t        return False, f\"no valid diagram header (got: {lines[0][:40]!r})\"\n145\t    body = \"\\n\".join(lines[1:])\n146\t    # balanced subgraph/end\n147\t    n_sub = len(re.findall(r\"^\\s*subgraph\\b\", body, re.MULTILINE))\n148\t    n_end = len(re.findall(r\"^\\s*end\\b\", body, re.MULTILINE))\n149\t    if n_sub != n_end:\n150\t        return False, f\"unbalanced subgraph/end ({n_sub} vs {n_end})\"\n151\t    # a flowchart/graph must have at least one edge/connection\n152\t    if header.startswith((\"flowchart\", \"graph\")):\n153\t        if not re.search(r\"--|==|-\\.|-->|---\", body):\n154\t            return False, \"no edges/connections found\"\n155\t    # crude prose detector: a non-comment line that reads like a sentence\n156\t    for l in lines[1:]:\n157\t        s = l.strip()\n158\t        if s.startswith(\"%%\"):\n159\t            continue\n160\t        if s.endswith(\".\") and \" \" in s and not re.search(r\"[\\[\\]{}()|>\\-=]\", s):\n161\t            return False, f\"prose leaked into diagram: {s[:40]!r}\"\n162\t    return True, \"ok\"\n163\t\n164\t\n165\tdef _find_mmdc_cli() -> Optional[str]:\n166\t    \"\"\"Locate the mermaid-cli entry (``cli.js``). Env ``BENNY_MMDC_CLI`` wins;\n167\t    otherwise probe the packaging install. Returns None when unavailable (render\n168\t    validation is an optional dev/build-time gate, not shipped in the runtime).\"\"\"\n169\t    env = os.environ.get(\"BENNY_MMDC_CLI\")\n170\t    if env and Path(env).exists():\n171\t        return env\n172\t    here = Path(__file__).resolve()\n173\t    for parent in here.parents:\n174\t        cand = (\n175\t            parent / \"packaging\" / \"node_modules\" / \"@mermaid-js\" / \"mermaid-cli\" / \"src\" / \"cli.js\"\n176\t        )\n177\t        if cand.exists():\n178\t            return str(cand)\n179\t    return None\n180\t\n181\t\n182\tdef render_validate_mermaid(\n183\t    code: str, *, out_png: Optional[str] = None, timeout: int = 120\n184\t) -> Tuple[bool, str, Optional[str]]:\n185\t    \"\"\"Authoritative 'does it render' check: run mermaid-cli (mmdc) to render the\n186\t    diagram to PNG. Returns (ok, reason, png_path|None). Falls back to (None-ish)\n187\t    when node/mmdc are absent so callers can degrade to structural validation.\"\"\"\n188\t    node = shutil.which(\"node\")\n189\t    cli = _find_mmdc_cli()\n190\t    if not node or not cli:\n191\t        return False, \"mmdc-unavailable\", None\n192\t    tmpdir = Path(tempfile.mkdtemp(prefix=\"mmdc-\"))\n193\t    mmd = tmpdir / \"d.mmd\"\n\n... [294 lines truncated] ..."},"type":"attachment","uuid":"9d06ee57-d55e-4607-91c3-a4fa9cb1d05c","timestamp":"2026-06-28T21:24:18.120Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"8a533f4f-52c1-4883-9f06-3b7e51d615ce","version":"2.1.187","gitBranch":"HEAD"}
{"parentUuid":"9d06ee57-d55e-4607-91c3-a4fa9cb1d05c","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\core\\vision_pipeline.py","snippet":"1\t\"\"\"\n2\tVision pipeline orchestrator (VIS-001 / ADR-003 Phase 3).\n3\t\n4\tTies the pieces into the reusable, multimodal document-parsing workflow:\n5\t\n6\t    DocModel (Phase 0)  →  describe each visual via the multi-model ladder (Phase 2)\n7\t                        →  stitch surrogates back IN READING ORDER\n8\t                        →  enriched markdown + JSON sidecar (graph-ready, provenance-kept)\n9\t\n10\tThis is the \"greater than the sum of the parts\" step: Docling supplies deterministic\n11\tstructure, qwen3vl reads the figures, the qwen3-9b reviewer + validator keep them\n12\thonest, and the result is a single document where every figure is a Mermaid diagram,\n13\tevery table is JSON, and every surrogate cites its page/bbox/source figure — feeding\n14\tthe existing PageIndex/triple pipeline unchanged.\n15\t\"\"\"\n16\t\n17\tfrom __future__ import annotations\n18\t\n19\timport json\n20\timport logging\n21\tfrom pathlib import Path\n22\tfrom typing import Any, Callable, Dict, List, Optional\n23\t\n24\tfrom .docmodel import _safe_stem\n25\tfrom .vision_describe import (\n26\t    DEFAULT_REVIEWER,\n27\t    DEFAULT_VLM,\n28\t    _table_json_to_markdown,\n29\t    classify_visual,\n30\t    describe_element,\n31\t)\n32\tfrom .workspace import get_workspace_path\n33\t\n34\tlogger = logging.getLogger(__name__)\n35\t\n36\tVISUAL_TYPES = {\"picture\", \"chart\"}\n37\t\n38\t\n39\t# =============================================================================\n40\t# CONTEXT GATHERING (caption + neighbours — the grounding the VLM needs)\n41\t# =============================================================================\n42\t\n43\t\n44\tdef _caption_for(by_order: Dict[int, dict], order: int) -> str:\n45\t    for o in (order + 1, order - 1, order + 2):\n46\t        e = by_order.get(o)\n47\t        if e and e.get(\"type\") == \"caption\" and e.get(\"text\"):\n48\t            return e[\"text\"]\n49\t    return \"\"\n50\t\n51\t\n52\tdef _context_for(by_order: Dict[int, dict], order: int, window: int = 4) -> str:\n53\t    parts: List[str] = []\n54\t    for o in range(order - window, order + window + 1):\n55\t        if o == order:\n56\t            continue\n57\t        e = by_order.get(o)\n58\t        if e and e.get(\"type\") in (\"caption\", \"section_header\", \"text\") and e.get(\"text\"):\n59\t            tag = \"CAPTION\" if e[\"type\"] == \"caption\" else e[\"type\"]\n60\t            parts.append(f\"[{tag}] {e['text'][:300]}\")\n61\t    return \"\\n\".join(parts)\n62\t\n63\t\n64\t# =============================================================================\n65\t# STITCHING — surrogate → markdown, in place\n66\t# =============================================================================\n67\t\n68\t\n69\tdef _surrogate_to_markdown(el: dict) -> str:\n70\t    \"\"\"Render one element's enriched markdown, with a provenance comment so a\n71\t    downstream node can cite the source figure/page/bbox.\"\"\"\n72\t    t = el.get(\"type\")\n73\t    sur = el.get(\"surrogate\")\n74\t    prov = f\"<!-- docmodel id={el['id']} type={t} page={el.get('page')} -->\"\n75\t\n76\t    if t == \"title\":\n77\t        return f\"# {el.get('text','').strip()}\"\n78\t    if t == \"section_header\":\n79\t        return f\"## {el.get('text','').strip()}\"\n80\t    if t == \"list_item\":\n81\t        return f\"- {el.get('text','').strip()}\"\n82\t    if t in (\"text\", \"caption\", \"footnote\", \"paragraph\"):\n83\t        return el.get(\"text\", \"\").strip()\n84\t\n85\t    if t == \"table\" and el.get(\"table\"):\n86\t        md = _table_json_to_markdown(el[\"table\"], max_rows=50)\n87\t        js = json.dumps(\n88\t            {\"columns\": el[\"table\"][\"columns\"], \"rows\": el[\"table\"][\"rows\"]}, ensure_ascii=False\n89\t        )\n90\t        return f\"{prov}\\n{md}\\n\\n```json\\n{js}\\n```\"\n91\t\n92\t    if t in VISUAL_TYPES and sur:\n93\t        kind = sur.get(\"surrogate_kind\")\n94\t        score = sur.get(\"score\")\n95\t        if kind == \"mermaid\":\n96\t            return f\"{prov[:-4]} figure_score={score} -->\\n```mermaid\\n{sur['content']}\\n```\"\n97\t        if kind == \"chart_json\":\n98\t            return f\"{prov}\\n```json\\n{sur['content']}\\n```\"\n99\t        # caption / caption_fallback\n100\t        return f\"{prov}\\n*Figure ({el.get('page')}): {sur.get('content','').strip()}*\"\n101\t\n102\t    # unhandled type with text\n103\t    return el.get(\"text\", \"\").strip()\n104\t\n105\t\n106\t# =============================================================================\n107\t# ORCHESTRATION\n108\t# =============================================================================\n109\t\n110\t\n111\tasync def enrich_docmodel(\n112\t    docmodel: Dict[str, Any],\n113\t    *,\n114\t    workspace_root: Optional[Path] = None,\n115\t    vlm_model: str = DEFAULT_VLM,\n116\t    reviewer_model: str = DEFAULT_REVIEWER,\n117\t    max_refine: int = 1,\n118\t    render_check: bool = False,\n119\t    limit: Optional[int] = None,\n120\t    run_id: Optional[str] = None,\n121\t    log_fn: Callable = print,\n122\t) -> Dict[str, Any]:\n123\t    \"\"\"Run the describer ladder over every visual element of ``docmodel`` and stitch\n124\t    an enriched document. Returns ``{markdown, elements, summary}``. Tables reuse the\n125\t    Phase-0 JSON (no VLM). Mutates a copy — the input docmodel is left intact.\n126\t    \"\"\"\n127\t    ws = docmodel.get(\"workspace\") or \"default\"\n128\t    root = workspace_root or get_workspace_path(ws)\n129\t    elements = [dict(e) for e in docmodel.get(\"elements\", [])]\n130\t    by_order = {e[\"reading_order\"]: e for e in elements}\n131\t\n132\t    visuals = [e for e in elements if e.get(\"type\") in VISUAL_TYPES and e.get(\"crop\")]\n133\t    if limit is not None:\n134\t        visuals = visuals[:limit]\n135\t    todo_ids = {e[\"id\"] for e in visuals}\n136\t\n137\t    summary = {\n138\t        \"visual_total\": sum(1 for e in elements if e.get(\"type\") in VISUAL_TYPES),\n139\t        \"visual_processed\": 0,\n140\t        \"diagrams\": 0,\n141\t        \"validated\": 0,\n142\t        \"caption_fallback\": 0,\n143\t        \"charts\": 0,\n144\t        \"tables\": 0,\n145\t        \"scores\": [],\n146\t    }\n147\t\n148\t    for el in elements:\n149\t        if el.get(\"type\") == \"table\" and el.get(\"table\"):\n150\t            summary[\"tables\"] += 1\n151\t            continue\n152\t        if el[\"id\"] not in todo_ids:\n153\t            continue\n154\t        crop_path = root / el[\"crop\"]\n155\t        if not crop_path.exists():\n156\t            log_fn(f\"[pipeline] crop missing for #{el['reading_order']}: {crop_path}\")\n157\t            continue\n158\t        caption = _caption_for(by_order, el[\"reading_order\"])\n159\t        context = _context_for(by_order, el[\"reading_order\"])\n160\t        kind = classify_visual(el[\"type\"], caption)\n161\t        log_fn(\n162\t            f\"[pipeline] #{el['reading_order']} p{el.get('page')} {el['type']} -> {kind}  ({caption[:50]!r})\"\n163\t        )\n164\t\n165\t        sur = await describe_element(\n166\t            crop_path.read_bytes(),\n167\t            label=el[\"type\"],\n168\t            caption=caption,\n169\t            context=context,\n170\t            vlm_model=vlm_model,\n171\t            reviewer_model=reviewer_model,\n172\t            max_refine=max_refine,\n173\t            render_check=render_check,\n174\t            run_id=run_id,\n175\t            log_fn=lambda *a: log_fn(\"    \", *a),\n176\t        )\n177\t        el[\"surrogate\"] = sur\n178\t        summary[\"visual_processed\"] += 1\n179\t        if sur[\"surrogate_kind\"] in (\"mermaid\",):\n180\t            summary[\"diagrams\"] += 1\n181\t        if sur[\"surrogate_kind\"] == \"chart_json\":\n182\t            summary[\"charts\"] += 1\n183\t        if sur.get(\"validated\"):\n184\t            summary[\"validated\"] += 1\n185\t        if sur[\"surrogate_kind\"] == \"caption_fallback\":\n186\t            summary[\"caption_fallback\"] += 1\n187\t        if sur.get(\"score\") is not None:\n188\t            summary[\"scores\"].append(sur[\"score\"])\n189\t\n190\t    scores = summary.pop(\"scores\")\n191\t    summary[\"avg_score\"] = round(sum(scores) / len(scores), 2) if scores else None\n192\t\n193\t    markdown = \"\\n\\n\".join(\n194\t        _surrogate_to_markdown(e) for e in elements if _surrogate_to_markdown(e).strip()\n195\t    )\n196\t\n197\t    return {\n198\t        \"markdown\": markdown,\n199\t        \"elements\": elements,\n200\t        \"summary\": summary,\n201\t        \"source\": docmodel.get(\"source\"),\n202\t        \"workspace\": ws,\n203\t    }\n204\t\n205\t\n206\tdef write_enriched(\n207\t    result: Dict[str, Any], workspace: str, stem: str, workspace_root: Optional[Path] = None\n208\t) -> Dict[str, str]:\n\n... [22 lines truncated] ..."},"type":"attachment","uuid":"10692557-adb8-45c5-8be2-ad0eb031658e","timestamp":"2026-06-28T21:24:18.121Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime","sessionId":"8a533f4f-52c1-4883-9f06-3b7e51d615ce","version":"2.1.187","gitBranch":"HEAD"}
