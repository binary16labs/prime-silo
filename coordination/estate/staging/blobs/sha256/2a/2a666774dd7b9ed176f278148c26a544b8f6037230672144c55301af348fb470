what pip installs into site/; it is kept\n119\t// explicit (rather than parsing runtime/requirements.txt) so the bundle contents\n120\t// are reviewable and decoupled from server/dev/test churn.\n121\tconst BUNDLE_RUNTIME_REQUIREMENTS = [\n122\t  // API surface\n123\t  \"fastapi>=0.115.0\",\n124\t  \"uvicorn>=0.34.0\",\n125\t  \"httpx>=0.28.0\",\n126\t  \"pydantic>=2.10.0\",\n127\t  \"python-multipart>=0.0.20\",\n128\t  // Model calls (router/offline guard goes through litellm)\n129\t  \"litellm>=1.60.0\",\n130\t  \"tiktoken>=0.7.0\",\n131\t  // Swarm / Flows / Deep-produce\n132\t  \"langchain>=0.3.0\",\n133\t  \"langgraph>=0.2.0\",\n134\t  // RAG vector store + ANN index\n135\t  \"chromadb>=0.5.0\",\n136\t  \"hnswlib>=0.8.0\",\n137\t  // Graphs\n138\t  \"neo4j>=5.25.0\",\n139\t  \"networkx>=3.4.0\",\n140\t  // Lineage facets are imported at module load in governance/lineage.py (HTTP\n141\t  // emission itself stays gated off via BENNY_LINEAGE_ENABLED).\n142\t  \"openlineage-python>=1.27.0\",\n143\t  // Observability / tracing (governance/tracing.py). Pulls scipy, scikit-learn,\n144\t  // boto3, kubernetes, grpcio, the pydantic-ai + opentelemetry stack.\n145\t  \"arize-phoenix>=5.0.0\",\n146\t  // Tabular data — Pypes engines (pandas is the always-on default; polars/pyarrow\n147\t  // are the columnar fast path).\n148\t  \"pandas>=2.0.0\",\n149\t  \"polars>=1.0.0\",\n150\t  \"pyarrow>=15.0.0\",\n151\t  // Documents ingest (PDF + HTML cleanup). fitz == PyMuPDF.\n152\t  \"pypdf>=5.0.0\",\n153\t  \"beautifulsoup4>=4.12.0\",\n154\t  \"markdownify>=0.13.0\",\n155\t  \"PyMuPDF>=1.24.0\",\n156\t  // Code graph (Tree-Sitter AST + grammars)\n157\t  \"tree-sitter>=0.21.0\",\n158\t  \"tree-sitter-python>=0.21.0\",\n159\t  \"tree-sitter-javascript>=0.21.0\",\n160\t  \"tree-sitter-typescript>=0.23.0\",\n161\t  // Misc core\n162\t  \"jsonschema>=4.20.0\",\n163\t  \"pathspec>=0.12.0\",\n164\t  \"rich>=13.0.0\",\n165\t  \"mcp>=1.0\"\n166\t];\n167\t\n168\t// No packages are excluded