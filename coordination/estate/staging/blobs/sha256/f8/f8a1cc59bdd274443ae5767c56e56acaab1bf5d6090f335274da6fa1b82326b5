Toolbar\" style=\"display:none;\">\n    <button class=\"btn\" id=\"prevBtn\" onclick=\"prevPage()\">◀ Prev</button>\n    <span id=\"pageInfo\" style=\"font-size:13px; font-weight:bold; padding:0 8px;\">—</span>\n    <button class=\"btn\" id=\"nextBtn\" onclick=\"nextPage()\">Next ▶</button>\n    <div class=\"spacer\"></div>\n    <button class=\"btn\" id=\"fontDown\" onclick=\"changeFontSize(-1)\">A−</button>\n    <button class=\"btn\" id=\"fontUp\" onclick=\"changeFontSize(1)\">A+</button>\n  </div>\n\n  <!-- Content Viewport -->\n  <div class=\"reader-viewport\" id=\"viewport\">\n    <div class=\"loading-indicator\" id=\"loading\">Opening document...</div>\n  </div>\n\n  <!-- Status Bar -->\n  <div class=\"status-bar\">\n    <span id=\"statusText\">—</span>\n    <span id=\"statusMeta\"></span>\n  </div>\n</div>\n\n<script type=\"module\">\n  import { bridge } from './space-bridge.js';\n\n  const params   = new URLSearchParams(location.search);\n  const filePath = params.get('file') || '';\n  const fileType = params.get('type') || detectType(filePath);\n\n  let fontSize = 16;\n  let currentPdfPage = 1;\n  let totalPdfPages = 0;\n  let pdfDoc = null;\n\n  function detectType(path) {\n    const ext = bridge.utils.fileExtension(path);\n    if (ext === 'epub') return 'epub';\n    if (ext === 'pdf')  return 'pdf';\n    if (['md', 'markdown'].includes(ext)) return 'markdown';\n    return 'text';\n  }\n\n  window.goBack = function() {\n    if (document.referrer && document.referrer.includes('rekindle')) {\n      history.back();\n    } else {\n      location.href = 'files.html';\n    }\n  };\n\n  window.openInEditor = function() {\n    location.href = `editor.html?file=${encodeURIComponent(filePath)}`;\n  };\n\n  window.changeFontSize = function(delta) {\n    fontSize = Math.max(10, Math.min(28, fontSize + delta));\n    document.getElementById('viewport').style.fontSize = fontSize + 'px';\n  };\n\n  // ── PDF Navigation ──────────────────────────────────\n  window.prevPage = function() {\n    if (currentPdfPage > 1) { currentPdfPage--; renderPdfPage(); }\n  };\n\n  window.nextPage = function() {\n    if (currentPdfPage < totalPdfPages) { currentPdfPage++; renderPdfPage(); }\n  };\n\n  async function renderPdfPage() {\n    if (!pdfDoc) return;\n    const page = await pdfDoc.getPage(currentPdfPage);\n    const viewport = page.getViewport({ scale: 1.5 });\n    const canvas = document.getElementById('pdfCanvas');\n    canvas.width = viewport.width;\n    canvas.height = viewport.height;\n    const ctx = canvas.getContext('2d');\n    await page.render({ canvasContext: ctx, viewport }).promise;\n    document.getElementById('pageInfo').textContent = `${currentPdfPage} / ${totalPdfPages}`;\n  }\n\n  // ── Load Document ───────────────────────────────────\n  async function loadDocument() {\n    const loading  = document.getElementById('loading');\n    const vp       = document.getElementById('viewport');\n    const title    = document.getElementById('titleText');\n    const toolbar  = document.getElementById('readerToolbar');\n    const editBtn  = document.getElementById('editBtn');\n    const status   = document.getElementById('statusText');\n    const meta     = document.getElementById('statusMeta');\n\n    const fileName = filePath.split('/').pop() || 'Untitled';\n    title.textContent = fileName;\n\n    if (!filePath) {\n      loading.textContent = 'No file specified. Open a file from the Files app.';\n      status.textContent = 'No file';\n      return;\n    }\n\n    try {\n      if (fileType === 'pdf') {\n        await loadPdf(vp, loading, toolbar, status, meta);\n      } else if (fileType === 'markdown' || fileType === 'text') {\n        await loadText(vp, loading, status, meta, editBtn);\n      } else if (fileType === 'epub') {\n        await loadEpubFallback(vp, loading, status, meta);\n      }\n    } catch (err) {\n      loading.textContent = 'Error: ' + (err.message || 'Could not load document');\n      status.textContent = 'Error';\n    }\n  }\n\n  // ── PDF Loading ─────────────────────────────────────\n  async function loadPdf(vp, loading, toolbar, status, meta) {\n    toolbar.style.display = 'flex';\n\n    // Try client-side pdf.js first\n    if (typeof pdfjsLib !== 'undefined') {\n      try {\n        pdfjsLib.GlobalWorkerOptions.workerSrc =\n          'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';\n\n        // We need the raw binary — fetch through proxy or direct\n        const cfg = bridge.config.load();\n        const url = cfg.spaceUrl + '/api/file_read';\n        const res = await fetch(url, {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          credentials: 'include',\n          body: JSON.stringify({ path: filePath, encoding: 'base64' }),\n        });\n\n        if (res.ok) {\n          const data = await res.json();\n          const binary = atob(data.content || '');\n          const bytes = new Uint8Array(binary.length);\n          for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);\n\n          pdfDoc = await pdfjsLib.getDocument({ data: bytes }).promise;\n          totalPdfPages = pdfDoc.numPages;\n\n          loading.style.display = 'none';\n          vp.classList.add('pdf-viewport');\n          vp.innerHTML = '<canvas id=\"pdfCanvas\"></canvas>';\n\n          currentPdfPage = 1;\n          renderPdfPage();\n          status.textContent = filePath;\n          meta.textContent = totalPdfPages + ' pages';\n          return;\n        }\n      } catch (e) {\n        console.warn('pdf.js failed, falling back to server extraction:', e);\n      }\n    }\n\n    // Fallback: server-side text extraction via Benny\n    try {\n      const result = await bridge.workspaceFiles.pdfExtract(filePath);\n      loading.style.display = 'none';\n      toolbar.style.display = 'none';\n\n      const pages = result.pages || [];\n      let html = '';\n      for (const p of pages) {\n        html += `<h3 style=\"border-bottom:1px solid #000; margin-top:2em;\">Page ${p.page}</h3>`;\n        html += `<div style=\"white-space:pre-wrap;\">${escapeHtml(p.text)}</div>`;\n      }\n      vp.innerHTML = html || '<div class=\"empty-state\">No text could be extracted from this PDF.</div>';\n      status.textContent = filePath;\n      meta.textContent = pages.length + ' pages (text)';\n    } catch (err2) {\n      loading.textContent = 'Could not render PDF. Error: ' + err2.message;\n    }\n  }\n\n  // ── Markdown/Text Loading ───────────────────────────\n  async function loadText(vp, loading, status, meta, editBtn) {\n    const result = await bridge.files.read(filePath);\n    const content = result.content || result.text || (typeof result === 'string' ? result : '');\n\n    loading.style.display = 'none';\n    editBtn.style.display = 'flex';\n\n    if (fileType === 'markdown') {\n      vp.innerHTML = '';\n      const preview = document.createElement('div');\n      preview.className = 'preview-area';\n      preview.innerHTML = typeof marked !== 'undefined'\n        ? marked.parse(content)\n        : content.replace(/\\n/g, '<br>');\n      vp.appendChild(preview);\n    } else {\n      vp.innerHTML = `<pre style=\"white-space:pre-wrap; font-family:var(--font-mono); font-size:14px; padding:12px;\">${escapeHtml(content)}</pre>`;\n    }\n\n    status.textContent = filePath;\n    meta.textContent = bridge.utils.formatBytes(content.length);\n\n    // Cache for offline\n    bridge.cache.set('reader_' + filePath, content);\n  }\n\n  // ── EPUB Fallback (text-only for e-ink) ─────────────\n  async function loadEpubFallback(vp, loading, status, meta) {\n    // On e-ink devices, a full epub.js renderer may be too heavy.\n    // We'll try to read the file and display what we can.\n    loading.textContent = 'EPUB support requires epub.js. For now, try converting to PDF or Markdown.';\n    status.textContent = 'EPUB (limited)';\n    meta.textContent = '';\n\n    // Attempt: if epub.js is available on the page, use it\n    // This is a placeholder for future epub.js integration\n  }\n\n  function escapeHtml(s) {\n    const d = document.createElement('div');\n    d.textContent = s;\n    return d.innerHTML;\n  }\n\n  // ── Init ─────────────────────────────────────────────\n  loadDocument();\n</script>\n\n</body>\n</html>\n","numLines":252,"startLine":1,"totalLines":252}},"sourceToolAssistantUUID":"48c7abc7-fc82-421a-9cf7-4055962626d9","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"96450f51-d651-4f84-a2b8-70f86383cafe","version":"2.1.202","gitBranch":"HEAD"}
