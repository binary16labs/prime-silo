35\t * Fail-fast credential check, called once at server startup (see app.js).\n136\t * Throws before the server begins listening if either Benny key cannot be\n137\t * resolved via env or the per-install keystore — in ALL modes, not just\n138\t * production, since there is no shipped default left to fall back to.\n139\t */\n140\texport function assertRuntimeProxyConfig() {\n141\t  resolveBennyApiKey();\n142\t  resolveBennyAgentApiKey();\n143\t}\n144\t\n145\tfunction getRuntimeBaseUrl() {\n146\t  return (process.env.RUNTIME_BASE_URL || DEFAULT_RUNTIME_BASE_URL).replace(/\\/+$/, \"\");\n147\t}\n148\t\n149\tfunction getBennyApiKey() {\n150\t  return resolveBennyApiKey();\n151\t}\n152\t\n153\tfunction getBennyAgentApiKey() {\n154\t  return resolveBennyAgentApiKey();\n155\t}\n156\t\n157\texport function isRuntimeProxyPath(pathname) {\n158\t  return pathname === RUNTIME_PATH_PREFIX || pathname.startsWith(RUNTIME_PATH_PREFIX + \"/\");\n159\t}\n160\t\n161\texport function isAgentRuntimeProxyPath(pathname) {\n162\t  return (\n163\t    pathname === AGENT_RUNTIME_PATH_PREFIX || pathname.startsWith(AGENT_RUNTIME_PATH_PREFIX + \"/\")\n164\t  );\n165\t}\n166\t\n167\tfunction buildUpstreamUrlFor(prefix, requestUrl) {\n168\t  // Strip the proxy prefix and rebuild against the runtime base.\n169\t  // /api/runtime/agent_sandbox/health → http://127.0.0.1:8005/api/agent_sandbox/health\n170\t  const trimmed = requestUrl.pathname.slice(prefix.length) || \"/\";\n171\t  return `${getRuntimeBaseUrl()}/api${trimmed}${requestUrl.search}`;\n172\t}\n173\t\n174\t/**\n175\t * ADR-003 (Q0 follow-up): dot-segments must never survive into the upstream\n176\t * URL. `new URL()` normalises literal `..` before routing, but percent-encoded\n177\t * dots (`%2e%2e`) pass through `pathname` untouched and would be decoded and\n178\t * normalised by the upstream server — letting a caller escape the facade's\n179\t * `/api` prefix. Undecodable paths are rejected as traversal too.\n180\t */\n181\texport function hasPathTraversal(pathname) {\n182\t  let decoded = String(pathname || \"\");\n183\t  try {\n184\t    decoded = decodeURIComponent(decoded);\n185\t  } catch {\n186\t    return true;\n187\t  }\n188\t  return decoded.split(/[\\\\/]+/).some((segment) => segment === \"..\");\n189\t}\n190\t\n191\tfunction rejectTraversal(res) {\n192\t  res.writeHead(400, { \"Content-Type\": \"application/json\" });\n193\t  res.end(JSON.stringify({ error: \"invalid_path\", detail: \"dot-segments are not allowed\" }));\n194\t}\n195\t\n196\tfunction mapUnreachable(err, upstreamUrl) {\n197\t  return {\n198\t    status: 502,\n199\t    body: {\n200\t      error: \"runtime_proxy_unreachable\",\n201\t      detail: String(err?.message || err),\n202\t      upstream_url: upstreamUrl\n203\t    }\n204\t  };\n205\t}\n206\t\n207\t/**\n208\t * Handle a /api/runtime/<path> request — the HUMAN facade.\n209\t *\n210\t * Injects the trusted Benny key and strips any client-supplied agent scope so a\n211\t * human request can never self-assert (or be tricked into asserting) an agent\n212\t * scope. Resolves once the response has fully streamed.\n213\t */\n214\texport async function proxyToRuntime(req, res, requestUrl) {\n215\t  if (hasPathTraversal(requestUrl.pathname)) {\n216\t    rejectTraversal(res);\n217\t    return;\n218\t  }\n219\t  const upstreamUrl = buildUpstreamUrlFor(RUNTIME_PATH_PREFIX, requestUrl);\n220\t  const headers = buildUpstreamHeaders(req.headers, {\n221\t    // The client value is never trusted: a forged X-Benny-Agent-Scope is dropped.\n222\t    dropHeaders: [AGENT_SCOPE_HEADER],\n223\t    setHeaders: { \"X-Benny-API-Key\": getBennyApiKey() }\n224\t  });\n225\t\n226\t  await forwardToUpstream({\n227\t    req,\n228\t    res,\n229\t    upstreamUrl,\n230\t    headers,\n231\t    mapError: (err) => mapUnreachable(err, upstreamUrl)\n232\t  });\n233\t}\n234\t\n235\t/**\n236\t * Handle a /api/agent-runtime/<path> request — the AGENT facade.\n237\t *\n238\t * Injects the sandbox-bound agent key and sets X-Benny-Agent-Scope=sandbox\n239\t * server-side, overwriting any client value. The agent cannot widen its own\n240\t * scope: the header it sends is discarded and the credential it gets is pinned\n241\t * to sandbox at Benny.\n242\t */\n243\texport async function proxyToAgentRuntime(req, res, requestUrl) {\n244\t  if (hasPathTraversal(requestUrl.pathname)) {\n245\t    rejectTraversal(res);\n246\t    return;\n247\t  }\n248\t  const upstreamUrl = buildUpstreamUrlFor(AGENT_RUNTIME_PATH_PREFIX, requestUrl);\n249\t  const headers = buildUpstreamHeaders(req.headers, {\n250\t    dropHeaders: [AGENT_SCOPE_HEADER],\n251\t    setHeaders: {\n252\t      \"X-Benny-API-Key\": getBennyAgentApiKey(),\n253\t      [AGENT_SCOPE_HEADER]: SANDBOX_SCOPE\n254\t    }\n255\t  });\n256\t\n257\t  await forwardToUpstream({\n258\t    req,\n259\t    res,\n260\t    upstreamUrl,\n261\t    headers,\n262\t    mapError: (err) => mapUnreachable(err, upstreamUrl)\n263\t  });\n264\t}\n265\t\n266\t/**\n267\t * Out-of-band Benny-runtime request helper for non-router callers (the\n268\t * `node space bridge` CLI). This is a trusted server-side caller, so it uses\n269\t * the trusted key. Returns parsed JSON; never throws on transport failure\n270\t * (returns {ok:false}). Paths are relative to the runtime's /api root.\n271\t */\n272\texport async function runtimeRequest(apiPath, { method = \"GET\", body, timeoutMs = 15000 } = {}) {\n273\t  const normalizedPath = apiPath.startsWith(\"/\") ? apiPath : `/${apiPath}`;\n274\t  const url = `${getRuntimeBaseUrl()}/api${normalizedPath}`;\n275\t\n276\t  let response;\n277\t  try {\n278\t    response = await fetch(url, {\n279\t      method,\n280\t      headers: {\n281\t        \"X-Benny-API-Key\": getBennyApiKey(),\n282\t        ...(body ? { \"content-type\": \"application/json\" } : {})\n283\t      },\n284\t      body: body ? JSON.stringify(body) : undefined,\n285\t      signal: AbortSignal.timeout(timeoutMs)\n286\t    });\n287\t  } catch (err) {\n288\t    return {\n289\t      ok: false,\n290\t      status: 0,\n291\t      error: \"runtime_unreachable\",\n292\t      detail: String(err?.message || err),\n293\t      hint: \"Benny runtime is not running. Boot it with scripts/dev.ps1 (or python -m benny.api.server), or set RUNTIME_BASE_URL.\",\n294\t      url\n295\t    };\n296\t  }\n297\t\n298\t  let payload = null;\n299\t  try {\n300\t    payload = await response.json();\n301\t  } catch {\n302\t    payload = null;\n303\t  }\n304\t  return { ok: response.ok, status: response.status, body: payload, url };\n305\t}\n306\t\n307\t// Exposed for tests so the proxy's path semantics stay locked.\n308\texport const __testing = {\n309\t  RUNTIME_PATH_PREFIX,\n310\t  AGENT_RUNTIME_PATH_PREFIX,\n311\t  DEFAULT_RUNTIME_BASE_URL,\n312\t  AGENT_SCOPE_HEADER,\n313\t  SANDBOX_SCOPE,\n314\t  buildUpstreamUrl: (requestUrl) => buildUpstreamUrlFor(RUNTIME_PATH_PREFIX, requestUrl),\n315\t  buildAgentUpstreamUrl: (requestUrl) => buildUpstreamUrlFor(AGENT_RUNTIME_PATH_PREFIX, requestUrl)\n316\t};\n317\t"}]},"uuid":"e1766448-9009-4da4-8748-5df6133fa9fe","timestamp":"2026-07-10T12:12:34.720Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\server\\lib\\runtime_proxy.js","content":"// ADR-001 Phase D — Benny runtime proxy.\n//\n// Forwards shell requests to the Benny FastAPI runtime (default\n// http://127.0.0.1:8005) over two distinct, server-authoritative facades:\n//\n//   • /api/runtime/<path>        — HUMAN path. Strips /api/runtime, injects the\n//     trusted BENNY_API_KEY, and *strips* any client X-Benny-Agent-Scope. A\n//     human-driven request runs under Benny's normal RBAC (no agent scope).\n//\n//   • /api/agent-runtime/<path>  — AGENT path. Strips /api/agent-runtime,\n//     injects the sandbox-bound BENNY_AGENT_API_KEY, and *sets* the agent\n//     scope to \"sandbox\" server-side, overwriting whatever the client sent.\n//\n// Why two paths (ADR-001 confused-deputy fix): the de