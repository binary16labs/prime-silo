\">\n</head>\n<body>\n\n<div class=\"window\">\n  <!-- Title Bar -->\n  <div class=\"title-bar\">\n    <button class=\"btn-back\" onclick=\"location.href='index.html'\">◀</button>\n    <div class=\"title-stripes\"></div>\n    <span class=\"title-text\">Settings</span>\n  </div>\n\n  <div class=\"content\">\n\n    <!-- Connection Settings -->\n    <div class=\"settings-group\">\n      <div class=\"settings-group-title\">Connection</div>\n      <div class=\"settings-row\">\n        <label for=\"spaceUrl\">Space Agent URL</label>\n        <input type=\"url\" id=\"spaceUrl\" placeholder=\"(same origin)\" title=\"Leave blank for same-origin. Set to http://192.168.x.x:PORT for cross-origin.\">\n      </div>\n      <div class=\"settings-row\">\n        <label for=\"bennyUrl\">Benny API URL</label>\n        <input type=\"url\" id=\"bennyUrl\" placeholder=\"http://localhost:8005\">\n      </div>\n      <div class=\"settings-row\">\n        <label for=\"bennyKey\">Benny API Key</label>\n        <input type=\"text\" id=\"bennyKey\" placeholder=\"(optional)\">\n      </div>\n    </div>\n\n    <!-- Connection Test -->\n    <div class=\"settings-group\">\n      <div class=\"settings-group-title\">Test Connection</div>\n      <div class=\"settings-row\" style=\"flex-direction: column; align-items: stretch; gap: 8px;\">\n        <button class=\"btn\" onclick=\"testConnection()\" style=\"width: 100%;\">🔌 Test Connection</button>\n        <div id=\"testResults\" style=\"font-family: var(--font-mono); font-size: 12px; padding: 4px 0;\">\n          Press \"Test Connection\" to check both servers.\n        </div>\n      </div>\n    </div>\n\n    <!-- Display Settings -->\n    <div class=\"settings-group\">\n      <div class=\"settings-group-title\">Display</div>\n      <div class=\"settings-row\">\n        <label for=\"fontSize\">Font Size</label>\n        <select id=\"fontSize\">\n          <option value=\"14\">14px — Small</option>\n          <option value=\"16\" selected>16px — Normal</option>\n          <option value=\"18\">18px — Large</option>\n          <option value=\"20\">20px — Extra Large</option>\n          <option value=\"24\">24px — Huge</option>\n        </select>\n      </div>\n    </div>\n\n    <!-- Data Management -->\n    <div class=\"settings-group\">\n      <div class=\"settings-group-title\">Data</div>\n      <div class=\"settings-row\">\n        <label>Cached Files</label>\n        <button class=\"btn\" onclick=\"clearCache()\">Clear Cache</button>\n      </div>\n      <div class=\"settings-row\">\n        <label>Chat History</label>\n        <button class=\"btn\" onclick=\"clearChatHistory()\">Clear Chat</button>\n      </div>\n      <div class=\"settings-row\">\n        <label>All Local Data</label>\n        <button class=\"btn\" onclick=\"resetAll()\">Reset Everything</button>\n      </div>\n    </div>\n\n    <!-- About -->\n    <div class=\"settings-group\">\n      <div class=\"settings-group-title\">About</div>\n      <div class=\"settings-row\" style=\"flex-direction: column; align-items: flex-start; gap: 4px;\">\n        <div style=\"font-size: 14px;\"><strong>ReKindle × Space Agent</strong></div>\n        <div style=\"font-size: 12px; color: var(--muted);\">\n          Self-hosted e-ink interface for Space Agent &amp; Benny AI.\n          <br>Based on <a href=\"https://github.com/ReKindleOS/ReKindle\" target=\"_blank\" style=\"color: var(--text);\">ReKindleOS/ReKindle</a> (MIT License).\n        </div>\n      </div>\n    </div>\n\n    <!-- Save Button -->\n    <div style=\"padding: 12px 0;\">\n      <button class=\"btn\" onclick=\"saveSettings()\" style=\"width: 100%; font-size: 16px; padding: 12px;\">\n        💾 Save Settings\n      </button>\n    </div>\n\n  </div>\n\n  <!-- Status Bar -->\n  <div class=\"status-bar\">\n    <span id=\"statusText\">—</span>\n  </div>\n</div>\n\n<script type=\"module\">\n  import { bridge } from './space-bridge.js';\n\n  const spaceUrl = document.getElementById('spaceUrl');\n  const bennyUrl = document.getElementById('bennyUrl');\n  const bennyKey = document.getElementById('bennyKey');\n  const fontSize = document.getElementById('fontSize');\n  const status   = document.getElementById('statusText');\n\n  // ── Load Settings ───────────────────────────────────\n  function loadSettings() {\n    const cfg = bridge.config.load();\n    spaceUrl.value = cfg.spaceUrl || '';\n    bennyUrl.value = cfg.bennyUrl || 'http://localhost:8005';\n    bennyKey.value = cfg.bennyApiKey || '';\n\n    // Display settings\n    const display = JSON.parse(localStorage.getItem('rekindle_display') || '{}');\n    if (display.fontSize) fontSize.value = display.fontSize;\n\n    status.textContent = 'Settings loaded';\n  }\n\n  // ── Save Settings ───────────────────────────────────\n  window.saveSettings = function() {\n    bridge.config.save({\n      spaceUrl: spaceUrl.value.replace(/\\/+$/, ''),\n      bennyUrl: bennyUrl.value.replace(/\\/+$/, ''),\n      bennyApiKey: bennyKey.value,\n    });\n\n    localStorage.setItem('rekindle_display', JSON.stringify({\n      fontSize: fontSize.value,\n    }));\n\n    // Apply font size globally\n    document.documentElement.style.fontSize = fontSize.value + 'px';\n\n    status.textContent = 'Settings saved ✓';\n  };\n\n  // ── Test Connection ─────────────────────────────────\n  window.testConnection = async function() {\n    const results = document.getElementById('testResults');\n    results.textContent = 'Testing...';\n\n    // Save current values temporarily\n    const tempCfg = {\n      spaceUrl: spaceUrl.value.replace(/\\/+$/, ''),\n      bennyUrl: bennyUrl.value.replace(/\\/+$/, ''),\n      bennyApiKey: bennyKey.value,\n    };\n    bridge.config.save(tempCfg);\n\n    let output = '';\n\n    // Test Space Agent\n    try {\n      const spaceOk = await bridge.health.spaceAlive();\n      output += spaceOk\n        ? '✓ Space Agent — connected\\n'\n        : '✗ Space Agent — unreachable\\n';\n    } catch (e) {\n      output += '✗ Space Agent — error: ' + e.message + '\\n';\n    }\n\n    // Test Benny\n    try {\n      const bennyOk = await bridge.health.bennyAlive();\n      output += bennyOk\n        ? '✓ Benny API — connected\\n'\n        : '✗ Benny API — unreachable\\n';\n    } catch (e) {\n      output += '✗ Benny API — error: ' + e.message + '\\n';\n    }\n\n    // Test auth (if Space Agent is up)\n    try {\n      const auth = await bridge.auth.check();\n      if (auth && auth.authenticated !== false) {\n        output += '✓ Authenticated as: ' + (auth.username || 'unknown') + '\\n';\n      } else {\n        output += '⚠ Not authenticated (login required)\\n';\n      }\n    } catch {\n      output += '⚠ Auth check skipped\\n';\n    }\n\n    results.textContent = output;\n    status.textContent = 'Test complete';\n  };\n\n  // ── Data Management ─────────────────────────────────\n  window.clearCache = function() {\n    bridge.cache.clear();\n    status.textContent = 'Cache cleared ✓';\n  };\n\n  window.clearChatHistory = function() {\n    localStorage.removeItem('rekindle_chat_history');\n    status.textContent = 'Chat history cleared ✓';\n  };\n\n  window.resetAll = function() {\n    if (!confirm('This will remove all local ReKindle data including settings, cache, and chat history. Continue?')) return;\n\n    // Remove all rekindle-related localStorage keys\n    const keysToRemove = [];\n    for (let i = 0; i < localStorage.length; i++) {\n      const key = localStorage.key(i);\n      if (key && (key.startsWith('rekindle_') || key.startsWith('rk_cache_'))) {\n        keysToRemove.push(key);\n      }\n    }\n    keysToRemove.forEach(k => localStorage.removeItem(k));\n\n    status.textContent = 'All data cleared ✓';\n    loadSettings();\n  };\n\n  // ── Init ─────────────────────────────────────────────\n  loadSettings();\n</script>\n\n</body>\n</html>\n","numLines":234,"startLine":1,"totalLines":234}},"sourceToolAssistantUUID":"b27b6fc9-4c1f-44cc-8809-d8c166a7da23","userType":"external","