{"parentUuid":"65edb44b-0256-45c4-9b9f-fc77cb34d8cc","isSidechain":false,"promptId":"85b8b153-3abc-4db9-9e9e-9fcc277f5e21","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TBoE5CKVVLbLQYgiTcDibC","type":"tool_result","content":"1\t// Single authority for resolving the Prime-Silo home on the Node side.\n2\t//\n3\t// Historically the app had four competing notions of \"home\": the tray's\n4\t// config.homeDir, the tray's config.bennyHome, the CUSTOMWARE_PATH runtime\n5\t// param, and repo-relative fallbacks. This module collapses them into one\n6\t// declared root with everything else derived from it:\n7\t//\n8\t//   <root>/                  ← PRIME_SILO_HOME (the one declared home)\n9\t//   ├── customware/          ← CUSTOMWARE_PATH (Space server L1/L2)\n10\t//   └── benny/               ← BENNY_HOME (portable Benny runtime)\n11\t//\n12\t// Resolution precedence for the root (highest wins):\n13\t//   1. PRIME_SILO_HOME env var        → source \"env\"\n14\t//   2. homeDir in prime-silo-config.json → source \"config\"\n15\t//   3. per-user default (<appData>/Prime-Silo/prime-silo-home) → source \"default\"\n16\t//\n17\t// Explicit BENNY_HOME / CUSTOMWARE_PATH env overrides and the legacy\n18\t// config.bennyHome key remain honored — but they are reported with their own\n19\t// source tag and a divergence warning when they point outside the declared\n20\t// root, so `benny doctor`, /api/home, and the tray can surface the drift\n21\t// instead of hiding it.\n22\t//\n23\t// Kept dependency-free and Electron-free: Electron callers pass the parsed\n24\t// config + userData path in; non-Electron callers (server API, CLI, tests)\n25\t// rely on the built-in per-platform config locator.\n26\t//\n27\t// The Python runtime has a mirror of this logic in\n28\t// runtime/benny/portable/home.py (resolve_home) — keep the two in sync.\n29\t\n30\tconst fs = require(\"node:fs\");\n31\tconst path = require(\"node:path\");\n32\tconst os = require(\"node:os\");\n33\tconst { randomBytes } = require(\"node:crypto\");\n34\t\n35\tconst CONFIG_DIR_NAME = \"Prime-Silo\";\n36\tconst CONFIG_FILENAME = \"prime-silo-config.json\";\n37\tconst DEFAULT_HOME_DIRNAME = \"prime-silo-home\";\n38\tconst CUSTOMWARE_SUBDIR = \"customware\";\n39\tconst BENNY_SUBDIR = \"benny\";\n40\t// Pre-unification per-user defaults (main.js used userData/customware and\n41\t// userData/benny-home when nothing was configured). Installs that already\n42\t// have data there keep working untouched.\n43\tconst LEGACY_CUSTOMWARE_DIRNAME = \"customware\";\n44\tconst LEGACY_BENNY_DIRNAME = \"benny-home\";\n45\t\n46\tfunction trimmed(value) {\n47\t  return String(value == null ? \"\" : value).trim();\n48\t}\n49\t\n50\t// Per-user application-data base without Electron: the same directory\n51\t// Electron's app.getPath(\"userData\") resolves to for this app.\n52\tfunction appDataBase(platform, env, homedir) {\n53\t  if (platform === \"win32\") {\n54\t    return trimmed(env.APPDATA) || path.join(homedir, \"AppData\", \"Roaming\");\n55\t  }\n56\t  if (platform === \"darwin\") {\n57\t    return path.join(homedir, \"Library\", \"Application Support\");\n58\t  }\n59\t  return trimmed(env.XDG_CONFIG_HOME) || path.join(homedir, \".config\");\n60\t}\n61\t\n62\tfunction defaultUserDataPath({ platform = process.platform, env = process.env } = {}) {\n63\t  return path.join(appDataBase(platform, env, os.homedir()), CONFIG_DIR_NAME);\n64\t}\n65\t\n66\tfunction configFilePath(options = {}) {\n67\t  const userDataPath = trimmed(options.userDataPath) || defaultUserDataPath(options);\n68\t  return path.join(userDataPath, CONFIG_FILENAME);\n69\t}\n70\t\n71\t// Best-effort read of prime-silo-config.json for callers that don't already\n72\t// have it parsed (server API, CLI). Electron callers keep their own reader.\n73\tfunction readDesktopConfig(options = {}) {\n74\t  try {\n75\t    const file = configFilePath(options);\n76\t    if (fs.existsSync(file)) {\n77\t      return JSON.parse(fs.readFileSync(file, \"utf8\")) || {};\n78\t    }\n79\t  } catch {\n80\t    // Unreadable config is treated as absent; resolution falls to defaults.\n81\t  }\n82\t  return {};\n83\t}\n84\t\n85\tfunction isInside(child, parent) {\n86\t  const rel = path.relative(path.resolve(parent), path.resolve(child));\n87\t  return rel === \"\" || (!rel.startsWith(\"..\") && !path.isAbsolute(rel));\n88\t}\n89\t\n90\t// Resolve the declared home root and the two derived paths.\n91\t//\n92\t// options:\n93\t//   env          — environment map (default process.env)\n94\t//   config       — parsed prime-silo-config.json (default: read from disk)\n95\t//   userDataPath — Electron userData dir (default: per-platform equivalent)\n96\t//   platform     — default process.platform\n97\t//\n98\t// returns {\n99\t//   root, source,                 // \"env\" | \"config\" | \"default\"\n100\t//   customwarePath, customwareSource, // \"derived\" | \"env-override\" | \"legacy-default\"\n101\t//   bennyHome, bennyHomeSource,   // \"derived\" | \"env-override\" | \"legacy-config\" | \"legacy-default\"\n102\t//   configPath,                   // where the config file lives\n103\t//   warnings                      // human-readable divergence notes\n104\t// }\n105\tfunction resolveHome(options = {}) {\n106\t  const env = options.env || process.env;\n107\t  const platform = options.platform || process.platform;\n108\t  const userDataPath = trimmed(options.userDataPath) || defaultUserDataPath({ platform, env });\n109\t  const config =\n110\t    options.config && typeof options.config === \"object\"\n111\t      ? options.config\n112\t      : readDesktopConfig({ userDataPath });\n113\t\n114\t  const warnings = [];\n115\t\n116\t  // 1. The declared root.\n117\t  let root;\n118\t  let source;\n119\t  const envRoot = trimmed(env.PRIME_SILO_HOME);\n120\t  const configRoot = trimmed(config.homeDir);\n121\t  if (envRoot) {\n122\t    root = path.resolve(envRoot);\n123\t    source = \"env\";\n124\t    if (config