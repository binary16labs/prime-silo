const row = {\n      stream: \"B\",\n      id: `B-trace-${e.id}`,\n      state,\n      goal,\n      tool_call: { name, args },\n      source: { type: \"trace\", id: e.id, sid: rootSid(e), agent: e.agent },\n    };\n    // Privacy: drop the row if any of its text carries personal/job context.\n    const flat = `${state}\\n${goal}\\n${JSON.stringify(row.tool_call)}\\n${row.source.sid}`;\n    if (detector(flat)) {\n      excluded.personal++;\n      continue;\n    }\n    rows.push(row);\n  }\n  return { rows, excluded };\n}\n\n// Emit Stream A from cards + ADRs, applying the same personal-context filter.\nexport function buildStreamA(cards, adrs, { detector = () => false } = {}) {\n  const rows = [];\n  const excluded = { personal: 0 };\n  for (const pair of [...cards.flatMap(cardToPairs), ...adrs.flatMap(adrToPairs)]) {\n    if (detector(`${pair.instruction}\\n${pair.response}\\n${pair.source.id}`)) {\n      excluded.personal++;\n      continue;\n    }\n    rows.push(pair);\n  }\n  return { rows, excluded };\n}\n\nexport { validateRowA, validateRowB };\n","structuredPatch":[{"oldStart":111,"oldLines":7,"newStart":111,"newLines":7,"lines":["       state,","       goal,","       tool_call: { name, args },","-      source: { type: \"trace\", id: e.id, sid: rootSid(e), agent: e.agent },","+      source: { type: \"trace\", id: e.id, sid, agent: e.agent },","     };","     // Privacy: drop the row if any of its text carries personal/job context.","     const flat = `${state}\\n${goal}\\n${JSON.stringify(row.tool_call)}\\n${row.source.sid}`;"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"8967e88b-3e4e-4933-ad91-50ce3a2f2ea5","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"61a9f7a2-1353-4f19-addd-895289cb8f19","version":"2.1.217","gitBranch":"HEAD"}
