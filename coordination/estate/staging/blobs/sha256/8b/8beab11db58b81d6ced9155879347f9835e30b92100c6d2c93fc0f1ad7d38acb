{"parentUuid":"20ce8d58-d50b-47a5-855b-8b403d475519","isSidechain":false,"promptId":"85b8b153-3abc-4db9-9e9e-9fcc277f5e21","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0118pDe1xVWQ4LkArkMchp3F","type":"tool_result","content":"1\t\"\"\"`$BENNY_HOME` layout, init, validate, and uninstall.\n2\t\n3\tThis module is the single authority for what a portable Benny install looks\n4\tlike on disk. The layout is declared once, at the top, and every other piece\n5\tof the system resolves paths through a ``BennyHome`` instance.\n6\t\n7\tSee PBR-001 §4.1 for the declared shape.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport dataclasses\n13\timport os\n14\timport secrets\n15\timport shutil\n16\timport sys\n17\timport uuid\n18\tfrom pathlib import Path\n19\tfrom typing import Iterable, Literal\n20\t\n21\tProfile = Literal[\"app\", \"native\"]\n22\t\n23\tSCHEMA_VERSION = \"1.0.0\"\n24\t\n25\t# Shared layout — present under both profiles.\n26\tSHARED_DIRS: tuple[str, ...] = (\n27\t    \"bin\",\n28\t    \"config\",\n29\t    \"data\",\n30\t    \"data/runs\",\n31\t    \"data/lineage\",\n32\t    \"data/vector\",\n33\t    \"data/graph\",\n34\t    \"workspaces\",\n35\t    \"models\",\n36\t    \"logs\",\n37\t    \"tmp\",\n38\t    \"state\",\n39\t)\n40\t\n41\t# Profile-specific subtrees — mutually exclusive.\n42\tAPP_DIRS: tuple[str, ...] = (\"app\",)\n43\tNATIVE_DIRS: tuple[str, ...] = (\"runtime\", \"runtime/python\", \"runtime/node\", \"runtime/neo4j\")\n44\t\n45\t# Config files seeded on fresh init.\n46\t_BENNY_TOML_TEMPLATE = \"\"\"# Portable Benny config (see PBR-001 §4.1).\n47\t# Paths declared here MUST be either relative or under this $BENNY_HOME root.\n48\tschema_version = \"{schema_version}\"\n49\tprofile = \"{profile}\"\n50\t\n51\t[runtime]\n52\t# Port assignments match benny/core/models.py LOCAL_PROVIDERS defaults.\n53\tlemonade_port = 13305\n54\tneo4j_bolt_port = 7687\n55\tneo4j_http_port = 7474\n56\tapi_port = 8000\n57\tui_port = 5173\n58\t\"\"\"\n59\t\n60\t_VOICES_JSON = \"\"\"{\n61\t  \"_comment\": \"TTS voice registry; closes the hardcoded af_sky gap (PBR-001 §4.4).\",\n62\t  \"providers\": {\n63\t    \"lemonade\": {\n64\t      \"voices\": [\"af_sky\", \"bf_emma\", \"bm_george\", \"af_bella\"],\n65\t      \"default\": \"af_sky\"\n66\t    }\n67\t  }\n68\t}\n69\t\"\"\"\n70\t\n71\t_SERVER_OPS_ALLOWLIST_JSON = \"\"\"{\n72\t  \"_comment\": \"Allow-listed local-LLM server-ops targets (LC-2 scope).\",\n73\t  \"commands\": [\"status\", \"health\", \"start\", \"stop\"],\n74\t  \"services\": [\"lemonade\", \"ollama\", \"fastflowlm\", \"neo4j\", \"marquez\"]\n75\t}\n76\t\"\"\"\n77\t\n78\t# Portable launcher scripts (PBR-001 §4.3). Each launcher derives $BENNY_HOME\n79\t# from its own location so the SSD can be mounted at any drive letter or path.\n80\t# {python_exe} is substituted at seed time with the absolute path to the\n81\t# interpreter that ran `benny init`, ensuring launchers always use the venv.\n82\t_POSIX_LAUNCHER = \"\"\"#!/usr/bin/env sh\n83\t# Portable Benny launcher (POSIX). Self-locates $BENNY_HOME.\n84\tset -e\n85\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n86\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n87\texec {python_exe} -m benny_cli \"$@\"\n88\t\"\"\"\n89\t\n90\t_WINDOWS_LAUNCHER = \"\"\"@echo off\n91\trem Portable Benny launcher (Windows). Self-locates %%BENNY_HOME%%.\n92\trem Python path pinned to the venv that ran `benny init` — do not edit by hand;\n93\trem re-run `benny init` if you recreate the venv.\n94\tset \"SCRIPT_DIR=%~dp0\"\n95\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n96\t\"{python_exe}\" -m benny_cli %*\n97\t\"\"\"\n98\t\n99\t_POSIX_UI_LAUNCHER = \"\"\"#!/usr/bin/env sh\n100\t# Starts the UI dev server.  Checks BENNY_FRONTEND_DIR first (dev installs),\n101\t# then $BENNY_HOME/app/ui (packaged installs), then $BENNY_HOME.\n102\tset -e\n103\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n104\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n105\tif [ -n \"$BENNY_FRONTEND_DIR\" ] && [ -d \"$BENNY_FRONTEND_DIR\" ]; then\n106\t    cd \"$BENNY_FRONTEND_DIR\"\n107\telif [ -d \"$BENNY_HOME/app/ui\" ]; then\n108\t    cd \"$BENNY_HOME/app/ui\"\n109\telse\n110\t    cd \"$BENNY_HOME\"\n111\tfi\n112\texec npm run dev -- \"$@\"\n113\t\"\"\"\n114\t\n115\t_WINDOWS_UI_LAUNCHER = \"\"\"@echo off\n116\tset \"SCRIPT_DIR=%~dp0\"\n117\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n118\tif defined BENNY_FRONTEND_DIR (\n119\t    cd /d \"%BENNY_FRONTEND_DIR%\"\n120\t) else if exist \"%BENNY_HOME%\\\\app\\\\ui\" (\n121\t    cd /d \"%BENNY_HOME%\\\\app\\\\ui\"\n122\t) else (\n123\t    cd /d \"%BENNY_HOME%\"\n124\t)\n125\tnpm run dev -- %*\n126\t\"\"\"\n127\t\n128\t_POSIX_LLM_LAUNCHER = \"\"\"#!/usr/bin/env sh\n129\t# Starts the local LLM runtime (Lemonade). Placeholder until the bundled\n130\t# binary is side-loaded under models/ or app/; for now defers to PATH.\n131\tset -e\n132\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n133\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n134\texec lemonade-server \"$@\"\n135\t\"\"\"\n136\t\n137\t_WINDOWS_LLM_LAUNCHER = \"\"\"@echo off\n138\tset \"SCRIPT_DIR=%~dp0\"\n139\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n140\tLemonadeServer.exe %*\n141\t\"\"\"\n142\t\n143\t_POSIX_NEO4J_LAUNCHER = \"\"\"#!/usr/bin/env sh\n144\tset -e\n145\tSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\n146\texport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\n147\texec neo4j \"$@\"\n148\t\"\"\"\n149\t\n150\t_WINDOWS_NEO4J_LAUNCHER = \"\"\"@echo off\n151\tset \"SCRIPT_DIR=%~dp0\"\n152\tfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n153\tneo4j.bat %*\n154\t\"\"\"\n155\t\n156\t_LAUNCHERS: tuple[tuple[str, str, bool], ...] = (\n157\t    (\"benny\", _POSIX_LAUNCHER, True),\n158\t    (\"benny.cmd\", _WINDOWS_LAUNCHER, False),\n159\t    (\"benny-ui\", _POSIX_UI_LAUNCHER, True),\n160\t    (\"benny-ui.cmd\", _WINDOWS_UI_LAUNCHER, False),\n161\t    (\"benny-llm\", _POSIX_LLM_LAUNCHER, True),\n162\t    (\"benny-llm.cmd\", _WINDOWS_LLM_LAUNCHER, False),\n163\t    (\"benny-neo4j\", _POSIX_NEO4J_LAUNCHER, True),\n164\t    (\"benny-neo4j.cmd\", _WINDOWS_NEO4J_LAUNCHER, False),\n165\t    (\"benny-mcp\", _POSIX_LAUNCHER, True),  # mcp variant resolved in _seed_launchers\n166\t    (\"benny-mcp.cmd\", _WINDOWS_LAUNCHER, False),\n167\t)\n168\t\n169\t# Declarative compose manifest for the `app` profile (PBR-001 §4.3).\n170\t# Kept minimal and generic — the image tags are placeholders the app-profile\n171\t# builder pins at release time. Paths use relative-to-$BENNY_HOME forms only.\n172\t_COMPOSE_YML = \"\"\"# Portable Benny — profile=app stack (see PBR-001 §4.3).\n173\t# This file is seeded on `benny init --profile app`. Paths MUST stay relative\n174\t# to the enclosing $BENNY_HOME; absolute host paths are rejected by SR-1.\n175\tversion: \"3.9\"\n176\t\n177\tservices:\n178\t  neo4j:\n179\t    image: neo4j:5.20-community\n180\t    environment:\n181\t      NEO4J_AUTH: \"neo4j/benny_local\"\n182\t    ports:\n183\t      - \"7474:7474\"\n184\t      - \"7687:7687\"\n185\t    volumes:\n186\t      - ../data/graph:/data\n187\t      - ../logs:/logs\n188\t\n189\t  api:\n190\t    image: benny-api:latest\n191\t    depends_on:\n192\t      - neo4j\n193\t    environment:\n194\t      BENNY_HOME: /benny-home\n195\t      NEO4J_URI: bolt://neo4j:7687\n196\t    ports:\n197\t      - \"8000:8000\"\n198\t    volumes:\n199\t      - ../:/benny-home\n200\t\n201\t  ui:\n202\t    image: benny-ui:latest\n203\t    depends_on:\n204\t      - api\n205\t    ports:\n206\t      - \"5173:5173\"\n207\t\"\"\"\n208\t\n209\t\n210\tclass PortableHomeError(RuntimeError):\n211\t    \"\"\"Raised on illegal portable-home state transitions.\"\"\"\n212\t\n213\t\n214\t@dataclasses.dataclass(frozen=True)\n215\tclass BennyHome:\n216\t    root: Path\n217\t    profile: Profile\n218\t\n219\t    @property\n220\t    def bin_dir(self) -> Path:\n221\t        return self.root / \"bin\"\n222\t\n223\t    @property\n224\t    def config_dir(self) -> Path:\n225\t        return self.root / \"config\"\n226\t\n227\t    @property\n228\t    def data_dir(self) -> Path:\n229\t        return self.root / \"data\"\n230\t\n231\t    @property\n232\t    def workspaces_dir(self) -> Path:\n233\t        return self.root / \"workspaces\"\n234\t\n235\t    @property\n236\t    def models_dir(self) -> Path:\n237\t        return self.root / \"models\"\n238\t\n239\t    @property\n240\t    def state_dir(self) -> Path:\n241\t        return self.root / \"state\"\n242\t\n243\t    @property\n244\t    def profile_subtree(self) -> Path:\n245\t        return self.root / (\"app\" if self.profile == \"app\" else \"runtime\")\n246\t\n247\t\n248\t@dataclasses.dataclass(frozen=True)\n249\tclass ValidationReport:\n250\t    ok: bool\n251\t    problems: tuple[str, ...]\n252\t\n253\t\n254\t# ---- internals -------------------------------------------------------------\n255\t\n256\t\n257\tdef _expected_dirs(profile: Profile) -> Iterable[str]:\n258\t    yield from SHARED_DIRS\n259\t    yield from (APP_DIRS if profile == \"app\" else NATIVE_DIRS)\n260\t\n261\t\n262\tdef _read_existing_profile(root: Path) -> Profile | None:\n263\t    lock = root / \"state\" / \"profile-lock\"\n264\t    if not lock.is_file():\n265\t        return None\n266\t    value = lock.read_text(encoding=\"utf-8\").strip()\n267\t    if value not in (\"app\", \"native\"):\n268\t        return None\n269\t    return value  # type: ignore[return-value]\n270\t\n271\t\n272\tdef _seed_state(root: Path, profile: Profile) -> None:\n273\t    state = root / \"state\"\n274\t    state.mkdir(parents=True, exist_ok=True)\n275\t\n276\t    device_id_path = state / \"device-id\"\n277\t    if not device_id_path.is_file():\n278\t        device_id_path.write_text(str(uuid.uuid4()), encoding=\"utf-8\")\n279\t\n280\t    # Per-install HMAC signing key (PBR-001 §4.1 state). Generated once, like the\n281\t    # device-id, and never overwritten — so view/pin/.aamp signatures are tied to\n282\t    # THIS install instead of the shared dev fallback in views_signing /\n283\t    # agentamp.signing. 32 bytes → 64 hex chars, the form BENNY_HMAC_KEY expects.\n284\t    hmac_key_file = state / \"hmac-key\"\n285\t    if not hmac_key_file.is_file():\n286\t        hmac_key_file.write_text(secrets.token_hex(32), encoding=\"utf-8\")\n287\t\n288\t    (state / \"schema-version\").write_text(SCHEMA_VERSION, encoding=\"utf-8\")\n289\t    (state / \"profile-lock\").write_text(profile, encoding=\"utf-8\")\n290\t\n291\t\n292\tdef _seed_launchers(root: Path, python_exe: str) -> None:\n293\t    \"\"\"Write portable launcher scripts into ``<root>/bin/``.\n294\t\n295\t    ``python_exe`` is the absolute path to the interpreter that ran\n296\t    ``benny init``; it is embedded directly in each launcher so that the\n297\t    correct venv Python is always used regardless of PATH.\n298\t\n299\t    On POSIX we also chmod +x; on Windows the .cmd extension is what\n300\t    makes scripts runnable.\n301\t    \"\"\"\n302\t    import os\n303\t    import stat\n304\t\n305\t    bin_dir = root / \"bin\"\n306\t    bin_dir.mkdir(parents=True, exist_ok=True)\n307\t\n308\t    # Normalise path separators for cross-platform embedding.\n309\t    py = python_exe.replace(\"\\\\\", \"/\")\n310\t\n311\t    for name, template, executable in _LAUNCHERS:\n312\t        if name in (\"benny-mcp\", \"benny-mcp.cmd\"):\n313\t            # MCP variant: swap the module invocation.\n314\t            if name.endswith(\".cmd\"):\n315\t                content = template.format(python_exe=py).replace(\n316\t                    \"-m benny_cli\", \"-m benny.mcp.server --stdio\"\n317\t                )\n318\t            else:\n319\t                content = template.format(python_exe=py).replace(\n320\t                    'benny_cli \"$@\"', 'benny.mcp.server --stdio \"$@\"'\n321\t                )\n322\t        else:\n323\t            content = template.format(python_exe=py)\n324\t\n325\t        path = bin_dir / name\n326\t        path.write_text(content, encoding=\"utf-8\")\n327\t        if executable and os.name == \"posix\":\n328\t            mode = path.stat().st_mode\n329\t            path.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n330\t\n331\t    # Record the Python path so `benny doctor` can verify it later.\n332\t    (root / \"state\").mkdir(parents=True, exist_ok=True)\n333\t    (root / \"state\" / \"python-path\").write_text(python_exe, encoding=\"utf-8\")\n334\t\n335\t\n336\tdef _seed_app_compose(root: Path) -> None:\n337\t    \"\"\"Seed ``<root>/app/compose.yml`` for the `app` profile only.\"\"\"\n338\t    compose = root / \"app\" / \"compose.yml\"\n339\t    compose.parent.mkdir(parents=True, exist_ok=True)\n340\t    if not compose.is_file():\n341\t        compose.write_text(_COMPOSE_YML, encoding=\"utf-8\")\n342\t\n343\t\n344\tdef _seed_config(root: Path, profile: Profile) -> None:\n345\t    config = root / \"config\"\n346\t    config.mkdir(parents=True, exist_ok=True)\n347\t\n348\t    toml_path = config / \"benny.toml\"\n349\t    if not toml_path.is_file():\n350\t        toml_path.write_text(\n351\t            _BENNY_TOML_TEMPLATE.format(schema_version=SCHEMA_VERSION, profile=profile),\n352\t            encoding=\"utf-8\",\n353\t        )\n354\t\n355\t    (config / \"profile\").write_text(profile, encoding=\"utf-8\")\n356\t\n357\t    voices_path = config / \"voices.json\"\n358\t    if not voices_path.is_file():\n359\t        voices_path.write_text(_VOICES_JSON, encoding=\"utf-8\")\n360\t\n361\t    allow_path = config / \"server_ops_allowlist.json\"\n362\t    if not allow_path.is_file():\n363\t        allow_path.write_text(_SERVER_OPS_ALLOWLIST_JSON, encoding=\"utf-8\")\n364\t\n365\t\n366\t# ---- home resolution (mirror of packaging/desktop/home_resolver.js) ---------\n367\t#\n368\t# One declared Prime-Silo home; $BENNY_HOME derives from it as <root>/benny.\n369\t# Precedence for the effective Benny home (highest wins):\n370\t#   1. BENNY_HOME env                      → source \"env-override\"\n371\t#   2. bennyHome in prime-silo-config.json → source \"legacy-config\"\n372\t#   3. PRIME_SILO_HOME env or homeDir in prime-silo-config.json → <root>/benny\n373\t#   4. pre-unification per-user default (<userData>/benny-home), if it exists\n374\t#   5. derived from the per-user default root\n375\t# There is deliberately NO repo-relative fallback: nothing may silently write\n376\t# into a git checkout (that is how run debris ended up committed pre-Phase-0).\n377\t\n378\t_CONFIG_DIR_NAME = \"Prime-Silo\"\n379\t_CONFIG_FILENAME = \"prime-silo-config.json\"\n380\t_DEFAULT_HOME_DIRNAME = \"prime-silo-home\"\n381\t_LEGACY_BENNY_DIRNAME = \"benny-home\"\n382\t\n383\t\n384\tdef _user_data_path(env: dict | None = None) -> Path:\n385\t    env = os.environ if env is None else env\n386\t    if sys.platform == \"win32\":\n387\t        base = env.get(\"APPDATA\") or str(Path.home() / \"AppData\" / \"Roaming\")\n388\t    elif sys.platform == \"darwin\":\n389\t        base = str(Path.home() / \"Library\" / \"Application Support\")\n390\t    else:\n391\t        base = env.get(\"XDG_CONFIG_HOME\") or str(Path.home() / \".config\")\n392\t    return Path(base) / _CONFIG_DIR_NAME\n393\t\n394\t\n395\tdef _read_desktop_config(env: dict | None = None) -> dict:\n396\t    \"\"\"Best-effort read of the shared desktop config; absent/broken → {}.\"\"\"\n397\t    import json\n398\t\n399\t    try:\n400\t        raw = (_user_data_path(env) / _CONFIG_FILENAME).read_text(encoding=\"utf-8\")\n401\t        value = json.loads(raw)\n402\t        return value if isinstance(value, dict) else {}\n403\t    except (OSError, ValueError):\n404\t        return {}\n405\t\n406\t\n407\t@dataclasses.dataclass(frozen=True)\n408\tclass ResolvedHome:\n409\t    root: Path  # the declared Prime-Silo home\n410\t    source: str  # \"env\" | \"config\" | \"default\"\n411\t    benny_home: Path  # effective $BENNY_HOME\n412\t    benny_home_source: str  # \"env-override\" | \"legacy-config\" | \"legacy-default\" | \"derived\"\n413\t    warnings: tuple[str, ...]\n414\t\n415\t\n416\tdef resolve_home(env: dict | None = None) -> ResolvedHome:\n417\t    env = os.environ if env is None else env\n418\t    config = _read_desktop_config(env)\n419\t    user_data = _user_data_path(env)\n420\t    warnings: list[str] = []\n421\t\n422\t    env_root = str(env.get(\"PRIME_SILO_HOME\") or \"\").strip()\n423\t    config_root = str(config.get(\"homeDir\") or \"\").strip()\n424\t    if env_root:\n425\t        root, source = Path(env_root).resolve(), \"env\"\n426\t    elif config_root:\n427\t        root, source = Path(config_root).resolve(), \"config\"\n428\t    else:\n429\t        root, source = user_data / _DEFAULT_HOME_DIRNAME, \"default\"\n430\t\n431\t    env_benny = str(env.get(\"BENNY_HOME\") or \"\").strip()\n432\t    config_benny = str(config.get(\"bennyHome\") or \"\").strip()\n433\t    legacy_default = user_data / _LEGACY_BENNY_DIRNAME\n434\t    if env_benny:\n435\t        benny_home, benny_source = Path(env_benny).resolve(), \"env-override\"\n436\t        try:\n437\t            benny_home.relative_to(root)\n438\t        except ValueError:\n439\t            warnings.append(\n440\t                f\"BENNY_HOME env override ({benny_home}) points outside the declared home ({root}).\"\n441\t            )\n442\t    elif config_benny:\n443\t        benny_home, benny_source = Path(config_benny).resolve(), \"legacy-config\"\n444\t        warnings.append(\n445\t            f'Benny home comes from the legacy config key \"bennyHome\" ({benny_home}); '\n446\t            f\"adopt the unified home to derive it from {root}.\"\n447\t        )\n448\t    elif source == \"default\" and legacy_default.is_dir():\n449\t        benny_home, benny_source = legacy_default, \"legacy-default\"\n450\t        warnings.append(\n451\t            f\"Benny home uses the pre-unification default ({benny_home}); \"\n452\t            f\"adopt the unified home to move it under {root}.\"\n453\t        )\n454\t    else:\n455\t        benny_home, benny_source = root / \"benny\", \"derived\"\n456\t\n457\t    return ResolvedHome(\n458\t        root=root,\n459\t        source=source,\n460\t        benny_home=benny_home,\n461\t        benny_home_source=benny_source,\n462\t        warnings=tuple(warnings),\n463\t    )\n464\t\n465\t\n466\tdef resolve_benny_home(env: dict | None = None) -> Path:\n467\t    \"\"\"The effective ``$BENNY_HOME`` — the single call sites should use instead\n468\t    of reading the env var (with a repo-relative fallback) themselves.\"\"\"\n469\t    return resolve_home(env).benny_home\n470\t\n471\t\n472\t# ---- public API ------------------------------------------------------------\n473\t\n474\t\n475\tdef init(root: Path, *, profile: Profile) -> BennyHome:\n476\t    \"\"\"Create or refresh a portable $BENNY_HOME. Idempotent within a profile.\n477\t\n478\t    Raises ``PortableHomeError`` if the root was previously initialised with\n479\t    a different profile (cross-profile switching is handled by a future\n480\t    `benny migrate`, not init).\n481\t    \"\"\"\n482\t    if profile not in (\"app\", \"native\"):\n483\t        raise PortableHomeError(f\"unknown profile: {profile!r}\")\n484\t\n485\t    root = Path(root)\n486\t    existing = _read_existing_profile(root)\n487\t    if existing is not None and existing != profile:\n488\t        raise PortableHomeError(\n489\t            f\"profile mismatch: $BENNY_HOME at {root} was initialised as \"\n490\t            f\"{existing!r}; refusing to switch to {profile!r}. \"\n491\t            \"Use `benny migrate` for cross-profile changes.\"\n492\t        )\n493\t\n494\t    for rel in _expected_dirs(profile):\n495\t        (root / rel).mkdir(parents=True, exist_ok=True)\n496\t\n497\t    # Everything init seeds lives under $BENNY_HOME — never the project checkout.\n498\t    # The repo-root benny.bat / benny.sh are static, committed wrappers.\n499\t    python_exe = sys.executable\n500\t    _seed_state(root, profile)\n501\t    _seed_config(root, profile)\n502\t    _seed_launchers(root, python_exe)\n503\t    if profile == \"app\":\n504\t        _seed_app_compose(root)\n505\t\n506\t    return BennyHome(root=root, profile=profile)\n507\t\n508\t\n509\tdef hmac_key_path(root: Path) -> Path:\n510\t    \"\"\"Location of the per-install HMAC signing key under ``$BENNY_HOME``.\"\"\"\n511\t    return Path(root) / \"state\" / \"hmac-key\"\n512\t\n513\t\n514\tdef read_install_hmac_key(root: Path) -> str | None:\n515\t    \"\"\"Return the per-install HMAC key (hex string) for ``root``, or ``None`` if\n516\t    this home was never initialised / the file is missing or empty.\"\"\"\n517\t    try:\n518\t        value = hmac_key_path(root).read_text(encoding=\"utf-8\").strip()\n519\t    except OSError:\n520\t        return None\n521\t    return value or None\n522\t\n523\t\n524\tdef install_hmac_key_bytes_from_env_home() -> bytes | None:\n525\t    \"\"\"Resolve the per-install key bytes from the ``$BENNY_HOME`` in the\n526\t    environment. The shared fallback for the signing resolvers (views_signing,\n527\t    agentamp.signing): they consult this before the non-production dev key, so\n528\t    every entry point — booted server, CLI, tests — signs with the install key\n529\t    once ``benny init`` has generated it. Returns ``None`` when ``$BENNY_HOME``\n530\t    is unset, uninitialised, or the stored value isn't valid hex.\"\"\"\n531\t    root = os.environ.get(\"BENNY_HOME\")\n532\t    if not root:\n533\t        return None\n534\t    value = read_install_hmac_key(Path(root))\n535\t    if not value:\n536\t        return None\n537\t    try:\n538\t        return bytes.fromhex(value)\n539\t    except ValueError:\n540\t        return None\n541\t\n542\t\n543\tdef ensure_hmac_key_in_env(root: Path) -> str | None:\n544\t    \"\"\"Export the per-install key to ``BENNY_HMAC_KEY`` if it isn't already set,\n545\t    so subprocesses inherit it too. An explicit env value always wins. Returns\n546\t    the effective key (hex), or ``None`` if none could be resolved.\"\"\"\n547\t    existing = os.environ.get(\"BENNY_HMAC_KEY\")\n548\t    if existing:\n549\t        return existing\n550\t    value = read_install_hmac_key(Path(root))\n551\t    if value:\n552\t        os.environ[\"BENNY_HMAC_KEY\"] = value\n553\t    return value\n554\t\n555\t\n556\tdef validate(root: Path) -> ValidationReport:\n557\t    \"\"\"FR-1 structural check. Returns a report; never raises for missing dirs.\"\"\"\n558\t    root = Path(root)\n559\t    problems: list[str] = []\n560\t\n561\t    profile = _read_existing_profile(root)\n562\t    if profile is None:\n563\t        return ValidationReport(ok=False, problems=(\"state/profile-lock missing or invalid\",))\n564\t\n565\t    for rel in _expected_dirs(profile):\n566\t        if not (root / rel).is_dir():\n567\t            problems.append(f\"missing directory: {rel}\")\n568\t\n569\t    for rel in (\"state/device-id\", \"state/schema-version\", \"config/benny.toml\", \"config/profile\"):\n570\t        if not (root / rel).is_file():\n571\t            problems.append(f\"missing file: {rel}\")\n572\t\n573\t    # Mutually-exclusive subtree invariant.\n574\t    if profile == \"app\" and (root / \"runtime\").exists():\n575\t        problems.append(\"profile=app but runtime/ exists\")\n576\t    if profile == \"native\" and (root / \"app\").exists():\n577\t        problems.append(\"profile=native but app/ exists\")\n578\t\n579\t    return ValidationReport(ok=not problems, problems=tuple(problems))\n580\t\n581\t\n582\tdef uninstall(root: Path, *, keep_data: bool) -> None:\n583\t    \"\"\"Remove the app/runtime boundary. With ``keep_data=True``, workspaces,\n584\t    models, data, config, and state survive — only the disposable app layer\n585\t    is removed. With ``keep_data=False``, the entire tree is deleted.\n586\t    \"\"\"\n587\t    root = Path(root)\n588\t    if not root.exists():\n589\t        return\n590\t\n591\t    if not keep_data:\n592\t        shutil.rmtree(root)\n593\t        return\n594\t\n595\t    for rel in APP_DIRS + NATIVE_DIRS:\n596\t        victim = root / rel\n597\t        if victim.exists():\n598\t            shutil.rmtree(victim)\n599\t    # `bin/` is part of the app layer under both profiles — remove it too,\n600\t    # it will be re-seeded on the next init.\n601\t    bin_dir = root / \"bin\"\n602\t    if bin_dir.exists():\n603\t        shutil.rmtree(bin_dir)\n604\t    # Profile-lock stays: the user's intent (app vs native) is preserved\n605\t    # across reinstall.\n606\t"}]},"uuid":"4f928847-512d-460b-a080-2358e814ac56","timestamp":"2026-07-23T13:06:59.223Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\portable\\home.py","content":"\"\"\"`$BENNY_HOME` layout, init, validate, and uninstall.\n\nThis module is the single authority for what a portable Benny install looks\nlike on disk. The layout is declared once, at the top, and every other piece\nof the system resolves paths through a ``BennyHome`` instance.\n\nSee PBR-001 §4.1 for the declared shape.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport dataclasses\nimport os\nimport secrets\nimport shutil\nimport sys\nimport uuid\nfrom pathlib import Path\nfrom typing import Iterable, Literal\n\nProfile = Literal[\"app\", \"native\"]\n\nSCHEMA_VERSION = \"1.0.0\"\n\n# Shared layout — present under both profiles.\nSHARED_DIRS: tuple[str, ...] = (\n    \"bin\",\n    \"config\",\n    \"data\",\n    \"data/runs\",\n    \"data/lineage\",\n    \"data/vector\",\n    \"data/graph\",\n    \"workspaces\",\n    \"models\",\n    \"logs\",\n    \"tmp\",\n    \"state\",\n)\n\n# Profile-specific subtrees — mutually exclusive.\nAPP_DIRS: tuple[str, ...] = (\"app\",)\nNATIVE_DIRS: tuple[str, ...] = (\"runtime\", \"runtime/python\", \"runtime/node\", \"runtime/neo4j\")\n\n# Config files seeded on fresh init.\n_BENNY_TOML_TEMPLATE = \"\"\"# Portable Benny config (see PBR-001 §4.1).\n# Paths declared here MUST be either relative or under this $BENNY_HOME root.\nschema_version = \"{schema_version}\"\nprofile = \"{profile}\"\n\n[runtime]\n# Port assignments match benny/core/models.py LOCAL_PROVIDERS defaults.\nlemonade_port = 13305\nneo4j_bolt_port = 7687\nneo4j_http_port = 7474\napi_port = 8000\nui_port = 5173\n\"\"\"\n\n_VOICES_JSON = \"\"\"{\n  \"_comment\": \"TTS voice registry; closes the hardcoded af_sky gap (PBR-001 §4.4).\",\n  \"providers\": {\n    \"lemonade\": {\n      \"voices\": [\"af_sky\", \"bf_emma\", \"bm_george\", \"af_bella\"],\n      \"default\": \"af_sky\"\n    }\n  }\n}\n\"\"\"\n\n_SERVER_OPS_ALLOWLIST_JSON = \"\"\"{\n  \"_comment\": \"Allow-listed local-LLM server-ops targets (LC-2 scope).\",\n  \"commands\": [\"status\", \"health\", \"start\", \"stop\"],\n  \"services\": [\"lemonade\", \"ollama\", \"fastflowlm\", \"neo4j\", \"marquez\"]\n}\n\"\"\"\n\n# Portable launcher scripts (PBR-001 §4.3). Each launcher derives $BENNY_HOME\n# from its own location so the SSD can be mounted at any drive letter or path.\n# {python_exe} is substituted at seed time with the absolute path to the\n# interpreter that ran `benny init`, ensuring launchers always use the venv.\n_POSIX_LAUNCHER = \"\"\"#!/usr/bin/env sh\n# Portable Benny launcher (POSIX). Self-locates $BENNY_HOME.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nexec {python_exe} -m benny_cli \"$@\"\n\"\"\"\n\n_WINDOWS_LAUNCHER = \"\"\"@echo off\nrem Portable Benny launcher (Windows). Self-locates %%BENNY_HOME%%.\nrem Python path pinned to the venv that ran `benny init` — do not edit by hand;\nrem re-run `benny init` if you recreate the venv.\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\n\"{python_exe}\" -m benny_cli %*\n\"\"\"\n\n_POSIX_UI_LAUNCHER = \"\"\"#!/usr/bin/env sh\n# Starts the UI dev server.  Checks BENNY_FRONTEND_DIR first (dev installs),\n# then $BENNY_HOME/app/ui (packaged installs), then $BENNY_HOME.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nif [ -n \"$BENNY_FRONTEND_DIR\" ] && [ -d \"$BENNY_FRONTEND_DIR\" ]; then\n    cd \"$BENNY_FRONTEND_DIR\"\nelif [ -d \"$BENNY_HOME/app/ui\" ]; then\n    cd \"$BENNY_HOME/app/ui\"\nelse\n    cd \"$BENNY_HOME\"\nfi\nexec npm run dev -- \"$@\"\n\"\"\"\n\n_WINDOWS_UI_LAUNCHER = \"\"\"@echo off\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\nif defined BENNY_FRONTEND_DIR (\n    cd /d \"%BENNY_FRONTEND_DIR%\"\n) else if exist \"%BENNY_HOME%\\\\app\\\\ui\" (\n    cd /d \"%BENNY_HOME%\\\\app\\\\ui\"\n) else (\n    cd /d \"%BENNY_HOME%\"\n)\nnpm run dev -- %*\n\"\"\"\n\n_POSIX_LLM_LAUNCHER = \"\"\"#!/usr/bin/env sh\n# Starts the local LLM runtime (Lemonade). Placeholder until the bundled\n# binary is side-loaded under models/ or app/; for now defers to PATH.\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nexec lemonade-server \"$@\"\n\"\"\"\n\n_WINDOWS_LLM_LAUNCHER = \"\"\"@echo off\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\nLemonadeServer.exe %*\n\"\"\"\n\n_POSIX_NEO4J_LAUNCHER = \"\"\"#!/usr/bin/env sh\nset -e\nSCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\nexport BENNY_HOME=\"$(cd \"$SCRIPT_DIR/..\" && pwd)\"\nexec neo4j \"$@\"\n\"\"\"\n\n_WINDOWS_NEO4J_LAUNCHER = \"\"\"@echo off\nset \"SCRIPT_DIR=%~dp0\"\nfor %%I in (\"%SCRIPT_DIR%..\") do set \"BENNY_HOME=%%~fI\"\nneo4j.bat %*\n\"\"\"\n\n_LAUNCHERS: tuple[tuple[str, str, bool], ...] = (\n    (\"benny\", _POSIX_LAUNCHER, True),\n    (\"benny.cmd\", _WINDOWS_LAUNCHER, False),\n    (\"benny-ui\", _POSIX_UI_LAUNCHER, True),\n    (\"benny-ui.cmd\", _WINDOWS_UI_LAUNCHER, False),\n    (\"benny-llm\", _POSIX_LLM_LAUNCHER, True),\n    (\"benny-llm.cmd\", _WINDOWS_LLM_LAUNCHER, False),\n    (\"benny-neo4j\", _POSIX_NEO4J_LAUNCHER, True),\n    (\"benny-neo4j.cmd\", _WINDOWS_NEO4J_LAUNCHER, False),\n    (\"benny-mcp\", _POSIX_LAUNCHER, True),  # mcp variant resolved in _seed_launchers\n    (\"benny-mcp.cmd\", _WINDOWS_LAUNCHER, False),\n)\n\n# Declarative compose manifest for the `app` profile (PBR-001 §4.3).\n# Kept minimal and generic — the image tags are placeholders the app-profile\n# builder pins at release time. Paths use relative-to-$BENNY_HOME forms only.\n_COMPOSE_YML = \"\"\"# Portable Benny — profile=app stack (see PBR-001 §4.3).\n# This file is seeded on `benny init --profile app`. Paths MUST stay relative\n# to the enclosing $BENNY_HOME; absolute host paths are rejected by SR-1.\nversion: \"3.9\"\n\nservices:\n  neo4j:\n    image: neo4j:5.20-community\n    environment:\n      NEO4J_AUTH: \"neo4j/benny_local\"\n    ports:\n      - \"7474:7474\"\n      - \"7687:7687\"\n    volumes:\n      - ../data/graph:/data\n      - ../logs:/logs\n\n  api:\n    image: benny-api:latest\n    depends_on:\n      - neo4j\n    environment:\n      BENNY_HOME: /benny-home\n      NEO4J_URI: bolt://neo4j:7687\n    ports:\n      - \"8000:8000\"\n    volumes:\n      - ../:/benny-home\n\n  ui:\n    image: benny-ui:latest\n    depends_on:\n      - api\n    ports:\n      - \"5173:5173\"\n\"\"\"\n\n\nclass PortableHomeError(RuntimeError):\n    \"\"\"Raised on illegal portable-home state transitions.\"\"\"\n\n\n@dataclasses.dataclass(frozen=True)\nclass BennyHome:\n    root: Path\n    profile: Profile\n\n    @property\n    def bin_dir(self) -> Path:\n        return self.root / \"bin\"\n\n    @property\n    def config_dir(self) -> Path:\n        return self.root / \"config\"\n\n    @property\n    def data_dir(self) -> Path:\n        return self.root / \"data\"\n\n    @property\n    def workspaces_dir(self) -> Path:\n        return self.root / \"workspaces\"\n\n    @property\n    def models_dir(self) -> Path:\n        return self.root / \"models\"\n\n    @property\n    def state_dir(self) -> Path:\n        return self.root / \"state\"\n\n    @property\n    def profile_subtree(self) -> Path:\n        return self.root / (\"app\" if self.profile == \"app\" else \"runtime\")\n\n\n@dataclasses.dataclass(frozen=True)\nclass ValidationReport:\n    ok: bool\n    problems: tuple[str, ...]\n\n\n# ---- internals -------------------------------------------------------------\n\n\ndef _expected_dirs(profile: Profile) -> Iterable[str]:\n    yield from SHARED_DIRS\n    yield from (APP_DIRS if profile == \"app\" else NATIVE_DIRS)\n\n\ndef _read_existing_profile(root: Path) -> Profile | None:\n    lock = root / \"state\" / \"profile-lock\"\n    if not lock.is_file():\n        return None\n    value = lock.read_text(encoding=\"utf-8\").strip()\n    if value not in (\"app\", \"native\"):\n        return None\n    return value  # type: ignore[return-value]\n\n\ndef _seed_state(root: Path, profile: Profile) -> None:\n    state = root / \"state\"\n    state.mkdir(parents=True, exist_ok=True)\n\n    device_id_path = state / \"device-id\"\n    if not device_id_path.is_file():\n        device_id_path.write_text(str(uuid.uuid4()), encoding=\"utf-8\")\n\n    # Per-install HMAC signing key (PBR-001 §4.1 state). Generated once, like the\n    # device-id, and never overwritten — so view/pin/.aamp signatures are tied to\n    # THIS install instead of the shared dev fallback in views_signing /\n    # agentamp.signing. 32 bytes → 64 hex chars, the form BENNY_HMAC_KEY expects.\n    hmac_key_file = state / \"hmac-key\"\n    if not hmac_key_file.is_file():\n        hmac_key_file.write_text(secrets.token_hex(32), encoding=\"utf-8\")\n\n    (state / \"schema-version\").write_text(SCHEMA_VERSION, encoding=\"utf-8\")\n    (state / \"profile-lock\").write_text(profile, encoding=\"utf-8\")\n\n\ndef _seed_launchers(root: Path, python_exe: str) -> None:\n    \"\"\"Write portable launcher scripts into ``<root>/bin/``.\n\n    ``python_exe`` is the absolute path to the interpreter that ran\n    ``benny init``; it is embedded directly in each launcher so that the\n    correct venv Python is always used regardless of PATH.\n\n    On POSIX we also chmod +x; on Windows the .cmd extension is what\n    makes scripts runnable.\n    \"\"\"\n    import os\n    import stat\n\n    bin_dir = root / \"bin\"\n    bin_dir.mkdir(parents=True, exist_ok=True)\n\n    # Normalise path separators for cross-platform embedding.\n    py = python_exe.replace(\"\\\\\", \"/\")\n\n    for name, template, executable in _LAUNCHERS:\n        if name in (\"benny-mcp\", \"benny-mcp.cmd\"):\n            # MCP variant: swap the module invocation.\n            if name.endswith(\".cmd\"):\n                content = template.format(python_exe=py).replace(\n                    \"-m benny_cli\", \"-m benny.mcp.server --stdio\"\n                )\n            else:\n                content = template.format(python_exe=py).replace(\n                    'benny_cli \"$@\"', 'benny.mcp.server --stdio \"$@\"'\n                )\n        else:\n            content = template.format(python_exe=py)\n\n        path = bin_dir / name\n        path.write_text(content, encoding=\"utf-8\")\n        if executable and os.name == \"posix\":\n            mode = path.stat().st_mode\n            path.chmod(mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)\n\n    # Record the Python path so `benny doctor` can verify it later.\n    (root / \"state\").mkdir(parents=True, exist_ok=True)\n    (root / \"state\" / \"python-path\").write_text(python_exe, encoding=\"utf-8\")\n\n\ndef _seed_app_compose(root: Path) -> None:\n    \"\"\"Seed ``<root>/app/compose.yml`` for the `app` profile only.\"\"\"\n    compose = root / \"app\" / \"compose.yml\"\n    compose.parent.mkdir(parents=True, exist_ok=True)\n    if not compose.is_file():\n        compose.write_text(_COMPOSE_YML, encoding=\"utf-8\")\n\n\ndef _seed_config(root: Path, profile: Profile) -> None:\n    config = root / \"config\"\n    config.mkdir(parents=True, exist_ok=True)\n\n    toml_path = config / \"benny.toml\"\n    if not toml_path.is_file():\n        toml_path.write_text(\n            _BENNY_TOML_TEMPLATE.format(schema_version=SCHEMA_VERSION, profile=profile),\n            encoding=\"utf-8\",\n        )\n\n    (config / \"profile\").write_text(profile, encoding=\"utf-8\")\n\n    voices_path = config / \"voices.json\"\n    if not voices_path.is_file():\n        voices_path.write_text(_VOICES_JSON, encoding=\"utf-8\")\n\n    allow_path = config / \"server_ops_allowlist.json\"\n    if not allow_path.is_file():\n        allow_path.write_text(_SERVER_OPS_ALLOWLIST_JSON, encoding=\"utf-8\")\n\n\n# ---- home resolution (mirror of packaging/desktop/home_resolver.js) ---------\n#\n# One declared Prime-Silo home; $BENNY_HOME derives from it as <root>/benny.\n# Precedence for the effective Benny home (highest wins):\n#   1. BENNY_HOME env                      → source \"env-override\"\n#   2. bennyHome in prime-silo-config.json → source \"legacy-config\"\n#   3. PRIME_SILO_HOME env or homeDir in prime-silo-config.json → <root>/benny\n#   4. pre-unification per-user default (<userData>/benny-home), if it exists\n#   5. derived from the per-user default root\n# There is deliberately NO repo-relative fallback: nothing may silently write\n# into a git checkout (that is how run debris ended up committed pre-Phase-0).\n\n_CONFIG_DIR_NAME = \"Prime-Silo\"\n_CONFIG_FILENAME = \"prime-silo-config.json\"\n_DEFAULT_HOME_DIRNAME = \"prime-silo-home\"\n_LEGACY_BENNY_DIRNAME = \"benny-home\"\n\n\ndef _user_data_path(env: dict | None = None) -> Path:\n    env = os.environ if env is None else env\n    if sys.platform == \"win32\":\n        base = env.get(\"APPDATA\") or str(Path.home() / \"AppData\" / \"Roaming\")\n    elif sys.platform == \"darwin\":\n        base = str(Path.home() / \"Library\" / \"Application Support\")\n    else:\n        base = env.get(\"XDG_CONFIG_HOME\") or str(Path.home() / \".config\")\n    return Path(base) / _CONFIG_DIR_NAME\n\n\ndef _read_desktop_config(env: dict | None = None) -> dict:\n    \"\"\"Best-effort read of the shared desktop config; absent/broken → {}.\"\"\"\n    import json\n\n    try:\n        raw = (_user_data_path(env) / _CONFIG_FILENAME).read_text(encoding=\"utf-8\")\n        value = json.loads(raw)\n        return value if isinstance(value, dict) else {}\n    except (OSError, ValueError):\n        return {}\n\n\n@dataclasses.dataclass(frozen=True)\nclass ResolvedHome:\n    root: Path  # the declared Prime-Silo home\n    source: str  # \"env\" | \"config\" | \"default\"\n    benny_home: Path  # effective $BENNY_HOME\n    benny_home_source: str  # \"env-override\" | \"legacy-config\" | \"legacy-default\" | \"derived\"\n    warnings: tuple[str, ...]\n\n\ndef resolve_home(env: dict | None = None) -> ResolvedHome:\n    env = os.environ if env is None else env\n    config = _read_desktop_config(env)\n    user_data = _user_data_path(env)\n    warnings: list[str] = []\n\n    env_root = str(env.get(\"PRIME_SILO_HOME\") or \"\").strip()\n    config_root = str(config.get(\"homeDir\") or \"\").strip()\n    if env_root:\n        root, source = Path(env_root).resolve(), \"env\"\n    elif config_root:\n        root, source = Path(config_root).resolve(), \"config\"\n    else:\n        root, source = user_data / _DEFAULT_HOME_DIRNAME, \"default\"\n\n    env_benny = str(env.get(\"BENNY_HOME\") or \"\").strip()\n    config_benny = str(config.get(\"bennyHome\") or \"\").strip()\n    legacy_default = user_data / _LEGACY_BENNY_DIRNAME\n    if env_benny:\n        benny_home, benny_source = Path(env_benny).resolve(), \"env-override\"\n        try:\n            benny_home.relative_to(root)\n        except ValueError:\n            warnings.append(\n                f\"BENNY_HOME env override ({benny_home}) points outside the declared home ({root}).\"\n            )\n    elif config_benny:\n        benny_home, benny_source = Path(config_benny).resolve(), \"legacy-config\"\n        warnings.append(\n            f'Benny home comes from the legacy config key \"bennyHome\" ({benny_home}); '\n            f\"adopt the unified home to derive it from {root}.\"\n        )\n    elif source == \"default\" and legacy_default.is_dir():\n        benny_home, benny_source = legacy_default, \"legacy-default\"\n        warnings.append(\n            f\"Benny home uses the pre-unification default ({benny_home}); \"\n            f\"adopt the unified home to move it under {root}.\"\n        )\n    else:\n        benny_home, benny_source = root / \"benny\", \"derived\"\n\n    return ResolvedHome(\n        root=root,\n        source=source,\n        benny_home=benny_home,\n        benny_home_source=benny_source,\n        warnings=tuple(warnings),\n    )\n\n\ndef resolve_benny_home(env: dict | None = None) -> Path:\n    \"\"\"The effective ``$BENNY_HOME`` — the single call sites should use instead\n    of reading the env var (with a repo-relative fallback) themselves.\"\"\"\n    return resolve_home(env).benny_home\n\n\n# ---- public API ------------------------------------------------------------\n\n\ndef init(root: Path, *, profile: Profile) -> BennyHome:\n    \"\"\"Create or refresh a portable $BENNY_HOME. Idempotent within a profile.\n\n    Raises ``PortableHomeError`` if the root was previously initialised with\n    a different profile (cross-profile switching is handled by a future\n    `benny migrate`, not init).\n    \"\"\"\n    if profile not in (\"app\", \"native\"):\n        raise PortableHomeError(f\"unknown profile: {profile!r}\")\n\n    root = Path(root)\n    existing = _read_existing_profile(root)\n    if existing is not None and existing != profile:\n        raise PortableHomeError(\n            f\"profile mismatch: $BENNY_HOME at {root} was initialised as \"\n            f\"{existing!r}; refusing to switch to {profile!r}. \"\n            \"Use `benny migrate` for cross-profile changes.\"\n        )\n\n    for rel in _expected_dirs(profile):\n        (root / rel).mkdir(parents=True, exist_ok=True)\n\n    # Everything init seeds lives under $BENNY_HOME — never the project checkout.\n    # The repo-root benny.bat / benny.sh are static, committed wrappers.\n    python_exe = sys.executable\n    _seed_state(root, profile)\n    _seed_config(root, profile)\n    _seed_launchers(root, python_exe)\n    if profile == \"app\":\n        _seed_app_compose(root)\n\n    return BennyHome(root=root, profile=profile)\n\n\ndef hmac_key_path(root: Path) -> Path:\n    \"\"\"Location of the per-install HMAC signing key under ``$BENNY_HOME``.\"\"\"\n    return Path(root) / \"state\" / \"hmac-key\"\n\n\ndef read_install_hmac_key(root: Path) -> str | None:\n    \"\"\"Return the per-install HMAC key (hex string) for ``root``, or ``None`` if\n    this home was never initialised / the file is missing or empty.\"\"\"\n    try:\n        value = hmac_key_path(root).read_text(encoding=\"utf-8\").strip()\n    except OSError:\n        return None\n    return value or None\n\n\ndef install_hmac_key_bytes_from_env_home() -> bytes | None:\n    \"\"\"Resolve the per-install key bytes from the ``$BENNY_HOME`` in the\n    environment. The shared fallback for the signing resolvers (views_signing,\n    agentamp.signing): they consult this before the non-production dev key, so\n    every entry point — booted server, CLI, tests — signs with the install key\n    once ``benny init`` has generated it. Returns ``None`` when ``$BENNY_HOME``\n    is unset, uninitialised, or the stored value isn't valid hex.\"\"\"\n    root = os.environ.get(\"BENNY_HOME\")\n    if not root:\n        return None\n    value = read_install_hmac_key(Path(root))\n    if not value:\n        return None\n    try:\n        return bytes.fromhex(value)\n    except ValueError:\n        return None\n\n\ndef ensure_hmac_key_in_env(root: Path) -> str | None:\n    \"\"\"Export the per-install key to ``BENNY_HMAC_KEY`` if it isn't already set,\n    so subprocesses inherit it too. An explicit env value always wins. Returns\n    the effective key (hex), or ``None`` if none could be resolved.\"\"\"\n    existing = os.environ.get(\"BENNY_HMAC_KEY\")\n    if existing:\n        return existing\n    value = read_install_hmac_key(Path(root))\n    if value:\n        os.environ[\"BENNY_HMAC_KEY\"] = value\n    return value\n\n\ndef validate(root: Path) -> ValidationReport:\n    \"\"\"FR-1 structural check. Returns a report; never raises for missing dirs.\"\"\"\n    root = Path(root)\n    problems: list[str] = []\n\n    profile = _read_existing_profile(root)\n    if profile is None:\n        return ValidationReport(ok=False, problems=(\"state/profile-lock missing or invalid\",))\n\n    for rel in _expected_dirs(profile):\n        if not (root / rel).is_dir():\n            problems.append(f\"missing directory: {rel}\")\n\n    for rel in (\"state/device-id\", \"state/schema-version\", \"config/benny.toml\", \"config/profile\"):\n        if not (root / rel).is_file():\n            problems.append(f\"missing file: {rel}\")\n\n    # Mutually-exclusive subtree invariant.\n    if profile == \"app\" and (root / \"runtime\").exists():\n        problems.append(\"profile=app but runtime/ exists\")\n    if profile == \"native\" and (root / \"app\").exists():\n        problems.append(\"profile=native but app/ exists\")\n\n    return ValidationReport(ok=not problems, problems=tuple(problems))\n\n\ndef uninstall(root: Path, *, keep_data: bool) -> None:\n    \"\"\"Remove the app/runtime boundary. With ``keep_data=True``, workspaces,\n    models, data, config, and state survive — only the disposable app layer\n    is removed. With ``keep_data=False``, the entire tree is deleted.\n    \"\"\"\n    root = Path(root)\n    if not root.exists():\n        return\n\n    if not keep_data:\n        shutil.rmtree(root)\n        return\n\n    for rel in APP_DIRS + NATIVE_DIRS:\n        victim = root / rel\n        if victim.exists():\n            shutil.rmtree(victim)\n    # `bin/` is part of the app layer under both profiles — remove it too,\n    # it will be re-seeded on the next init.\n    bin_dir = root / \"bin\"\n    if bin_dir.exists():\n        shutil.rmtree(bin_dir)\n    # Profile-lock stays: the user's intent (app vs native) is preserved\n    # across reinstall.\n","numLines":606,"startLine":1,"totalLines":606}},"sourceToolAssistantUUID":"20ce8d58-d50b-47a5-855b-8b403d475519","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"61a9f7a2-1353-4f19-addd-895289cb8f19","version":"2.1.217","gitBranch":"HEAD"}
