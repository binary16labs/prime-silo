{"parentUuid":"7c6e35d5-c4f3-4d2b-a41e-e4704b824a7b","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_016XbQkG96wPZY9TuTPy8u8n","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LZ7hF8mk488qxfzeAvMbZu","name":"Read","input":{"file_path":"prime-silo\\runtime\\benny\\core\\docmodel.py"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2921,"cache_read_input_tokens":62398,"output_tokens":184,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2921,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":184,"cache_read_input_tokens":62398,"cache_creation_input_tokens":2921,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2921},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcXPofhqURHhsRpipnA1J","type":"assistant","uuid":"1d5efb54-ecd6-49c8-a105-f7e84b070c26","timestamp":"2026-06-29T10:28:59.092Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"eb427ad4-8c1e-494a-b563-fd2879a365fa","version":"2.1.187","gitBranch":"HEAD"}
{"parentUuid":"1d5efb54-ecd6-49c8-a105-f7e84b070c26","isSidechain":false,"promptId":"2c396758-3082-4aa5-8b6d-cf9d2bf6d0a3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LZ7hF8mk488qxfzeAvMbZu","type":"tool_result","content":"1\t\"\"\"\n2\tDocModel — structured document extraction (VIS-001 / ADR-003 Phase 0).\n3\t\n4\tParses a document into Docling's element tree, preserving per-element **type**,\n5\t**page**, **bbox** and **reading order**; exports tables to **JSON**; persists a\n6\t**crop** per picture keyed by content-hash; and writes a\n7\t``workspace/.benny/docmodel/<source>.json`` artifact. **No VLM** runs here — this\n8\tis the visually-complete substrate the vision describer ladder (Phase 2) and the\n9\tPageIndex spine (ADR-002) consume.\n10\t\n11\tThis replaces the early-flatten in ``core/extraction.py`` for the vision path:\n12\tinstead of throwing figures/tables away into markdown, every element survives\n13\twith provenance. The default ingest path is untouched (VIS-F5) — this is a\n14\tseparate entry point gated behind the ``vision`` ingest flag.\n15\t\n16\tThe Docling-dependent extraction is intentionally thin; the transformation logic\n17\t(hashing, bbox/table serialization, traversal guard) is pure and unit-tested\n18\toffline (VIS-NFR1).\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\timport datetime\n24\timport hashlib\n25\timport json\n26\timport logging\n27\timport re\n28\timport statistics\n29\tfrom pathlib import Path\n30\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n31\t\n32\tfrom .workspace import get_workspace_path\n33\t\n34\tlogger = logging.getLogger(__name__)\n35\t\n36\tDOCMODEL_SCHEMA = \"prime-silo.docmodel/1\"\n37\tDOCMODEL_SUBDIR = \".benny/docmodel\"\n38\t\n39\t# Element types that carry a visual crop worth describing later (Phase 2).\n40\tVISUAL_LABELS = {\"picture\", \"chart\"}\n41\t\n42\t\n43\t# =============================================================================\n44\t# PURE HELPERS (no Docling, no I/O — unit-tested offline)\n45\t# =============================================================================\n46\t\n47\t\n48\tdef _short_hash(*parts: Any, length: int = 16) -> str:\n49\t    \"\"\"Stable short sha256 over the string form of the given parts.\"\"\"\n50\t    h = hashlib.sha256(\"\\x1f\".join(\"\" if p is None else str(p) for p in parts).encode(\"utf-8\"))\n51\t    return h.hexdigest()[:length]\n52\t\n53\t\n54\tdef _safe_stem(name: str) -> str:\n55\t    \"\"\"Filesystem-safe stem for a source name — strips any path/traversal and\n56\t    keeps only ``[A-Za-z0-9._-]`` (VIS-SEC2 belt-and-braces over the\n57\t    workspace-path guard).\"\"\"\n58\t    stem = Path(str(name)).stem\n59\t    stem = re.sub(r\"[^A-Za-z0-9._-]\", \"_\", stem)\n60\t    stem = stem.strip(\"._\") or \"doc\"\n61\t    return stem\n62\t\n63\t\n64\tdef _bbox_to_dict(bbox: Any) -> Optional[Dict[str, Any]]:\n65\t    \"\"\"Normalize a Docling BoundingBox to a plain dict, or None.\"\"\"\n66\t    if bbox is None:\n67\t        return None\n68\t    try:\n69\t        origin = getattr(bbox, \"coord_origin\", None)\n70\t        return {\n71\t            \"l\": float(bbox.l),\n72\t            \"t\": float(bbox.t),\n73\t            \"r\": float(bbox.r),\n74\t            \"b\": float(bbox.b),\n75\t            \"coord_origin\": getattr(origin, \"value\", str(origin)) if origin is not None else None,\n76\t        }\n77\t    except Exception:\n78\t        return None\n79\t\n80\t\n81\tdef _df_to_table_json(df: Any) -> Dict[str, Any]:\n82\t    \"\"\"Convert a pandas DataFrame (from ``TableItem.export_to_dataframe``) into a\n83\t    JSON-serializable structured table: column names + rows + shape. NaN → None.\"\"\"\n84\t    columns = [str(c) for c in df.columns]\n85\t    # astype(object) FIRST so the None replacement sticks — on a float column\n86\t    # ``where(..., None)`` re-casts None back to NaN (not JSON-safe). Object dtype\n87\t    # keeps None, giving valid JSON with no NaN tokens.\n88\t    safe = df.astype(object).where(df.notna(), None)\n89\t    rows = safe.values.tolist()\n90\t    return {\n91\t        \"columns\": columns,\n92\t        \"rows\": rows,\n93\t        \"n_rows\": int(df.shape[0]),\n94\t        \"n_cols\": int(df.shape[1]),\n95\t    }\n96\t\n97\t\n98\tdef _element_id(\n99\t    reading_order: int,\n100\t    label: str,\n101\t    page: Any,\n102\t    bbox: Optional[Dict[str, Any]],\n103\t    text: Optional[str],\n104\t    self_ref: Any,\n105\t) -> str:\n106\t    \"\"\"Stable per-element id. Uses structural coordinates (order/type/page/bbox)\n107\t    plus a text/self_ref discriminator so re-extracting the same document yields\n108\t    the same ids (idempotent crop keys, stable provenance).\"\"\"\n109\t    bbox_key = None if bbox is None else (bbox[\"l\"], bbox[\"t\"], bbox[\"r\"], bbox[\"b\"])\n110\t    return _short_hash(reading_order, label, page, bbox_key, (text or \"\")[:80], self_ref)\n111\t\n112\t\n113\t# =============================================================================\n114\t# DOCLING-DEPENDENT EXTRACTION\n115\t# =============================================================================\n116\t\n117\t\n118\tdef _docmodel_dir(workspace: str) -> Path:\n119\t    return get_workspace_path(workspace, DOCMODEL_SUBDIR)\n120\t\n121\t\n122\tdef _is_fresh(json_path: Path, source_path: Path) -> bool:\n123\t    \"\"\"True if the docmodel json exists, is non-empty, and is at least as new as\n124\t    the source — the same idempotency guard ``promote_staged_files`` uses.\"\"\"\n125\t    return (\n126\t        json_path.exists()\n127\t        and json_path.stat().st_size > 0\n128\t        and json_path.stat().st_mtime >= source_path.stat().st_mtime\n129\t    )\n130\t\n131\t\n132\tdef _build_converter(do_ocr: bool, images_scale: float, emit_crops: bool):\n133\t    \"\"\"Construct a Docling converter configured for structured extraction.\n134\t\n135\t    ``generate_page_images`` is what makes per-picture crops available via\n136\t    ``PictureItem.get_image(doc)`` (the non-deprecated path in docling 2.107).\n137\t    ``do_table_structure`` powers ``export_to_dataframe`` → table JSON.\n138\t    \"\"\"\n139\t    from docling.backend.pypdfium2_backend import PyPdfiumDocumentBackend\n140\t    from docling.datamodel.base_models import InputFormat\n141\t    from docling.datamodel.pipeline_options import PdfPipelineOptions\n142\t    from docling.document_converter import DocumentConverter, PdfFormatOption\n143\t\n144\t    opts = PdfPipelineOptions()\n145\t    opts.do_ocr = do_ocr\n146\t    opts.do_table_structure = True\n147\t    opts.generate_page_images = emit_crops\n148\t    opts.images_scale = images_scale\n149\t\n150\t    return DocumentConverter(\n151\t        format_options={\n152\t            InputFormat.PDF: PdfFormatOption(pipeline_options=opts, backend=PyPdfiumDocumentBackend)\n153\t        }\n154\t    )\n155\t\n156\t\n157\tdef build_docmodel(\n158\t    file_path: Path,\n159\t    workspace: str = \"default\",\n160\t    *,\n161\t    backend: str = \"pymupdf\",\n162\t    do_ocr: bool = False,\n163\t    images_scale: float = 2.0,\n164\t    emit_crops: bool = True,\n165\t    force: bool = False,\n166\t    log_fn: Callable = print,\n167\t) -> Dict[str, Any]:\n168\t    \"\"\"Build (or reuse) the DocModel for ``file_path``.\n169\t\n170\t    ``backend``:\n171\t      - ``\"pymupdf\"`` (default) — lean, fully offline, no torch / no model download.\n172\t        Figure crops via ``extract_image``, tables via ``find_tables``, text in\n173\t        reading order with font-size heading heuristics. Ships in the runtime bundle.\n174\t      - ``\"docling\"`` — higher-accuracy ML layout/table models (torch/transformers,\n175\t        fetches HF weights on first use). Opt-in; not bundled. Install ``docling``.\n176\t\n177\t    Idempotent: returns the cached ``<stem>.json`` when it is at least as new as the\n178\t    source unless ``force``. On any backend error, falls back to a text-only DocModel\n179\t    (flagged ``degraded``) so the pipeline still has something to ingest — graceful\n180\t    degradation, never silent success.\n181\t    \"\"\"\n182\t    file_path = Path(file_path)\n183\t    stem = _safe_stem(file_path.name)\n184\t    out_dir = _docmodel_dir(workspace)\n185\t    out_dir.mkdir(parents=True, exist_ok=True)\n186\t    json_path = out_dir / f\"{stem}.json\"\n187\t\n188\t    if not force and file_path.exists() and _is_fresh(json_path, file_path):\n189\t        log_fn(f\"[docmodel] reusing fresh {json_path.name}\")\n190\t        return json.loads(json_path.read_text(encoding=\"utf-8\"))\n191\t\n192\t    crops_dir = out_dir / \"crops\" / stem\n193\t\n194\t    try:\n195\t        if backend == \"docling\":\n196\t            model = _extract_with_docling(\n197\t                file_path,\n198\t                workspace,\n199\t                out_dir,\n200\t                crops_dir,\n201\t                stem,\n202\t                do_ocr=do_ocr,\n203\t                images_scale=images_scale,\n204\t                emit_crops=emit_crops,\n205\t                log_fn=log_fn,\n206\t            )\n207\t        else:\n208\t            model = _extract_with_pymupdf(\n209\t                file_path,\n210\t                workspace,\n211\t                crops_dir,\n212\t                stem,\n213\t                emit_crops=emit_crops,\n214\t                log_fn=log_fn,\n215\t            )\n216\t    except ImportError as e:\n217\t        log_fn(\n218\t            f\"[docmodel] {backend} backend unavailable ({e}); text-only fallback for {file_path.name}\"\n219\t        )\n220\t        model = _fallback_textonly(file_path, stem, reason=f\"{backend}-import:{e}\", log_fn=log_fn)\n221\t    except Exception as e:\n222\t        log_fn(\n223\t            f\"[docmodel] {backend} extraction failed for {file_path.name}: {e}; text-only fallback\"\n224\t        )\n225\t        model = _fallback_textonly(file_path, stem, reason=f\"{backend}-error:{e}\", log_fn=log_fn)\n226\t\n227\t    json_path.write_text(json.dumps(model, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n228\t    log_fn(\n229\t        f\"[docmodel] wrote {json_path.name} [{backend}]: {len(model['elements'])} elements \"\n230\t        f\"({model['counts']})\"\n231\t    )\n232\t    return model\n233\t\n234\t\n235\t# =============================================================================\n236\t# PyMuPDF BACKEND (default — lean, offline, no torch / no model download)\n237\t# =============================================================================\n238\t\n239\t\n240\tdef _bbox_tuple_to_dict(t: Tuple[float, float, float, float]) -> Dict[str, Any]:\n241\t    return {\n242\t        \"l\": float(t[0]),\n243\t        \"t\": float(t[1]),\n244\t        \"r\": float(t[2]),\n245\t        \"b\": float(t[3]),\n246\t        \"coord_origin\": \"TOPLEFT\",\n247\t    }\n248\t\n249\t\n250\tdef _rows_to_table_json(rows: List[List[Any]]) -> Dict[str, Any]:\n251\t    \"\"\"Convert ``TableFinder.extract()`` rows (list of cell-string rows) to the same\n252\t    table JSON shape the Docling path emits. First row = header.\"\"\"\n253\t    rows = [r for r in rows if r is not None]\n254\t    if not rows:\n255\t        return {\"columns\": [], \"rows\": [], \"n_rows\": 0, \"n_cols\": 0}\n256\t    header = [\"\" if c is None else str(c) for c in rows[0]]\n257\t    body = [[None if c is None else c for c in r] for r in rows[1:]]\n258\t    return {\"columns\": header, \"rows\": body, \"n_rows\": len(body), \"n_cols\": len(header)}\n259\t\n260\t\n261\tdef _looks_like_table(rows: List[List[Any]]) -> bool:\n262\t    \"\"\"Light sanity filter for RULED-line tables (high precision already): ≥2 rows,\n263\t    ≥2 cols, ≥50% cells non-empty. (We deliberately do NOT use PyMuPDF's\n264\t    text-alignment strategy — it shatters prose into fake columns and would\n265\t    suppress real body text. Borderless tables stay as text under this backend;\n266\t    use backend='docling' when structured borderless tables matter.)\"\"\"\n267\t    if len(rows) < 2:\n268\t        return False\n269\t    ncols = max((len(r) for r in rows), default=0)\n270\t    if ncols < 2:\n271\t        return False\n272\t    cells = [c for r in rows for c in r]\n273\t    nonempty = sum(1 for c in cells if c not in (None, \"\"))\n274\t    return bool(cells) and nonempty / len(cells) >= 0.5\n275\t\n276\t\n277\tdef _rect_mostly_inside(outer: Tuple, inner: Tuple, frac: float = 0.6) -> bool:\n278\t    ix0, iy0 = max(outer[0], inner[0]), max(outer[1], inner[1])\n279\t    ix1, iy1 = min(outer[2], inner[2]), min(outer[3], inner[3])\n280\t    inter = max(0.0, ix1 - ix0) * max(0.0, iy1 - iy0)\n281\t    area = max(1e-6, (inner[2] - inner[0]) * (inner[3] - inner[1]))\n282\t    return inter / area >= frac\n283\t\n284\t\n285\tdef _classify_text_block(text: str, max_size: float, median_size: float, page_no: int) -> str:\n286\t    s = text.strip()\n287\t    low = s.lower()\n288\t    if re.match(r\"^(figure|fig\\.|table)\\s*\\d\", low):\n289\t        return \"caption\"\n290\t    if re.match(r\"^\\s*([•▪●■–\\-\\*]|\\d+\\.|\\(?[a-z]\\))\\s+\", s):\n291\t        return \"list_item\"\n292\t    short = len(s) <= 120 and s.count(\"\\n\") == 0\n293\t    if short and max_size >= median_size * 1.8 and page_no == 1:\n294\t        return \"title\"\n295\t    if short and max_size >= median_size * 1.18:\n296\t        return \"section_header\"\n297\t    return \"text\"\n298\t\n299\t\n300\tdef _extract_with_pymupdf(\n301\t    file_path: Path,\n302\t    workspace: str,\n303\t    crops_dir: Path,\n304\t    stem: str,\n305\t    *,\n306\t    emit_crops: bool,\n307\t    log_fn: Callable,\n308\t) -> Dict[str, Any]:\n309\t    ext = file_path.suffix.lower()\n310\t    # Plain text needs no PyMuPDF — handle before importing fitz so a text ingest\n311\t    # works even where PyMuPDF isn't installed.\n312\t    if ext in (\".txt\", \".md\"):\n313\t        text = file_path.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n314\t        els = (\n315\t            [\n316\t                {\n317\t                    \"id\": _element_id(0, \"text\", None, None, text, None),\n318\t                    \"reading_order\": 0,\n319\t                    \"type\": \"text\",\n320\t                    \"page\": None,\n321\t                    \"bbox\": None,\n322\t                    \"self_ref\": None,\n323\t                    \"text\": text,\n324\t                }\n325\t            ]\n326\t            if text\n327\t            else []\n328\t        )\n329\t        return _model_envelope(\n330\t            file_path, workspace, \"pymupdf\", n_pages=None, counts={\"text\": len(els)}, elements=els\n331\t        )\n332\t    if ext != \".pdf\":\n333\t        # docx/pptx/html aren't well served by PyMuPDF — use backend=\"docling\" for those.\n334\t        raise NotImplementedError(\n335\t            f\"pymupdf backend handles .pdf/.txt/.md, not {ext} (use backend='docling')\"\n336\t        )\n337\t\n338\t    import fitz  # PyMuPDF\n339\t\n340\t    doc = fitz.open(str(file_path))\n341\t    elements: List[Dict[str, Any]] = []\n342\t    counts: Dict[str, int] = {}\n343\t    order = 0\n344\t\n345\t    for pno in range(doc.page_count):\n346\t        page = doc[pno]\n347\t        page_no = pno + 1\n348\t        td = page.get_text(\"dict\")\n349\t        sizes = [\n350\t            sp.get(\"size\", 0)\n351\t            for b in td[\"blocks\"]\n352\t            if b.get(\"type\", 0) == 0\n353\t            for ln in b.get(\"lines\", [])\n354\t            for sp in ln.get(\"spans\", [])\n355\t        ]\n356\t        median_size = statistics.median(sizes) if sizes else 10.0\n357\t\n358\t        items: List[Tuple[float, float, Dict[str, Any]]] = []  # (y0, x0, partial)\n359\t\n360\t        # 1. tables — RULED lines only (high precision, zero prose false positives).\n361\t        # Borderless tables intentionally fall through as text (see _looks_like_table).\n362\t        table_rects: List[Tuple] = []\n363\t        try:\n364\t            for t in page.find_tables().tables:\n365\t                rows = t.extract()\n366\t                if not _looks_like_table(rows):\n367\t                    continue\n368\t                bbox = tuple(t.bbox)\n369\t                table_rects.append(bbox)\n370\t                items.append(\n371\t                    (\n372\t                        bbox[1],\n373\t                        bbox[0],\n374\t                        {\"type\": \"table\", \"bbox\": bbox, \"table\": _rows_to_table_json(rows)},\n375\t                    )\n376\t                )\n377\t        except Exception as e:\n378\t            log_fn(f\"[docmodel] find_tables p{page_no} failed: {e}\")\n379\t\n380\t        # 2. figures (embedded raster images)\n381\t        img_rects: List[Tuple] = []\n382\t        if emit_crops:\n383\t            for info in page.get_image_info(xrefs=True):\n384\t                xref = info.get(\"xref\", 0)\n385\t                bbox = tuple(info.get(\"bbox\", (0, 0, 0, 0)))\n386\t                if xref <= 0 or (bbox[2] - bbox[0]) * (bbox[3] - bbox[1]) < 2500:\n387\t                    continue  # skip rules/icons/tiny marks\n388\t                img_rects.append(bbox)\n389\t                crop_rel = None\n390\t                try:\n391\t                    base = doc.extract_image(xref)\n392\t                    data = base[\"image\"]\n393\t                    digest = hashlib.sha256(data).hexdigest()[:16]\n394\t                    crops_dir.mkdir(parents=True, exist_ok=True)\n395\t                    cp = crops_dir / f\"{digest}.{base.get('ext', 'png')}\"\n396\t                    if not cp.exists():\n397\t                        cp.write_bytes(data)\n398\t                    crop_rel = str(cp.relative_to(get_workspace_path(workspace))).replace(\"\\\\\", \"/\")\n399\t                except Exception as e:\n400\t                    log_fn(f\"[docmodel] image xref {xref} extract failed: {e}\")\n401\t                items.append(\n402\t                    (bbox[1], bbox[0], {\"type\": \"picture\", \"bbox\": bbox, \"crop\": crop_rel})\n403\t                )\n404\t\n405\t        # 3. text blocks (skip those inside a table or figure region)\n406\t        for b in td[\"blocks\"]:\n407\t            if b.get(\"type\", 0) != 0:\n408\t                continue\n409\t            bbox = tuple(b[\"bbox\"])\n410\t            if any(_rect_mostly_inside(r, bbox) for r in table_rects + img_rects):\n411\t                continue\n412\t            lines = [\n413\t                \" \".join(sp.get(\"text\", \"\") for sp in ln.get(\"spans\", [])).strip()\n414\t                for ln in b.get(\"lines\", [])\n415\t            ]\n416\t            text = \" \".join(ln for ln in lines if ln).strip()\n417\t            if not text:\n418\t                continue\n419\t            max_size = max(\n420\t                (sp.get(\"size\", 0) for ln in b.get(\"lines\", []) for sp in ln.get(\"spans\", [])),\n421\t                default=median_size,\n422\t            )\n423\t            items.append(\n424\t                (\n425\t                    bbox[1],\n426\t                    bbox[0],\n427\t                    {\n428\t                        \"type\": _classify_text_block(text, max_size, median_size, page_no),\n429\t                        \"bbox\": bbox,\n430\t                        \"text\": text,\n431\t                    },\n432\t                )\n433\t            )\n434\t\n435\t        # reading order: top-to-bottom, then left-to-right\n436\t        items.sort(key=lambda it: (round(it[0], 1), round(it[1], 1)))\n437\t        for _y, _x, d in items:\n438\t            label = d[\"type\"]\n439\t            counts[label] = counts.get(label, 0) + 1\n440\t            bbox_d = _bbox_tuple_to_dict(d[\"bbox\"])\n441\t            text = d.get(\"text\")\n442\t            el = {\n443\t                \"id\": _element_id(order, label, page_no, bbox_d, text, None),\n444\t                \"reading_order\": order,\n445\t                \"type\": label,\n446\t                \"page\": page_no,\n447\t                \"bbox\": bbox_d,\n448\t                \"self_ref\": None,\n449\t            }\n450\t            if text:\n451\t                el[\"text\"] = text\n452\t            if \"table\" in d:\n453\t                el[\"table\"] = d[\"table\"]\n454\t            if d.get(\"crop\"):\n455\t                el[\"crop\"] = d[\"crop\"]\n456\t            elements.append(el)\n457\t            order += 1\n458\t\n459\t    n_pages = doc.page_count\n460\t    doc.close()\n461\t    return _model_envelope(\n462\t        file_path, workspace, \"pymupdf\", n_pages=n_pages, counts=counts, elements=elements\n463\t    )\n464\t\n465\t\n466\tdef _model_envelope(\n467\t    file_path: Path, workspace: str, backend: str, *, n_pages, counts, elements\n468\t) -> Dict[str, Any]:\n469\t    return {\n470\t        \"schema\": DOCMODEL_SCHEMA,\n471\t        \"source\": file_path.name,\n472\t        \"workspace\": workspace,\n473\t        \"generated_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n474\t        \"backend\": backend,\n475\t        \"docling_version\": _safe_version(\"docling\") if backend == \"docling\" else None,\n476\t        \"n_pages\": n_pages,\n477\t        \"degraded\": False,\n478\t        \"counts\": counts,\n479\t        \"elements\": elements,\n480\t    }\n481\t\n482\t\n483\t# =============================================================================\n484\t# DOCLING BACKEND (optional — higher accuracy, heavier)\n485\t# =============================================================================\n486\t\n487\t\n488\tdef _extract_with_docling(\n489\t    file_path: Path,\n490\t    workspace: str,\n491\t    out_dir: Path,\n492\t    crops_dir: Path,\n493\t    stem: str,\n494\t    *,\n495\t    do_ocr: bool,\n496\t    images_scale: float,\n497\t    emit_crops: bool,\n498\t    log_fn: Callable,\n499\t) -> Dict[str, Any]:\n500\t    from docling_core.types.doc import PictureItem, TableItem\n501\t\n502\t    converter = _build_converter(do_ocr, images_scale, emit_crops)\n503\t    result = converter.convert(str(file_path))\n504\t    doc = result.document\n505\t\n506\t    elements: List[Dict[str, Any]] = []\n507\t    counts: Dict[str, int] = {}\n508\t\n509\t    for idx, (item, _level) in enumerate(doc.iterate_items()):\n510\t        label = getattr(item, \"label\", None)\n511\t        label_val = getattr(label, \"value\", None) or \"unknown\"\n512\t        counts[label_val] = counts.get(label_val, 0) + 1\n513\t\n514\t        prov_list = getattr(item, \"prov\", None) or []\n515\t        prov = prov_list[0] if prov_list else None\n516\t        page = getattr(prov, \"page_no\", None) if prov else None\n517\t        bbox = _bbox_to_dict(getattr(prov, \"bbox\", None)) if prov else None\n518\t        text = getattr(item, \"text\", None) or None\n519\t        self_ref = getattr(item, \"self_ref\", None)\n520\t\n521\t        el: Dict[str, Any] = {\n522\t            \"id\": _element_id(idx, label_val, page, bbox, text, self_ref),\n523\t            \"reading_order\": idx,\n524\t            \"type\": label_val,\n525\t            \"page\": page,\n526\t            \"bbox\": bbox,\n527\t            \"self_ref\": self_ref,\n528\t        }\n529\t        if text:\n530\t            el[\"text\"] = text\n531\t\n532\t        # Tables → structured JSON (VIS-F2)\n533\t        if isinstance(item, TableItem):\n534\t            try:\n535\t                el[\"table\"] = _df_to_table_json(item.export_to_dataframe(doc))\n536\t            except Exception as e:\n537\t                log_fn(f\"[docmodel] table export failed at #{idx}: {e}\")\n538\t\n539\t        # Pictures/charts → content-addressed crop (VIS-F3)\n540\t        if emit_crops and isinstance(item, PictureItem):\n541\t            crop_rel = _save_crop(item, doc, crops_dir, workspace, log_fn)\n542\t            if crop_rel:\n543\t                el[\"crop\"] = crop_rel\n544\t\n545\t        elements.append(el)\n546\t\n547\t    return {\n548\t        \"schema\": DOCMODEL_SCHEMA,\n549\t        \"source\": file_path.name,\n550\t        \"workspace\": workspace,\n551\t        \"generated_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n552\t        \"docling_version\": _safe_version(\"docling\"),\n553\t        \"n_pages\": _num_pages(doc),\n554\t        \"degraded\": False,\n555\t        \"counts\": counts,\n556\t        \"elements\": elements,\n557\t    }\n558\t\n559\t\n560\tdef _save_crop(\n561\t    item: Any, doc: Any, crops_dir: Path, workspace: str, log_fn: Callable\n562\t) -> Optional[str]:\n563\t    \"\"\"Render a picture's crop to PNG keyed by image-bytes hash (so identical\n564\t    images dedupe across re-ingest). Returns the workspace-relative path or None.\"\"\"\n565\t    try:\n566\t        img = item.get_image(doc)\n567\t        if img is None:\n568\t            return None\n569\t        import io\n570\t\n571\t        buf = io.BytesIO()\n572\t        img.save(buf, format=\"PNG\")\n573\t        data = buf.getvalue()\n574\t        digest = hashlib.sha256(data).hexdigest()[:16]\n575\t        crops_dir.mkdir(parents=True, exist_ok=True)\n576\t        crop_path = crops_dir / f\"{digest}.png\"\n577\t        if not crop_path.exists():\n578\t            crop_path.write_bytes(data)\n579\t        ws_root = get_workspace_path(workspace)\n580\t        return str(crop_path.relative_to(ws_root)).replace(\"\\\\\", \"/\")\n581\t    except Exception as e:\n582\t        log_fn(f\"[docmodel] crop save failed: {e}\")\n583\t        return None\n584\t\n585\t\n586\tdef _fallback_textonly(\n587\t    file_path: Path, stem: str, *, reason: str, log_fn: Callable\n588\t) -> Dict[str, Any]:\n589\t    \"\"\"Produce a minimal text-only DocModel using basic extraction when Docling\n590\t    is unavailable/failed — keeps the pipeline alive without pretending the rich\n591\t    structure was extracted (``degraded`` flag + reason).\"\"\"\n592\t    text = \"\"\n593\t    try:\n594\t        from .extraction import _basic_extract\n595\t\n596\t        text = _basic_extract(file_path)\n597\t    except Exception as e:\n598\t        log_fn(f\"[docmodel] basic extraction also failed: {e}\")\n599\t\n600\t    elements = []\n601\t    if text.strip():\n602\t        elements.append(\n603\t            {\n604\t                \"id\": _element_id(0, \"text\", None, None, text, \"#/texts/0\"),\n605\t                \"reading_order\": 0,\n606\t                \"type\": \"text\",\n607\t                \"page\": None,\n608\t                \"bbox\": None,\n609\t                \"self_ref\": \"#/texts/0\",\n610\t                \"text\": text,\n611\t            }\n612\t        )\n613\t\n614\t    return {\n615\t        \"schema\": DOCMODEL_SCHEMA,\n616\t        \"source\": file_path.name,\n617\t        \"workspace\": None,\n618\t        \"generated_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n619\t        \"docling_version\": None,\n620\t        \"n_pages\": None,\n621\t        \"degraded\": True,\n622\t        \"degraded_reason\": reason,\n623\t        \"counts\": {\"text\": len(elements)},\n624\t        \"elements\": elements,\n625\t    }\n626\t\n627\t\n628\tdef _safe_version(pkg: str) -> Optional[str]:\n629\t    try:\n630\t        from importlib.metadata import version\n631\t\n632\t        return version(pkg)\n633\t    except Exception:\n634\t        return None\n635\t\n636\t\n637\tdef _num_pages(doc: Any) -> Optional[int]:\n638\t    try:\n639\t        n = doc.num_pages()\n640\t        return int(n)\n641\t    except Exception:\n642\t        try:\n643\t            return len(getattr(doc, \"pages\", {}) or {})\n644\t        except Exception:\n645\t            return None\n646\t"}]},"uuid":"9b370850-c406-4d25-af5f-2b3e8727297a","timestamp":"2026-06-29T10:28:59.101Z","toolUseResult":{"type":"text","file":{"filePath":"prime-silo\\runtime\\benny\\core\\docmodel.py","content":"\"\"\"\nDocModel — structured document extraction (VIS-001 / ADR-003 Phase 0).\n\nParses a document into Docling's element tree, preserving per-element **type**,\n**page**, **bbox** and **reading order**; exports tables to **JSON**; persists a\n**crop** per picture keyed by content-hash; and writes a\n``workspace/.benny/docmodel/<source>.json`` artifact. **No VLM** runs here — this\nis the visually-complete substrate the vision describer ladder (Phase 2) and the\nPageIndex spine (ADR-002) consume.\n\nThis replaces the early-flatten in ``core/extraction.py`` for the vision path:\ninstead of throwing figures/tables away into markdown, every element survives\nwith provenance. The default ingest path is untouched (VIS-F5) — this is a\nseparate entry point gated behind the ``vision`` ingest flag.\n\nThe Docling-dependent extraction is intentionally thin; the transformation logic\n(hashing, bbox/table serialization, traversal guard) is pure and unit-tested\noffline (VIS-NFR1).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport datetime\nimport hashlib\nimport json\nimport logging\nimport re\nimport statistics\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\nfrom .workspace import get_workspace_path\n\nlogger = logging.getLogger(__name__)\n\nDOCMODEL_SCHEMA = \"prime-silo.docmodel/1\"\nDOCMODEL_SUBDIR = \".benny/docmodel\"\n\n# Element types that carry a visual crop worth describing later (Phase 2).\nVISUAL_LABELS = {\"picture\", \"chart\"}\n\n\n# =============================================================================\n# PURE HELPERS (no Docling, no I/O — unit-tested offline)\n# =============================================================================\n\n\ndef _short_hash(*parts: Any, length: int = 16) -> str:\n    \"\"\"Stable short sha256 over the string form of the given parts.\"\"\"\n    h = hashlib.sha256(\"\\x1f\".join(\"\" if p is None else str(p) for p in parts).encode(\"utf-8\"))\n    return h.hexdigest()[:length]\n\n\ndef _safe_stem(name: str) -> str:\n    \"\"\"Filesystem-safe stem for a source name — strips any path/traversal and\n    keeps only ``[A-Za-z0-9._-]`` (VIS-SEC2 belt-and-braces over the\n    workspace-path guard).\"\"\"\n    stem = Path(str(name)).stem\n    stem = re.sub(r\"[^A-Za-z0-9._-]\", \"_\", stem)\n    stem = stem.strip(\"._\") or \"doc\"\n    return stem\n\n\ndef _bbox_to_dict(bbox: Any) -> Optional[Dict[str, Any]]:\n    \"\"\"Normalize a Docling BoundingBox to a plain dict, or None.\"\"\"\n    if bbox is None:\n        return None\n    try:\n        origin = getattr(bbox, \"coord_origin\", None)\n        return {\n            \"l\": float(bbox.l),\n            \"t\": float(bbox.t),\n            \"r\": float(bbox.r),\n            \"b\": float(bbox.b),\n            \"coord_origin\": getattr(origin, \"value\", str(origin)) if origin is not None else None,\n        }\n    except Exception:\n        return None\n\n\ndef _df_to_table_json(df: Any) -> Dict[str, Any]:\n    \"\"\"Convert a pandas DataFrame (from ``TableItem.export_to_dataframe``) into a\n    JSON-serializable structured table: column names + rows + shape. NaN → None.\"\"\"\n    columns = [str(c) for c in df.columns]\n    # astype(object) FIRST so the None replacement sticks — on a float column\n    # ``where(..., None)`` re-casts None back to NaN (not JSON-safe). Object dtype\n    # keeps None, giving valid JSON with no NaN tokens.\n    safe = df.astype(object).where(df.notna(), None)\n    rows = safe.values.tolist()\n    return {\n        \"columns\": columns,\n        \"rows\": rows,\n        \"n_rows\": int(df.shape[0]),\n        \"n_cols\": int(df.shape[1]),\n    }\n\n\ndef _element_id(\n    reading_order: int,\n    label: str,\n    page: Any,\n    bbox: Optional[Dict[str, Any]],\n    text: Optional[str],\n    self_ref: Any,\n) -> str:\n    \"\"\"Stable per-element id. Uses structural coordinates (order/type/page/bbox)\n    plus a text/self_ref discriminator so re-extracting the same document yields\n    the same ids (idempotent crop keys, stable provenance).\"\"\"\n    bbox_key = None if bbox is None else (bbox[\"l\"], bbox[\"t\"], bbox[\"r\"], bbox[\"b\"])\n    return _short_hash(reading_order, label, page, bbox_key, (text or \"\")[:80], self_ref)\n\n\n# =============================================================================\n# DOCLING-DEPENDENT EXTRACTION\n# =============================================================================\n\n\ndef _docmodel_dir(workspace: str) -> Path:\n    return get_workspace_path(workspace, DOCMODEL_SUBDIR)\n\n\ndef _is_fresh(json_path: Path, source_path: Path) -> bool:\n    \"\"\"True if the docmodel json exists, is non-empty, and is at least as new as\n    the source — the same idempotency guard ``promote_staged_files`` uses.\"\"\"\n    return (\n        json_path.exists()\n        and json_path.stat().st_size > 0\n        and json_path.stat().st_mtime >= source_path.stat().st_mtime\n    )\n\n\ndef _build_converter(do_ocr: bool, images_scale: float, emit_crops: bool):\n    \"\"\"Construct a Docling converter configured for structured extraction.\n\n    ``generate_page_images`` is what makes per-picture crops available via\n    ``PictureItem.get_image(doc)`` (the non-deprecated path in docling 2.107).\n    ``do_table_structure`` powers ``export_to_dataframe`` → table JSON.\n    \"\"\"\n    from docling.backend.pypdfium2_backend import PyPdfiumDocumentBackend\n    from docling.datamodel.base_models import InputFormat\n    from docling.datamodel.pipeline_options import PdfPipelineOptions\n    from docling.document_converter import DocumentConverter, PdfFormatOption\n\n    opts = PdfPipelineOptions()\n    opts.do_ocr = do_ocr\n    opts.do_table_structure = True\n    opts.generate_page_images = emit_crops\n    opts.images_scale = images_scale\n\n    return DocumentConverter(\n        format_options={\n            InputFormat.PDF: PdfFormatOption(pipeline_options=opts, backend=PyPdfiumDocumentBackend)\n        }\n    )\n\n\ndef build_docmodel(\n    file_path: Path,\n    workspace: str = \"default\",\n    *,\n    backend: str = \"pymupdf\",\n    do_ocr: bool = False,\n    images_scale: float = 2.0,\n    emit_crops: bool = True,\n    force: bool = False,\n    log_fn: Callable = print,\n) -> Dict[str, Any]:\n    \"\"\"Build (or reuse) the DocModel for ``file_path``.\n\n    ``backend``:\n      - ``\"pymupdf\"`` (default) — lean, fully offline, no torch / no model download.\n        Figure crops via ``extract_image``, tables via ``find_tables``, text in\n        reading order with font-size heading heuristics. Ships in the runtime bundle.\n      - ``\"docling\"`` — higher-accuracy ML layout/table models (torch/transformers,\n        fetches HF weights on first use). Opt-in; not bundled. Install ``docling``.\n\n    Idempotent: returns the cached ``<stem>.json`` when it is at least as new as the\n    source unless ``force``. On any backend error, falls back to a text-only DocModel\n    (flagged ``degraded``) so the pipeline still has something to ingest — graceful\n    degradation, never silent success.\n    \"\"\"\n    file_path = Path(file_path)\n    stem = _safe_stem(file_path.name)\n    out_dir = _docmodel_dir(workspace)\n    out_dir.mkdir(parents=True, exist_ok=True)\n    json_path = out_dir / f\"{stem}.json\"\n\n    if not force and file_path.exists() and _is_fresh(json_path, file_path):\n        log_fn(f\"[docmodel] reusing fresh {json_path.name}\")\n        return json.loads(json_path.read_text(encoding=\"utf-8\"))\n\n    crops_dir = out_dir / \"crops\" / stem\n\n    try:\n        if backend == \"docling\":\n            model = _extract_with_docling(\n                file_path,\n                workspace,\n                out_dir,\n                crops_dir,\n                stem,\n                do_ocr=do_ocr,\n                images_scale=images_scale,\n                emit_crops=emit_crops,\n                log_fn=log_fn,\n            )\n        else:\n            model = _extract_with_pymupdf(\n                file_path,\n                workspace,\n                crops_dir,\n                stem,\n                emit_crops=emit_crops,\n                log_fn=log_fn,\n            )\n    except ImportError as e:\n        log_fn(\n            f\"[docmodel] {backend} backend unavailable ({e}); text-only fallback for {file_path.name}\"\n        )\n        model = _fallback_textonly(file_path, stem, reason=f\"{backend}-import:{e}\", log_fn=log_fn)\n    except Exception as e:\n        log_fn(\n            f\"[docmodel] {backend} extraction failed for {file_path.name}: {e}; text-only fallback\"\n        )\n        model = _fallback_textonly(file_path, stem, reason=f\"{backend}-error:{e}\", log_fn=log_fn)\n\n    json_path.write_text(json.dumps(model, indent=2, ensure_ascii=False), encoding=\"utf-8\")\n    log_fn(\n        f\"[docmodel] wrote {json_path.name} [{backend}]: {len(model['elements'])} elements \"\n        f\"({model['counts']})\"\n    )\n    return model\n\n\n# =============================================================================\n# PyMuPDF BACKEND (default — lean, offline, no torch / no model download)\n# =============================================================================\n\n\ndef _bbox_tuple_to_dict(t: Tuple[float, float, float, float]) -> Dict[str, Any]:\n    return {\n        \"l\": float(t[0]),\n        \"t\": float(t[1]),\n        \"r\": float(t[2]),\n        \"b\": float(t[3]),\n        \"coord_origin\": \"TOPLEFT\",\n    }\n\n\ndef _rows_to_table_json(rows: List[List[Any]]) -> Dict[str, Any]:\n    \"\"\"Convert ``TableFinder.extract()`` rows (list of cell-string rows) to the same\n    table JSON shape the Docling path emits. First row = header.\"\"\"\n    rows = [r for r in rows if r is not None]\n    if not rows:\n        return {\"columns\": [], \"rows\": [], \"n_rows\": 0, \"n_cols\": 0}\n    header = [\"\" if c is None else str(c) for c in rows[0]]\n    body = [[None if c is None else c for c in r] for r in rows[1:]]\n    return {\"columns\": header, \"rows\": body, \"n_rows\": len(body), \"n_cols\": len(header)}\n\n\ndef _looks_like_table(rows: List[List[Any]]) -> bool:\n    \"\"\"Light sanity filter for RULED-line tables (high precision already): ≥2 rows,\n    ≥2 cols, ≥50% cells non-empty. (We deliberately do NOT use PyMuPDF's\n    text-alignment strategy — it shatters prose into fake columns and would\n    suppress real body text. Borderless tables stay as text under this backend;\n    use backend='docling' when structured borderless tables matter.)\"\"\"\n    if len(rows) < 2:\n        return False\n    ncols = max((len(r) for r in rows), default=0)\n    if ncols < 2:\n        return False\n    cells = [c for r in rows for c in r]\n    nonempty = sum(1 for c in cells if c not in (None, \"\"))\n    return bool(cells) and nonempty / len(cells) >= 0.5\n\n\ndef _rect_mostly_inside(outer: Tuple, inner: Tuple, frac: float = 0.6) -> bool:\n    ix0, iy0 = max(outer[0], inner[0]), max(outer[1], inner[1])\n    ix1, iy1 = min(outer[2], inner[2]), min(outer[3], inner[3])\n    inter = max(0.0, ix1 - ix0) * max(0.0, iy1 - iy0)\n    area = max(1e-6, (inner[2] - inner[0]) * (inner[3] - inner[1]))\n    return inter / area >= frac\n\n\ndef _classify_text_block(text: str, max_size: float, median_size: float, page_no: int) -> str:\n    s = text.strip()\n    low = s.lower()\n    if re.match(r\"^(figure|fig\\.|table)\\s*\\d\", low):\n        return \"caption\"\n    if re.match(r\"^\\s*([•▪●■–\\-\\*]|\\d+\\.|\\(?[a-z]\\))\\s+\", s):\n        return \"list_item\"\n    short = len(s) <= 120 and s.count(\"\\n\") == 0\n    if short and max_size >= median_size * 1.8 and page_no == 1:\n        return \"title\"\n    if short and max_size >= median_size * 1.18:\n        return \"section_header\"\n    return \"text\"\n\n\ndef _extract_with_pymupdf(\n    file_path: Path,\n    workspace: str,\n    crops_dir: Path,\n    stem: str,\n    *,\n    emit_crops: bool,\n    log_fn: Callable,\n) -> Dict[str, Any]:\n    ext = file_path.suffix.lower()\n    # Plain text needs no PyMuPDF — handle before importing fitz so a text ingest\n    # works even where PyMuPDF isn't installed.\n    if ext in (\".txt\", \".md\"):\n        text = file_path.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n        els = (\n            [\n                {\n                    \"id\": _element_id(0, \"text\", None, None, text, None),\n                    \"reading_order\": 0,\n                    \"type\": \"text\",\n                    \"page\": None,\n                    \"bbox\": None,\n                    \"self_ref\": None,\n                    \"text\": text,\n                }\n            ]\n            if text\n            else []\n        )\n        return _model_envelope(\n            file_path, workspace, \"pymupdf\", n_pages=None, counts={\"text\": len(els)}, elements=els\n        )\n    if ext != \".pdf\":\n        # docx/pptx/html aren't well served by PyMuPDF — use backend=\"docling\" for those.\n        raise NotImplementedError(\n            f\"pymupdf backend handles .pdf/.txt/.md, not {ext} (use backend='docling')\"\n        )\n\n    import fitz  # PyMuPDF\n\n    doc = fitz.open(str(file_path))\n    elements: List[Dict[str, Any]] = []\n    counts: Dict[str, int] = {}\n    order = 0\n\n    for pno in range(doc.page_count):\n        page = doc[pno]\n        page_no = pno + 1\n        td = page.get_text(\"dict\")\n        sizes = [\n            sp.get(\"size\", 0)\n            for b in td[\"blocks\"]\n            if b.get(\"type\", 0) == 0\n            for ln in b.get(\"lines\", [])\n            for sp in ln.get(\"spans\", [])\n        ]\n        median_size = statistics.median(sizes) if sizes else 10.0\n\n        items: List[Tuple[float, float, Dict[str, Any]]] = []  # (y0, x0, partial)\n\n        # 1. tables — RULED lines only (high precision, zero prose false positives).\n        # Borderless tables intentionally fall through as text (see _looks_like_table).\n        table_rects: List[Tuple] = []\n        try:\n            for t in page.find_tables().tables:\n                rows = t.extract()\n                if not _looks_like_table(rows):\n                    continue\n                bbox = tuple(t.bbox)\n                table_rects.append(bbox)\n                items.append(\n                    (\n                        bbox[1],\n                        bbox[0],\n                        {\"type\": \"table\", \"bbox\": bbox, \"table\": _rows_to_table_json(rows)},\n                    )\n                )\n        except Exception as e:\n            log_fn(f\"[docmodel] find_tables p{page_no} failed: {e}\")\n\n        # 2. figures (embedded raster images)\n        img_rects: List[Tuple] = []\n        if emit_crops:\n            for info in page.get_image_info(xrefs=True):\n                xref = info.get(\"xref\", 0)\n                bbox = tuple(info.get(\"bbox\", (0, 0, 0, 0)))\n                if xref <= 0 or (bbox[2] - bbox[0]) * (bbox[3] - bbox[1]) < 2500:\n                    continue  # skip rules/icons/tiny marks\n                img_rects.append(bbox)\n                crop_rel = None\n                try:\n                    base = doc.extract_image(xref)\n                    data = base[\"image\"]\n                    digest = hashlib.sha256(data).hexdigest()[:16]\n                    crops_dir.mkdir(parents=True, exist_ok=True)\n                    cp = crops_dir / f\"{digest}.{base.get('ext', 'png')}\"\n                    if not cp.exists():\n                        cp.write_bytes(data)\n                    crop_rel = str(cp.relative_to(get_workspace_path(workspace))).replace(\"\\\\\", \"/\")\n                except Exception as e:\n                    log_fn(f\"[docmodel] image xref {xref} extract failed: {e}\")\n                items.append(\n                    (bbox[1], bbox[0], {\"type\": \"picture\", \"bbox\": bbox, \"crop\": crop_rel})\n                )\n\n        # 3. text blocks (skip those inside a table or figure region)\n        for b in td[\"blocks\"]:\n            if b.get(\"type\", 0) != 0:\n                continue\n            bbox = tuple(b[\"bbox\"])\n            if any(_rect_mostly_inside(r, bbox) for r in table_rects + img_rects):\n                continue\n            lines = [\n                \" \".join(sp.get(\"text\", \"\") for sp in ln.get(\"spans\", [])).strip()\n                for ln in b.get(\"lines\", [])\n            ]\n            text = \" \".join(ln for ln in lines if ln).strip()\n            if not text:\n                continue\n            max_size = max(\n                (sp.get(\"size\", 0) for ln in b.get(\"lines\", []) for sp in ln.get(\"spans\", [])),\n                default=median_size,\n            )\n            items.append(\n                (\n                    bbox[1],\n                    bbox[0],\n                    {\n                        \"type\": _classify_text_block(text, max_size, median_size, page_no),\n                        \"bbox\": bbox,\n                        \"text\": text,\n                    },\n                )\n            )\n\n        # reading order: top-to-bottom, then left-to-right\n        items.sort(key=lambda it: (round(it[0], 1), round(it[1], 1)))\n        for _y, _x, d in items:\n            label = d[\"type\"]\n            counts[label] = counts.get(label, 0) + 1\n            bbox_d = _bbox_tuple_to_dict(d[\"bbox\"])\n            text = d.get(\"text\")\n            el = {\n                \"id\": _element_id(order, label, page_no, bbox_d, text, None),\n                \"reading_order\": order,\n                \"type\": label,\n                \"page\": page_no,\n                \"bbox\": bbox_d,\n                \"self_ref\": None,\n            }\n            if text:\n                el[\"text\"] = text\n            if \"table\" in d:\n                el[\"table\"] = d[\"table\"]\n            if d.get(\"crop\"):\n                el[\"crop\"] = d[\"crop\"]\n            elements.append(el)\n            order += 1\n\n    n_pages = doc.page_count\n    doc.close()\n    return _model_envelope(\n        file_path, workspace, \"pymupdf\", n_pages=n_pages, counts=counts, elements=elements\n    )\n\n\ndef _model_envelope(\n    file_path: Path, workspace: str, backend: str, *, n_pages, counts, elements\n) -> Dict[str, Any]:\n    return {\n        \"schema\": DOCMODEL_SCHEMA,\n        \"source\": file_path.name,\n        \"workspace\": workspace,\n        \"generated_at\": datetime.datetime.now(datetime.timezone.utc).isoformat(),\n        \"backend\": backend,\n        \"docling_version\": _safe_version(\"docling\") if backend == \"docling\" else None,\n        \"n_pages\": n_pages,\n        \"degraded\": False,\n        \"counts\": counts,\n        \"elements\": elements,\n    }\n\n\n# =============================================================================\n# DOCLING BACKEND (optional — higher accuracy, heavier)\n# =============================================================================\n\n\ndef _extract_with_docling(\n    file_path: Path,\n    workspace: str,\n    out_dir: Path,\n    crops_dir: Path,\n    stem: str,\n    *,\n    do_ocr: bool,\n    images_scale: float,\n    emit_crops: bool,\n    log_fn: Callable,\n) -> Dict[str, Any]:\n    from docling_core.types.doc import PictureItem, TableItem\n\n    converter = _build_converter(do_ocr, images_scale, emit_crops)\n    result = converter.convert(str(file_path))\n    doc = result.document\n\n    elements: List[Dict[str, Any]] = []\n    counts: Dict[str, int] = {}\n\n    for idx, (item, _level) in enumerate(doc.iterate_items()):\n        label = getattr(item, \"label\", None)\n        label_val = getattr(label, \"value\", None) or \"unknown\"\n        counts[label_val] = counts.get(label_val, 0) + 1\n\n        prov_list = getattr(item, \"prov\", None) or []\n        prov = prov_list[0] if prov_list else None\n        page = getattr(prov, \"page_no\", None) if prov else None\n        bbox = _bbox_to_dict(getattr(prov, \"b