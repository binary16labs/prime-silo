path\":   \"/api/vision/stitch\",\n242\t            \"body\":   { \"workspace\": \"${workspace}\", \"surrogates\": \"${inputs.validated_surrogates}\", \"target_dir\": \"${data_in_dir}\" },\n243\t            \"timeout\": { \"connect\": 10, \"read\": 600, \"write\": 120, \"pool\": 10 }\n244\t          },\n245\t          \"emits\": { \"enriched_docs\": \"$.enriched_docs\" }\n246\t        }\n247\t      },\n248\t\n249\t      {\n250\t        \"id\": \"rag_ingest\",\n251\t        \"description\": \"[DETERMINISTIC] [EXISTING] Chunk and embed the ENRICHED docs into ChromaDB. Unchanged from knowledge_enrichment_pipeline — it now sees figure surrogates and table JSON inline, not a visually-blind doc.\",\n252\t        \"skill_hint\": \"rag_ingest\",\n253\t        \"dependencies\": [\"stitch_enriched\"],\n254\t        \"wave\": 5,\n255\t        \"complexity\": \"medium\",\n256\t        \"node_type\": \"task\",\n257\t        \"inputs_from\": {\n258\t          \"enriched_docs\": { \"source_task\": \"stitch_enriched\", \"emits_key\": \"enriched_docs\" }\n259\t        },\n260\t        \"execution\": {\n261\t          \"kind\": \"blocking_with_task_fallback\",\n262\t          \"generate_run_id_as\": \"task_run_id\",\n263\t          \"request\": {\n264\t            \"method\": \"POST\",\n265\t            \"path\":   \"/api/rag/ingest\",\n266\t            \"body\": {\n267\t              \"workspace\":      \"${workspace}\",\n268\t              \"deep_synthesis\": false,\n269\t              \"run_id\":         \"${task_run_id}\",\n270\t              \"files\":          \"${inputs.enriched_docs}\"\n271\t            },\n272\t            \"timeout\": { \"connect\": 10, \"read\": 1800, \"write\": 120, \"pool\": 10 }\n273\t          },\n274\t          \"fallback_on_timeout\": {\n275\t            \"method\":  \"GET\",\n276\t            \"path\":    \"/api/tasks/tasks/${task_run_id}\",\n277\t            \"timeout_s\": 10,\n278\t            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n279\t            \"success_result\": { \"status\": \"completed_after_timeout\", \"rag_chunks\": \"$.total_steps\", \"task_id\": \"${task_run_id}\" }\n280\t          }\n281\t        }\n282\t      },\n283\t\n284\t      {\n285\t        \"id\": \"deep_synthesis\",\n286\t        \"description\": \"[AGENTIC] [EXISTING] Build the PageIndex tree over the enriched corpus and fan triple extraction over its Section leaves (ADR-002). Figure-derived triples now exist and inherit Section + page provenance.\",\n287\t        \"skill_hint\": \"rag_ingest\",\n288\t        \"assigned_model\": \"${synthesis_model}\",\n289\t        \"dependencies\": [\"rag_ingest\"],\n290\t        \"wave\": 6,\n291\t        \"complexity\": \"high\",\n292\t        \"node_type\": \"task\",\n293\t        \"execution\": {\n294\t          \"kind\": \"blocking_with_task_list_fallback\",\n295\t          \"request\": {\n296\t            \"method\": \"POST\",\n297\t            \"path\":   \"/api/graph/synthesize\",\n298\t            \"body\":   { \"workspace\": \"${workspace}\", \"model\": \"${synthesis_model}\" },\n299\t            \"timeout\": { \"connect\": 10, \"read\": 1800, \"write\": 60, \"pool\": 10 }\n300\t          },\n301\t          \"fallback_on_timeout\": {\n302\t            \"method\":              \"GET\",\n303\t            \"path\":                \"/api/tasks\",\n304\t            \"params\":              { \"workspace\": \"${workspace}\" },\n305\t            \"timeout_s\":           10,\n306\t            \"filter_type\":         \"synthesis\",\n307\t            \"sort_by\":             \"updated_at\",\n308\t            \"order\":               \"desc\",\n309\t            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n310\t            \"success_result\":      { \"status\": \"completed_after_timeout\", \"task_id\": \"$.task_id\", \"message\": \"$.message\" }\n311\t          }\n312\t        }\n313\t      },\n314\t\n315\t      {\n316\t        \"id\": \"validate_visio