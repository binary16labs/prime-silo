{"parentUuid":"39208b44-c9d5-4f9f-af32-e11ba589c0c0","isSidechain":false,"promptId":"2c396758-3082-4aa5-8b6d-cf9d2bf6d0a3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EqBJXjQpBwwjdznSdtbUTj","type":"tool_result","content":"1\t\"\"\"\n2\tVision ingestion routes (VIS-001 / ADR-003).\n3\t\n4\tExposes the multimodal document-parsing workflow over HTTP so the\n5\t``vision_ingestion_pipeline`` manifest is runnable via ``benny enrich``:\n6\t\n7\t  POST /api/vision/docmodel  — Phase 0: parse staged/ingestible docs into DocModels\n8\t                               (element tree + table JSON + picture crops).\n9\t  POST /api/vision/enrich    — Phase 2+3: run the describer ladder over each DocModel's\n10\t                               visuals and stitch an enriched markdown into data_in/\n11\t                               (which the existing /api/rag/ingest then consumes).\n12\t\n13\tBoth are long-running (Docling + local VLM); callers use the manifest's\n14\tblocking_with_task_fallback. All model calls flow through ``call_model``.\n15\t\"\"\"\n16\t\n17\timport json\n18\tfrom typing import Optional\n19\t\n20\tfrom fastapi import APIRouter, HTTPException\n21\t\n22\tfrom ..core.docmodel import _safe_stem, build_docmodel\n23\tfrom ..core.vision_pipeline import enrich_docmodel, write_enriched\n24\tfrom ..core.workspace import get_workspace_path\n25\t\n26\trouter = APIRouter()\n27\t\n28\tSUPPORTED = {\".pdf\", \".docx\", \".pptx\", \".html\", \".md\", \".txt\"}\n29\t\n30\t\n31\t@router.post(\"/docmodel\")\n32\tasync def vision_docmodel(\n33\t    workspace: str = \"default\",\n34\t    emit_crops: bool = True,\n35\t    source: Optional[str] = None,\n36\t    force: bool = False,\n37\t):\n38\t    \"\"\"Build DocModels for ingestible files under the workspace (staging + data_in).\"\"\"\n39\t    results = []\n40\t    seen = set()\n41\t    for sub in (\"staging\", \"data_in\"):\n42\t        d = get_workspace_path(workspace, sub)\n43\t        if not d.exists():\n44\t            continue\n45\t        for f in sorted(d.glob(\"*.*\")):\n46\t            if f.suffix.lower() not in SUPPORTED or _safe_stem(f.name) in seen:\n47\t                continue\n48\t            if source and _safe_stem(f.name) != _safe_stem(source):\n49\t                continue\n50\t            seen.add(_safe_stem(f.name))\n51\t            try:\n52\t                model = build_docmodel(f, workspace=workspace, emit_crops=emit_crops, force=force)\n53\t                results.append(\n54\t                    {\n55\t                        \"source\": f.name,\n56\t                        \"elements\": len(model[\"elements\"]),\n57\t                        \"counts\": model[\"counts\"],\n58\t                        \"degraded\": model[\"degraded\"],\n59\t                    }\n60\t                )\n61\t            except Exception as e:  # one bad file must not sink the batch\n62\t                results.append({\"source\": f.name, \"error\": str(e)})\n63\t    if not results:\n64\t        raise HTTPException(404, f\"No ingestible files found under workspace '{workspace}'.\")\n65\t    return {\"status\": \"ok\", \"docmodels\": results}\n66\t\n67\t\n68\t@router.post(\"/enrich\")\n69\tasync def vision_enrich(\n70\t    workspace: str = \"default\",\n71\t    source: Optional[str] = None,\n72\t    vlm_model: Optional[str] = None,\n73\t    reviewer_model: Optional[str] = None,\n74\t    render_check: bool = False,\n75\t    limit: Optional[int] = None,\n76\t    write_to_data_in: bool = True,\n77\t):\n78\t    \"\"\"Run the describer ladder over each DocModel's visuals, stitch an enriched\n79\t    markdown (+ JSON sidecar), and drop the enriched markdown into data_in/ so the\n80\t    existing RAG ingest picks up the visually-complete document.\"\"\"\n81\t    dm_dir = get_workspace_path(workspace, \".benny/docmodel\")\n82\t    if not dm_dir.exists():\n83\t        raise HTTPException(404, \"No DocModels yet — run POST /api/vision/docmodel first.\")\n84\t\n85\t    enriched = []\n86\t    for jf in sorted(dm_dir.glob(\"*.json\")):\n87\t        if jf.name.endswith(\".enriched.json\"):\n88\t            continue\n89\t        if source and _safe_stem(jf.stem) != _safe_stem(source):\n90\t            continue\n91\t        docmodel = json.loads(jf.read_text(encoding=\"utf-8\"))\n92\t        kwargs = {\"render_check\": render_check, \"limit\": limit}\n93\t        if vlm_model:\n94\t            kwargs[\"vlm_model\"] = vlm_model\n95\t        if reviewer_model:\n96\t            kwargs[\"reviewer_model\"] = reviewer_model\n97\t        res = await enrich_docmodel(docmodel, **kwargs)\n98\t        paths = write_enriched(res, workspace, docmodel.get(\"source\", jf.stem))\n99\t        if write_to_data_in:\n100\t            di = get_workspace_path(workspace, \"data_in\")\n101\t            di.mkdir(parents=True, exist_ok=True)\n102\t            md_name = f\"{_safe_stem(docmodel.get('source', jf.stem))}.md\"\n103\t            (di / md_name).write_text(res[\"markdown\"], encoding=\"utf-8\")\n104\t            paths[\"data_in\"] = str(di / md_name)\n105\t        enriched.append(\n106\t            {\"source\": docmodel.get(\"source\"), \"summary\": res[\"summary\"], \"paths\": paths}\n107\t        )\n108\t\n109\t    if not enriched:\n110\t        raise HTTPException(404, f\"No matching DocModel to enrich in workspace '{workspace}'.\")\n111\t    return {\"status\": \"ok\", \"enriched\": enriched}\n112\t"}]},"uuid":"ab4409c1-851f-4d1e-a853-f1f1cfe516e2","timestamp":"2026-06-29T10:28:54.922Z","toolUseResult":{"type":"text","file":{"filePath":"prime-silo\\runtime\\benny\\api\\vision_routes.py","content":"\"\"\"\nVision ingestion routes (VIS-001 / ADR-003).\n\nExposes the multimodal document-parsing workflow over HTTP so the\n``vision_ingestion_pipeline`` manifest is runnable via ``benny enrich``:\n\n  POST /api/vision/docmodel  — Phase 0: parse staged/ingestible docs into DocModels\n                               (element tree + table JSON + picture crops).\n  POST /api/vision/enrich    — Phase 2+3: run the describer ladder over each DocModel's\n                               visuals and stitch an enriched markdown into data_in/\n                               (which the existing /api/rag/ingest then consumes).\n\nBoth are long-running (Docling + local VLM); callers use the manifest's\nblocking_with_task_fallback. All model calls flow through ``call_model``.\n\"\"\"\n\nimport json\nfrom typing import Optional\n\nfrom fastapi import APIRouter, HTTPException\n\nfrom ..core.docmodel import _safe_stem, build_docmodel\nfrom ..core.vision_pipeline import enrich_docmodel, write_enriched\nfrom ..core.workspace import get_workspace_path\n\nrouter = APIRouter()\n\nSUPPORTED = {\".pdf\", \".docx\", \".pptx\", \".html\", \".md\", \".txt\"}\n\n\n@router.post(\"/docmodel\")\nasync def vision_docmodel(\n    workspace: str = \"default\",\n    emit_crops: bool = True,\n    source: Optional[str] = None,\n    force: bool = False,\n):\n    \"\"\"Build DocModels for ingestible files under the workspace (staging + data_in).\"\"\"\n    results = []\n    seen = set()\n    for sub in (\"staging\", \"data_in\"):\n        d = get_workspace_path(workspace, sub)\n        if not d.exists():\n            continue\n        for f in sorted(d.glob(\"*.*\")):\n            if f.suffix.lower() not in SUPPORTED or _safe_stem(f.name) in seen:\n                continue\n            if source and _safe_stem(f.name) != _safe_stem(source):\n                continue\n            seen.add(_safe_stem(f.name))\n            try:\n                model = build_docmodel(f, workspace=workspace, emit_crops=emit_crops, force=force)\n                results.append(\n                    {\n                        \"source\": f.name,\n                        \"elements\": len(model[\"elements\"]),\n                        \"counts\": model[\"counts\"],\n                        \"degraded\": model[\"degraded\"],\n                    }\n                )\n            except Exception as e:  # one bad file must not sink the batch\n                results.append({\"source\": f.name, \"error\": str(e)})\n    if not results:\n        raise HTTPException(404, f\"No ingestible files found under workspace '{workspace}'.\")\n    return {\"status\": \"ok\", \"docmodels\": results}\n\n\n@router.post(\"/enrich\")\nasync def vision_enrich(\n    workspace: str = \"default\",\n    source: Optional[str] = None,\n    vlm_model: Optional[str] = None,\n    reviewer_model: Optional[str] = None,\n    render_check: bool = False,\n    limit: Optional[int] = None,\n    write_to_data_in: bool = True,\n):\n    \"\"\"Run the describer ladder over each DocModel's visuals, stitch an enriched\n    markdown (+ JSON sidecar), and drop the enriched markdown into data_in/ so the\n    existing RAG ingest picks up the visually-complete document.\"\"\"\n    dm_dir = get_workspace_path(workspace, \".benny/docmodel\")\n    if not dm_dir.exists():\n        raise HTTPException(404, \"No DocModels yet — run POST /api/vision/docmodel first.\")\n\n    enriched = []\n    for jf in sorted(dm_dir.glob(\"*.json\")):\n        if jf.name.endswith(\".enriched.json\"):\n            continue\n        if source and _safe_stem(jf.stem) != _safe_stem(source):\n            continue\n        docmodel = json.loads(jf.read_text(encoding=\"utf-8\"))\n        kwargs = {\"render_check\": render_check, \"limit\": limit}\n        if vlm_model:\n            kwargs[\"vlm_model\"] = vlm_model\n        if reviewer_model:\n            kwargs[\"reviewer_model\"] = reviewer_model\n        res = await enrich_docmodel(docmodel, **kwargs)\n        paths = write_enriched(res, workspace, docmodel.get(\"source\", jf.stem))\n        if write_to_data_in:\n            di = get_workspace_path(workspace, \"data_in\")\n            di.mkdir(parents=True, exist_ok=True)\n            md_name = f\"{_safe_stem(docmodel.get('source', jf.stem))}.md\"\n            (di / md_name).write_text(res[\"markdown\"], encoding=\"utf-8\")\n            paths[\"data_in\"] = str(di / md_name)\n        enriched.append(\n            {\"source\": docmodel.get(\"source\"), \"summary\": res[\"summary\"], \"paths\": paths}\n        )\n\n    if not enriched:\n        raise HTTPException(404, f\"No matching DocModel to enrich in workspace '{workspace}'.\")\n    return {\"status\": \"ok\", \"enriched\": enriched}\n","numLines":112,"startLine":1,"totalLines":112}},"sourceToolAssistantUUID":"39208b44-c9d5-4f9f-af32-e11ba589c0c0","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"eb427ad4-8c1e-494a-b563-fd2879a365fa","version":"2.1.187","gitBranch":"HEAD"}
