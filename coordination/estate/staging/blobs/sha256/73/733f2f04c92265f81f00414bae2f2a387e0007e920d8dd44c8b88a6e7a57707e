{"parentUuid":"aeb87008-38fe-482f-bf57-ca0a2c9e9b35","isSidechain":false,"promptId":"2c396758-3082-4aa5-8b6d-cf9d2bf6d0a3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011VDJGSG5RgC5DRH4XXsoQg","type":"tool_result","content":"1\t\"\"\"\n2\tVision describer ladder + multi-model review loop (VIS-001 / ADR-003 Phase 2).\n3\t\n4\tTurns a DocModel visual element (a crop + its caption/context from Phase 0) into a\n5\tvalidated textual **surrogate**, using more than one model so the result is\n6\tgreater than any single pass:\n7\t\n8\t  1. classify   — illustration | diagram | chart (label + caption heuristics)\n9\t  2. describe    — qwen3vl (vision) produces the surrogate from the crop, grounded\n10\t                   by the caption + surrounding text\n11\t  3. validate    — programmatic check (Mermaid parses / JSON valid) — no hollow success\n12\t  4. review      — qwen3-9b (text) cross-checks the surrogate against the document's\n13\t                   OWN text, scores it, flags missing/hallucinated parts, proposes a fix\n14\t  5. refine      — vision model regenerates given the critique (bounded iterations)\n15\t  6. best wins   — highest-scoring VALID surrogate, else a plain caption fallback\n16\t\n17\tAll model calls go through ``call_model`` (ADR-001 / VIS-SEC3). The vision and\n18\treviewer models are parameters so the workflow is reusable across documents.\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\timport logging\n24\timport os\n25\timport re\n26\timport shutil\n27\timport subprocess\n28\timport tempfile\n29\tfrom pathlib import Path\n30\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n31\t\n32\tfrom .models import call_model\n33\tfrom .vision import vision_message\n34\t\n35\tlogger = logging.getLogger(__name__)\n36\t\n37\tDEFAULT_VLM = \"lemonade/qwen3vl-it-4b-FLM\"\n38\tDEFAULT_REVIEWER = \"lemonade/qwen3.5-9b-FLM\"\n39\t\n40\t# DocItemLabel values that are decorative vs. technical. docling already emits a\n41\t# distinct ``chart`` label; everything else under ``picture`` we sub-classify.\n42\t_DIAGRAM_HINTS = (\n43\t    \"figure\",\n44\t    \"diagram\",\n45\t    \"architecture\",\n46\t    \"cycle\",\n47\t    \"framework\",\n48\t    \"model\",\n49\t    \"flow\",\n50\t    \"process\",\n51\t    \"metamodel\",\n52\t    \"structure\",\n53\t    \"relationship\",\n54\t    \"overview\",\n55\t)\n56\t_CHART_HINTS = (\"chart\", \"graph\", \"plot\", \"trend\", \"distribution\", \"histogram\", \"bar \", \"pie\")\n57\t\n58\t\n59\t# =============================================================================\n60\t# CLASSIFICATION\n61\t# =============================================================================\n62\t\n63\t\n64\tdef classify_visual(label: str, caption: str = \"\") -> str:\n65\t    \"\"\"Decide the treatment type for a visual element.\n66\t\n67\t    ``chart`` (docling label) → chart. Otherwise use caption keywords to tell a\n68\t    technical *diagram* from a decorative *illustration*; default to diagram in a\n69\t    technical document since that is the high-value case.\n70\t    \"\"\"\n71\t    cap = (caption or \"\").lower()\n72\t    if label == \"chart\" or any(h in cap for h in _CHART_HINTS):\n73\t        return \"chart\"\n74\t    if any(h in cap for h in _DIAGRAM_HINTS):\n75\t        return \"diagram\"\n76\t    # A captioned \"Figure N\" in a standards doc is almost always a diagram.\n77\t    if re.search(r\"\\bfig(?:ure)?\\b\", cap):\n78\t        return \"diagram\"\n79\t    return \"illustration\"\n80\t\n81\t\n82\t# =============================================================================\n83\t# MERMAID EXTRACTION + VALIDATION (programmatic \"test the outcome\")\n84\t# =============================================================================\n85\t\n86\t_MERMAID_HEADERS = (\n87\t    \"flowchart\",\n88\t    \"graph\",\n89\t    \"sequencediagram\",\n90\t    \"classdiagram\",\n91\t    \"statediagram\",\n92\t    \"erdiagram\",\n93\t    \"journey\",\n94\t    \"gantt\",\n95\t    \"mindmap\",\n96\t    \"timeline\",\n97\t    \"C4Context\",\n98\t)\n99\t\n100\t\n101\tdef extract_code(text: str, lang: str = \"mermaid\") -> str:\n102\t    \"\"\"Pull a fenced ``code block (any of ```mermaid / ``` / ```json) or, failing\n103\t    that, return the stripped text. Drops <think> blocks local models emit, and —\n104\t    for Mermaid — strips the invalid ``#`` comments/notes local models like to add\n105\t    (Mermaid comments are ``%%``, and a stray ``# Note:`` line hard-fails mmdc).\"\"\"\n106\t    if not text:\n107\t        return \"\"\n108\t    text = re.sub(r\"<think>.*?</think>\", \"\", text, flags=re.DOTALL | re.IGNORECASE).strip()\n109\t    m = re.search(rf\"```{lang}\\s*\\n?(.*?)```\", text, re.DOTALL | re.IGNORECASE)\n110\t    if not m:\n111\t        m = re.search(r\"```\\s*\\n?(.*?)```\", text, re.DOTALL)\n112\t    code = (m.group(1) if m else text).strip()\n113\t    if lang == \"mermaid\":\n114\t        code = _sanitize_mermaid(code)\n115\t    return code\n116\t\n117\t\n118\tdef _sanitize_mermaid(code: str) -> str:\n119\t    \"\"\"Remove Mermaid-invalid ``#`` comment lines and trailing `` # ...`` inline\n120\t    notes (the ``\\\\s#\\\\s`` form won't touch a real ``A[C#]`` label).\"\"\"\n121\t    out = []\n122\t    for line in code.splitlines():\n123\t        if line.lstrip().startswith(\"#\"):\n124\t            continue\n125\t        line = re.sub(r\"\\s+#\\s.*$\", \"\", line)  # strip \" # note\" tails\n126\t        if line.strip():\n127\t            out.append(line)\n128\t    return \"\\n\".join(out).strip()\n129\t\n130\t\n131\tdef validate_mermaid(code: str) -> Tuple[bool, str]:\n132\t    \"\"\"Permissive structural PRE-FILTER for Mermaid source — the authoritative gate\n133\t    is ``render_validate_mermaid`` (mmdc). Calibrated against the real renderer: it\n134\t    only rejects what definitely will not render (no/empty header, no edges,\n135\t    unbalanced subgraph/end, prose instead of code). It deliberately does NOT\n136\t    reject things mmdc actually accepts (dotted ids, `A --|x|--> B` labels); those\n137\t    are quality concerns handled by the prompt + reviewer, not validity. Returns\n138\t    (ok, reason).\"\"\"\n139\t    if not code or not code.strip():\n140\t        return False, \"empty\"\n141\t    lines = [ln.rstrip() for ln in code.strip().splitlines() if ln.strip()]\n142\t    header = lines[0].strip().lower()\n143\t    if not header.startswith(tuple(h.lower() for h in _MERMAID_HEADERS)):\n144\t        return False, f\"no valid diagram header (got: {lines[0][:40]!r})\"\n145\t    body = \"\\n\".join(lines[1:])\n146\t    # balanced subgraph/end\n147\t    n_sub = len(re.findall(r\"^\\s*subgraph\\b\", body, re.MULTILINE))\n148\t    n_end = len(re.findall(r\"^\\s*end\\b\", body, re.MULTILINE))\n149\t    if n_sub != n_end:\n150\t        return False, f\"unbalanced subgraph/end ({n_sub} vs {n_end})\"\n151\t    # a flowchart/graph must have at least one edge/connection\n152\t    if header.startswith((\"flowchart\", \"graph\")):\n153\t        if not re.search(r\"--|==|-\\.|-->|---\", body):\n154\t            return False, \"no edges/connections found\"\n155\t    # crude prose detector: a non-comment line that reads like a sentence\n156\t    for ln in lines[1:]:\n157\t        s = ln.strip()\n158\t        if s.startswith(\"%%\"):\n159\t            continue\n160\t        if s.endswith(\".\") and \" \" in s and not re.search(r\"[\\[\\]{}()|>\\-=]\", s):\n161\t            return False, f\"prose leaked into diagram: {s[:40]!r}\"\n162\t    return True, \"ok\"\n163\t\n164\t\n165\tdef _find_mmdc_cli() -> Optional[str]:\n166\t    \"\"\"Locate the mermaid-cli entry (``cli.js``). Env ``BENNY_MMDC_CLI`` wins;\n167\t    otherwise probe the packaging install. Returns None when unavailable (render\n168\t    validation is an optional dev/build-time gate, not shipped in the runtime).\"\"\"\n169\t    env = os.environ.get(\"BENNY_MMDC_CLI\")\n170\t    if env and Path(env).exists():\n171\t        return env\n172\t    here = Path(__file__).resolve()\n173\t    for parent in here.parents:\n174\t        cand = (\n175\t            parent / \"packaging\" / \"node_modules\" / \"@mermaid-js\" / \"mermaid-cli\" / \"src\" / \"cli.js\"\n176\t        )\n177\t        if cand.exists():\n178\t            return str(cand)\n179\t    return None\n180\t\n181\t\n182\tdef render_validate_mermaid(\n183\t    code: str, *, out_png: Optional[str] = None, timeout: int = 120\n184\t) -> Tuple[bool, str, Optional[str]]:\n185\t    \"\"\"Authoritative 'does it render' check: run mermaid-cli (mmdc) to render the\n186\t    diagram to PNG. Returns (ok, reason, png_path|None). Falls back to (None-ish)\n187\t    when node/mmdc are absent so callers can degrade to structural validation.\"\"\"\n188\t    node = shutil.which(\"node\")\n189\t    cli = _find_mmdc_cli()\n190\t    if not node or not cli:\n191\t        return False, \"mmdc-unavailable\", None\n192\t    tmpdir = Path(tempfile.mkdtemp(prefix=\"mmdc-\"))\n193\t    mmd = tmpdir / \"d.mmd\"\n194\t    png = Path(out_png) if out_png else tmpdir / \"d.png\"\n195\t    png.parent.mkdir(parents=True, exist_ok=True)\n196\t    mmd.write_text(code, encoding=\"utf-8\")\n197\t    try:\n198\t        proc = subprocess.run(\n199\t            [node, cli, \"-i\", str(mmd), \"-o\", str(png)],\n200\t            capture_output=True,\n201\t            text=True,\n202\t            timeout=timeout,\n203\t        )\n204\t        if proc.returncode == 0 and png.exists() and png.stat().st_size > 0:\n205\t            return True, \"rendered\", str(png)\n206\t        err = (proc.stderr or proc.stdout or \"\").strip().splitlines()\n207\t        return (\n208\t            False,\n209\t            \"render-failed: \" + (err[-1][:160] if err else f\"exit {proc.returncode}\"),\n210\t            None,\n211\t        )\n212\t    except subprocess.TimeoutExpired:\n213\t        return False, \"render-timeout\", None\n214\t    except Exception as e:\n215\t        return False, f\"render-error: {e}\", None\n216\t\n217\t\n218\tdef _table_json_to_markdown(table: Dict[str, Any], max_rows: int = 8) -> str:\n219\t    cols = table.get(\"columns\", [])\n220\t    rows = table.get(\"rows\", [])[:max_rows]\n221\t    out = [\n222\t        \"| \" + \" | \".join(str(c) for c in cols) + \" |\",\n223\t        \"| \" + \" | \".join(\"---\" for _ in cols) + \" |\",\n224\t    ]\n225\t    for r in rows:\n226\t        out.append(\"| \" + \" | \".join(\"\" if c is None else str(c) for c in r) + \" |\")\n227\t    return \"\\n\".join(out)\n228\t\n229\t\n230\t# =============================================================================\n231\t# PROMPTS\n232\t# =============================================================================\n233\t\n234\tDIAGRAM_PROMPT = \"\"\"You are converting a TECHNICAL DIAGRAM into Mermaid diagram-as-code.\n235\t\n236\tCONTEXT (caption + surrounding text from the source document):\n237\t{context}\n238\t\n239\tRules:\n240\t- Output ONLY Mermaid code, nothing else. Start with a valid header (flowchart TD / flowchart LR / graph TD).\n241\t- Give each node a SHORT id that is plain alphanumeric with NO dots and NO spaces (e.g. P, A, B, RM).\n242\t- Define each node's label EXACTLY ONCE as `id[Label]` using the EXACT text from the image, then connect using ids ONLY.\n243\t  CORRECT:   A[Architecture Vision]\\n             A --> B\\n             RM[Requirements Management]\\n             RM <--> A\n244\t  WRONG:     A.[Architecture Vision] --> B.[Business Architecture]   (dotted ids, label repeated)\n245\t- Capture EVERY labelled box/node and EVERY arrow, including direction and edge labels (`A -->|label| B`).\n246\t- For a hub/center node connected to all others, define it once and link it to each id.\n247\t- Use `subgraph Name ... end` for visually grouped/nested containers.\n248\t- Do NOT invent nodes not in the image. Do NOT add prose or explanation.\n249\t\n250\tMermaid:\"\"\"\n251\t\n252\tILLUSTRATION_PROMPT = \"\"\"Describe this image in 1-2 factual sentences for a document index.\n253\tCONTEXT: {context}\n254\tBe concrete and specific; do not speculate. Description:\"\"\"\n255\t\n256\tCHART_PROMPT = \"\"\"You are extracting data from a CHART. Output ONLY a JSON object:\n257\t{{\"chart_type\": \"...\", \"title\": \"...\", \"axes\": {{\"x\": \"...\", \"y\": \"...\"}}, \"series\": [{{\"name\": \"...\", \"points\": [[x, y], ...]}}], \"description\": \"one sentence\"}}\n258\tCONTEXT: {context}\n259\tJSON:\"\"\"\n260\t\n261\tREVIEW_PROMPT = \"\"\"You are a meticulous reviewer of diagram-as-code. A vision model converted a\n262\ttechnical diagram into Mermaid. You CANNOT see the image, but you have the diagram's\n263\tcaption and the surrounding document text, which describe what the diagram contains.\n264\t\n265\tDIAGRAM CAPTION + CONTEXT:\n266\t{context}\n267\t\n268\tCANDIDATE MERMAID:\n269\t{mermaid}\n270\t\n271\tAssess strictly and reply in this EXACT XML form (no prose outside it):\n272\t<review>\n273\t  <valid_syntax>true|false</valid_syntax>\n274\t  <score>0-10</score>\n275\t  <missing>comma-separated nodes/edges implied by the context but absent from the Mermaid, or \"none\"</missing>\n276\t  <hallucinated>comma-separated nodes in the Mermaid not supported by the context, or \"none\"</hallucinated>\n277\t  <improved_mermaid>\n278\tA corrected/improved full Mermaid diagram (keep what is right, fix the rest). If the candidate is already good, repeat it.\n279\t  </improved_mermaid>\n280\t</review>\"\"\"\n281\t\n282\t\n283\tdef _fmt(prompt: str, **kw) -> str:\n284\t    return prompt.format(**kw)\n285\t\n286\t\n287\t# =============================================================================\n288\t# MODEL STEPS\n289\t# =============================================================================\n290\t\n291\t\n292\tasync def _vision_call(prompt: str, crop_bytes: bytes, model: str, run_id: Optional[str]) -> str:\n293\t    return await call_model(\n294\t        model=model,\n295\t        messages=vision_message(prompt, crop_bytes),\n296\t        temperature=0.0,\n297\t        max_tokens=1024,\n298\t        workspace_id=\"default\",\n299\t        role=\"vision\",\n300\t        run_id=run_id,\n301\t    )\n302\t\n303\t\n304\tasync def _text_call(prompt: str, model: str, run_id: Optional[str]) -> str:\n305\t    return await call_model(\n306\t        model=model,\n307\t        messages=[{\"role\": \"user\", \"content\": prompt}],\n308\t        temperature=0.0,\n309\t        max_tokens=1024,\n310\t        workspace_id=\"default\",\n311\t        role=\"graph_synthesis\",\n312\t        run_id=run_id,\n313\t    )\n314\t\n315\t\n316\tdef _parse_review(raw: str) -> Dict[str, Any]:\n317\t    def field(tag):\n318\t        m = re.search(rf\"<{tag}>(.*?)</{tag}>\", raw, re.DOTALL | re.IGNORECASE)\n319\t        return m.group(1).strip() if m else \"\"\n320\t\n321\t    score_s = field(\"score\")\n322\t    try:\n323\t        score = float(re.search(r\"[\\d.]+\", score_s).group())\n324\t    except Exception:\n325\t        score = 0.0\n326\t    return {\n327\t        \"valid_syntax\": field(\"valid_syntax\").lower().startswith(\"t\"),\n328\t        \"score\": score,\n329\t        \"missing\": field(\"missing\"),\n330\t        \"hallucinated\": field(\"hallucinated\"),\n331\t        \"improved_mermaid\": extract_code(field(\"improved_mermaid\")),\n332\t    }\n333\t\n334\t\n335\t# =============================================================================\n336\t# ORCHESTRATION\n337\t# =============================================================================\n338\t\n339\t\n340\tasync def describe_element(\n341\t    crop_bytes: bytes,\n342\t    *,\n343\t    label: str = \"picture\",\n344\t    caption: str = \"\",\n345\t    context: str = \"\",\n346\t    vlm_model: str = DEFAULT_VLM,\n347\t    reviewer_model: str = DEFAULT_REVIEWER,\n348\t    max_refine: int = 1,\n349\t    render_check: bool = False,\n350\t    run_id: Optional[str] = None,\n351\t    log_fn: Callable = print,\n352\t) -> Dict[str, Any]:\n353\t    \"\"\"Run the full describe→validate→review→refine ladder for one visual element.\n354\t\n355\t    Returns a surrogate dict: {type, surrogate_kind, content, validated, score,\n356\t    attempts:[...], review:{...}, model_id}. Never raises on a bad generation —\n357\t    degrades to a caption with validated=False.\n358\t    \"\"\"\n359\t    ctx = (caption + \"\\n\" + context).strip() or \"(no surrounding text available)\"\n360\t    kind = classify_visual(label, caption)\n361\t    attempts: List[Dict[str, Any]] = []\n362\t\n363\t    if kind == \"illustration\":\n364\t        desc = await _vision_call(\n365\t            _fmt(ILLUSTRATION_PROMPT, context=ctx), crop_bytes, vlm_model, run_id\n366\t        )\n367\t        return {\n368\t            \"type\": label,\n369\t            \"surrogate_kind\": \"caption\",\n370\t            \"content\": desc.strip(),\n371\t            \"validated\": bool(desc.strip()),\n372\t            \"score\": None,\n373\t            \"attempts\": [],\n374\t            \"model_id\": vlm_model,\n375\t        }\n376\t\n377\t    if kind == \"chart\":\n378\t        raw = await _vision_call(_fmt(CHART_PROMPT, context=ctx), crop_bytes, vlm_model, run_id)\n379\t        js = extract_code(raw, \"json\")\n380\t        ok = js.strip().startswith(\"{\") and js.strip().endswith(\"}\")\n381\t        return {\n382\t            \"type\": label,\n383\t            \"surrogate_kind\": \"chart_json\" if ok else \"caption\",\n384\t            \"content\": js if ok else raw.strip(),\n385\t            \"validated\": ok,\n386\t            \"score\": None,\n387\t            \"attempts\": [],\n388\t            \"model_id\": vlm_model,\n389\t        }\n390\t\n391\t    # --- diagram: the multi-model loop ---\n392\t    # The VISION model always OWNS the topology (it can see the image). The text\n393\t    # reviewer is blind, so it only GUIDES — scores, flags missing/hallucinated/\n394\t    # syntax — which we feed back as a refinement critique. A reviewer-proposed\n395\t    # diagram is kept ONLY as a last resort if no vision attempt ever validates.\n396\t    best: Optional[Dict[str, Any]] = None\n397\t    reviewer_fallback: Optional[Dict[str, Any]] = None\n398\t    review: Dict[str, Any] = {}\n399\t    prompt = _fmt(DIAGRAM_PROMPT, context=ctx)\n400\t\n401\t    for i in range(max_refine + 1):\n402\t        raw = await _vision_call(prompt, crop_bytes, vlm_model, run_id)\n403\t        mermaid = extract_code(raw, \"mermaid\")\n404\t        ok, reason = validate_mermaid(mermaid)\n405\t        # Optional authoritative gate: only count as valid if mmdc actually renders\n406\t        # it (catches everything the structural check can't). Skipped silently when\n407\t        # the renderer isn't installed.\n408\t        if ok and render_check:\n409\t            rok, rreason, _png = render_validate_mermaid(mermaid)\n410\t            if rreason != \"mmdc-unavailable\":\n411\t                ok, reason = rok, (reason if rok else rreason)\n412\t        attempts.append({\"iter\": i, \"valid\": ok, \"reason\": reason, \"chars\": len(mermaid)})\n413\t        log_fn(f\"[describe] diagram attempt {i}: valid={ok} ({reason}) {len(mermaid)} chars\")\n414\t\n415\t        # review with the text model (cross-check vs document text)\n416\t        review_raw = await _text_call(\n417\t            _fmt(REVIEW_PROMPT, context=ctx, mermaid=mermaid), reviewer_model, run_id\n418\t        )\n419\t        review = _parse_review(review_raw)\n420\t        log_fn(\n421\t            f\"[review] score={review['score']} valid_syntax={review['valid_syntax']} \"\n422\t            f\"missing={review['missing'][:60]!r}\"\n423\t        )\n424\t\n425\t        cand = {\n426\t            \"mermaid\": mermaid,\n427\t            \"valid\": ok,\n428\t            \"reason\": reason,\n429\t            \"score\": review[\"score\"],\n430\t            \"review\": review,\n431\t            \"source\": \"vision\",\n432\t        }\n433\t        if (\n434\t            best is None\n435\t            or (ok and not best[\"valid\"])\n436\t            or (ok == best[\"valid\"] and review[\"score\"] > best[\"score\"])\n437\t        ):\n438\t            best = cand\n439\t\n440\t        # capture a VALID reviewer-proposed diagram as fallback only (blind model)\n441\t        improved = review.get(\"improved_mermaid\", \"\")\n442\t        if improved and reviewer_fallback is None and validate_mermaid(improved)[0]:\n443\t            reviewer_fallback = {\n444\t                \"mermaid\": improved,\n445\t                \"valid\": True,\n446\t                \"score\": review[\"score\"],\n447\t                \"review\": review,\n448\t                \"source\": \"reviewer_fallback\",\n449\t            }\n450\t\n451\t        if best[\"valid\"] and review[\"score\"] >= 8:\n452\t            break  # vision attempt is valid and the reviewer is happy\n453\t        if i < max_refine:\n454\t            prompt = (\n455\t                _fmt(DIAGRAM_PROMPT, context=ctx)\n456\t                + f\"\\n\\nYour previous attempt scored {review['score']}/10. FIX these, keeping the layout you can see:\\n\"\n457\t                f\"- missing nodes/edges: {review.get('missing','')}\\n\"\n458\t                f\"- remove if not in image: {review.get('hallucinated','')}\\n\"\n459\t                f\"- syntax issue: {reason if not ok else 'none'}\\n\"\n460\t            )\n461\t\n462\t    chosen = best if (best and best[\"valid\"]) else (reviewer_fallback or best)\n463\t    if chosen and chosen[\"valid\"]:\n464\t        return {\n465\t            \"type\": label,\n466\t            \"surrogate_kind\": \"mermaid\",\n467\t            \"content\": chosen[\"mermaid\"],\n468\t            \"validated\": True,\n469\t            \"score\": chosen[\"score\"],\n470\t            \"attempts\": attempts,\n471\t            \"review\": chosen.get(\"review\", review),\n472\t            \"model_id\": vlm_model,\n473\t            \"source\": chosen.get(\"source\", \"vision\"),\n474\t        }\n475\t\n476\t    # fallback: plain caption (no hollow success)\n477\t    cap = await _vision_call(_fmt(ILLUSTRATION_PROMPT, context=ctx), crop_bytes, vlm_model, run_id)\n478\t    return {\n479\t        \"type\": label,\n480\t        \"surrogate_kind\": \"caption_fallback\",\n481\t        \"content\": cap.strip(),\n482\t        \"validated\": False,\n483\t        \"score\": best[\"score\"] if best else 0.0,\n484\t        \"attempts\": attempts,\n485\t        \"review\": review,\n486\t        \"model_id\": vlm_model,\n487\t    }\n488\t"}]},"uuid":"402b1011-b1d4-4482-a894-786cc774fba8","timestamp":"2026-06-29T10:28:39.420Z","toolUseResult":{"type":"text","file":{"filePath":"prime-silo\\runtime\\benny\\core\\vision_describe.py","content":"\"\"\"\nVision describer ladder + multi-model review loop (VIS-001 / ADR-003 Phase 2).\n\nTurns a DocModel visual element (a crop + its caption/context from Phase 0) into a\nvalidated textual **surrogate**, using more than one model so the result is\ngreater than any single pass:\n\n  1. classify   — illustration | diagram | chart (label + caption heuristics)\n  2. describe    — qwen3vl (vision) produces the surrogate from the crop, grounded\n                   by the caption + surrounding text\n  3. validate    — programmatic check (Mermaid parses / JSON valid) — no hollow success\n  4. review      — qwen3-9b (text) cross-checks the surrogate against the document's\n                   OWN text, scores it, flags missing/hallucinated parts, proposes a fix\n  5. refine      — vision model regenerates given the critique (bounded iterations)\n  6. best wins   — highest-scoring VALID surrogate, else a plain caption fallback\n\nAll model calls go through ``call_model`` (ADR-001 / VIS-SEC3). The vision and\nreviewer models are parameters so the workflow is reusable across documents.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nimport os\nimport re\nimport shutil\nimport subprocess\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\nfrom .models import call_model\nfrom .vision import vision_message\n\nlogger = logging.getLogger(__name__)\n\nDEFAULT_VLM = \"lemonade/qwen3vl-it-4b-FLM\"\nDEFAULT_REVIEWER = \"lemonade/qwen3.5-9b-FLM\"\n\n# DocItemLabel values that are decorative vs. technical. docling already emits a\n# distinct ``chart`` label; everything else under ``picture`` we sub-classify.\n_DIAGRAM_HINTS = (\n    \"figure\",\n    \"diagram\",\n    \"architecture\",\n    \"cycle\",\n    \"framework\",\n    \"model\",\n    \"flow\",\n    \"process\",\n    \"metamodel\",\n    \"structure\",\n    \"relationship\",\n    \"overview\",\n)\n_CHART_HINTS = (\"chart\", \"graph\", \"plot\", \"trend\", \"distribution\", \"histogram\", \"bar \", \"pie\")\n\n\n# =============================================================================\n# CLASSIFICATION\n# =============================================================================\n\n\ndef classify_visual(label: str, caption: str = \"\") -> str:\n    \"\"\"Decide the treatment type for a visual element.\n\n    ``chart`` (docling label) → chart. Otherwise use caption keywords to tell a\n    technical *diagram* from a decorative *illustration*; default to diagram in a\n    technical document since that is the high-value case.\n    \"\"\"\n    cap = (caption or \"\").lower()\n    if label == \"chart\" or any(h in cap for h in _CHART_HINTS):\n        return \"chart\"\n    if any(h in cap for h in _DIAGRAM_HINTS):\n        return \"diagram\"\n    # A captioned \"Figure N\" in a standards doc is almost always a diagram.\n    if re.search(r\"\\bfig(?:ure)?\\b\", cap):\n        return \"diagram\"\n    return \"illustration\"\n\n\n# =============================================================================\n# MERMAID EXTRACTION + VALIDATION (programmatic \"test the outcome\")\n# =============================================================================\n\n_MERMAID_HEADERS = (\n    \"flowchart\",\n    \"graph\",\n    \"sequencediagram\",\n    \"classdiagram\",\n    \"statediagram\",\n    \"erdiagram\",\n    \"journey\",\n    \"gantt\",\n    \"mindmap\",\n    \"timeline\",\n    \"C4Context\",\n)\n\n\ndef extract_code(text: str, lang: str = \"mermaid\") -> str:\n    \"\"\"Pull a fenced ``code block (any of ```mermaid / ``` / ```json) or, failing\n    that, return the stripped text. Drops <think> blocks local models emit, and —\n    for Mermaid — strips the invalid ``#`` comments/notes local models like to add\n    (Mermaid comments are ``%%``, and a stray ``# Note:`` line hard-fails mmdc).\"\"\"\n    if not text:\n        return \"\"\n    text = re.sub(r\"<think>.*?</think>\", \"\", text, flags=re.DOTALL | re.IGNORECASE).strip()\n    m = re.search(rf\"```{lang}\\s*\\n?(.*?)```\", text, re.DOTALL | re.IGNORECASE)\n    if not m:\n        m = re.search(r\"```\\s*\\n?(.*?)```\", text, re.DOTALL)\n    code = (m.group(1) if m else text).strip()\n    if lang == \"mermaid\":\n        code = _sanitize_mermaid(code)\n    return code\n\n\ndef _sanitize_mermaid(code: str) -> str:\n    \"\"\"Remove Mermaid-invalid ``#`` comment lines and trailing `` # ...`` inline\n    notes (the ``\\\\s#\\\\s`` form won't touch a real ``A[C#]`` label).\"\"\"\n    out = []\n    for line in code.splitlines():\n        if line.lstrip().startswith(\"#\"):\n            continue\n        line = re.sub(r\"\\s+#\\s.*$\", \"\", line)  # strip \" # note\" tails\n        if line.strip():\n            out.append(line)\n    return \"\\n\".join(out).strip()\n\n\ndef validate_mermaid(code: str) -> Tuple[bool, str]:\n    \"\"\"Permissive structural PRE-FILTER for Mermaid source — the authoritative gate\n    is ``render_validate_mermaid`` (mmdc). Calibrated against the real renderer: it\n    only rejects what definitely will not render (no/empty header, no edges,\n    unbalanced subgraph/end, prose instead of code). It deliberately does NOT\n    reject things mmdc actually accepts (dotted ids, `A --|x|--> B` labels); those\n    are quality concerns handled by the prompt + reviewer, not validity. Returns\n    (ok, reason).\"\"\"\n    if not code or not code.strip():\n        return False, \"empty\"\n    lines = [ln.rstrip() for ln in code.strip().splitlines() if ln.strip()]\n    header = lines[0].strip().lower()\n    if not header.startswith(tuple(h.lower() for h in _MERMAID_HEADERS)):\n        return False, f\"no valid diagram header (got: {lines[0][:40]!r})\"\n    body = \"\\n\".join(lines[1:])\n    # balanced subgraph/end\n    n_sub = len(re.findall(r\"^\\s*subgraph\\b\", body, re.MULTILINE))\n    n_end = len(re.findall(r\"^\\s*end\\b\", body, re.MULTILINE))\n    if n_sub != n_end:\n        return False, f\"unbalanced subgraph/end ({n_sub} vs {n_end})\"\n    # a flowchart/graph must have at least one edge/connection\n    if header.startswith((\"flowchart\", \"graph\")):\n        if not re.search(r\"--|==|-\\.|-->|---\", body):\n            return False, \"no edges/connections found\"\n    # crude prose detector: a non-comment line that reads like a sentence\n    for ln in lines[1:]:\n        s = ln.strip()\n        if s.startswith(\"%%\"):\n            continue\n        if s.endswith(\".\") and \" \" in s and not re.search(r\"[\\[\\]{}()|>\\-=]\", s):\n            return False, f\"prose leaked into diagram: {s[:40]!r}\"\n    return True, \"ok\"\n\n\ndef _find_mmdc_cli() -> Optional[str]:\n    \"\"\"Locate the mermaid-cli entry (``cli.js``). Env ``BENNY_MMDC_CLI`` wins;\n    otherwise probe the packaging install. Returns None when unavailable (render\n    validation is an optional dev/build-time gate, not shipped in the runtime).\"\"\"\n    env = os.environ.get(\"BENNY_MMDC_CLI\")\n    if env and Path(env).exists():\n        return env\n    here = Path(__file__).resolve()\n    for parent in here.parents:\n        cand = (\n            parent / \"packaging\" / \"node_modules\" / \"@mermaid-js\" / \"mermaid-cli\" / \"src\" / \"cli.js\"\n        )\n        if cand.exists():\n            return str(cand)\n    return None\n\n\ndef render_validate_mermaid(\n    code: str, *, out_png: Optional[str] = None, timeout: int = 120\n) -> Tuple[bool, str, Optional[str]]:\n    \"\"\"Authoritative 'does it render' check: run mermaid-cli (mmdc) to render the\n    diagram to PNG. Returns (ok, reason, png_path|None). Falls back to (None-ish)\n    when node/mmdc are absent so callers can degrade to structural validation.\"\"\"\n    node = shutil.which(\"node\")\n    cli = _find_mmdc_cli()\n    if not node or not cli:\n        return False, \"mmdc-unavailable\", None\n    tmpdir = Path(tempfile.mkdtemp(prefix=\"mmdc-\"))\n    mmd = tmpdir / \"d.mmd\"\n    png = Path(out_png) if out_png else tmpdir / \"d.png\"\n    png.parent.mkdir(parents=True, exist_ok=True)\n    mmd.write_text(code, encoding=\"utf-8\")\n    try:\n        proc = subprocess.run(\n            [node, cli, \"-i\", str(mmd), \"-o\", str(png)],\n            capture_output=True,\n            text=True,\n            timeout=timeout,\n        )\n        if proc.returncode == 0 and png.exists() and png.stat().st_size > 0:\n            return True, \"rendered\", str(png)\n        err = (proc.stderr or proc.stdout or \"\").strip().splitlines()\n        return (\n            False,\n            \"render-failed: \" + (err[-1][:160] if err else f\"exit {proc.returncode}\"),\n            None,\n        )\n    except subprocess.TimeoutExpired:\n        return False, \"render-timeout\", None\n    except Exception as e:\n        return False, f\"render-error: {e}\", None\n\n\ndef _table_json_to_markdown(table: Dict[str, Any], max_rows: int = 8) -> str:\n    cols = table.get(\"columns\", [])\n    rows = table.get(\"rows\", [])[:max_rows]\n    out = [\n        \"| \" + \" | \".join(str(c) for c in cols) + \" |\",\n        \"| \" + \" | \".join(\"---\" for _ in cols) + \" |\",\n    ]\n    for r in rows:\n        out.append(\"| \" + \" | \".join(\"\" if c is None else str(c) for c in r) + \" |\")\n    return \"\\n\".join(out)\n\n\n# =============================================================================\n# PROMPTS\n# =============================================================================\n\nDIAGRAM_PROMPT = \"\"\"You are converting a TECHNICAL DIAGRAM into Mermaid diagram-as-code.\n\nCONTEXT (caption + surrounding text from the source document):\n{context}\n\nRules:\n- Output ONLY Mermaid code, nothing else. Start with a valid header (flowchart TD / flowchart LR / graph TD).\n- Give each node a SHORT id that is plain alphanumeric with NO dots and NO spaces (e.g. P, A, B, RM).\n- Define each node's label EXACTLY ONCE as `id[Label]` using the EXACT text from the image, then connect using ids ONLY.\n  CORRECT:   A[Architecture Vision]\\n             A --> B\\n             RM[Requirements Management]\\n             RM <--> A\n  WRONG:     A.[Architecture Vision] --> B.[Business Architecture]   (dotted ids, label repeated)\n- Capture EVERY labelled box/node and EVERY arrow, including direction and edge labels (`A -->|label| B`).\n- For a hub/center node connected to all others, define it once and link it to each id.\n- Use `subgraph Name ... end` for visually grouped/nested containers.\n- Do NOT invent nodes not in the image. Do NOT add prose or explanation.\n\nMermaid:\"\"\"\n\nILLUSTRATION_PROMPT = \"\"\"Describe this image in 1-2 factual sentences for a document index.\nCONTEXT: {context}\nBe concrete and specific; do not speculate. Description:\"\"\"\n\nCHART_PROMPT = \"\"\"You are extracting data from a CHART. Output ONLY a JSON object:\n{{\"chart_type\": \"...\", \"title\": \"...\", \"axes\": {{\"x\": \"...\", \"y\": \"...\"}}, \"series\": [{{\"name\": \"...\", \"points\": [[x, y], ...]}}], \"description\": \"one sentence\"}}\nCONTEXT: {context}\nJSON:\"\"\"\n\nREVIEW_PROMPT = \"\"\"You are a meticulous reviewer of diagram-as-code. A vision model converted a\ntechnical diagram into Mermaid. You CANNOT see the image, but you have the diagram's\ncaption and the surrounding document text, which describe what the diagram contains.\n\nDIAGRAM CAPTION + CONTEXT:\n{context}\n\nCANDIDATE MERMAID:\n{mermaid}\n\nAssess strictly and reply in this EXACT XML form (no prose outside it):\n<review>\n  <valid_syntax>true|false</valid_syntax>\n  <score>0-10</score>\n  <missing>comma-separated nodes/edges implied by the context but absent from the Mermaid, or \"none\"</missing>\n  <hallucinated>comma-separated nodes in the Mermaid not supported by the context, or \"none\"</hallucinated>\n  <improved_mermaid>\nA corrected/improved full Mermaid diagram (keep what is right, fix the rest). If the candidate is already good, repeat it.\n  </improved_mermaid>\n</review>\"\"\"\n\n\ndef _fmt(prompt: str, **kw) -> str:\n    return prompt.format(**kw)\n\n\n# =============================================================================\n# MODEL STEPS\n# =============================================================================\n\n\nasync def _vision_call(prompt: str, crop_bytes: bytes, model: str, run_id: Optional[str]) -> str:\n    return await call_model(\n        model=model,\n        messages=vision_message(prompt, crop_bytes),\n        temperature=0.0,\n        max_tokens=1024,\n        workspace_id=\"default\",\n        role=\"vision\",\n        run_id=run_id,\n    )\n\n\nasync def _text_call(prompt: str, model: str, run_id: Optional[str]) -> str:\n    return await call_model(\n        model=model,\n        messages=[{\"role\": \"user\", \"content\": prompt}],\n        temperature=0.0,\n        max_tokens=1024,\n        workspace_id=\"default\",\n        role=\"graph_synthesis\",\n        run_id=run_id,\n    )\n\n\ndef _parse_review(raw: str) -> Dict[str, Any]:\n    def field(tag):\n        m = re.search(rf\"<{tag}>(.*?)</{tag}>\", raw, re.DOTALL | re.IGNORECASE)\n        return m.group(1).strip() if m else \"\"\n\n    score_s = field(\"score\")\n    try:\n        score = float(re.search(r\"[\\d.]+\", score_s).group())\n    except Exception:\n        score = 0.0\n    return {\n        \"valid_syntax\": field(\"valid_syntax\").lower().startswith(\"t\"),\n        \"score\": score,\n        \"missing\": field(\"missing\"),\n        \"hallucinated\": field(\"hallucinated\"),\n        \"improved_mermaid\": extract_code(field(\"improved_mermaid\")),\n    }\n\n\n# =============================================================================\n# ORCHESTRATION\n# =============================================================================\n\n\nasync def describe_element(\n    crop_bytes: bytes,\n    *,\n    label: str = \"picture\",\n    caption: str = \"\",\n    context: str = \"\",\n    vlm_model: str = DEFAULT_VLM,\n    reviewer_model: str = DEFAULT_REVIEWER,\n    max_refine: int = 1,\n    render_check: bool = False,\n    run_id: Optional[str] = None,\n    log_fn: Callable = print,\n) -> Dict[str, Any]:\n    \"\"\"Run the full describe→validate→review→refine ladder for one visual element.\n\n    Returns a surrogate dict: {type, surrogate_kind, content, validated, score,\n    attempts:[...], review:{...}, model_id}. Never raises on a bad generation —\n    degrades to a caption with validated=False.\n    \"\"\"\n    ctx = (caption + \"\\n\" + context).strip() or \"(no surrounding text available)\"\n    kind = classify_visual(label, caption)\n    attempts: List[Dict[str, Any]] = []\n\n    if kind == \"illustration\":\n        desc = await _vision_call(\n            _fmt(ILLUSTRATION_PROMPT, context=ctx), crop_bytes, vlm_model, run_id\n        )\n        return {\n            \"type\": label,\n            \"surrogate_kind\": \"caption\",\n            \"content\": desc.strip(),\n            \"validated\": bool(desc.strip()),\n            \"score\": None,\n            \"attempts\": [],\n            \"model_id\": vlm_model,\n        }\n\n    if kind == \"chart\":\n        raw = await _vision_call(_fmt(CHART_PROMPT, context=ctx), crop_bytes, vlm_model, run_id)\n        js = extract_code(raw, \"json\")\n        ok = js.strip().startswith(\"{\") and js.strip().endswith(\"}\")\n        return {\n            \"type\": label,\n            \"surrogate_kind\": \"chart_json\" if ok else \"caption\",\n            \"content\": js if ok else raw.strip(),\n            \"validated\": ok,\n            \"score\": None,\n            \"attempts\": [],\n            \"model_id\": vlm_model,\n        }\n\n    # --- diagram: the multi-model loop ---\n    # The VISION model always OWNS the topology (it can see the image). The text\n    # reviewer is blind, so it only GUIDES — scores, flags missing/hallucinated/\n    # syntax — which we feed back as a refinement critique. A reviewer-proposed\n    # diagram is kept ONLY as a last resort if no vision attempt ever validates.\n    best: Optional[Dict[str, Any]] = None\n    reviewer_fallback: Optional[Dict[str, Any]] = None\n    review: Dict[str, Any] = {}\n    prompt = _fmt(DIAGRAM_PROMPT, context=ctx)\n\n    for i in range(max_refine + 1):\n        raw = await _vision_call(prompt, crop_bytes, vlm_model, run_id)\n        mermaid = extract_code(raw, \"mermaid\")\n        ok, reason = validate_mermaid(mermaid)\n        # Optional authoritative gate: only count as valid if mmdc actually renders\n        # it (catches everything the structural check can't). Skipped silently when\n        # the renderer isn't installed.\n        if ok and render_check:\n            rok, rreason, _png = render_validate_mermaid(mermaid)\n            if rreason != \"mmdc-unavailable\":\n                ok, reason = rok, (reason if rok else rreason)\n        attempts.append({\"iter\": i, \"valid\": ok, \"reason\": reason, \"chars\": len(mermaid)})\n        log_fn(f\"[describe] diagram attempt {i}: valid={ok} ({reason}) {len(mermaid)} chars\")\n\n        # review with the text model (cross-check vs document text)\n        review_raw = await _text_call(\n            _fmt(REVIEW_PROMPT, context=ctx, mermaid=mermaid), reviewer_model, run_id\n        )\n        review = _parse_review(review_raw)\n        log_fn(\n            f\"[review] score={review['score']} valid_syntax={review['valid_syntax']} \"\n            f\"missing={review['missing'][:60]!r}\"\n        )\n\n        cand = {\n            \"mermaid\": mermaid,\n            \"valid\": ok,\n            \"reason\": reason,\n            \"score\": review[\"score\"],\n            \"review\": review,\n            \"source\": \"vision\",\n        }\n        if (\n            best is None\n            or (ok and not best[\"valid\"])\n            or (ok == best[\"valid\"] and review[\"score\"] > best[\"score\"])\n        ):\n            best = cand\n\n        # capture a VALID reviewer-proposed diagram as fallback only (blind model)\n        improved = review.get(\"improved_mermaid\", \"\")\n        if improved and reviewer_fallback is None and validate_mermaid(improved)[0]:\n            reviewer_fallback = {\n                \"mermaid\": improved,\n                \"valid\": True,\n                \"score\": review[\"score\"],\n                \"review\": review,\n                \"source\": \"reviewer_fallback\",\n            }\n\n        if best[\"valid\"] and review[\"score\"] >= 8:\n            break  # vision attempt is valid and the reviewer is happy\n        if i < max_refine:\n            prompt = (\n                _fmt(DIAGRAM_PROMPT, context=ctx)\n                + f\"\\n\\nYour previous attempt scored {review['score']}/10. FIX these, keeping the layout you can see:\\n\"\n                f\"- missing nodes/edges: {review.get('missing','')}\\n\"\n                f\"- remove if not in image: {review.get('hallucinated','')}\\n\"\n                f\"- syntax issue: {reason if not ok else 'none'}\\n\"\n            )\n\n    chosen = best if (best and best[\"valid\"]) else (reviewer_fallback or best)\n    if chosen and chosen[\"valid\"]:\n        return {\n            \"type\": label,\n            \"surrogate_kind\": \"mermaid\",\n            \"content\": chosen[\"mermaid\"],\n            \"validated\": True,\n            \"score\": chosen[\"score\"],\n            \"attempts\": attempts,\n            \"review\": chosen.get(\"review\", review),\n            \"model_id\": vlm_model,\n            \"source\": chosen.get(\"source\", \"vision\"),\n        }\n\n    # fallback: plain caption (no hollow success)\n    cap = await _vision_call(_fmt(ILLUSTRATION_PROMPT, context=ctx), crop_bytes, vlm_model, run_id)\n    return {\n        \"type\": label,\n        \"surrogate_kind\": \"caption_fallback\",\n        \"content\": cap.strip(),\n        \"validated\": False,\n        \"score\": best[\"score\"] if best else 0.0,\n        \"attempts\": attempts,\n        \"review\": review,\n        \"model_id\": vlm_model,\n    }\n","numLines":488,"startLine":1,"totalLines":488}},"sourceToolAssistantUUID":"aeb87008-38fe-482f-bf57-ca0a2c9e9b35","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"eb427ad4-8c1e-494a-b563-fd2879a365fa","version":"2.1.187","gitBranch":"HEAD"}
