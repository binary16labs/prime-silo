ents\",\n134\t        \"dependencies\": [\"docmodel_extract\"],\n135\t        \"wave\": 1,\n136\t        \"complexity\": \"low\",\n137\t        \"node_type\": \"task\",\n138\t        \"inputs_from\": {\n139\t          \"visual_elements\": { \"source_task\": \"docmodel_extract\", \"emits_key\": \"visual_elements\" }\n140\t        },\n141\t        \"execution\": {\n142\t          \"kind\": \"blocking\",\n143\t          \"request\": {\n144\t            \"method\": \"POST\",\n145\t            \"path\":   \"/api/vision/classify\",\n146\t            \"body\": {\n147\t              \"workspace\": \"${workspace}\",\n148\t              \"threshold\": \"${classify_threshold}\",\n149\t              \"elements\":  \"${inputs.visual_elements}\"\n150\t            },\n151\t            \"timeout\": { \"connect\": 10, \"read\": 600, \"write\": 60, \"pool\": 10 }\n152\t          },\n153\t          \"emits\": { \"typed_elements\": \"$.typed_elements\" }\n154\t        }\n155\t      },\n156\t\n157\t      {\n158\t        \"id\": \"describe_visuals\",\n159\t        \"description\": \"[AGENTIC/VISION] [NEW — VIS-001 Phase 1+2] Run the type-routed describer ladder via the multimodal call_model path: illustration→caption, diagram→${diagram_format} (Mermaid/PlantUML), chart→data-series JSON + description. Content-hash cached — unchanged crops are reused, never re-described.\",\n160\t        \"skill_hint\": \"describe_visuals\",\n161\t        \"assigned_model\": \"${vlm_model}\",\n162\t        \"dependencies\": [\"classify_elements\"],\n163\t        \"wave\": 2,\n164\t        \"complexity\": \"high\",\n165\t        \"node_type\": \"task\",\n166\t        \"inputs_from\": {\n167\t          \"typed_elements\": { \"source_task\": \"classify_elements\", \"emits_key\": \"typed_elements\" }\n168\t        },\n169\t        \"execution\": {\n170\t          \"kind\": \"blocking_with_task_list_fallback\",\n171\t          \"request\": {\n172\t            \"method\": \"POST\",\n173\t            \"path\":   \"/api/vision/describe\",\n174\t            \"body\": {\n175\t              \"workspace\":      \"${workspace}\",\n176\t              \"vlm_model\":      \"${vlm_model}\",\n177\t              \"diagram_format\": \"${diagram_format}\",\n178\t              \"elements\":       \"${inputs.typed_elements}\"\n179\t            },\n180\t            \"timeout\": { \"connect\": 10, \"read\": 2400, \"write\": 60, \"pool\": 10 }\n181\t          },\n182\t          \"fallback_on_timeout\": {\n183\t            \"method\":              \"GET\",\n184\t            \"path\":                \"/api/tasks\",\n185\t            \"params\":              { \"workspace\": \"${workspace}\" },\n186\t            \"timeout_s\":           10,\n187\t            \"filter_type\":         \"vision\",\n188\t            \"sort_by\":             \"updated_at\",\n189\t            \"order\":               \"desc\",\n190\t            \"success_when_status\": [\"completed\", \"complete\", \"done\"],\n191\t            \"success_result\":      { \"status\": \"completed_after_timeout\", \"task_id\": \"$.task_id\", \"message\": \"$.message\" }\n192\t          },\n193\t          \"emits\": { \"surrogates\": \"$.surrogates\" }\n194\t        }\n195\t      },\n196\t\n197\t      {\n198\t        \"id\": \"validate_surrogates\",\n199\t        \"description\": \"[DETERMINISTIC] [NEW — VIS-001 Phase 2] Gate every surrogate: Mermaid/PlantUML must pass a headless parse; chart/table JSON must validate against schema. A surrogate that fails degrades to a plain caption — it is NEVER reported as success (no hollow success).\",\n200\t        \"skill_hint\": \"validate_surrogates\",\n201\t        \"dependencies\": [\"describe_visuals\"],\n202\t        \"wave\": 3,\n203\t        \"complexity\": \"low\",\n204\t        \"node_type\": \"task\",\n205\t        \"inputs_from\": {\n206\t          \"surrogates\": { \"source_task\": \"describe_visuals\", \"emits_key\": \"surrogates\" }\n207\t        },\n208\t        \"execution\": {\n209\