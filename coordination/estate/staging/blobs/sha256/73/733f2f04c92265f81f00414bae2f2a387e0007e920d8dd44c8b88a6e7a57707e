port.md\"],\n350\t        \"execution\": {\n351\t          \"kind\": \"report\",\n352\t          \"stats_request\": {\n353\t            \"method\":    \"GET\",\n354\t            \"path\":      \"/api/graph/stats\",\n355\t            \"params\":    { \"workspace\": \"${workspace}\" },\n356\t            \"timeout_s\": 30\n357\t          },\n358\t          \"output\": {\n359\t            \"path\":        \"${outputs.base_dir}/vision_ingestion_report.md\",\n360\t            \"format\":      \"md\",\n361\t            \"template_id\": \"vision_ingestion_report_default\"\n362\t          }\n363\t        }\n364\t      }\n365\t    ],\n366\t\n367\t    \"edges\": [\n368\t      { \"id\": \"e_doc_classify\",  \"source\": \"docmodel_extract\",    \"target\": \"classify_elements\",   \"label\": \"visual elements\",      \"animated\": true },\n369\t      { \"id\": \"e_classify_desc\", \"source\": \"classify_elements\",   \"target\": \"describe_visuals\",    \"label\": \"typed elements\",       \"animated\": true },\n370\t      { \"id\": \"e_desc_val\",      \"source\": \"describe_visuals\",    \"target\": \"validate_surrogates\", \"label\": \"surrogates\",           \"animated\": true },\n371\t      { \"id\": \"e_val_stitch\",    \"source\": \"validate_surrogates\", \"target\": \"stitch_enriched\",     \"label\": \"validated surrogates\", \"animated\": true },\n372\t      { \"id\": \"e_stitch_rag\",    \"source\": \"stitch_enriched\",     \"target\": \"rag_ingest\",          \"label\": \"enriched docs\",        \"animated\": true },\n373\t      { \"id\": \"e_rag_synth\",     \"source\": \"rag_ingest\",          \"target\": \"deep_synthesis\",      \"label\": \"indexed corpus\",       \"animated\": true },\n374\t      { \"id\": \"e_synth_val\",     \"source\": \"deep_synthesis\",      \"target\": \"validate_vision\",     \"label\": \"figure triples\",       \"animated\": true },\n375\t      { \"id\": \"e_val_report\",    \"source\": \"validate_vision\",     \"target\": \"generate_rep