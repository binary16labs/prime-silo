{"parentUuid":"5bc39f4c-24a9-44fc-94ae-e2b04f0262e2","isSidechain":false,"promptId":"6f58d9f8-96db-45c8-911a-d0087d4ebcee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L6DPFaKfHZLQi1CAHb4s4z","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t//\n3\t// ADR-001 Phase D2 — agent-scope injection tests for runtime-client.js.\n4\t//\n5\t// Stubs window.fetch so the tests never touch a real shell or runtime.\n6\t// Verifies: scope validation, the bound-client factory tags every call,\n7\t// withAgentScope auto-injects on the unbound runtimeFetch, explicit\n8\t// headers win, scope nesting restores correctly, async withAgentScope\n9\t// restores after rejection, and pre-existing helpers (fetchAsAgent,\n10\t// listWidgets) keep working untouched.\n11\t\n12\timport assert from \"node:assert/strict\";\n13\t\n14\timport {\n15\t  runtimeFetch,\n16\t  fetchAsAgent,\n17\t  listWidgets,\n18\t  readRuntimeJson,\n19\t  createAgentRuntimeClient,\n20\t  withAgentScope,\n21\t  getActiveAgentScope,\n22\t  __testing\n23\t} from \"../app/L0/_all/mod/_prime_silo/runtime_client/runtime-client.js\";\n24\t\n25\tasync function main() {\n26\t  __testing.resetAgentScope();\n27\t\n28\t  testScopeValidation();\n29\t  testGetActiveAgentScopeStartsNull();\n30\t  testWithAgentScopeRejectsBadInputs();\n31\t\n32\t  await testRuntimeFetchUnscopedHasNoHeader();\n33\t  await testWithAgentScopeAutoInjectsHeader();\n34\t  await testWithAgentScopeRestoresAfterReturn();\n35\t  await testWithAgentScopeRestoresAfterAsyncReject();\n36\t  await testWithAgentScopeNestingShadowsAndRestores();\n37\t  await testExplicitHeaderWinsOverActiveScope();\n38\t\n39\t  await testCreateAgentRuntimeClientTagsAllCalls();\n40\t  await testCreateAgentRuntimeClientReadOnlyScope();\n41\t  await testCreateAgentRuntimeClientFetchAsAgentOverride();\n42\t  await testCreateAgentRuntimeClientListWidgetsParsesJson();\n43\t\n44\t  await testFetchAsAgentInjectsHeader();\n45\t  await testListWidgetsUnscopedStillWorks();\n46\t\n47\t  await testNon2xxRaisesRuntimeError();\n48\t\n49\t  console.log(\"runtime_client_agent_scope_test: ok\");\n50\t}\n51\t\n52\tfunction installFetchStub(handler) {\n53\t  const original = globalThis.fetch;\n54\t  const calls = [];\n55\t  globalThis.fetch = async (url, init = {}) => {\n56\t    calls.push({ url: String(url), init, headers: extractHeaderMap(init.headers) });\n57\t    return handler(String(url), init, calls);\n58\t  };\n59\t  return {\n60\t    calls,\n61\t    restore() {\n62\t      globalThis.fetch = original;\n63\t    }\n64\t  };\n65\t}\n66\t\n67\tfunction extractHeaderMap(headers) {\n68\t  if (!headers) return {};\n69\t  if (headers instanceof Headers) {\n70\t    const out = {};\n71\t    headers.forEach((value, name) => { out[name.toLowerCase()] = value; });\n72\t    return out;\n73\t  }\n74\t  const out = {};\n75\t  for (const [k, v] of Object.entries(headers)) out[k.toLowerCase()] = v;\n76\t  return out;\n77\t}\n78\t\n79\tfunction jsonResponse(body, status = 200) {\n80\t  return new Response(JSON.stringify(body), {\n81\t    status,\n82\t    headers: { \"content-type\": \"application/json\" }\n83\t  });\n84\t}\n85\t\n86\tfunction testScopeValidation() {\n87\t  // Bound client rejects bad scope synchronously.\n88\t  assert.throws(() => createAgentRuntimeClient(\"admin\"), /Invalid agent scope/);\n89\t  assert.throws(() => createAgentRuntimeClient(\"\"), /Invalid agent scope/);\n90\t  assert.throws(() => createAgentRuntimeClient(undefined), /Invalid agent scope/);\n91\t  // Both valid scopes accepted.\n92\t  const sandbox = createAgentRuntimeClient(\"sandbox\");\n93\t  const readOnly = createAgentRuntimeClient(\"read_only\");\n94\t  assert.equal(sandbox.scope, \"sandbox\");\n95\t  assert.equal(readOnly.scope, \"read_only\");\n96\t}\n97\t\n98\tfunction testGetActiveAgentScopeStartsNull() {\n99\t  __testing.resetAgentScope();\n100\t  assert.equal(getActiveAgentScope(), null);\n101\t}\n102\t\n103\tfunction testWithAgentScopeRejects