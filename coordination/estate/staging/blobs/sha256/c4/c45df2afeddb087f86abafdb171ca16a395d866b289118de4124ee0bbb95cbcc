d\",\n            \"content\": \"# hi\",\n        },\n        headers={\"X-Benny-Agent-Scope\": \"garbage\"},\n    )\n    assert r.status_code == 200\n\n\n# ---------------------------------------------------------------------------\n# Sandbox write route\n# ---------------------------------------------------------------------------\n\n\ndef test_write_sandbox_file_creates_file_and_emits_lineage(client, clean_workspace_root):\n    with patch(\"benny.api.agent_sandbox_routes.emit_agent_authorship\") as mock_emit:\n        r = client.post(\n            \"/api/agent_sandbox/write\",\n            json={\n                \"workspace\": \"ws_a\",\n                \"subdir\": \"drafts\",\n                \"filename\": \"candidate.json\",\n                \"content\": \"{}\",\n                \"agent_id\": \"planner_v1\",\n            },\n        )\n    assert r.status_code == 200, r.text","numLines":90,"startLine":116,"totalLines":347}},"sourceToolAssistantUUID":"a8e26551-0365-43b6-aa9d-eaa9be7dabec","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"f14181cb-e721-4eeb-b987-5560fe28855c","version":"2.1.181","gitBranch":"HEAD"}
