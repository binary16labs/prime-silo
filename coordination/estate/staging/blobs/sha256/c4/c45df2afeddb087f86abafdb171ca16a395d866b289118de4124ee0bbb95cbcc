n.scope, \"sandbox\", \"default scope must match the documented default\");\n46\t    assert.equal(turn.runtimeClient.scope, \"sandbox\");\n47\t    assert.equal(turn.disposed, false);\n48\t  } finally {\n49\t    turn.dispose();\n50\t  }\n51\t}\n52\t\n53\tfunction testMountAgentTurnExplicitScopes() {\n54\t  const sb = mountAgentTurn(\"sandbox\");\n55\t  const ro = mountAgentTurn(\"read_only\");\n56\t  try {\n57\t    assert.equal(sb.scope, \"sandbox\");\n58\t    assert.equal(ro.scope, \"read_only\");\n59\t  } finally {\n60\t    sb.dispose();\n61\t    ro.dispose();\n62\t  }\n63\t}\n64\t\n65\tfunction testMountAgentTurnRejectsBadScope() {\n66\t  assert.throws(() => mountAgentTurn(\"admin\"), /Invalid agent scope/);\n67\t  assert.throws(() => mountAgentTurn(\"\"), /Invalid agent scope/);\n68\t}\n69\t\n70\tfunction testHandleDisposeIdempotent() {\n71\t  const turn = mountAgentTurn(\"sandbox\");\n72\t  assert.equal(turn.disposed, false);\n73\t  turn.dispose();\n74\t  assert.equal(turn.disposed, true);\n75\t  // Calling dispose again must not throw.\n76\t  turn.dispose();\n77\t  assert.equal(turn.disposed, true);\n78\t}\n79\t\n80\tfunction testRuntimeClientShapeMatchesWidgetExpectations() {\n81\t  // Widgets accept an options.runtimeClient with these methods. Any\n82\t  // future change to the bound-client shape that drops one of these\n83\t  // will fail this test before downstream widget tests catch it.\n84\t  const turn = mountAgentTurn(\"sandbox\");\n85\t  try {\n86\t    const c = turn.runtimeClient;\n87\t    assert.equal(typeof c.runtimeFetch, \"function\");\n88\t    assert.equal(typeof c.fetchAsAgent, \"function\");\n89\t    assert.equal(typeof c.readRuntimeJson, \"function\");\n90\t    assert.equal(typeof c.listWidgets, \"function\");\n91\t    assert.equal(typeof c.scope, \"string\");\n92\t  } finally {\n93\t    turn.dispose();\n94\t  }\n95\t}\n96\t\n97\tfunction testMetaConstantStable() {\n98\t  // The exported meta is a soft contract for any consumer that wants to\n99\t  // introspect the module's intent without importing the runtime.\n100\t  assert.equal(typeof __agent_runtime_meta__, \"object\");\n101\t  assert.equal(__agent_runtime_meta__.default_scope, \"sandbox\");\n102\t  assert.equal(typeof __agent_runtime_meta__.schema_version, \"string\");\n103\t}\n104\t\n105\tfunction installFetchStub(handler) {\n106\t  const original = globalThis.fetch;\n107\t  const calls = [];\n108\t  globalThis.fetch = async (url, init = {}) => {\n109\t    calls.push({ url: String(url), init, headers: extractHeaderMap(init.headers) });\n110\t    return handler(String(url), init, calls);\n111\t  };\n112\t  return {\n113\t    calls,\n114\t    restore() {\n115\t      globalThis.fetch = original;\n116\t    }\n117\t  };\n118\t}\n119\t\n120\tfunction extractHeaderMap(headers) {\n121\t  if (!headers) return {};\n122\t  if (headers instanceof Headers) {\n123\t    const out = {};\n124\t    headers.forEach((value, name) => {\n125\t      out[name.toLowerCase()] = value;\n126\t    });\n127\t    return out;\n128\t  }\n129\t  const out = {};\n130\t  for (const [k, v] of Object.entries(headers)) out[k.toLowerCase()] = v;\n131\t  return out;\n132\t}\n133\t\n134\tfunction jsonResponse(body, status = 200) {\n135\t  return new Response(JSON.stringify(body), {\n136\t    status,\n137\t    headers: { \"content-type\": \"application/json\" }\n138\t  });\n139\t}\n140\t\n141\tasync function testBoundClientPutsHeaderOnTheWire() {\n142\t  const stub = installFetchStub(async () => jsonResponse([{ id: \"kg3d.synoptic_web\" }]));\n143\t  try {\n144\t    const turn = mountAgentTurn(\"sandbox\");\n145\t    const widgets = await turn.runtimeClient.listWidgets();\n146\t    assert.deepEqual(widgets, [{ id: \"kg3d.synoptic_web\" }]);\n147\t    assert.equal(stub.calls[0].headers[\"x-benny-agent-scope\"], \"sandbox\");\n148\t    // ADR-003: the bound agent client routes through the agent facade.\n149\t    assert.match(stub.calls[0].url, /\\/api\\/agent-runtime\\/widgets$/);\n150\t    turn.dispose();\n151\t  } finally {\n152\t    stub.restore();\n153\t  }\n154\t}\n155\t\n156\tasync function testBoundClientDoesNotMutateModuleScope() {\n157\t  runtimeClientTesting.resetAgentScope();\n158\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n159\t  try {\n160\t    const turn = mountAgentTurn(\"sandbox\");\n161\t    await turn.runtimeClient.runtimeFetch(\"/widgets\");\n162\t    // Critical: the bound client tags its OWN calls but does NOT touch\n163\t    // the module-level active scope, so unrelated human-driven traffic\n164\t    // happening in parallel doesn't inherit the agent scope.\n165\t    assert.equal(getCurrentAgentScope(), null);\n166\t    turn.dispose();\n167\t  } finally {\n168\t    stub.restore();\n169\t  }\n170\t}\n171\t\n172\tasync function testRunWithAgentContextSetsAndRestores() {\n173\t  runtimeClientTesting.resetAgentScope();\n174\t  let observedInside = null;\n175\t  await runWithAgentContext(\"read_only\", () => {\n176\t    observedInside = getCurrentAgentScope();\n177\t  });\n178\t  assert.equal(observedInside, \"read_only\");\n179\t  assert.equal(getCurrentAgentScope(), null);\n180\t}\n181\t\n182\tasync function testRunWithAgentContextRestoresAfterReject() {\n183\t  runtimeClientTesting.resetAgentScope();\n184\t  await assert.rejects(\n185\t    runWithAgentContext(\"sandbox\", async () => {\n186\t      assert.equal(getCurrentAgentScope(), \"sandbox\");\n187\t      throw new Error(\"turn aborted\");\n188\t    }),\n189\t    /turn aborted/\n190\t  );\n191\t  assert.equal(getCurrentAgentScope(), null);\n192\t}\n193\t\n194\tasync function testGetCurrentAgentScopeMatchesRuntimeClient() {\n195\t  // getCurrentAgentScope is a re-export — assert it's tied to the same\n196\t  // state the runtime client reads.\n197\t  runtimeClientTesting.resetAgentScope();\n198\t  assert.equal(getCurrentAgentScope(), null);\n199\t  await runWithAgentContext(\"sandbox\", () => {\n200\t    assert.equal(getCurrentAgentScope(), \"sandbox\");\n201\t  });\n202\t  assert.equal(getCurrentAgentScope(), null);\n203\t}\n204\t\n205\tmain().catch((err) => {\n206\t  console.error(err);\n207\t  process.exit(1);\n208\t});"},"type":"attachment","uuid":"3b96587e-c024-41a7-b4a4-059221f04f79","timestamp":"2026-06-24T08:40:57.474Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"f14181cb-e721-4eeb-b987-5560fe28855c","version":"2.1.181","gitBranch":"HEAD"}
{"parentUuid":"3b96587e-c024-41a7-b4a4-059221f04f79","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\tests\\runtime_client_agent_scope_test.mjs","snippet":"1\t#!/usr/bin/env node\n2\t//\n3\t// ADR-001 Phase D2 — agent-scope injection tests for runtime-client.js.\n4\t//\n5\t// Stubs window.fetch so the tests never touch a real shell or runtime.\n6\t// Verifies: scope validation, the bound-client factory tags every call,\n7\t// withAgentScope auto-injects on the unbound runtimeFetch, explicit\n8\t// headers win, scope nesting restores correctly, async withAgentScope\n9\t// restores after rejection, and pre-existing helpers (fetchAsAgent,\n10\t// listWidgets) keep working untouched.\n11\t\n12\timport assert from \"node:assert/strict\";\n13\t\n14\timport {\n15\t  runtimeFetch,\n16\t  fetchAsAgent,\n17\t  listWidgets,\n18\t  readRuntimeJson,\n19\t  createAgentRuntimeClient,\n20\t  withAgentScope,\n21\t  getActiveAgentScope,\n22\t  __testing\n23\t} from \"../app/L0/_all/mod/_prime_silo/runtime_client/runtime-client.js\";\n24\t\n25\tasync function main() {\n26\t  __testing.resetAgentScope();\n27\t\n28\t  testScopeValidation();\n29\t  testGetActiveAgentScopeStartsNull();\n30\t  testWithAgentScopeRejectsBadInputs();\n31\t\n32\t  await testRuntimeFetchUnscopedHasNoHeader();\n33\t  await testWithAgentScopeAutoInjectsHeader();\n34\t  await testWithAgentScopeRestoresAfterReturn();\n35\t  await testWithAgentScopeRestoresAfterAsyncReject();\n36\t  await testWithAgentScopeNestingShadowsAndRestores();\n37\t  await testExplicitHeaderWinsOverActiveScope();\n38\t\n39\t  await testCreateAgentRuntimeClientTagsAllCalls();\n40\t  await testCreateAgentRuntimeClientReadOnlyScope();\n41\t  await testCreateAgentRuntimeClientFetchAsAgentOverride();\n42\t  await testCreateAgentRuntimeClientListWidgetsParsesJson();\n43\t\n44\t  await testFetchAsAgentInjectsHeader();\n45\t  await testListWidgetsUnscopedStillWorks();\n46\t\n47\t  await testNon2xxRaisesRuntimeError();\n48\t\n49\t  console.log(\"runtime_client_agent_scope_test: ok\");\n50\t}\n51\t\n52\tfunction installFetchStub(handler) {\n53\t  const original = globalThis.fetch;\n54\t  const calls = [];\n55\t  globalThis.fetch = async (url, init = {}) => {\n56\t    calls.push({ url: String(url), init, headers: extractHeaderMap(init.headers) });\n57\t    return handler(String(url), init, calls);\n58\t  };\n59\t  return {\n60\t    calls,\n61\t    restore() {\n62\t      globalThis.fetch = original;\n63\t    }\n64\t  };\n65\t}\n66\t\n67\tfunction extractHeaderMap(headers) {\n68\t  if (!headers) return {};\n69\t  if (headers instanceof Headers) {\n70\t    const out = {};\n71\t    headers.forEach((value, name) => {\n72\t      out[name.toLowerCase()] = value;\n73\t    });\n74\t    return out;\n75\t  }\n76\t  const out = {};\n77\t  for (const [k, v] of Object.entries(headers)) out[k.toLowerCase()] = v;\n78\t  return out;\n79\t}\n80\t\n81\tfunction jsonResponse(body, status = 200) {\n82\t  return new Response(JSON.stringify(body), {\n83\t    status,\n84\t    headers: { \"content-type\": \"application/json\" }\n85\t  });\n86\t}\n87\t\n88\tfunction testScopeValidation() {\n89\t  // Bound client rejects bad scope synchronously.\n90\t  assert.throws(() => createAgentRuntimeClient(\"admin\"), /Invalid agent scope/);\n91\t  assert.throws(() => createAgentRuntimeClient(\"\"), /Invalid agent scope/);\n92\t  assert.throws(() => createAgentRuntimeClient(undefined), /Invalid agent scope/);\n93\t  // Both valid scopes accepted.\n94\t  const sandbox = createAgentRuntimeClient(\"sandbox\");\n95\t  const readOnly = createAgentRuntimeClient(\"read_only\");\n96\t  assert.equal(sandbox.scope, \"sandbox\");\n97\t  assert.equal(readOnly.scope, \"read_only\");\n98\t}\n99\t\n100\tfunction testGetActiveAgentScopeStartsNull() {\n101\t  __testing.resetAgentScope();\n102\t  assert.equal(getActiveAgentScope(), null);\n103\t}\n104\t\n105\tfunction testWithAgentScopeRejectsBadInputs() {\n106\t  assert.throws(() => withAgentScope(\"nope\", () => 1), /Invalid agent scope/);\n107\t  assert.throws(() => withAgentScope(\"sandbox\", \"not a function\"), /must be a function/);\n108\t}\n109\t\n110\tasync function testRuntimeFetchUnscopedHasNoHeader() {\n111\t  __testing.resetAgentScope();\n112\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n113\t  try {\n114\t    await runtimeFetch(\"/widgets\");\n115\t    assert.equal(stub.calls.length, 1);\n116\t    assert.equal(stub.calls[0].headers[\"x-benny-agent-scope\"], undefined);\n117\t    assert.match(stub.calls[0].url, /\\/api\\/runtime\\/widgets$/);\n118\t  } finally {\n119\t    stub.restore();\n120\t  }\n121\t}\n122\t\n123\tasync function testWithAgentScopeAutoInjectsHeader() {\n124\t  __testing.resetAgentScope();\n125\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n126\t  try {\n127\t    await withAgentScope(\"sandbox\", () => runtimeFetch(\"/widgets\"));\n128\t    assert.equal(stub.calls.length, 1);\n129\t    assert.equal(stub.calls[0].headers[\"x-benny-agent-scope\"], \"sandbox\");\n130\t  } finally {\n131\t    stub.restore();\n132\t  }\n133\t  // Scope is gone after the block.\n134\t  assert.equal(getActiveAgentScope(), null);\n135\t}\n136\t\n137\tasync function testWithAgentScopeRestoresAfterReturn() {\n138\t  __testing.resetAgentScope();\n139\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n140\t  try {\n141\t    await withAgentScope(\"read_only\", async () => {\n142\t      assert.equal(getActiveAgentScope(), \"read_only\");\n143\t      await runtimeFetch(\"/widgets\");\n144\t    });\n145\t    assert.equal(getActiveAgentScope(), null);\n146\t  } finally {\n147\t    stub.restore();\n148\t  }\n149\t}\n150\t\n151\tasync function testWithAgentScopeRestoresAfterAsyncReject() {\n152\t  __testing.resetAgentScope();\n153\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n154\t  try {\n155\t    await assert.rejects(\n156\t      withAgentScope(\"sandbox\", async () => {\n157\t        assert.equal(getActiveAgentScope(), \"sandbox\");\n158\t        throw new Error(\"agent boom\");\n159\t      }),\n160\t      /agent boom/\n161\t    );\n162\t    // Critically: scope restored even though fn() rejected.\n163\t    assert.equal(getActiveAgentScope(), null);\n164\t  } finally {\n165\t    stub.restore();\n166\t  }\n167\t}\n168\t\n169\tasync function testWithAgentScopeNestingShadowsAndRestores() {\n170\t  __testing.resetAgentScope();\n171\t  const observed = [];\n172\t  const stub = installFetchStub(async (_url, init) => {\n173\t    observed.push(extractHeaderMap(init.headers)[\"x-benny-agent-scope\"] || null);\n174\t    return jsonResponse({ ok: true });\n175\t  });\n176\t  try {\n177\t    await withAgentScope(\"sandbox\", async () => {\n178\t      await runtimeFetch(\"/a\");\n179\t      await withAgentScope(\"read_only\", async () => {\n180\t        await runtimeFetch(\"/b\");\n181\t      });\n182\t      // Outer scope restored after inner block.\n183\t      await runtimeFetch(\"/c\");\n184\t    });\n185\t    assert.deepEqual(observed, [\"sandbox\", \"read_only\", \"sandbox\"]);\n186\t    assert.equal(getActiveAgentScope(), null);\n187\t  } finally {\n188\t    stub.restore();\n189\t  }\n190\t}\n191\t\n192\tasync function testExplicitHeaderWinsOverActiveScope() {\n193\t  __testing.resetAgentScope();\n194\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n195\t  try {\n196\t    await withAgentScope(\"sandbox\", () =>\n197\t      runtimeFetch(\"/widgets\", { headers: { \"X-Benny-Agent-Scope\": \"read_only\" } })\n198\t    );\n199\t    // Caller's explicit header is preserved — ambient context does not\n200\t    // override an intentional value.\n201\t    assert.equal(stub.calls[0].headers[\"x-benny-agent-scope\"], \"read_only\");\n202\t  } finally {\n203\t    stub.restore();\n204\t  }\n205\t}\n206\t\n207\tasync function testCreateAgentRuntimeClientTagsAllCalls() {\n208\t  __testing.resetAgentScope();\n209\t  const stub = installFetchStub(async () => jsonResponse({ ok: true }));\n210\t  try {\n211\t    const client = createAgentRuntimeClient(\"sandbox\");\n212\t    await client.runtimeFetch(\"/agent_sandbox/health\");\n213\t    await client.fetchAsAgent(\"/agent_sandbox/write\", { method: \"POST\" });\n214\t    assert.equal(stub.calls[0].headers[\"x-benny-agent-scope\"], \"sandbox\");\n215\t    assert.equal(stub.calls[1].headers[\"x-benny-agent-scope\"], \"sandbox\");\n216\t    // ADR-003: scoped agent calls route through the dedicated agent facade.\n217\t    assert.match(stub.calls[0].url, /\\/api\\/agent-runtime\\/agent_sandbox\\/health$/);\n218\t    assert.match(stub.calls[1].url, /\\/api\\/agent-runtime\\/agent_sandbox\\/write$/);\n219\t    // Bound client must NOT pollute the module-level active scope.\n220\t    assert.equal(getActiveAgentScope(), null);\n221\t  } finally {\n\n... [95 lines truncated] ..."},"type":"attachment","uuid":"63f9474a-accd-4673-9fca-8be8796f1f50","timestamp":"2026-06-24T08:40:57.474Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"f14181cb-e721-4eeb-b987-5560fe28855c","version":"2.1.181","gitBranch":"HEAD"}
{"parentUuid":"63f9474a-accd-4673-9fca-8be8796f1f50","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\architecture\\ADR-003-agent-scope-credential-binding.md","snippet":"1\t# ADR-003 — Credential-bound agent scope (confused-deputy fix)\n2\t\n3\t- **Status:** Accepted (partial — see Residual Gap)\n4\t- **Date:** 2026-06-24\n5\t- **Supersedes the enforcement mechanism of:** [ADR-001](../runtime/architecture/ADR-001-prime-silo-shell-fork.md) determinism boundary\n6\t- **Related code:** `server/lib/runtime_proxy.js`, `server/lib/service_proxy.js`, `server/router/router.js`, `runtime/benny/api/agent_scope.py`, `app/L0/_all/mod/_prime_silo/runtime_client/runtime-client.js`\n7\t\n8\t## Context\n9\t\n10\tADR-001 introduced a determinism boundary: the in-browser agent runtime has full\n11\t_read_ access to Benny but its _writes_ are confined to `/api/agent_sandbox/`.\n12\tThat boundary was enforced entirely by a client-set header,\n13\t`X-Benny-Agent-Scope`, that the browser's agent runtime _voluntarily_ attached.\n14\t\n15\tA code review flagged this as a classic **confused-deputy / privilege\n16\tescalation** vulnerability:\n17\t\n18\t- The space-agent shell proxy injects the trusted `X-Benny-API-Key` on every\n19\t  `/api/runtime/*` call, so the request reaches Benny fully trusted.\n20\t- The proxy then **forwarded the client's `X-Benny-Agent-Scope` unchanged**.\n21\t- Therefore any authenticated caller (or agent-generated code) could simply\n22\t  **omit or alter** the scope header and reach Benny with full, unscoped trust —\n23\t  executing arbitrary swarm/graph/config mutations the sandbox was meant to deny.\n24\t\n25\tTwo further facts sharpened the problem:\n26\t\n27\t1. There is no agent-vs-human identity in the auth layer (`request_context.js`\n28\t   has no role/scope field), so the proxy cannot \"derive scope from RBAC.\"\n29\t2. Benny's `GovernanceMiddleware` is currently disabled (`server.py`), so the\n30\t   API key is not even validated — the scope header was the _only_ gate.\n31\t\n32\t## Decision\n33\t\n34\t**Bind scope to a server-injected credential, never to a client header.**\n35\t\n36\t### Two proxy facades (`server/lib/runtime_proxy.js`)\n37\t\n38\t| Facade | Path                   | Injects                         | Scope                                                                   |\n39\t| ------ | ---------------------- | ------------------------------- | ----------------------------------------------------------------------- |\n40\t| Human  | `/api/runtime/*`       | `BENNY_API_KEY` (trusted)       | client `X-Benny-Agent-Scope` **stripped** → normal RBAC                 |\n41\t| Agent  | `/api/agent-runtime/*` | `BENNY_AGENT_API_KEY` (sandbox) | `X-Benny-Agent-Scope: sandbox` **forced**, overwriting any client value |\n42\t\n43\tHeader filtering and stream piping are centralised in\n44\t`server/lib/service_proxy.js` so the \"drop these client headers, set these\n45\tserver headers\" decision lives in exactly one place.\n46\t\n47\t### Server-side enforcement (`runtime/benny/api/agent_scope.py`)\n48\t\n49\t`AgentScopeMiddleware` now computes an **effective scope** = the _most\n50\trestrictive_ of (a) the scope implied by the authenticating key — the sandbox\n51\tagent key pins the request to `sandbox` — and (b) the header scope. A caller can\n52\tonly **narrow** its confinement (`sandbox → read_only`), never widen it. The\n53\tboundary therefore holds even if the header is forged or the proxy is\n54\tmisconfigured.\n55\t\n56\t### Client routing (`runtime-client.js`)\n57\t\n58\tThe browser runtime client routes to the agent facade automatically whenever an\n59\tagent scope is active (`withAgentScope` / `fetchAsAgent` / a bound client) and to\n60\tthe human facade otherwise. The scope header is still sent for audit/back-compat,\n61\tbut the proxy is authoritative.\n62\t\n63\t### Credential hygiene\n64\t\n65\tThe hardcoded `DEFAULT_BENNY_API_KEY = \"benny-mesh-2026-auth\"` fallback is gone.\n66\tKeys resolve from env with dev-only fallbacks; in production\n67\t(`NODE_ENV=production`) `assertRuntimeProxyConfig()` throws at startup if\n68\t`BENNY_API_KEY` or `BENNY_AGENT_API_KEY` is missing. Set both to the same secret\n69\tin the Benny process and the shell process.\n70\t\n71\t## Residual Gap (why status is \"partial\")\n72\t\n73\tBoth facades are **same-origin**. In-page JavaScript — including agent-generated\n74\tcode — can still _choose_ to call `/api/runtime/*` (the human path) instead of\n75\t`/api/agent-runtime/*`. The credential binding makes scope unforgeable _given a\n76\tpath_, but it does not stop code from selecting the privileged path.\n77\t\n78\tMaking the boundary truly unbypassable requires the agent runtime to execute\n79\t**isolated from human JS** — e.g. a sandboxed Web Worker or cross-origin iframe\n80\twhose only channel to Benny is a broker that can reach the agent facade alone,\n81\twith CSP denying direct `/api/runtime` access. That is a larger change to the\n82\tspace-agent trust model and is tracked as the ADR-001 follow-up.\n83\t\n84\tUntil then, this ADR delivers: (1) scope can no longer be forged by tampering\n85\twith a header, (2) human and agent traffic carry distinct, scoped credentials,\n86\tand (3) no shipped default key in production.\n87\t\n88\t## Consequences\n89\t\n90\t- `tests/runtime_proxy_test.mjs` updated: the human facade now _strips_ the\n91\t  client scope; a new test asserts the agent facade forces sandbox + the agent\n92\t  key.\n93\t- Existing `runtime/tests/api/test_agent_sandbox.py` behaviour is preserved\n94\t  (those tests never send the agent key, so header-based behaviour is unchanged).\n95\t- Deployments must provision two secrets; see `docker-compose.yml` / DEVOPS.md."},"type":"attachment","uuid":"5e6f24cc-ed17-46a7-9969-6894ae193ea1","timestamp":"2026-06-24T08:40:57.474Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"f14181cb-e721-4eeb-b987-5560fe28855c","version":"2.1.181","gitBranch":"HEAD"}
