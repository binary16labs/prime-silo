ions.pinnedBy;\n421\t  }\n422\t  const response = await runtimeFetch(\"/views/pin\", {\n423\t    method: \"POST\",\n424\t    headers: { \"Content-Type\": \"application/json\" },\n425\t    body: JSON.stringify(payload)\n426\t  });\n427\t  return readRuntimeJson(response);\n428\t}\n429\t\n430\t/**\n431\t * Phase F2b — read a pinned view AND verify its embedded signature in one\n432\t * round-trip.\n433\t *\n434\t * GETs ``/api/views/load/<workspace>/<filename>``. The runtime reads\n435\t * ``$BENNY_HOME/workspaces/<ws>/views/<filename>``, extracts the\n436\t * ``signature`` field embedded by ``pinView``, recomputes the HMAC against\n437\t * the rest of the canonical payload, and returns:\n438\t *\n439\t *   {\n440\t *     workspace, filename, relative_path, bytes,\n441\t *     view: { …, signature: {algorithm, value, signed_at} },\n442\t *     signature: { algorithm, value, signed_at } | null,\n443\t *     valid: boolean\n444\t *   }\n445\t *\n446\t * ``valid: false`` is NOT an HTTP error — the caller is expected to branch\n447\t * on it. A missing or malformed inline signature surfaces as ``valid: false``\n448\t * with ``signature: null``; structural problems (no such file, body is not\n449\t * JSON, body is not an object) surface as HTTP 404 / 400.\n450\t *\n451\t * Reads are unrestricted by ``AgentScopeMiddleware`` so this works from any\n452\t * caller — human, bound agent client, or anonymous shell. The runtime is\n453\t * the only holder of ``BENNY_HMAC_KEY``; the browser never re-signs and\n454\t * never trusts a client-side check.\n455\t *\n456\t * @param {string} workspace\n457\t * @param {string} filename\n458\t * @param {{ }} [options]\n459\t * @returns {Promise<{\n460\t *   workspace: string,\n461\t *   filename: string,\n462\t *   relative_path: string,\n463\t *   bytes: number,\n464\t *   view: object,\n465\t *   signature: {algorithm: string, value: string, signed_at: string} | null,\n466\t *   valid: boolean\n467\t * }>}\n468\t */\n469\texport async function loadPinnedView(workspace, filename, options = {}) {\n470\t  if (typeof workspace !== \"string\" || !workspace) {\n471\t    throw new Error(\"loadPinnedView: workspace is required.\");\n472\t  }\n473\t  if (typeof filename !== \"string\" || !filename) {\n474\t    throw new Error(\"loadPinnedView: filename is required.\");\n475\t  }\n476\t  const path = `/views/load/${encodeURIComponent(workspace)}/${encodeURIComponent(filename)}`;\n477\t  const response = await runtimeFetch(path);\n478\t  return readRuntimeJson(response);\n479\t}\n480\t\n481\tfunction serialiseViewContent(content) {\n482\t  if (typeof content === \"string\") {\n483\t    return content;\n484\t  }\n485\t  if (content === null || content === undefined) {\n486\t    throw new Error(\"saveView: content must be a JSON string or a JSON-serialisable object.\");\n487\t  }\n488\t  return JSON.stringify(content);\n489\t}\n490\t\n491\t/**\n492\t * Phase D2 — synchronous agent-scope context.\n493\t *\n494\t * Sets the active agent scope for the duration of `fn()` and restores the\n495\t * previous scope on return. Browsers don't have AsyncLocalStorage, so the\n496\t * scope only auto-applies for the synchronous code path inside `fn` —\n497\t * including the *first* await on `runtimeFetch`. Once `fn` resolves, the\n498\t * scope is gone. For long-running agent loops, use\n499\t * `createAgentRuntimeClient(scope)` and pass the bound client through.\n500\t *\n501\t * Nesting works: inner scopes shadow outer scopes and the outer scope is\n502\t * restored when the inner block returns.\n503\t *\n504\t * @param {\"sandbox\"|\"read_only\"} scope\n505\t * @param {() => T | Promise<T>} fn\n506\t * @returns {T | Promise<T>}\n507\t */\n508\texport function withAgentScope(scope, fn) {\n509\t  validateScope(scope);\n510\t  if (typeof fn !== \"function\") {\n511\t    throw new Error(\"withAgentScope: fn must be a function.\");\n512\t  }\n513\t  const previous = _activeAgentScope;\n514\t  _activeAgentScope = scope;\n515\t