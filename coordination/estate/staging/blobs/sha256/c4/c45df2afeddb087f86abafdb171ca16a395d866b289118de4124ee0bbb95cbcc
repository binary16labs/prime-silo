----------------------------------------------------------------------\n45\t\n46\tfunction installFetchStub(handler) {\n47\t  const calls = [];\n48\t  const original = globalThis.fetch;\n49\t  globalThis.fetch = async (url, init = {}) => {\n50\t    const callRecord = {\n51\t      url: String(url),\n52\t      method: (init.method || \"GET\").toUpperCase(),\n53\t      init,\n54\t      headers: extractHeaderMap(init.headers),\n55\t      body: init.body,\n56\t    };\n57\t    calls.push(callRecord);\n58\t    return handler(String(url), init, calls);\n59\t  };\n60\t  return {\n61\t    calls,\n62\t    restore() { globalThis.fetch = original; },\n63\t  };\n64\t}\n65\t\n66\tfunction extractHeaderMap(headers) {\n67\t  if (!headers) return {};\n68\t  if (headers instanceof Headers) {\n69\t    const out = {};\n70\t    headers.forEach((value, name) => { out[name.toLowerCase()] = value; });\n71\t    return out;\n72\t  }\n73\t  const out = {};\n74\t  for (const [k, v] of Object.entries(headers)) out[k.toLowerCase()] = v;\n75\t  return out;\n76\t}\n77\t\n78\tfunction jsonResponse(body, status = 200) {\n79\t  return new Response(JSON.stringify(body), {\n80\t    status,\n81\t    headers: { \"content-type\": \"application/json\" },\n82\t  });\n83\t}\n84\t\n85\tfunction makeHistory(messageCount) {\n86\t  return Array.from({ length: messageCount }, (_, i) => ({\n87\t    role: i % 2 === 0 ? \"user\" : \"assistant\",\n88\t    content: `message ${i}`,\n89\t  }));\n90\t}\n91\t\n92\t// ---------------------------------------------------------------------------\n93\t// compactHistoryForCheckpoint\n94\t// ---------------------------------------------------------------------------\n95\t\n96\tasync function testCompactPassesThroughSmallHistory() {\n97\t  const history = makeHistory(5);\n98\t  const result = await compactHistoryForCheckpoint(history, {});\n99\t  assert.deepEqual(result, history);\n100\t  console.log(\"  ✓ compactHistoryForCheckpoint passes through small history\");\n101\t}\n102\t