s the trusted\n99\t  // edge; downstream RBAC fires per route inside Benny.\n100\t  headers.set(\"X-Benny-API-Key\", getBennyApiKey());\n101\t\n102\t  return headers;\n103\t}\n104\t\n105\tfunction streamRequestBody(req) {\n106\t  if (METHODS_WITHOUT_BODY.has(String(req.method).toUpperCase())) {\n107\t    return undefined;\n108\t  }\n109\t  // Node IncomingMessage is a Readable stream; convert to a Web stream so\n110\t  // fetch() can consume it without buffering the whole body.\n111\t  return Readable.toWeb(req);\n112\t}\n113\t\n114\tfunction copyResponseHeaders(upstreamResponse, res) {\n115\t  upstreamResponse.headers.forEach((value, name) => {\n116\t    if (RESPONSE_HEADERS_TO_STRIP.has(name.toLowerCase())) {\n117\t      return;\n118\t    }\n119\t    res.setHeader(name, value);\n120\t  });\n121\t}\n122\t\n123\tasync function pipeResponseBody(upstreamResponse, res) {\n124\t  if (!upstreamResponse.body) {\n125\t    res.end();\n126\t    return;\n127\t  }\n128\t  const nodeStream = Readable.fromWeb(upstreamResponse.body);\n129\t  nodeStream.on(\"error\", (err) => {\n130\t    res.destroy(err);\n131\t  });\n132\t  nodeStream.pipe(res);\n133\t}\n134\t\n135\t/**\n136\t * Handle a /api/runtime/<path> request by proxying it to the Benny runtime.\n137\t * Returns a promise that resolves once the response has been fully streamed.\n138\t */\n139\texport async function proxyToRuntime(req, res, requestUrl) {\n140\t  const upstreamUrl = buildUpstreamUrl(requestUrl);\n141\t  const headers = buildUpstreamHeaders(req.headers);\n142\t  const body = streamRequestBody(req);\n143\t\n144\t  let upstreamResponse;\n145\t  try {\n146\t    upstreamResponse = await fetch(upstreamUrl, {\n147\t      method: req.method,\n148\t      headers,\n149\t      body,\n150\t      // Allows fetch to stream a request body in Node 20+/22 without\n151\t      // requiring Content-Length.\n152\t      duplex: body ? \"half\" : undefined,\n153\t      redirect: \"manual\"\n154\t    });\n155\t  } catch (err) {\n156