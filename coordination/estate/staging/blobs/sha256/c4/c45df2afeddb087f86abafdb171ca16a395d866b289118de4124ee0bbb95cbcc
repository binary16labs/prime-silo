{"parentUuid":"7eb2e2be-2063-403f-a82e-eec159085a3a","isSidechain":false,"promptId":"6f58d9f8-96db-45c8-911a-d0087d4ebcee","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014ACvpb14HRYF7oMm1kEVPK","type":"tool_result","content":"1\t// Phase M1 — Memo-Ray memory-graph proxy.\n2\t//\n3\t// Forwards /api/memoray/<path> requests from the space-agent shell to the\n4\t// Memo-Ray Express server (default http://127.0.0.1:3030). Memo-Ray is the\n5\t// memory graph of the cognitive mesh — the third first-class graph beside\n6\t// the knowledge graph (documents) and code graph (AST). The shell page,\n7\t// the onscreen-agent `memory-recall` skill, and the `node space memory`\n8\t// CLI all consume Memo-Ray through this one chokepoint, so the endpoint\n9\t// is configurable in exactly one place.\n10\t//\n11\t// The integration is declared in manifests/integrations/memoray.integration.json\n12\t// (schema aamp.integration/1); this module is the `shell_proxy` node of that\n13\t// manifest's process map. Drift between this file and the manifest is a\n14\t// conformance finding (`GET /api/integration_audit`).\n15\t//\n16\t// The proxy:\n17\t//   • Strips the /api/memoray prefix: /api/memoray/beta/overview\n18\t//     → <base>/api/beta/overview.\n19\t//   • Whitelists methods: GET on any path, POST only on /files/open\n20\t//     (Memo-Ray validates open targets against its indexed lineage\n21\t//     server-side — paths outside the memory graph get a 403 upstream).\n22\t//     Everything else → 405.\n23\t//   • Returns 404 {error:\"memoray_disabled\"} when MEMORAY_ENABLED is off,\n24\t//     502 {error:\"memoray_unreachable\"} with a boot hint when the upstream\n25\t//     is down — the page renders both as friendly first-class screens.\n26\t//   • Server-to-server fetch carries no Origin header, so Memo-Ray's\n27\t//     localhost-only CORS policy never applies; browser callers stay on\n28\t//     the shell origin.\n29\t//\n30\t// Configuration resolution per key (most specific wins):\n31\t//   1. Runtime params MEMORAY_ENABLED / MEMORAY_BASE_URL when set by a\n32\t//      launch arg, stored .env value, or process env (commands/params.yaml\n33\t//      owns the schema; `node space get/set MEMORAY_BASE_URL` manages it).\n34\t//   2. The wizard manifest prime-silo.config.json `memoray` block.\n35\t//   3. The app-registry lockfile (apps.lock.json) — the port the resolver\n36\t//      assigned memo-ray on this machine, so a port change propagates without\n37\t//      touching prime-silo config.\n38\t//   4. Defaults: enabled, http://127.0.0.1:3030.\n39\t\n40\timport fs from \"node:fs/promises\";\n41\timport path from \"node:path\";\n42\timport { Readable } from \"node:stream\";\n43\t\n44\timport { lockServiceUrl } from \"./registry_lock.js\";\n45\t\n46\tconst MEMORAY_PATH_PREFIX = \"/api/memoray\";\n47\t\n48\tconst DEFAULT_MEMORAY_BASE_URL = \"http://127.0.0.1:3030\";\n49\tconst DEFAULT_MEMORAY_ENABLED = true;\n50\t\n51\tconst CONFIG_MANIFEST_FILENAME = \"prime-silo.config.json\";\n52\t\n53\t// Memo-Ray's only mutating endpoint the shell is allowed to reach. Opening\n54\t// a file is lineage-validated upstream; nothing else may POST through.\n55\tconst POST_PATH_WHITELIST = new Set([\"/files/open\"]);\n56\t\n57\t// Mirrors server/lib/runtime_proxy.js so proxy behaviour stays consistent.\n58\tconst UPSTREAM_REQUEST_HEADERS_TO_STRIP = new Set([\n59\t  \"accept-encoding\",\n60\t  \"connection\",\n61\t  \"content-length\",\n62\t  \"cookie\",\n63\t  \"host\",\n64\t  \"keep-alive\",\n65\t  \"origin\",\n66\t  \"proxy-authenticate\",\n67\t  \"proxy-authorization\",\n68\t  \"referer\",\n69\t  \"te\",\n70\t  \"trailer\",\n71\t  \"transfer-encoding\",\n72\t  \"upgrade\"\n73\t]);\n74\t\n75\tconst RESPONSE_HEADERS_TO_STRIP = new Set([\n76\t  \"connection\",\n77\t  \"content-encoding\",\n78\t  \"content-length\",\n79\t  \"set-cookie\",\n80\t  \"set-cookie2\",\n81\t  \"transfer-encoding\"\n82\t]);\n83\t\n84\tconst METHODS_WITHOUT_BODY