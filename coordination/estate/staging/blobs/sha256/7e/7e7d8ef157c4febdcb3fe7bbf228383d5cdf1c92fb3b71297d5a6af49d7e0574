"ids\"] == [\"k2\"]\n    assert got[\"documents\"] == [\"two\"]\n    assert got[\"metadatas\"] == [{\"i\": 2}]\n\n    everything = collection.get()\n    assert sorted(everything[\"ids\"]) == [\"k1\", \"k2\"]\n\n\ndef test_string_ids_survive_reopen(tmp_path, rng):\n    col = S16Collection(tmp_path, name=\"knowledge\", ndim=64, index_backend=\"brute\")\n    embs = seeded(2, rng)\n    col.add(ids=[\"persist-me\", \"and-me\"], embeddings=embs, documents=[\"p\", \"q\"])\n    col.persist()\n    col.close()\n\n    reopened = S16Collection(tmp_path, name=\"knowledge\")\n    out = reopened.query(query_embeddings=[embs[0]], n_results=1)\n    assert out[\"ids\"][0][0] == \"persist-me\"\n    reopened.close()\n\n\ndef test_toggle_env_values():\n    assert not is_enabled({})\n    assert not is_enabled({ENV_VAR: \"chroma\"})\n    for value in (\"s16\", \"1\", \"true\", \"YES\"):\n        assert is_enabled({ENV_VAR: value})\n\n\ndef test_resolve_collection_off_returns_none(tmp_path):\n    assert resolve_collection(tmp_path, env={}) is None\n    assert resolve_collection(tmp_path, env={ENV_VAR: \"0\"}) is None\n\n\ndef test_resolve_collection_on_returns_s16(tmp_path, rng):\n    col = resolve_collection(\n        tmp_path, name=\"knowledge\", env={ENV_VAR: \"s16\"}, ndim=64, index_backend=\"brute\"\n    )\n    assert isinstance(col, S16Collection)\n    col.add(ids=[\"t\"], embeddings=seeded(1, rng), documents=[\"toggled\"])\n    assert col.count() == 1\n    col.close()\n","structuredPatch":[{"oldStart":1,"oldLines":10,"newStart":1,"newLines":26,"lines":[" import numpy as np"," import pytest"," ","-from s16.chroma_compat import S16Collection","+from s16.chroma_compat import S16Collection, _matches"," from s16.toggle import ENV_VAR, is_enabled, resolve_collection"," "," ","+class FakeEF:","+    \"\"\"Deterministic text->vector stub standing in for LocalEmbeddingFunction.\"\"\"","+","+    def __init__(self, ndim=64):","+        self.ndim = ndim","+        self.calls = 0","+","+    def _