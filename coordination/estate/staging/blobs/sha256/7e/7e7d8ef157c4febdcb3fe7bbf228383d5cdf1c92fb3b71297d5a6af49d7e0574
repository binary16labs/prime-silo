 return sum(f.stat().st_size for f in path.rglob(\"*\") if f.is_file())\n\n\ndef bench_backend(backend: str, vectors, payloads, queries, truth) -> dict:\n    path = OUT_DIR / backend\n    if path.exists():\n        shutil.rmtree(path)\n\n    store = S16KnowledgeStore(path, ndim=NDIM, index_backend=backend, oversample=8)\n    t0 = time.perf_counter()\n    store.put_many(\n        [(i, vectors[i], payloads[i], {\"doc\": i}) for i in range(N_DOCS)]\n    )\n    ingest_s = time.perf_counter() - t0\n    store.persist()\n\n    latencies, recalls = [], []\n    for q, expected in zip(queries, truth):\n        t0 = time.perf_counter()\n        hits = store.search(q, k=K)\n        latencies.append((time.perf_counter() - t0) * 1000)\n        recalls.append(len({k for k, _ in hits} & expected) / K)\n\n    kv_bytes = dir_size(path / \"kv\")\n    index_file = path / store._index_filename()\n    result = {\n        \"backend\": backend,\n        \"docs\": N_DOCS,\n        \"ndim\": NDIM,\n        \"ingest_seconds\": round(ingest_s, 2),\n        \"ingest_docs_per_second\": round(N_DOCS / ingest_s, 1),\n        \"search_ms_p50\": round(float(np.percentile(latencies, 50)), 2),\n        \"search_ms_p95\": round(float(np.percentile(latencies, 95)), 2),\n        \"recall_at_10\": round(float(np.mean(recalls)), 4),\n        \"disk_kv_mb\": round(kv_bytes / 2**20, 1),\n        \"disk_index_mb\": round(index_file.stat().st_size / 2**20, 2),\n    }\n    store.close()\n    return result\n\n\ndef main() -> None:\n    rng = np.random.default_rng(1616)\n    print(f\"[bench] corpus: {N_DOCS} docs x {NDIM} dims, 32 clusters\")\n    vectors, payloads, _ = make_clustered_corpus(\n        rng, n_docs=N_DOCS, ndim=NDIM, n_clusters=32\n    )\n    qids = rng.integers(0, N_DOCS, size=N_QUERIES)\n    queries = vectors[qids] + 0.05 * rng.standard_normal((N_QUERIES, NDIM)).astype(\n        np.float32\n    )\n\n    print(\"[bench] exact float ground truth…\")\n    truth = []\n    for q in queries:\n        scores = cosine_scores(q, vectors)\n        truth.append(set(np.lexsort((np.arange(N_DOCS), -scores))[:K].tolist()))\n\n    raw_payload_mb = sum(len(p) for p in payloads) / 2**20\n    backends = [\"brute\"] + ([\"usearch\"] if HAVE_USEARCH else [])\n    results = {\n        \"generated_at\": time.strftime(\"%Y-%m-%dT%H:%M:%S\"),\n        \"corpus\": {\n            \"docs\": N_DOCS,\n            \"ndim\": NDIM,\n            \"queries\": N_QUERIES,\n            \"k\": K,\n            \"oversample\": 8,\n            \"raw_payload_mb\": round(raw_payload_mb, 1),\n        },\n        \"backends\": [],\n    }\n    for backend in backends:\n        print(f\"[bench] backend={backend}…\")\n        r = bench_backend(backend, vectors, payloads, queries, truth)\n        r[\"payload_compression_ratio\"] = round(raw_payload_mb / r[\"disk_kv_mb\"], 2) if r[\n            \"disk_kv_mb\"\n        ] else None\n        results[\"backends\"].append(r)\n        print(\n            f\"  ingest {r['ingest_docs_per_second']}/s | search p50 {r['search_ms_p50']}ms \"\n            f\"p95 {r['search_ms_p95']}ms | recall@10 {r['recall_at_10']} | \"\n            f\"kv {r['disk_kv_mb']}MB index {r['disk_index_mb']}MB\"\n        )\n\n    RESULTS.write_text(json.dumps(results, indent=2), \"utf-8\")\n    print(f\"[bench] written: {RESULTS}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":103,"oldLines":6,"newStart":103,"newLines":7,"lines":["             \"queries\": N_QUERIES,","             \"k\": K,","             \"oversample\": 8,","+            \"min_candidates\": 384,","             \"raw_payload_mb\": round(raw_payload_mb, 1),","         },","         \"backends\": [],"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"08bd15d2-6431-4ae3-a1f1-d42b9ed850ab","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\s16","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"