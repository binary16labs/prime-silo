{"parentUuid":"dfdd054a-1106-4b9f-b97c-5feb84971d5f","isSidechain":false,"message":{"model":"claude-opus-4-8","id":"msg_01PMZza3tkNtp7KUZJfu2tvd","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012VFXzQUQwf1vYTKzJeqoiv","name":"Write","input":{"file_path":"C:\\Users\\nsdha\\OneDrive\\binary16\\s16\\tests\\test_parity_smoke.py","content":"\"\"\"Offline smoke test for the parity methodology (no Chroma, no real data).\n\nGuards the core parity claim in miniature: S16's top-k neighborhoods agree with\nan exact float-cosine reference on realistic (non-adversarial) embeddings. The\nfull harness (bench/parity_harness.py) runs this against Chroma on exported\nworkspaces; this keeps the method honest in CI where Chroma isn't installed.\n\"\"\"\n\nimport numpy as np\n\nfrom s16.knowledge_store import S16KnowledgeStore\nfrom s16.quantize import cosine_scores\n\n\ndef test_s16_neighborhoods_match_exact_cosine(tmp_path):\n    rng = np.random.default_rng(3)\n    ndim, n = 768, 400\n    # Diffuse gaussian blobs — closer to real embedding geometry than the tight\n    # synthetic clusters the G0 gate stresses.\n    centers = rng.standard_normal((12, ndim)).astype(np.float32)\n    assign = rng.integers(0, 12, size=n)\n    vectors = (centers[assign] + 0.6 * rng.standard_normal((n, ndim))).astype(np.float32)\n\n    store = S16KnowledgeStore(tmp_path / \"ks\", ndim=ndim, index_backend=\"brute\")\n    store.put_many([(i, vectors[i], b\"d%d\" % i, None) for i in range(n)])\n\n    k = 10\n    overlaps = []\n    for qi in rng.choice(n, size=40, replace=False):\n        truth_scores = cosine_scores(vectors[qi], vectors)\n        truth = set(np.lexsort((np.arange(n), -truth_scores))[: k + 1].tolist())\n        truth.discard(int(qi))\n        got = {key for key, _ in store.search(vectors[qi], k=k + 1) if key != int(qi)}\n        got = set(list(got)[:k])\n        overlaps.append(len(got & truth) / k)\n    assert float(np.mean(overlaps)) >= 0.95\n    store.close()\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1436,"cache_read_input_tokens":287617,"output_tokens":891,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1436,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":891,"cache_read_input_tokens":287617,"cache_creation_input_tokens":1436,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1436},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcfGAP3Ad3JwbAHT5jb44","type":"assistant","uuid":"13f8a12e-b94b-4e9d-813e-8427e9cd75aa","timestamp":"2026-07-03T14:13:43.544Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\s16","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"HEAD"}
