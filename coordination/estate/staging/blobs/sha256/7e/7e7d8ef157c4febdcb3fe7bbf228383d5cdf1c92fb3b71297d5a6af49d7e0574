{"parentUuid":"f136f39b-6069-4143-90f4-340650373788","isSidechain":false,"promptId":"8ff9ec7b-65fd-4fdd-98b4-a7cd9e88f343","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BGcWp6nhGv4pY6wSLN3n1G","type":"tool_result","content":"1\t// ADR-001 Phase C — `kg3d.synoptic_web` widget.\n2\t//\n3\t// Read-only synoptic web of concept ontology nodes and edges, sourced from\n4\t// the runtime's `/kg3d/ontology` endpoint. Seventh migrated widget under\n5\t// Phase C; the second graph-shaped widget after `dag.canvas`.\n6\t//\n7\t// ## Renderer dependency decision\n8\t//\n9\t// The upstream `SynopticWeb.tsx` uses `react-force-graph-3d` + Three.js.\n10\t// Migrating that wholesale into the shell would mean bundling React +\n11\t// Three.js — a meaningful dependency for a read-only inspector. This\n12\t// migration takes a pragmatic line:\n13\t//\n14\t//   1. Ship a default **2D SVG layered renderer** that respects the AoT\n15\t//      layering (1 = abstract → 5 = concrete) and category palette. No\n16\t//      runtime dependency. Validates the data path end-to-end.\n17\t//   2. Keep the renderer **pluggable** via `options.renderer`. A future\n18\t//      `three-renderer.js` can lazy-import Three.js (or `3d-force-graph`)\n19\t//      from a CDN ESM and slot in without touching the widget core. The\n20\t//      same hook lets tests inject a stub.\n21\t//\n22\t// Honest trade-off: this is *not yet* a 3D synoptic web in the shell —\n23\t// the widget id keeps the historic name because the ontology contract\n24\t// and intent are identical. Upgrading to 3D is a follow-up; the data\n25\t// path needs to land first.\n26\t//\n27\t// Public API\n28\t//   createSynopticWebWidget(host, props, options)\n29\t//     props   — {\n30\t//       workspace?: string,        // default \"default\"\n31\t//       focusedLayer?: number,     // 1..5 — fade other AoT layers\n32\t//       selectedNodeId?: string,\n33\t//       onSelect?: (nodeId) => void,\n34\t//       data?: { nodes, edges }    // optional inline data — skips fetch\n35\t//     }\n36\t//     options — {\n37\t//       runtimeClient?: { runtimeFetch, readRuntimeJson },\n38\t//       renderer?: { mount(host, layout, props), update(layout, props), dispose() }\n39\t//     }\n40\t//\n41\t// Returns { update, refresh, destroy, get layout }.\n42\t\n43\timport { runtimeFetch, readRuntimeJson } from \"../../../runtime_client/runtime-client.js\";\n44\t\n45\tconst STATE_LOADING = \"loading\";\n46\tconst STATE_READY = \"ready\";\n47\tconst STATE_ERROR = \"error\";\n48\t\n49\tconst HTML_ESCAPES = {\n50\t  \"&\": \"&amp;\",\n51\t  \"<\": \"&lt;\",\n52\t  \">\": \"&gt;\",\n53\t  '\"': \"&quot;\",\n54\t  \"'\": \"&#39;\"\n55\t};\n56\t\n57\tfunction escapeHtml(text) {\n58\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n59\t}\n60\t\n61\t// AoT layering — layer 1 is most abstract, layer 5 is most concrete.\n62\t// The synoptic-web rendering puts abstract on top, concrete on bottom.\n63\tconst MIN_LAYER = 1;\n64\tconst MAX_LAYER = 5;\n65\tconst DEFAULT_LAYER = 3;\n66\t\n67\t// Subset of upstream palette — keeps the renderer dependency-free. The\n68\t// full palette lives in `runtime/frontend/src/components/Studio/kg3d/palette.ts`;\n69\t// the shell mirrors the most-used categories and falls back to a neutral\n70\t// colour for unknown ones.\n71\tconst CATEGORY_COLORS = {\n72\t  ai_deep_learning: \"#a78bfa\",\n73\t  neural_evolutionary_computing: \"#22d3ee\",\n74\t  calc_variations_control: \"#34d399\",\n75\t  linear_multilinear_algebra_matrix_theory: \"#fb923c\",\n76\t  optimisation_reinforcement_learning: \"#f472b6\",\n77\t  default: \"#94a3b8\"\n78\t};\n79\t\n80\tconst EDGE_COLORS = {\n81\t  prerequisite: \"rgba(99, 102, 241, 0.55)\",\n82\t  references: \"rgba(148, 163, 184, 0.45)\",\n83\t  default: \"rgba(148, 163, 184, 0.45)\"\n84\t};\n85\t\n86\tconst LAYER_GAP = 90;\n87\tconst NODE_RADIUS_BASE = 6;\n88\tconst NODE_RADIUS_SCALE = 18;\n89\tconst HORIZONTAL_PADDING = 32;\n90\tconst TOP_PADDING = 28;\n91\tconst BOTTOM_PADDING = 28;\n92\tconst SVG_WIDTH = 720;\n93\t\n94\tfunction pickCategoryColor(category) {\n95\t  if (category && CATEGORY_COLORS[category]) {\n96\t    return CATEGORY_COLORS[category];\n97\t  }\n98\t  return CATEGORY_COLORS.default;\n99\t}\n100\t\n101\tfunction pickEdgeColor(kind) {\n102\t  if (kind && EDGE_COLORS[kind]) {\n103\t    return EDGE_COLORS[kind];\n104\t  }\n105\t  return EDGE_COLORS.default;\n106\t}\n107\t\n108\tfunction buildOntologyPath(props) {\n109\t  const params = new URLSearchParams();\n110\t  params.set(\"workspace\", props.workspace || \"default\");\n111\t  return `/kg3d/ontology?${params.toString()}`;\n112\t}\n113\t\n114\tfunction ensureClient(options) {\n115\t  if (options && options.runtimeClient) {\n116\t    return options.runtimeClient;\n117\t  }\n118\t  return { runtimeFetch, readRuntimeJson };\n119\t}\n120\t\n121\tfunction clampLayer(layer) {\n122\t  if (typeof layer !== \"number\" || Number.isNaN(layer)) return DEFAULT_LAYER;\n123\t  if (layer < MIN_LAYER) return MIN_LAYER;\n124\t  if (layer > MAX_LAYER) return MAX_LAYER;\n125\t  return Math.round(layer);\n126\t}\n127\t\n128\tfunction pageRankWeight(node) {\n129\t  const pr =\n130\t    node && node.metrics && typeof node.metrics.pagerank === \"number\" ? node.metrics.pagerank : 0;\n131\t  // Pagerank in the test fixtures is normalised 0..100; clamp so a single\n132\t  // dominant node doesn't blow out the radius.\n133\t  return Math.max(0, Math.min(1, pr / 100));\n134\t}\n135\t\n136\t/**\n137\t * Compute layered layout. Nodes are bucketed by `aot_layer`; within a\n138\t * layer they're spaced evenly across the available width. Returns a map\n139\t * of nodeId → { x, y, radius, color } plus the bounding height.\n140\t */\n141\texport function computeLayout(nodes, edges) {\n142\t  const safeNodes = Array.isArray(nodes) ? nodes : [];\n143\t  const safeEdges = Array.isArray(edges) ? edges : [];\n144\t\n145\t  const buckets = new Map();\n146\t  for (let l = MIN_LAYER; l <= MAX_LAYER; l += 1) buckets.set(l, []);\n147\t  for (const node of safeNodes) {\n148\t    const layer = clampLayer(node && node.aot_layer);\n149\t    buckets.get(layer).push(node);\n150\t  }\n151\t\n152\t  const positions = {};\n153\t  buckets.forEach((bucketNodes, layer) => {\n154\t    const count = bucketNodes.length;\n155\t    if (count === 0) return;\n156\t    const innerWidth = SVG_WIDTH - HORIZONTAL_PADDING * 2;\n157\t    const step = count === 1 ? 0 : innerWidth / (count - 1);\n158\t    bucketNodes.forEach((node, idx) => {\n159\t      const x = HORIZONTAL_PADDING + (count === 1 ? innerWidth / 2 : idx * step);\n160\t      const y = TOP_PADDING + (layer - MIN_LAYER) * LAYER_GAP;\n161\t      const weight = pageRankWeight(node);\n162\t      const radius = NODE_RADIUS_BASE + weight * NODE_RADIUS_SCALE;\n163\t      positions[node.id] = {\n164\t        x,\n165\t        y,\n166\t        radius,\n167\t        layer,\n168\t        color: pickCategoryColor(node.category),\n169\t        node\n170\t      };\n171\t    });\n172\t  });\n173\t\n174\t  const renderedEdges = [];\n175\t  for (const edge of safeEdges) {\n176\t    const sourceId = edge.source_id || edge.source;\n177\t    const targetId = edge.target_id || edge.target;\n178\t    if (!sourceId || !targetId) continue;\n179\t    if (!positions[sourceId] || !positions[targetId]) continue;\n180\t    if (sourceId === targetId) continue;\n181\t    renderedEdges.push({\n182\t      id: edge.id || `${sourceId}->${targetId}`,\n183\t      source: sourceId,\n184\t      target: targetId,\n185\t      kind: edge.kind || \"references\",\n186\t      weight: typeof edge.weight === \"number\" ? edge.weight : 1\n187\t    });\n188\t  }\n189\t\n190\t  const totalLayers = MAX_LAYER - MIN_LAYER + 1;\n191\t  const height = TOP_PADDING + (totalLayers - 1) * LAYER_GAP + BOTTOM_PADDING;\n192\t\n193\t  return { positions, edges: renderedEdges, width: SVG_WIDTH, height, buckets };\n194\t}\n195\t\n196\tfunction renderEdgeSvg(edge, positions, focusedLayer) {\n197\t  const s = positions[edge.source];\n198\t  const t = positions[edge.target];\n199\t  if (!s || !t) return \"\";\n200\t  const opacity = focusedLayer\n201\t    ? s.layer === focusedLayer || t.layer === focusedLayer\n202\t      ? 0.8\n203\t      : 0.18\n204\t    : 0.7;\n205\t  const strokeWidth = edge.kind === \"prerequisite\" ? 1.8 : 1.2;\n206\t  return `<line class=\"prime-silo-kg__edge\"\n207\t    x1=\"${s.x}\" y1=\"${s.y}\" x2=\"${t.x}\" y2=\"${t.y}\"\n208\t    stroke=\"${pickEdgeColor(edge.kind)}\"\n209\t    stroke-width=\"${strokeWidth}\"\n210\t    stroke-opacity=\"${opacity}\" />`;\n211\t}\n212\t\n213\tfunction renderNodeSvg(positionEntry, props) {\n214\t  const { x, y, radius, layer, color, node } = positionEntry;\n215\t  const focused = props.focusedLayer;\n216\t  const inFocus = !focused || focused === layer;\n217\t  const opacity = inFocus ? 1 : 0.18;\n218\t  const selected = node.id === props.selectedNodeId;\n219\t  const label = node.display_name || node.canonical_name || node.id;\n220\t  const title =\n221\t    node.canonical_name && node.canonical_name !== label\n222\t      ? `${label} (${node.canonical_name})`\n223\t      : label;\n224\t  return `\n225\t    <g class=\"prime-silo-kg__node\" data-node-id=\"${escapeHtml(node.id)}\"${selected ? ' data-selected=\"true\"' : \"\"} opacity=\"${opacity}\">\n226\t      <title>${escapeHtml(title)}</title>\n227\t      <circle cx=\"${x}\" cy=\"${y}\" r=\"${radius}\" fill=\"${color}\" stroke=\"${selected ? \"#f8fafc\" : \"rgba(15,23,42,0.85)\"}\" stroke-width=\"${selected ? 2.5 : 1.5}\" />\n228\t      <text class=\"prime-silo-kg__node-label\" x=\"${x}\" y=\"${y + radius + 12}\" text-anchor=\"middle\">${escapeHtml(label)}</text>\n229\t    </g>\n230\t  `;\n231\t}\n232\t\n233\tfunction renderLayerGuides(height) {\n234\t  const guides = [];\n235\t  for (let layer = MIN_LAYER; layer <= MAX_LAYER; layer += 1) {\n236\t    const y = TOP_PADDING + (layer - MIN_LAYER) * LAYER_GAP;\n237\t    guides.push(\n238\t      `<line class=\"prime-silo-kg__layer-guide\" x1=\"0\" y1=\"${y}\" x2=\"${SVG_WIDTH}\" y2=\"${y}\" />`\n239\t    );\n240\t    guides.push(`<text class=\"prime-silo-kg__layer-label\" x=\"6\" y=\"${y - 6}\">L${layer}</text>`);\n241\t  }\n242\t  return guides.join(\"\");\n243\t}\n244\t\n245\texport function renderSvg(layout, props) {\n246\t  const { positions, edges, width, height } = layout;\n247\t  const edgeSvg = edges.map((e) => renderEdgeSvg(e, positions, props.focusedLayer)).join(\"\");\n248\t  const nodeSvg = Object.values(positions)\n249\t    .map((entry) => renderNodeSvg(entry, props))\n250\t    .join(\"\");\n251\t  return `\n252\t    <svg class=\"prime-silo-kg__svg\" viewBox=\"0 0 ${width} ${height}\" width=\"${width}\" height=\"${height}\" xmlns=\"http://www.w3.org/2000/svg\">\n253\t      <g class=\"prime-silo-kg__layer-guides\">${renderLayerGuides(height)}</g>\n254\t      <g class=\"prime-silo-kg__edges\">${edgeSvg}</g>\n255\t      <g class=\"prime-silo-kg__nodes\">${nodeSvg}</g>\n256\t    </svg>\n257\t  `;\n258\t}\n259\t\n260\tfunction renderError(host, error) {\n261\t  const detail = (error && ((error.body && error.body.detail) || error.message)) || String(error);\n262\t  host.dataset.widgetState = STATE_ERROR;\n263\t  host.innerHTML = `<div class=\"prime-silo-kg__error\">Knowledge graph load failed: ${escapeHtml(detail)}</div>`;\n264\t}\n265\t\n266\tfunction renderLoading(host, props) {\n267\t  host.dataset.widgetState = STATE_LOADING;\n268\t  host.innerHTML = `<div class=\"prime-silo-kg__loading\">Loading ontology for workspace ${escapeHtml(props.workspace || \"default\")}…</div>`;\n269\t}\n270\t\n271\tfunction renderEmpty(host, props) {\n272\t  host.dataset.widgetState = STATE_READY;\n273\t  host.innerHTML = `<div class=\"prime-silo-kg__empty\">No concepts in workspace <code>${escapeHtml(props.workspace || \"default\")}</code>. Ingest documents or run KG3D ontology compilation to populate the synoptic web.</div>`;\n274\t}\n275\t\n276\t/**\n277\t * Mount the synoptic-web widget into `host`.\n278\t */\n279\texport function createSynopticWebWidget(host, initialProps, options = {}) {\n280\t  if (!host || typeof host.querySelector !== \"function\") {\n281\t    throw new Error(\"createSynopticWebWidget: host must be an HTMLElement.\");\n282\t  }\n283\t\n284\t  const client = ensureClient(options);\n285\t  const customRenderer = options && options.renderer ? options.renderer : null;\n286\t  let props = { ...initialProps };\n287\t  let aborted = false;\n288\t  let lastLayout = null;\n289\t  let rendererHandle = null;\n290\t\n291\t  host.classList.add(\"prime-silo-kg\");\n292\t\n293\t  function onClick(event) {\n294\t    const target = event.target && event.target.closest && event.target.closest(\"[data-node-id]\");\n295\t    if (!target) return;\n296\t    const nodeId = target.getAttribute(\"data-node-id\");\n297\t    if (typeof props.onSelect === \"function\") {\n298\t      props.onSelect(nodeId);\n299\t    }\n300\t  }\n301\t\n302\t  if (typeof host.addEventListener === \"function\") {\n303\t    host.addEventListener(\"click\", onClick);\n304\t  }\n305\t\n306\t  function paint(layout) {\n307\t    if (customRenderer) {\n308\t      if (rendererHandle && typeof rendererHandle.update === \"function\") {\n309\t        rendererHandle.update(layout, props);\n310\t        return;\n311\t      }\n312\t      rendererHandle = customRenderer.mount(host, layout, props);\n313\t      host.dataset.widgetState = STATE_READY;\n314\t      return;\n315\t    }\n316\t    host.dataset.widgetState = STATE_READY;\n317\t    host.innerHTML = renderSvg(layout, props);\n318\t  }\n319\t\n320\t  // Fallback when /kg3d/ontology comes back empty: read the raw dual graph\n321\t  // from /graph/full (which works on every runtime version) and adapt it to\n322\t  // the widget's node shape. Seen live: a runtime whose ontology loader failed\n323\t  // and whose demo fixture was removed returned {nodes:[], edges:[]} while the\n324\t  // graph itself held 900+ concepts — the canvas said \"no concepts\" over a\n325\t  // perfectly good graph. Layers are derived from connectivity (sources on\n326\t  // top, hubs high, leaves low) since raw nodes carry no aot_layer.\n327\t  // Cap the fallback view: post-synthesis workspaces reach tens of thousands\n328\t  // of concepts, which (a) blew the call stack via spread-max over the degree\n329\t  // values (\"Maximum call stack size exceeded\" on v1.10.0) and (b) would hang\n330\t  // the tab as SVG anyway. Keep every Source plus the most-connected concepts.\n331\t  const FALLBACK_NODE_BUDGET = 400;\n332\t\n333\t  async function loadGraphFullFallback() {\n334\t    const ws = encodeURIComponent(props.workspace || \"default\");\n335\t    const response = await client.runtimeFetch(`/graph/full?workspace=${ws}&show_all=true`);\n336\t    const raw = await client.readRuntimeJson(response);\n337\t    const rawNodes = (raw && raw.nodes) || [];\n338\t    const rawEdges = (raw && raw.edges) || [];\n339\t    const degree = new Map();\n340\t    let maxDeg = 1;\n341\t    for (const e of rawEdges) {\n342\t      const ds = (degree.get(e.source) || 0) + 1;\n343\t      const dt = (degree.get(e.target) || 0) + 1;\n344\t      degree.set(e.source, ds);\n345\t      degree.set(e.target, dt);\n346\t      if (ds > maxDeg) maxDeg = ds;\n347\t      if (dt > maxDeg) maxDeg = dt;\n348\t    }\n349\t    // Layering by connectivity semantics: a synthesized concept's baseline is\n350\t    // degree 2 (its SOURCED_FROM + one RELATES_TO), so ≥3 means it connects\n351\t    // beyond its own document — the cross-reference tier. Top 5% are hubs.\n352\t    const sortedDeg = [...degree.values()].sort((a, b) => b - a);\n353\t    const hub = Math.max(4, sortedDeg[Math.floor(sortedDeg.length * 0.05)] || 4);\n354\t\n355\t    const sources = [];\n356\t    const concepts = [];\n357\t    for (const n of rawNodes) {\n358\t      if ((n.labels || []).includes(\"Source\")) sources.push(n);\n359\t      else concepts.push(n);\n360\t    }\n361\t    concepts.sort((a, b) => (degree.get(b.id) || 0) - (degree.get(a.id) || 0));\n362\t    const kept = sources.concat(concepts.slice(0, Math.max(0, FALLBACK_NODE_BUDGET - sources.length)));\n363\t    const keptIds = new Set(kept.map((n) => n.id));\n364\t\n365\t    const nodes = kept.map((n) => {\n366\t      const d = degree.get(n.id) || 0;\n367\t      const isSource = (n.labels || []).includes(\"Source\");\n368\t      const layer = isSource ? 1 : d >= hub ? 2 : d >= 3 ? 3 : d > 0 ? 4 : 5;\n369\t      return {\n370\t        id: String(n.id),\n371\t        display_name: n.name || String(n.id),\n372\t        canonical_name: n.name || String(n.id),\n373\t        category: isSource ? \"documentation\" : \"concept\",\n374\t        aot_layer: layer,\n375\t        metrics: { pagerank: (d / maxDeg) * 100 }\n376\t      };\n377\t    });\n378\t    const edges = rawEdges.filter((e) => keptIds.has(e.source) && keptIds.has(e.target));\n379\t    return { nodes, edges };\n380\t  }\n381\t\n382\t  async function load() {\n383\t    renderLoading(host, props);\n384\t    try {\n385\t      let payload;\n386\t      if (props.data && (props.data.nodes || props.data.edges)) {\n387\t        payload = { nodes: props.data.nodes || [], edges: props.data.edges || [] };\n388\t      } else {\n389\t        const response = await client.runtimeFetch(buildOntologyPath(props));\n390\t        payload = await client.readRuntimeJson(response);\n391\t        if (!payload || !Array.isArray(payload.nodes) || payload.nodes.length === 0) {\n392\t          payload = await loadGraphFullFallback();\n393\t        }\n394\t      }\n395\t      if (aborted) return;\n396\t      const nodes = payload && Array.isArray(payload.nodes) ? payload.nodes : [];\n397\t      const edges = payload && Array.isArray(payload.edges) ? payload.edges : [];\n398\t      if (nodes.length === 0) {\n399\t        lastLayout = computeLayout([], []);\n400\t        renderEmpty(host, props);\n401\t        return;\n402\t      }\n403\t      lastLayout = computeLayout(nodes, edges);\n404\t      paint(lastLayout);\n405\t    } catch (err) {\n406\t      if (aborted) return;\n407\t      renderError(host, err);\n408\t    }\n409\t  }\n410\t\n411\t  function update(nextProps) {\n412\t    const merged = { ...props, ...nextProps };\n413\t    const fetchKeyChanged =\n414\t      merged.workspace !== props.workspace || (merged.data || null) !== (props.data || null);\n415\t    props = merged;\n416\t    if (fetchKeyChanged) {\n417\t      load();\n418\t    } else if (lastLayout) {\n419\t      paint(lastLayout);\n420\t    }\n421\t  }\n422\t\n423\t  function refresh() {\n424\t    return load();\n425\t  }\n426\t\n427\t  function destroy() {\n428\t    aborted = true;\n429\t    if (typeof host.removeEventListener === \"function\") {\n430\t      host.removeEventListener(\"click\", onClick);\n431\t    }\n432\t    if (rendererHandle && typeof rendererHandle.dispose === \"function\") {\n433\t      try {\n434\t        rendererHandle.dispose();\n435\t      } catch (_e) {\n436\t        /* swallow */\n437\t      }\n438\t    }\n439\t    rendererHandle = null;\n440\t    host.classList.remove(\"prime-silo-kg\");\n441\t    host.innerHTML = \"\";\n442\t    delete host.dataset.widgetState;\n443\t  }\n444\t\n445\t  load();\n446\t\n447\t  return {\n448\t    update,\n449\t    refresh,\n450\t    destroy,\n451\t    get layout() {\n452\t      return lastLayout;\n453\t    }\n454\t  };\n455\t}\n456\t\n457\texport const __testing = {\n458\t  buildOntologyPath,\n459\t  computeLayout,\n460\t  renderSvg,\n461\t  renderEdgeSvg,\n462\t  renderNodeSvg,\n463\t  pickCategoryColor,\n464\t  pickEdgeColor,\n465\t  clampLayer,\n466\t  CATEGORY_COLORS,\n467\t  EDGE_COLORS,\n468\t  MIN_LAYER,\n469\t  MAX_LAYER\n470\t};\n471\t"}]},"uuid":"db7610ab-1218-4a53-88c1-61febe2744cd","timestamp":"2026-07-03T06:45:46.851Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\app\\L0\\_all\\mod\\_prime_silo\\widgets\\kg3d\\synoptic_web\\index.js","content":"// ADR-001 Phase C — `kg3d.synoptic_web` widget.\n//\n// Read-only synoptic web of concept ontology nodes and edges, sourced from\n// the runtime's `/kg3d/ontology` endpoint. Seventh migrated widget under\n// Phase C; the second graph-shaped widget after `dag.canvas`.\n//\n// ## Renderer dependency decision\n//\n// The upstream `SynopticWeb.tsx` uses `react-force-graph-3d` + Three.js.\n// Migrating that wholesale into the shell would mean bundling React +\n// Three.js — a meaningful dependency for a read-only inspector. This\n// migration takes a pragmatic line:\n//\n//   1. Ship a default **2D SVG layered renderer** that respects the AoT\n//      layering (1 = abstract → 5 = concrete) and category palette. No\n//      runtime dependency. Validates the data path end-to-end.\n//   2. Keep the renderer **pluggable** via `options.renderer`. A future\n//      `three-renderer.js` can lazy-import Three.js (or `3d-force-graph`)\n//      from a CDN ESM and slot in without touching the widget core. The\n//      same hook lets tests inject a stub.\n//\n// Honest trade-off: this is *not yet* a 3D synoptic web in the shell —\n// the widget id keeps the historic name because the ontology contract\n// and intent are identical. Upgrading to 3D is a follow-up; the data\n// path needs to land first.\n//\n// Public API\n//   createSynopticWebWidget(host, props, options)\n//     props   — {\n//       workspace?: string,        // default \"default\"\n//       focusedLayer?: number,     // 1..5 — fade other AoT layers\n//       selectedNodeId?: string,\n//       onSelect?: (nodeId) => void,\n//       data?: { nodes, edges }    // optional inline data — skips fetch\n//     }\n//     options — {\n//       runtimeClient?: { runtimeFetch, readRuntimeJson },\n//       renderer?: { mount(host, layout, props), update(layout, props), dispose() }\n//     }\n//\n// Returns { update, refresh, destroy, get layout }.\n\nimport { runtimeFetch, readRuntimeJson } from \"../../../runtime_client/runtime-client.js\";\n\nconst STATE_LOADING = \"loading\";\nconst STATE_READY = \"ready\";\nconst STATE_ERROR = \"error\";\n\nconst HTML_ESCAPES = {\n  \"&\": \"&amp;\",\n  \"<\": \"&lt;\",\n  \">\": \"&gt;\",\n  '\"': \"&quot;\",\n  \"'\": \"&#39;\"\n};\n\nfunction escapeHtml(text) {\n  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n}\n\n// AoT layering — layer 1 is most abstract, layer 5 is most concrete.\n// The synoptic-web rendering puts abstract on top, concrete on bottom.\nconst MIN_LAYER = 1;\nconst MAX_LAYER = 5;\nconst DEFAULT_LAYER = 3;\n\n// Subset of upstream palette — keeps the renderer dependency-free. The\n// full palette lives in `runtime/frontend/src/components/Studio/kg3d/palette.ts`;\n// the shell mirrors the most-used categories and falls back to a neutral\n// colour for unknown ones.\nconst CATEGORY_COLORS = {\n  ai_deep_learning: \"#a78bfa\",\n  neural_evolutionary_computing: \"#22d3ee\",\n  calc_variations_control: \"#34d399\",\n  linear_multilinear_algebra_matrix_theory: \"#fb923c\",\n  optimisation_reinforcement_learning: \"#f472b6\",\n  default: \"#94a3b8\"\n};\n\nconst EDGE_COLORS = {\n  prerequisite: \"rgba(99, 102, 241, 0.55)\",\n  references: \"rgba(148, 163, 184, 0.45)\",\n  default: \"rgba(148, 163, 184, 0.45)\"\n};\n\nconst LAYER_GAP = 90;\nconst NODE_RADIUS_BASE = 6;\nconst NODE_RADIUS_SCALE = 18;\nconst HORIZONTAL_PADDING = 32;\nconst TOP_PADDING = 28;\nconst BOTTOM_PADDING = 28;\nconst SVG_WIDTH = 720;\n\nfunction pickCategoryColor(category) {\n  if (category && CATEGORY_COLORS[category]) {\n    return CATEGORY_COLORS[category];\n  }\n  return CATEGORY_COLORS.default;\n}\n\nfunction pickEdgeColor(kind) {\n  if (kind && EDGE_COLORS[kind]) {\n    return EDGE_COLORS[kind];\n  }\n  return EDGE_COLORS.default;\n}\n\nfunction buildOntologyPath(props) {\n  const params = new URLSearchParams();\n  params.set(\"workspace\", props.workspace || \"default\");\n  return `/kg3d/ontology?${params.toString()}`;\n}\n\nfunction ensureClient(options) {\n  if (options && options.runtimeClient) {\n    return options.runtimeClient;\n  }\n  return { runtimeFetch, readRuntimeJson };\n}\n\nfunction clampLayer(layer) {\n  if (typeof layer !== \"number\" || Number.isNaN(layer)) return DEFAULT_LAYER;\n  if (layer < MIN_LAYER) return MIN_LAYER;\n  if (layer > MAX_LAYER) return MAX_LAYER;\n  return Math.round(layer);\n}\n\nfunction pageRankWeight(node) {\n  const pr =\n    node && node.metrics && typeof node.metrics.pagerank === \"number\" ? node.metrics.pagerank : 0;\n  // Pagerank in the test fixtures is normalised 0..100; clamp so a single\n  // dominant node doesn't blow out the radius.\n  return Math.max(0, Math.min(1, pr / 100));\n}\n\n/**\n * Compute layered layout. Nodes are bucketed by `aot_layer`; within a\n * layer they're spaced evenly across the available width. Returns a map\n * of nodeId → { x, y, radius, color } plus the bounding height.\n */\nexport function computeLayout(nodes, edges) {\n  const safeNodes = Array.isArray(nodes) ? nodes : [];\n  const safeEdges = Array.isArray(edges) ? edges : [];\n\n  const buckets = new Map();\n  for (let l = MIN_LAYER; l <= MAX_LAYER; l += 1) buckets.set(l, []);\n  for (const node of safeNodes) {\n    const layer = clampLayer(node && node.aot_layer);\n    buckets.get(layer).push(node);\n  }\n\n  const positions = {};\n  buckets.forEach((bucketNodes, layer) => {\n    const count = bucketNodes.length;\n    if (count === 0) return;\n    const innerWidth = SVG_WIDTH - HORIZONTAL_PADDING * 2;\n    const step = count === 1 ? 0 : innerWidth / (count - 1);\n    bucketNodes.forEach((node, idx) => {\n      const x = HORIZONTAL_PADDING + (count === 1 ? innerWidth / 2 : idx * step);\n      const y = TOP_PADDING + (layer - MIN_LAYER) * LAYER_GAP;\n      const weight = pageRankWeight(node);\n      const radius = NODE_RADIUS_BASE + weight * NODE_RADIUS_SCALE;\n      positions[node.id] = {\n        x,\n        y,\n        radius,\n        layer,\n        color: pickCategoryColor(node.category),\n        node\n      };\n    });\n  });\n\n  const renderedEdges = [];\n  for (const edge of safeEdges) {\n    const sourceId = edge.source_id || edge.source;\n    const targetId = edge.target_id || edge.target;\n    if (!sourceId || !targetId) continue;\n    if (!positions[sourceId] || !positions[targetId]) continue;\n    if (sourceId === targetId) continue;\n    renderedEdges.push({\n      id: edge.id || `${sourceId}->${targetId}`,\n      source: sourceId,\n      target: targetId,\n      kind: edge.kind || \"references\",\n      weight: typeof edge.weight === \"number\" ? edge.weight : 1\n    });\n  }\n\n  const totalLayers = MAX_LAYER - MIN_LAYER + 1;\n  const height = TOP_PADDING + (totalLayers - 1) * LAYER_GAP + BOTTOM_PADDING;\n\n  return { positions, edges: renderedEdges, width: SVG_WIDTH, height, buckets };\n}\n\nfunction renderEdgeSvg(edge, positions, focusedLayer) {\n  const s = positions[edge.source];\n  const t = positions[edge.target];\n  if (!s || !t) return \"\";\n  const opacity = focusedLayer\n    ? s.layer === focusedLayer || t.layer === focusedLayer\n      ? 0.8\n      : 0.18\n    : 0.7;\n  const strokeWidth = edge.kind === \"prerequisite\" ? 1.8 : 1.2;\n  return `<line class=\"prime-silo-kg__edge\"\n    x1=\"${s.x}\" y1=\"${s.y}\" x2=\"${t.x}\" y2=\"${t.y}\"\n    stroke=\"${pickEdgeColor(edge.kind)}\"\n    stroke-width=\"${strokeWidth}\"\n    stroke-opacity=\"${opacity}\" />`;\n}\n\nfunction renderNodeSvg(positionEntry, props) {\n  const { x, y, radius, layer, color, node } = positionEntry;\n  const focused = props.focusedLayer;\n  const inFocus = !focused || focused === layer;\n  const opacity = inFocus ? 1 : 0.18;\n  const selected = node.id === props.selectedNodeId;\n  const label = node.display_name || node.canonical_name || node.id;\n  const title =\n    node.canonical_name && node.canonical_name !== label\n      ? `${label} (${node.canonical_name})`\n      : label;\n  return `\n    <g class=\"prime-silo-kg__node\" data-node-id=\"${escapeHtml(node.id)}\"${selected ? ' data-selected=\"true\"' : \"\"} opacity=\"${opacity}\">\n      <title>${escapeHtml(title)}</title>\n      <circle cx=\"${x}\" cy=\"${y}\" r=\"${radius}\" fill=\"${color}\" stroke=\"${selected ? \"#f8fafc\" : \"rgba(15,23,42,0.85)\"}\" stroke-width=\"${selected ? 2.5 : 1.5}\" />\n      <text class=\"prime-silo-kg__node-label\" x=\"${x}\" y=\"${y + radius + 12}\" text-anchor=\"middle\">${escapeHtml(label)}</text>\n    </g>\n  `;\n}\n\nfunction renderLayerGuides(height) {\n  const guides = [];\n  for (let layer = MIN_LAYER; layer <= MAX_LAYER; layer += 1) {\n    const y = TOP_PADDING + (layer - MIN_LAYER) * LAYER_GAP;\n    guides.push(\n      `<line class=\"prime-silo-kg__layer-guide\" x1=\"0\" y1=\"${y}\" x2=\"${SVG_WIDTH}\" y2=\"${y}\" />`\n    );\n    guides.push(`<text class=\"prime-silo-kg__layer-label\" x=\"6\" y=\"${y - 6}\">L${layer}</text>`);\n  }\n  return guides.join(\"\");\n}\n\nexport function renderSvg(layout, props) {\n  const { positions, edges, width, height } = layout;\n  const edgeSvg = edges.map((e) => renderEdgeSvg(e, positions, props.focusedLayer)).join(\"\");\n  const nodeSvg = Object.values(positions)\n    .map((entry) => renderNodeSvg(entry, props))\n    .join(\"\");\n  return `\n    <svg class=\"prime-silo-kg__svg\" viewBox=\"0 0 ${width} ${height}\" width=\"${width}\" height=\"${height}\" xmlns=\"http://www.w3.org/2000/svg\">\n      <g class=\"prime-silo-kg__layer-guides\">${renderLayerGuides(height)}</g>\n      <g class=\"prime-silo-kg__edges\">${edgeSvg}</g>\n      <g class=\"prime-silo-kg__nodes\">${nodeSvg}</g>\n    </svg>\n  `;\n}\n\nfunction renderError(host, error) {\n  const detail = (error && ((error.body && error.body.detail) || error.message)) || String(error);\n  host.dataset.widgetState = STATE_ERROR;\n  host.innerHTML = `<div class=\"prime-silo-kg__error\">Knowledge graph load failed: ${escapeHtml(detail)}</div>`;\n}\n\nfunction renderLoading(host, props) {\n  host.dataset.widgetState = STATE_LOADING;\n  host.innerHTML = `<div class=\"prime-silo-kg__loading\">Loading ontology for workspace ${escapeHtml(props.workspace || \"default\")}…</div>`;\n}\n\nfunction renderEmpty(host, props) {\n  host.dataset.widgetState = STATE_READY;\n  host.innerHTML = `<div class=\"prime-silo-kg__empty\">No concepts in workspace <code>${escapeHtml(props.workspace || \"default\")}</code>. Ingest documents or run KG3D ontology compilation to populate the synoptic web.</div>`;\n}\n\n/**\n * Mount the synoptic-web widget into `host`.\n */\nexport function createSynopticWebWidget(host, initialProps, options = {}) {\n  if (!host || typeof host.querySelector !== \"function\") {\n    throw new Error(\"createSynopticWebWidget: host must be an HTMLElement.\");\n  }\n\n  const client = ensureClient(options);\n  const customRenderer = options && options.renderer ? options.renderer : null;\n  let props = { ...initialProps };\n  let aborted = false;\n  let lastLayout = null;\n  let rendererHandle = null;\n\n  host.classList.add(\"prime-silo-kg\");\n\n  function onClick(event) {\n    const target = event.target && event.target.closest && event.target.closest(\"[data-node-id]\");\n    if (!target) return;\n    const nodeId = target.getAttribute(\"data-node-id\");\n    if (typeof props.onSelect === \"function\") {\n      props.onSelect(nodeId);\n    }\n  }\n\n  if (typeof host.addEventListener === \"function\") {\n    host.addEventListener(\"click\", onClick);\n  }\n\n  function paint(layout) {\n    if (customRenderer) {\n      if (rendererHandle && typeof rendererHandle.update === \"function\") {\n        rendererHandle.update(layout, props);\n        return;\n      }\n      rendererHandle = customRenderer.mount(host, layout, props);\n      host.dataset.widgetState = STATE_READY;\n      return;\n    }\n    host.dataset.widgetState = STATE_READY;\n    host.innerHTML = renderSvg(layout, props);\n  }\n\n  // Fallback when /kg3d/ontology comes back empty: read the raw dual graph\n  // from /graph/full (which works on every runtime version) and adapt it to\n  // the widget's node shape. Seen live: a runtime whose ontology loader failed\n  // and whose demo fixture was removed returned {nodes:[], edges:[]} while the\n  // graph itself held 900+ concepts — the canvas said \"no concepts\" over a\n  // perfectly good graph. Layers are derived from connectivity (sources on\n  // top, hubs high, leaves low) since raw nodes carry no aot_layer.\n  // Cap the fallback view: post-synthesis workspaces reach tens of thousands\n  // of concepts, which (a) blew the call stack via spread-max over the degree\n  // values (\"Maximum call stack size exceeded\" on v1.10.0) and (b) would hang\n  // the tab as SVG anyway. Keep every Source plus the most-connected concepts.\n  const FALLBACK_NODE_BUDGET = 400;\n\n  async function loadGraphFullFallback() {\n    const ws = encodeURIComponent(props.workspace || \"default\");\n    const response = await client.runtimeFetch(`/graph/full?workspace=${ws}&show_all=true`);\n    const raw = await client.readRuntimeJson(response);\n    const rawNodes = (raw && raw.nodes) || [];\n    const rawEdges = (raw && raw.edges) || [];\n    const degree = new Map();\n    let maxDeg = 1;\n    for (const e of rawEdges) {\n      const ds = (degree.get(e.source) || 0) + 1;\n      const dt = (degree.get(e.target) || 0) + 1;\n      degree.set(e.source, ds);\n      degree.set(e.target, dt);\n      if (ds > maxDeg) maxDeg = ds;\n      if (dt > maxDeg) maxDeg = dt;\n    }\n    // Layering by connectivity semantics: a synthesized concept's baseline is\n    // degree 2 (its SOURCED_FROM + one RELATES_TO), so ≥3 means it connects\n    // beyond its own document — the cross-reference tier. Top 5% are hubs.\n    const sortedDeg = [...degree.values()].sort((a, b) => b - a);\n    const hub = Math.max(4, sortedDeg[Math.floor(sortedDeg.length * 0.05)] || 4);\n\n    const sources = [];\n    const concepts = [];\n    for (const n of rawNodes) {\n      if ((n.labels || []).includes(\"Source\")) sources.push(n);\n      else concepts.push(n);\n    }\n    concepts.sort((a, b) => (degree.get(b.id) || 0) - (degree.get(a.id) || 0));\n    const kept = sources.concat(concepts.slice(0, Math.max(0, FALLBACK_NODE_BUDGET - sources.length)));\n    const keptIds = new Set(kept.map((n) => n.id));\n\n    const nodes = kept.map((n) => {\n      const d = degree.get(n.id) || 0;\n      const isSource = (n.labels || []).includes(\"Source\");\n      const layer = isSource ? 1 : d >= hub ? 2 : d >= 3 ? 3 : d > 0 ? 4 : 5;\n      return {\n        id: String(n.id),\n        display_name: n.name || String(n.id),\n        canonical_name: n.name || String(n.id),\n        category: isSource ? \"documentation\" : \"concept\",\n        aot_layer: layer,\n        metrics: { pagerank: (d / maxDeg) * 100 }\n      };\n    });\n    const edges = rawEdges.filter((e) => keptIds.has(e.source) && keptIds.has(e.target));\n    return { nodes, edges };\n  }\n\n  async function load() {\n    renderLoading(host, props);\n    try {\n      let payload;\n      if (props.data && (props.data.nodes || props.data.edges)) {\n        payload = { nodes: props.data.nodes || [], edges: props.data.edges || [] };\n      } else {\n        const response = await client.runtimeFetch(buildOntologyPath(props));\n        payload = await client.readRuntimeJson(response);\n        if (!payload || !Array.isArray(payload.nodes) || payload.nodes.length === 0) {\n          payload = await loadGraphFullFallback();\n        }\n      }\n      if (aborted) return;\n      const nodes = payload && Array.isArray(payload.nodes) ? payload.nodes : [];\n      const edges = payload && Array.isArray(payload.edges) ? payload.edges : [];\n      if (nodes.length === 0) {\n        lastLayout = computeLayout([], []);\n        renderEmpty(host, props);\n        return;\n      }\n      lastLayout = computeLayout(nodes, edges);\n      paint(lastLayout);\n    } catch (err) {\n      if (aborted) return;\n      renderError(host, err);\n    }\n  }\n\n  function update(nextProps) {\n    const merged = { ...props, ...nextProps };\n    const fetchKeyChanged =\n      merged.workspace !== props.workspace || (merged.data || null) !== (props.data || null);\n    props = merged;\n    if (fetchKeyChanged) {\n      load();\n    } else if (lastLayout) {\n      paint(lastLayout);\n    }\n  }\n\n  function refresh() {\n    return load();\n  }\n\n  function destroy() {\n    aborted = true;\n    if (typeof host.removeEventListener === \"function\") {\n      host.removeEventListener(\"click\", onClick);\n    }\n    if (rendererHandle && typeof rendererHandle.dispose === \"function\") {\n      try {\n        rendererHandle.dispose();\n      } catch (_e) {\n        /* swallow */\n      }\n    }\n    rendererHandle = null;\n    host.classList.remove(\"prime-silo-kg\");\n    host.innerHTML = \"\";\n    delete host.dataset.widgetState;\n  }\n\n  load();\n\n  return {\n    update,\n    refresh,\n    destroy,\n    get layout() {\n      return lastLayout;\n    }\n  };\n}\n\nexport const __testing = {\n  buildOntologyPath,\n  computeLayout,\n  renderSvg,\n  renderEdgeSvg,\n  renderNodeSvg,\n  pickCategoryColor,\n  pickEdgeColor,\n  clampLayer,\n  CATEGORY_COLORS,\n  EDGE_COLORS,\n  MIN_LAYER,\n  MAX_LAYER\n};\n","numLines":471,"startLine":1,"totalLines":471}},"sourceToolAssistantUUID":"f136f39b-6069-4143-90f4-340650373788","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"HEAD"}
