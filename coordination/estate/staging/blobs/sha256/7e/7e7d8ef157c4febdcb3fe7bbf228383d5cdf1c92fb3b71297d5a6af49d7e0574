{"parentUuid":"056babc3-24c1-40f7-a873-ab45a64b45e6","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\runtime\\benny\\tools\\knowledge.py","snippet":"1\t\"\"\"\n2\tKnowledge Tools - ChromaDB-based semantic search capabilities\n3\t\"\"\"\n4\t\n5\tfrom typing import List, Optional\n6\t\n7\timport chromadb\n8\tfrom chromadb.config import Settings\n9\tfrom langchain_core.tools import tool\n10\t\n11\tfrom ..core.embeddings import LocalEmbeddingFunction\n12\tfrom ..core.workspace import get_workspace_path, smart_output\n13\t\n14\t\n15\tdef get_chromadb_client(workspace_id: str = \"default\") -> chromadb.PersistentClient:\n16\t    \"\"\"Get ChromaDB client for workspace\"\"\"\n17\t    chromadb_path = get_workspace_path(workspace_id, \"chromadb\")\n18\t    chromadb_path.mkdir(parents=True, exist_ok=True)\n19\t    return chromadb.PersistentClient(\n20\t        path=str(chromadb_path), settings=Settings(anonymized_telemetry=False)\n21\t    )\n22\t\n23\t\n24\tdef get_knowledge_collection(\n25\t    client: \"chromadb.PersistentClient\", collection_name: str = \"knowledge\"\n26\t):\n27\t    \"\"\"Get/create a RAG collection bound to the local HTTP embedder.\n28\t\n29\t    CRITICAL — every ingest / query / tool path MUST open the knowledge\n30\t    collection through this helper. Opening it with a bare\n31\t    ``client.get_or_create_collection(name)`` makes ChromaDB fall back to its\n32\t    networked ONNX ``DefaultEmbeddingFunction`` (all-MiniLM-L6-v2, 384-dim),\n33\t    which (a) needs ``onnxruntime`` + an internet download that is absent in\n34\t    the bundled/offline runtime, so ``collection.add`` raises, and (b) does not\n35\t    match the 768-dim ``LocalEmbeddingFunction`` used by the agent search tools,\n36\t    causing a Chroma dimensionality error when both touch the same collection.\n37\t    Routing everything through here keeps a single, offline-safe embedding\n38\t    space across ingest, query, chat, adaptive-RAG and the graph agent.\n39\t    \"\"\"\n40\t    ef = LocalEmbeddingFunction()\n41\t    try:\n42\t        return client.get_or_create_collection(collection_name, embedding_function=ef)\n43\t    except Exception as e:\n44\t        msg = str(e).lower()\n45\t        # A collection created by the OLD code with Chroma's default embedder is\n46\t        # rejected at open time by Chroma >=1.x (\"embedding function conflict:\n47\t        # ... persisted: default\"). Those vectors are unsearchable with the local\n48\t        # embedder anyway, so drop + recreate once. One-time migration; the zero-\n49\t        # install exe self-heals with no manual chromadb cleanup.\n50\t        if \"embedding function\" in msg or \"conflict\" in msg:\n51\t            try:\n52\t                client.delete_collection(collection_name)\n53\t            except Exception:\n54\t                pass\n55\t            return client.get_or_create_collection(collection_name, embedding_function=ef)\n56\t        raise\n57\t\n58\t\n59\tdef heal_collection_dimension(client, collection, collection_name: str, probe_vec: List[float]):\n60\t    \"\"\"Auto-reset a stale vector collection whose stored embedding dimension no\n61\t    longer matches the active embedder, and return the collection to use.\n62\t\n63\t    Pre-fix installs built ``knowledge`` with ChromaDB's 384-dim default\n64\t    embedder; adding 768-dim local vectors now raises a dimensionality error.\n65\t    Those old vectors are unsearchable with the new embedder anyway, so on a\n66\t    mismatch we drop and recreate the collection — the user never has to delete\n67\t    ``chromadb`` dirs by hand (zero-install exe stays self-healing).\n68\t\n69\t    The check uses an explicit-embedding canary add (bypasses the embedding\n70\t    function) so it is deterministic and offline-safe.\n71\t    \"\"\"\n72\t    canary_id = \"__benny_dim_canary__\"\n73\t    vec = [float(x) for x in (probe_vec or [])]\n74\t    if not vec:\n75\t        return collection  # nothing to check against; let real adds proceed\n76\t    try:\n77\t        collection.add(ids=[canary_id], embeddings=[vec], documents=[\"canary\"])\n78\t        # Clean up the canary so it never pollutes retrieval.\n79\t        try:\n80\t            collection.delete(ids=[canary_id])\n81\t        except Exception:\n82\t            pass\n83\t        return collection\n84\t    except Exception as e:\n85\t        msg = str(e).lower()\n86\t        if \"dimension\" in msg or \"dimensionality\" in msg:\n87\t            try:\n88\t                client.delete_collection(collection_name)\n89\t            except Exception:\n90\t                pass\n91\t            return get_knowledge_collection(client, collection_name)\n92\t        # Unknown failure — best-effort canary cleanup, then re-raise so the\n93\t        # caller surfaces a real indexing problem rather than masking it.\n94\t        try:\n95\t            collection.delete(ids=[canary_id])\n96\t        except Exception:\n97\t            pass\n98\t        raise\n99\t\n100\t\n101\t@tool\n102\tdef search_knowledge_workspace(\n103\t    query: str, workspace: str = \"default\", top_k: int = 20, active_nexus_id: Optional[str] = None\n104\t) -> str:\n105\t    \"\"\"\n106\t    Search the workspace knowledge base using semantic similarity.\n107\t\n108\t    Args:\n109\t        query: Search query to find relevant documents\n110\t        workspace: Workspace ID for scoped search\n111\t        top_k: Number of results to return\n112\t\n113\t    Returns:\n114\t        Formatted search results with sources and relevance scores\n115\t    \"\"\"\n116\t    try:\n117\t        client = get_chromadb_client(workspace)\n118\t        collection = get_knowledge_collection(client)\n119\t\n120\t        if collection.count() == 0:\n121\t            return \"📭 Knowledge base is empty. Ingest documents first.\"\n122\t\n123\t        # Filter by run_id if a Nexus is active\n124\t        query_params = {\"query_texts\": [query], \"n_results\": min(top_k, collection.count())}\n125\t        if active_nexus_id and active_nexus_id.strip() and active_nexus_id != \"neural_nexus\":\n126\t            query_params[\"where\"] = {\"run_id\": active_nexus_id.strip()}\n127\t\n128\t        results = collection.query(**query_params)\n129\t\n130\t        if not results[\"documents\"][0]:\n131\t            return \"No relevant documents found.\"\n132\t\n133\t        output_lines = [f\"🔍 Found {len(results['documents'][0])} results for: '{query}'\\n\"]\n134\t\n135\t        for i, (doc, meta, distance) in enumerate(\n136\t            zip(results[\"documents\"][0], results[\"metadatas\"][0], results[\"distances\"][0])\n137\t        ):\n138\t            source = meta.get(\"source\", \"Unknown\")\n139\t            relevance = round((1 - distance) * 100, 1)\n140\t            output_lines.append(f\"**[{i+1}] {source}** (relevance: {relevance}%)\")\n141\t            output_lines.append(f\"```\\n{doc[:500]}{'...' if len(doc) > 500 else ''}\\n```\\n\")\n142\t\n143\t        return \"\\n\".join(output_lines)\n144\t\n145\t    except Exception as e:\n146\t        return f\"❌ Search error: {str(e)}\"\n147\t\n148\t\n149\t@tool\n150\tdef list_available_documents(workspace: str = \"default\") -> str:\n151\t    \"\"\"\n152\t    List all documents in a workspace's knowledge base.\n153\t\n154\t    Args:\n155\t        workspace: Workspace ID\n156\t\n157\t    Returns:\n158\t        List of documents with chunk counts\n159\t    \"\"\"\n160\t    try:\n161\t        client = get_chromadb_client(workspace)\n162\t        collection = get_knowledge_collection(client)\n163\t\n164\t        if collection.count() == 0:\n165\t            return \"📭 No documents in knowledge base.\"\n166\t\n167\t        # Get all metadata to extract unique sources\n168\t        all_data = collection.get(include=[\"metadatas\"])\n169\t        sources = {}\n170\t\n171\t        for meta in all_data[\"metadatas\"]:\n172\t            source = meta.get(\"source\", \"Unknown\")\n173\t            sources[source] = sources.get(source, 0) + 1\n174\t\n175\t        output_lines = [\n176\t            f\"📚 Knowledge Base: {len(sources)} documents ({collection.count()} total chunks)\\n\"\n177\t        ]\n178\t        for source, chunks in sorted(sources.items()):\n179\t            output_lines.append(f\"  • {source} ({chunks} chunks)\")\n180\t\n181\t        return \"\\n\".join(output_lines)\n182\t\n183\t    except Exception as e:\n184\t        return f\"❌ Error listing documents: {str(e)}\"\n185\t\n186\t\n187\t@tool\n188\tdef read_full_document(document_name: str, workspace: str = \"default\") -> str:\n189\t    \"\"\"\n190\t    Retrieve complete document content from the knowledge base.\n191\t\n192\t    Args:\n193\t        document_name: Name of document to read\n194\t        workspace: Workspace ID\n195\t\n196\t    Returns:\n\n... [24 lines truncated] ..."},"type":"attachment","uuid":"bf1d4987-3913-4a34-ac2e-a0b35d4c5191","timestamp":"2026-07-03T14:26:00.956Z","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"HEAD"}
