}\")\n        self.kv.put(_kb(_PAYLOAD, key), payload)\n        self.kv.put_raw(_kb(_VECTOR, key), vec.tobytes())\n        if metadata is not None:\n            self.kv.put_raw(_kb(_META, key), json.dumps(metadata).encode(\"utf-8\"))\n        self.index.add(np.array([key], dtype=np.uint64), binarize(vec))\n\n    def put_many(self, items: list[tuple[int, np.ndarray, bytes, dict | None]]) -> None:\n        keys = np.array([k for k, *_ in items], dtype=np.uint64)\n        vectors = np.vstack(\n            [np.asarray(v, dtype=np.float32).reshape(1, -1) for _, v, *_ in items]\n        )\n        if vectors.shape[1] != self.ndim:\n            raise ValueError(f\"vector dim {vectors.shape[1]} != store ndim {self.ndim}\")\n        for (key, _, payload, metadata), vec in zip(items, vectors):\n            self.kv.put(_kb(_PAYLOAD, key), payload)\n            self.kv.put_raw(_kb(_VECTOR, key), vec.tobytes())\n            if metadata is not None:\n                self.kv.put_raw(_kb(_META, key), json.dumps(metadata).encode(\"utf-8\"))\n        self.index.add(keys, binarize(vectors))\n\n    # ------------------------------------------------------------------- read\n    def get(self, key: int) -> tuple[bytes | None, dict | None]:\n        payload = self.kv.get(_kb(_PAYLOAD, key))\n        meta_raw = self.kv.get_raw(_kb(_META, key))\n        return payload, json.loads(meta_raw) if meta_raw is not None else None\n\n    def vector(self, key: int) -> np.ndarray | None:\n        raw = self.kv.get_raw(_kb(_VECTOR, key))\n        return None if raw is None else np.frombuffer(raw, dtype=np.float32)\n\n    def search(self, query_vector: np.ndarray, k: int = 10) -> list[tuple[int, float]]:\n        \"\"\"Binary candidate search + float32 cosine rescore (ADR-002).\"\"\"\n        q = np.asarray(query_vector, dtype=np.float32).reshape(-1)\n        if q.shape[0] != self.ndim:\n            raise ValueError(f\"query dim {q.shape[0]} != store ndim {self.ndim}\")\n        if len(self.index) == 0:\n            return []\n        # Candidate breadth: k*oversample with a floor. Measured (ADR-002): the\n        # recall knee sits at a candidate COUNT tied to corpus density, not at\n        # a fixed multiple of k — the floor absorbs density variation.\n        n_candidates = min(len(self.index), max(k * self.oversample, self.min_candidates))\n        candidates, _ = self.index.search(binarize(q)[0], n_candidates)\n        if candidates.size == 0:\n            return []\n        floats = np.vstack([self.vector(int(c)) for c in candidates])\n        scores = cosine_scores(q, floats)\n        # Deterministic order: score desc, then key asc.\n        order = np.lexsort((candidates, -scores))[:k]\n        return [(int(candidates[i]), float(scores[i])) for i in order]\n\n    # -------------------------------------------------------------- lifecycle\n    def __len__(self) -> int:\n        return len(self.index)\n\n    def _index_filename(self) -> str:\n        return \"index.usearch\" if self.index_backend == \"usearch\" else \"index.npz\"\n\n    def _write_manifest(self) -> None:\n        (self.path / _MANIFEST).write_text(\n            json.dumps(\n                {\n                    \"format\": \"s16.store/1\",\n                    \"ndim\": self.ndim,\n                    \"index_backend\": self.index_backend,\n                    \"index_file\": self._index_filename(),\n                    \"oversample\": self.oversample,\n                },\n                indent=2,\n            ),\n            \"utf-8\",\n        )\n\n    def persist(self) -> None:\n        index_path = self.path / self._index_filename()\n        self.index.save(index_path)\n        # np.savez appends .npz when missing; normalize so the manifest is truthful.\n        appended = index_path.with_name(index_path.name + \".npz\")\n        if not index_path.exists() and appended.exists():\n            appended.replace(index_path)\n        self._write_manifest()\n        self.kv.flush()\n\n    def close(self) -> None:\n        self.kv.close()\n","structuredPatch":[{"oldStart":147,"oldLines":6,"newStart":147,"newLines":7,"lines":["                     \"index_backend\": self.index_backend,","                     \"index_file\": self._index_filename(),","                     \"oversample\": self.oversample,","+                    \"min_candidates\": self.min_candidates,","                 },","                 indent=2,","             ),"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"161a4346-acda-4a0e-aa44-3d1588a88e38","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\s16","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"HEAD"}
