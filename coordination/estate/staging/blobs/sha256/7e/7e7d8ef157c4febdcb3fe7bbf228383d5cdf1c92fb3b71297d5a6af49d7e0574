s.join(\"; \")}. Return corrected JSON only.`\n232\t            : \"\";\n233\t        const res = await chat({\n234\t          system,\n235\t          user: pack + feedback,\n236\t          maxTokens: config.CARD_MAX_TOKENS,\n237\t          json: true\n238\t        });\n239\t        tokens = {\n240\t          prompt: tokens.prompt + res.prompt_tokens,\n241\t          completion: tokens.completion + res.completion_tokens,\n242\t          estimated: res.usage_estimated\n243\t        };\n244\t        const parsed = lastBalancedJson(res.content);\n245\t        gateErrors = validateCard(parsed, { sessionId: item.id, agent: item.agent });\n246\t        if (gateErrors.length === 0) card = parsed;\n247\t      } catch (e) {\n248\t        gateErrors = [`llm error: ${e.message}`];\n249\t      }\n250\t    }\n251\t\n252\t    const ms = Date.now() - started;\n253\t    if (card) {\n254\t      fs.writeFileSync(cardPath(item.id), JSON.stringify(card, null, 2));\n255\t      appendLedger({\n256\t        phase: \"map\",\n257\t        session_id: item.id,\n258\t        status: \"ok\",\n259\t        ms,\n260\t        retries,\n261\t        prompt_tokens: tokens.prompt,\n262\t        completion_tokens: tokens.completion,\n263\t        usage_estimated: tokens.estimated,\n264\t        project: card.project\n265\t      });\n266\t      ok++;\n267\t      console.log(\n268\t        `[map] ok  ${sid8(item.id)} ${card.project.padEnd(20).slice(0, 20)} ${(ms / 1000).toFixed(0)}s`\n269\t      );\n270\t    } else {\n271\t      appendLedger({\n272\t        phase: \"map\",\n273\t        session_id: item.id,\n274\t        status: \"failed\",\n275\t        ms,\n276\t        retries,\n277\t        gate_errors: gateErrors\n278\t      });\n279\t      failed++;\n280\t      console.log(\n281\t        `[map] FAIL ${sid8(item.id)} ${(ms / 1000).toFixed(0)}s — ${gateErrors.join(\"; \").slice(0, 120)}`\n282\t      );\n283\t    }\n284\t\n285\t    const allVerdicts = mapVerdicts();\n286\t    const doneCount = [...allVerdicts.values()].filter((v) => v.status === \"ok\").length;\n287\t    const okLedger = readLedger().filter((e) => e.phase === \"map\" && e.status === \"ok\" && e.ms);\n288\t    const avgMs = okLedger.length ? okLedger.reduce((a, e) => a + e.ms, 0) / okLedger.length : 0;\n289\t    const remaining = inventory.length - allVerdicts.size;\n290\t    writeStatus({\n291\t      phase: \"map\",\n292\t      backlog_total: inventory.length,\n293\t      cards_ok: doneCount,\n294\t      map_failed: [...allVerdicts.values()].filter((v) => v.status === \"failed\").length,\n295\t      map_thin: [...allVerdicts.values()].filter((v) => v.status === \"skipped_thin\").length,\n296\t      current_session: sid8(item.id),\n297\t      cards_per_hour: avgMs ? +(3600000 / avgMs).toFixed(1) : null,\n298\t      eta_hours_remaining: avgMs ? +((remaining * avgMs) / 3600000).toFixed(1) : null\n299\t    });\n300\t  }\n301\t  console.log(\n302\t    `[map] done: ok=${ok} failed=${failed} thin=${thin}${interrupted ? \" (interrupted — resume with the same command)\" : \"\"}`\n303\t  );\n304\t}\n305\t\n306\t// -------------------------------------------------------------------- model\n307\tfunction loadCards() {\n308\t  const dir = stateDir(\"cards\");\n309\t  return fs\n310\t    .readdirSync(dir)\n311\t    .filter((f) => f.endsWith(\".json\"))\n312\t    .map((f) => JSON.parse(fs.readFileSync(path.join(dir, f), \"utf8\")));\n313\t}\n314\t\n315\tfunction renderCardMd(card) {\n316\t  const list = (k, label) =>\n317\t    card[k] && card[k].length ? `**${label}:**\\n${card[k].map((x) => `- ${x}`).join(\"\\n\")}` : \"\";\n318\t  // Three H2 sections, not ten: deep synthesis extracts per H2 section (capped\n319\t  // at 10/doc), so section count IS the per-document LLM cost. Ten sections\n320\t  // cost ~10 min/doc and caused the 30-min batch timeouts; three cost ~3 min.\n321\t  const overview = [\n322\t    card.intent,\n323\t    list(\"applications\", \"Applications\"),\n324\t    list(\"capabilities\", \"Capabilities\")\n325\t  ]\n326\t    .filter(Boolean)\n327\t    .join(\"\\n\\n\");\n328\t  const happened = [\n329\t    list(\"decisions\", \"Decisions\"),\n330\t    list(\"outcomes\", \"Outcomes\"),\n331\t    list(\"failures\", \"Failures\")\n332\t  ]\n333\t    .filter(Boolean)\n334\t    .join(\"\\n\\n\");\n335\t  const threads = [\n336\t    list(\"skills_observed\", \"Skills observed\"),\n337\t    list(\"operator_traits\", \"Operator traits\"),\n338\t    list(\"open_threads\", \"Open threads\"),\n339\t    list(\"proposed_next\", \"Proposed next\")\n340\t  ]\n341\t    .filter(Boolean)\n342\t    .join(\"\\n\\n\");\n343\t  return [\n344\t    `# Session card: ${card.project} (${card.period})`,\n345\t    `Session ${card.session_id} · agent ${card.agent}`,\n346\t    `\\n## Overview\\n${overview || \"(none)\"}`,\n347\t    `\\n## What happened\\n${happened || \"(none)\"}`,\n348\t    `\\n## Threads and signals\\n${threads || \"(none)\"}`\n349\t  ].join(\"\\n\");\n350\t}\n351\t\n352\t// Fire-and-poll ingest. A deep-synthesis ingest holds the HTTP response open\n353\t// for many minutes; Node's undici kills idle connections at ~5 min regardless\n354\t// of AbortSignal (seen live: \"fetch failed\" while the server kept working and\n355\t// the graph kept filling). So: POST with a client-generated run_id, tolerate\n356\t// the connection dying, and poll the runtime's task record until it settles.\n357\t// This also serializes batches — the next POST waits for this task to finish.\n358\tasync function ingestBatch(batch, { deepSynthesis = config.DEEP_SYNTHESIS } = {}) {\n359\t  const runId = crypto.randomUUID();\n360\t  const post = fetch(`${config.BENNY_API_BASE}/api/rag/ingest`, {\n361\t    method: \"POST\",\n362\t    headers: { \"Content-Type\": \"application/json\", \"X-Benny-API-Key\": config.BENNY_API_KEY },\n363\t    body: JSON.stringify({\n364\t      workspace: config.WORKSPACE,\n365\t      files: batch,\n366\t      run_id: runId,\n367\t      deep_synthesis: deepSynthesis,\n368\t      model: config.INGEST_MODEL\n369\t    })\n370\t  }).catch(() => null); // connection death ≠ ingest death — the task record decides\n371\t\n372\t  const started = Date.now();\n373\t  const deadline = started + config.INGEST_TIMEOUT_MS;\n374\t  let seen = false;\n375\t  while (Date.now() < deadline) {\n376\t    await new Promise((r) => setTimeout(r, 10000));\n377\t    let task = null;\n378\t    try {\n379\t      const res = await fetch(`${config.BENNY_API_BASE}/api/tasks`, {\n380\t        headers: { \"X-Benny-API-Key\": config.BENNY_API_KEY },\n381\t        signal: AbortSignal.timeout(15000)\n382\t      });\n383\t      const tasks = await res.json();\n384\t      task = Array.isArray(tasks) ? tasks.find((t) => t.task_id === runId) : null;\n385\t    } catch {\n386\t      continue; // transient — keep polling\n387\t    }\n388\t    if (!task) {\n389\t      // The handler registers the task before any work, so a task that never\n390\t      // appears means the POST was rejected — surface its status if the\n391\t      // response is available, without hanging on a still-open connection.\n392\t      if (!seen && Date.now() - started > 60000) {\n393\t        const r = await Promise.race([\n394\t          post,\n395\t          new Promise((res) => setTimeout(() => res(undefined), 5000))\n396\t        ]);\n397\t        return {\n398\t          ok: false,\n399\t          runId,\n400\t          error: r ? `submit rejected (${r.status})` : \"no task registered after 60s\"\n401\t        };\n402\t      }\n403\t      continue;\n404\t    }\n405\t    seen = true;\n406\t    if (task.status === \"completed\" || task.status === \"completed_with_errors\") {\n407\t      return { ok: true, runId, partial: task.status === \"completed_with_errors\" };\n408\t    }\n409\t    if (task.status === \"failed\") return { ok: false, runId, error: task.message || \"task failed\" };\n410\t    if (interrupted)\n411\t      return { ok: false, runId, error: \"interrupted while waiting (server task continues)\" };\n412\t  }\n413\t  return {\n414\t    ok: false,\n415\t    runId,\n416\t    error: `timeout after ${config.INGEST_TIMEOUT_MS}ms (server task may still be running)`\n417\t  };\n418\t}\n419\t\n420\tasync function runModel() {\n421\t  const cards = loadCards();\n422\t  if (cards.length === 0) {\n423\t    console.log(\"[model] no cards yet — run map first\");\n424\t    return;\n425\t  }\n426\t\n427\t  // Rollups — deterministic aggregation, recomputed from scratch every time.\n428\t  const projects = {},\n429\t    capabilities = {},\n430\t    timeline = {},\n431\t    operator = { traits: {}, skills: {} },\n432\t    openThreads = [],\n433\t    proposedNext = [],\n434\t    sids = {};\n435\t  for (const c of cards) {\n436\t    sids[sid8(c.session_id)] = c.session_id;\n437\t    const p = (projects[c.project] ||= {\n438\t      sessions: [],\n439\t      months: new Set(),\n440\t      applications: new Set(),\n441\t      capabilities: new Set(),\n442\t      outcomes: 0,\n443\t      open_threads: [],\n444\t      proposed_next: []\n445\t    });\n446\t    p.sessions.push(sid8(c.session_id));\n447\t    p.months.add(c.period);\n448\t    for (const a of c.applications || []) p.applications.add(a);\n449\t    for (const k of c.capabilities || []) {\n450\t      p.capabilities.add(k);\n451\t      (capabilities[k] ||= new Set()).add(c.project);\n452\t    }\n453\t    p.outcomes += (c.outcomes || []).length;\n454\t    for (const t of c.open_threads || []) {\n455\t      p.open_threads.push(t);\n456\t      openThreads.push({ project: c.project, sid: sid8(c.session_id), thread: t });\n457\t    }\n458\t    for (const n of c.proposed_next || []) {\n459\t      p.proposed_next.push(n);\n460\t      proposedNext.push({ project: c.project, sid: sid8(c.session_id), next: n });\n461\t    }\n462\t    const m = (timeline[c.period] ||= { projects: new Set(), sessions: 0 });\n463\t    m.projects.add(c.project);\n464\t    m.sessions++;\n465\t    for (const t of c.operator_traits || []) (operator.traits[t] ||= []).push(sid8(c.session_id));\n466\t    for (const s of c.skills_observed || []) (operator.skills[s] ||= []).push(sid8(c.session_id));\n467\t  }\n468\t  const dehydrate = (o) => JSON.parse(JSON.stringify(o, (k, v) => (v instanceof Set ? [...v] : v)));\n469\t  fs.writeFileSync(\n470\t    stateDir(\"rollups\", \"projects.json\"),\n471\t    JSON.stringify(dehydrate(projects), null, 2)\n472\t  );\n473\t  fs.writeFileSync(\n474\t    stateDir(\"rollups\", \"capabilities.json\"),\n475\t    JSON.stringify(dehydrate(capabilities), null, 2)\n476\t  );\n477\t  fs.writeFileSync(\n478\t    stateDir(\"rollups\", \"timeline.json\"),\n479\t    JSON.stringify(dehydrate(timeline), null, 2)\n480\t  );\n481\t  fs.writeFileSync(stateDir(\"rollups\", \"operator.json\"), JSON.stringify(operator, null, 2));\n482\t  fs.writeFileSync(\n483\t    stateDir(\"rollups\", \"threads.json\"),\n484\t    JSON.stringify({ open_threads: openThreads, proposed_next: proposedNext }, null, 2)\n485\t  );\n486\t  fs.writeFileSync(stateDir(\"rollups\", \"sids.json\"), JSON.stringify(sids, null, 2));\n487\t  console.log(\n488\t    `[model] rollups: ${Object.keys(projects).length} projects, ${Object.keys(capabilities).length} capabilities, ${Object.keys(timeline).length} months`\n489\t  );\n490\t\n491\t  // Cards → workspace data_in as markdown, then into the knowledge graph.\n492\t  // Ingestion state is tracked explicitly (a render is not an ingest — the\n493\t  // pilot hit exactly that: rendered files, failed ingest, nothing to retry).\n494\t  for (const c of cards) {\n495\t    const p = workspaceDir(\"data_in\", `longview_card_${sid8(c.session_id)}.md`);\n496\t    if (!fs.existsSync(p)) fs.writeFileSync(p, renderCardMd(c));\n497\t  }\n498\t  const ingestedPath = stateDir(\"rollups\", \"ingested.json\");\n499\t  let ingested = [];\n500\t  try {\n501\t    ingested = JSON.parse(fs.readFileSync(ingestedPath, \"utf8\"));\n502\t  } catch {\n503\t    /* first run */\n504\t  }\n505\t  const ingestedSet = new Set(ingested);\n506\t  const pending = cards\n507\t    .map((c) => `longview_card_${sid8(c.session_id)}.md`)\n508\t    .filter((n) => !ingestedSet.has(n));\n509\t  console.log(`[model] ${pending.length} card docs pending graph ingestion`);\n510\t\n511\t  if (!flag(\"no-graph\") && pending.length) {\n512\t    const step = config.DEEP_SYNTHESIS ? config.INGEST_BATCH : 25;\n513\t    console.log(\n514\t      `[model] deep_synthesis=${config.DEEP_SYNTHESIS} (${config.DEEP_SYNTHESIS ? \"cards become graph Documents/Concepts — LLM per doc, slow\" : \"vectors only — the graph stays EMPTY\"})`\n515\t    );\n516\t    for (let i = 0; i < pending.length; i += step) {\n517\t      const batch = pending.slice(i, i + step);\n518\t      process.stdout.write(\n519\t        `[model] /rag/ingest batch ${Math.floor(i / step) + 1} (${batch.length} files)… `\n520\t      );\n521\t      const verdict = await ingestBatch(batch);\n522\t      console.log(verdict.ok ? `ok (run ${verdict.runId})` : `FAILED (${verdict.error})`);\n523\t      appendLedger({\n524\t        phase: \"model\",\n525\t        action: \"ingest\",\n526\t        files: batch.length,\n527\t        deep_synthesis: config.DEEP_SYNTHESIS,\n528\t        ok: verdict.ok,\n529\t        run_id: verdict.runId,\n530\t        ...(verdict.error ? { error: verdict.error } : {})\n531\t      });\n532\t      if (verdict.ok) {\n533\t        for (const n of batch) ingestedSet.add(n);\n534\t        fs.writeFileSync(ingestedPath, JSON.stringify([...ingestedSet], null, 2));\n535\t      }\n536\t      if (interrupted) break;\n537\t    }\n538\t  }\n539\t  writeStatus({ phase: \"model\", cards_ok: cards.length, projects: Object.keys(projects).length });\n540\t}\n541\t\n542\t// ------------------------------------------------------------------- reduce\n543\tasync function reduceCall(name, system, user, outPath) {\n544\t  const started = Date.now();\n545\t  // Per-part slices control composition; this cap guarantees the total fits\n546\t  // the model's context window regardless of corpus size (see config note).\n547\t  user = user.slice(0, config.REDUCE_INPUT_BUDGET);\n548\t  const res = await chat({ system, user, maxTokens: config.REDUCE_MAX_TOKENS, temperature: 0.4 });\n549\t  fs.writeFileSync(outPath, res.content);\n550\t  appendLedger({\n551\t    phase: \"reduce\",\n552\t    artifact: name,\n553\t    ms: Date.now() - started,\n554\t    prompt_tokens: res.prompt_tokens,\n555\t    completion_tokens: res.completion_tokens,\n556\t    usage_estimated: res.usage_estimated\n557\t  });\n558\t  console.log(\n559\t    `[reduce] ${name} → ${path.relative(config.BENNY_HOME, outPath)} (${((Date.now() - started) / 1000).toFixed(0)}s)`\n560\t  );\n561\t  return res.content;\n562\t}\n563\t\n564\tconst cardDigest = (c) =>\n565\t  JSON.stringify({\n566\t    sid: sid8(c.session_id),\n567\t    period: c.period,\n568\t    intent: c.intent,\n569\t    capabilities: c.capabilities,\n570\t    decisions: c.decisions,\n571\t    outcomes: c.outcomes,\n572\t    failures: c.failures,\n573\t    open_threads: c.open_threads,\n574\t    proposed_next: c.proposed_next\n575\t  });\n576\t\n577\tasync function runReduce({ onlyOverride = null, skipBookOverride = null } = {}) {\n578\t  const cards = loadCards();\n579\t  if (!cards.length) return console.log(\"[reduce] no cards — run map first\");\n580\t  const only = onlyOverride ?? (opt(\"only\", \"\") || \"\").split(\",\").filter(Boolean);\n581\t  const skipBook = skipBookOverride ?? flag(\"skip-book\");\n582\t  const want = (n) => only.length === 0 || only.includes(n);\n583\t  const rollup = (n) => fs.readFileSync(stateDir(\"rollups\", `${n}.json`), \"utf8\");\n584\t  const outDir = (...p) => workspaceDir(\"data_out\", ...p);\n585\t  writeStatus({ phase: \"reduce\" });\n586\t\n587\t  // 1. Project dossiers — one bounded call per project.\n588\t  const byProject = {};\n589\t  for (const c of cards) (byProject[c.project] ||= []).push(c);\n590\t  const dossiers = {};\n591\t  if (want(\"dossiers\")) {\n592\t    for (const [project, pcards] of Object.entries(byProject)) {\n593\t      if (interrupted) break;\n594\t      pcards.sort((a, b) => (a.period || \"\").localeCompare(b.period || \"\"));\n595\t      const user = `Project: ${project}\\nSession cards (chronological, one JSON per line):\\n${pcards\n596\t        .map(cardDigest)\n597\t        .join(\"\\n\")\n598\t        .slice(0, 24000)}`;\n599\t      const safe = project.replace(/[^a-z0-9-_]+/gi, \"_\").slice(0, 60);\n600\t      dossiers[project] = await reduceCall(\n601\t        `dossier:${project}`,\n602\t        prompt(\"project_dossier\"),\n603\t        user,\n604\t        outDir(\"dossiers\", `${safe}.md`)\n605\t      );\n606\t    }\n607\t  } else {\n608\t    for (const f of fs.readdirSync(outDir(\"dossiers\"))) {\n609\t      if (f.endsWith(\".md\"))\n610\t        dossiers[f.replace(/\\.md$/, \"\")] = fs.readFileSync(outDir(\"dossiers\", f), \"utf8\");\n611\t    }\n612\t  }\n613\t\n614\t  const dossierSummaries = Object.entries(dossiers)\n615\t    .map(([p, d]) => `--- ${p} ---\\n${d.slice(0, 2200)}`)\n616\t    .join(\"\\n\\n\")\n617\t    .slice(0, 26000);\n618\t\n619\t  // 2. Cross-project themes — the greater-than-the-sum pass.\n620\t  let themes = \"\";\n621\t  // Discovery notes (weave phase) — when they exist, every synthesis input\n622\t  // stands on them too: the loop's findings compound into the deliverables.\n623\t  let discoveryDigest = \"\";\n624\t  try {\n625\t    const dDir = outDir(\"discovery\");\n626\t    discoveryDigest = fs\n627\t      .readdirSync(dDir)\n628\t      .filter((f) => f.endsWith(\".md\"))\n629\t      .map((f) => fs.readFileSync(path.join(dDir, f), \"utf8\").slice(0, 1200))\n630\t      .join(\"\\n\\n---\\n\\n\")\n631\t      .slice(0, 8000);\n632\t  } catch {\n633\t    /* no weave yet */\n634\t  }\n635\t\n636\t  if (want(\"themes\") && !interrupted) {\n637\t    themes = await reduceCall(\n638\t      \"themes\",\n639\t      prompt(\"themes\"),\n640\t      `${dossierSummaries}\\n\\n## Timeline rollup\\n${rollup(\"timeline\")}\\n\\n## Operator rollup\\n${rollup(\"operator\").slice(0, 6000)}${discoveryDigest ? `\\n\\n## Discovery notes (cross-reference findings)\\n${discoveryDigest}` : \"\"}`,\n641\t      outDir(\"THEMES.md\")\n642\t    );\n643\t  } else if (fs.existsSync(outDir(\"THEMES.md\"))) {\n644\t    themes = fs.readFileSync(outDir(\"THEMES.md\"), \"utf8\");\n645\t  }\n646\t\n647\t  // 3-5. Deliverables.\n648\t  if (want(\"report\") && !interrupted) {\n649\t    await reduceCall(\n650\t      \"report\",\n651\t      prompt(\"report\"),\n652\t      `## Themes\\n${themes.slice(0, 8000)}\\n\\n## Dossiers\\n${dossierSummaries.slice(0, 16000)}\\n\\n## Capability rollup\\n${rollup(\"capabilities\").slice(0, 4000)}`,\n653\t      outDir(\"PORTFOLIO-REPORT.md\")\n654\t    );\n655\t  }\n656\t  if (want(\"prd\") && !interrupted) {\n657\t    await reduceCall(\n658\t      \"prd\",\n659\t      prompt(\"prd\"),\n660\t      `## Themes\\n${themes.slice(0, 8000)}\\n\\n## Open threads & proposed next\\n${rollup(\"threads\").slice(0, 14000)}\\n\\n## Dossier summaries\\n${dossierSummaries.slice(0, 8000)}`,\n661\t      outDir(\"PRD-WHAT-COMES-NEXT.md\")\n662\t    );\n663\t  }\n664\t  if (want(\"skill\") && !interrupted) {\n665\t    await reduceCall(\n666\t      \"skill\",\n667\t      prompt(\"skill\"),\n668\t      `## Operator evidence (trait/skill → session ids)\\n${rollup(\"operator\").slice(0, 12000)}\\n\\n## Themes (operating style)\\n${themes.slice(0, 6000)}`,\n669\t      outDir(\"skills\", \"working-with-this-operator.SKILL.md\")\n670\t    );\n671\t  }\n672\t\n673\t  // 6. Book — outline (JSON), then bounded chapter calls.\n674\t  if (want(\"book\") && !skipBook && !interrupted) {\n675\t    const outlineRaw = await reduceCall(\n676\t      \"book:outline\",\n677\t      prompt(\"book_outline\"),\n678\t      `## Themes\\n${themes.slice(0, 6000)}\\n\\n## Dossier summaries\\n${dossierSummaries.slice(0, 14000)}\\n\\n## Timeline\\n${rollup(\"timeline\")}`,\n679\t      outDir(\"book\", \"outline.json\")\n680\t    );\n681\t    const outline = lastBalancedJson(outlineRaw);\n682\t    if (outline?.chapters?.length) {\n683\t      const parts = [`# ${outline.title}\\n\\n_${outline.subtitle || \"\"}_\\n\\n${outline.arc || \"\"}\\n`];\n684\t      for (const ch of outline.chapters) {\n685\t        if (interrupted) break;\n686\t        const relevant = Object.entries(dossiers)\n687\t          .filter(([p]) =>\n688\t            (ch.projects || []).some((x) => p.toLowerCase().includes(String(x).toLowerCase()))\n689\t          )\n690\t          .map(([, d]) => d.slice(0, 5000))\n691\t          .join(\"\\n\\n\");\n692\t        const text = await reduceCall(\n693\t          `book:ch${ch.n}`,\n694\t          prompt(\"book_chapter\"),\n695\t          `## Outline\\n${JSON.stringify(outline).slice(0, 3000)}\\n\\n## This chapter\\n${JSON.stringify(ch)}\\n\\n## Source dossiers\\n${relevant || dossierSummaries.slice(0, 10000)}`,\n696\t          outDir(\"book\", `chapter-${String(ch.n).padStart(2, \"0\")}.md`)\n697\t        );\n698\t        parts.push(text);\n699\t      }\n700\t      fs.writeFileSync(outDir(\"book\", \"BOOK.md\"), parts.join(\"\\n\\n---\\n\\n\"));\n701\t      console.log(`[reduce] book assembled (${outline.chapters.length} chapters)`);\n702\t    } else {\n703\t      console.log(\n704\t        \"[reduce] book outline did not parse — chapters skipped (rerun with --only book)\"\n705\t      );\n706\t    }\n707\t  }\n708\t\n709\t  // 7. TOGAF SAD — prepared for a human-launched swarm run (ADR-001).\n710\t  if (want(\"togaf\")) {\n711\t    fs.writeFileSync(\n712\t      outDir(\"TOGAF-RUN.md\"),\n713\t      [\n714\t        \"# TOGAF SAD over the LONGVIEW graph\",\n715\t        \"\",\n716\t        \"The knowledge graph in this workspace now contains the session-card corpus.\",\n717\t        \"Run the existing 6-task SAD swarm against it (human-launched per ADR-001):\",\n718\t        \"\",\n719\t        \"```powershell\",\n720\t        \"cd \" + path.join(\"runtime\"),\n721\t        `python benny_cli.py run manifests/templates/togaf_sad_report_swarm.json --json ^`,\n722\t        `  --var workspace=${config.WORKSPACE} ^`,\n723\t        `  --var topic=\"The binary16 application estate (LONGVIEW synthesis)\" ^`,\n724\t        `  --var model=lemonade/${config.LONGVIEW_MODEL} ^`,\n725\t        `  --var output_file=data_out/TOGAF_SAD_binary16.md`,\n726\t        \"```\",\n727\t        \"\",\n728\t        \"The swarm's baseline_extraction step queries this workspace's graph, so the\",\n729\t        \"SAD baseline is the synthesized estate, not a single repo. Run appears in\",\n730\t        \"Mission Control / activity feed like any other runtime run.\"\n731\t      ].join(\"\\n\")\n732\t    );\n733\t    console.log(\"[reduce] togaf → data_out/TOGAF-RUN.md (human-launched)\");\n734\t  }\n735\t  writeStatus({ phase: \"reduce_done\", deliverables_at: workspaceDir(\"data_out\") });\n736\t}\n737\t\n738\t// --------------------------------------------------------------------- code\n739\t// AST/code-graph feed (ADR-005 horizontal mechanism, code half): junction the\n740\t// repo into the workspace src/, then run the existing declarative enrichment\n741\t// manifest (Tree-Sitter scan → code graph → CORRELATES_WITH links to the\n742\t// knowledge concepts). Reuses benny enrich end to end.\n743\tasync function runCode() {\n744\t  const srcRoot = workspaceDir(\"src\");\n745\t  const target = path.join(srcRoot, \"prime-silo\");\n746\t  fs.mkdirSync(srcRoot, { recursive: true });\n747\t  if (!fs.existsSync(target)) {\n748\t    // Junction (no admin needed on Windows), so the scan sees the live repo.\n749\t    const r = spawnSync(\"cmd\", [\"/c\", \"mklink\", \"/J\", target, projectRoot], { encoding: \"utf8\" });\n750\t    if (!fs.existsSync(target)) {\n751\t      console.log(`[code] junction failed (${(r.stderr || \"\").trim()}) — skipping code graph`);\n752\t      appendLedger({ phase: \"code\", ok: false, error: \"junction failed\" });\n753\t      return;\n754\t    }\n755\t    console.log(`[code] junction: ${target} → ${projectRoot}`);\n756\t  }\n757\t  writeStatus({ phase: \"code\" });\n758\t  const started = Date.now();\n759\t  console.log(\"[code] benny enrich (Tree-Sitter scan → code graph → correlate)…\");\n760\t  const r = spawnSync(\n761\t    \"python\",\n762\t    [\"benny_cli.py\", \"enrich\", \"--workspace\", config.WORKSPACE, \"--src\", \"src/prime-silo\", \"--run\"],\n763\t    {\n764\t      cwd: path.join(projectRoot, \"runtime\"),\n765\t      encoding: \"utf8\",\n766\t      timeout: 3600000,\n767\t      // The enrich CLI prints progress glyphs (braille spinners) that crash\n768\t      // Python's cp1252 console encoder on Windows — force UTF-8 stdio.\n769\t      env: { ...process.env, PYTHONIOENCODING: \"utf-8\", PYTHONUTF8: \"1\" }\n770\t    }\n771\t  );\n772\t  const ok = r.status === 0;\n773\t  const tail = ((r.stdout || \"\") + (r.stderr || \"\"))\n774\t    .split(\"\\n\")\n775\t    .filter(Boolean)\n776\t    .slice(-4)\n777\t    .join(\" | \");\n778\t  console.log(\n779\t    `[code] ${ok ? \"ok\" : \"FAILED\"} (${((Date.now() - started) / 1000 / 60).toFixed(1)} min) ${tail.slice(0, 300)}`\n780\t  );\n781\t  appendLedger({ phase: \"code\", ok, ms: Date.now() - started, tail: tail.slice(0, 500) });\n782\t}\n783\t\n784\t// -------------------------------------------------------------------- weave\n785\t// Discovery loops (the request: \"loops of discovery… cross reference and\n786\t// discovery through the graph and the text\"). Each loop: ask the model what\n787\t// is under-explored → answer each question from retrieval (chunks + graph\n788\t// concepts) → write a cited discovery note → ingest the note back, so the\n789\t// next loop (and every deliverable) stands on a richer corpus.\n790\tasync function runWeave({ loops = null, questionsPerLoop = null } = {}) {\n791\t  const nLoops = loops ?? Number(opt(\"loops\", 2));\n792\t  const nQuestions = questionsPerLoop ?? Number(opt(\"questions\", 4));\n793\t  const discoveryDir = workspaceDir(\"data_out\", \"discovery\");\n794\t  fs.mkdirSync(discoveryDir, { recursive: true });\n795\t  const outDir = workspaceDir(\"data_out\");\n796\t  const themes = fs.existsSync(path.join(outDir, \"THEMES.md\"))\n797\t    ? fs.readFileSync(path.join(outDir, \"THEMES.md\"), \"utf8\")\n798\t    : \"\";\n799\t\n800\t  for (let loop = 1; loop <= nLoops; loop++) {\n801\t    if (interrupted) break;\n802\t    const existingNotes = fs\n803\t      .readdirSync(discoveryDir)\n804\t      .filter((f) => f.endsWith(\".md\"))\n805\t      .map((f) => \"- \" + f.replace(/\\.md$/, \"\").replace(/_/g, \" \"));\n806\t    const concepts = await graphCatalog(25);\n807\t    writeStatus({ phase: \"weave\", weave_loop: loop, weave_loops_total: nLoops });\n808\t    console.log(`[weave] loop ${loop}/${nLoops}: generating ${nQuestions} discovery questions…`);\n809\t    // Two attempts — local JSON mode sometimes wraps in prose or truncates.\n810\t    let qs = [];\n811\t    for (let attempt = 0; attempt < 2 && qs.length === 0; attempt++) {\n812\t      const started = Date.now();\n813\t      const res = await chat({\n814\t        system: prompt(\"discovery_questions\"),\n815\t        user: [\n816\t          `Generate exactly ${nQuestions} questions.`,\n817\t          `## Current themes\\n${themes.slice(0, 4000)}`,\n818\t          concepts.length ? `## Top graph concepts\\n${concepts.join(\", \")}` : \"\",\n819\t          existingNotes.length\n820\t            ? `## Notes already written\\n${existingNotes.join(\"\\n\").slice(0, 1500)}`\n821\t            : \"\",\n822\t          attempt > 0 ? \"Your previous answer was not valid JSON. Return ONLY the JSON object.\" : \"\"\n823\t        ]\n824\t          .filter(Boolean)\n825\t          .join(\"\\n\\n\"),\n826\t        maxTokens: 900,\n827\t        json: true,\n828\t        temperature: attempt === 0 ? 0.6 : 0.3\n829\t      });\n830\t      qs = lastBalancedJson(res.content)?.questions || [];\n831\t      appendLedger({\n832\t        phase: \"weave\",\n833\t        artifact: `loop${loop}:questions`,\n834\t        ms: Date.now() - started,\n835\t        attempt,\n836\t        count: qs.length\n837\t      });\n838\t      if (!qs.length)\n839\t        console.log(\n840\t          `[weave] loop ${loop} attempt ${attempt + 1}: no questions parsed — head: ${res.content.slice(0, 100).replace(/\\s+/g, \" \")}`\n841\t        );\n842\t    }\n843\t    if (!qs.length) {\n844\t      console.log(`[weave] loop ${loop}: questions failed twice — stopping weave`);\n845\t      break;\n846\t    }\n847\t\n848\t    const noteFiles = [];\n849\t    for (const [i, q] of qs.entries()) {\n850\t      if (interrupted) break;\n851\t      const noteName = `loop${loop}_q${i + 1}.md`;\n852\t      const notePath = path.join(discoveryDir, noteName);\n853\t      if (fs.existsSync(notePath)) continue;\n854\t      const t0 = Date.now();\n855\t      const evidence = await evidenceFor(q.question, { topK: 6, budget: 4200 });\n856\t      const note = await chat({\n857\t        system: prompt(\"discovery_note\"),\n858\t        user: `## Question\\n${q.question}\\n\\n## Why it matters\\n${q.why || \"\"}\\n\\n## Retrieved evidence\\n${evidence}`,\n859\t        maxTokens: 1100,\n860\t        temperature: 0.4\n861\t      });\n862\t      fs.writeFileSync(notePath, note.content.trim());\n863\t      noteFiles.push(noteName);\n864\t      appendLedger({\n865\t        phase: \"weave\",\n866\t        artifact: `loop${loop}:note${i + 1}`,\n867\t        ms: Date.now() - t0,\n868\t        prompt_tokens: note.prompt_tokens,\n869\t        completion_tokens: note.completion_tokens\n870\t      });\n871\t      console.log(`[weave] loop ${loop} note ${i + 1}/${qs.length}: ${q.question.slice(0, 70)}…`);\n872\t    }\n873\t\n874\t    // Feed the notes back into the corpus so the NEXT loop (and opus retrieval)\n875\t    // can stand on them. Vectors are what retrieval needs; graph synthesis of\n876\t    // notes rides the same ingestBatch discipline.\n877\t    for (const name of noteFiles) {\n878\t      const stagedName = `longview_note_${name}`;\n879\t      fs.copyFileSync(path.join(discoveryDir, name), workspaceDir(\"data_in\", stagedName));\n880\t      // Vectors only: notes exist for retrieval, and a deep-synthesis ingest\n881\t      // pays the full ~40-min clustering pass PER NOTE at this graph size.\n882\t      const verdict = await ingestBatch([stagedName], { deepSynthesis: false });\n883\t      appendLedger({\n884\t        phase: \"weave\",\n885\t        action: \"ingest\",\n886\t        file: stagedName,\n887\t        ok: verdict.ok,\n888\t        run_id: verdict.runId\n889\t      });\n890\t      console.log(\n891\t        `[weave] ingest ${stagedName}: ${verdict.ok ? \"ok\" : \"FAILED (\" + verdict.error + \")\"}`\n892\t      );\n893\t      if (interrupted) break;\n894\t    }\n895\t  }\n896\t  writeStatus({ phase: \"weave_done\" });\n897\t}\n898\t\n899\t// ---------------------------------------------------------------------- pdf\n900\tfunction runPdfPhase() {\n901\t  const bookMd = workspaceDir(\"data_out\", \"opus\", \"THE-AI-VAMPIRE.md\");\n902\t  if (!fs.existsSync(bookMd)) {\n903\t    console.log(\n904\t      \"[pdf] no assembled book at data_out/opus/THE-AI-VAMPIRE.md — run the opus phase first\"\n905\t    );\n906\t    return;\n907\t  }\n908\t  const md = fs.readFileSync(bookMd, \"utf8\");\n909\t  const htmlPath = workspaceDir(\"data_out\", \"opus\", \"THE-AI-VAMPIRE.html\");\n910\t  fs.writeFileSync(htmlPath, mdToHtml(md, { title: \"The AI Vampire\" }));\n911\t  const pdfPath = workspaceDir(\"data_out\", \"opus\", \"THE-AI-VAMPIRE.pdf\");\n912\t  const r = htmlToPdf(htmlPath, pdfPath);\n913\t  appendLedger({ phase: \"pdf\", ok: r.ok, bytes: r.bytes, error: r.error });\n914\t  console.log(\n915\t    r.ok\n916\t      ? `[pdf] ${pdfPath} (${(r.bytes / 1024 / 1024).toFixed(1)} MB via ${r.browser})`\n917\t      : `[pdf] FAILED — ${r.error} (HTML is at ${htmlPath})`\n918\t  );\n919\t  writeStatus({ phase: \"pdf_done\", pdf: r.ok ? pdfPath : null });\n920\t}\n921\t\n922\t// ------------------------------------------------------------ status/report\n923\tfunction runStatus() {\n924\t  const s = readStatus();\n925\t  if (!s) return console.log(\"no status yet — run inventory first\");\n926\t  console.log(JSON.stringify(s, null, 2));\n927\t}\n928\t\n929\tfunction runReport() {\n930\t  const ledger = readLedger();\n931\t  const maps = [...mapVerdicts().values()];\n932\t  const ok = maps.filter((e) => e.status === \"ok\");\n933\t  const failed = maps.filter((e) => e.status === \"failed\");\n934\t  const thin = maps.filter((e) => e.status === \"skipped_thin\");\n935\t  const msArr = ok\n936\t    .map((e) => e.ms)\n937\t    .filter(Boolean)\n938\t    .sort((a, b) => a - b);\n939\t  const median = msArr.length ? msArr[Math.floor(msArr.length / 2)] : 0;\n940\t  const mean = msArr.length ? msArr.reduce((a, b) => a + b, 0) / msArr.length : 0;\n941\t  const tok = (k) => ok.reduce((a, e) => a + (e[k] || 0), 0);\n942\t  const estimated = ok.some((e) => e.usage_estimated);\n943\t  let total = 0;\n944\t  try {\n945\t    total = loadInventory().length;\n946\t  } catch {\n947\t    /* no inventory */\n948\t  }\n949\t  const remaining = Math.max(0, total - maps.length);\n950\t  const reduces = ledger.filter((e) => e.phase === \"reduce\");\n951\t  console.log(\n952\t    [\n953\t      \"LONGVIEW ledger report (every number below comes from the ledger)\",\n954\t      `  inventory total : ${total || \"unknown\"}`,\n955\t      `  cards ok        : ${ok.length}`,\n956\t      `  map failed      : ${failed.length}`,\n957\t      `  skipped thin    : ${thin.length}`,\n958\t      `  remaining       : ${remaining}`,\n959\t      `  per-card median : ${(median / 1000).toFixed(1)}s   mean: ${(mean / 1000).toFixed(1)}s`,\n960\t      `  throughput      : ${mean ? (3600000 / mean).toFixed(1) : \"?\"} cards/hour`,\n961\t      `  est. remaining  : ${mean ? ((remaining * mean) / 3600000).toFixed(1) : \"?\"} hours`,\n962\t      `  tokens (map)    : prompt ${tok(\"prompt_tokens\")}, completion ${tok(\"completion_tokens\")}${estimated ? \" (some ESTIMATED — server omitted usage)\" : \"\"}`,\n963\t      `  reduce artifacts: ${reduces.length}`,\n964\t      failed.length ? `  failed sids     : ${failed.map((e) => sid8(e.session_id)).join(\", \")}` : \"\"\n965\t    ]\n966\t      .filter(Boolean)\n967\t      .join(\"\\n\")\n968\t  );\n969\t}\n970\t\n971\t// -------------------------------------------------------------------- delta\n972\tasync function runDelta() {\n973\t  await runInventory();\n974\t  runExtractForce(); // extract only missing/changed packs\n975\t  const before = [...mapVerdicts().values()].filter((v) => v.status === \"ok\").length;\n976\t  await runMap({ deltaMode: true });\n977\t  const after = [...mapVerdicts().values()].filter((v) => v.status === \"ok\").length;\n978\t  const newCards = after - before;\n979\t  await runModel();\n980\t  if (flag(\"refresh\") || newCards >= config.DELTA_REDUCE_THRESHOLD) {\n981\t    console.log(`[delta] ${newCards} new cards → re-running reduce`);\n982\t    await runReduce();\n983\t  } else {\n984\t    console.log(\n985\t      `[delta] ${newCards} new cards (< ${config.DELTA_REDUCE_THRESHOLD}) — reduce skipped; use --refresh to force`\n986\t    );\n987\t  }\n988\t}\n989\t\n990\t// Delta extract: rebuild packs for sessions newer than their existing pack.\n991\tfunction runExtractForce() {\n992\t  const inventory = loadInventory();\n993\t  const sessionById = new Map(listSessions().map((s) => [s.id, s]));\n994\t  let done = 0;\n995\t  for (const item of inventory) {\n996\t    if (interrupted) break;\n997\t    const p = evidencePath(item.id);\n998\t    if (fs.existsSync(p) && fs.statSync(p).mtimeMs >= (item.timestamp || 0)) continue;\n999\t    const session = sessionById.get(item.id);\n1000\t    if (!session) continue;\n1001\t    const ev = buildEvidencePack(session);\n1002\t    fs.writeFileSync(p, ev.pack);\n1003\t    fs.writeFileSync(\n1004\t      evidenceMetaPath(item.id),\n1005\t      JSON.stringify(\n1006\t        {\n1007\t          signal_chars: ev.signalChars,\n1008\t          artifact_names: ev.artifactNames,\n1009\t          project: ev.project,\n1010\t          first_ts: ev.firstTs,\n1011\t          last_ts: ev.lastTs\n1012\t        },\n1013\t        null,\n1014\t        2\n1015\t      )\n1016\t    );\n1017\t    done++;\n1018\t  }\n1019\t  console.log(`[extract:delta] rebuilt ${done} packs`);\n1020\t}\n1021\t\n1022\t// ----------------------------------------------------------------- manifest\n1023\t// Declarative mode: the manifest (runtime/manifests/templates/\n1024\t// longview_synthesis.json) is the definition of record — variables map onto\n1025\t// config, plan.phases decide what runs. Per ADR-005 §4 the phases are the\n1026\t// manifest's tasks; the per-session fan-out stays inside the map phase.\n1027\tfunction loadManifest() {\n1028\t  const defaultPath = path.join(\n1029\t    projectRoot,\n1030\t    \"runtime\",\n1031\t    \"manifests\",\n1032\t    \"templates\",\n1033\t    \"longview_synthesis.json\"\n1034\t  );\n1035\t  const p = opt(\"manifest\", args[1] && !args[1].startsWith(\"--\") ? args[1] : defaultPath);\n1036\t  // Packaged installs ship scripts/ but not runtime/ (the runtime is a fetched\n1037\t  // asset) — fall back to the built-in defaults, which mirror the template.\n1038\t  let manifest;\n1039\t  if (fs.existsSync(p)) {\n1040\t    manifest = JSON.parse(fs.readFileSync(p, \"utf8\"));\n1041\t  } else {\n1042\t    console.log(`[run] manifest not found at ${p} — using built-in defaults (all phases)`);\n1043\t    manifest = {\n1044\t      id: \"longview_synthesis(builtin-defaults)\",\n1045\t      workspace: config.WORKSPACE,\n1046\t      variables: {},\n1047\t      plan: {\n1048\t        phases: [\"inventory\", \"extract\", \"map\", \"model\", \"reduce\"].map((id) => ({\n1049\t          id,\n1050\t          enabled: true\n1051\t        }))\n1052\t      }\n1053\t    };\n1054\t  }\n1055\t  const v = manifest.variables || {};\n1056\t  if (manifest.workspace) config.WORKSPACE = manifest.workspace;\n1057\t  if (v.model) config.LONGVIEW_MODEL = v.model;\n1058\t  if (v.ingest_model) config.INGEST_MODEL = v.ingest_model;\n1059\t  if (v.evidence_budget_chars) config.EVIDENCE_BUDGET_CHARS = Number(v.evidence_budget_chars);\n1060\t  if (v.reduce_input_chars) config.REDUCE_INPUT_BUDGET = Number(v.reduce_input_chars);\n1061\t  if (v.card_max_tokens) config.CARD_MAX_TOKENS = Number(v.card_max_tokens);\n1062\t  if (v.reduce_max_tokens) config.REDUCE_MAX_TOKENS = Number(v.reduce_max_tokens);\n1063\t  if (v.thin_session_chars) config.THIN_SESSION_CHARS = Number(v.thin_session_chars);\n1064\t  if (v.delta_reduce_threshold) config.DELTA_REDUCE_THRESHOLD = Number(v.delta_reduce_threshold);\n1065\t  if (v.ingest_batch_size) config.INGEST_BATCH = Number(v.ingest_batch_size);\n1066\t  if (typeof v.deep_synthesis === \"boolean\") config.DEEP_SYNTHESIS = v.deep_synthesis;\n1067\t  return { path: p, manifest };\n1068\t}\n1069\t\n1070\tasync function runManifest() {\n1071\t  const { path: manifestPath, manifest } = loadManifest();\n1072\t  ensureWorkspace(); // the manifest may have switched the workspace\n1073\t  acquireLock();\n1074\t  console.log(\n1075\t    `[run] manifest ${manifest.id} (${path.basename(manifestPath)}) → workspace '${config.WORKSPACE}', model ${config.LONGVIEW_MODEL}`\n1076\t  );\n1077\t  if (flag(\"delta\")) {\n1078\t    await runDelta();\n1079\t    return;\n1080\t  }\n1081\t  const onlyPhase = opt(\"phase\", null);\n1082\t  const phases = (manifest.plan?.phases || []).filter((ph) =>\n1083\t    onlyPhase ? ph.id === onlyPhase : ph.enabled !== false\n1084\t  );\n1085\t  if (onlyPhase && phases.length === 0) {\n1086\t    console.error(`[run] phase '${onlyPhase}' not found in manifest`);\n1087\t    process.exit(2);\n1088\t  }\n1089\t  for (const ph of phases) {\n1090\t    if (interrupted) break;\n1091\t    console.log(`[run] phase: ${ph.id}`);\n1092\t    if (ph.id === \"inventory\") await runInventory();\n1093\t    else if (ph.id === \"extract\") runExtract();\n1094\t    else if (ph.id === \"map\") await runMap({ limitOverride: Number(ph.limit) || Infinity });\n1095\t    else if (ph.id === \"model\") await runModel();\n1096\t    else if (ph.id === \"code\") await runCode();\n1097\t    else if (ph.id === \"weave\")\n1098\t      await runWeave({\n1099\t        loops: Number(ph.loops) || null,\n1100\t        questionsPerLoop: Number(ph.questions) || null\n1101\t      });\n1102\t    else if (ph.id === \"reduce\")\n1103\t      await runReduce({\n1104\t        onlyOverride: Array.isArray(ph.only) && ph.only.length ? ph.only : null,\n1105\t        skipBookOverride: ph.skip_book === true ? true : null\n1106\t      });\n1107\t    else if (ph.id === \"opus\") await runOpus({ interrupted: () => interrupted });\n1108\t    else if (ph.id === \"pdf\") runPdfPhase();\n1109\t    else console.log(`[run] unknown phase '${ph.id}' — skipped`);\n1110\t  }\n1111\t}\n1112\t\n1113\t// --------------------------------------------------------------------- main\n1114\t// \"run\" locks inside runManifest — after the manifest has set the workspace,\n1115\t// so the lock lands in the workspace it actually guards.\n1116\tconst MUTATING_COMMANDS = new Set([\n1117\t  \"all\",\n1118\t  \"delta\",\n1119\t  \"inventory\",\n1120\t  \"extract\",\n1121\t  \"map\",\n1122\t  \"model\",\n1123\t  \"code\",\n1124\t  \"weave\",\n1125\t  \"reduce\",\n1126\t  \"opus\",\n1127\t  \"pdf\"\n1128\t]);\n1129\t\n1130\tasync function main() {\n1131\t  ensureWorkspace();\n1132\t  if (MUTATING_COMMANDS.has(command)) acquireLock();\n1133\t  switch (command) {\n1134\t    case \"run\":\n1135\t      await runManifest();\n1136\t      break;\n1137\t    case \"inventory\":\n1138\t      await runInventory();\n1139\t      break;\n1140\t    case \"extract\":\n1141\t      runExtract();\n1142\t      break;\n1143\t    case \"map\":\n1144\t      await runMap();\n1145\t      break;\n1146\t    case \"model\":\n1147\t      await runModel();\n1148\t      break;\n1149\t    case \"code\":\n1150\t      await runCode();\n1151\t      break;\n1152\t    case \"weave\":\n1153\t      await runWeave();\n1154\t      break;\n1155\t    case \"reduce\":\n1156\t      await runReduce();\n1157\t      break;\n1158\t    case \"opus\":\n1159\t      await runOpus({ interrupted: () => interrupted });\n1160\t      break;\n1161\t    case \"pdf\":\n1162\t      runPdfPhase();\n1163\t      break;\n1164\t    case \"all\":\n1165\t      await runInventory();\n1166\t      runExtract();\n1167\t      await runMap();\n1168\t      if (!interrupted) await runModel();\n1169\t      if (!interrupted) await runReduce();\n1170\t      break;\n1171\t    case \"delta\":\n1172\t      await runDelta();\n1173\t      break;\n1174\t    case \"status\":\n1175\t      runStatus();\n1176\t      break;\n1177\t    case \"report\":\n1178\t      runReport();\n1179\t      break;\n1180\t    default:\n1181\t      console.error(`unknown command '${command}' — see header of this file`);\n1182\t      process.exit(2);\n1183\t  }\n1184\t}\n1185\t\n1186\tmain().catch((e) => {\n1187\t  console.error(\"Fatal:\", e);\n1188\t  process.exit(1);\n1189\t});\n1190\t"}]},"uuid":"42600144-4b95-4005-9d68-6b5e697913c7","timestamp":"2026-07-03T06:46:36.977Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\scripts\\longview\\longview.mjs","content":"#!/usr/bin/env node\n/**\n * LONGVIEW — long-horizon session synthesis on the local model (ADR-005).\n *\n *   node scripts/longview/longview.mjs run [manifest.json] [--phase X] [--delta]\n *     — manifest mode (default: runtime/manifests/templates/longview_synthesis.json);\n *       also reachable as `benny longview run`. Individual phases:\n *   node scripts/longview/longview.mjs inventory [--no-sync] [--agents a,b]\n *   node scripts/longview/longview.mjs extract   [--limit N] [--force]\n *   node scripts/longview/longview.mjs map       [--limit N] [--force]\n *   node scripts/longview/longview.mjs model     [--no-graph]\n *   node scripts/longview/longview.mjs reduce    [--skip-book] [--only report,prd,...]\n *   node scripts/longview/longview.mjs all       [--limit N] [--no-graph] [--skip-book]\n *   node scripts/longview/longview.mjs delta     [--refresh] [--no-graph]\n *   node scripts/longview/longview.mjs status | report\n *\n * Backlog mode: `all` — resume-safe at card granularity; kill and rerun freely.\n * Delta mode:   `delta` — only sessions new/changed since their card.\n * Heartbeat:    <workspace>/longview/status.json; honest numbers: ledger.jsonl.\n */\nimport { spawnSync } from \"child_process\";\nimport crypto from \"crypto\";\nimport fs from \"fs\";\nimport path from \"path\";\nimport { fileURLToPath } from \"url\";\nimport { runOpus } from \"./lib/opus.mjs\";\nimport { evidenceFor, graphCatalog } from \"./lib/retrieve.mjs\";\nimport { mdToHtml, htmlToPdf } from \"./lib/book_pdf.mjs\";\nimport { config, ensureWorkspace, workspaceDir, stateDir, projectRoot } from \"./lib/config.mjs\";\nimport { syncStore, listSessions } from \"./lib/store.mjs\";\nimport { buildEvidencePack } from \"./lib/evidence.mjs\";\nimport { chat, lastBalancedJson } from \"./lib/llm.mjs\";\nimport { validateCard } from \"./lib/gate.mjs\";\nimport { appendLedger, readLedger, mapVerdicts, writeStatus, readStatus } from \"./lib/ledger.mjs\";\n\nconst __dirname = path.dirname(fileURLToPath(import.meta.url));\nconst prompt = (name) => fs.readFileSync(path.join(__dirname, \"prompts\", `${name}.md`), \"utf8\");\n\nconst args = process.argv.slice(2);\nconst command = args[0] || \"status\";\nconst flag = (name) => args.includes(`--${name}`);\nconst opt = (name, fallback = null) => {\n  const i = args.indexOf(`--${name}`);\n  return i >= 0 && args[i + 1] ? args[i + 1] : fallback;\n};\n\nlet interrupted = false;\nprocess.on(\"SIGINT\", () => {\n  if (interrupted) process.exit(130);\n  interrupted = true;\n  console.log(\"\\n[longview] finishing current item, then stopping (Ctrl+C again to force)…\");\n});\n\n// Single-instance lock — the EXE tray, Bridge button, and CLI can all launch\n// the runner; only one may mutate a workspace at a time. Stale locks (dead\n// pid) are reclaimed. status/report stay lock-free.\nconst lockPath = () => stateDir(\"runner.lock\");\n\nfunction pidAlive(pid) {\n  try {\n    process.kill(pid, 0);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nfunction acquireLock() {\n  try {\n    const held = JSON.parse(fs.readFileSync(lockPath(), \"utf8\"));\n    if (held.pid && held.pid !== process.pid && pidAlive(held.pid)) {\n      console.error(\n        `[longview] already running (pid ${held.pid}, ${held.command || \"?\"} since ${held.started_at}). ` +\n          `Use 'status' to watch it, or stop that run first.`\n      );\n      process.exit(3);\n    }\n  } catch {\n    /* no lock or unreadable — take it */\n  }\n  fs.writeFileSync(\n    lockPath(),\n    JSON.stringify(\n      { pid: process.pid, command, args: args.slice(1), started_at: new Date().toISOString() },\n      null,\n      2\n    )\n  );\n  const release = () => {\n    try {\n      const held = JSON.parse(fs.readFileSync(lockPath(), \"utf8\"));\n      if (held.pid === process.pid) fs.unlinkSync(lockPath());\n    } catch {\n      /* already gone */\n    }\n  };\n  process.on(\"exit\", release);\n}\n\nconst sid8 = (id) => String(id).slice(0, 8);\nconst inventoryPath = () => stateDir(\"inventory.json\");\nconst cardPath = (id) => stateDir(\"cards\", `${id}.json`);\nconst evidencePath = (id) => stateDir(\"evidence\", `${id}.md`);\nconst evidenceMetaPath = (id) => stateDir(\"evidence\", `${id}.meta.json`);\n\n// ---------------------------------------------------------------- inventory\nasync function runInventory() {\n  if (!flag(\"no-sync\")) {\n    process.stdout.write(\"[inventory] memo-ray sync… \");\n    try {\n      const { via } = await syncStore();\n      console.log(`ok (${via})`);\n    } catch (e) {\n      console.log(`FAILED (${e.message}) — proceeding with the store as-is`);\n    }\n  }\n  const agents = (opt(\"agents\", \"antigravity,claude\") || \"\")\n    .toLowerCase()\n    .split(\",\")\n    .filter(Boolean);\n  const sessions = listSessions({ agents });\n  const inventory = sessions.map((s) => ({\n    id: s.id,\n    agent: s.agent,\n    title: (s.content || \"\").slice(0, 120),\n    project: s.metadata?.project || null,\n    timestamp: s.timestamp || 0,\n    events: (s.children_ids || []).length\n  }));\n  fs.writeFileSync(inventoryPath(), JSON.stringify(inventory, null, 2));\n  const byAgent = {};\n  for (const s of inventory) byAgent[s.agent] = (byAgent[s.agent] || 0) + 1;\n  writeStatus({ phase: \"inventory\", backlog_total: inventory.length, by_agent: byAgent });\n  console.log(`[inventory] ${inventory.length} sessions`, byAgent);\n  return inventory;\n}\n\nconst loadInventory = () => JSON.parse(fs.readFileSync(inventoryPath(), \"utf8\"));\n\n// ------------------------------------------------------------------ extract\nfunction runExtract() {\n  const inventory = loadInventory();\n  const limit = Number(opt(\"limit\", 0)) || Infinity;\n  const sessionById = new Map(listSessions().map((s) => [s.id, s]));\n  let done = 0,\n    skipped = 0;\n  for (const item of inventory) {\n    if (done >= limit || interrupted) break;\n    if (fs.existsSync(evidencePath(item.id)) && !flag(\"force\")) {\n      skipped++;\n      continue;\n    }\n    const session = sessionById.get(item.id);\n    if (!session) continue;\n    const ev = buildEvidencePack(session);\n    fs.writeFileSync(evidencePath(item.id), ev.pack);\n    fs.writeFileSync(\n      evidenceMetaPath(item.id),\n      JSON.stringify(\n        {\n          signal_chars: ev.signalChars,\n          artifact_names: ev.artifactNames,\n          project: ev.project,\n          first_ts: ev.firstTs,\n          last_ts: ev.lastTs\n        },\n        null,\n        2\n      )\n    );\n    done++;\n    if (done % 20 === 0) console.log(`[extract] ${done} packs…`);\n  }\n  console.log(`[extract] built ${done}, kept ${skipped} existing`);\n}\n\n// ---------------------------------------------------------------------- map\nasync function runMap({ deltaMode = false, limitOverride = null } = {}) {\n  const inventory = loadInventory();\n  const limit = limitOverride ?? (Number(opt(\"limit\", 0)) || Infinity);\n  const verdicts = mapVerdicts();\n  const system = prompt(\"session_card\");\n\n  const queue = inventory.filter((item) => {\n    if (!fs.existsSync(evidencePath(item.id))) return false;\n    const v = verdicts.get(item.id);\n    if (flag(\"force\")) return true;\n    if (!v) return true;\n    if (v.status === \"ok\" && fs.existsSync(cardPath(item.id))) {\n      // Delta: a session that gained activity after its card was made is stale.\n      return deltaMode && item.timestamp > Date.parse(v.ts || 0);\n    }\n    if (v.status === \"skipped_thin\") return false;\n    return true; // previous failure → retry\n  });\n\n  console.log(\n    `[map] queue ${Math.min(queue.length, limit)} of ${inventory.length} sessions (model ${config.LONGVIEW_MODEL})`\n  );\n  let ok = 0,\n    failed = 0,\n    thin = 0,\n    processed = 0;\n\n  for (const item of queue) {\n    if (processed >= limit || interrupted) break;\n    processed++;\n    const meta = JSON.parse(fs.readFileSync(evidenceMetaPath(item.id), \"utf8\"));\n    if (meta.signal_chars < config.THIN_SESSION_CHARS) {\n      appendLedger({\n        phase: \"map\",\n        session_id: item.id,\n        status: \"skipped_thin\",\n        signal_chars: meta.signal_chars\n      });\n      thin++;\n      continue;\n    }\n    const pack = fs.readFileSync(evidencePath(item.id), \"utf8\");\n    const started = Date.now();\n    let card = null,\n      gateErrors = [],\n      retries = 0,\n      tokens = { prompt: 0, completion: 0, estimated: false };\n\n    for (let attempt = 0; attempt < 2 && !card; attempt++) {\n      retries = attempt;\n      try {\n        const feedback =\n          attempt > 0\n            ? `\\n\\nYour previous answer failed validation: ${gateErrors.join(\"; \")}. Return corrected JSON only.`\n            : \"\";\n        const res = await chat({\n          system,\n          user: pack + feedback,\n          maxTokens: config.CARD_MAX_TOKENS,\n          json: true\n        });\n        tokens = {\n          prompt: tokens.prompt + res.prompt_tokens,\n          completion: tokens.completion + res.completion_tokens,\n          estimated: res.usage_estimated\n        };\n        const parsed = lastBalancedJson(res.content);\n        gateErrors = validateCard(parsed, { sessionId: item.id, agent: item.agent });\n        if (gateErrors.length === 0) card = parsed;\n      } catch (e) {\n        gateErrors = [`llm error: ${e.message}`];\n      }\n    }\n\n    const ms = Date.now() - started;\n    if (card) {\n      fs.writeFileSync(cardPath(item.id), JSON.stringify(card, null, 2));\n      appendLedger({\n        phase: \"map\",\n        session_id: item.id,\n        status: \"ok\",\n        ms,\n        retries,\n        prompt_tokens: tokens.prompt,\n        completion_tokens: tokens.completion,\n        usage_estimated: tokens.estimated,\n        project: card.project\n      });\n      ok++;\n      console.log(\n        `[map] ok  ${sid8(item.id)} ${card.project.padEnd(20).slice(0, 20)} ${(ms / 1000).toFixed(0)}s`\n      );\n    } else {\n      appendLedger({\n        phase: \"map\",\n        session_id: item.id,\n        status: \"failed\",\n        ms,\n        retries,\n        gate_errors: gateErrors\n      });\n      failed++;\n      console.log(\n        `[map] FAIL ${sid8(item.id)} ${(ms / 1000).toFixed(0)}s — ${gateErrors.join(\"; \").slice(0, 120)}`\n      );\n    }\n\n    const allVerdicts = mapVerdicts();\n    const doneCount = [...allVerdicts.values()].filter((v) => v.status === \"ok\").length;\n    const okLedger = readLedger().filter((e) => e.phase === \"map\" && e.status === \"ok\" && e.ms);\n    const avgMs = okLedger.length ? okLedger.reduce((a, e) => a + e.ms, 0) / okLedger.length : 0;\n    const remaining = inventory.length - allVerdicts.size;\n    writeStatus({\n      phase: \"map\",\n      backlog_total: inventory.length,\n      cards_ok: doneCount,\n      map_failed: [...allVerdicts.values()].filter((v) => v.status === \"failed\").length,\n      map_thin: [...allVerdicts.values()].filter((v) => v.status === \"skipped_thin\").length,\n      current_session: sid8(item.id),\n      cards_per_hour: avgMs ? +(3600000 / avgMs).toFixed(1) : null,\n      eta_hours_remaining: avgMs ? +((remaining * avgMs) / 3600000).toFixed(1) : null\n    });\n  }\n  console.log(\n    `[map] done: ok=${ok} failed=${failed} thin=${thin}${interrupted ? \" (interrupted — resume with the same command)\" : \"\"}`\n  );\n}\n\n// -------------------------------------------------------------------- model\nfunction loadCards() {\n  const dir = stateDir(\"cards\");\n  return fs\n    .readdirSync(dir)\n    .filter((f) => f.endsWith(\".json\"))\n    .map((f) => JSON.parse(fs.readFileSync(path.join(dir, f), \"utf8\")));\n}\n\nfunction renderCardMd(card) {\n  const list = (k, label) =>\n    card[k] && card[k].length ? `**${label}:**\\n${card[k].map((x) => `- ${x}`).join(\"\\n\")}` : \"\";\n  // Three H2 sections, not ten: deep synthesis extracts per H2 section (capped\n  // at 10/doc), so section count IS the per-document LLM cost. Ten sections\n  // cost ~10 min/doc and caused the 30-min batch timeouts; three cost ~3 min.\n  const overview = [\n    card.intent,\n    list(\"applications\", \"Applications\"),\n    list(\"capabilities\", \"Capabilities\")\n  ]\n    .filter(Boolean)\n    .join(\"\\n\\n\");\n  const happened = [\n    list(\"decisions\", \"Decisions\"),\n    list(\"outcomes\", \"Outcomes\"),\n    list(\"failures\", \"Failures\")\n  ]\n    .filter(Boolean)\n    .join(\"\\n\\n\");\n  const threads = [\n    list(\"skills_observed\", \"Skills observed\"),\n    list(\"operator_traits\", \"Operator traits\"),\n    list(\"open_threads\", \"Open threads\"),\n    list(\"proposed_next\", \"Proposed next\")\n  ]\n    .filter(Boolean)\n    .join(\"\\n\\n\");\n  return [\n    `# Session card: ${card.project} (${card.period})`,\n    `Session ${card.session_id} · agent ${card.agent}`,\n    `\\n## Overview\\n${overview || \"(none)\"}`,\n    `\\n## What happened\\n${happened || \"(none)\"}`,\n    `\\n## Threads and signals\\n${threads || \"(none)\"}`\n  ].join(\"\\n\");\n}\n\n// Fire-and-poll ingest. A deep-synthesis ingest holds the HTTP response open\n// for many minutes; Node's undici kills idle connections at ~5 min regardless\n// of AbortSignal (seen live: \"fetch failed\" while the server kept working and\n// the graph kept filling). So: POST with a client-generated run_id, tolerate\n// the connection dying, and poll the runtime's task record until it settles.\n// This also serializes batches — the next POST waits for this task to finish.\nasync function ingestBatch(batch, { deepSynthesis = config.DEEP_SYNTHESIS } = {}) {\n  const runId = crypto.randomUUID();\n  const post = fetch(`${config.BENNY_API_BASE}/api/rag/ingest`, {\n    method: \"POST\",\n    headers: { \"Content-Type\": \"application/json\", \"X-Benny-API-Key\": config.BENNY_API_KEY },\n    body: JSON.stringify({\n      workspace: config.WORKSPACE,\n      files: batch,\n      run_id: runId,\n      deep_synthesis: deepSynthesis,\n      model: config.INGEST_MODEL\n    })\n  }).catch(() => null); // connection death ≠ ingest death — the task record decides\n\n  const started = Date.now();\n  const deadline = started + config.INGEST_TIMEOUT_MS;\n  let seen = false;\n  while (Date.now() < deadline) {\n    await new Promise((r) => setTimeout(r, 10000));\n    let task = null;\n    try {\n      const res = await fetch(`${config.BENNY_API_BASE}/api/tasks`, {\n        headers: { \"X-Benny-API-Key\": config.BENNY_API_KEY },\n        signal: AbortSignal.timeout(15000)\n      });\n      const tasks = await res.json();\n      task = Array.isArray(tasks) ? tasks.find((t) => t.task_id === runId) : null;\n    } catch {\n      continue; // transient — keep polling\n    }\n    if (!task) {\n      // The handler registers the task before any work, so a task that never\n      // appears means the POST was rejected — surface its status if the\n      // response is available, without hanging on a still-open connection.\n      if (!seen && Date.now() - started > 60000) {\n        const r = await Promise.race([\n          post,\n          new Promise((res) => setTimeout(() => res(undefined), 5000))\n        ]);\n        return {\n          ok: false,\n          runId,\n          error: r ? `submit rejected (${r.status})` : \"no task registered after 60s\"\n        };\n      }\n      continue;\n    }\n    seen = true;\n    if (task.status === \"completed\" || task.status === \"completed_with_errors\") {\n      return { ok: true, runId, partial: task.status === \"completed_with_errors\" };\n    }\n    if (task.status === \"failed\") return { ok: false, runId, error: task.message || \"task failed\" };\n    if (interrupted)\n      return { ok: false, runId, error: \"interrupted while waiting (server task continues)\" };\n  }\n  return {\n    ok: false,\n    runId,\n    error: `timeout after ${config.INGEST_TIMEOUT_MS}ms (server task may still be running)`\n  };\n}\n\nasync function runModel() {\n  const cards = loadCards();\n  if (cards.length === 0) {\n    console.log(\"[model] no cards yet — run map first\");\n    return;\n  }\n\n  // Rollups — deterministic aggregation, recomputed from scratch every time.\n  const projects = {},\n    capabilities = {},\n    timeline = {},\n    operator = { traits: {}, skills: {} },\n    openThreads = [],\n    proposedNext = [],\n    sids = {};\n  for (const c of cards) {\n    sids[sid8(c.session_id)] = c.session_id;\n    const p = (projects[c.project] ||= {\n      sessions: [],\n      months: new Set(),\n      applications: new Set(),\n      capabilities: new Set(),\n      outcomes: 0,\n      open_threads: [],\n      proposed_next: []\n    });\n    p.sessions.push(sid8(c.session_id));\n    p.months.add(c.period);\n    for (const a of c.applications || []) p.applications.add(a);\n    for (const k of c.capabilities || []) {\n      p.capabilities.add(k);\n      (capabilities[k] ||= new Set()).add(c.project);\n    }\n    p.outcomes += (c.outcomes || []).length;\n    for (const t of c.open_threads || []) {\n      p.open_threads.push(t);\n      openThreads.push({ project: c.project, sid: sid8(c.session_id), thread: t });\n    }\n    for (const n of c.proposed_next || []) {\n      p.proposed_next.push(n);\n      proposedNext.push({ project: c.project, sid: sid8(c.session_id), next: n });\n    }\n    const m = (timeline[c.period] ||= { projects: new Set(), sessions: 0 });\n    m.projects.add(c.project);\n    m.sessions++;\n    for (const t of c.operator_traits || []) (operator.traits[t] ||= []).push(sid8(c.session_id));\n    for (const s of c.skills_observed || []) (operator.skills[s] ||= []).push(sid8(c.session_id));\n  }\n  const dehydrate = (o) => JSON.parse(JSON.stringify(o, (k, v) => (v instanceof Set ? [...v] : v)));\n  fs.writeFileSync(\n    stateDir(\"rollups\", \"projects.json\"),\n    JSON.stringify(dehydrate(projects), null, 2)\n  );\n  fs.writeFileSync(\n    stateDir(\"rollups\", \"capabilities.json\"),\n    JSON.stringify(dehydrate(capabilities), null, 2)\n  );\n  fs.writeFileSync(\n    stateDir(\"rollups\", \"timeline.json\"),\n    JSON.stringify(dehydrate(timeline), null, 2)\n  );\n  fs.writeFileSync(stateDir(\"rollups\", \"operator.json\"), JSON.stringify(operator, null, 2));\n  fs.writeFileSync(\n    stateDir(\"rollups\", \"threads.json\"),\n    JSON.stringify({ open_threads: openThreads, proposed_next: proposedNext }, null, 2)\n  );\n  fs.writeFileSync(stateDir(\"rollups\", \"sids.json\"), JSON.stringify(sids, null, 2));\n  console.log(\n    `[model] rollups: ${Object.keys(projects).length} projects, ${Object.keys(capabilities).length} capabilities, ${Object.keys(timeline).length} months`\n  );\n\n  // Cards → workspace data_in as markdown, then into the knowledge graph.\n  // Ingestion state is tracked explicitly (a render is not an ingest — the\n  // pilot hit exactly that: rendered files, failed ingest, nothing to retry).\n  for (const c of cards) {\n    const p = workspaceDir(\"data_in\", `longview_card_${sid8(c.session_id)}.md`);\n    if (!fs.existsSync(p)) fs.writeFileSync(p, renderCardMd(c));\n  }\n  const ingestedPath = stateDir(\"rollups\", \"ingested.json\");\n  let ingested = [];\n  try {\n    ingested = JSON.parse(fs.readFileSync(ingestedPath, \"utf8\"));\n  } catch {\n    /* first run */\n  }\n  const ingestedSet = new Set(ingested);\n  const pending = cards\n    .map((c) => `longview_card_${sid8(c.session_id)}.md`)\n    .filter((n) => !ingestedSet.has(n));\n  console.log(`[model] ${pending.length} card docs pending graph ingestion`);\n\n  if (!flag(\"no-graph\") && pending.length) {\n    const step = config.DEEP_SYNTHESIS ? config.INGEST_BATCH : 25;\n    console.log(\n      `[model] deep_synthesis=${config.DEEP_SYNTHESIS} (${config.DEEP_SYNTHESIS ? \"cards become graph Documents/Concepts — LLM per doc, slow\" : \"vectors only — the graph stays EMPTY\"})`\n    );\n    for (let i = 0; i < pending.length; i += step) {\n      const batch = pending.slice(i, i + step);\n      process.stdout.write(\n        `[model] /rag/ingest batch ${Math.floor(i / step) + 1} (${batch.length} files)… `\n      );\n      const verdict = await ingestBatch(batch);\n      console.log(verdict.ok ? `ok (run ${verdict.runId})` : `FAILED (${verdict.error})`);\n      appendLedger({\n        phase: \"model\",\n        action: \"ingest\",\n        files: batch.length,\n        deep_synthesis: config.DEEP_SYNTHESIS,\n        ok: verdict.ok,\n        run_id: verdict.runId,\n        ...(verdict.error ? { error: verdict.error } : {})\n      });\n      if (verdict.ok) {\n        for (const n of batch) ingestedSet.add(n);\n        fs.writeFileSync(ingestedPath, JSON.stringify([...ingestedSet], null, 2));\n      }\n      if (interrupted) break;\n    }\n  }\n  writeStatus({ phase: \"model\", cards_ok: cards.length, projects: Object.keys(projects).length });\n}\n\n// ------------------------------------------------------------------- reduce\nasync function reduceCall(name, system, user, outPath) {\n  const started = Date.now();\n  // Per-part slices control composition; this cap guarantees the total fits\n  // the model's context window regardless of corpus size (see config note).\n  user = user.slice(0, config.REDUCE_INPUT_BUDGET);\n  const res = await chat({ system, user, maxTokens: config.REDUCE_MAX_TOKENS, temperature: 0.4 });\n  fs.writeFileSync(outPath, res.content);\n  appendLedger({\n    phase: \"reduce\",\n    artifact: name,\n    ms: Date.now() - started,\n    prompt_tokens: res.prompt_tokens,\n    completion_tokens: res.completion_tokens,\n    usage_estimated: res.usage_estimated\n  });\n  console.log(\n    `[reduce] ${name} → ${path.relative(config.BENNY_HOME, outPath)} (${((Date.now() - started) / 1000).toFixed(0)}s)`\n  );\n  return res.content;\n}\n\nconst cardDigest = (c) =>\n  JSON.stringify({\n    sid: sid8(c.session_id),\n    period: c.period,\n    intent: c.intent,\n    capabilities: c.capabilities,\n    decisions: c.decisions,\n    outcomes: c.outcomes,\n    failures: c.failures,\n    open_threads: c.open_threads,\n    proposed_next: c.proposed_next\n  });\n\nasync function runReduce({ onlyOverride = null, skipBookOverride = null } = {}) {\n  const cards = loadCards();\n  if (!cards.length) return console.log(\"[reduce] no cards — run map first\");\n  const only = onlyOverride ?? (opt(\"only\", \"\") || \"\").split(\",\").filter(Boolean);\n  const skipBook = skipBookOverride ?? flag(\"skip-book\");\n  const want = (n) => only.length === 0 || only.includes(n);\n  const rollup = (n) => fs.readFileSync(stateDir(\"rollups\", `${n}.json`), \"utf8\");\n  const outDir = (...p) => workspaceDir(\"data_out\", ...p);\n  writeStatus({ phase: \"reduce\" });\n\n  // 1. Project dossiers — one bounded call per project.\n  const byProject = {};\n  for (const c of cards) (byProject[c.project] ||= []).push(c);\n  const dossiers = {};\n  if (want(\"dossiers\")) {\n    for (const [project, pcards] of Object.entries(byProject)) {\n      if (interrupted) break;\n      pcards.sort((a, b) => (a.period || \"\").localeCompare(b.period || \"\"));\n      const user = `Project: ${project}\\nSession cards (chronological, one JSON per line):\\n${pcards\n        .map(cardDigest)\n        .join(\"\\n\")\n        .slice(0, 24000)}`;\n      const safe = project.replace(/[^a-z0-9-_]+/gi, \"_\").slice(0, 60);\n      dossiers[project] = await reduceCall(\n        `dossier:${project}`,\n        prompt(\"project_dossier\"),\n        user,\n        outDir(\"dossiers\", `${safe}.md`)\n      );\n    }\n  } else {\n    for (const f of fs.readdirSync(outDir(\"dossiers\"))) {\n      if (f.endsWith(\".md\"))\n        dossiers[f.replace(/\\.md$/, \"\")] = fs.readFileSync(outDir(\"dossiers\", f), \"utf8\");\n    }\n  }\n\n  const dossierSummaries = Object.entries(dossiers)\n    .map(([p, d]) => `--- ${p} ---\\n${d.slice(0, 2200)}`)\n    .join(\"\\n\\n\")\n    .slice(0, 26000);\n\n  // 2. Cross-project themes — the greater-than-the-sum pass.\n  let themes = \"\";\n  // Discovery notes (weave phase) — when they exist, every synthesis input\n  // stands on them too: the loop's findings compound into the deliverables.\n  let discoveryDigest = \"\";\n  try {\n    const dDir = outDir(\"discovery\");\n    discoveryDigest = fs\n      .readdirSync(dDir)\n      .filter((f) => f.endsWith(\".md\"))\n      .map((f) => fs.readFileSync(path.join(dDir, f), \"utf8\").slice(0, 1200))\n      .join(\"\\n\\n---\\n\\n\")\n      .slice(0, 8000);\n  } catch {\n    /* no weave yet */\n  }\n\n  if (want(\"themes\") && !interrupted) {\n    themes = await reduceCall(\n      \"themes\",\n      prompt(\"themes\"),\n      `${dossierSummaries}\\n\\n## Timeline rollup\\n${rollup(\"timeline\")}\\n\\n## Operator rollup\\n${rollup(\"operator\").slice(0, 6000)}${discoveryDigest ? `\\n\\n## Discovery notes (cross-reference findings)\\n${discoveryDigest}` : \"\"}`,\n      outDir(\"THEMES.md\")\n    );\n  } else if (fs.existsSync(outDir(\"THEMES.md\"))) {\n    themes = fs.readFileSync(outDir(\"THEMES.md\"), \"utf8\");\n  }\n\n  // 3-5. Deliverables.\n  if (want(\"report\") && !interrupted) {\n    await reduceCall(\n      \"report\",\n      prompt(\"report\"),\n      `## Themes\\n${themes.slice(0, 8000)}\\n\\n## Dossiers\\n${dossierSummaries.slice(0, 16000)}\\n\\n## Capability rollup\\n${rollup(\"capabilities\").slice(0, 4000)}`,\n      outDir(\"PORTFOLIO-REPORT.md\")\n    );\n  }\n  if (want(\"prd\") && !interrupted) {\n    await reduceCall(\n      \"prd\",\n      prompt(\"prd\"),\n      `## Themes\\n${themes.slice(0, 8000)}\\n\\n## Open threads & proposed next\\n${rollup(\"threads\").slice(0, 14000)}\\n\\n## Dossier summaries\\n${dossierSummaries.slice(0, 8000)}`,\n      outDir(\"PRD-WHAT-COMES-NEXT.md\")\n    );\n  }\n  if (want(\"skill\") && !interrupted) {\n    await reduceCall(\n      \"skill\",\n      prompt(\"skill\"),\n      `## Operator evidence (trait/skill → session ids)\\n${rollup(\"operator\").slice(0, 12000)}\\n\\n## Themes (operating style)\\n${themes.slice(0, 6000)}`,\n      outDir(\"skills\", \"working-with-this-operator.SKILL.md\")\n    );\n  }\n\n  // 6. Book — outline (JSON), then bounded chapter calls.\n  if (want(\"book\") && !skipBook && !interrupted) {\n    const outlineRaw = await reduceCall(\n      \"book:outline\",\n      prompt(\"book_outline\"),\n      `## Themes\\n${themes.slice(0, 6000)}\\n\\n## Dossier summaries\\n${dossierSummaries.slice(0, 14000)}\\n\\n## Timeline\\n${rollup(\"timeline\")}`,\n      outDir(\"book\", \"outline.json\")\n    );\n    const outline = lastBalancedJson(outlineRaw);\n    if (outline?.chapters?.length) {\n      const parts = [`# ${outline.title}\\n\\n_${outline.subtitle || \"\"}_\\n\\n${outline.arc || \"\"}\\n`];\n      for (const ch of outline.chapters) {\n        if (interrupted) break;\n        const relevant = Object.entries(dossiers)\n          .filter(([p]) =>\n            (ch.projects || []).some((x) => p.toLowerCase().includes(String(x).toLowerCase()))\n          )\n          .map(([, d]) => d.slice(0, 5000))\n          .join(\"\\n\\n\");\n        const text = await reduceCall(\n          `book:ch${ch.n}`,\n          prompt(\"book_chapter\"),\n          `## Outline\\n${JSON.stringify(outline).slice(0, 3000)}\\n\\n## This chapter\\n${JSON.stringify(ch)}\\n\\n## Source dossiers\\n${relevant || dossierSummaries.slice(0, 10000)}`,\n          outDir(\"book\", `chapter-${String(ch.n).padStart(2, \"0\")}.md`)\n        );\n        parts.push(text);\n      }\n      fs.writeFileSync(outDir(\"book\", \"BOOK.md\"), parts.join(\"\\n\\n---\\n\\n\"));\n      console.log(`[reduce] book assembled (${outline.chapters.length} chapters)`);\n    } else {\n      console.log(\n        \"[reduce] book outline did not parse — chapters skipped (rerun with --only book)\"\n      );\n    }\n  }\n\n  // 7. TOGAF SAD — prepared for a human-launched swarm run (ADR-001).\n  if (want(\"togaf\")) {\n    fs.writeFileSync(\n      outDir(\"TOGAF-RUN.md\"),\n      [\n        \"# TOGAF SAD over the LONGVIEW graph\",\n        \"\",\n        \"The knowledge graph in this workspace now contains the session-card corpus.\",\n        \"Run the existing 6-task SAD swarm against it (human-launched per ADR-001):\",\n        \"\",\n        \"```powershell\",\n        \"cd \" + path.join(\"runtime\"),\n        `python benny_cli.py run manifests/templates/togaf_sad_report_swarm.json --json ^`,\n        `  --var workspace=${config.WORKSPACE} ^`,\n        `  --var topic=\"The binary16 application estate (LONGVIEW synthesis)\" ^`,\n        `  --var model=lemonade/${config.LONGVIEW_MODEL} ^`,\n        `  --var output_file=data_out/TOGAF_SAD_binary16.md`,\n        \"```\",\n        \"\",\n        \"The swarm's baseline_extraction step queries this workspace's graph, so the\",\n        \"SAD baseline is the synthesized estate, not a single repo. Run appears in\",\n        \"Mission Control / activity feed like any other runtime run.\"\n      ].join(\"\\n\")\n    );\n    console.log(\"[reduce] togaf → data_out/TOGAF-RUN.md (human-launched)\");\n  }\n  writeStatus({ phase: \"reduce_done\", deliverables_at: workspaceDir(\"data_out\") });\n}\n\n// --------------------------------------------------------------------- code\n// AST/code-graph feed (ADR-005 horizontal mechanism, code half): junction the\n// repo into the workspace src/, then run the existing declarative enrichment\n// manifest (Tree-Sitter scan → code graph → CORRELATES_WITH links to the\n// knowledge concepts). Reuses benny enrich end to end.\nasync function runCode() {\n  const srcRoot = workspaceDir(\"src\");\n  const target = path.join(srcRoot, \"prime-silo\");\n  fs.mkdirSync(srcRoot, { recursive: true });\n  if (!fs.existsSync(target)) {\n    // Junction (no admin needed on Windows), so the scan sees the live repo.\n    const r = spawnSync(\"cmd\", [\"/c\", \"mklink\", \"/J\", target, projectRoot], { encoding: \"utf8\" });\n    if (!fs.existsSync(target)) {\n      console.log(`[code] junction failed (${(r.stderr || \"\").trim()}) — skipping code graph`);\n      appendLedger({ phase: \"code\", ok: false, error: \"junction failed\" });\n      return;\n    }\n    console.log(`[code] junction: ${target} → ${projectRoot}`);\n  }\n  writeStatus({ phase: \"code\" });\n  const started = Date.now();\n  console.log(\"[code] benny enrich (Tree-Sitter scan → code graph → correlate)…\");\n  const r = spawnSync(\n    \"python\",\n    [\"benny_cli.py\", \"enrich\", \"--workspace\", config.WORKSPACE, \"--src\", \"src/prime-silo\", \"--run\"],\n    {\n      cwd: path.join(projectRoot, \"runtime\"),\n      encoding: \"utf8\",\n      timeout: 3600000,\n      // The enrich CLI prints progress glyphs (braille spinners) that crash\n      // Python's cp1252 console encoder on Windows — force UTF-8 stdio.\n      env: { ...process.env, PYTHONIOENCODING: \"utf-8\", PYTHONUTF8: \"1\" }\n    }\n  );\n  const ok = r.status === 0;\n  const tail = ((r.stdout || \"\") + (r.stderr || \"\"))\n    .split(\"\\n\")\n    .filter(Boolean)\n    .slice(-4)\n    .join(\" | \");\n  console.log(\n    `[code] ${ok ? \"ok\" : \"FAILED\"} (${((Date.now() - started) / 1000 / 60).toFixed(1)} min) ${tail.slice(0, 300)}`\n  );\n  appendLedger({ phase: \"code\", ok, ms: Date.now() - started, tail: tail.slice(0, 500) });\n}\n\n// -------------------------------------------------------------------- weave\n// Discovery loops (the request: \"loops of discovery… cross reference and\n// discovery through the graph and the text\"). Each loop: ask the model what\n// is under-explored → answer each question from retrieval (chunks + graph\n// concepts) → write a cited discovery note → ingest the note back, so the\n// next loop (and every deliverable) stands on a richer corpus.\nasync function runWeave({ loops = null, questionsPerLoop = null } = {}) {\n  const nLoops = loops ?? Number(opt(\"loops\", 2));\n  const nQuestions = questionsPerLoop ?? Number(opt(\"questions\", 4));\n  const discoveryDir = workspaceDir(\"data_out\", \"discovery\");\n  fs.mkdirSync(discoveryDir, { recursive: true });\n  const outDir = workspaceDir(\"data_out\");\n  const themes = fs.existsSync(path.join(outDir, \"THEMES.md\"))\n    ? fs.readFileSync(path.join(outDir, \"THEMES.md\"), \"utf8\")\n    : \"\";\n\n  for (let loop = 1; loop <= nLoops; loop++) {\n    if (interrupted) break;\n    const existingNotes = fs\n      .readdirSync(discoveryDir)\n      .filter((f) => f.endsWith(\".md\"))\n      .map((f) => \"- \" + f.replace(/\\.md$/, \"\").replace(/_/g, \" \"));\n    const concepts = await graphCatalog(25);\n    writeStatus({ phase: \"weave\", weave_loop: loop, weave_loops_total: nLoops });\n    console.log(`[weave] loop ${loop}/${nLoops}: generating ${nQuestions} discovery questions…`);\n    // Two attempts — local JSON mode sometimes wraps in prose or truncates.\n    let qs = [];\n    for (let attempt = 0; attempt < 2 && qs.length === 0; attempt++) {\n      const started = Date.now();\n      const res = await chat({\n        system: prompt(\"discovery_questions\"),\n        user: [\n          `Generate exactly ${nQuestions} questions.`,\n          `## Current themes\\n${themes.slice(0, 4000)}`,\n          concepts.length ? `## Top graph concepts\\n${concepts.join(\", \")}` : \"\",\n          existingNotes.length\n            ? `## Notes already written\\n${existingNotes.join(\"\\n\").slice(0, 1500)}`\n            : \"\",\n          attempt > 0 ? \"Your previous answer was not valid JSON. Return ONLY the JSON object.\" : \"\"\n        ]\n          .filter(Boolean)\n          .join(\"\\n\\n\"),\n        maxTokens: 900,\n        json: true,\n        temperature: attempt === 0 ? 0.6 : 0.3\n      });\n      qs = lastBalancedJson(res.content)?.questions || [];\n      appendLedger({\n        phase: \"weave\",\n        artifact: `loop${loop}:questions`,\n        ms: Date.now() - started,\n        attempt,\n        count: qs.length\n      });\n      if (!qs.length)\n        console.log(\n          `[weave] loop ${loop} attempt ${attempt + 1}: no questions parsed — head: ${res.content.slice(0, 100).replace(/\\s+/g, \" \")}`\n        );\n    }\n    if (!qs.length) {\n      console.log(`[weave] loop ${loop}: questions failed twice — stopping weave`);\n      break;\n    }\n\n    const noteFiles = [];\n    for (const [i, q] of qs.entries()) {\n      if (interrupted) break;\n      const noteName = `loop${loop}_q${i + 1}.md`;\n      const notePath = path.join(discoveryDir, noteName);\n      if (fs.existsSync(notePath)) continue;\n      const t0 = Date.now();\n      const evidence = await evidenceFor(q.question, { topK: 6, budget: 4200 });\n      const note = await chat({\n        system: prompt(\"discovery_note\"),\n        user: `## Question\\n${q.question}\\n\\n## Why it matters\\n${q.why || \"\"}\\n\\n## Retrieved evidence\\n${evidence}`,\n        maxTokens: 1100,\n        temperature: 0.4\n      });\n      fs.writeFileSync(notePath, note.content.trim());\n      noteFiles.push(noteName);\n      appendLedger({\n        phase: \"weave\",\n        artifact: `loop${loop}:note${i + 1}`,\n        ms: Date.now() - t0,\n        prompt_tokens: note.prompt_tokens,\n        completion_tokens: note.completion_tokens\n      });\n      console.log(`[weave] loop ${loop} note ${i + 1}/${qs.length}: ${q.question.slice(0, 70)}…`);\n    }\n\n    // Feed the notes back into the corpus so the NEXT loop (and opus retrieval)\n    // can stand on them. Vectors are what retrieval needs; graph synthesis of\n    // notes rides the same ingestBatch discipline.\n    for (const name of noteFiles) {\n      const stagedName = `longview_note_${name}`;\n      fs.copyFileSync(path.join(discoveryDir, name), workspaceDir(\"data_in\", stagedName));\n      // Vectors only: notes exist for retrieval, and a deep-synthesis ingest\n      // pays the full ~40-min clustering pass PER NOTE at this graph size.\n      const verdict = await ingestBatch([stagedName], { deepSynthesis: false });\n      appendLedger({\n        phase: \"weave\",\n        action: \"ingest\",\n        file: stagedName,\n        ok: verdict.ok,\n        run_id: verdict.runId\n      });\n      console.log(\n        `[weave] ingest ${stagedName}: ${verdict.ok ? \"ok\" : \"FAILED (\" + verdict.error + \")\"}`\n      );\n      if (interrupted) break;\n    }\n  }\n  writeStatus({ phase: \"weave_done\" });\n}\n\n// ---------------------------------------------------------------------- pdf\nfunction runPdfPhase() {\n  const bookMd = workspaceDir(\"data_out\", \"opus\", \"THE-AI-VAMPIRE.md\");\n  if (!fs.existsSync(bookMd)) {\n    console.log(\n      \"[pdf] no assembled book at data_out/opus/THE-AI-VAMPIRE.md — run the opus phase first\"\n    );\n    return;\n  }\n  const md = fs.readFileSync(bookMd, \"utf8\");\n  const htmlPath = workspaceDir(\"data_out\", \"opus\", \"THE-AI-VAMPIRE.html\");\n  fs.writeFileSync(htmlPath, mdToHtml(md, { title: \"The AI Vampire\" }));\n  const pdfPath = workspaceDir(\"data_out\", \"opus\", \"THE-AI-VAMPIRE.pdf\");\n  const r = htmlToPdf(htmlPath, pdfPath);\n  appendLedger({ phase: \"pdf\", ok: r.ok, bytes: r.bytes, error: r.error });\n  console.log(\n    r.ok\n      ? `[pdf] ${pdfPath} (${(r.bytes / 1024 / 1024).toFixed(1)} MB via ${r.browser})`\n      : `[pdf] FAILED — ${r.error} (HTML is at ${htmlPath})`\n  );\n  writeStatus({ phase: \"pdf_done\", pdf: r.ok ? pdfPath : null });\n}\n\n// ------------------------------------------------------------ status/report\nfunction runStatus() {\n  const s = readStatus();\n  if (!s) return console.log(\"no status yet — run inventory first\");\n  console.log(JSON.stringify(s, null, 2));\n}\n\nfunction runReport() {\n  const ledger = readLedger();\n  const maps = [...mapVerdicts().values()];\n  const ok = maps.filter((e) => e.status === \"ok\");\n  const failed = maps.filter((e) => e.status === \"failed\");\n  const thin = maps.filter((e) => e.status === \"skipped_thin\");\n  const msArr = ok\n    .map((e) => e.ms)\n    .filter(Boolean)\n    .sort((a, b) => a - b);\n  const median = msArr.length ? msArr[Math.floor(msArr.length / 2)] : 0;\n  const mean = msArr.length ? msArr.reduce((a, b) => a + b, 0) / msArr.length : 0;\n  const tok = (k) => ok.reduce((a, e) => a + (e[k] || 0), 0);\n  const estimated = ok.some((e) => e.usage_estimated);\n  let total = 0;\n  try {\n    total = loadInventory().length;\n  } catch {\n    /* no inventory */\n  }\n  const remaining = Math.max(0, total - maps.length);\n  const reduces = ledger.filter((e) => e.phase === \"reduce\");\n  console.log(\n    [\n      \"LONGVIEW ledger report (every number below comes from the ledger)\",\n      `  inventory total : ${total || \"unknown\"}`,\n      `  cards ok        : ${ok.length}`,\n      `  map failed      : ${failed.length}`,\n      `  skipped thin    : ${thin.length}`,\n      `  remaining       : ${remaining}`,\n      `  per-card median : ${(median / 1000).toFixed(1)}s   mean: ${(mean / 1000).toFixed(1)}s`,\n      `  throughput      : ${mean ? (3600000 / mean).toFixed(1) : \"?\"} cards/hour`,\n      `  est. remaining  : ${mean ? ((remaining * mean) / 3600000).toFixed(1) : \"?\"} hours`,\n      `  tokens (map)    : prompt ${tok(\"prompt_tokens\")}, completion ${tok(\"completion_tokens\")}${estimated ? \" (some ESTIMATED — server omitted usage)\" : \"\"}`,\n      `  reduce artifacts: ${reduces.length}`,\n      failed.length ? `  failed sids     : ${failed.map((e) => sid8(e.session_id)).join(\", \")}` : \"\"\n    ]\n      .filter(Boolean)\n      .join(\"\\n\")\n  );\n}\n\n// -------------------------------------------------------------------- delta\nasync function runDelta() {\n  await runInventory();\n  runExtractForce(); // extract only missing/changed packs\n  const before = [...mapVerdicts().values()].filter((v) => v.status === \"ok\").length;\n  await runMap({ deltaMode: true });\n  const after = [...mapVerdicts().values()].filter((v) => v.status === \"ok\").length;\n  const newCards = after - before;\n  await runModel();\n  if (flag(\"refresh\") || newCards >= config.DELTA_REDUCE_THRESHOLD) {\n    console.log(`[delta] ${newCards} new cards → re-running reduce`);\n    await runReduce();\n  } else {\n    console.log(\n      `[delta] ${newCards} new cards (< ${config.DELTA_REDUCE_THRESHOLD}) — reduce skipped; use --refresh to force`\n    );\n  }\n}\n\n// Delta extract: rebuild packs for sessions newer than their existing pack.\nfunction runExtractForce() {\n  const inventory = loadInventory();\n  const sessionById = new Map(listSessions().map((s) => [s.id, s]));\n  let done = 0;\n  for (const item of inventory) {\n    if (interrupted) break;\n    const p = evidencePath(item.id);\n    if (fs.existsSync(p) && fs.statSync(p).mtimeMs >= (item.timestamp || 0)) continue;\n    const session = sessionById.get(item.id);\n    if (!session) continue;\n    const ev = buildEvidencePack(session);\n    fs.writeFileSync(p, ev.pack);\n    fs.writeFileSync(\n      evidenceMetaPath(item.id),\n      JSON.stringify(\n        {\n          signal_chars: ev.signalChars,\n          artifact_names: ev.artifactNames,\n          project: ev.project,\n          first_ts: ev.firstTs,\n          last_ts: ev.lastTs\n        },\n        null,\n        2\n      )\n    );\n    done++;\n  }\n  console.log(`[extract:delta] rebuilt ${done} packs`);\n}\n\n// ----------------------------------------------------------------- manifest\n// Declarative mode: the manifest (runtime/manifests/templates/\n// longview_synthesis.json) is the definition of record — variables map onto\n// config, plan.phases decide what runs. Per ADR-005 §4 the phases are the\n// manifest's tasks; the per-session fan-out stays inside the map phase.\nfunction loadManifest() {\n  const defaultPath = path.join(\n    projectRoot,\n    \"runtime\",\n    \"manifests\",\n    \"templates\",\n    \"longview_synthesis.json\"\n  );\n  const p = opt(\"manifest\", args[1] && !args[1].startsWith(\"--\") ? args[1] : defaultPath);\n  // Packaged installs ship scripts/ but not runtime/ (the runtime is a fetched\n  // asset) — fall back to the built-in defaults, which mirror the template.\n  let manifest;\n  if (fs.existsSync(p)) {\n    manifest = JSON.parse(fs.readFileSync(p, \"utf8\"));\n  } else {\n    console.log(`[run] manifest not found at ${p} — using built-in defaults (all phases)`);\n    manifest = {\n      id: \"longview_synthesis(builtin-defaults)\",\n      workspace: config.WORKSPACE,\n      variables: {},\n      plan: {\n        phases: [\"inventory\", \"extract\", \"map\", \"model\", \"reduce\"].map((id) => ({\n          id,\n          enabled: true\n        }))\n      }\n    };\n  }\n  const v = manifest.variables || {};\n  if (manifest.workspace) config.WORKSPACE = manifest.workspace;\n  if (v.model) config.LONGVIEW_MODEL = v.model;\n  if (v.ingest_model) config.INGEST_MODEL = v.ingest_model;\n  if (v.evidence_budget_chars) config.EVIDENCE_BUDGET_CHARS = Number(v.evidence_budget_chars);\n  if (v.reduce_input_chars) config.REDUCE_INPUT_BUDGET = Number(v.reduce_input_chars);\n  if (v.card_max_tokens) config.CARD_MAX_TOKENS = Number(v.card_max_tokens);\n  if (v.reduce_max_tokens) config.REDUCE_MAX_TOKENS = Number(v.reduce_max_tokens);\n  if (v.thin_session_chars) config.THIN_SESSION_CHARS = Number(v.thin_session_chars);\n  if (v.delta_reduce_threshold) config.DELTA_REDUCE_THRESHOLD = Number(v.delta_reduce_threshold);\n  if (v.ingest_batch_size) config.INGEST_BATCH = Number(v.ingest_batch_size);\n  if (typeof v.deep_synthesis === \"boolean\") config.DEEP_SYNTHESIS = v.deep_synthesis;\n  return { path: p, manifest };\n}\n\nasync function runManifest() {\n  const { path: manifestPath, manifest } = loadManifest();\n  ensureWorkspace(); // the manifest may have switched the workspace\n  acquireLock();\n  console.log(\n    `[run] manifest ${manifest.id} (${path.basename(manifestPath)}) → workspace '${config.WORKSPACE}', model ${config.LONGVIEW_MODEL}`\n  );\n  if (flag(\"delta\")) {\n    await runDelta();\n    return;\n  }\n  const onlyPhase = opt(\"phase\", null);\n  const phases = (manifest.plan?.phases || []).filter((ph) =>\n    onlyPhase ? ph.id === onlyPhase : ph.enabled !== false\n  );\n  if (onlyPhase && phases.length === 0) {\n    console.error(`[run] phase '${onlyPhase}' not found in manifest`);\n    process.exit(2);\n  }\n  for (const ph of phases) {\n    if (interrupted) break;\n    console.log(`[run] phase: ${ph.id}`);\n    if (ph.id === \"inventory\") await runInventory();\n    else if (ph.id === \"extract\") runExtract();\n    else if (ph.id === \"map\") await runMap({ limitOverride: Number(ph.limit) || Infinity });\n    else if (ph.id === \"model\") await runModel();\n    else if (ph.id === \"code\") await runCode();\n    else if (ph.id === \"weave\")\n      await runWeave({\n        loops: Number(ph.loops) || null,\n        questionsPerLoop: Number(ph.questions) || null\n      });\n    else if (ph.id === \"reduce\")\n      await runReduce({\n        onlyOverride: Array.isArray(ph.only) && ph.only.length ? ph.only : null,\n        skipBookOverride: ph.skip_book === true ? true : null\n      });\n    else if (ph.id === \"opus\") await runOpus({ interrupted: () => interrupted });\n    else if (ph.id === \"pdf\") runPdfPhase();\n    else console.log(`[run] unknown phase '${ph.id}' — skipped`);\n  }\n}\n\n// --------------------------------------------------------------------- main\n// \"run\" locks inside runManifest — after the manifest has set the workspace,\n// so the lock lands in the workspace it actually guards.\nconst MUTATING_COMMANDS = new Set([\n  \"all\",\n  \"delta\",\n  \"inventory\",\n  \"extract\",\n  \"map\",\n  \"model\",\n  \"code\",\n  \"weave\",\n  \"reduce\",\n  \"opus\",\n  \"pdf\"\n]);\n\nasync function main() {\n  ensureWorkspace();\n  if (MUTATING_COMMANDS.has(command)) acquireLock();\n  switch (command) {\n    case \"run\":\n      await runManifest();\n      break;\n    case \"inventory\":\n      await runInventory();\n      break;\n    case \"extract\":\n      runExtract();\n      break;\n    case \"map\":\n      await runMap();\n      break;\n    case \"model\":\n      await runModel();\n      break;\n    case \"code\":\n      await runCode();\n      break;\n    case \"weave\":\n      await runWeave();\n      break;\n    case \"reduce\":\n      await runReduce();\n      break;\n    case \"opus\":\n      await runOpus({ interrupted: () => interrupted });\n      break;\n    case \"pdf\":\n      runPdfPhase();\n      break;\n    case \"all\":\n      await runInventory();\n      runExtract();\n      await runMap();\n      if (!interrupted) await runModel();\n      if (!interrupted) await runReduce();\n      break;\n    case \"delta\":\n      await runDelta();\n      break;\n    case \"status\":\n      runStatus();\n      break;\n    case \"report\":\n      runReport();\n      break;\n    default:\n      console.error(`unknown command '${command}' — see header of this file`);\n      process.exit(2);\n  }\n}\n\nmain().catch((e) => {\n  console.error(\"Fatal:\", e);\n  process.exit(1);\n});\n","numLines":1190,"startLine":1,"totalLines":1190}},"sourceToolAssistantUUID":"c0969ad9-eaef-4473-b310-e4d7eccf9fd2","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"HEAD"}
