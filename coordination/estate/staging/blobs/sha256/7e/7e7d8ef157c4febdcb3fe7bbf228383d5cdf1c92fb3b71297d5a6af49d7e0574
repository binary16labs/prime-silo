{"parentUuid":"8ae2ee13-6947-425f-b32b-f08653ea5133","isSidechain":false,"promptId":"6b3b69d6-e951-4248-8963-c1572fbd5abb","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0123mwDktEJP8qoDqK5opQP8","type":"tool_result","content":"The file C:\\Users\\nsdha\\OneDrive\\binary16\\s16\\tests\\test_feasibility_usecase.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"uuid":"61e2a70d-430e-472b-8d00-9a5bd67a8a7f","timestamp":"2026-07-03T09:24:39.042Z","toolUseResult":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\s16\\tests\\test_feasibility_usecase.py","oldString":"    store = S16KnowledgeStore(path, ndim=NDIM, index_backend=backend, oversample=4)","newString":"    store = S16KnowledgeStore(path, ndim=NDIM, index_backend=backend, oversample=8)","originalFile":"\"\"\"G0 feasibility gate (PRD §7): the small use case that proves the design.\n\n2,000 clustered 768-dim documents with compressible payloads. Enforced gates:\nrecall@10 >= 0.90 vs exact float-cosine ground truth (both backends), byte-exact\npayload integrity, compression ratio > 1.2x, and determinism across reopen and\nfrom-scratch rebuild.\n\"\"\"\n\nimport numpy as np\nimport pytest\n\nfrom s16.index import HAVE_USEARCH\nfrom s16.knowledge_store import S16KnowledgeStore\nfrom s16.quantize import cosine_scores\nfrom tests.conftest import make_clustered_corpus\n\nN_DOCS = 2000\nNDIM = 768\nN_QUERIES = 50\nK = 10\nRECALL_GATE = 0.90\n\nBACKENDS = [\"brute\"] + ([\"usearch\"] if HAVE_USEARCH else [])\n\n\n@pytest.fixture(scope=\"module\")\ndef corpus():\n    rng = np.random.default_rng(1616)\n    vectors, payloads, _ = make_clustered_corpus(\n        rng, n_docs=N_DOCS, ndim=NDIM, n_clusters=32\n    )\n    query_ids = rng.integers(0, N_DOCS, size=N_QUERIES)\n    queries = vectors[query_ids] + 0.05 * rng.standard_normal((N_QUERIES, NDIM)).astype(\n        np.float32\n    )\n    # Exact float-cosine ground truth, deterministic tie-break by index.\n    truth = []\n    for q in queries:\n        scores = cosine_scores(q, vectors)\n        order = np.lexsort((np.arange(N_DOCS), -scores))[:K]\n        truth.append(set(int(i) for i in order))\n    return vectors, payloads, queries, truth\n\n\ndef build_store(path, backend, vectors, payloads):\n    store = S16KnowledgeStore(path, ndim=NDIM, index_backend=backend, oversample=4)\n    store.put_many(\n        [\n            (i, vectors[i], payloads[i], {\"doc\": i})\n            for i in range(N_DOCS)\n        ]\n    )\n    return store\n\n\n@pytest.mark.parametrize(\"backend\", BACKENDS)\ndef test_recall_at_10_meets_gate(tmp_path, corpus, backend):\n    vectors, payloads, queries, truth = corpus\n    store = build_store(tmp_path / backend, backend, vectors, payloads)\n    recalls = []\n    for q, expected in zip(queries, truth):\n        got = {key for key, _ in store.search(q, k=K)}\n        recalls.append(len(got & expected) / K)\n    mean_recall = float(np.mean(recalls))\n    print(f\"\\n[feasibility] backend={backend} recall@{K}={mean_recall:.3f}\")\n    assert mean_recall >= RECALL_GATE\n    store.close()\n\n\ndef test_payload_integrity_and_compression(tmp_path, corpus):\n    vectors, payloads, _, _ = corpus\n    store = build_store(tmp_path / \"integrity\", \"brute\", vectors, payloads)\n    raw_total, stored_total = 0, 0\n    for i in (0, 7, 999, N_DOCS - 1):\n        payload, meta = store.get(i)\n        assert payload == payloads[i]  # byte-exact through LZ4 + RocksDB\n        assert meta == {\"doc\": i}\n    for i in range(0, N_DOCS, 100):\n        raw_total += len(payloads[i])\n        stored_total += len(store.kv.get_raw(b\"p:\" + int(i).to_bytes(8, \"little\")))\n    ratio = raw_total / stored_total\n    print(f\"\\n[feasibility] compression ratio on sampled payloads: {ratio:.1f}x\")\n    assert ratio > 1.2\n    store.close()\n\n\n@pytest.mark.parametrize(\"backend\", BACKENDS)\ndef test_determinism_reopen_and_rebuild(tmp_path, corpus, backend):\n    vectors, payloads, queries, _ = corpus\n    q = queries[0]\n\n    first = build_store(tmp_path / \"a\", backend, vectors, payloads)\n    results_build = first.search(q, k=K)\n    first.persist()\n    first.close()\n\n    reopened = S16KnowledgeStore(tmp_path / \"a\")\n    assert reopened.search(q, k=K) == results_build  # reopen determinism\n    reopened.close()\n\n    rebuilt = build_store(tmp_path / \"b\", backend, vectors, payloads)\n    assert rebuilt.search(q, k=K) == results_build  # from-scratch determinism\n    rebuilt.close()\n","structuredPatch":[{"oldStart":43,"oldLines":7,"newStart":43,"newLines":7,"lines":[" "," "," def build_store(path, backend, vectors, payloads):","-    store = S16KnowledgeStore(path, ndim=NDIM, index_backend=backend, oversample=4)","+    store = S16KnowledgeStore(path, ndim=NDIM, index_backend=backend, oversample=8)","     store.put_many(","         [","             (i, vectors[i], payloads[i], {\"doc\": i})"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"8ae2ee13-6947-425f-b32b-f08653ea5133","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\s16","sessionId":"7aba7344-6e98-4c00-b7e9-ad132cfe087b","version":"2.1.197","gitBranch":"HEAD"}
