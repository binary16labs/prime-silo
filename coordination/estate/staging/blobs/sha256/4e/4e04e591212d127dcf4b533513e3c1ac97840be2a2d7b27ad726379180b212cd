================================\n52\t# MANIFEST CRUD\n53\t# =============================================================================\n54\t\n55\t\n56\tdef save_manifest(manifest: SwarmManifest) -> SwarmManifest:\n57\t    _ensure_dirs()\n58\t    manifest.touch()\n59\t    path = _manifest_path(manifest.id)\n60\t    with _lock:\n61\t        path.write_text(manifest.model_dump_json(indent=2), encoding=\"utf-8\")\n62\t    return manifest\n63\t\n64\t\n65\tdef get_manifest(manifest_id: str) -> Optional[SwarmManifest]:\n66\t    path = _manifest_path(manifest_id)\n67\t    if not path.exists():\n68\t        return None\n69\t    try:\n70\t        data = json.loads(path.read_text(encoding=\"utf-8\"))\n71\t        return SwarmManifest.model_validate(data)\n72\t    except Exception:\n73\t        return None\n74\t\n75\t\n76\tdef list_manifests() -> List[SwarmManifest]:\n77\t    _ensure_dirs()\n78\t    out: List[SwarmManifest] = []\n79\t    for p in sorted(_MANIFEST_DIR.glob(\"*.json\")):\n80\t        try:\n81\t            data = json.loads(p.read_text(encoding=\"utf-8\"))\n82\t            out.append(SwarmManifest.model_validate(data))\n83\t        except Exception:\n84\t            continue\n85\t    return out\n86\t\n87\t\n88\tdef delete_manifest(manifest_id: str) -> bool:\n89\t    path = _manifest_path(manifest_id)\n90\t    if path.exists():\n91\t        path.unlink()\n92\t        return True\n93\t    return False\n94\t\n95\t\n96\t# =============================================================================\n97\t# RUN CRUD\n98\t# =============================================================================\n99\t\n100\t\n101\tdef save_run(record: RunRecord) -> RunRecord:\n102\t    _ensure_dirs()\n103\t    path = _run_path(record.run_id)\n104\t    with _lock:\n105\t        path.write_text(record.model_dump_json(indent=2), encoding=\"utf-8\")\n106\t    return record\n107\t\n108\t\n109\tdef get_run(run_id: str) -> Optional[RunRecord]:\n110\t    path = _run_path(run_id)\n111\t 