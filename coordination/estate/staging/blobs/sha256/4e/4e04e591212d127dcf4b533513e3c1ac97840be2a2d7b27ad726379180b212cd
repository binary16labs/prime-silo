{"parentUuid":"951a1f20-5511-4d5a-909d-cc848ca8492d","isSidechain":false,"promptId":"aaff5a02-c6dd-47a0-8e28-bbd05998745e","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XgdAhzy4DpciBtkH1JR1Qv","type":"tool_result","content":"1\t\"\"\"AOS-001 Phase 9 — Append-only HMAC-chained ledger for SOX 404 audit.\n2\t\n3\tPublic API\n4\t----------\n5\t  LedgerEntry\n6\t      Dataclass holding the fields required by AOS-F26 / AOS-COMP1.\n7\t      After :func:`append_entry` the fields ``seq``, ``prev_hash``,\n8\t      ``entry_hash``, ``hmac``, and ``timestamp`` are populated.\n9\t\n10\t  LedgerRewindError\n11\t      Raised when a rewind (deletion / force-reset of ledger entries)\n12\t      is detected (AOS-SEC6).\n13\t\n14\t  append_entry(entry, *, ledger_dir, secret) -> LedgerEntry\n15\t      Appends *entry* to ``<ledger_dir>/ledger.jsonl`` and updates the\n16\t      ``<ledger_dir>/HEAD`` pointer file.  Sequence numbers are 1-based\n17\t      and monotonically increasing.  The HMAC chain ties each entry to\n18\t      its predecessor:\n19\t\n20\t          hmac = HMAC-SHA256(secret,\n21\t                             prompt_hash || diff_hash || prev_hash)\n22\t\n23\t      Returns the populated entry (with seq, prev_hash, entry_hash, hmac,\n24\t      timestamp assigned).\n25\t\n26\t  get_head_hash(*, ledger_dir) -> str | None\n27\t      Returns the SHA-256 hex digest of the last appended entry as stored\n28\t      in ``<ledger_dir>/HEAD``, or ``None`` if the ledger is empty.\n29\t\n30\t  verify_chain(*, ledger_dir, secret) -> bool\n31\t      Re-reads every entry in ``ledger.jsonl`` in order and verifies:\n32\t        1. Each entry's stored HMAC matches the recomputed value.\n33\t        2. Each entry's ``prev_hash`` matches the ``entry_hash`` of the\n34\t           preceding entry (genesis prev_hash = 64 zeros).\n35\t      Returns ``True`` when the chain is intact, ``False`` otherwise\n36\t      (AOS-F27 / AOS-SEC6).\n37\t\n38\tAOS requirements covered\n39\t------------------------\n40\t  F26   append_entry(): monotonic seq + HMAC chain.\n41\t  F27   SOX 404 intent proof in each entry; verify_chain() for audit.\n42\t  SEC6  Rewind detection: HEAD vs final chain entry.\n43\t  COMP1 All required SOX fields present in every ledger record.\n44\t  NFR8  Stdlib-only (hashlib, hmac, json, pathlib) — no network.\n45\t\n46\tDependencies: stdlib only (dataclasses, datetime, hashlib, hmac, json,\n47\t              pathlib).  No new top-level dependency.\n48\t\"\"\"\n49\t\n50\tfrom __future__ import annotations\n51\t\n52\timport hashlib\n53\timport hmac as hmac_lib\n54\timport json\n55\tfrom dataclasses import dataclass, field\n56\tfrom datetime import datetime, timezone\n57\tfrom pathlib import Path\n58\tfrom typing import Optional\n59\t\n60\t# Genesis hash used as the prev_hash of the very first ledger entry.\n61\t_GENESIS_HASH = \"0\" * 64\n62\t\n63\t_LEDGER_FILENAME = \"ledger.jsonl\"\n64\t_HEAD_FILENAME = \"HEAD\"\n65\t\n66\t\n67\t# ---------------------------------------------------------------------------\n68\t# Exceptions\n69\t# ---------------------------------------------------------------------------\n70\t\n71\t\n72\tclass LedgerRewindError(RuntimeError):\n73\t    \"\"\"Raised when a ledger rewind (history tampering) is detected (AOS-SEC6).\"\"\"\n74\t\n75\t\n76\t# ---------------------------------------------------------------------------\n77\t# Data model\n78\t# ---------------------------------------------------------------------------\n79\t\n80\t\n81\t@dataclass\n82\tclass LedgerEntry:\n83\t    \"\"\"SOX 404 ledger record (AOS-F26 / AOS-COMP1).\n84\t\n85\t    Fields populated by the caller before :func:`append_entry`\n86\t    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n87\t    prompt_hash:    SHA-256 of the prompt that generated this action.\n88\t    diff_hash:      SHA-256 of the file-diff / change produced.\n89\t    persona:        Agent persona name (e.g. ``\"architect\"``).\n90\t    model:          LLM model identifier.\n91\t    model_hash:     SHA-256 of the model weights / manifest.\n92\t    manifest_sig:   SHA-256 signature of the active manifest.\n93\t\n94\t    Fields populated by :func:`append_entry`\n95\t    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\n96\t    seq:            1-based monotonic sequence number.\n97\t    prev_hash:      entry_hash of the preceding entry (genesis = 64 zeros).\n98\t    entry_hash:     SHA-256 of the canonical JSON serialisation of this\n99\t                    record (used as the ``prev_hash`` of the next entry).\n100\t    hmac:           HMAC-SHA256(secret, prompt_hash || diff_hash || prev_hash).\n101\t    timestamp:      ISO-8601 UTC timestamp at append time.\n102\t    \"\"\"\n103\t\n104\t    # --- caller-supplied ---\n105\t    prompt_hash:  str\n106\t    diff_hash:    str\n107\t    persona:      str\n108\t    model:        str\n109\t    model_hash:   str\n110\t    manifest_sig: str\n111\t\n112\t    # --- assigned by append_entry ---\n113\t    seq:        int        = field(default=0, compare=False)\n114\t    prev_hash:  str        = field(default=_GENESIS_HASH, compare=False)\n115\t    entry_hash: str        = field(default=\"\", compare=False)\n116\t    hmac:       str        = field(default=\"\", compare=False)\n117\t    timestamp:  str        = field(default=\"\", compare=False)\n118\t\n119\t\n120\t# ---------------------------------------------------------------------------\n121\t# Internal helpers\n122\t# ---------------------------------------------------------------------------\n123\t\n124\t\n125\tdef _ledger_path(ledger_dir: Path) -> Path:\n126\t    return ledger_dir / _LEDGER_FILENAME\n127\t\n128\t\n129\tdef _head_path(ledger_dir: Path) -> Path:\n130\t    return ledger_dir / _HEAD_FILENAME\n131\t\n132\t\n133\tdef _compute_hmac(secret: bytes, prompt_hash: str, diff_hash: str, prev_hash: str) -> str:\n134\t    \"\"\"Compute HMAC-SHA256(secret, prompt_hash || diff_hash || prev_hash).\"\"\"\n135\t    payload = (prompt_hash + diff_hash + prev_hash).encode(\"utf-8\")\n136\t    return hmac_lib.new(secret, payload, hashlib.sha256).hexdigest()\n137\t\n138\t\n139\tdef _record_dict(entry: LedgerEntry) -> dict:\n140\t    \"\"\"Serialise *entry* to the canonical dict used for hashing and JSONL storage.\"\"\"\n141\t    return {\n142\t        \"seq\":          entry.seq,\n143\t        \"prompt_hash\":  entry.prompt_hash,\n144\t        \"diff_hash\":    entry.diff_hash,\n145\t        \"prev_hash\":    entry.prev_hash,\n146\t        \"persona\":      entry.persona,\n147\t        \"model\":        entry.model,\n148\t        \"model_hash\":   entry.model_hash,\n149\t        \"manifest_sig\": entry.manifest_sig,\n150\t        \"timestamp\":    entry.timestamp,\n151\t        \"hmac\":         entry.hmac,\n152\t        \"entry_hash\":   entry.entry_hash,\n153\t    }\n154\t\n155\t\n156\tdef _hash_record(record: dict) -> str:\n157\t    \"\"\"SHA-256 of the canonical JSON representation (sorted keys).\"\"\"\n158\t    canonical = json.dumps(record, sort_keys=True, separators=(\",\", \":\"))\n159\t    return hashlib.sha256(canonical.encode(\"utf-8\")).hexdigest()\n160\t\n161\t\n162\t# ---------------------------------------------------------------------------\n163\t# Public API\n164\t# ---------------------------------------------------------------------------\n165\t\n166\t\n167\tdef append_entry(\n168\t    entry: LedgerEntry,\n169\t    *,\n170\t    ledger_dir: Path,\n171\t    secret: bytes,\n172\t) -> LedgerEntry:\n173\t    \"\"\"Append *entry* to the HMAC-chained ledger (AOS-F26).\n174\t\n175\t    Parameters\n176\t    ----------\n177\t    entry:\n178\t        Populated :class:`LedgerEntry` (caller supplies prompt_hash,\n179\t        diff_hash, persona, model, model_hash, manifest_sig).\n180\t    ledger_dir:\n181\t        Directory where ``ledger.jsonl`` and ``HEAD`` are stored.\n182\t    secret:\n183\t        HMAC secret bytes.  Never logged or stored.\n184\t\n185\t    Returns\n186\t    -------\n187\t    LedgerEntry\n188\t        The same entry, mutated in-place with seq, prev_hash, entry_hash,\n189\t        hmac, and timestamp filled in.  Also returned for convenience.\n190\t    \"\"\"\n191\t    ledger_dir = Path(ledger_dir)\n192\t    ledger_dir.mkdir(parents=True, exist_ok=True)\n193\t\n194\t    ledger_file = _ledger_path(ledger_dir)\n195\t    head_file = _head_path(ledger_dir)\n196\t\n197\t    # Determine previous hash and sequence number\n198\t    prev_hash = _GENESIS_HASH\n199\t    next_seq = 1\n200\t\n201\t    if ledger_file.exists():\n202\t        lines = [l for l in ledger_file.read_text(encoding=\"utf-8\").splitlines() if l.strip()]\n203\t        if lines:\n204\t            last_record = json.loads(lines[-1])\n205\t            prev_hash = last_record.get(\"entry_hash\", _GENESIS_HASH)\n206\t            next_seq = last_record.get(\"seq\", 0) + 1\n207\t\n208\t    # Assign ledger fields\n209\t    entry.seq = next_seq\n210\t    entry.prev_hash = prev_hash\n211\t    entry.timestamp = datetime.now(timezone.utc).isoformat()\n212\t    entry.hmac = _compute_hmac(secret, entry.prompt_hash, entry.diff_hash, entry.prev_hash)\n213\t\n214\t    # Compute entry_hash over the record *including* the hmac (final fingerprint)\n215\t    record = _record_dict(entry)\n216\t    record[\"entry_hash\"] = \"\"   # placeholder while hashing\n217\t    record[\"entry_hash\"] = _hash_record(record)\n218\t    entry.entry_hash = record[\"entry_hash\"]\n219\t\n220\t    # Append to JSONL (atomic: write then flush)\n221\t    with open(ledger_file, \"a\", encoding=\"utf-8\") as fh:\n222\t        fh.write(json.dumps(record, separators=(\",\", \":\")) + \"\\n\")\n223\t        fh.flush()\n224\t\n225\t    # Update HEAD pointer\n226\t    head_file.write_text(entry.entry_hash, encoding=\"utf-8\")\n227\t\n228\t    return entry\n229\t\n230\t\n231\tdef get_head_hash(*, ledger_dir: Path) -> Optional[str]:\n232\t    \"\"\"Return the ``entry_hash`` of the last entry in ``ledger.jsonl``.\n233\t\n