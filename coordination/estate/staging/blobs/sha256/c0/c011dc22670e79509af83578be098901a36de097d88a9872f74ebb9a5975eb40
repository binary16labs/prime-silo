th.join(config.BENNY_HOME, \"workspaces\", config.WORKSPACE, ...parts);\n}\n\n// LONGVIEW's own state lives under <workspace>/longview/.\nexport function stateDir(...parts) {\n  return workspaceDir(\"longview\", ...parts);\n}\n\nexport function ensureWorkspace() {\n  for (const d of [\n    workspaceDir(\"data_in\"),\n    workspaceDir(\"data_out\"),\n    stateDir(\"evidence\"),\n    stateDir(\"cards\"),\n    stateDir(\"rollups\"),\n    workspaceDir(\"data_out\", \"dossiers\"),\n    workspaceDir(\"data_out\", \"skills\"),\n    workspaceDir(\"data_out\", \"book\")\n  ]) {\n    fs.mkdirSync(d, { recursive: true });\n  }\n}\n","structuredPatch":[{"oldStart":51,"oldLines":7,"newStart":51,"newLines":10,"lines":["   BENNY_API_KEY: env(\"BENNY_API_KEY\", \"benny-mesh-2026-auth\"),"," ","   // Budgets — evidence pack size bounds per-card latency on a 9B model.","-  EVIDENCE_BUDGET_CHARS: Number(env(\"LONGVIEW_EVIDENCE_BUDGET\", 9000)),","+  // NOTE: lemonade serves qwen3.5-9b-FLM with ctx_size 4096 on this box;","+  // 7500 chars (~2.1k tokens) + system prompt + 1.2k output stays inside it.","+  // Raise LONGVIEW_EVIDENCE_BUDGET only after raising the FLM ctx_size.","+  EVIDENCE_BUDGET_CHARS: Number(env(\"LONGVIEW_EVIDENCE_BUDGET\", 7500)),","   CARD_MAX_TOKENS: Number(env(\"LONGVIEW_CARD_MAX_TOKENS\", 1200)),","   REDUCE_MAX_TOKENS: Number(env(\"LONGVIEW_REDUCE_MAX_TOKENS\", 2400)),","   LLM_TIMEOUT_MS: Number(env(\"LONGVIEW_LLM_TIMEOUT_MS\", 900000)),"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"cfd3d2a1-fe01-45dc-ac92-26a7cead27f4","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo","sessionId":"79f3f47a-9f9d-4a1f-b922-ef7b2aa390a9","version":"2.1.197","gitBranch":"HEAD"}
