3\t  let lastNodeId = sessionUUID;\n104\t  let nodesProcessed = 0;\n105\t  let tokens = 0;\n106\t  let lineIndex = 0;\n107\t  let sessionCwd = null;\n108\t  let gitBranch = null;\n109\t  let entrypoint = null;\n110\t  let version = null;\n111\t  let logSessionId = null;\n112\t\n113\t  for await (const line of rl) {\n114\t    if (!line.trim()) continue;\n115\t    lineIndex++;\n116\t    try {\n117\t      const entry = JSON.parse(line);\n118\t\n119\t      // Extract session-level metadata from any entry that carries it\n120\t      if (entry.cwd && !sessionCwd) sessionCwd = entry.cwd;\n121\t      if (entry.gitBranch && !gitBranch) gitBranch = entry.gitBranch;\n122\t      if (entry.entrypoint && !entrypoint) entrypoint = entry.entrypoint;\n123\t      if (entry.version && !version) version = entry.version;\n124\t      if (entry.sessionId && !logSessionId) logSessionId = entry.sessionId;\n125\t\n126\t      // Resolve timestamp — Claude Desktop uses _audit_timestamp,\n127\t      // Claude Code uses timestamp (ISO string at entry level).\n128\t      const entryTs = new Date(entry._audit_timestamp || entry.timestamp || Date.now()).getTime();\n129\t\n130\t      if (entry.message?.usage) {\n131\t        tokens +=\n132\t          (entry.message.usage.input_tokens || 0) + (entry.message.usage.output_tokens || 0);\n133\t      } else if (entry.usage) {\n134\t        tokens += (entry.usage.input_tokens || 0) + (entry.usage.output_tokens || 0);\n135\t      }\n136\t\n137\t      if (entry.type === \"assistant\") {\n138\t        const msgContent = entry.message?.content || [];\n139\t        for (const block of Array.isArray(msgContent) ? msgContent : []) {\n140\t          const blockId = hash(filePath + lineIndex + (block.type || \"\") + nodesProcessed);\n141\t          let blockType = \"Message\";\n142\t          let blockContent = \"\";\n143\t          let fileName = null;\n144\t\n145\t          if (block.type === \"thinking\") {\n146\t            blockType = \"Thought\";\n147\t            blockContent = (block.thinking || \"\").substring(0, 2000);\n148\t          } else if (block.type === \"text\") {\n149\t            blockType = \"Message\";\n150\t            blockContent = block.text || \"\";\n151\t          } else if (block.type === \"tool_use\") {\n152\t            blockType = \"Tool Call\";\n153\t            let filePath = null;\n154\t            if (block.input) {\n155\t              let rawPath =\n156\t                block.input.path ||\n157\t                block.input.TargetFile ||\n158\t                block.input.target_file ||\n159\t                block.input.absolute_path ||\n160\t                block.input.file ||\n161\t                block.input.AbsolutePath ||\n162\t                block.input.file_path;\n163\t              if (typeof rawPath === \"string\") {\n164\t                rawPath = rawPath.trim().replace(/^[\"']|[\"']$/g, \"\");\n165\t                filePath = rawPath;\n166\t                fileName = path.basename(rawPath.replace(/\\\\/g, \"/\"));\n167\t              }\n168\t            }\n169\t\n170\t            const editTools = [\n171\t              \"write_to_file\",\n172\t              \"replace_file_content\",\n173\t              \"str_replace_editor\",\n174\t              \"edit_file\",\n175\t              \"Write\",\n176\t              \"Edit\",\n177\t              \"write_file\",\n178\t              \"edit_file_multi\",\n179\t              \"patch_file\",\n180\t              \"save_file\"\n181\t            ];\n182\t            if (editTools.includes(block.name)) {\n183\t              blockType = \"Artifact\";\n184\t            }\n185\t\n186\t            blockContent = JSON.stringify({ name: block.name, input: block.input }, null, 2);\n187\t          } else {\n188\t            continue;\n189\t          }\n190\t\n191\t          saveEntity({\n192\t            id: blockId,\n193\t            type: blockType,\n194\t            agent: \"Claude\",\n195\t            timestamp: entryTs,\n196\t            content: 