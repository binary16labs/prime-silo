BENNY_HOME\", \".benny_home\");\n46\t}\n47\tif (!path.isAbsolute(bennyHome)) bennyHome = path.resolve(projectRoot, bennyHome);\n48\t\n49\texport const config = {\n50\t  BENNY_HOME: bennyHome,\n51\t  WORKSPACE: env(\"LONGVIEW_WORKSPACE\", \"longview\"),\n52\t\n53\t  // memo-ray entity store (the ADR-005 seam). Fallback chain so the runner\n54\t  // works both from a dev checkout (sibling standalone memo-ray) and from the\n55\t  // packaged app (vendored memoray builds its store under ~/.mem0ray).\n56\t  MEMORAY_DATA_DIR:\n57\t    env(\"MEMORAY_DATA_DIR\", \"\") ||\n58\t    [\n59\t      path.resolve(projectRoot, \"..\", \"memo-ray\", \"agent-os-dashboard\", \"server\", \"data\"),\n60\t      path.join(os.homedir(), \".mem0ray\", \"data\"),\n61\t      path.resolve(projectRoot, \"memoray\", \"server\", \"data\")\n62\t    ].find((p) => fs.existsSync(path.join(p, \"index.json\"))) ||\n63\t    path.resolve(projectRoot, \"..\", \"memo-ray\", \"agent-os-dashboard\", \"server\", \"data\"),\n64\t  MEMORAY_SERVER_DIR: env(\n65\t    \"MEMORAY_SERVER_DIR\",\n66\t    path.resolve(projectRoot, \"..\", \"memo-ray\", \"agent-os-dashboard\", \"server\")\n67\t  ),\n68\t  MEMORAY_SERVER_URL: env(\"MEMORAY_SERVER_URL\", \"http://127.0.0.1:3030\"),\n69\t\n70\t  // Local model host (same one benny/core/models.py resolves to).\n71\t  LEMONADE_BASE_URL: env(\"LEMONADE_BASE_URL\", \"http://127.0.0.1:13305/api/v1\"),\n72\t  LONGVIEW_MODEL: env(\"LONGVIEW_MODEL\", \"qwen3.5-9b-FLM\"),\n73\t\n74\t  // Benny runtime API (Phase D ingestion, workspace paths).\n75\t  BENNY_API_BASE: `http://${env(\"BENNY_API_HOST\", \"127.0.0.1\")}:${env(\"BENNY_API_PORT\", \"8005\")}`,\n76\t  BENNY_API_KEY: env(\"BENNY_API_KEY\", \"benny-mesh-2026-auth\"),\n77\t\n78\t  // Budgets — evidence pack size bounds per-card latency on a 9B model.\n79\t  // NOTE: lemonade serves qwen3.5-9b-FLM with ctx_size 4096 on this box;\n80\t  // 7500 chars (~2.1k tokens) + system prompt + 1.2k output stays inside it.\n81\t  // Raise LONGVIEW_EVIDENCE_BUDGET only after raising the FLM ctx_size.\n82\t  EVIDENCE_BUDGET_CHARS: Number(env(\"LONGVIEW_EVIDENCE_BUDGET\", 7500)),\n83\t  CARD_MAX_TOKENS: Number(env(\"LONGVIEW_CARD_MAX_TOKENS\", 1200)),\n84\t  REDUCE_MAX_TOKENS: Number(env(\"LONGVIEW_REDUCE_MAX_TOKENS\", 1800)),\n85\t  // Hard cap on any composed reduce input (chars). 4096-token ctx ⇒ input must\n86\t  // stay ≈ ≤2200 tokens once the ~1800-token output budget is reserved. Raise\n87\t  // together with the FLM ctx_size for higher-fidelity synthesis at scale.\n88\t  REDUCE_INPUT_BUDGET: Number(env(\"LONGVIEW_REDUCE_INPUT\", 8500)),\n89\t\n90\t  // Phase D graph ingestion. deep_synthesis is what turns card docs into\n91\t  // Document/Concept nodes in Neo4j — without it /rag/ingest only writes\n92\t  // vectors (found live: 55 cards in Chroma, empty graph). Synthesis is\n93\t  // LLM-per-document, so batches are small and the timeout generous.\n94\t  DEEP_SYNTHESIS: env(\"LONGVIEW_DEEP_SYNTHESIS\", \"true\") !== \"false\",\n95\t  INGEST_MODEL: env(\"LONGVIEW_INGEST_MODEL\", \"lemonade/qwen3.5-9b-FLM\"),\n96\t  INGEST_BATCH: Number(env(\"LONGVIEW_INGEST_BATCH\", 5)),\n97\t  INGEST_TIMEOUT_MS: Number(env(\"LONGVIEW_INGEST_TIMEOUT_MS\", 1800000)),\n98\t  LLM_TIMEOUT_MS: Number(env(\"LONGVIEW_LLM_TIMEOUT_MS\", 900000)),\n99\t  // Sessions with less extractable text than this are recorded as thin, not mapped.\n100\t  THIN_SESSION_CHARS: Number(env(\"LONGVIEW_THIN_CHARS\", 200)),\n101\t  // Delta mode: re-run REDUCE automatically once this many new cards accumulate.\n102\t  DELTA_REDUCE_THRESHOLD: Number(env(\"LONGVIEW_DELTA_THRESHOLD\", 5))\n103\t};\n104\t\n105\texport function workspaceDir(...parts) {\n106\t  return path.join(config.BENNY_HOME, \"workspaces\", config.WORKSPACE, ...parts);\n107\t}\n108\t\n109\t// LONGVIEW's own state lives under <workspace>/longview/.\n110\texport function stateDir(...parts) {\n111\t  return workspaceDir(\"longview\", ...parts);\n112\t}\n113\t\n114\texport function