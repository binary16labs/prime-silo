{"parentUuid":"2f7cd58c-b4da-414c-b32b-e613663b559e","isSidechain":false,"attachment":{"type":"edited_text_file","filename":"C:\\Users\\nsdha\\OneDrive\\binary16\\prime-silo\\packaging\\desktop\\tray.js","snippet":"1\t// Desktop system tray for the packaged Prime-Silo shell.\n2\t//\n3\t// Prime-Silo is a long-running cognitive-mesh shell, so it belongs in the tray\n4\t// like its Memo-Ray companion: closing the window hides to tray instead of\n5\t// quitting, and the tray menu reopens the window, opens the app in a browser,\n6\t// surfaces the registry-resolved Memo-Ray endpoint, and quits for real.\n7\t//\n8\t// Wired from main.js after the main window exists. Kept dependency-free beyond\n9\t// electron itself; the Memo-Ray status line reads apps.lock.json directly with\n10\t// a tiny inline walk-up so the tray has no cross-module import.\n11\t\n12\tconst path = require(\"node:path\");\n13\tconst fs = require(\"node:fs\");\n14\tconst { spawn } = require(\"node:child_process\");\n15\tconst { app, Tray, Menu, shell, nativeImage, dialog, ipcMain } = require(\"electron\");\n16\tconst services = require(\"./services\");\n17\tconst openStudio = require(\"./openstudio_services\");\n18\tconst memoray = require(\"./memoray_service\");\n19\tconst longview = require(\"./longview_service\");\n20\tconst { resolveHome } = require(\"./home_resolver\");\n21\t\n22\tconst PROJECT_ROOT = path.resolve(__dirname, \"../..\");\n23\tconst LOCK_FILENAME = \"apps.lock.json\";\n24\tconst LOCK_SCHEMA = \"aamp.lock/1\";\n25\tconst CONFIG_FILENAME = \"prime-silo-config.json\";\n26\t\n27\tlet tray = null;\n28\tlet currentHomeDir = null;\n29\tlet currentBennyHome = null;\n30\tlet bennyRuntimeUp = false;\n31\tlet bennyStatusTimer = null;\n32\t// Latest lifecycle phase pushed by the runtime supervisor (first-run download →\n33\t// start). \"\" = unknown; others: downloading | starting | running | degraded |\n34\t// unavailable | stopped. Drives the status line so the ~380MB first-run fetch is\n35\t// visible instead of looking hung.\n36\tlet runtimePhase = \"\";\n37\tlet menuOptions = null;\n38\t\n39\tfunction getConfigPath() {\n40\t  return path.join(app.getPath(\"userData\"), CONFIG_FILENAME);\n41\t}\n42\t\n43\tfunction readConfig() {\n44\t  try {\n45\t    const configPath = getConfigPath();\n46\t    if (fs.existsSync(configPath)) {\n47\t      return JSON.parse(fs.readFileSync(configPath, \"utf8\")) || {};\n48\t    }\n49\t  } catch {\n50\t    // ignore config read errors\n51\t  }\n52\t  return {};\n53\t}\n54\t\n55\t// Merge a patch into the on-disk config so independent settings (homeDir,\n56\t// bennyHome) never clobber each other.\n57\tfunction writeConfigPatch(patch) {\n58\t  try {\n59\t    const configPath = getConfigPath();\n60\t    fs.mkdirSync(path.dirname(configPath), { recursive: true });\n61\t    const next = { ...readConfig(), ...patch };\n62\t    fs.writeFileSync(configPath, JSON.stringify(next, null, 2), \"utf8\");\n63\t  } catch (error) {\n64\t    console.error(\"[Tray] Failed to write config:\", error);\n65\t  }\n66\t}\n67\t\n68\tfunction writeHomeDirectoryConfig(homeDir) {\n69\t  writeConfigPatch({ homeDir: homeDir || null });\n70\t}\n71\t\n72\t// The tray's view of the declared home — one resolver call, re-read from the\n73\t// live config so a configure action is reflected on the next menu build.\n74\tfunction resolveTrayHome() {\n75\t  return resolveHome({ userDataPath: app.getPath(\"userData\"), config: readConfig() });\n76\t}\n77\t\n78\t// Open a native terminal rooted at the configured home directory. Best-effort\n79\t// and cross-platform: each branch detaches the child so quitting the tray app\n80\t// never takes the terminal with it. Spawn errors fall through to a fallback so\n81\t// a missing preferred emulator (e.g. Windows Terminal) degrades gracefully.\n82\tfunction openTerminalAt(dir) {\n83\t  if (!dir || !fs.existsSync(dir)) {\n84\t    return;\n85\t  }\n86\t  try {\n87\t    if (process.platform === \"win32\") {\n88\t      // Prefer Windows Terminal; fall back to a cmd window via the shell.\n89\t      const wt = spawn(\"wt.exe\", [\"-d\", dir], { detached: true, stdio: \"ignore\" });\n90\t      wt.on(\"error\", () => {\n91\t        const fallback = spawn(\"cmd.exe\", [\"/c\", \"start\", \"cmd.exe\", \"/K\", `cd /d \"${dir}\"`], {\n92\t          detached: true,\n93\t          stdio: \"ignore\",\n94\t          windowsVerbatimArguments: true\n95\t        });\n96\t        fallback.on(\"error\", (error) => console.error(\"[Tray] Failed to open terminal:\", error));\n97\t        fallback.unref();\n98\t      });\n99\t      wt.unref();\n100\t    } else if (process.platform === \"darwin\") {\n101\t      const child = spawn(\"open\", [\"-a\", \"Terminal\", dir], { detached: true, stdio: \"ignore\" });\n102\t      child.on(\"error\", (error) => console.error(\"[Tray] Failed to open terminal:\", error));\n103\t      child.unref();\n104\t    } else {\n105\t      // Linux: try common emulators in order; first that launches wins.\n106\t      const candidates = [\n107\t        [\"x-terminal-emulator\", []],\n108\t        [\"gnome-terminal\", [`--working-directory=${dir}`]],\n109\t        [\"konsole\", [\"--workdir\", dir]],\n110\t        [\"xfce4-terminal\", [`--working-directory=${dir}`]],\n111\t        [\"xterm\", []]\n112\t      ];\n113\t      const tryNext = (index) => {\n114\t        if (index >= candidates.length) {\n115\t          console.error(\"[Tray] No terminal emulator found to open.\");\n116\t          return;\n117\t        }\n118\t        const [command, args] = candidates[index];\n119\t        const child = spawn(command, args, { cwd: dir, detached: true, stdio: \"ignore\" });\n120\t        child.on(\"error\", () => tryNext(index + 1));\n121\t        child.unref();\n122\t      };\n123\t      tryNext(0);\n124\t    }\n125\t  } catch (error) {\n126\t    console.error(\"[Tray] Failed to open terminal:\", error);\n127\t  }\n128\t}\n129\t\n130\tfunction resolveTrayIcon() {\n131\t  const candidates =\n132\t    process.platform === \"win32\"\n133\t      ? [path.join(__dirname, \"../platforms/windows/icon.ico\")]\n134\t      : [\n135\t          path.join(__dirname, \"../platforms/linux/icons/32x32.png\"),\n136\t          path.join(__dirname, \"../platforms/linux/icons/icon.png\")\n137\t        ];\n138\t  for (const candidate of candidates) {\n139\t    try {\n140\t      const image = nativeImage.createFromPath(candidate);\n141\t      if (!image.isEmpty()) {\n142\t        return image;\n143\t      }\n144\t    } catch {\n145\t      // try next candidate\n146\t    }\n147\t  }\n148\t  return nativeImage.createEmpty();\n149\t}\n150\t\n151\t// Best-effort read of the registry lockfile so the tray can show where Memo-Ray\n152\t// actually listens. Returns the memo-ray url or null.\n153\tfunction readMemorayUrlFromLock() {\n154\t  let dir = PROJECT_ROOT;\n155\t  while (true) {\n156\t    const candidate = path.join(dir, LOCK_FILENAME);\n157\t    if (fs.existsSync(candidate)) {\n158\t      try {\n159\t        const lock = JSON.parse(fs.readFileSync(candidate, \"utf8\"));\n160\t        if (lock && lock.schema === LOCK_SCHEMA && lock.services) {\n161\t          const entry = lock.services[\"memo-ray/memory-graph\"];\n162\t          return entry && entry.url ? entry.url : null;\n163\t        }\n164\t      } catch {\n165\t        return null;\n166\t      }\n167\t      return null;\n168\t    }\n169\t    const parent = path.dirname(dir);\n170\t    if (parent === dir) {\n171\t      return null;\n172\t    }\n173\t    dir = parent;\n174\t  }\n175\t}\n176\t\n177\t// The runtime status line, reflecting the supervisor's lifecycle phase. The\n178\t// first-run download and start-up are surfaced so the tray never just says\n179\t// \"stopped\" while the runtime is actually being fetched/started.\n180\tfunction runtimeStatusLabel(bundledManaged) {\n181\t  switch (runtimePhase) {\n182\t    case \"downloading\":\n183\t      return \"Benny runtime: downloading runtime… (first run)\";\n18