{"parentUuid":"b24fe8ff-c4e3-4e04-9fa1-13ae77e55cdf","isSidechain":false,"promptId":"5b41bf5b-39b7-47b2-b1be-8bc0501d2b90","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DwXqBAfjKUen3fgMAgMkST","type":"tool_result","content":"1\t// ADR-001 Phase C — `kg3d.synoptic_web` widget.\n2\t//\n3\t// Read-only synoptic web of concept ontology nodes and edges, sourced from\n4\t// the runtime's `/kg3d/ontology` endpoint. Seventh migrated widget under\n5\t// Phase C; the second graph-shaped widget after `dag.canvas`.\n6\t//\n7\t// ## Renderer dependency decision\n8\t//\n9\t// The upstream `SynopticWeb.tsx` uses `react-force-graph-3d` + Three.js.\n10\t// Migrating that wholesale into the shell would mean bundling React +\n11\t// Three.js — a meaningful dependency for a read-only inspector. This\n12\t// migration takes a pragmatic line:\n13\t//\n14\t//   1. Ship a default **2D SVG layered renderer** that respects the AoT\n15\t//      layering (1 = abstract → 5 = concrete) and category palette. No\n16\t//      runtime dependency. Validates the data path end-to-end.\n17\t//   2. Keep the renderer **pluggable** via `options.renderer`. A future\n18\t//      `three-renderer.js` can lazy-import Three.js (or `3d-force-graph`)\n19\t//      from a CDN ESM and slot in without touching the widget core. The\n20\t//      same hook lets tests inject a stub.\n21\t//\n22\t// Honest trade-off: this is *not yet* a 3D synoptic web in the shell —\n23\t// the widget id keeps the historic name because the ontology contract\n24\t// and intent are identical. Upgrading to 3D is a follow-up; the data\n25\t// path needs to land first.\n26\t//\n27\t// Public API\n28\t//   createSynopticWebWidget(host, props, options)\n29\t//     props   — {\n30\t//       workspace?: string,        // default \"default\"\n31\t//       focusedLayer?: number,     // 1..5 — fade other AoT layers\n32\t//       selectedNodeId?: string,\n33\t//       onSelect?: (nodeId) => void,\n34\t//       data?: { nodes, edges }    // optional inline data — skips fetch\n35\t//     }\n36\t//     options — {\n37\t//       runtimeClient?: { runtimeFetch, readRuntimeJson },\n38\t//       renderer?: { mount(host, layout, props), update(layout, props), dispose() }\n39\t//     }\n40\t//\n41\t// Returns { update, refresh, destroy, get layout }.\n42\t\n43\timport { runtimeFetch, readRuntimeJson } from \"../../../runtime_client/runtime-client.js\";\n44\t\n45\tconst STATE_LOADING = \"loading\";\n46\tconst STATE_READY = \"ready\";\n47\tconst STATE_ERROR = \"error\";\n48\t\n49\tconst HTML_ESCAPES = {\n50\t  \"&\": \"&amp;\",\n51\t  \"<\": \"&lt;\",\n52\t  \">\": \"&gt;\",\n53\t  '\"': \"&quot;\",\n54\t  \"'\": \"&#39;\"\n55\t};\n56\t\n57\tfunction escapeHtml(text) {\n58\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n59\t}\n60\t\n61\t// AoT layering — layer 1 is most abstract, layer 5 is most concrete.\n62\t// The synoptic-web rendering puts abstract on top, concrete on bottom.\n63\tconst MIN_LAYER = 1;\n64\tconst MAX_LAYER = 5;\n65\tconst DEFAULT_LAYER = 3;\n66\t\n67\t// Subset of upstream palette — keeps the renderer dependency-free. The\n68\t// full palette lives in `runtime/frontend/src/components/Studio/kg3d/palette.ts`;\n69\t// the shell mirrors the most-used categories and falls back to a neutral\n70\t// colour for unknown ones.\n71\tconst CATEGORY_COLORS = {\n72\t  ai_deep_learning: \"#a78bfa\",\n73\t  neural_evolutionary_computing: \"#22d3ee\",\n74\t  calc_variations_control: \"#34d399\",\n75\t  linear_multilinear_algebra_matrix_theory: \"#fb923c\",\n76\t  optimisation_reinforcement_learning: \"#f472b6\",\n77\t  default: \"#94a3b8\"\n78\t};\n79\t\n80\tconst EDGE_COLORS = {\n81\t  prerequisite: \"rgba(99, 102, 241, 0.55)\",\n82\t  references: \"rgba(148, 163, 184, 0.45)\",\n83\t  default: \"rgba(148, 163, 184, 0.45)\"\n84\t};\n85\t\n86\tconst LAYER_GAP = 90;\n87\tconst NODE_RADIUS_BASE = 6;\n88\tconst NODE_RADIUS_SCALE = 18;\n89\tconst HORIZONTAL_PADDING = 32;\n90\tconst TOP_PADDING = 28;\n91\tconst BOTTOM_PADDING = 28;\n92\tconst SVG_WIDTH = 720;\n93\t\n94\tfunction pickCategoryColor(category) {\n95\t  if (category && CATEGORY_COLORS[category]) {\n96\t    return CATEGORY_COLORS[category];\n97\t  }\n98\t  return CATEGORY_COLORS.default;\n99\t}\n100\t\n101\tfunction pickEdgeColor(kind) {\n102\t  if (kind && EDGE_COLORS[kind]) {\n103\t    return EDGE_COLORS[kind];\n104\t  }\n105\t  return EDGE_COLORS.default;\n106\t}\n107\t\n108\tfunction buildOntologyPath(props) {\n109\t  const params = new URLSearchParams();\n110\t  params.set(\"workspace\", props.workspace || \"default\");\n111\t  return `/kg3d/ontology?${params.toString()}`;\n112\t}\n113\t\n114\tfunction ensureClient(options) {\n115\t  if (options && options.runtimeClient) {\n116\t    return options.runtimeClient;\n117\t  }\n118\t  return { runtimeFetch, readRuntimeJson };\n119\t}\n120\t\n121\tfunction clampLayer(layer) {\n122\t  if (typeof layer !== \"number\" || Number.isNaN(layer)) return DEFAULT_LAYER;\n123\t  if (layer < MIN_LAYER) return MIN_LAYER;\n124\t  if (layer > MAX_LAYER) return MAX_LAYER;\n125\t  return Math.round(layer);\n126\t}\n127\t\n128\tfunction pageRankWeight(node) {\n129\t  const pr =\n130\t    node && node.metrics && typeof node.metrics.pagerank === \"number\" ? node.metrics.pagerank : 0;\n131\t  // Pagerank in the test fixtures is normalised 0..100; clamp so a single\n132\t  // dominant node doesn't blow out the radius.\n133\t  return Math.max(0, Math.min(1, pr / 100));\n134\t}\n135\t\n136\t/**\n137\t * Compute layered layout. Nodes are bucketed by `aot_layer`; within a\n138\t * layer they're spaced evenly across the available width. Returns a map\n139\t * of nodeId → { x, y, radius, color } plus the bounding height.\n140\t */\n141\texport function computeLayout(nodes, edges) {\n142\t  const safeNodes = Array.isArray(nodes) ? nodes : [];\n143\t  const safeEdges = Array.isArray(edges) ? edges : [];\n144\t\n145\t  const buckets = new Map();\n146\t  for (let l = MIN_LAYER; l <= MAX_LAYER; l += 1) buckets.set(l, []);\n147\t  for (const node of safeNodes) {\n148\t    const layer = clampLayer(node && node.aot_layer);\n149\t    buckets.get(layer).push(node);\n150\t  }\n151\t\n152\t  const positions = {};\n153\t  buckets.forEach((bucketNodes, layer) => {\n154\t    const count = bucketNodes.length;\n155\t    if (count === 0) return;\n156\t    const innerWidth = SVG_WIDTH - HORIZONTAL_PADDING * 2;\n157\t    const step = count === 1 ? 0 : innerWidth / (count - 1);\n158\t    bucketNodes.forEach((node, idx) => {\n159\t      const x = HORIZONTAL_PADDING + (count === 1 ? innerWidth / 2 : idx * step);\n160\t      const y = TOP_PADDING + (layer - MIN_LAYER) * LAYER_GAP;\n161\t      const weight = pageRankWeight(node);\n162\t      const radius = NODE_RADIUS_BASE + weight * NODE_RADIUS_SCALE;\n163\t      positions[node.id] = {\n164\t        x,\n165\t        y,\n166\t        radius,\n167\t        layer,\n168\t        color: pickCategoryColor(node.category),\n169\t        node\n170\t      };\n171\t    });\n172\t  });\n173\t\n174\t  const renderedEdges = [];\n175\t  for (const edge of safeEdges) {\n176\t    const sourceId = edge.source_id || edge.source;\n177\t    const targetId = edge.target_id || edge.target;\n178\t    if (!sourceId || !targetId) continue;\n179\t    if (!positions[sourceId] || !positions[targetId]) continue;\n180\t    if (sourceId === targetId) continue;\n181\t    renderedEdges.push({\n182\t      id: edge.id || `${sourceId}->${targetId}`,\n183\t      source: sourceId,\n184\t      target: targetId,\n185\t      kind: edge.kind || \"references\",\n186\t      weight: typeof edge.weight === \"number\" ? edge.weight : 1\n187\t    });\n188\t  }\n189\t\n190\t  const totalLayers = MAX_LAYER - MIN_LAYER + 1;\n191\t  const height = TOP_PADDING + (totalLayers - 1) * LAYER_GAP + BOTTOM_PADDING;\n192\t\n193\t  return { positions, edges: renderedEdges, width: SVG_WIDTH, height, buckets };\n194\t}\n195\t\n196\tfunction renderEdgeSvg(edge, positions, focusedLayer) {\n197\t  const s = positions[edge.source];\n198\t  const t = positions[edge.target];\n199\t  if (!s || !t) return \"\";\n200\t  const opacity = focusedLayer\n201\t    ? s.layer === focusedLayer || t.layer === focusedLayer\n202\t      ? 0.8\n203\t      : 0.18\n204\t    : 0.7;\n205\t  const strokeWidth = edge.kind === \"prerequisite\" ? 1.8 : 1.2;\n206\t  return `<line class=\"prime-silo-kg__edge\"\n207\t    x1=\"${s.x}\" y1=\"${s.y}\" x2=\"${t.x}\" y2=\"${t.y}\"\n208\t    stroke=\"${pickEdgeColor(edge.kind)}\"\n209\t    stroke-width=\"${strokeWidth}\"\n210\t    stroke-opacity=\"${opacity}\" />`;\n211\t}\n212\t\n213\tfunction renderNodeSvg(positionEntry, props) {\n214\t  const { x, y, radius, layer, color, node } = positionEntry;\n215\t  const focused = props.focusedLayer;\n216\t  const inFocus = !focused || focused === layer;\n217\t  const opacity = inFocus ? 1 : 0.18;\n218\t  const selected = node.id === props.selectedNodeId;\n219\t  const label = node.display_name || node.canonical_name || node.id;\n220\t  const title =\n221\t    node.canonical_name && node.canonical_name !== label\n222\t      ? `${label} (${node.canonical_name})`\n223\t      : label;\n224\t  return `\n225\t    <g class=\"prime-silo-kg__node\" data-node-id=\"${escapeHtml(node.id)}\"${selected ? ' data-selected=\"true\"' : \"\"} opacity=\"${opacity}\">\n226\t      <title>${escapeHtml(title)}</title>\n227\t      <circle cx=\"${x}\" cy=\"${y}\" r=\"${radius}\" fill=\"${color}\" stroke=\"${selected ? \"#f8fafc\" : \"rgba(15,23,42,0.85)\"}\" stroke-width=\"${selected ? 2.5 : 1.5}\" />\n228\t      <text class=\"prime-silo-kg__node-label\" x=\"${x}\" y=\"${y + radius + 12}\" text-anchor=\"middle\">${escapeHtml(label)}</text>\n229\t    </g>\n230\t  `;\n231\t}\n232\t\n233\tfunction renderLayerGuides(height) {\n234\t  const guides = [];\n235\t  for (let layer = MIN_LAYER; layer <= MAX_LAYER; layer += 1) {\n236\t    const y = TOP_PADDING + (layer - MIN_LAYER) * LAYER_GAP;\n237\t    guides.push(\n238\t      `<line class=\"prime-silo-kg__layer-guide\" x1=\"0\" y1=\"${y}\" x2=\"${SVG_WIDTH}\" y2=\"${y}\" />`\n239\t    );\n240\t    guides.push(`<text class=\"prime-silo-kg__layer-label\" x=\"6\" y=\"${y - 6}\">L${layer}</text>`);\n241\t  }\n242\t  return guides.join(\"\");\n243\t}\n244\t\n245\texport function renderSvg(layout, props) {\n246\t  const { positions, edges, width, height } = layout;\n247\t  const edgeSvg = edges.map((e) => renderEdgeSvg(e, positions, props.focusedLayer)).join(\"\");\n248\t  const nodeSvg = Object.values(positions)\n249\t    .map((entry) => renderNodeSvg(entry, props))\n250\t    .join(\"\");\n251\t  return `\n252\t    <svg class=\"prime-silo-kg__svg\" viewBox=\"0 0 ${width} ${height}\" width=\"${width}\" height=\"${height}\" xmlns=\"http://www.w3.org/2000/svg\">\n253\t      <g class=\"prime-silo-kg__layer-guides\">${renderLayerGuides(height)}</g>\n254\t      <g class=\"prime-silo-kg__edges\">${edgeSvg}</g>\n255\t      <g class=\"prime-silo-kg__nodes\">${nodeSvg}</g>\n256\t    </svg>\n257\t  `;\n258\t}\n259\t\n260\tfunction renderError(host, error) {\n261\t  const detail = (error && ((error.body && error.body.detail) || error.message)) || String(error);\n262\t  host.dataset.widgetState = STATE_ERROR;\n263\t  host.innerHTML = `<div class=\"prime-silo-kg__error\">Knowledge graph load failed: ${escapeHtml(detail)}</div>`;\n264\t}\n265\t\n266\tfunction renderLoading(host, props) {\n267\t  host.dataset.widgetState = STATE_LOADING;\n268\t  host.innerHTML = `<div class=\"prime-silo-kg__loading\">Loading ontology for workspace ${escapeHtml(props.workspace || \"default\")}…</div>`;\n269\t}\n270\t\n271\tfunction renderEmpty(host, props) {\n272\t  host.dataset.widgetState = STATE_READY;\n273\t  host.innerHTML = `<div class=\"prime-silo-kg__empty\">No concepts in workspace <code>${escapeHtml(props.workspace || \"default\")}</code>. Ingest documents or run KG3D ontology compilation to populate the synoptic web.</div>`;\n274\t}\n275\t\n276\t/**\n277\t * Mount the synoptic-web widget into `host`.\n278\t */\n279\texport function createSynopticWebWidget(host, initialProps, options = {}) {\n280\t  if (!host || typeof host.querySelector !== \"function\") {\n281\t    throw new Error(\"createSynopticWebWidget: host must be an HTMLElement.\");\n282\t  }\n283\t\n284\t  const client = ensureClient(options);\n285\t  const customRenderer = options && options.renderer ? options.renderer : null;\n286\t  let props = { ...initialProps };\n287\t  let aborted = false;\n288\t  let lastLayout = null;\n289\t  let rendererHandle = null;\n290\t\n291\t  host.classList.add(\"prime-silo-kg\");\n292\t\n293\t  function onClick(event) {\n294\t    const target = event.target && event.target.closest && event.target.closest(\"[data-node-id]\");\n295\t    if (!target) return;\n296\t    const nodeId = target.getAttribute(\"data-node-id\");\n297\t    if (typeof props.onSelect === \"function\") {\n298\t      props.onSelect(nodeId);\n299\t    }\n300\t  }\n301\t\n302\t  if (typeof host.addEventListener === \"function\") {\n303\t    host.addEventListener(\"click\", onClick);\n304\t  }\n305\t\n306\t  function paint(layout) {\n307\t    if (customRenderer) {\n308\t      if (rendererHandle && typeof rendererHandle.update === \"function\") {\n309\t        rendererHandle.update(layout, props);\n310\t        return;\n311\t      }\n312\t      rendererHandle = customRenderer.mount(host, layout, props);\n313\t      host.dataset.widgetState = STATE_READY;\n314\t      return;\n315\t    }\n316\t    host.dataset.widgetState = STATE_READY;\n317\t    host.innerHTML = renderSvg(layout, props);\n318\t  }\n319\t\n320\t  // Fallback when /kg3d/ontology comes back empty: read the raw dual graph\n321\t  // from /graph/full (which works on every runtime version) and adapt it to\n322\t  // the widget's node shape. Seen live: a runtime whose ontology loader failed\n323\t  // and whose demo fixture was removed returned {node