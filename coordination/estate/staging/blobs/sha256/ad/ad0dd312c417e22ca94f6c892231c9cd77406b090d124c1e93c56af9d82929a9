{"parentUuid":"80391f4a-de88-4267-8ebd-3caf77f5dd87","isSidechain":false,"promptId":"5b41bf5b-39b7-47b2-b1be-8bc0501d2b90","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KFDTyHGLHJ3UmLdi9H7JPh","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t//\n3\t// ADR-001 Phase C — kg3d.synoptic_web widget tests.\n4\t//\n5\t// Seventh migrated widget; second graph-shaped after dag.canvas. Tests\n6\t// cover the runtime fetch path, the layered layout algorithm, palette\n7\t// fallbacks, the focused-layer fade, click delegation, the inline-data\n8\t// fast path that bypasses the fetch, and the pluggable-renderer hook\n9\t// (so future Three.js renderers can land without touching this suite).\n10\t\n11\timport assert from \"node:assert/strict\";\n12\t\n13\timport {\n14\t  createSynopticWebWidget,\n15\t  __testing as kgTesting\n16\t} from \"../app/L0/_all/mod/_prime_silo/widgets/kg3d/synoptic_web/index.js\";\n17\t\n18\tasync function main() {\n19\t  testBuildOntologyPath();\n20\t  testClampLayer();\n21\t  testPickCategoryAndEdgeColors();\n22\t  testComputeLayoutBucketsByLayer();\n23\t  testComputeLayoutDropsDanglingEdges();\n24\t  testRenderSvgIncludesLayerGuidesAndNodes();\n25\t  testRenderEdgeFocusFade();\n26\t  await testWidgetLoadsViaFetch();\n27\t  await testWidgetRendersFromInlineData();\n28\t  await testWidgetSurfacesError();\n29\t  await testWidgetEmptyOntology();\n30\t  await testWidgetGraphFullFallbackBudget();\n31\t  await testWidgetUpdateReloadsOnWorkspaceChange();\n32\t  await testWidgetUpdateRepaintsOnFocusedLayer();\n33\t  await testWidgetCustomRendererReceivesLayout();\n34\t  await testWidgetClickInvokesOnSelect();\n35\t  await testWidgetDestroyClearsHostAndDisposesRenderer();\n36\t  console.log(\"widgets_kg3d_synoptic_web_test: ok\");\n37\t}\n38\t\n39\tfunction testBuildOntologyPath() {\n40\t  assert.equal(kgTesting.buildOntologyPath({}), \"/kg3d/ontology?workspace=default\");\n41\t  assert.equal(\n42\t    kgTesting.buildOntologyPath({ workspace: \"c4_test\" }),\n43\t    \"/kg3d/ontology?workspace=c4_test\"\n44\t  );\n45\t}\n46\t\n47\tfunction testClampLayer() {\n48\t  assert.equal(kgTesting.clampLayer(0), kgTesting.MIN_LAYER);\n49\t  assert.equal(kgTesting.clampLayer(7), kgTesting.MAX_LAYER);\n50\t  assert.equal(kgTesting.clampLayer(2.7), 3);\n51\t  assert.equal(kgTesting.clampLayer(undefined), 3);\n52\t}\n53\t\n54\tfunction testPickCategoryAndEdgeColors() {\n55\t  assert.equal(\n56\t    kgTesting.pickCategoryColor(\"ai_deep_learning\"),\n57\t    kgTesting.CATEGORY_COLORS.ai_deep_learning\n58\t  );\n59\t  assert.equal(kgTesting.pickCategoryColor(\"not_a_category\"), kgTesting.CATEGORY_COLORS.default);\n60\t  assert.equal(kgTesting.pickCategoryColor(undefined), kgTesting.CATEGORY_COLORS.default);\n61\t\n62\t  assert.equal(kgTesting.pickEdgeColor(\"prerequisite\"), kgTesting.EDGE_COLORS.prerequisite);\n63\t  assert.equal(kgTesting.pickEdgeColor(\"references\"), kgTesting.EDGE_COLORS.references);\n64\t  assert.equal(kgTesting.pickEdgeColor(\"weird\"), kgTesting.EDGE_COLORS.default);\n65\t}\n66\t\n67\tfunction testComputeLayoutBucketsByLayer() {\n68\t  const nodes = [\n69\t    { id: \"a\", aot_layer: 1, category: \"ai_deep_learning\", metrics: { pagerank: 100 } },\n70\t    { id: \"b\", aot_layer: 2, category: \"neural_evolutionary_computing\", metrics: { pagerank: 50 } },\n71\t    { id: \"c\", aot_layer: 2, category: \"neural_evolutionary_computing\", metrics: { pagerank: 25 } },\n72\t    { id: \"d\", aot_layer: 4, metrics: { pagerank: 0 } } // unknown category falls back\n73\t  ];\n74\t  const edges = [\n75\t    { source_id: \"a\", target_id: \"b\", kind: \"prerequisite\" },\n76\t    { source_id: \"b\", target_id: \"c\", kind: \"references\" }\n77\t  ];\n78\t  const layout = kgTesting.computeLayout(nodes, edges);\n79\t  // a is alone in layer 1 — should be centred.\n80\t  assert.ok(layout.positions.a);\n81\t  assert.ok(layout.positions.b);\n82\t  assert.ok(layout.positions.c);\n83\t  assert.ok(layout.positions.d);\n84\t  // Layer 2 has b and c — they share a y coordinate.\n85\t  assert.equal(layout.positions.b.y, layout.positions.c.y);\n86\t  // Layer 1 sits above layer 4 (smaller y).\n87\t  assert.ok(layout.positions.a.y < layout.positions.d.y);\n88\t  // Pagerank weights radius — a (pr=100) is bigger than d (pr=0).\n89\t  assert.ok(layout.positions.a.radius > layout.positions.d.radius);\n90\t  // Two edges retained.\n91\t  assert.equal(layout.edges.length, 2);\n92\t  // Layer-bucket map exposed for external use.\n93\t  assert.equal(layout.buckets.get(2).length, 2);\n94\t  // Unknown-category node uses the default colour.\n95\t  assert.equal(layout.positions.d.color, kgTesting.CATEGORY_COLORS.default);\n96\t}\n97\t\n98\tfunction testComputeLayoutDropsDanglingEdges() {\n99\t  const nodes = [\n100\t    { id: \"a\", aot_layer: 1, metrics: { pagerank: 50 } },\n101\t    { id: \"b\", aot_layer: 2, metrics: { pagerank: 50 } }\n102\t  ];\n103\t  const edges = [\n104\t    { source_id: \"a\", target_id: \"b\" },\n105\t    { source_id: \"a\", target_id: \"ghost\" }, // dropped\n106\t    { source_id: \"ghost\", target_id: \"b\" }, // dropped\n107\t    { source_id: \"a\", target_id: \"a\" } // self-loop dropped\n108\t  ];\n109\t  const layout = kgTesting.computeLayout(nodes, edges);\n110\t  assert.equal(layout.edges.length, 1);\n111\t  assert.equal(layout.edges[0].source, \"a\");\n112\t  assert.equal(layout.edges[0].target, \"b\");\n113\t}\n114\t\n115\tfunction testRenderSvgIncludesLayerGuidesAndNodes() {\n116\t  const layout = kgTesting.computeLayout(\n117\t    [\n118\t      {\n119\t        id: \"a\",\n120\t        display_name: \"Alpha\",\n121\t        aot_layer: 1,\n122\t        category: \"ai_deep_learning\",\n123\t        metrics: { pagerank: 80 }\n124\t      },\n125\t      { id: \"b\", display_name: \"Beta\", aot_layer: 3, metrics: { pagerank: 40 } }\n126\t    ],\n127\t    [{ source_id: \"a\", target_id: \"b\", kind: \"prerequisite\" }]\n128\t  );\n129\t  const svg = kgTesting.renderSvg(layout, {});\n130\t  assert.match(svg, /<svg /);\n131\t  assert.match(svg, /data-node-id=\"a\"/);\n132\t  assert.match(svg, /data-node-id=\"b\"/);\n133\t  assert.match(svg, /Alpha/);\n134\t  assert.match(svg, /Beta/);\n135\t  // Layer guides for L1..L5 should be present.\n136\t  assert.match(svg, />L1</);\n137\t  assert.match(svg, />L5</);\n138\t  // Edge stroke uses the prerequisite colour.\n139\t  assert.match(svg, new RegExp(kgTesting.EDGE_COLORS.prerequisite.replace(/[()]/g, \"\\\\$&\")));\n140\t}\n141\t\n142\tfunction testRenderEdgeFocusFade() {\n143\t  const layout = kgTesting.computeLayout(\n144\t    [\n145\t      { id: \"a\", aot_layer: 1, metrics: { pagerank: 40 } },\n146\t      { id: \"b\", aot_layer: 5, metrics: { pagerank: 40 } }\n147\t    ],\n148\t    [{ source_id: \"a\", target_id: \"b\" }]\n149\t  );\n150\t  // Without focus → edge opacity is the default 0.7.\n151\t  const svgUnfocused = kgTesting.renderSvg(layout, {});\n152\t  assert.match(svgUnfocused, /stroke-opacity=\"0.7\"/);\n153\t  // With focus on layer 3 (which neither endpoint is in) → faded.\n154\t  const svgFocused = kgTesting.renderSvg(layout, { focusedLayer: 3 });\n155\t  assert.match(svgFocused, /stroke-opacity=\"0.18\"/);\n156\t  // Nodes outside the focus also fade.\n157\t  assert.match(svgFocused, /opacity=\"0.18\"/);\n158\t}\n159\t\n160\tclass FakeClassList {\n161\t  constructor() {\n162\t    this._set = new Set();\n163\t  }\n164\t  add(...n) {\n165\t    n.forEach((x) => this._set.add(x));\n166\t  }\n167\t  remove(...n) {\n168\t    n.forEach((x) => this._set.delete(x));\n169\t  }\n170\t  has(name) {\n171\t    return this._set.has(name);\n172\t  }\n173\t}\n174\t\n175\tclass FakeElement {\n176\t  constructor(tag = \"div\", attrs = {}) {\n177\t    this.tagName = tag.toUpperCase();\n178\t    this.attrs = { ...attrs };\n179\t    this.parent = null;\n180\t  }\n181\t  getAttribute(name) {\n182\t    return Object.prototype.hasOwnProperty.call(this.attrs, name) ? this.attrs[name] : null;\n183\t  }\n184\t  closest(selector) {\n185\t    if (!selector.startsWith(\"[\") || !selector.endsWith(\"]\")) return null;\n186\t    const attr = selector.slice(1, -1);\n187\t    let node = this;\n188\t    while (node) {\n189\t      if (node.attrs && Object.prototype.hasOwnProperty.call(node.attrs, attr)) {\n190\t        return node;\n191\t      }\n192\t      node = node.parent;\n193\t    }\n194\t    return null;\n195\t  }\n196\t}\n197\t\n198\tfunction createFakeHost() {\n199\t  const host = {\n200\t    classList: new FakeClassList(),\n201\t    dataset: {},\n202\t    innerHTML: \"\",\n203\t    _listeners: new Map(),\n204\t    addEventListener(type, handler) {\n205\t      if (!this._listeners.has(type)) this._listeners.set(type, []);\n206\t      this._listeners.get(type).push(handler);\n207\t    },\n208\t    removeEventListener(type, handler) {\n209\t      const list = this._listeners.get(type) || [];\n210\t      const idx = list.indexOf(handler);\n211\t      if (idx >= 0) list.splice(idx, 1);\n212\t    },\n213\t    dispatch(type, event) {\n214\t      const list = this._listeners.get(type) || [];\n215\t      for (const h of list) h(event);\n216\t    },\n217\t    querySelector: () => null\n218\t  };\n219\t  return host;\n220\t}\n221\t\n222\tfunction jsonResponse(body, status = 200) {\n223\t  return new Response(JSON.stringify(body), {\n224\t    status,\n225\t    headers: { \"content-type\": \"application/json\" }\n226\t  });\n227\t}\n228\t\n229\tfunction makeRuntimeError(status, detail) {\n230\t  const err = new Error(detail);\n231\t  err.name = \"RuntimeError\";\n232\t  err.status = status;\n233\t  err.body = { detail };\n234\t  return err;\n235\t}\n236\t\n237\tfunction createClientStub() {\n238\t  const calls = [];\n239\t  const stub = {\n240\t    calls,\n241\t    runtimeHandler: null,\n242\t    runtimeFetch: null,\n243\t    readRuntimeJson: async (response) => {\n244\t      const text = await response.text();\n245\t      return text ? JSON.parse(text) : null;\n246\t    }\n247\t  };\n248\t  stub.runtimeFetch = async (path, init = {}) => {\n249\t    calls.push({ path, init });\n250\t    if (!stub.runtimeHandler) {\n251\t      throw new Error(\"no runtimeHandler installed for path \" + path);\n252\t    }\n253\t    const result = stub.runtimeHandler(path, init);\n254\t    if (result instanceof Error) throw result;\n255\t    return result;\n256\t  };\n257\t  return stub;\n258\t}\n259\t\n260\tasync function settle() {\n261\t  // Macrotask drain, not just microtasks — the /graph/full fallback adds a\n262\t  // second fetch round-trip, and Response.text() can resolve across timers.\n263\t  for (let i = 0; i < 4; i += 1) await new Promise((r) => setTimeout(r, 0));\n264\t}\n265\t\n266\tconst SAMPLE_ONTOLOGY = {\n267\t  nodes: [\n268\t    {\n269\t      id: \"1\",\n270\t      canonical_name: \"AI\",\n271\t      display_name: \"Artificial Intelligence\",\n272\t      category: \"ai_deep_learning\",\n273\t      aot_layer: 1,\n274\t      metrics: { pagerank: 100 }\n275\t    },\n276\t    {\n277\t      id: \"2\",\n278\t      canonical_name: \"Neural Networks\",\n279\t      display_name: \"Neural Networks\",\n280\t      category: \"neural_evolutionary_computing\",\n281\t      aot_layer: 2,\n282\t      metrics: { pagerank: 60 }\n283\t    }\n284\t  ],\n285\t  edges: [{ id: \"e1\", source_id: \"1\", target_id: \"2\", kind: \"prerequisite\" }]\n286\t};\n287\t\n288\tasync function testWidgetLoadsViaFetch() {\n289\t  const host = createFakeHost();\n290\t  const client = createClientStub();\n291\t  client.runtimeHandler = (path) => {\n292\t    assert.match(path, /\\/kg3d\\/ontology\\?workspace=c4_test/);\n293\t    return jsonResponse(SAMPLE_ONTOLOGY);\n294\t  };\n295\t\n296\t  const handle = createSynopticWebWidget(host, { workspace: \"c4_test\" }, { runtimeClient: client });\n297\t  await settle();\n298\t\n299\t  assert.equal(host.dataset.widgetState, \"ready\");\n300\t  assert.match(host.innerHTML, /Artificial Intelligence/);\n301\t  assert.match(host.innerHTML, /Neural Networks/);\n302\t  assert.equal(client.calls.length, 1);\n303\t  assert.ok(handle.layout);\n304\t  assert.ok(handle.layout.positions[\"1\"]);\n305\t  assert.ok(handle.layout.positions[\"2\"]);\n306\t}\n307\t\n308\tasync function testWidgetRendersFromInlineData() {\n309\t  const host = createFakeHost();\n310\t  const client = createClientStub();\n311\t  // No runtimeHandler → fetch would throw if called.\n312\t  createSynopticWebWidget(\n313\t    host,\n314\t    { data: SAMPLE_ONTOLOGY, workspace: \"c4_test\" },\n315\t    { runtimeClient: client }\n316\t  );\n317\t  await settle();\n318\t\n319\t  assert.equal(host.dataset.widgetState, \"ready\");\n320\t  assert.match(host.innerHTML, /Neural Networks/);\n321\t  assert.equal(client.calls.length, 0, \"inline data must skip the fetch\");\n322\t}\n323\t\n324\tasync function testWidgetSurfacesError() {\n325\t  const host = createFakeHost();\n326\t  const client = createClientStub();\n327\t  client.runtimeHandler = () => makeRuntimeError(503, \"neo4j unavailable\");\n328\t\n329\t  createSynopticWebWidget(host, {}, { runtimeClient: client });\n330\t  await settle();\n331\t\n332\t  assert.equal(host.dataset.widgetState, \"error\");\n333\t  assert.match(host.innerHTML, /neo4j unavailable/);\n334\t}\n335\t\n336\tasync function testWidgetEmptyOntology() {\n337\t  const host = createFakeHost();\n338\t  const client = createClientStub();\n339\t  client.runtimeHandler = () => jsonResponse({ nodes: [], edges: [] });\n340\t\n341\t  createSynopticWebWidget(host, { workspace: \"fresh\" }, { runtimeClient: client });\n342\t  await settle();\n343\t\n344\t  assert.equal(host.dataset.widgetState, \"ready\");\n345\t  assert.match(host.innerHTML, /No concepts in workspace/);\n346\t  assert.match(host.innerHTML, /<code>fresh<\\/code>/);\n347\t}\n348\t\n349\tasync function testWidgetGraphFullFallbackBudget() {\n350\t  // Regression for v1.10.0: a post-synthesis workspace (tens of thousands of\n351\t  // concepts) reached the /graph/full fallback and died with \"Maximum call\n352\t  // stack size exceeded\" (spread-max over the degree values). The fallback now\n353\t  // caps the view at 400 nodes: every Source plus the most-connected concepts.\n354\t  const nodes = [\n355\t    { id: \"s1\", name: \"doc-one.md\", labels: [\"Source\"] },\n356\t    { id: \"s2\", name: \"doc-two.md\", labels: [\"Source\"] }\n357\t  ];\n358\t  const edges = [];\n359\t  for (let i = 0; i < 1000; i += 1) {\n360\t    nodes.push({ id: `c${i}`, name: `Concept ${i}`, labels: [\"Concept\"] });\n361\t    if (i > 0) edges.push({ source: `c${i - 1}`, target: `c${i}` });\n362\t  }\n363\t  // Make c0 an unmistakable hub so it must survive the cut.\n364\t  for (let i = 500; i < 520; i += 1) edges.push({ source: \"c0\", target: `c${i}` });\n365\t\n366\t  const host = createFakeHost();\n367\t  const client = createClientStub();\n368\t  client.runtimeHandler = (path) =>\n369\t    path.startsWith(\"/graph/full\")\n370\t      ? jsonResponse({ nodes, edges })\n371\t      : jsonResponse({ nodes: [], edges: [] });\n372\t\n373\t  const handle = createSynopticWebWidget(host, { workspace: \"big\" }, { runtimeClient: client });\n374\t  await settle();\n375\t\n376\t  assert.equal(host.dataset.widgetState, \"ready\");\n377\t  const kept = Object.keys(handle.layout.positions);\n378\t  assert.equal(kept.length, 400, \"fallback must cap the rendered graph at 400 nodes\");\n379\t  assert.ok(handle.layout.positions.s1, \"sources always survive the cut\");\n380\t  assert.ok(handle.layout.positions.s2, \"sources always survive the cut\");\n381\t  assert.ok(handle.layout.positions.c0, \"the highest-degree concept survives the cut\");\n382\t  // Edges to dropped nodes are filtered, not left dangling.\n383\t  for (const e of handle.layout.edges) {\n384\t    assert.ok(handle.layout.positions[e.source] && handle.layout.positions[e.target]);\n385\t  }\n386\t}\n387\t\n388\tasync function testWidgetUpdateReloadsOnWorkspaceChange() {\n389\t  const host = createFakeHost();\n390\t  const client = createClientStub();\n391\t  let nthLoad = 0;\n392\t  client.runtimeHandler = (path) => {\n393\t    nthLoad += 1;\n394\t    return jsonResponse({\n395\t      nodes: [\n396\t        {\n397\t          id: `n-${nthLoad}`,\n398\t          display_name: `Node ${nthLoad}`,\n399\t          aot_layer: 2,\n400\t          metrics: { pagerank: 50 }\n401\t        }\n402\t      ],\n403\t      edges: []\n404\t    });\n405\t  };\n406\t\n407\t  const widget = createSynopticWebWidget(host, { workspace: \"first\" }, { runtimeClient: client });\n408\t  await settle();\n409\t  widget.update({ workspace: \"second\" });\n410\t  await settle();\n411\t\n412\t  assert.equal(client.calls.length, 2);\n413\t  assert.match(host.innerHTML, /Node 2/);\n414\t}\n415\t\n416\tasync function testWidgetUpdateRepaintsOnFocusedLayer() {\n417\t  const host = createFakeHost();\n418\t  const client = createClientStub();\n419\t  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n420\t\n421\t  const widget = createSynopticWebWidget(host, {}, { runtimeClient: client });\n422\t  await settle();\n423\t  assert.equal(client.calls.length, 1);\n424\t\n425\t  widget.update({ focusedLayer: 1 });\n426\t  await settle();\n427\t\n428\t  // No new fetch — focusedLayer is a render-only change.\n429\t  assert.equal(client.calls.length, 1);\n430\t  // Node 2 (layer 2) should be faded; node 1 (layer 1) should not.\n431\t  assert.match(host.innerHTML, /data-node-id=\"2\"\\s+opacity=\"0.18\"/);\n432\t}\n433\t\n434\tasync function testWidgetCustomRendererReceivesLayout() {\n435\t  const host = createFakeHost();\n436\t  const client = createClientStub();\n437\t  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n438\t\n439\t  const renderCalls = [];\n440\t  let disposeCalled = 0;\n441\t  const customRenderer = {\n442\t    mount(_h, layout, props) {\n443\t      renderCalls.push({ phase: \"mount\", layout, props: { ...props } });\n444\t      return {\n445\t        update(nextLayout, nextProps) {\n446\t          renderCalls.push({ phase: \"update\", layout: nextLayout, props: { ...nextProps } });\n447\t        },\n448\t        dispose() {\n449\t          disposeCalled += 1;\n450\t        }\n451\t      };\n452\t    }\n453\t  };\n454\t\n455\t  const widget = createSynopticWebWidget(\n456\t    host,\n457\t    { workspace: \"c4_test\" },\n458\t    { runtimeClient: client, renderer: customRenderer }\n459\t  );\n460\t  await settle();\n461\t\n462\t  assert.equal(renderCalls.length, 1);\n463\t  assert.equal(renderCalls[0].phase, \"mount\");\n464\t  assert.ok(renderCalls[0].layout.positions[\"1\"]);\n465\t  // Default SVG should NOT be rendered when a custom renderer is provided.\n466\t  assert.doesNotMatch(host.innerHTML, /<svg /);\n467\t  assert.equal(host.dataset.widgetState, \"ready\");\n468\t\n469\t  // Update with focused layer — should call renderer.update, not remount.\n470\t  widget.update({ focusedLayer: 1 });\n471\t  await settle();\n472\t  assert.equal(renderCalls.length, 2);\n473\t  assert.equal(renderCalls[1].phase, \"update\");\n474\t  assert.equal(renderCalls[1].props.focusedLayer, 1);\n475\t\n476\t  widget.destroy();\n477\t  assert.equal(disposeCalled, 1);\n478\t}\n479\t\n480\tasync function testWidgetClickInvokesOnSelect() {\n481\t  const host = createFakeHost();\n482\t  const client = createClientStub();\n483\t  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n484\t\n485\t  const clicks = [];\n486\t  createSynopticWebWidget(host, { onSelect: (id) => clicks.push(id) }, { runtimeClient: client });\n487\t  await settle();\n488\t\n489\t  // Simulate a click on the node group's child.\n490\t  const nodeEl = new FakeElement(\"g\", { \"data-node-id\": \"1\" });\n491\t  const inner = new FakeElement(\"circle\");\n492\t  inner.parent = nodeEl;\n493\t  host.dispatch(\"click\", { target: inner });\n494\t\n495\t  assert.deepEqual(clicks, [\"1\"]);\n496\t}\n497\t\n498\tasync function testWidgetDestroyClearsHostAndDisposesRenderer() {\n499\t  const host = createFakeHost();\n500\t  const client = createClientStub();\n501\t  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n502\t\n503\t  const handle = createSynopticWebWidget(host, {}, { runtimeClient: client });\n504\t  await settle();\n505\t  assert.match(host.innerHTML, /<svg /);\n506\t  handle.destroy();\n507\t  assert.equal(host.innerHTML, \"\");\n508\t  assert.equal(host.dataset.widgetState, undefined);\n509\t}\n510\t\n511\tmain().catch((err) => {\n512\t  console.error(err);\n513\t  process.exit(1);\n514\t});\n515\t"}]},"uuid":"0fab2d1b-67db-43c1-881d-fd4e78b31711","timestamp":"2026-07-03T19:50:42.846Z","toolUseResult":{"type":"text","file":{"filePath":"prime-silo\\tests\\widgets_kg3d_synoptic_web_test.mjs","content":"#!/usr/bin/env node\n//\n// ADR-001 Phase C — kg3d.synoptic_web widget tests.\n//\n// Seventh migrated widget; second graph-shaped after dag.canvas. Tests\n// cover the runtime fetch path, the layered layout algorithm, palette\n// fallbacks, the focused-layer fade, click delegation, the inline-data\n// fast path that bypasses the fetch, and the pluggable-renderer hook\n// (so future Three.js renderers can land without touching this suite).\n\nimport assert from \"node:assert/strict\";\n\nimport {\n  createSynopticWebWidget,\n  __testing as kgTesting\n} from \"../app/L0/_all/mod/_prime_silo/widgets/kg3d/synoptic_web/index.js\";\n\nasync function main() {\n  testBuildOntologyPath();\n  testClampLayer();\n  testPickCategoryAndEdgeColors();\n  testComputeLayoutBucketsByLayer();\n  testComputeLayoutDropsDanglingEdges();\n  testRenderSvgIncludesLayerGuidesAndNodes();\n  testRenderEdgeFocusFade();\n  await testWidgetLoadsViaFetch();\n  await testWidgetRendersFromInlineData();\n  await testWidgetSurfacesError();\n  await testWidgetEmptyOntology();\n  await testWidgetGraphFullFallbackBudget();\n  await testWidgetUpdateReloadsOnWorkspaceChange();\n  await testWidgetUpdateRepaintsOnFocusedLayer();\n  await testWidgetCustomRendererReceivesLayout();\n  await testWidgetClickInvokesOnSelect();\n  await testWidgetDestroyClearsHostAndDisposesRenderer();\n  console.log(\"widgets_kg3d_synoptic_web_test: ok\");\n}\n\nfunction testBuildOntologyPath() {\n  assert.equal(kgTesting.buildOntologyPath({}), \"/kg3d/ontology?workspace=default\");\n  assert.equal(\n    kgTesting.buildOntologyPath({ workspace: \"c4_test\" }),\n    \"/kg3d/ontology?workspace=c4_test\"\n  );\n}\n\nfunction testClampLayer() {\n  assert.equal(kgTesting.clampLayer(0), kgTesting.MIN_LAYER);\n  assert.equal(kgTesting.clampLayer(7), kgTesting.MAX_LAYER);\n  assert.equal(kgTesting.clampLayer(2.7), 3);\n  assert.equal(kgTesting.clampLayer(undefined), 3);\n}\n\nfunction testPickCategoryAndEdgeColors() {\n  assert.equal(\n    kgTesting.pickCategoryColor(\"ai_deep_learning\"),\n    kgTesting.CATEGORY_COLORS.ai_deep_learning\n  );\n  assert.equal(kgTesting.pickCategoryColor(\"not_a_category\"), kgTesting.CATEGORY_COLORS.default);\n  assert.equal(kgTesting.pickCategoryColor(undefined), kgTesting.CATEGORY_COLORS.default);\n\n  assert.equal(kgTesting.pickEdgeColor(\"prerequisite\"), kgTesting.EDGE_COLORS.prerequisite);\n  assert.equal(kgTesting.pickEdgeColor(\"references\"), kgTesting.EDGE_COLORS.references);\n  assert.equal(kgTesting.pickEdgeColor(\"weird\"), kgTesting.EDGE_COLORS.default);\n}\n\nfunction testComputeLayoutBucketsByLayer() {\n  const nodes = [\n    { id: \"a\", aot_layer: 1, category: \"ai_deep_learning\", metrics: { pagerank: 100 } },\n    { id: \"b\", aot_layer: 2, category: \"neural_evolutionary_computing\", metrics: { pagerank: 50 } },\n    { id: \"c\", aot_layer: 2, category: \"neural_evolutionary_computing\", metrics: { pagerank: 25 } },\n    { id: \"d\", aot_layer: 4, metrics: { pagerank: 0 } } // unknown category falls back\n  ];\n  const edges = [\n    { source_id: \"a\", target_id: \"b\", kind: \"prerequisite\" },\n    { source_id: \"b\", target_id: \"c\", kind: \"references\" }\n  ];\n  const layout = kgTesting.computeLayout(nodes, edges);\n  // a is alone in layer 1 — should be centred.\n  assert.ok(layout.positions.a);\n  assert.ok(layout.positions.b);\n  assert.ok(layout.positions.c);\n  assert.ok(layout.positions.d);\n  // Layer 2 has b and c — they share a y coordinate.\n  assert.equal(layout.positions.b.y, layout.positions.c.y);\n  // Layer 1 sits above layer 4 (smaller y).\n  assert.ok(layout.positions.a.y < layout.positions.d.y);\n  // Pagerank weights radius — a (pr=100) is bigger than d (pr=0).\n  assert.ok(layout.positions.a.radius > layout.positions.d.radius);\n  // Two edges retained.\n  assert.equal(layout.edges.length, 2);\n  // Layer-bucket map exposed for external use.\n  assert.equal(layout.buckets.get(2).length, 2);\n  // Unknown-category node uses the default colour.\n  assert.equal(layout.positions.d.color, kgTesting.CATEGORY_COLORS.default);\n}\n\nfunction testComputeLayoutDropsDanglingEdges() {\n  const nodes = [\n    { id: \"a\", aot_layer: 1, metrics: { pagerank: 50 } },\n    { id: \"b\", aot_layer: 2, metrics: { pagerank: 50 } }\n  ];\n  const edges = [\n    { source_id: \"a\", target_id: \"b\" },\n    { source_id: \"a\", target_id: \"ghost\" }, // dropped\n    { source_id: \"ghost\", target_id: \"b\" }, // dropped\n    { source_id: \"a\", target_id: \"a\" } // self-loop dropped\n  ];\n  const layout = kgTesting.computeLayout(nodes, edges);\n  assert.equal(layout.edges.length, 1);\n  assert.equal(layout.edges[0].source, \"a\");\n  assert.equal(layout.edges[0].target, \"b\");\n}\n\nfunction testRenderSvgIncludesLayerGuidesAndNodes() {\n  const layout = kgTesting.computeLayout(\n    [\n      {\n        id: \"a\",\n        display_name: \"Alpha\",\n        aot_layer: 1,\n        category: \"ai_deep_learning\",\n        metrics: { pagerank: 80 }\n      },\n      { id: \"b\", display_name: \"Beta\", aot_layer: 3, metrics: { pagerank: 40 } }\n    ],\n    [{ source_id: \"a\", target_id: \"b\", kind: \"prerequisite\" }]\n  );\n  const svg = kgTesting.renderSvg(layout, {});\n  assert.match(svg, /<svg /);\n  assert.match(svg, /data-node-id=\"a\"/);\n  assert.match(svg, /data-node-id=\"b\"/);\n  assert.match(svg, /Alpha/);\n  assert.match(svg, /Beta/);\n  // Layer guides for L1..L5 should be present.\n  assert.match(svg, />L1</);\n  assert.match(svg, />L5</);\n  // Edge stroke uses the prerequisite colour.\n  assert.match(svg, new RegExp(kgTesting.EDGE_COLORS.prerequisite.replace(/[()]/g, \"\\\\$&\")));\n}\n\nfunction testRenderEdgeFocusFade() {\n  const layout = kgTesting.computeLayout(\n    [\n      { id: \"a\", aot_layer: 1, metrics: { pagerank: 40 } },\n      { id: \"b\", aot_layer: 5, metrics: { pagerank: 40 } }\n    ],\n    [{ source_id: \"a\", target_id: \"b\" }]\n  );\n  // Without focus → edge opacity is the default 0.7.\n  const svgUnfocused = kgTesting.renderSvg(layout, {});\n  assert.match(svgUnfocused, /stroke-opacity=\"0.7\"/);\n  // With focus on layer 3 (which neither endpoint is in) → faded.\n  const svgFocused = kgTesting.renderSvg(layout, { focusedLayer: 3 });\n  assert.match(svgFocused, /stroke-opacity=\"0.18\"/);\n  // Nodes outside the focus also fade.\n  assert.match(svgFocused, /opacity=\"0.18\"/);\n}\n\nclass FakeClassList {\n  constructor() {\n    this._set = new Set();\n  }\n  add(...n) {\n    n.forEach((x) => this._set.add(x));\n  }\n  remove(...n) {\n    n.forEach((x) => this._set.delete(x));\n  }\n  has(name) {\n    return this._set.has(name);\n  }\n}\n\nclass FakeElement {\n  constructor(tag = \"div\", attrs = {}) {\n    this.tagName = tag.toUpperCase();\n    this.attrs = { ...attrs };\n    this.parent = null;\n  }\n  getAttribute(name) {\n    return Object.prototype.hasOwnProperty.call(this.attrs, name) ? this.attrs[name] : null;\n  }\n  closest(selector) {\n    if (!selector.startsWith(\"[\") || !selector.endsWith(\"]\")) return null;\n    const attr = selector.slice(1, -1);\n    let node = this;\n    while (node) {\n      if (node.attrs && Object.prototype.hasOwnProperty.call(node.attrs, attr)) {\n        return node;\n      }\n      node = node.parent;\n    }\n    return null;\n  }\n}\n\nfunction createFakeHost() {\n  const host = {\n    classList: new FakeClassList(),\n    dataset: {},\n    innerHTML: \"\",\n    _listeners: new Map(),\n    addEventListener(type, handler) {\n      if (!this._listeners.has(type)) this._listeners.set(type, []);\n      this._listeners.get(type).push(handler);\n    },\n    removeEventListener(type, handler) {\n      const list = this._listeners.get(type) || [];\n      const idx = list.indexOf(handler);\n      if (idx >= 0) list.splice(idx, 1);\n    },\n    dispatch(type, event) {\n      const list = this._listeners.get(type) || [];\n      for (const h of list) h(event);\n    },\n    querySelector: () => null\n  };\n  return host;\n}\n\nfunction jsonResponse(body, status = 200) {\n  return new Response(JSON.stringify(body), {\n    status,\n    headers: { \"content-type\": \"application/json\" }\n  });\n}\n\nfunction makeRuntimeError(status, detail) {\n  const err = new Error(detail);\n  err.name = \"RuntimeError\";\n  err.status = status;\n  err.body = { detail };\n  return err;\n}\n\nfunction createClientStub() {\n  const calls = [];\n  const stub = {\n    calls,\n    runtimeHandler: null,\n    runtimeFetch: null,\n    readRuntimeJson: async (response) => {\n      const text = await response.text();\n      return text ? JSON.parse(text) : null;\n    }\n  };\n  stub.runtimeFetch = async (path, init = {}) => {\n    calls.push({ path, init });\n    if (!stub.runtimeHandler) {\n      throw new Error(\"no runtimeHandler installed for path \" + path);\n    }\n    const result = stub.runtimeHandler(path, init);\n    if (result instanceof Error) throw result;\n    return result;\n  };\n  return stub;\n}\n\nasync function settle() {\n  // Macrotask drain, not just microtasks — the /graph/full fallback adds a\n  // second fetch round-trip, and Response.text() can resolve across timers.\n  for (let i = 0; i < 4; i += 1) await new Promise((r) => setTimeout(r, 0));\n}\n\nconst SAMPLE_ONTOLOGY = {\n  nodes: [\n    {\n      id: \"1\",\n      canonical_name: \"AI\",\n      display_name: \"Artificial Intelligence\",\n      category: \"ai_deep_learning\",\n      aot_layer: 1,\n      metrics: { pagerank: 100 }\n    },\n    {\n      id: \"2\",\n      canonical_name: \"Neural Networks\",\n      display_name: \"Neural Networks\",\n      category: \"neural_evolutionary_computing\",\n      aot_layer: 2,\n      metrics: { pagerank: 60 }\n    }\n  ],\n  edges: [{ id: \"e1\", source_id: \"1\", target_id: \"2\", kind: \"prerequisite\" }]\n};\n\nasync function testWidgetLoadsViaFetch() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = (path) => {\n    assert.match(path, /\\/kg3d\\/ontology\\?workspace=c4_test/);\n    return jsonResponse(SAMPLE_ONTOLOGY);\n  };\n\n  const handle = createSynopticWebWidget(host, { workspace: \"c4_test\" }, { runtimeClient: client });\n  await settle();\n\n  assert.equal(host.dataset.widgetState, \"ready\");\n  assert.match(host.innerHTML, /Artificial Intelligence/);\n  assert.match(host.innerHTML, /Neural Networks/);\n  assert.equal(client.calls.length, 1);\n  assert.ok(handle.layout);\n  assert.ok(handle.layout.positions[\"1\"]);\n  assert.ok(handle.layout.positions[\"2\"]);\n}\n\nasync function testWidgetRendersFromInlineData() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  // No runtimeHandler → fetch would throw if called.\n  createSynopticWebWidget(\n    host,\n    { data: SAMPLE_ONTOLOGY, workspace: \"c4_test\" },\n    { runtimeClient: client }\n  );\n  await settle();\n\n  assert.equal(host.dataset.widgetState, \"ready\");\n  assert.match(host.innerHTML, /Neural Networks/);\n  assert.equal(client.calls.length, 0, \"inline data must skip the fetch\");\n}\n\nasync function testWidgetSurfacesError() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = () => makeRuntimeError(503, \"neo4j unavailable\");\n\n  createSynopticWebWidget(host, {}, { runtimeClient: client });\n  await settle();\n\n  assert.equal(host.dataset.widgetState, \"error\");\n  assert.match(host.innerHTML, /neo4j unavailable/);\n}\n\nasync function testWidgetEmptyOntology() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = () => jsonResponse({ nodes: [], edges: [] });\n\n  createSynopticWebWidget(host, { workspace: \"fresh\" }, { runtimeClient: client });\n  await settle();\n\n  assert.equal(host.dataset.widgetState, \"ready\");\n  assert.match(host.innerHTML, /No concepts in workspace/);\n  assert.match(host.innerHTML, /<code>fresh<\\/code>/);\n}\n\nasync function testWidgetGraphFullFallbackBudget() {\n  // Regression for v1.10.0: a post-synthesis workspace (tens of thousands of\n  // concepts) reached the /graph/full fallback and died with \"Maximum call\n  // stack size exceeded\" (spread-max over the degree values). The fallback now\n  // caps the view at 400 nodes: every Source plus the most-connected concepts.\n  const nodes = [\n    { id: \"s1\", name: \"doc-one.md\", labels: [\"Source\"] },\n    { id: \"s2\", name: \"doc-two.md\", labels: [\"Source\"] }\n  ];\n  const edges = [];\n  for (let i = 0; i < 1000; i += 1) {\n    nodes.push({ id: `c${i}`, name: `Concept ${i}`, labels: [\"Concept\"] });\n    if (i > 0) edges.push({ source: `c${i - 1}`, target: `c${i}` });\n  }\n  // Make c0 an unmistakable hub so it must survive the cut.\n  for (let i = 500; i < 520; i += 1) edges.push({ source: \"c0\", target: `c${i}` });\n\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = (path) =>\n    path.startsWith(\"/graph/full\")\n      ? jsonResponse({ nodes, edges })\n      : jsonResponse({ nodes: [], edges: [] });\n\n  const handle = createSynopticWebWidget(host, { workspace: \"big\" }, { runtimeClient: client });\n  await settle();\n\n  assert.equal(host.dataset.widgetState, \"ready\");\n  const kept = Object.keys(handle.layout.positions);\n  assert.equal(kept.length, 400, \"fallback must cap the rendered graph at 400 nodes\");\n  assert.ok(handle.layout.positions.s1, \"sources always survive the cut\");\n  assert.ok(handle.layout.positions.s2, \"sources always survive the cut\");\n  assert.ok(handle.layout.positions.c0, \"the highest-degree concept survives the cut\");\n  // Edges to dropped nodes are filtered, not left dangling.\n  for (const e of handle.layout.edges) {\n    assert.ok(handle.layout.positions[e.source] && handle.layout.positions[e.target]);\n  }\n}\n\nasync function testWidgetUpdateReloadsOnWorkspaceChange() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  let nthLoad = 0;\n  client.runtimeHandler = (path) => {\n    nthLoad += 1;\n    return jsonResponse({\n      nodes: [\n        {\n          id: `n-${nthLoad}`,\n          display_name: `Node ${nthLoad}`,\n          aot_layer: 2,\n          metrics: { pagerank: 50 }\n        }\n      ],\n      edges: []\n    });\n  };\n\n  const widget = createSynopticWebWidget(host, { workspace: \"first\" }, { runtimeClient: client });\n  await settle();\n  widget.update({ workspace: \"second\" });\n  await settle();\n\n  assert.equal(client.calls.length, 2);\n  assert.match(host.innerHTML, /Node 2/);\n}\n\nasync function testWidgetUpdateRepaintsOnFocusedLayer() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n\n  const widget = createSynopticWebWidget(host, {}, { runtimeClient: client });\n  await settle();\n  assert.equal(client.calls.length, 1);\n\n  widget.update({ focusedLayer: 1 });\n  await settle();\n\n  // No new fetch — focusedLayer is a render-only change.\n  assert.equal(client.calls.length, 1);\n  // Node 2 (layer 2) should be faded; node 1 (layer 1) should not.\n  assert.match(host.innerHTML, /data-node-id=\"2\"\\s+opacity=\"0.18\"/);\n}\n\nasync function testWidgetCustomRendererReceivesLayout() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n\n  const renderCalls = [];\n  let disposeCalled = 0;\n  const customRenderer = {\n    mount(_h, layout, props) {\n      renderCalls.push({ phase: \"mount\", layout, props: { ...props } });\n      return {\n        update(nextLayout, nextProps) {\n          renderCalls.push({ phase: \"update\", layout: nextLayout, props: { ...nextProps } });\n        },\n        dispose() {\n          disposeCalled += 1;\n        }\n      };\n    }\n  };\n\n  const widget = createSynopticWebWidget(\n    host,\n    { workspace: \"c4_test\" },\n    { runtimeClient: client, renderer: customRenderer }\n  );\n  await settle();\n\n  assert.equal(renderCalls.length, 1);\n  assert.equal(renderCalls[0].phase, \"mount\");\n  assert.ok(renderCalls[0].layout.positions[\"1\"]);\n  // Default SVG should NOT be rendered when a custom renderer is provided.\n  assert.doesNotMatch(host.innerHTML, /<svg /);\n  assert.equal(host.dataset.widgetState, \"ready\");\n\n  // Update with focused layer — should call renderer.update, not remount.\n  widget.update({ focusedLayer: 1 });\n  await settle();\n  assert.equal(renderCalls.length, 2);\n  assert.equal(renderCalls[1].phase, \"update\");\n  assert.equal(renderCalls[1].props.focusedLayer, 1);\n\n  widget.destroy();\n  assert.equal(disposeCalled, 1);\n}\n\nasync function testWidgetClickInvokesOnSelect() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n\n  const clicks = [];\n  createSynopticWebWidget(host, { onSelect: (id) => clicks.push(id) }, { runtimeClient: client });\n  await settle();\n\n  // Simulate a click on the node group's child.\n  const nodeEl = new FakeElement(\"g\", { \"data-node-id\": \"1\" });\n  const inner = new FakeElement(\"circle\");\n  inner.parent = nodeEl;\n  host.dispatch(\"click\", { target: inner });\n\n  assert.deepEqual(clicks, [\"1\"]);\n}\n\nasync function testWidgetDestroyClearsHostAndDisposesRenderer() {\n  const host = createFakeHost();\n  const client = createClientStub();\n  client.runtimeHandler = () => jsonResponse(SAMPLE_ONTOLOGY);\n\n  const handle = createSynopticWebWidget(host, {}, { runtimeClient: client });\n  await settle();\n  assert.match(host.innerHTML, /<svg /);\n  handle.destroy();\n  assert.equal(host.innerHTML, \"\");\n  assert.equal(host.dataset.widgetState, undefined);\n}\n\nmain().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n","numLines":515,"startLine":1,"totalLines":515}},"sourceToolAssistantUUID":"80391f4a-de88-4267-8ebd-3caf77f5dd87","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"4cd9df3b-c431-4ac3-8790-b888629655bb","version":"2.1.197","gitBranch":"HEAD","slug":"warm-beaming-pretzel"}
