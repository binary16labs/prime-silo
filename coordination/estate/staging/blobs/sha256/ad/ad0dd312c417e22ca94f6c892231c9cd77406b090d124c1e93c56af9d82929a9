      2\n167\t    );\n168\t    if (spec?.chapters?.length) {\n169\t      part.chapters = spec.chapters.map((c, i) => ({ ...c, n: nextChapter + i }));\n170\t      nextChapter += spec.chapters.length;\n171\t      fs.writeFileSync(outlinePath, JSON.stringify(outline, null, 2));\n172\t    } else {\n173\t      console.log(`[opus] WARN chapters for part ${part.n} did not parse — rerun resumes here`);\n174\t    }\n175\t  }\n176\t\n177\t  // Per-chapter section breakdown, resume-safe per chapter.\n178\t  for (const part of outline.parts) {\n179\t    for (const ch of part.chapters || []) {\n180\t      if (interrupted()) return outline;\n181\t      if (Array.isArray(ch.sections) && ch.sections.length) continue;\n182\t      console.log(`[opus] sections for part ${part.n} ch ${ch.n}: ${ch.title}`);\n183\t      const spec = await jsonCall(\n184\t        `sections:p${part.n}c${ch.n}`,\n185\t        prompt(\"vampire_chapter_sections\"),\n186\t        [\n187\t          `## Book\\n${JSON.stringify({ title: outline.title, metaphor: outline.metaphor, arc: outline.arc }).slice(0, 1500)}`,\n188\t          `## Part ${part.n}: ${part.title} — ${part.theme}`,\n189\t          `## Chapter (write sections for THIS one)\\n${JSON.stringify({ part: part.n, chapter: ch.n, title: ch.title, brief: ch.brief, projects: ch.projects, motifs: ch.motifs })}`,\n190\t          `## Evidence available\\n${foundationDigest().slice(0, 3000)}`\n191\t        ].join(\"\\n\\n\"),\n192\t        1400,\n193\t        \"sections\",\n194\t        3\n195\t      );\n196\t      if (spec?.sections?.length) {\n197\t        // Section ids become filenames — never let a missing id collide.\n198\t        ch.sections = spec.sections.map((s, i) => ({\n199\t          ...s,\n200\t          id: s.id || `p${part.n}c${ch.n}s${i + 1}`\n201\t        }));\n202\t        fs.writeFileSync(outlinePath, JSON.stringify(outline, null, 2));\n203\t      } else {\n204\t        console.log(\n205\t          `[opus] WARN sections for p${part.n}c${ch.