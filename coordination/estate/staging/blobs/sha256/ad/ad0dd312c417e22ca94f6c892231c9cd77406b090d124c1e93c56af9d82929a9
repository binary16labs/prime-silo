s with more nodes than this render with the\n36\t// free-floating force graph (the \"Memo-Ray drilldown\" look); smaller ones use\n37\t// the calmer layered SVG. Tunable per-call via props.forceThreshold.\n38\tconst DEFAULT_FORCE_THRESHOLD = 60;\n39\t\n40\tconst HTML_ESCAPES = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" };\n41\tfunction escapeHtml(text) {\n42\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n43\t}\n44\t\n45\t// Memo-Ray organic palette, by node type.\n46\tconst NODE_TYPE_COLORS = {\n47\t  Session: \"#c4a882\",\n48\t  \"User Input\": \"#c4a882\",\n49\t  Thought: \"#9caf88\",\n50\t  Message: \"#8a9aa4\",\n51\t  \"Tool Call\": \"#6b8068\",\n52\t  \"Tool Result\": \"#6b8068\",\n53\t  Artifact: \"#8a9aa4\",\n54\t  default: \"#6b7378\"\n55\t};\n56\t\n57\tconst BAND_WIDTH = 150;\n58\tconst BAND_GAP = 40;\n59\tconst ROW_GAP = 26;\n60\tconst NODE_RADIUS = 7;\n61\tconst ARTIFACT_W = 90;\n62\tconst ARTIFACT_H = 22;\n63\tconst TOP_PADDING = 30;\n64\tconst LEFT_PADDING = 24;\n65\tconst SVG_MIN_HEIGHT = 260;\n66\t\n67\tfunction ensureClient(options) {\n68\t  if (options && options.memorayClient) {\n69\t    return options.memorayClient;\n70\t  }\n71\t  return { memorayFetch, readMemorayJson };\n72\t}\n73\t\n74\tfunction colorFor(type) {\n75\t  return NODE_TYPE_COLORS[type] || NODE_TYPE_COLORS.default;\n76\t}\n77\t\n78\tfunction isArtifact(node) {\n79\t  return node && node.type === \"Artifact\";\n80\t}\n81\t\n82\tfunction nodeLabel(node) {\n83\t  if (!node) return \"(node)\";\n84\t  return node.label || node.metadata?.fileName || node.type || node.id || \"(node)\";\n85\t}\n86\t\n87\t/**\n88\t * Compute a depth-layered layout from {nodes, links}.\n89\t *\n90\t * Depth is the BFS distance from the root (the session node, or the node\n91\t * with no incoming link). Nodes at the same depth stack vertically. Returns\n92\t * { positions: {id: {x,y,node,depth}}, edges: [{source,target}], width,\n93\t * height }. Robust to cycles and orphan nodes (orphans land at depth 0).\n94\t */\n95\texport function computeLayout(nodes, links) {\n96\t  const safeNodes = Array.isArray(nodes) ? nodes : [];\n97\t  const safeLinks = Array.isArray(links) ? links : [];\n98\t  const byId = new Map(safeNodes.map((n) => [n.id, n]));\n99\t\n100\t  // Build adjacency + indegree.\n101\t  const children = new Map();\n102\t  const indegree = new Map();\n103\t  for (const n of safeNodes) indegree.set(n.id, 0);\n104\t  for (const link of safeLinks) {\n105\t    const source = typeof link.source === \"object\" ? link.source.id : link.source;\n106\t    const target = typeof link.target === \"object\" ? link.target.id : link.target;\n107\t    if (!byId.has(source) || !byId.has(target)) continue;\n108\t    if (!children.has(source)) children.set(source, []);\n109\t    children.get(source).push(target);\n110\t    indegree.set(target, (indegree.get(target) || 0) + 1);\n111\t  }\n112\t\n113\t  // Roots = indegree 0 (sessions, orphans). BFS to assign depth.\n114\t  const depth = new Map();\n115\t  const queue = [];\n116\t  for (const n of safeNodes) {\n117\t    if ((indegree.get(n.id) || 0) === 0) {\n118\t      depth.set(n.id, 0);\n119\t      queue.push(n.id);\n120\t    }\n121\t  }\n122\t  // Fallback: if every node has an incoming link (pure cycle), seed first node.\n123\t  if (queue.length === 0 && safeNodes.length > 0) {\n124\t    depth.set(safeNodes[0].id, 0);\n125\t    queue.push(safeNodes[0].id);\n126\t  }\n127\t  const visited = new Set(queue);\n128\t  while (queue.length > 0) {\n129\t    const id = queue.shift();\n130\t    const d = depth.get(id) || 0;\n131\t    for (const childId of children.get(id) || []) {\n132\t      const candidate = d + 1;\n133\t      if (!depth.has(childId) || candidate > depth.get(childId)) {\n134\t        depth.set(childId, candidate);\n135\t      }\n136\t      if (!visited.has(childId)) {\n137\t        visited.add(childId);\n138\t        queue.push(childId);\n139\t      }\n140\t    }\n141\t  }\n142\t\n143\t  // Any node never reached (disconnected) → depth 0.\n144\t  for (const n of safeNodes) {\n145\t    if (!depth.has(n.id)) depth.set(n.id, 0);\n146\t  }\n147\t\n148\t  // Bucket by depth, stack.\n149\t  const bands = new Map();\n150\t  for (const n of safeNodes) {\n151\t    const d = depth.get(n.id);\n152\t    if (!bands.has(d)) bands.set(d, []);\n153\t    bands.get(d).push(n);\n154\t  }\n155\t\n156\t  const positions = {};\n157\t  let maxRows = 0;\n158\t  for (const [d, bucket] of bands) {\n159\t    bucket.sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));\n160\t    if (bucket.length > maxRows) maxRows = bucket.length;\n161\t    bucket.forEach((node, row) => {\n162\t      positions[node.id] = {\n163\t        x: LEFT_PADDING + d * (BAND_WIDTH + BAND_GAP),\n164\t        y: TOP_PADDING + row * ROW_GAP,\n165\t        depth: d,\n166\t        node\n167\t      };\n168\t    });\n169\t  }\n170\t\n171\t  const edges = [];\n172\t  for (const link of safeLinks) {\n173\t    const source = typeof link.source === \"object\" ? link.source.id : link.source;\n174\t    const target = typeof link.target === \"object\" ? link.target.id : link.target;\n175\t    if (positions[source] && positions[target]) {\n176\t      edges.push({ source, target });\n177\t    }\n178\t  }\n179\t\n180\t  const maxDepth = bands.size > 0 ? Math.max(...bands.keys()) : 0;\n181\t  const width = LEFT_PADDING * 2 + (maxDepth + 1) * (BAND_WIDTH + BAND_GAP);\n182\t  const height = Math.max(SVG_MIN_HEIGHT, TOP_PADDING * 2 + maxRows * ROW_GAP);\n183\t\n184\t  return { positions, edges, width, height };\n185\t}\n186\t\n187\t/* ── default 2D SVG renderer ─────────────────────────────────────────── */\n188\t\n189\tfunction createDefaultRenderer() {\n190\t  let svg = null;\n191\t  let onSelect = null;\n192\t\n193\t  function mount(hostEl, layout, props) {\n194\t    onSelect = props && props.onSelect;\n195\t    svg = document.createElementNS(SVG_NS, \"svg\");\n196\t    svg.setAttribute(\"class\", \"mray-lg__svg\");\n197\t    hostEl.appendChild(svg);\n198\t    update(layout, props);\n199\t    return { update, dispose };\n200\t  }\n201\t\n202\t  function highlightIdSet(props) {\n203\t    const ids = [];\n204\t    if (props && Array.isArray(props.highlightIds)) ids.push(...props.highlightIds);\n205\t    if (props && Array.isArray(props.highlightNodeIds)) ids.push(...props.highlightNodeIds);\n206\t    return new Set(ids.filter(Boolean).map(String));\n207\t  }\n208\t\n209\t  function update(layout, props) {\n210\t    if (!svg) return;\n211\t    onSelect = (props && props.onSelect) || onSelect;\n212\t    const hot = highlightIdSet(props);\n213\t    const track = Boolean(props && props.track);\n214\t    let firstHotEl = null;\n215\t    const { positions, edges, width, height } = layout;\n216\t    svg.setAttribute(\"viewBox\", `0 0 ${width} ${height}`);\n217\t    svg.setAttribute(\"width\", String(width));\n218\t    svg.setAttribute(\"height\", String(height));\n219\t    while (svg.firstChild) svg.removeChild(svg.firstChild);\n220\t\n221\t    // edges first (under nodes)\n222\t    for (const edge of edges) {\n223\t      const a = positions[edge.source];\n224\t      const b = positions[edge.target];\n225\t      if (!a || !b) continue;\n226\t      const line = document.createElementNS(SVG_NS, \"line\");\n227\t      line.setAttribute(\"x1\", String(a.x));\n228\t      line.setAttribute(\"y1\", String(a.y));\n229\t      line.setAttribute(\"x2\", String(b.x));\n230\t      line.setAttribute(\"y2\", String(b.y));\n231\t      line.setAttribute(\"class\", \"mray-lg__edge\");\n232\t      svg.appendChild(line);\n233\t    }\n234\t\n235\t    // nodes\n236\t    for (const pos of Object.values(positions)) {\n237\t      const node = pos.node;\n238\t      const color = colorFor(node.type);\n239\t      const group = document.createElementNS(SVG_NS, \"g\");\n240\t      const isHot = hot.has(String(node.id));\n241\t      group.setAttribute(\"class\", isHot ? \"mray-lg__node is-current\" : \"mray-lg__node\");\n242\t      group.setAttribute(\"tabindex\", \"0\");\n243\t      group.setAttribute(\"role\", \"button\");\n244\t      group.dataset.nodeId = node.id;\n245\t      if (isHot && !firstHotEl) firstHotEl = group;\n246\t      group.setAttribute(\"aria-label\", `${node.type}: ${nodeLabel(node)}`);\n247\t\n248\t      if (isArtifact(node)) {\n249\t        const rect = document.createElementNS(SVG_NS, \"rect\");\n250\t        rect.setAttribute(\"x\", String(pos.x - ARTIFACT_W / 2));\n251\t        rect.setAttribute(\"y\", String(pos.y - ARTIFACT_H / 2));\n252\t        rect.setAttribute(\"width\", String(ARTIFACT_W));\n253\t        rect.setAttribute(\"height\", String(ARTIFACT_H));\n254\t        rect.setAttribute(\"rx\", \"5\");\n255\t        rect.setAttribute(\"fill\", color);\n256\t        rect.setAttribute(\"fill-opacity\", node.metadata?.isVirtual ? \"0.35\" : \"0.7\");\n257\t        rect.setAttribute(\"stroke\", color);\n258\t        group.appendChild(rect);\n259\t      } else {\n260\t        const circle = document.createElementNS(SVG_NS, \"circle\");\n261\t        circle.setAttribute(\"cx\", String(pos.x));\n262\t        circle.setAttribute(\"cy\", String(pos.y));\n263\t        circle.setAttribute(\"r\", String(node.type === \"Session\" ? NODE_RADIUS + 4 : NODE_RADIUS));\n264\t        circle.setAttribute(\"fill\", color);\n265\t        group.appendChild(circle);\n266\t      }\n267\t\n268\t      const text = document.createElementNS(SVG_NS, \"text\");\n269\t      text.setAttribute(\"x\", String(pos.x + (isArtifact(node) ? 0 : NODE_RADIUS + 5)));\n270\t      text.setAttribute(\"y\", String(pos.y + (isArtifact(node) ? 1 : 3)));\n271\t      text.setAttribute(\"class\", \"mray-lg__label\");\n272\t      if (isArtifact(node)) text.setAttribute(\"text-anchor\", \"middle\");\n273\t      const label = nodeLabel(node);\n274\t      text.textContent = label.length > 22 ? `${label.slice(0, 21)}…` : label;\n275\t      group.appendChild(text);\n276\t\n277\t      const select = () => {\n278\t        if (typeof onSelect === \"function\") onSelect(node.id);\n279\t      };\n280\t      group.addEventListener(\"click\", select);\n281\t      group.addEventListener(\"keydown\", (ev) => {\n282\t        if (ev.key === \"Enter\" || ev.key === \" \") {\n283\t          ev.preventDefault();\n284\t          select();\n285\t        }\n286\t      });\n287\t\n288\t      svg.appendChild(group);\n289\t    }\n290\t\n291\t    // Camera-track: scroll the highlighted node into view (Step-Through player).\n292\t    if (track && firstHotEl && typeof firstHotEl.scrollIntoView === \"function\") {\n293\t      firstHotEl.scrollIntoView({ behavior: \"smooth\", block: \"center\", inline: \"center\" });\n294\t    }\n295\t  }\n296\t\n297\t  function dispose() {\n298\t    if (svg && svg.parentNode) svg.parentNode.removeChild(svg);\n299\t    svg = null;\n300\t    onSelect = null;\n301\t  }\n302\t\n303\t  return { mount, update, dispose };\n304\t}\n305\t\n306\t/* ── factory ─────────────────────────────────────────────────────────── */\n307\t\n308\texport function createLineageGraphWidget(host, initialProps = {}, options = {}) {\n309\t  if (!host || typeof host.querySelector !== \"function\") {\n310\t    throw new Error(\"createLineageGraphWidget: host must be an HTMLElement.\");\n311\t  }\n312\t\n313\t  const client = ensureClient(options);\n314\t  let props = { layoutMode: \"linear\", ...initialProps };\n315\t  let aborted = false;\n316\t  let renderer = null;\n317\t  let currentMode = null;\n318\t  let rendererHandle = null;\n319\t  let layout = null;\n320\t  let lastData = null;\n321\t\n322\t  host.classList.add(\"mray-lg\");\n323\t\n324\t  // Props passed down to a renderer: expose the highlight set under BOTH names so\n325\t  // the SVG renderer (highlightIds) and the force renderer (highlightNodeIds) each\n326\t  // find it from one `props.highlightIds`.\n327\t  function rendererProps() {\n328\t    const ids = props.highlightIds || props.highlightNodeIds || [];\n329\t    return { ...props, highlightIds: ids, highlightNodeIds: ids };\n330\t  }\n331\t\n332\t  // Resolve the effective layout for a node count. An explicit options.renderer\n333\t  // always wins (callers that hard-wire a renderer); otherwise layoutMode picks,\n334\t  // with `auto` choosing force above the threshold.\n335\t  function resolveMode(nodeCount) {\n336\t    if (options.renderer) return \"custom\";\n337\t    const mode = props.layoutMode || \"linear\";\n338\t    if (mode === \"force\") return \"force\";\n339\t    if (mode === \"linear\") return \"linear\";\n340\t    const threshold = Number(props.forceThreshold) || DEFAULT_FORCE_THRESHOLD;\n341\t    return nodeCount > threshold ? \"force\" : \"linear\";\n342\t  }\n343\t\n344\t  function chooseRenderer(mode) {\n345\t    if (mode === \"custom\") return options.renderer;\n346\t    if (mode === \"force\") return createForceGraph2DRenderer({ physicsMode: \"fluid\" });\n347\t    return createDefaultRenderer();\n348\t  }\n349\t\n350\t  function renderState(html) {\n351\t    teardownRenderer();\n352\t    host.innerHTML = `<div class=\"mray-lg__state\">${html}</div>`;\n353\t  }\n354\t\n355\t  function teardownRenderer() {\n356\t    if (rendererHandle && typeof rendererHandle.dispose === \"function\") {\n357\t      rendererHandle.dispose();\n358\t    } else if (renderer && typeof renderer.dispose === \"function\") {\n359\t      renderer.dispose();\n360\t    }\n361\t    rendererHandle = null;\n362\t    currentMode = null;\n363\t  }\n364\t\n365\t  function paint(data) {\n366\t    lastData = data;\n367\t    layout = computeLayout(data.nodes, data.links);\n368\t    const mode = resolveMode((data.nodes || []).length);\n369\t    // Swap renderers when the resolved layout changes (e.g. layoutMode toggled,\n370\t    // or an `auto` session crossed the node-count threshold).\n371\t    if (mode !== currentMode) {\n372\t      teardownRenderer();\n373\t      renderer = choo