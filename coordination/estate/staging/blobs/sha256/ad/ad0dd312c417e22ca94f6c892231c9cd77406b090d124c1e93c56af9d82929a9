f.replace(/\\.md$/, \"\"));\n40\t    parts.push(`## Projects with dossiers\\n${dossiers.join(\", \")}`);\n41\t  } catch {\n42\t    /* none yet */\n43\t  }\n44\t  try {\n45\t    const notes = fs\n46\t      .readdirSync(path.join(out, \"discovery\"))\n47\t      .filter((f) => f.endsWith(\".md\"))\n48\t      .map((f) => \"- \" + readIf(path.join(out, \"discovery\", f), 120).split(\"\\n\")[0]);\n49\t    if (notes.length) parts.push(`## Discovery notes\\n${notes.join(\"\\n\")}`);\n50\t  } catch {\n51\t    /* none yet */\n52\t  }\n53\t  return parts.join(\"\\n\\n\");\n54\t}\n55\t\n56\tasync function jsonCall(name, system, user, maxTokens, requiredKey = null, minItems = 1) {\n57\t  // Two attempts. Hard-won constraints on this stack (all ledgered live):\n58\t  // - lemonade's JSON mode (response_format json_object) makes qwen3.5 stop\n59\t  //   mid-object at ~300 tokens and interleave stray scalars (\"parts\": [1,\n60\t  //   {…}]) — while plain-text calls of the same length complete fine. So ask\n61\t  //   for JSON in the prompt and parse it out (lastBalancedJson strips prose).\n62\t  // - Early stops lose the closing braces and lastBalancedJson then finds an\n63\t  //   INNER object: fall back to truncation repair before declaring invalid.\n64\t  // - Validity = the required key holds ≥ minItems real entries (objects with\n65\t  //   a title); stray scalars are filtered out rather than fatal downstream.\n66\t  const normalize = (o) => {\n67\t    if (!o) return null;\n68\t    if (!requiredKey) return o;\n69\t    const v = Array.isArray(o[requiredKey]) ? o[requiredKey] : null;\n70\t    if (!v) return null;\n71\t    const items = v.filter((x) => x && typeof x === \"object\" && typeof x.title === \"string\");\n72\t    return items.length >= minItems ? { ...o, [requiredKey]: items } : null;\n73\t  };\n74\t  let lastHead = \"\";\n75\t  for (let attempt = 0; attempt < 2; attempt++) {\n76\t    const started = Date.now();\n77\t    const feedback =\n78\t      attempt > 0\n79\t        ? `\\n\\nYour previous answer was not valid (${lastHead ? `it began: ${lastHead}` : \"empty\"}). Return ONLY the complete JSON object, nothing else, and keep it compact.`\n80\t        : \"\";\n81\t    const res = await chat({\n82\t      system,\n83\t      user: user + feedback,\n84\t      maxTokens,\n85\t      temperature: attempt === 0 ? 0.5 : 0.3\n86\t    });\n87\t    const parsed =\n88\t      normalize(lastBalancedJson(res.content)) ?? normalize(repairTruncatedJson(res.content));\n89\t    appendLedger({\n90\t      phase: \"opus\",\n91\t      artifact: name,\n92\t      ms: Date.now() - started,\n93\t      prompt_tokens: res.prompt_tokens,\n94\t      completion_tokens: res.completion_tokens,\n95\t      attempt,\n96\t      ok: Boolean(parsed)\n97\t    });\n98\t    if (parsed) return parsed;\n99\t    lastHead = res.content.slice(0, 120).replace(/\\s+/g, \" \");\n100\t    console.log(`[opus] ${name} attempt ${attempt + 1} invalid — head: ${lastHead}`);\n101\t  }\n102\t  return null;\n103\t}\n104\t\n105\tasync function buildOutline(interrupted) {\n106\t  const outlinePath = opusDir(\"outline.json\");\n107\t  const realParts = (o) =>\n108\t    Array.isArray(o?.parts)\n109\t      ? o.parts.filter((p) => p && typeof p === \"object\" && typeof p.title === \"string\")\n110\t      : [];\n111\t  let outline = null;\n112\t  try {\n113\t    outline = JSON.parse(fs.readFileSync(outlinePath, \"utf8\"));\n114\t    // A previous run may have persisted a degenerate outline (stray scalars in\n115\t    // parts, or a single salvaged part) — rebuild rather than resume garbage.\n116\t    const parts = realParts(outline);\n117\t    if (parts.length >= 3) outline.parts = parts;\n118\t    else outline = null;\n119\t  } catch {\n120\t    /* build it */\n121\t  }\n122\t  if (!outline) {\n123\t    // Parts only — a full 14-18 chapter outline overflows the output budget\n124\t    // and truncates into unparseable JSON (seen live). Hierarchy all the way:\n125\t    // parts → chapters-per-