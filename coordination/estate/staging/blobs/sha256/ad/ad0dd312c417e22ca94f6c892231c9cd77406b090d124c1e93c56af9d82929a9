 (const [key, label] of pairs) {\n75\t    const v = c[key];\n76\t    const n = Array.isArray(v) ? v.length : v;\n77\t    if (typeof n === \"number\" && n > 0) chips.push(`+${n} ${label}`);\n78\t  }\n79\t  return chips;\n80\t}\n81\t\n82\t// The pieces of a ledger entry worth showing verbatim, in a stable order, with the\n83\t// noisy/huge fields stripped so the content pane stays a calm read.\n84\tconst CONTENT_HIDE = new Set([\n85\t  \"action\",\n86\t  \"phase\",\n87\t  \"status\",\n88\t  \"ok\",\n89\t  \"ts\",\n90\t  \"ms\",\n91\t  \"prompt_tokens\",\n92\t  \"completion_tokens\",\n93\t  \"gate_errors\"\n94\t]);\n95\t\n96\tfunction contentBody(action) {\n97\t  const c = (action && action.content) || {};\n98\t  const lines = [];\n99\t  for (const [k, v] of Object.entries(c)) {\n100\t    if (CONTENT_HIDE.has(k)) continue;\n101\t    if (v == null || v === \"\") continue;\n102\t    let rendered;\n103\t    if (Array.isArray(v))\n104\t      rendered = v.length > 12 ? `${v.slice(0, 12).join(\", \")} … (${v.length})` : v.join(\", \");\n105\t    else if (typeof v === \"object\") rendered = JSON.stringify(v);\n106\t    else rendered = String(v);\n107\t    if (rendered.length > 600) rendered = `${rendered.slice(0, 600)}…`;\n108\t    lines.push(`${k}: ${rendered}`);\n109\t  }\n110\t  return lines.join(\"\\n\");\n111\t}\n112\t\n113\tfunction bennyRecordPage() {\n114\t  return {\n115\t    state: \"loading\", // loading | ready | empty | error\n116\t    error: \"\",\n117\t    scope: \"run\",\n118\t    workspace: \"\",\n119\t    actions: [],\n120\t    lineage: { nodes: [], links: [] },\n121\t    stepIndex: 0,\n122\t    showWhy: false,\n123\t    isPlaying: false,\n124\t    speed: 2,\n125\t    showMap: true,\n126\t    tracking: true,\n127\t    graphMode: \"auto\",\n128\t    live: false,\n129\t    heartbeat: null,\n130\t    runConfig: null,\n131\t    _ledgerSince: 0,\n132\t    _graph: null,\n133\t    _playTimer: null,\n134\t    _liveTimer: null,\n135\t    _keyHandler: null,\n136\t\n137\t    async init() {\n138\t      const q = readQuery();\n139\t      this.scope = q.scope || \"run\";\n140\t      this.workspace = q.workspace || \"\";\n141\t      this.live = q.live === \"1\" || q.live === \"true\";\n142\t      await this.loadRecord();\n143\t      this._keyHandler = (e) => this.onKey(e);\n144\t      window.addEventListener(\"keydown\", this._keyHandler);\n145\t    },\n146\t\n147\t    recordUrl() {\n148\t      const p = new URLSearchParams({ scope: this.scope });\n149\t      if (this.workspace) p.set(\"workspace\", this.workspace);\n150\t      return `/api/longview_record?${p.toString()}`;\n151\t    },\n152\t\n153\t    async loadRecord({ keepStep = false } = {}) {\n154\t      if (!keepStep) this.state = \"loading\";\n155\t      try {\n156\t        const res = await fetch(this.recordUrl(), { credentials: \"same-origin\" });\n157\t        if (!res.ok) throw new Error(`record ${res.status}`);\n158\t        const body = await res.json();\n159\t        if (body && body.error) throw new Error(body.detail || body.error);\n160\t        const rec = body.record || {};\n161\t        this.actions = Array.isArray(rec.actions) ? rec.actions : [];\n162\t        this.workspace = rec.workspace || this.workspace;\n163\t        this.lineage =\n164\t          body.lineage && Array.isArray(body.lineage.nodes)\n165\t            ? body.lineage\n166\t            : { nodes: [], links: [] };\n167\t        this.runConfig =\n168\t          (this.actions.find((a) => a.content && a.content.action === \"run_config\") || {})\n169\t            .content || null;\n170\t        if (this.actions.length === 0) {\n171\t          this.state = \"empty\";\n172\t          return;\n173\t        }\n174\t        this.state = \"ready\";\n175\t        if (!keepStep || this.stepIndex >= this.actions.length) {\n176\t          this.stepIndex = this.actions.length - 1; // land on the newest step\n177\t        }\n178\t        this.$nextTick(() => {\n179\t          this.mountGraph();\n180\t          th