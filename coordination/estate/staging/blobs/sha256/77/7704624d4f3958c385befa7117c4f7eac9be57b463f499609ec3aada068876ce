n.get(\"T0_SMOKE_DIR\", ROOT / \"scripts\" / \"train\" / \"smoke\" / \"out\"))\n39\t\n40\tTARGET_ARCH = \"gfx1200\"          # RX 9060 XT / RDNA4\n41\tMIN_VRAM_GIB = 15.0              # ~16 GB card, allow headroom for reserved/reported delta\n42\tMIN_STEPS = 30                   # the contract's ~30-step smoke\n43\t\n44\t\n45\tdef _fail(reason: str, detail: str = \"\") -> int:\n46\t    print(f\"[t0] reason={reason}{(' — ' + detail) if detail else ''}\")\n47\t    print(\"[t0] GATE RED\")\n48\t    return 1\n49\t\n50\t\n51\tdef _run(cmd: list) -> str:\n52\t    \"\"\"Run a probe tool, return combined stdout (empty string if it can't run).\"\"\"\n53\t    exe = shutil.which(cmd[0])\n54\t    if not exe:\n55\t        return \"\"\n56\t    try:\n57\t        p = subprocess.run(\n58\t            [exe, *cmd[1:]], capture_output=True, text=True, timeout=60,\n59\t            errors=\"replace\",\n60\t        )\n61\t        return (p.stdout or \"\") + \"\\n\" + (p.stderr or \"\")\n62\t    except (subprocess.SubprocessError, OSError):\n63\t        return \"\"\n64\t\n65\t\n66\tdef probe_gpu() -> dict | None:\n67\t    \"\"\"Return {tool, arch, vram_gib, raw} if a compute device reports gfx1200, else None.\"\"\"\n68\t    # hipInfo: 'gcnArchName:  gfx1200' + 'totalGlobalMem:  NNNN' (bytes or MB, varies)\n69\t    out = _run([\"hipInfo\"])\n70\t    if TARGET_ARCH in out:\n71\t        vram = _vram_from_bytes(re.search(r\"totalGlobalMem:\\s*([0-9]+)\", out))\n72\t        return {\"tool\": \"hipInfo\", \"arch\": TARGET_ARCH, \"vram_gib\": vram, \"raw\": out[:2000]}\n73\t\n74\t    # rocminfo: 'Name: gfx1200' + a 'Size: NNNN(KB)' under the GPU agent's global pool\n75\t    out = _run([\"rocminfo\"])\n76\t    if TARGET_ARCH in out:\n77\t        vram = _vram_from_kb(re.search(r\"Size:\\s*([0-9]+)\\(KB\\)\", out))\n78\t        return {\"tool\": \"rocminfo\", \"arch\": TARGET_ARCH, \"vram_gib\": vram, \"raw\": out[:2000]}\n79\t\n80\t    # rocm-smi: product name + VRAM total (MB)\n81\t    out = _run([\"rocm-smi\", \"--showproductname\", \"--showmeminfo\", \"vram\"])\n82\t    if TARGET_ARCH in out or \"9060\" in out:\n83\t        m = re.search(r\"(?:vram|VRAM).*?Total.*?([0-9]+)\\s*(?:MB|MiB)\", out, re.S | re.I)\n84\t        vram = round(int(m.group(1)) / 1024, 1) if m else None\n85\t        return {\"tool\": \"rocm-smi\", \"arch\": TARGET_ARCH, \"vram_gib\": vram, \"raw\": out[:2000]}\n86\t\n87\t    # Fallback: AMD's bundled-runtime ROCm PyTorch wheels ship no HIP SDK CLI\n88\t    # tools, so ask torch itself. torch.cuda under ROCm reports the HIP device.\n89\t    torch_probe = probe_gpu_via_torch()\n90\t    if torch_probe:\n91\t        return torch_probe\n92\t\n93\t    return None\n94\t\n95\t\n96\tdef probe_gpu_via_torch() -> dict | None:\n97\t    \"\"\"Query the training stack's torch for a gfx1200 HIP device.\n98\t\n99\t    Runs in the trainer venv when the gate can't import torch itself — set\n100\t    $T0_VENV_PY, else the default Unsloth venv python is tried.\n101\t    \"\"\"\n102\t    snippet = (\n103\t        \"import json,torch\\n\"\n104\t        \"d=None\\n\"\n105\t        \"if torch.cuda.is_available():\\n\"\n106\t        \" p=torch.cuda.get_device_properties(0)\\n\"\n107\t        \" d={'arch':getattr(p,'gcnArchName','') or '','vram_gib':round(p.total_memory/1024**3,1)}\\n\"\n108\t        \"print(json.dumps(d))\\n\"\n109\t    )\n110\t    pys = [sys.executable,\n111\t           os.environ.get(\"T0_VENV_PY\", \"\"),\n112\t           str(Path.home() / \".unsloth\" / \"studio\" / \"unsloth_studio\" / \"Scripts\" / \"python.exe\")]\n113\t    for py in pys:\n114\t        if not py or not Path(py).exists():\n115\t            continue\n116\t        try:\n117\t            p = subprocess.run([py, \"-c\", snippet], capture_output=True, text=True, timeout=120)\n118\t        except (subprocess.SubprocessError, OSError):\n119\t            continue\n120\t        line = (p.stdout or \"\").strip().splitlines()[-1:] or [\"\"]\n121\t        try:\n122\t            info