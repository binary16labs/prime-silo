apter_dir\") or (SMOKE_DIR / \"adapter\"))\n165\t    if not adir.is_absolute():\n166\t        adir = (SMOKE_DIR / adir).resolve()\n167\t    if not (adir / \"adapter_config.json\").is_file():\n168\t        return False, \"adapter_missing\", {\"adapter_dir\": str(adir)}\n169\t    weights = list(adir.glob(\"adapter_model.safetensors\")) + list(adir.glob(\"adapter_model.bin\"))\n170\t    if not weights or weights[0].stat().st_size == 0:\n171\t        return False, \"adapter_missing\", {\"adapter_dir\": str(adir)}\n172\t    if not _adapter_reloads(weights[0]):\n173\t        return False, \"adapter_unloadable\", {\"adapter\": str(weights[0])}\n174\t\n175\t    return True, \"\", {\n176\t        \"base_model\": data.get(\"base_model\"),\n177\t        \"rocm_build\": data.get(\"rocm_build\"),\n178\t        \"steps\": steps,\n179\t        \"final_loss\": data.get(\"final_loss\", loss[-1]),\n180\t        \"first_loss\": loss[0],\n181\t        \"adapter\": str(weights[0]),\n182\t    }\n183\t\n184\t\n185\tdef _adapter_reloads(weights: Path) -> bool:\n186\t    \"\"\"Best-effort structural reload: open the safetensors header / torch load.\n187\t\n188\t    Passes on file integrity when the libs aren't present, so the gate doesn't\n189\t    demand torch on the probe box; a real load is exercised by the smoke itself.\n190\t    \"\"\"\n191\t    if weights.suffix == \".safetensors\":\n192\t        try:\n193\t            from safetensors import safe_open  # type: ignore\n194\t\n195\t            with safe_open(str(weights), framework=\"pt\") as f:\n196\t                return len(f.keys()) > 0\n197\t        except ImportError:\n198\t            # No safetensors lib here — verify the header length prefix is sane.\n199\t            try:\n200\t                with weights.open(\"rb\") as fh:\n201\t                    n = int.from_bytes(fh.read(8), \"little\")\n202\t                    return 0 < n < weights.stat().st_size\n203\t            except OSError:\n204\t                return False\