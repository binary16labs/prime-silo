{"parentUuid":"888bc570-eb31-4675-8597-5172ffbff1d7","isSidechain":false,"promptId":"46a3cdce-084f-4f82-9f1d-125dc9054afc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bwmdyfd9qxQc32hs1Up98X","type":"tool_result","content":"1\t#!/usr/bin/env node\n2\t//\n3\t// ADR-001 Phase C follow-up — three-renderer drop-in.\n4\t//\n5\t// Renders into a fake DOM host (the renderer never reaches DOM APIs\n6\t// outside `host.innerHTML` and `host.querySelector` existence checks).\n7\t// The `3d-force-graph` lib is stubbed via `options.loader` so this\n8\t// node-runner test never touches the CDN.\n9\t\n10\timport assert from \"node:assert/strict\";\n11\t\n12\timport {\n13\t  createThreeRenderer,\n14\t  layoutToGraphData,\n15\t  nodeMatchesProps,\n16\t  __testing\n17\t} from \"../app/L0/_all/mod/_prime_silo/widgets/three_renderer/index.js\";\n18\t\n19\tasync function main() {\n20\t  // layoutToGraphData — pure normaliser. No DOM, no async.\n21\t  testLayoutToGraphDataEmpty();\n22\t  testLayoutToGraphDataKg3dShape();\n23\t  testLayoutToGraphDataCodegraphShape();\n24\t  testLayoutToGraphDataDropsEdgesWithMissingEnds();\n25\t  testLayoutToGraphDataPinsXYAsFxFy();\n26\t  testLayoutToGraphDataFluidSeedsXY();\n27\t  testLayoutToGraphDataCoercesEdgeIdsToStrings();\n28\t  testLayoutToGraphDataCarriesOriginalNode();\n29\t\n30\t  // createThreeRenderer — factory + mount + lazy-load lifecycle.\n31\t  testFactoryReturnsMountShape();\n32\t  testFactoryIsLazyAndDoesNotCallLoader();\n33\t  await testMountReturnsSyncHandle();\n34\t  await testMountCallsLoaderAndAppliesData();\n35\t  await testUpdateAfterLoadAppliesData();\n36\t  await testUpdateBeforeLoadIsReplayedOnActivation();\n37\t  await testDisposeBeforeLoadCancelsActivation();\n38\t  await testDisposeAfterLoadCallsDestructor();\n39\t  await testLoaderErrorPaintsInlineError();\n40\t  await testLoaderReturnsNonFunctionPaintsInlineError();\n41\t  await testOnNodeClickWiresThrough();\n42\t  await testMultipleMountsAreIndependent();\n43\t  testMountRejectsBadHost();\n44\t\n45\t  // Filters (focusedLayer) — node/link visibility predicates.\n46\t  testNodeMatchesProps();\n47\t  await testFocusedLayerAppliesVisibility();\n48\t\n49\t  console.log(\"widgets_three_renderer_test: ok\");\n50\t}\n51\t\n52\t// ---------------------------------------------------------------------------\n53\t// Fixtures\n54\t// ---------------------------------------------------------------------------\n55\t\n56\tfunction fakeHost() {\n57\t  const host = {\n58\t    innerHTML: \"\",\n59\t    classList: { add() {}, remove() {} },\n60\t    querySelector() {\n61\t      return null;\n62\t    },\n63\t    addEventListener() {},\n64\t    removeEventListener() {}\n65\t  };\n66\t  return host;\n67\t}\n68\t\n69\tfunction stubForceGraph3D() {\n70\t  // Mirrors 3d-force-graph's curried/fluent API. The instance records\n71\t  // every call so tests can assert on the wire shape.\n72\t  const instance = {\n73\t    _calls: [],\n74\t    _destroyed: false,\n75\t    backgroundColor(...args) {\n76\t      this._calls.push([\"backgroundColor\", args]);\n77\t      return this;\n78\t    },\n79\t    nodeRelSize(...args) {\n80\t      this._calls.push([\"nodeRelSize\", args]);\n81\t      return this;\n82\t    },\n83\t    nodeColor(...args) {\n84\t      this._calls.push([\"nodeColor\", args]);\n85\t      return this;\n86\t    },\n87\t    linkColor(...args) {\n88\t      this._calls.push([\"linkColor\", args]);\n89\t      return this;\n90\t    },\n91\t    onNodeClick(...args) {\n92\t      this._calls.push([\"onNodeClick\", args]);\n93\t      return this;\n94\t    },\n95\t    graphData(...args) {\n96\t      this._calls.push([\"graphData\", args]);\n97\t      return this;\n98\t    },\n99\t    _destructor() {\n100\t      this._destroyed = true;\n101\t    }\n102\t  };\n103\t  // The lib exports a factory of the form ForceGraph3D() returns a\n104\t  // function that takes the dom element and returns the instance.\n105\t  const ForceGraph3D = () => (host) => {\n106\t    instance._host = host;\n107\t    return instance;\n108\t  };\n109\t  ForceGraph3D._instance = instance;\n110\t  return ForceGraph3D;\n111\t}\n112\t\n113\t// Flush ALL pending microtasks. The renderer's activation chain is\n114\t// `Promise.resolve().then(loader).then(activate)`, so it takes several\n115\t// microtasks to drain; setTimeout(0) yields to the macrotask queue which\n116\t// only runs after every microtask is done.\n117\tfunction flushAsync() {\n118\t  return new Promise((resolve) => setTimeout(resolve, 0));\n119\t}\n120\t\n121\tfunction delayedLoader(ForceGraph3D) {\n122\t  // Resolves the loader on the next microtask so we can interleave\n123\t  // mount → update → dispose calls with the load lifecycle.\n124\t  let resolve;\n125\t  const promise = new Promise((r) => {\n126\t    resolve = r;\n127\t  });\n128\t  return {\n129\t    loader: () => promise,\n130\t    flush() {\n131\t      resolve(ForceGraph3D);\n132\t      return promise;\n133\t    }\n134\t  };\n135\t}\n136\t\n137\tfunction kg3dLayout() {\n138\t  return {\n139\t    positions: {\n140\t      neural_nets: {\n141\t        x: 100,\n142\t        y: 50,\n143\t        radius: 12,\n144\t        layer: 1,\n145\t        color: \"#a78bfa\",\n146\t        node: { id: \"neural_nets\", canonical_name: \"Neural networks\" }\n147\t      },\n148\t      backprop: {\n149\t        x: 200,\n150\t        y: 140,\n151\t        radius: 8,\n152\t        layer: 3,\n153\t        color: \"#22d3ee\",\n154\t        node: { id: \"backprop\" }\n155\t      }\n156\t    },\n157\t    edges: [\n158\t      { id: \"e1\", source: \"neural_nets\", target: \"backprop\", kind: \"prerequisite\", weight: 0.9 }\n159\t    ],\n160\t    width: 720,\n161\t    height: 480\n162\t  };\n163\t}\n164\t\n165\tfunction codegraphLayout() {\n166\t  return {\n167\t    positions: {\n168\t      \"/src/foo.py\": {\n169\t        x: 50,\n170\t        y: 30,\n171\t        radius: 6,\n172\t        type: \"File\",\n173\t        color: \"#00FFFF\",\n174\t        node: { id: \"/src/foo.py\", type: \"File\", path: \"/src/foo.py\" }\n175\t      },\n176\t      \"Foo.bar\": {\n177\t        x: 200,\n178\t        y: 60,\n179\t        radius: 6,\n180\t        type: \"Function\",\n181\t        color: \"#FF5F1F\",\n182\t        node: { id: \"Foo.bar\", type: \"Function\" }\n183\t      }\n184\t    },\n185\t    edges: [{ id: \"e1\", source: \"/src/foo.py\", target: \"Foo.bar\", type: \"DEFINES\" }]\n186\t  };\n187\t}\n188\t\n189\t// ---------------------------------------------------------------------------\n190\t// layoutToGraphData\n191\t// ---------------------------------------------------------------------------\n192\t\n193\tfunction testLayoutToGraphDataEmpty() {\n194\t  assert.deepEqual(layoutToGraphData(null), { nodes: [], links: [] });\n195\t  assert.deepEqual(layoutToGraphData({}), { nodes: [], links: [] });\n196\t  assert.deepEqual(layoutToGraphData({ positions: {}, edges: [] }), { nodes: [], links: [] });\n197\t}\n198\t\n199\tfunction testLayoutToGraphDataKg3dShape() {\n200\t  const out = layoutToGraphData(kg3dLayout());\n201\t  assert.equal(out.nodes.length, 2);\n202\t  const byId = Object.fromEntries(out.nodes.map((n) => [n.id, n]));\n203\t  assert.equal(byId.neural_nets.color, \"#a78bfa\");\n204\t  assert.equal(byId.neural_nets.val, 12);\n205\t  assert.equal(byId.neural_nets.layer, 1);\n206\t  assert.equal(byId.backprop.layer, 3);\n207\t  // kg3d carries no `type`, so neither should the graph node.\n208\t  assert.equal(\"type\" in byId.neural_nets, false);\n209\t  assert.equal(out.links.length, 1);\n210\t  assert.equal(out.links[0].kind, \"prerequisite\");\n211\t  assert.equal(out.links[0].weight, 0.9);\n212\t  // codegraph-style `type` is absent.\n213\t  assert.equal(\"type\" in out.links[0], false);\n214\t}\n215\t\n216\tfunction testLayoutToGraphDataCodegraphShape() {\n217\t  const out = layoutToGraphData(codegraphLayout());\n218\t  assert.equal(out.nodes.length, 2);\n219\t  const byId = Object.fromEntries(out.nodes.map((n) => [n.id, n]));\n220\t  assert.equal(byId[\"/src/foo.py\"].type, \"File\");\n221\t  assert.equal(byId[\"Foo.bar\"].type, \"Function\");\n222\t  assert.equal(out.links.length, 1);\n223\t  assert.equal(out.links[0].type, \"DEFINES\");\n224\t  // kg3d-style `kind` and `weight` are absent.\n225\t  assert.equal(\"kind\" in out.links[0], false);\n226\t  assert.equal(\"weight\" in out.links[0], false);\n227\t}\n228\t\n229\tfunction testLayoutToGraphDataDropsEdgesWithMissingEnds() {\n230\t  const out = layoutToGraphData({\n231\t    positions: { a: { x: 0, y: 0, color: \"#fff\" } },\n232\t    edges: [\n233\t      { source: \"a\", target: \"b\" }, // kept — normaliser doesn't reach into positions for validity\n234\t      { source: \"a\" }, // dropped — no target\n235\t      { target: \"b\" }, // dropped — no source\n236\t      { source: null, target: \"b\" }, // dropped — null source\n237\t      null // dropped — null edge\n238\t    ]\n239\t  });\n240\t  // The renderer's job is to forward what it's given; positional validity\n241\t  // is the widget's contract. But we DO drop edges that can't even form a\n242\t  // link record. So only the first survives.\n243\t  assert.equal(out.links.length, 1);\n244\t  assert.equal(out.links[0].source, \"a\");\n245\t  assert.equal(out.links[0].target, \"b\");\n246\t}\n247\t\n248\tfunction testLayoutToGraphDataPinsXYAsFxFy() {\n249\t  // 2D layout coordinates seed the 3D solver via fx/fy. Without this, the\n250\t  // 3D scene would lose the AoT-layer / type-band grouping that makes the\n251\t  // 2D fallback legible.\n252\t  const out = layoutToGraphData(kg3dLayout());\n253\t  const neural = out.nodes.find((n) => n.id === \"neural_nets\");\n254\t  assert.equal(neural.fx, 100);\n255\t  assert.equal(neural.fy, 50);\n256\t}\n257\t\n258\tfunction testLayoutToGraphDataFluidSeedsXY() {\n259\t  // When physicsMode is \"fluid\", nodes should not be pinned (fx/fy are undefined),\n260\t  // but instead have initial x/y coordinates seeded.\n261\t  const out = layoutToGraphData(kg3dLayout(), \"fluid\");\n262\t  const neural = out.nodes.find((n) => n.id === \"neural_nets\");\n263\t  assert.equal(neural.fx, undefined);\n264\t  assert.equal(neural.fy, undefined);\n265\t  assert.equal(neural.x, 100);\n266\t  assert.equal(neural.y, 50);\n267\t}\n268\t\n269\tfunction testLayoutToGraphDataCoercesEdgeIdsToStrings() {\n270\t  // Codegraph IDs are sometimes numeric (Neo4j internal ids). Force them\n271\t  // to strings so they line up with the node ids the normaliser emits.\n272\t  const out = layoutToGraphData({\n273\t    positions: { 42: { x: 0, y: 0 } },\n274\t    edges: [{ source: 42, target: \"42\" }]\n275\t  });\n276\t  assert.equal(out.links[0].source, \"42\");\n277\t  assert.equal(out.links[0].target, \"42\");\n278\t}\n279\t\n280\tfunction testLayoutToGraphDataCarriesOriginalNode() {\n281\t  const out = layoutToGraphData(codegraphLayout());\n282\t  const fn = out.nodes.find((n) => n.id === \"Foo.bar\");\n283\t  assert.equal(fn._original.type, \"Function\");\n284\t}\n285\t\n286\t// ---------------------------------------------------------------------------\n287\t// Factory + mount lifecycle\n288\t// ---------------------------------------------------------------------------\n289\t\n290\tfunction testFactoryReturnsMountShape() {\n291\t  const r = createThreeRenderer({ loader: () => Promise.resolve(stubForceGraph3D()) });\n292\t  assert.equal(typeof r.mount, \"function\");\n293\t}\n294\t\n295\tfunction testFactoryIsLazyAndDoesNotCallLoader() {\n296\t  let called = 0;\n297\t  createThreeRenderer({\n298\t    loader: () => {\n299\t      called += 1;\n300\t      return Promise.resolve(stubForceGraph3D());\n301\t    }\n302\t  });\n303\t  assert.equal(called, 0, \"factory must not call loader at construction\");\n304\t}\n305\t\n306\tasync function testMountReturnsSyncHandle() {\n307\t  const ForceGraph3D = stubForceGraph3D();\n308\t  const { loader, flush } = delayedLoader(ForceGraph3D);\n309\t  const r = createThreeRenderer({ loader });\n310\t  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n311\t  // Handle MUST be synchronous so widgets can assign it to rendererHandle\n312\t  // without await.\n313\t  assert.equal(typeof handle.update, \"function\");\n314\t  assert.equal(typeof handle.dispose, \"function\");\n315\t  // Loader runs but hasn't resolved yet — no calls on the instance.\n316\t  await flushAsync();\n317\t  assert.equal(ForceGraph3D._instance._calls.length, 0);\n318\t  handle.dispose();\n319\t  await flush().catch(() => {}); // unblock the promise chain to avoid unhandled-rejection noise\n320\t  await flushAsync();\n321\t}\n322\t\n323\tasync function testMountCallsLoaderAndAppliesData() {\n324\t  let calls = 0;\n325\t  const ForceGraph3D = stubForceGraph3D();\n326\t  const r = createThreeRenderer({\n327\t    loader: () => {\n328\t      calls += 1;\n329\t      return Promise.resolve(ForceGraph3D);\n330\t    }\n331\t  });\n332\t  const host = fakeHost();\n333\t  r.mount(host, kg3dLayout(), {});\n334\t  // Wait for the load promise + the internal then chain to flush.\n335\t  await flushAsync();\n336\t  assert.equal(calls, 1, \"loader must be called exactly once\");\n337\t  const inst = ForceGraph3D._instance;\n338\t  const methods = inst._calls.map((c) => c[0]);\n339\t  assert.ok(methods.includes(\"backgroundColor\"));\n340\t  assert.ok(methods.includes(\"nodeRelSize\"));\n341\t  assert.ok(methods.includes(\"nodeColor\"));\n342\t  assert.ok(methods.includes(\"linkColor\"));\n343\t  // graphData must have been called with the normalised payload.\n344\t  const dataCall = inst._calls.find((c) => c[0] === \"graphData\");\n345\t  assert.ok(dataCall, \"graphData must be called after load\");\n346\t  assert.equal(dataCall[1][0].nodes.length, 2);\n347\t  assert.equal(dataCall[1][0].links.length, 1);\n348\t}\n349\t\n350\tasync function testUpdateAfterLoadAppliesData() {\n351\t  const ForceGraph3D = stubForceGraph3D();\n352\t  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n353\t  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n354\t  await flushAsync();\n355\t  const before = ForceGraph3D._instance._calls.filter((c) => c[0] === \"graphData\").length;\n356\t  handle.update(codegraphLayout(), {});\n357\t  const after = ForceGraph3D._instance._calls.filter((c) => c[0] === \"graphData\").length;\n358\t  assert.equal(after, before + 1, \"update must call graphData once more\");\n359\t}\n360\t\n361\tasync function testUpdateBeforeLoadIsReplayedOnActivation() {\n362\t  // Mount with layout A, immediately update to layout B, THEN let the\n363\t  // loader resolve. The instance must see layout B (the latest), not A.\n364\t  const ForceGraph3D = stubForceGraph3D();\n365\t  const { loader, flush } = delayedLoader(ForceGraph3D);\n366\t  const r = createThreeRenderer({ loader });\n367\t  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n368\t  handle.update(codegraphLayout(), {});\n369\t  await flush();\n370\t  // Allow the chained .then to run.\n371\t  await flushAsync();\n372\t  const dataCall = ForceGraph3D._instance._calls.find((c) => c[0] === \"graphData\");\n373\t  assert.ok(dataCall, \"graphData must be called on activation\");\n374\t  // codegraph layout has node ids \"/src/foo.py\" and \"Foo.bar\".\n375\t  const ids = dataCall[1][0].nodes.map((n) => n.id).sort();\n376\t  assert.deepEqual(ids, [\"/src/foo.py\", \"Foo.bar\"].sort());\n377\t}\n378\t\n379\tasync function testDisposeBeforeLoadCancelsActivation() {\n380\t  const ForceGraph3D = stubForceGraph3D();\n381\t  const { loader, flush } = delayedLoader(ForceGraph3D);\n382\t  const r = createThreeRenderer({ loader });\n383\t  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n384\t  handle.dispose();\n385\t  await flush();\n386\t  await flushAsync();\n387\t  // The factory function was never invoked because dispose flipped the\n388\t  // cancellation flag before the .then ran.\n389\t  assert.equal(\n390\t    ForceGraph3D._instance._calls.length,\n391\t    0,\n392\t    \"disposed mount must not interact with the lib instance\"\n393\t  );\n394\t}\n395\t\n396\tasync function testDisposeAfterLoadCallsDestructor() {\n397\t  const ForceGraph3D = stubForceGraph3D();\n398\t  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n399\t  const host = fakeHost();\n400\t  const handle = r.mount(host, kg3dLayout(), {});\n401\t  await flushAsync();\n402\t  handle.dispose();\n403\t  assert.equal(\n404\t    ForceGraph3D._instance._destroyed,\n405\t    true,\n406\t    \"dispose after load must call _destructor on the 3d-force-graph instance\"\n407\t  );\n408\t  assert.equal(host.innerHTML, \"\");\n409\t}\n410\t\n411\tasync function testLoaderErrorPaintsInlineError() {\n412\t  const r = createThreeRenderer({\n413\t    loader: () => Promise.reject(new Error(\"network blew up\"))\n414\t  });\n415\t  const host = fakeHost();\n416\t  r.mount(host, kg3dLayout(), {});\n417\t  await flushAsync();\n418\t  assert.match(host.innerHTML, /3D renderer failed/);\n419\t  assert.match(host.innerHTML, /network blew up/);\n420\t}\n421\t\n422\tasync function testLoaderReturnsNonFunctionPaintsInlineError() {\n423\t  // Defensive: a bad CDN endpoint that returns a module without a default\n424\t  // export is a real failure mode. Surface it the same way as a network\n425\t  // error rather than throwing in the activation chain.\n426\t  const r = createThreeRenderer({\n427\t    loader: () => Promise.resolve({ weird: true })\n428\t  });\n429\t  const host = fakeHost();\n430\t  r.mount(host, kg3dLayout(), {});\n431\t  await flushAsync();\n432\t  assert.match(host.innerHTML, /3D renderer failed/);\n433\t  assert.match(host.innerHTML, /ForceGraph3D constructor/);\n434\t}\n435\t\n436\tasync function testOnNodeClickWiresThrough() {\n437\t  const ForceGraph3D = stubForceGraph3D();\n438\t  let receivedId = null;\n439\t  const r = createThreeRenderer({\n440\t    loader: () => Promise.resolve(ForceGraph3D),\n441\t    onNodeClick: (id) => {\n442\t      receivedId = id;\n443\t    }\n444\t  });\n445\t  r.mount(fakeHost(), kg3dLayout(), {});\n446\t  await flushAsync();\n447\t  // The instance recorded the onNodeClick registration with a handler;\n448\t  // invoke it as 3d-force-graph would on a click.\n449\t  const clickReg = ForceGraph3D._instance._calls.find((c) => c[0] === \"onNodeClick\");\n450\t  assert.ok(clickReg, \"onNodeClick must be registered on the instance\");\n451\t  const handler = clickReg[1][0];\n452\t  handler({ id: \"neural_nets\" });\n453\t  assert.equal(receivedId, \"neural_nets\");\n454\t}\n455\t\n456\tasync function testMultipleMountsAreIndependent() {\n457\t  // Two mounts off the same factory must hold independent state. The\n458\t  // renderer is a factory not a singleton — disposing one must not\n459\t  // affect the other.\n460\t  const instanceA = stubForceGraph3D()._instance;\n461\t  const instanceB = stubForceGraph3D()._instance;\n462\t  let nextInstance = instanceA;\n463\t  const ForceGraph3D = () => (host) => {\n464\t    const inst = nextInstance;\n465\t    inst._host = host;\n466\t    nextInstance = nextInstance === instanceA ? instanceB : instanceA;\n467\t    return inst;\n468\t  };\n469\t  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n470\t  const h1 = r.mount(fakeHost(), kg3dLayout(), {});\n471\t  const h2 = r.mount(fakeHost(), codegraphLayout(), {});\n472\t  await flushAsync();\n473\t  h1.dispose();\n474\t  assert.equal(instanceA._destroyed, true);\n475\t  assert.equal(instanceB._destroyed, false, \"disposing one mount must not affect the other\");\n476\t  h2.dispose();\n477\t  assert.equal(instanceB._destroyed, true);\n478\t}\n479\t\n480\tfunction testMountRejectsBadHost() {\n481\t  const r = createThreeRenderer({ loader: () => Promise.resolve(stubForceGraph3D()) });\n482\t  assert.throws(() => r.mount(null, kg3dLayout(), {}), /host must be an HTMLElement/);\n483\t  assert.throws(() => r.mount({}, kg3dLayout(), {}), /host must be an HTMLElement/);\n484\t}\n485\t\n486\t// ---------------------------------------------------------------------------\n487\t// Filters — focusedLayer\n488\t// ---------------------------------------------------------------------------\n489\t\n490\tfunction testNodeMatchesProps() {\n491\t  // No filter → everything visible.\n492\t  assert.equal(nodeMatchesProps({ layer: 1 }, {}), true);\n493\t  assert.equal(nodeMatchesProps({ layer: 1 }, { focusedLayer: 0 }), true);\n494\t  // Focused layer keeps matching nodes, hides others.\n495\t  assert.equal(nodeMatchesProps({ layer: 1 }, { focusedLayer: 1 }), true);\n496\t  assert.equal(nodeMatchesProps({ layer: 3 }, { focusedLayer: 1 }), false);\n497\t  // Nodes without a layer (e.g. code graph) are never hidden by a layer focus.\n498\t  assert.equal(nodeMatchesProps({}, { focusedLayer: 1 }), true);\n499\t}\n500\t\n501\tfunction stubForceGraph3DWithVisibility() {\n502\t  const base = stubForceGraph3D();\n503\t  const instance = base._instance;\n504\t  instance.nodeVisibility = function nodeVisibility(...args) {\n505\t    this._calls.push([\"nodeVisibility\", args]);\n506\t    this._nodeVisibility = args[0];\n507\t    return this;\n508\t  };\n509\t  instance.linkVisibility = function linkVisibility(...args) {\n510\t    this._calls.push([\"linkVisibility\", args]);\n511\t    this._linkVisibility = args[0];\n512\t    return this;\n513\t  };\n514\t  return base;\n515\t}\n516\t\n517\tasync function testFocusedLayerAppliesVisibility() {\n518\t  const ForceGraph3D = stubForceGraph3DWithVisibility();\n519\t  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n520\t  const handle = r.mount(fakeHost(), kg3dLayout(), { focusedLayer: 1 });\n521\t  await flushAsync();\n522\t  const inst = ForceGraph3D._instance;\n523\t  assert.equal(typeof inst._nodeVisibility, \"function\", \"nodeVisibility accessor registered\");\n524\t  assert.equal(typeof inst._linkVisibility, \"function\", \"linkVisibility accessor registered\");\n525\t  // kg3dLayout has neural_nets@layer1 and backprop@layer3 — focus on 1.\n526\t  assert.equal(inst._nodeVisibility({ layer: 1 }), true);\n527\t  assert.equal(inst._nodeVisibility({ layer: 3 }), false);\n528\t  // A link is visible only when both processed endpoints survive.\n529\t  assert.equal(inst._linkVisibility({ source: { layer: 1 }, target: { layer: 1 } }), true);\n530\t  assert.equal(inst._linkVisibility({ source: { layer: 1 }, target: { layer: 3 } }), false);\n531\t  // Clearing the focus (update with no focusedLayer) re-opens everything.\n532\t  handle.update(kg3dLayout(), {});\n533\t  assert.equal(inst._nodeVisibility({ layer: 3 }), true);\n534\t}\n535\t\n536\tmain().catch((err) => {\n537\t  console.error(err);\n538\t  process.exit(1);\n539\t});\n540\t\n541\t// Exported constants — sanity check the public surface didn't drift.\n542\tassert.equal(typeof __testing.DEFAULT_CDN_URL, \"string\");\n543\tassert.match(__testing.DEFAULT_CDN_URL, /3d-force-graph/);\n544\t"}]},"uuid":"408bc5ce-ef81-4ab7-ba5a-af5be7590812","timestamp":"2026-06-27T22:17:42.227Z","toolUseResult":{"type":"text","file":{"filePath":"C:/Users/nsdha/OneDrive/binary16/prime-silo/tests/widgets_three_renderer_test.mjs","content":"#!/usr/bin/env node\n//\n// ADR-001 Phase C follow-up — three-renderer drop-in.\n//\n// Renders into a fake DOM host (the renderer never reaches DOM APIs\n// outside `host.innerHTML` and `host.querySelector` existence checks).\n// The `3d-force-graph` lib is stubbed via `options.loader` so this\n// node-runner test never touches the CDN.\n\nimport assert from \"node:assert/strict\";\n\nimport {\n  createThreeRenderer,\n  layoutToGraphData,\n  nodeMatchesProps,\n  __testing\n} from \"../app/L0/_all/mod/_prime_silo/widgets/three_renderer/index.js\";\n\nasync function main() {\n  // layoutToGraphData — pure normaliser. No DOM, no async.\n  testLayoutToGraphDataEmpty();\n  testLayoutToGraphDataKg3dShape();\n  testLayoutToGraphDataCodegraphShape();\n  testLayoutToGraphDataDropsEdgesWithMissingEnds();\n  testLayoutToGraphDataPinsXYAsFxFy();\n  testLayoutToGraphDataFluidSeedsXY();\n  testLayoutToGraphDataCoercesEdgeIdsToStrings();\n  testLayoutToGraphDataCarriesOriginalNode();\n\n  // createThreeRenderer — factory + mount + lazy-load lifecycle.\n  testFactoryReturnsMountShape();\n  testFactoryIsLazyAndDoesNotCallLoader();\n  await testMountReturnsSyncHandle();\n  await testMountCallsLoaderAndAppliesData();\n  await testUpdateAfterLoadAppliesData();\n  await testUpdateBeforeLoadIsReplayedOnActivation();\n  await testDisposeBeforeLoadCancelsActivation();\n  await testDisposeAfterLoadCallsDestructor();\n  await testLoaderErrorPaintsInlineError();\n  await testLoaderReturnsNonFunctionPaintsInlineError();\n  await testOnNodeClickWiresThrough();\n  await testMultipleMountsAreIndependent();\n  testMountRejectsBadHost();\n\n  // Filters (focusedLayer) — node/link visibility predicates.\n  testNodeMatchesProps();\n  await testFocusedLayerAppliesVisibility();\n\n  console.log(\"widgets_three_renderer_test: ok\");\n}\n\n// ---------------------------------------------------------------------------\n// Fixtures\n// ---------------------------------------------------------------------------\n\nfunction fakeHost() {\n  const host = {\n    innerHTML: \"\",\n    classList: { add() {}, remove() {} },\n    querySelector() {\n      return null;\n    },\n    addEventListener() {},\n    removeEventListener() {}\n  };\n  return host;\n}\n\nfunction stubForceGraph3D() {\n  // Mirrors 3d-force-graph's curried/fluent API. The instance records\n  // every call so tests can assert on the wire shape.\n  const instance = {\n    _calls: [],\n    _destroyed: false,\n    backgroundColor(...args) {\n      this._calls.push([\"backgroundColor\", args]);\n      return this;\n    },\n    nodeRelSize(...args) {\n      this._calls.push([\"nodeRelSize\", args]);\n      return this;\n    },\n    nodeColor(...args) {\n      this._calls.push([\"nodeColor\", args]);\n      return this;\n    },\n    linkColor(...args) {\n      this._calls.push([\"linkColor\", args]);\n      return this;\n    },\n    onNodeClick(...args) {\n      this._calls.push([\"onNodeClick\", args]);\n      return this;\n    },\n    graphData(...args) {\n      this._calls.push([\"graphData\", args]);\n      return this;\n    },\n    _destructor() {\n      this._destroyed = true;\n    }\n  };\n  // The lib exports a factory of the form ForceGraph3D() returns a\n  // function that takes the dom element and returns the instance.\n  const ForceGraph3D = () => (host) => {\n    instance._host = host;\n    return instance;\n  };\n  ForceGraph3D._instance = instance;\n  return ForceGraph3D;\n}\n\n// Flush ALL pending microtasks. The renderer's activation chain is\n// `Promise.resolve().then(loader).then(activate)`, so it takes several\n// microtasks to drain; setTimeout(0) yields to the macrotask queue which\n// only runs after every microtask is done.\nfunction flushAsync() {\n  return new Promise((resolve) => setTimeout(resolve, 0));\n}\n\nfunction delayedLoader(ForceGraph3D) {\n  // Resolves the loader on the next microtask so we can interleave\n  // mount → update → dispose calls with the load lifecycle.\n  let resolve;\n  const promise = new Promise((r) => {\n    resolve = r;\n  });\n  return {\n    loader: () => promise,\n    flush() {\n      resolve(ForceGraph3D);\n      return promise;\n    }\n  };\n}\n\nfunction kg3dLayout() {\n  return {\n    positions: {\n      neural_nets: {\n        x: 100,\n        y: 50,\n        radius: 12,\n        layer: 1,\n        color: \"#a78bfa\",\n        node: { id: \"neural_nets\", canonical_name: \"Neural networks\" }\n      },\n      backprop: {\n        x: 200,\n        y: 140,\n        radius: 8,\n        layer: 3,\n        color: \"#22d3ee\",\n        node: { id: \"backprop\" }\n      }\n    },\n    edges: [\n      { id: \"e1\", source: \"neural_nets\", target: \"backprop\", kind: \"prerequisite\", weight: 0.9 }\n    ],\n    width: 720,\n    height: 480\n  };\n}\n\nfunction codegraphLayout() {\n  return {\n    positions: {\n      \"/src/foo.py\": {\n        x: 50,\n        y: 30,\n        radius: 6,\n        type: \"File\",\n        color: \"#00FFFF\",\n        node: { id: \"/src/foo.py\", type: \"File\", path: \"/src/foo.py\" }\n      },\n      \"Foo.bar\": {\n        x: 200,\n        y: 60,\n        radius: 6,\n        type: \"Function\",\n        color: \"#FF5F1F\",\n        node: { id: \"Foo.bar\", type: \"Function\" }\n      }\n    },\n    edges: [{ id: \"e1\", source: \"/src/foo.py\", target: \"Foo.bar\", type: \"DEFINES\" }]\n  };\n}\n\n// ---------------------------------------------------------------------------\n// layoutToGraphData\n// ---------------------------------------------------------------------------\n\nfunction testLayoutToGraphDataEmpty() {\n  assert.deepEqual(layoutToGraphData(null), { nodes: [], links: [] });\n  assert.deepEqual(layoutToGraphData({}), { nodes: [], links: [] });\n  assert.deepEqual(layoutToGraphData({ positions: {}, edges: [] }), { nodes: [], links: [] });\n}\n\nfunction testLayoutToGraphDataKg3dShape() {\n  const out = layoutToGraphData(kg3dLayout());\n  assert.equal(out.nodes.length, 2);\n  const byId = Object.fromEntries(out.nodes.map((n) => [n.id, n]));\n  assert.equal(byId.neural_nets.color, \"#a78bfa\");\n  assert.equal(byId.neural_nets.val, 12);\n  assert.equal(byId.neural_nets.layer, 1);\n  assert.equal(byId.backprop.layer, 3);\n  // kg3d carries no `type`, so neither should the graph node.\n  assert.equal(\"type\" in byId.neural_nets, false);\n  assert.equal(out.links.length, 1);\n  assert.equal(out.links[0].kind, \"prerequisite\");\n  assert.equal(out.links[0].weight, 0.9);\n  // codegraph-style `type` is absent.\n  assert.equal(\"type\" in out.links[0], false);\n}\n\nfunction testLayoutToGraphDataCodegraphShape() {\n  const out = layoutToGraphData(codegraphLayout());\n  assert.equal(out.nodes.length, 2);\n  const byId = Object.fromEntries(out.nodes.map((n) => [n.id, n]));\n  assert.equal(byId[\"/src/foo.py\"].type, \"File\");\n  assert.equal(byId[\"Foo.bar\"].type, \"Function\");\n  assert.equal(out.links.length, 1);\n  assert.equal(out.links[0].type, \"DEFINES\");\n  // kg3d-style `kind` and `weight` are absent.\n  assert.equal(\"kind\" in out.links[0], false);\n  assert.equal(\"weight\" in out.links[0], false);\n}\n\nfunction testLayoutToGraphDataDropsEdgesWithMissingEnds() {\n  const out = layoutToGraphData({\n    positions: { a: { x: 0, y: 0, color: \"#fff\" } },\n    edges: [\n      { source: \"a\", target: \"b\" }, // kept — normaliser doesn't reach into positions for validity\n      { source: \"a\" }, // dropped — no target\n      { target: \"b\" }, // dropped — no source\n      { source: null, target: \"b\" }, // dropped — null source\n      null // dropped — null edge\n    ]\n  });\n  // The renderer's job is to forward what it's given; positional validity\n  // is the widget's contract. But we DO drop edges that can't even form a\n  // link record. So only the first survives.\n  assert.equal(out.links.length, 1);\n  assert.equal(out.links[0].source, \"a\");\n  assert.equal(out.links[0].target, \"b\");\n}\n\nfunction testLayoutToGraphDataPinsXYAsFxFy() {\n  // 2D layout coordinates seed the 3D solver via fx/fy. Without this, the\n  // 3D scene would lose the AoT-layer / type-band grouping that makes the\n  // 2D fallback legible.\n  const out = layoutToGraphData(kg3dLayout());\n  const neural = out.nodes.find((n) => n.id === \"neural_nets\");\n  assert.equal(neural.fx, 100);\n  assert.equal(neural.fy, 50);\n}\n\nfunction testLayoutToGraphDataFluidSeedsXY() {\n  // When physicsMode is \"fluid\", nodes should not be pinned (fx/fy are undefined),\n  // but instead have initial x/y coordinates seeded.\n  const out = layoutToGraphData(kg3dLayout(), \"fluid\");\n  const neural = out.nodes.find((n) => n.id === \"neural_nets\");\n  assert.equal(neural.fx, undefined);\n  assert.equal(neural.fy, undefined);\n  assert.equal(neural.x, 100);\n  assert.equal(neural.y, 50);\n}\n\nfunction testLayoutToGraphDataCoercesEdgeIdsToStrings() {\n  // Codegraph IDs are sometimes numeric (Neo4j internal ids). Force them\n  // to strings so they line up with the node ids the normaliser emits.\n  const out = layoutToGraphData({\n    positions: { 42: { x: 0, y: 0 } },\n    edges: [{ source: 42, target: \"42\" }]\n  });\n  assert.equal(out.links[0].source, \"42\");\n  assert.equal(out.links[0].target, \"42\");\n}\n\nfunction testLayoutToGraphDataCarriesOriginalNode() {\n  const out = layoutToGraphData(codegraphLayout());\n  const fn = out.nodes.find((n) => n.id === \"Foo.bar\");\n  assert.equal(fn._original.type, \"Function\");\n}\n\n// ---------------------------------------------------------------------------\n// Factory + mount lifecycle\n// ---------------------------------------------------------------------------\n\nfunction testFactoryReturnsMountShape() {\n  const r = createThreeRenderer({ loader: () => Promise.resolve(stubForceGraph3D()) });\n  assert.equal(typeof r.mount, \"function\");\n}\n\nfunction testFactoryIsLazyAndDoesNotCallLoader() {\n  let called = 0;\n  createThreeRenderer({\n    loader: () => {\n      called += 1;\n      return Promise.resolve(stubForceGraph3D());\n    }\n  });\n  assert.equal(called, 0, \"factory must not call loader at construction\");\n}\n\nasync function testMountReturnsSyncHandle() {\n  const ForceGraph3D = stubForceGraph3D();\n  const { loader, flush } = delayedLoader(ForceGraph3D);\n  const r = createThreeRenderer({ loader });\n  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n  // Handle MUST be synchronous so widgets can assign it to rendererHandle\n  // without await.\n  assert.equal(typeof handle.update, \"function\");\n  assert.equal(typeof handle.dispose, \"function\");\n  // Loader runs but hasn't resolved yet — no calls on the instance.\n  await flushAsync();\n  assert.equal(ForceGraph3D._instance._calls.length, 0);\n  handle.dispose();\n  await flush().catch(() => {}); // unblock the promise chain to avoid unhandled-rejection noise\n  await flushAsync();\n}\n\nasync function testMountCallsLoaderAndAppliesData() {\n  let calls = 0;\n  const ForceGraph3D = stubForceGraph3D();\n  const r = createThreeRenderer({\n    loader: () => {\n      calls += 1;\n      return Promise.resolve(ForceGraph3D);\n    }\n  });\n  const host = fakeHost();\n  r.mount(host, kg3dLayout(), {});\n  // Wait for the load promise + the internal then chain to flush.\n  await flushAsync();\n  assert.equal(calls, 1, \"loader must be called exactly once\");\n  const inst = ForceGraph3D._instance;\n  const methods = inst._calls.map((c) => c[0]);\n  assert.ok(methods.includes(\"backgroundColor\"));\n  assert.ok(methods.includes(\"nodeRelSize\"));\n  assert.ok(methods.includes(\"nodeColor\"));\n  assert.ok(methods.includes(\"linkColor\"));\n  // graphData must have been called with the normalised payload.\n  const dataCall = inst._calls.find((c) => c[0] === \"graphData\");\n  assert.ok(dataCall, \"graphData must be called after load\");\n  assert.equal(dataCall[1][0].nodes.length, 2);\n  assert.equal(dataCall[1][0].links.length, 1);\n}\n\nasync function testUpdateAfterLoadAppliesData() {\n  const ForceGraph3D = stubForceGraph3D();\n  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n  await flushAsync();\n  const before = ForceGraph3D._instance._calls.filter((c) => c[0] === \"graphData\").length;\n  handle.update(codegraphLayout(), {});\n  const after = ForceGraph3D._instance._calls.filter((c) => c[0] === \"graphData\").length;\n  assert.equal(after, before + 1, \"update must call graphData once more\");\n}\n\nasync function testUpdateBeforeLoadIsReplayedOnActivation() {\n  // Mount with layout A, immediately update to layout B, THEN let the\n  // loader resolve. The instance must see layout B (the latest), not A.\n  const ForceGraph3D = stubForceGraph3D();\n  const { loader, flush } = delayedLoader(ForceGraph3D);\n  const r = createThreeRenderer({ loader });\n  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n  handle.update(codegraphLayout(), {});\n  await flush();\n  // Allow the chained .then to run.\n  await flushAsync();\n  const dataCall = ForceGraph3D._instance._calls.find((c) => c[0] === \"graphData\");\n  assert.ok(dataCall, \"graphData must be called on activation\");\n  // codegraph layout has node ids \"/src/foo.py\" and \"Foo.bar\".\n  const ids = dataCall[1][0].nodes.map((n) => n.id).sort();\n  assert.deepEqual(ids, [\"/src/foo.py\", \"Foo.bar\"].sort());\n}\n\nasync function testDisposeBeforeLoadCancelsActivation() {\n  const ForceGraph3D = stubForceGraph3D();\n  const { loader, flush } = delayedLoader(ForceGraph3D);\n  const r = createThreeRenderer({ loader });\n  const handle = r.mount(fakeHost(), kg3dLayout(), {});\n  handle.dispose();\n  await flush();\n  await flushAsync();\n  // The factory function was never invoked because dispose flipped the\n  // cancellation flag before the .then ran.\n  assert.equal(\n    ForceGraph3D._instance._calls.length,\n    0,\n    \"disposed mount must not interact with the lib instance\"\n  );\n}\n\nasync function testDisposeAfterLoadCallsDestructor() {\n  const ForceGraph3D = stubForceGraph3D();\n  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n  const host = fakeHost();\n  const handle = r.mount(host, kg3dLayout(), {});\n  await flushAsync();\n  handle.dispose();\n  assert.equal(\n    ForceGraph3D._instance._destroyed,\n    true,\n    \"dispose after load must call _destructor on the 3d-force-graph instance\"\n  );\n  assert.equal(host.innerHTML, \"\");\n}\n\nasync function testLoaderErrorPaintsInlineError() {\n  const r = createThreeRenderer({\n    loader: () => Promise.reject(new Error(\"network blew up\"))\n  });\n  const host = fakeHost();\n  r.mount(host, kg3dLayout(), {});\n  await flushAsync();\n  assert.match(host.innerHTML, /3D renderer failed/);\n  assert.match(host.innerHTML, /network blew up/);\n}\n\nasync function testLoaderReturnsNonFunctionPaintsInlineError() {\n  // Defensive: a bad CDN endpoint that returns a module without a default\n  // export is a real failure mode. Surface it the same way as a network\n  // error rather than throwing in the activation chain.\n  const r = createThreeRenderer({\n    loader: () => Promise.resolve({ weird: true })\n  });\n  const host = fakeHost();\n  r.mount(host, kg3dLayout(), {});\n  await flushAsync();\n  assert.match(host.innerHTML, /3D renderer failed/);\n  assert.match(host.innerHTML, /ForceGraph3D constructor/);\n}\n\nasync function testOnNodeClickWiresThrough() {\n  const ForceGraph3D = stubForceGraph3D();\n  let receivedId = null;\n  const r = createThreeRenderer({\n    loader: () => Promise.resolve(ForceGraph3D),\n    onNodeClick: (id) => {\n      receivedId = id;\n    }\n  });\n  r.mount(fakeHost(), kg3dLayout(), {});\n  await flushAsync();\n  // The instance recorded the onNodeClick registration with a handler;\n  // invoke it as 3d-force-graph would on a click.\n  const clickReg = ForceGraph3D._instance._calls.find((c) => c[0] === \"onNodeClick\");\n  assert.ok(clickReg, \"onNodeClick must be registered on the instance\");\n  const handler = clickReg[1][0];\n  handler({ id: \"neural_nets\" });\n  assert.equal(receivedId, \"neural_nets\");\n}\n\nasync function testMultipleMountsAreIndependent() {\n  // Two mounts off the same factory must hold independent state. The\n  // renderer is a factory not a singleton — disposing one must not\n  // affect the other.\n  const instanceA = stubForceGraph3D()._instance;\n  const instanceB = stubForceGraph3D()._instance;\n  let nextInstance = instanceA;\n  const ForceGraph3D = () => (host) => {\n    const inst = nextInstance;\n    inst._host = host;\n    nextInstance = nextInstance === instanceA ? instanceB : instanceA;\n    return inst;\n  };\n  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n  const h1 = r.mount(fakeHost(), kg3dLayout(), {});\n  const h2 = r.mount(fakeHost(), codegraphLayout(), {});\n  await flushAsync();\n  h1.dispose();\n  assert.equal(instanceA._destroyed, true);\n  assert.equal(instanceB._destroyed, false, \"disposing one mount must not affect the other\");\n  h2.dispose();\n  assert.equal(instanceB._destroyed, true);\n}\n\nfunction testMountRejectsBadHost() {\n  const r = createThreeRenderer({ loader: () => Promise.resolve(stubForceGraph3D()) });\n  assert.throws(() => r.mount(null, kg3dLayout(), {}), /host must be an HTMLElement/);\n  assert.throws(() => r.mount({}, kg3dLayout(), {}), /host must be an HTMLElement/);\n}\n\n// ---------------------------------------------------------------------------\n// Filters — focusedLayer\n// ---------------------------------------------------------------------------\n\nfunction testNodeMatchesProps() {\n  // No filter → everything visible.\n  assert.equal(nodeMatchesProps({ layer: 1 }, {}), true);\n  assert.equal(nodeMatchesProps({ layer: 1 }, { focusedLayer: 0 }), true);\n  // Focused layer keeps matching nodes, hides others.\n  assert.equal(nodeMatchesProps({ layer: 1 }, { focusedLayer: 1 }), true);\n  assert.equal(nodeMatchesProps({ layer: 3 }, { focusedLayer: 1 }), false);\n  // Nodes without a layer (e.g. code graph) are never hidden by a layer focus.\n  assert.equal(nodeMatchesProps({}, { focusedLayer: 1 }), true);\n}\n\nfunction stubForceGraph3DWithVisibility() {\n  const base = stubForceGraph3D();\n  const instance = base._instance;\n  instance.nodeVisibility = function nodeVisibility(...args) {\n    this._calls.push([\"nodeVisibility\", args]);\n    this._nodeVisibility = args[0];\n    return this;\n  };\n  instance.linkVisibility = function linkVisibility(...args) {\n    this._calls.push([\"linkVisibility\", args]);\n    this._linkVisibility = args[0];\n    return this;\n  };\n  return base;\n}\n\nasync function testFocusedLayerAppliesVisibility() {\n  const ForceGraph3D = stubForceGraph3DWithVisibility();\n  const r = createThreeRenderer({ loader: () => Promise.resolve(ForceGraph3D) });\n  const handle = r.mount(fakeHost(), kg3dLayout(), { focusedLayer: 1 });\n  await flushAsync();\n  const inst = ForceGraph3D._instance;\n  assert.equal(typeof inst._nodeVisibility, \"function\", \"nodeVisibility accessor registered\");\n  assert.equal(typeof inst._linkVisibility, \"function\", \"linkVisibility accessor registered\");\n  // kg3dLayout has neural_nets@layer1 and backprop@layer3 — focus on 1.\n  assert.equal(inst._nodeVisibility({ layer: 1 }), true);\n  assert.equal(inst._nodeVisibility({ layer: 3 }), false);\n  // A link is visible only when both processed endpoints survive.\n  assert.equal(inst._linkVisibility({ source: { layer: 1 }, target: { layer: 1 } }), true);\n  assert.equal(inst._linkVisibility({ source: { layer: 1 }, target: { layer: 3 } }), false);\n  // Clearing the focus (update with no focusedLayer) re-opens everything.\n  handle.update(kg3dLayout(), {});\n  assert.equal(inst._nodeVisibility({ layer: 3 }), true);\n}\n\nmain().catch((err) => {\n  console.error(err);\n  process.exit(1);\n});\n\n// Exported constants — sanity check the public surface didn't drift.\nassert.equal(typeof __testing.DEFAULT_CDN_URL, \"string\");\nassert.match(__testing.DEFAULT_CDN_URL, /3d-force-graph/);\n","numLines":544,"startLine":1,"totalLines":544}},"sourceToolAssistantUUID":"888bc570-eb31-4675-8597-5172ffbff1d7","userType":"external","entrypoint":"claude-desktop","cwd":"C:\\Users\\nsdha\\OneDrive\\binary16","sessionId":"1231aaa9-d9f4-4d01-9820-86f32a823a60","version":"2.1.187","gitBranch":"HEAD"}
