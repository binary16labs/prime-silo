nding.layout, physicsMode);\n371\t      state.highlight = highlightIdsFromProps(state.pending.props);\n372\t      const props = state.pending.props || {};\n373\t      // Honour layer filtering by dropping hidden nodes/links before they reach\n374\t      // the sim (cheaper than per-frame visibility for a 2D canvas).\n375\t      const visibleNodes = data.nodes.filter((n) => nodeMatchesProps(n, props));\n376\t      const visibleIds = new Set(visibleNodes.map((n) => n.id));\n377\t      const visibleLinks = data.links.filter(\n378\t        (l) => visibleIds.has(String(l.source)) && visibleIds.has(String(l.target))\n379\t      );\n380\t      state.instance.graphData({ nodes: visibleNodes, links: visibleLinks });\n381\t    }\n382\t\n383\t    function fireClick(node) {\n384\t      if (!node) return;\n385\t      // The widgets pass a per-mount `props.onSelect`; the Bridge factory wiring\n386\t      // passes `options.onNodeClick`. Prefer the per-mount handler so the two\n387\t      // conventions don't double-fire when both are present (they route to the\n388\t      // same selection logic). Fall back to the factory handler otherwise.\n389\t      const onSelect = state.pending && state.pending.props && state.pending.props.onSelect;\n390\t      if (typeof onSelect === \"function\") onSelect(node.id, node._original || node);\n391\t      else if (factoryOnNodeClick) factoryOnNodeClick(node.id, node._original || node);\n392\t    }\n393\t\n394\t    function fireHover(node) {\n395\t      const onHover = state.pending && state.pending.props && state.pending.props.onHover;\n396\t      if (typeof onHover === \"function\") onHover(node ? node.id : null, node);\n397\t    }\n398\t\n399\t    function drawMinimap() {\n400\t      const cv = state.minimapCanvas;\n401\t      const inst = state.instance;\n402\t      if (!cv || !inst || state.disposed) return;\n403\t      const ctx = cv.getContext(\"2d\");\n404\t      const W = cv.width;\n405\t      const H = cv.height;\n406\t      ctx.clearR