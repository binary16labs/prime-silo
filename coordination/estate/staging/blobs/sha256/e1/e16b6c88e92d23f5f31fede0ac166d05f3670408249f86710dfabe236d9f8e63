e, vh * scale);\n449\t        }\n450\t      } catch {\n451\t        /* center/zoom not ready */\n452\t      }\n453\t    }\n454\t\n455\t    Promise.resolve()\n456\t      .then(() => loader())\n457\t      .then((ForceGraph) => {\n458\t        if (state.disposed) return;\n459\t        if (typeof ForceGraph !== \"function\") {\n460\t          throw new Error(\"force_graph_2d: loader did not return a ForceGraph constructor.\");\n461\t        }\n462\t        // Mount force-graph into an absolutely-positioned inner layer rather\n463\t        // than the host itself. The canvas force-graph creates is a block\n464\t        // element; mounted directly into a host whose height is content-driven\n465\t        // (e.g. Memory mode's auto-sized grid row) it would size the host, which\n466\t        // re-sizes the canvas, … an infinite vertical-growth loop (\"the page\n467\t        // keeps scrolling down\"). An inset:0 absolute layer takes its size from\n468\t        // the host and contributes nothing back, breaking the loop. Falls back\n469\t        // to mounting into the host directly when there's no real DOM (tests).\n470\t        let mountEl = state.host;\n471\t        if (\n472\t          state.host.ownerDocument &&\n473\t          typeof state.host.ownerDocument.createElement === \"function\" &&\n474\t          typeof state.host.appendChild === \"function\"\n475\t        ) {\n476\t          const inner = state.host.ownerDocument.createElement(\"div\");\n477\t          inner.style.position = \"absolute\";\n478\t          inner.style.top = \"0\";\n479\t          inner.style.left = \"0\";\n480\t          inner.style.right = \"0\";\n481\t          inner.style.bottom = \"0\";\n482\t          inner.style.overflow = \"hidden\";\n483\t          state.host.appendChild(inner);\n484\t          state.inner = inner;\n485\t          mountEl = inner;\n486\t        }\n487\t        // force-graph's curried API: ForceGraph()(domElement)\n488\t        const instance = ForceGraph()(mountEl);\n489\t        instance\n490\t          .backgroundColor(backgroundColor)\n491\t          .nodeRelSize(DEFAULT_NODE_VAL)\n492\t          // Hover tooltip: the friendly name, its type, and — when it differs\n493\t          // from the name — the full identifier (path / canonical name / id),\n494\t          // so two similarly-named nodes are still tellable apart.\n495\t          .nodeLabel((n) => {\n496\t            if (!n) return \"\";\n497\t            const name = escapeHtml(String(n.label || n.id || \"\"));\n498\t            const type = n.type ? escapeHtml(String(n.type)) : \"\";\n499\t            const ident = n.ident && n.ident !== n.label ? escapeHtml(String(n.ident)) : \"\";\n500\t            const head = type ? `<strong>${name}</strong> <em>${type}</em>` : `<strong>${name}</strong>`;\n501\t            return ident ? `${head}<br><span style=\"opacity:.7\">${ident}</span>` : head;\n502\t          })\n503\t          .nodeCanvasObject(paintNode)\n504\t          .nodePointerAreaPaint((node, color, ctx) => {\n505\t            ctx.fillStyle = color;\n506\t            ctx.beginPath();\n507\t            ctx.arc(node.x, node.y, (node.val || DEFAULT_NODE_VAL) * 1.5, 0, 2 * Math.PI);\n508\t            ctx.fill();\n509\t          })\n510\t          .linkColor((l) => {\n511\t            const { s, t } = linkHot(l);\n512\t            if (s && t) return \"rgba(219,83,63,0.95)\";\n513\t            if (s || t) return \"rgba(219,83,63,0.4)\";\n514\t            return l.color || LINK_COLOR;\n515\t          })\n516\t          .linkWidth((l) => {\n517\t            const { s, t } = linkHot(l);\n518\t            return s || t ? 3 : 1;\n519\t          })\n520\t          .linkDirectionalParticles((l) => {\n521\t            const { s, t } = linkHot(l);\n522\t            return s || t ? 4 : 0;\n523\t          })\n524\t          .linkDirectionalParticleWidth((l) => {\n525\t            const { s, t } = linkHot(l);\n526\t            return s || t ? 4 : 2;\n527\t          })\n528\t          .linkDirectionalParticleSpeed((l) => {\n529\t            const { s, t } = linkHot(l);\n530\t            return s || t ? 0.015 : 0.004;\n531\t          })\n532\t          .d3VelocityDecay(0.25)\n533\t          .warmupTicks(50)\n534\t          .cooldownTime(3000)\n535\t          .onEngineStop(() => {\n536\t            // Frame the graph once, when the simulation first settles.\n537\t            if (!state.hasFitted) {\n538\t              state.hasFitted = true;\n539\t              refit(0);\n540\t            }\n541\t          })\n542\t          .onNodeClick((n) => fireClick(n))\n543\t          .onNodeHover((n) => fireHover(n))\n544\t          .onBackgroundClick(() => {\n545\t            const onBg = state.pending && state.pending.props && state.pending.props.onBackgroundClick;\n546\t            if (typeof onBg === \"function\") onBg();\n547\t          });\n548\t        state.instance = instance;\n549\t        applyData();\n550\t        scheduleResize();\n551\t\n552\t        // Keep the canvas filling the host through fullscreen / pane resizes,\n553\t        // and re-center the graph once the resize settles.\n554\t        if (typeof ResizeObserver !== \"undefined\") {\n555\t          state.resizeObserver = new ResizeObserver(() => {\n556\t            sizeToHost();\n557\t            scheduleRefit();\n558\t          });\n559\t          state.resizeObserver.observe(state.host);\n560\t        }\n561\t        // Window maximize / restore doesn't always re-fire ResizeObserver on a\n562\t        // flex-sized child, so listen for it directly as a belt-and-braces.\n563\t        if (state.host.ownerDocument && state.host.ownerDocument.defaultView) {\n564\t          state.win = state.host.ownerDocument.defaultView;\n565\t          state.onWinResize = () => {\n566\t            scheduleResize();\n567\t            scheduleRefit();\n568\t          };\n569\t          state.win.addEventListener(\"resize\", state.onWinResize);\n570\t        }\n571\t\n572\t        if (\n573\t          showMinimap &&\n574\t          state.host.ownerDocument &&\n575\t          typeof state.host.ownerDocument.createElement === \"function\" &&\n576\t          typeof state.host.appendChild === \"function\"\n577\t        ) {\n578\t          const cv = state.host.ownerDocument.createElement(\"canvas\");\n579\t          cv.width = 210;\n580\t          cv.height = 140;\n581\t          cv.className = \"prime-silo-fg2d__minimap\";\n582\t          // Inline fallbacks so the minimap stays pinned (and never adds to the\n583\t          // host's content height) even if force_graph_2d.css didn't load.\n584\t          cv.style.position = \"absolute\";\n585\t          cv.style.bottom = \"12px\";\n586\t          cv.style.right = \"12px\";\n587\t          cv.style.zIndex = \"10\";\n588\t          cv.style.pointerEvents = \"none\";\n589\t          state.host.appendChild(cv);\n590\t          state.minimapCanvas = cv;\n591\t          state.minimapTimer = setInterval(drawMinimap, 300);\n592\t        }\n593\t      })\n594\t      .catch((err) => {\n595\t        if (state.disposed || !state.host) return;\n596\t        state.host.innerHTML = `<div class=\"prime-silo-fg2d__error\">Graph renderer failed: ${escapeHtml(\n597\t          err && err.message ? err.message : String(err)\n598\t        )}</div>`;\n599\t      });\n600\t\n601\t    // Camera-track the highlighted node: when props.track is set, pan the\n602\t    // viewport to the first highlighted node (used by the Step-Through player so\n603\t    // the free-floating graph follows the current step). Best-effort — positions\n604\t    // may not be settled yet on the first frames, so we retry briefly.\n605\t    function maybeCenterOnHighlight() {\n606\t      const p = state.pending && state.pending.props;\n607\t      if (!p || !p.track || !state.instance) return;\n608\t      const ids = highlightIdsFromProps(p);\n609\t      if (!ids.length) return;\n610\t      const tryCenter = () => {\n611\t        if (state.disposed || !state.instance) return false;\n612\t        const gd = typeof state.instance.graphData === \"function\" ? state.instance.graphData() : null;\n613\t        const node = gd && gd.nodes.find((n) => ids.includes(String(n.id)));\n614\t        if (node && typeof node.x === \"number\" && typeof state.instance.centerAt === \"function\") {\n615\t          state.instance.centerAt(node.x, node.y, 600);\n616\t          return true;\n617\t        }\n618\t        return false;\n619\t      };\n620\t      if (!tryCenter()) {\n621\t        for (const delay of [120, 400, 900]) setTimeout(tryCenter, delay);\n622\t      }\n623\t    }\n624\t\n625\t    return {\n626\t      update(nextLayout, nextProps) {\n627\t        state.pending = { layout: nextLayout, props: nextProps };\n628\t        applyData();\n629\t        scheduleResize();\n630\t        maybeCenterOnHighlight();\n631\t      },\n632\t      dispose() {\n633\t        state.disposed = true;\n634\t        if (state.minimapTimer) {\n635\t          clearInterval(state.minimapTimer);\n636\t          state.minimapTimer = null;\n637\t        }\n638\t        if (state.refitTimer) {\n639\t          clearTimeout(state.refitTimer);\n640\t          state.refitTimer = null;\n641\t        }\n642\t        if (state.resizeObserver) {\n643\t          try {\n644\t            state.resizeObserver.disconnect();\n645\t          } catch {\n646\t            /* swallow */\n647\t          }\n648\t          state.resizeObserver = null;\n649\t        }\n650\t        if (state.win && state.onWinResize) {\n651\t          try {\n652\t            state.win.removeEventListener(\"resize\", state.onWinResize);\n653\t          } catch {\n654\t            /* swallow */\n655\t          }\n656\t          state.win = null;\n657\t          state.onWinResize = null;\n658\t        }\n659\t        if (state.instance && typeof state.instance._destructor === \"function\") {\n660\t          try {\n661\t            state.instance._destructor();\n662\t          } catch {\n663\t            /* swallow */\n664\t          }\n665\t        }\n666\t        state.instance = null;\n667\t        state.inner = null;\n668\t        if (state.host) {\n669\t          try {\n670\t            state.host.innerHTML = \"\";\n671\t          } catch {\n672\t            /* swallow */\n673\t          }\n674\t        }\n675\t        state.host = null;\n676\t      }\n677\t    };\n678\t  }\n679\t\n680\t  return { mount };\n681\t}\n682\t\n683\texport const __testing = {\n684\t  DEFAULT_VENDOR_URL,\n685\t  DEFAULT_BACKGROUND,\n686\t  PALETTE,\n687\t  HIGHLIGHT_COLOR,\n688\t  DEFAULT_NODE_COLOR,\n689\t  colorFor,\n690\t  labelFor,\n691\t  identifierFor,\n692\t  basename,\n693\t  highlightIdsFromProps\n694\t};\n695\t"}]},"uuid":"b8b1a55e-1d90-43e5-a554-be2e897b986c","timestamp":"2026-06-27T22:21:54.480Z","toolUseResult":{"type":"text","file":{"filePath":"C:/Users/nsdha/OneDrive/binary16/prime-silo/app/L0/_all/mod/_prime_silo/widgets/force_graph_2d/index.js","content":"// Organic 2D force-graph drop-in renderer.\n//\n// Slots into `memoray.lineage_graph`, `kg3d.synoptic_web`, and\n// `codegraph.canvas` via the same `options.renderer = { mount, update,\n// dispose }` hook that `three_renderer` uses. The widget cores stay\n// dependency-free (default 2D SVG); callers that want the living, organic\n// graph — the Memo-Ray look (force-simulated motion, node glow, animated\n// trace particles on the active path, a corner minimap) — pass an instance\n// returned by `createForceGraph2DRenderer()` and the widget never learns the\n// graphing library exists.\n//\n// ## Offline by design\n//\n// Unlike `three_renderer` (which lazy-loads `3d-force-graph` from a CDN), the\n// 2D library is **vendored locally** at `vendor/force-graph.module.js` (a\n// self-contained esbuild bundle of vasturiano/force-graph with every d3 /\n// lodash dependency inlined — zero bare imports, see vendor/README.md). The\n// default loader dynamic-imports that local path, so the renderer works with\n// no network at all. The import is still lazy (only on first mount) so pages\n// that never open a graph pay nothing.\n//\n// Tests inject `options.loader = () => Promise<ForceGraph>` so the node runner\n// never touches the vendored bundle or the DOM.\n//\n// ## Layout contract (shared with three_renderer)\n//\n//   • `memoray.lineage_graph` → positions carry { x, y, depth, node }\n//   • `kg3d.synoptic_web`     → positions carry { x, y, radius, layer, color, node }\n//   • `codegraph.canvas`      → positions carry { x, y, radius, type, color, node }\n//\n// `layoutToGraphData(layout, physics)` normalises all three into the\n// `{ nodes, links }` shape force-graph expects. Lineage positions carry no\n// colour/radius, so colour is derived from the node's `type` via the Memo-Ray\n// palette and size from a per-type default. `physics === \"pinned\"` fixes\n// fx/fy (frozen layout); `\"fluid\"` only seeds x/y and lets the simulation run\n// (the organic motion).\n//\n// ## Click / hover\n//\n// Both conventions are honoured: the per-mount `props.onSelect(id)` used by\n// the SVG renderers, and the factory `options.onNodeClick(id, node)` used by\n// the Bridge's `makeThreeRenderer`-style wiring. Whichever is present fires.\n\nconst DEFAULT_VENDOR_URL = new URL(\"./vendor/force-graph.module.js\", import.meta.url).href;\nconst DEFAULT_BACKGROUND = \"transparent\";\n\n// Memo-Ray organic palette, by node type (mirrors OrganicGraph.jsx PALETTE\n// and lineage_graph's NODE_TYPE_COLORS — earth tones, sage/moss/golden).\nconst PALETTE = {\n  \"User Input\": \"#b8a898\",\n  Thought: \"#8b9c8b\",\n  Message: \"#8b9c8b\",\n  \"Tool Call\": \"#6a8a6a\",\n  \"Tool Result\": \"#6a8a6a\",\n  Artifact: \"#8a9aa4\",\n  Session: \"#c4a882\",\n  \"System Init\": \"#5a6a5e\",\n  Error: \"#c47a6a\"\n};\nconst DEFAULT_NODE_COLOR = \"#6b7378\";\nconst HIGHLIGHT_COLOR = \"#db533f\"; // rust red, matches Memo-Ray\nconst LINK_COLOR = \"rgba(138,154,164,0.12)\";\nconst LABEL_COLOR = \"rgba(232,236,233,0.7)\";\nconst DEFAULT_NODE_VAL = 6;\n\nconst HTML_ESCAPES = { \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" };\nfunction escapeHtml(text) {\n  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n}\n\nfunction colorFor(entry) {\n  if (entry && typeof entry.color === \"string\" && entry.color) return entry.color;\n  const type = (entry && (entry.type || (entry.node && entry.node.type))) || null;\n  return (type && PALETTE[type]) || DEFAULT_NODE_COLOR;\n}\n\n// Last path segment, so a File node reads \"auth.py\" on the canvas instead of\n// the full \"/src/app/services/auth.py\". Trailing slashes are trimmed first.\nfunction basename(value) {\n  const str = String(value).replace(/[\\\\/]+$/, \"\");\n  const seg = str.split(/[\\\\/]/).pop();\n  return seg || str;\n}\n\nfunction looksLikePath(value) {\n  return typeof value === \"string\" && /[\\\\/]/.test(value) && !/\\s/.test(value);\n}\n\n// Human-readable label shown on the canvas. Mirrors the field priority each\n// widget's own SVG renderer uses, unified across all three graph shapes:\n//   • kg3d (Documents):  display_name → canonical_name → …\n//   • codegraph (Code):  name → label → path(basename) → …\n//   • memoray (Memory):  content / label / type\n// so nodes never fall back to a raw id or bare type when a real name exists.\nfunction labelFor(entry) {\n  const safe = entry && typeof entry === \"object\" ? entry : {};\n  const node = safe.node && typeof safe.node === \"object\" ? safe.node : {};\n  const named =\n    node.display_name ||\n    node.canonical_name ||\n    node.name ||\n    node.title ||\n    node.label ||\n    node.content ||\n    safe.label;\n  if (named) return basename(String(named).trim());\n  const path = node.path || safe.path;\n  if (path) return basename(path);\n  const id = safe.id || node.id;\n  if (id != null) return looksLikePath(id) ? basename(id) : String(id);\n  return node.type || safe.type || \"node\";\n}\