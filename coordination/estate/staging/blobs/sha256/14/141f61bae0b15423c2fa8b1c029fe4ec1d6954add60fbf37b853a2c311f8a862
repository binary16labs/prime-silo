tRef.current !== data.nodes.length;\n116\t\n117\t        prevSessionIdRef.current = sessionId;\n118\t        prevLayoutRef.current = layout;\n119\t        prevNodesCountRef.current = data.nodes.length;\n120\t\n121\t        if (layout === 'chronological') {\n122\t            // Sort nodes chronologically\n123\t            const sortedNodes = [...data.nodes].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));\n124\t            const total = sortedNodes.length;\n125\t\n126\t            sortedNodes.forEach((node, index) => {\n127\t                // Position nodes horizontally based on chronological index\n128\t                node.fx = (index - total / 2) * 80;\n129\t                \n130\t                // Keep the root Session node strictly at y=0, let other nodes spread out vertically\n131\t                if (node.type === 'Session') {\n132\t                    node.fy = 0;\n133\t                } else {\n134\t                    node.fy = undefined;\n135\t                }\n136\t            });\n137\t        } else if (layoutChanged || sessionChanged) {\n138\t            // Clear fixed coordinates so the force simulation can arrange organically\n139\t            data.nodes.forEach(node => {\n140\t                node.fx = undefined;\n141\t                node.fy = undefined;\n142\t            });\n143\t        }\n144\t\n145\t        if (fgRef.current) {\n146\t            // Only reheat simulation if the layout, session, or node count changed\n147\t            if (layoutChanged || sessionChanged || nodesCountChanged) {\n148\t                fgRef.current.d3ReheatSimulation();\n149\t            }\n150\t\n151\t            // Only zoom to fit when the session changes, layout changes, or on initial load\n152\t            if (sessionChanged || layoutChanged || !hasSettleZoomedRef.current) {\n153\t                hasSettleZoomedRef.current = true;\n154\t                setTimeout(() => {\n155\t                    if (fgRef.current) fgRef.current.zoomToFit(400, 60);\n156\t                }, 300);\n157\t            }\n158\t        }\n159\t    }, [layout, data, useWindow]);\n160\t\n161\t    const passesFilter = useCallback((node) => {\n162\t        if (node.type === 'User Input' && !filters.showUser) return false;\n163\t        if ((node.type === 'Thought' || node.type === 'Message') && !filters.showAgent) return false;\n164\t        if ((node.type === 'Tool Call' || node.type === 'Tool Result') && !filters.showTools) return false;\n165\t        if (node.type === 'Artifact' && !filters.showArtifacts) return false;\n166\t        return true;\n167\t    }, [filters]);\n168\t\n169\t    // Filtered data fed to the renderer. In windowed mode this is only the slice\n170\t    // of nodes around the focused step (everything else stays loaded for the\n171\t    // minimap + stepping); otherwise it's the whole filtered graph.\n172\t    const graphData = useMemo(() => {\n173\t        if (!data?.nodes) return { nodes: [], links: [] };\n174\t\n175\t        let candidateNodes;\n176\t        if (useWindow) {\n177\t            const focusId = activeHighlightIds[0];\n178\t            let fi = focusId ? ordered.findIndex(n => n.id === focusId) : -1;\n179\t            if (fi < 0) fi = ordered.length - 1;\n180\t            const lo = Math.max(0, fi - RENDER_WINDOW);\n181\t            const hi = Math.min(ordered.length, fi + RENDER_WINDOW + 1);\n182\t            candidateNodes = ordered.slice(lo, hi);\n183\t        } else {\n184\t            candidateNodes = data.nodes;\n185\t        }\n186\t\n187\t        const filteredNodes = candidateNodes.filter(passesFilter);\n188\t        const nodeIds = new Set(filteredNodes.map(n => n.id));\n189\t        const filteredLinks = (data.links || []).filter(l => {\n190\t            const src = typeof l.source === 'object' ? l.source.id : l.source;\n191\t            const tgt = typeof l.target === 'object' ? l.target.id : l.target;\n192\t            return nodeIds.has(src) && nodeIds.has(tgt);\n193\t        });\n194\t\n195\t        return { nodes: filteredNodes, links: filteredLinks };\n196\t    }, [data, passesFilter, useWindow, ordered, activeHighlightIds]);\n197\t\n198\t    // Note: changing activeHighlightIds gives paintNode (nodeCanvasObject) a new\n199\t    // identity, which makes ForceGraph2D redraw the canvas on its own. There is no\n200\t    // imperative refresh() method on the react-force-graph-2d ref, so we must not\n201\t    // call one here — doing so throws and unmounts the whole graph.\n202\t\n203\t    // Trace follow: in TRACKING mode, pan/zoom the camera to the active node so\n204\t    // stepping (or playback) moves the spotlight onto the current node. In FREE\n205\t    // ROAM mode we never touch the camera, so the user can compose cinematic\n206\t    // shots / pan freely while playback runs. Node positions (x/y) are only\n207\t    // available after the force sim has ticked, so we retry briefly if needed.\n208\t    useEffect(() => {\n209\t        if (!trackingMode) return;\n210\t        if (!fgRef.current || activeHighlightIds.length === 0) return;\n211\t        const targetId = activeHighlightIds[0];\n212\t        let cancelled = false;\n213\t        let attempts = 0;\n214\t\n215\t        const focus = () => {\n216\t            if (cancelled || !fgRef.current) return false;\n217\t            const node = graphData.nodes.find(n => n.id === targetId);\n218\t            const px = node && (node.x ?? node.fx);\n219\t            const py = node && (node.y ?? node.fy);\n220\t            if (typeof px === 'number' && typeof py === 'number') {\n221\t                // Center the camera on the focused node and zoom to a readable\n222\t                // level. We do this INSTANTLY (0ms) rather than animated: when the\n223\t                // render window slides each step the graph re-inits and resets the\n224\t                // camera, and an animated centerAt loses that race. Instant + a few\n225\t                // re-applies below reliably lands the spotlight on the node.\n226\t                if (fgRef.current.zoom() < TRACE_ZOOM) fgRef.current.zoom(TRACE_ZOOM, 0);\n227\t                fgRef.current.centerAt(px, py, 0);\n228\t                // Windowed only: nudge a repaint after the camera move (a cooled\n229\t                // canvas may not redraw on a programmatic pan). Safe because every\n230\t                // node is pinned, so reheating moves nothing. Organic mode already\n231\t                // repaints via the paintNode identity change on highlight.\n232\t                if (useWindow) fgRef.current.d3ReheatSimulation();\n233\t                return true;\n234\t            }\n235\t            return false;\n236\t        };\n237\t\n238\t        // Apply immediately, then re-apply across the next few frames to override\n239\t        // any camera reset triggered by the window's graphData changing.\n240\t        const positioned = focus();\n241\t        const timers = [60, 180, 320, 500].map(d => setTimeout(focus, d));\n242\t        if (!positioned) {\n243\t            // Node not placed yet — keep trying a little longer.\n244\t            const timer = setInterval(() => {\n245\t                attempts += 1;\n246\t                if (focus() || attempts >= 8) clearInterval(timer);\n247\t            }, 250);\n248\t            timers.push(timer);\n249\t        }\n250\t        return () => { cancelled = true; timers.forEach(t => { clearTimeout(t); clearInterval(t); }); };\n251\t    }, [activeHighlightIds, graphData, trackingMode, useWindow]);\n252\t\n253\t    // Graph lock: freeze node positions so the layout stops drifting/wiggling\n254\t    // when idle. Toggling the lock ON pins every node where it currently sits;\n255\t    // toggling OFF releases them and re-runs the force layout so the user can\n256\t    // rearrange. (New layouts are also pinned once they settle — see\n257\t    // handleEngineStop below — which keeps the trace-follow camera stable.)\n258\t    useEffect(() => {\n259\t        const fg = fgRef.current;\n260\t        if (!fg || !data?.nodes || useWindow) return; // windowed = already fixed positions\n261\t        if (locked) {\n262\t            data.nodes.forEach(n => {\n263\t                if (typeof n.x === 'number') { n.fx = n.x; n.fy = n.y; }\n264\t            });\n265\t        } else if (layout !== 'chronological') {\n266\t            data.nodes.forEach(n => { n.fx = undefined; n.fy = undefined; });\n267\t            fg.d3ReheatSimulation();\n268\t        }\n269\t        // eslint-disable-next-line react-hooks/exhaustive-deps\n270\t    }, [locked]);\n271\t\n272\t    // Once a fresh layout settles, pin it in place if the graph is locked so it\n273\t    // never drifts again (and the followed node stays put under the camera).\n274\t    const handleEngineStop = useCallback(() => {\n275\t        if (!locked || !data?.nodes || useWindow) return;\n276\t        data.nodes.forEach(n => {\n277\t            if (typeof n.x === 'number') { n.fx = n.x; n.fy = n.y; }\n278\t        });\n279\t    }, [locked, data, useWindow]);\n280\t\n281\t    // Minimap: in tracking mode, draw a downscaled overview of the WHOLE graph\n282\t    // (every node, no cap) with the current node highlighted and a rectangle for\n283\t    // the visible viewport — so the user keeps full spatial awareness of where\n284\t    // the close-up camera is within the complete session.\n285\t    useEffect(() => {\n286\t        if (!trackingMode) return;\n287\t        const draw = () => {\n288\t            const cv = minimapRef.current;\n289\t            if (!cv) return;\n290\t            const ctx = cv.getContext('2d');\n291\t            const W = cv.width, H = cv.height;\n292\t            ctx.clearRect(0, 0, W, H);\n293\t            ctx.fillStyle = 'rgba(18,22,20,0.82)';\n294\t            ctx.fillRect(0, 0, W, H);\n295\t\n296\t            // Windowed mode: show ALL nodes (deterministic fx/fy) for full\n297\t            // awareness. Organic mode: show the simulated nodes (x/y).\n298\t            const source = useWindow ? ordered : graphData.nodes;\n299\t            const posX = n => (typeof n.x === 'number' ? n.x : n.fx);\n300\t            const posY = n => (typeof n.y === 'number' ? n.y : n.fy);\n301\t            const nodes = source.filter(n => typeof posX(n) === 'number' && typeof posY(n) === 'number');\n302\t            if (!nodes.length) return;\n303\t            let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n304\t            for (const n of nodes) {\n305\t                const x = posX(n), y = posY(n);\n306\t                if (x < minX) minX = x; if (x > maxX) maxX = x;\n307\t                if (y < minY) minY = y; if (y > maxY) maxY = y;\n308\t            }\n309\t            const pad = 6, gw = (maxX - minX) || 1, gh = (maxY - minY) || 1;\n310\t            const scale = Math.min((W - 2 * pad) / gw, (H - 2 * pad) / gh);\n311\t            const ox = (W - gw * scale) / 2, oy = (H - gh * scale) / 2;\n312\t            const tx = x => ox + (x - minX) * scale;\n313\t            const ty = y => oy + (y - minY) * scale;\n314\t\n315\t            for (const n of nodes) {\n316\t                const hl = activeHighlightIds.includes(n.id);\n317\t                ctx.beginPath();\n318\t                ctx.arc(tx(posX(n)), ty(posY(n)), hl ? 3 : 1, 0, 2 * Math.PI);\n319\t                ctx.fillStyle = hl ? '#db533f' : (PALETTE[n.type] || '#5a6a5e');\n320\t                ctx.fill();\n321\t            }\n322\t\n323\t            // Viewport rectangle (where the main camera is looking)\n324\t            if (fgRef.current) {\n325\t                try {\n326\t                    const c = fgRef.current.centerAt();\n327\t                    const k = fgRef.current.zoom();\n328\t                    if (c && k) {\n329\t                        const vw = dimensions.width / k, vh = dimensions.height / k;\n330\t                        ctx.strokeStyle = 'rgba(232,236,233,0.55)';\n331\t                        ctx.lineWidth = 1;\n332\t                        ctx.strokeRect(tx(c.x - vw / 2), ty(c.y - vh / 2), vw * scale, vh * scale);\n333\t                    }\n334\t                } catch { /* center/zoom not ready */ }\n335\t            }\n336\t        };\n337\t        draw();\n338\t        const iv = setInterval(draw, 300);\n339\t        return () => clearInterval(iv);\n340\t    }, [trackingMode, graphData, ordered, useWindow, activeHighlightIds, dimensions]);\n341\t\n342\t    const paintNode = useCallback((node, ctx, globalScale) => {\n343\t        const isHighlighted = activeHighlightIds.includes(node.id);\n344\t        const color = isHighlighted ? '#db533f' : (PALETTE[node.type] || '#5a6a5e'); // Rust red highlight\n345\t        const size = (node.val || 6) * (isHighlighted ? 2.2 : 1); // Enlarged when in active scope\n346\t        const label = node.label || node.type;\n347\t\n348\t        ctx.save();\n349\t\n350\t        // Glow for Session, Artifact, and highlighted nodes\n351\t        if (node.type === 'Session' || node.type === 'Artifact' || isHighlighted) {\n352\t            ctx.shadowColor = isHighlighted ? '#db533f' : color;\n353\t            ctx.shadowBlur = isHighlighted ? 36 : 12; // Much larger blur for highlights\n354\t        }\n355\t\n356\t        ctx.beginPath();\n357\t        if (node.type === 'Artifact') {\n358\t            // Rounded rectangle\n359\t            const r = size * 0.4;\n360\t            const x = node.x - size;\n361\t            const y = node.y - size;\n362\t            const w = size * 2;\n363\t            const h = size * 2;\n364\t            ctx.moveTo(x + r, y);\n365\t            ctx.arcTo(x + w, y, x + w, y + h, r);\n366\t            ctx.arcTo(x + w, y + h, x, y + h, r);\n367\t            ctx.arcTo(x, y + h, x, y, r);\n368\t            ctx.arcTo(x, y, x + w, y, r);\n369\t        } else {\n370\t            ctx.arc(node.x, node.y, size, 0, 2 * Math.PI);\n371\t        }\n372\t\n373\t        ctx.fillStyle = color;\n374\t        ctx.globalAlpha = isHighlighted ? 1.0 : 0.85;\n375\t        ctx.fill();\n376\t        ctx.globalAlpha = 1;\n377\t\n378\t        // Membrane\n379\t        ctx.lineWidth = Math.max(size * 0.12, 0.5);\n380\t        ctx.strokeStyle = isHighlighted ? 'rgba(255, 255, 255, 0.9)' : `rgba(232,236,233,${node.type === 'Session' ? 0.4 : 0.15})`;\n381\t        ctx.stroke();\n382\t\n383\t        ctx.restore();\n384\t\n385\t        // Extra targeting ring for highlighted nodes to make them SUPER obvious\n386\t        if (isHighlighted) {\n387\t            ctx.save();\n388\t            ctx.beginPath();\n389\t            const pulse = Math.sin(Date.now() / 250) * 0.5 + 0.5; // slow pulse between 0 and 1\n390\t            const pulseRadius = size * (1.2 + pulse * 0.5); // Radiates outwards from size*1.2 to size*1.7\n391\t            ctx.arc(node.x, node.y, pulseRadius, 0, 2 * Math.PI);\n392\t            ctx.strokeStyle = '#db533f';\n393\t            ctx.lineWidth = 1.5 / globalScale; // Keep stroke thin even when zoomed in\n394\t            ctx.globalAlpha = 0.6 - pulse * 0.45; // fade out as it radiates outward\n395\t            ctx.stroke();\n396\t            ctx.restore();\n397\t        }\n398\t\n399\t        // Labels at zoom or if highlighted\n400\t        if (globalScale > 1.2 || isHighlighted) {\n401\t            const fontSize = Math.max(10 / globalScale, 5);\n402\t            ctx.font = isHighlighted ? `bold ${fontSize + 1}px Inter, system-ui` : `500 ${fontSize}px Inter, system-ui`;\n403\t            ctx.textAlign = 'center';\n404\t            ctx.textBaseline = 'top';\n405\t            ctx.fillStyle = isHighlighted ? '#db533f' : 'rgba(232,236,233,0.7)';\n406\t            const maxChars = Math.floor(20 * Math.min(globalScale / 2, 1.5));\n407\t            const text = label.length > maxChars ? label.substring(0, maxChars) + '…' : label;\n408\t            ctx.fillText(text, node.x, node.y + size + 2);\n409\t        }\n410\t    }, [activeHighlightIds]);\n411\t\n412\t    useEffect(() => {\n413\t        if (fgRef.current && graphData.nodes.length > 0 && !hasInitializedForces.current) {\n414\t            hasInitializedForces.current = true;\n415\t            fgRef.current.d3Force('charge')?.strength(-300);\n416\t            fgRef.current.d3Force('link')?.distance(50);\n417\t        }\n418\t    }, [graphData]);\n419\t\n420\t    return (\n421\t        <div className=\"graph-container\" ref={containerRef}>\n422\t            <ForceGraph2D\n423\t                ref={fgRef}\n424\t                width={dimensions.width}\n425\t                height={dimensions.height}\n426\t                graphData={graphData}\n427\t                onEngineStop={handleEngineStop}\n428\t                nodeCanvasObject={paintNode}\n429\t                onNodeHover={onNodeHover}\n430\t                onNodeClick={onNodeClick}\n431\t                onBackgroundClick={onBackgroundClick}\n432\t                nodePointerAreaPaint={(node, color, ctx) => {\n433\t                    ctx.fillStyle = color;\n434\t                    ctx.beginPath();\n435\t                    ctx.arc(node.x, node.y, (node.val || 6) * 1.5, 0, 2 * Math.PI);\n436\t                    ctx.fill();\n437\t                }}\n438\t                linkColor={link => {\n439\t                    const srcId = typeof link.source === 'object' ? link.source.id : link.source;\n440\t                    const tgtId = typeof link.target === 'object' ? link.target.id : link.target;\n441\t                    const isSourceHighlighted = activeHighlightIds.includes(srcId);\n442\t                    const isTargetHighlighted = activeHighlightIds.includes(tgtId);\n443\t                    if (isSourceHighlighted && isTargetHighlighted) {\n444\t                        return 'rgba(219, 83, 63, 0.95)'; // bright rust red between active nodes\n445\t                    }\n446\t                    if (isSourceHighlighted || isTargetHighlighted) {\n447\t                        return 'rgba(219, 83, 63, 0.4)'; // glowing rust red\n448\t                    }\n449\t                    return 'rgba(138,154,164,0.12)';\n450\t                }}\n451\t                linkWidth={link => {\n452\t                    const srcId = typeof link.source === 'object' ? link.source.id : link.source;\n453\t                    const tgtId = typeof link.target === 'object' ? link.target.id : link.target;\n454\t                    const isSourceHighlighted = activeHighlightIds.includes(srcId);\n455\t                    const isTargetHighlighted = activeHighlightIds.includes(tgtId);\n456\t                    return (isSourceHighlighted || isTargetHighlighted) ? 3 : 1;\n457\t                }}\n458\t                linkDirectionalParticles={link => {\n459\t                    const srcId = typeof link.source === 'object' ? link.source.id : link.source;\n460\t                    const tgtId = typeof link.target === 'object' ? link.target.id : link.target;\n461\t                    const isSourceHighlighted = activeHighlightIds.includes(srcId);\n462\t                    const isTargetHighlighted = activeHighlightIds.includes(tgtId);\n463\t                    // Only the active trace path animates. Giving every link a\n464\t                    // particle kept the canvas redrawing forever (no idle frame),\n465\t                    // which tanked performance on large graphs and pinned the CPU.\n466\t                    return (isSourceHighlighted || isTargetHighlighted) ? 4 : 0;\n467\t                }}\n468\t                linkDirectionalParticleWidth={link => {\n469\t                    const srcId = typeof link.source === 'object' ? link.source.id : link.source;\n470\t                    const tgtId = typeof link.target === 'object' ? link.target.id : link.target;\n471\t                    const isSourceHighlighted = activeHighlightIds.includes(srcId);\n472\t                    const isTargetHighlighted = activeHighlightIds.includes(tgtId);\n473\t                    return (isSourceHighlighted || isTargetHighlighted) ? 4 : 2;\n474\t                }}\n475\t                linkDirectionalParticleSpeed={link => {\n476\t                    const srcId = typeof link.source === 'object' ? link.source.id : link.source;\n477\t                    const tgtId = typeof link.target === 'object' ? link.target.id : link.target;\n478\t                    const isSourceHighlighted = activeHighlightIds.includes(srcId);\n479\t                    const isTargetHighlighted = activeHighlightIds.includes(tgtId);\n480\t                    return (isSourceHighlighted || isTargetHighlighted) ? 0.015 : 0.004;\n481\t                }}\n482\t                linkDirectionalParticleColor={link => {\n483\t                    const srcId = typeof link.source === 'object' ? link.source.id : link.source;\n484\t                    const tgtId = typeof link.target === 'object' ? link.target.id : link.target;\n485\t                    const isSourceHighlighted = activeHighlightIds.includes(srcId);\n486\t                    const isTargetHighlighted = activeHighlightIds.includes(tgtId);\n487\t                    return (isSourceHighlighted || isTargetHighlighted) ? 'rgba(219, 83, 63, 0.85)' : 'rgba(139,156,139,0.5)';\n488\t                }}\n489\t                d3VelocityDecay={0.25}\n490\t                warmupTicks={50}\n491\t                cooldownTime={3000}\n492\t                backgroundColor=\"transparent\"\n493\t                enableZoomInteraction={true}\n494\t                enablePanInteraction={true}\n495\t            />\n496\t\n497\t            {/* Full-graph minimap (tracking mode only) — keeps spatial awareness\n498\t                of the whole session while the main camera is zoomed in. */}\n499\t            {trackingMode && (\n500\t                <div style={{\n501\t                    position: 'absolute', bottom: 12, right: 12, zIndex: 10,\n502\t                    border: '1px solid rgba(232,236,233,0.18)', borderRadius: 6,\n503\t                    overflow: 'hidden', boxShadow: '0 4px 16px rgba(0,0,0,0.45)',\n504\t                    pointerEvents: 'none'\n505\t                }}>\n506\t                    <canvas ref={minimapRef} width={210} height={140} style={{ display: 'block' }} />\n507\t                    <div style={{\n508\t                        position: 'absolute', top: 4, left: 6, fontSize: 9,\n509\t                        letterSpacing: '0.08em', textTransform: 'uppercase',\n510\t                        color: 'rgba(232,236,233,0.55)', fontFamily: 'Inter, system-ui'\n511\t                    }}>Map</div>\n512\t                </div>\n513\t            )}\n514\t        </div>\n515\t    );\n516\t}\n517\t"}]},"uuid":"e6fe3424-e568-4bc3-af63-7d21773450e0","timestamp":"2026-06-24T17:49:23.302Z","toolUseResult":{"type":"text","file":{"filePath":"C:\\Users\\nsdha\\OneDrive\\binary16\\memo-ray\\agent-os-dashboard\\client\\src\\components\\OrganicGraph.jsx","content":"import React, { useRef, useEffect, useState, useCallback, useMemo } from 'react';\nimport ForceGraph2D from 'react-force-graph-2d';\n\n// Zoom level the trace-follow animates to so a highlighted node is clearly\n// visible (above the 1.2 threshold where node labels render).\nconst TRACE_ZOOM = 2.5;\n\n// Above this many nodes we switch from a force-simulated organic layout (which\n// settles slowly and renders poorly past a couple thousand nodes) to a stable\n// windowed layout: every node gets a deterministic position and only a window\n// around the current step is fed to the renderer. All nodes stay loaded and\n// auditable (step anywhere, the window follows) and the minimap shows them all.\nconst WINDOW_THRESHOLD = 500;\nconst RENDER_WINDOW = 140;   // nodes rendered on each side of the focused step\nconst NODE_GAP = 70;         // horizontal spacing between consecutive steps\nconst TYPE_LANES = {\n    'User Input': -2, 'Session': 0, 'Thought': 1, 'Message': 1,\n    'Tool Call': 2, 'Tool Result': 3, 'Artifact': -1, 'Error': 4, 'System Init': 0,\n};\n\nconst PALETTE = {\n  'User Input': '#b8a898',\n  'Thought':    '#8b9c8b',\n  'Message':    '#8b9c8b',\n  'Tool Call':  '#6a8a6a',\n  'Tool Result':'#6a8a6a',\n  'Artifact':   '#8a9aa4',\n  'Session':    '#c4a882',\n  'System Init':'#5a6a5e',\n  'Error':      '#c47a6a',\n};\n\nexport default function OrganicGraph({ data, filters = { showUser: true, showAgent: true, showTools: true, showArtifacts: true }, onNodeHover, onNodeClick, onBackgroundClick, highlightNodeIds = [], highlightNodeId = null, layout = 'organic', trackingMode = true, locked = false }) {\n    const fgRef = useRef();\n    const containerRef = useRef();\n    const minimapRef = useRef();\n    const [dimensions, setDimensions] = useState({ width: 800, height: 600 });\n\n    const prevSessionIdRef = useRef(null);\n    const prevLayoutRef = useRef(layout);\n    const prevNodesCountRef = useRef(0);\n    const hasSettleZoomedRef = useRef(false);\n    const hasInitializedForces = useRef(false);\n\n    const activeHighlightIds = useMemo(() => {\n        if (Array.isArray(highlightNodeIds)) return highlightNodeIds.filter(Boolean);\n        if (highlightNodeIds) return [highlightNodeIds];\n        if (highlightNodeId) return [highlightNodeId];\n        return [];\n    }, [highlightNodeIds, highlightNodeId]);\n\n    // For big sessions, switch to the windowed/deterministic strategy.\n    const useWindow = (data?.nodes?.length || 0) > WINDOW_THRESHOLD;\n\n    // Stable chronological ordering of the WHOLE graph. When windowing, every\n    // node also gets a fixed (fx, fy) so positions never drift as the window\n    // slides — the renderer just shows/hides nodes at their permanent spots.\n    const ordered = useMemo(() => {\n        if (!data?.nodes) return [];\n        const arr = [...data.nodes].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));\n        if (useWindow) {\n            const total = arr.length;\n            arr.forEach((n, i) => {\n                n.__idx = i;\n                n.fx = (i - total / 2) * NODE_GAP;\n                n.fy = (TYPE_LANES[n.type] ?? 0) * 55;\n            });\n        }\n        return arr;\n    }, [data, useWindow]);\n\n    // Measure actual container. A ResizeObserver tracks the element's real size\n    // after every layout pass — important for fullscreen/maximize, where a plain\n    // window-resize handler can read the old height before reflow finishes and\n    // leave the canvas filling only part of the screen.\n    useEffect(() => {\n        const measure = () => {\n            if (containerRef.current) {\n                const rect = containerRef.current.getBoundingClientRect();\n                if (rect.width > 0 && rect.height > 0) {\n                    setDimensions({ width: rect.width, height: rect.height });\n                }\n            }\n        };\n        measure();\n\n        let ro;\n        if (typeof ResizeObserver !== 'undefined' && containerRef.current) {\n            ro = new ResizeObserver(() => measure());\n            ro.observe(containerRef.current);\n        }\n        // Re-measure on the next frame too, so we catch the post-fullscreen layout.\n        const onResize = () => { measure(); requestAnimationFrame(measure); };\n        window.addEventListener('resize', onResize);\n        document.addEventListener('fullscreenchange', onResize);\n        return () => {\n            if (ro) ro.disconnect();\n            window.removeEventListener('resize', onResize);\n            document.removeEventListener('fullscreenchange', onResize);\n        };\n    }, []);\n\n    // Handle organic vs chronological layout\n    useEffect(() => {\n        if (!data?.nodes || data.nodes.length === 0) return;\n        // Windowed mode uses fixed deterministic positions — no force layout,\n        // no reheat, no fit (the trace camera handles framing). Skip all of it.\n        if (useWindow) return;\n\n        const sessionNode = data.nodes.find(n => n.type === 'Session');\n        const sessionId = sessionNode ? sessionNode.id : null;\n\n        const sessionChanged = prevSessionIdRef.current !== sessionId;\n        const layoutChanged = prevLayoutRef.current !== layout;\n        const nodesCountChanged = prevNodesCountRef.current !== data.nodes.length;\n\n        prevSessionIdRef.current = sessionId;\n        prevLayoutRef.current = layout;\n        prevNodesCountRef.current = data.nodes.length;\n\n        if (layout === 'chronological') {\n            // Sort nodes chronologically\n            const sortedNodes = [...data.nodes].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));\n            const total = sortedNodes.length;\n\n            sortedNodes.forEach((node, index) => {\n                // Position nodes horizontally based on chronological index\n                node.fx = (index - total / 2) * 80;\n                \n                // Keep the root Session node strictly at y=0, let other nodes spread out vertically\n                if (node.type === 'Session') {\n                    node.fy = 0;\n                } else {\n                    node.fy = undefined;\n                }\n            });\n        } else if (layoutChanged || sessionChanged) {\n            // Clear fixed coordinates so the force simulation can arrange organically\n            data.nodes.forEach(node => {\n                node.fx = undefined;\n                node.fy = undefined;\n            });\n        }\n\n        if (fgRef.current) {\n            // Only reheat simulation if the layout, session, or node count changed\n            if (layoutChanged || sessionChanged || nodesCountChanged) {\n                fgRef.current.d3ReheatSimulation();\n            }\n\n            // Only zoom to fit when the session changes, layout changes, or on initial load\n            if (sessionChanged || layoutChanged || !hasSettleZoomedRef.current) {\n                hasSettleZoomedRef.current = true;\n                setTimeout(() => {\n                    if (fgRef.current) fgRef.current.zoomToFit(400, 60);\n                }, 300);\n            }\n        }\n    }, [layout, data, useWindow]);\n\n    const passesFilter = useCallback((node) => {\n        if (node.type === 'User Input' && !filters.showUser) return false;\n        if ((node.type === 'Thought' || node.type === 'Message') && !filters.showAgent) return false;\n        if ((node.type === 'Tool Call' || node.type === 'Tool Result') && !filters.showTools) return false;\n        if (node.type === 'Artifact' && !filters.showArtifacts) return false;\n        return true;\n    }, [filters]);\n\n    // Filtered data fed to the renderer. In windowed mode this is only the slice\n    // of nodes around the focused step (everything else stays loaded for the\n    // minimap + stepping); otherwise it's the whole filtered graph.\n    const graphData = useMemo(() => {\n        if (!data?.nodes) return { nodes: [], links: [] };\n\n        let candidateNodes;\n        if (useWindow) {\n            const focusId = activeHighlightIds[0];\n            let fi = focusId ? ordered.findIndex(n => n.id === focusId) : -1;\n            if (fi < 0) fi = ordered.length - 1;\n            const lo = Math.max(0, fi - RENDER_WINDOW);\n            const hi = Math.min(ordered.length, fi + RENDER_WINDOW + 1);\n            candidateNodes = ordered.slice(lo, hi);\n        } else {\n            candidateNodes = data.nodes;\n        }\n\n        const filteredNodes = candidateNodes.filter(passesFilter);\n        const nodeIds = new Set(filteredNodes.map(n => n.id));\n        const filteredLinks = (data.links || []).filter(l => {\n            const src = typeof l.source === 'object' ? l.source.id : l.source;\n            const tgt = typeof l.target === 'object' ? l.target.id : l.target;\n            return nodeIds.has(src) && nodeIds.has(tgt);\n        });\n\n        return { nodes: filteredNodes, links: filteredLinks };\n    }, [data, passesFilter, useWindow, ordered, activeHighlightIds]);\n\n    // Note: changing activeHighlightIds gives paintNode (nodeCanvasObject) a new\n    // identity, which makes ForceGraph2D redraw the canvas on its own. There is no\n    // imperative refresh() method on the react-force-graph-2d ref, so we must not\n    // call one here — doing so throws and unmounts the whole graph.\n\n    // Trace follow: in TRACKING mode, pan/zoom the camera to the active node so\n    // stepping (or playback) moves the spotlight onto the current node. In FREE\n    // ROAM mode we never touch the camera, so the user can compose cinematic\n    // shots / pan freely while playback runs. Node positions (x/y) are only\n    // available after the force sim has ticked, so we retry briefly if needed.\n    useEffect(() => {\n        if (!trackingMode) return;\n        if (!fgRef.current || activeHighlightIds.length === 0) return;\n        const targetId = activeHighlightIds[0];\n        let cancelled = false;\n        let attempts = 0;\n\n        const focus = () => {\n            if (cancelled || !fgRef.current) return false;\n            const node = graphData.nodes.find(n => n.id === targetId);\n            const px = node && (node.x ?? node.fx);\n            const py = node && (node.y ?? node.fy);\n            if (typeof px === 'number' && typeof py === 'number') {\n                // Center the camera on the focused node and zoom to a readable\n                // level. We do this INSTANTLY (0ms) rather than animated: when the\n                // render window slides each step the graph re-inits and resets the\n                // camera, and an animated centerAt loses that race. Instant + a few\n                // re-applies below reliably lands the spotlight on the node.\n                if (fgRef.current.zoom() < TRACE_ZOOM) fgRef.current.zoom(TRACE_ZOOM, 0);\n                fgRef.current.centerAt(px, py, 0);\n                // Windowed only: nudge a repaint after the camera move (a cooled\n                // canvas may not redraw on a programmatic pan). Safe because every\n                // node is pinned, so reheating moves nothing. Organic mode already\n                // repaints via the paintNode identity change on highlight.\n                if (useWindow) fgRef.current.d3ReheatSimulation();\n                return true;\n            }\n            return false;\n        };\n\n        // Apply immediately, then re-apply across the next few frames to override\n        // any camera reset triggered by the window's graphData changing.\n        const positioned = focus();\n        const timers = [60, 180, 320, 500].map(d => setTimeout(focus, d));\n        if (!positioned) {\n            // Node not placed yet — keep trying a little longer.\n            const timer = setInterval(() => {\n                attempts += 1;\n                if (focus() || attempts >= 8) clearInterval(timer);\n            }, 250);\n            timers.push(timer);\n        }\n        return () => { cancelled = true; timers.forEach(t => { clearTimeout(t); clearInterval(t); }); };\n    }, [activeHighlightIds, graphData, trackingMode, useWindow]);\n\n    // Graph lock: freeze node positions so the layout stops drifting/wiggling\n    // when idle. Toggling the lock ON pins every node where it currently sits;\n    // toggling OFF releases them and re-runs the force layout so the user can\n    // rearrange. (New layouts are also pinned once they settle — see\n    // handleEngineStop below — which keeps the trace-follow camera stable.)\n    useEffect(() => {\n        const fg = fgRef.current;\n        if (!fg || !data?.nodes || useWindow) return; // windowed = already fixed positions\n        if (locked) {\n            data.nodes.forEach(n => {\n                if (typeof n.x === 'number') { n.fx = n.x; n.fy = n.y; }\n            });\n        } else if (layout !== 'chronological') {\n            data.nodes.forEach(n => { n.fx = undefined; n.fy = undefined; });\n            fg.d3ReheatSimulation();\n        }\n        // eslint-disable-next-line react-hooks/exhaustive-deps\n    }, [locked]);\n\n    // Once a fresh layout set