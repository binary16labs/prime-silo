{"parentUuid":"de879e67-278c-4508-955b-fc098026a497","isSidechain":false,"promptId":"650baa53-104c-4677-b61d-469b8b62c13b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ZkTbWbf3opXL5vV8h3VPk","type":"tool_result","content":"1\timport React, { useRef, useEffect, useState, useCallback, useMemo } from 'react';\n2\timport ForceGraph2D from 'react-force-graph-2d';\n3\t\n4\t// Zoom level the trace-follow animates to so a highlighted node is clearly\n5\t// visible (above the 1.2 threshold where node labels render).\n6\tconst TRACE_ZOOM = 2.5;\n7\t\n8\t// Above this many nodes we switch from a force-simulated organic layout (which\n9\t// settles slowly and renders poorly past a couple thousand nodes) to a stable\n10\t// windowed layout: every node gets a deterministic position and only a window\n11\t// around the current step is fed to the renderer. All nodes stay loaded and\n12\t// auditable (step anywhere, the window follows) and the minimap shows them all.\n13\tconst WINDOW_THRESHOLD = 500;\n14\tconst RENDER_WINDOW = 140;   // nodes rendered on each side of the focused step\n15\tconst NODE_GAP = 70;         // horizontal spacing between consecutive steps\n16\tconst TYPE_LANES = {\n17\t    'User Input': -2, 'Session': 0, 'Thought': 1, 'Message': 1,\n18\t    'Tool Call': 2, 'Tool Result': 3, 'Artifact': -1, 'Error': 4, 'System Init': 0,\n19\t};\n20\t\n21\tconst PALETTE = {\n22\t  'User Input': '#b8a898',\n23\t  'Thought':    '#8b9c8b',\n24\t  'Message':    '#8b9c8b',\n25\t  'Tool Call':  '#6a8a6a',\n26\t  'Tool Result':'#6a8a6a',\n27\t  'Artifact':   '#8a9aa4',\n28\t  'Session':    '#c4a882',\n29\t  'System Init':'#5a6a5e',\n30\t  'Error':      '#c47a6a',\n31\t};\n32\t\n33\texport default function OrganicGraph({ data, filters = { showUser: true, showAgent: true, showTools: true, showArtifacts: true }, onNodeHover, onNodeClick, onBackgroundClick, highlightNodeIds = [], highlightNodeId = null, layout = 'organic', trackingMode = true, locked = false }) {\n34\t    const fgRef = useRef();\n35\t    const containerRef = useRef();\n36\t    const minimapRef = useRef();\n37\t    const [dimensions, setDimensions] = useState({ width: 800, height: 600 });\n38\t\n39\t    const prevSessionIdRef = useRef(null);\n40\t    const prevLayoutRef = useRef(layout);\n41\t    const prevNodesCountRef = useRef(0);\n42\t    const hasSettleZoomedRef = useRef(false);\n43\t    const hasInitializedForces = useRef(false);\n44\t\n45\t    const activeHighlightIds = useMemo(() => {\n46\t        if (Array.isArray(highlightNodeIds)) return highlightNodeIds.filter(Boolean);\n47\t        if (highlightNodeIds) return [highlightNodeIds];\n48\t        if (highlightNodeId) return [highlightNodeId];\n49\t        return [];\n50\t    }, [highlightNodeIds, highlightNodeId]);\n51\t\n52\t    // For big sessions, switch to the windowed/deterministic strategy.\n53\t    const useWindow = (data?.nodes?.length || 0) > WINDOW_THRESHOLD;\n54\t\n55\t    // Stable chronological ordering of the WHOLE graph. When windowing, every\n56\t    // node also gets a fixed (fx, fy) so positions never drift as the window\n57\t    // slides — the renderer just shows/hides nodes at their permanent spots.\n58\t    const ordered = useMemo(() => {\n59\t        if (!data?.nodes) return [];\n60\t        const arr = [...data.nodes].sort((a, b) => (a.timestamp || 0) - (b.timestamp || 0));\n61\t        if (useWindow) {\n62\t            const total = arr.length;\n63\t            arr.forEach((n, i) => {\n64\t                n.__idx = i;\n65\t                n.fx = (i - total / 2) * NODE_GAP;\n66\t                n.fy = (TYPE_LANES[n.type] ?? 0) * 55;\n67\t            });\n68\t        }\n69\t        return arr;\n70\t    }, [data, useWindow]);\n71\t\n72\t    // Measure actual container. A ResizeObserver tracks the element's real size\n73\t    // after every layout pass — important for fullscreen/maximize, where a plain\n74\t    // window-resize handler can read the old height before reflow