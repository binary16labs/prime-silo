{"parentUuid":"81f60f1b-9ece-40b5-b78c-0762db50e9ec","isSidechain":false,"promptId":"650baa53-104c-4677-b61d-469b8b62c13b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01T7fXBirsp7UU2sAo7gHj6s","type":"tool_result","content":"1\t// ADR-001 Phase C follow-up — Three.js drop-in renderer.\n2\t//\n3\t// Slots into `kg3d.synoptic_web` and `codegraph.canvas` via the\n4\t// `options.renderer = { mount, update, dispose }` hook that Phase C\n5\t// established as the pluggable-renderer contract. The widget cores stay\n6\t// dependency-free (default 2D SVG); callers that want a 3D scene pass an\n7\t// instance returned by `createThreeRenderer()` and the widget never\n8\t// learns Three.js exists.\n9\t//\n10\t// ## Lazy-loading strategy\n11\t//\n12\t// Three.js is heavy. Bundling it into the shell would tax every page that\n13\t// imports a graph widget, even pages that never enable the 3D renderer.\n14\t// The strategy:\n15\t//\n16\t//   1. The renderer **module** itself has no top-level import of\n17\t//      Three.js / 3d-force-graph. Importing it is free.\n18\t//   2. The first call to `mount()` triggers a dynamic `import()` of\n19\t//      `3d-force-graph` from a CDN ESM endpoint\n20\t//      (`https://esm.sh/3d-force-graph@1` by default). The bundle is\n21\t//      cached by the browser after the first load.\n22\t//   3. While the import is in flight, the mount call returns a handle\n23\t//      synchronously so the widget contract is preserved. Subsequent\n24\t//      `update(layout, props)` calls before the import resolves are\n25\t//      stashed and replayed once the library is ready. `dispose()` before\n26\t//      the import resolves cancels the activation so nothing renders.\n27\t//\n28\t// Tests pass `options.loader = () => Promise<ForceGraph3D>` to inject a\n29\t// stub — the node test runner never touches the CDN. The loader is also\n30\t// the seam through which production callers can pin a specific\n31\t// `3d-force-graph` version or load from a self-hosted bundle.\n32\t//\n33\t// ## Layout contract\n34\t//\n35\t// The widget's `paint(layout)` flow calls `mount/update` with the layout\n36\t// already computed (positions keyed by id, an edges array). The renderer\n37\t// normalises both widget shapes:\n38\t//\n39\t//   • `kg3d.synoptic_web`  → positions carry { x, y, radius, layer, color, node }\n40\t//                            edges carry { id, source, target, kind, weight }\n41\t//   • `codegraph.canvas`   → positions carry { x, y, radius, type, color, node }\n42\t//                            edges carry { id, source, target, type, metadata }\n43\t//\n44\t// `layoutToGraphData(layout)` walks `Object.entries(positions)` to build\n45\t// nodes (preserving the SVG-layout coordinates as `fx`/`fy` initial\n46\t// positions — the 3D force layout iterates from there instead of starting\n47\t// from random) and walks `edges` to build links. The original entries\n48\t// from the widget's `positions[id].node` are carried through on\n49\t// `node._original` for callers that need them on hover.\n50\t//\n51\t// ## Public API\n52\t//\n53\t//   createThreeRenderer(options?) -> { mount, dispose }\n54\t//     options.loader            — () => Promise<ForceGraph3D constructor>\n55\t//     options.cdnUrl            — overrides the default CDN URL\n56\t//     options.backgroundColor   — scene background (default \"#0b1220\")\n57\t//     options.nodeRelSize       — passed through to 3d-force-graph\n58\t//     options.linkColor         — fallback link colour\n59\t//\n60\t//   mount(host, layout, props) -> handle { update, dispose }\n61\t//     Synchronous return. The handle's update / dispose route through to\n62\t//     the underlying 3d-force-graph instance once loaded.\n63\t\n64\tconst DEFAULT_CDN_URL = \"https://esm.sh/3d-force-graph@1\";\n65\tconst DEFAULT_BACKGROUND = \"#0b1220\";\n66\tconst DEFAULT_NODE_REL_SIZE = 4;\n67\tconst DEFAULT_LINK_COLOR = \"rgba(148, 163, 184, 0.55)\";\n68\tconst DEFAULT_NODE_COLOR = \"#94a3b8\";\n69\t\n70\tconst HTML_ESCAPES = {\n71\t  \"&\": \"&amp;\",\n72\t  \"<\": \"&lt;\",\n73\t  \">\": \"&gt;\",\n74\t  '\"': \"&quot;\",\n75\t  \"'\": \"&#39;\"\n76\t};\n77\t\n78\tfunction escapeHtml(text) {\n79\t  return String(text == null ? \"\" : text).replace(/[&<>\"']/g, (ch) => HTML_ESCAPES[ch]);\n80\t}\n81\t\n82\t/**\n83\t * Convert a widget layout (kg3d or codegraph shape) into the 3d-force-graph\n84\t * `{ nodes, links }` payload. Exported for testing.\n85\t */\n86\texport function layoutToGraphData(layout, physicsMode = \"pinned\") {\n87\t  const positions =\n88\t    layout && typeof layout === \"object\" && layout.positions ? layout.positions : {};\n89\t  const edgesRaw = layout && Array.isArray(layout.edges) ? layout.edges : [];\n90\t\n91\t  const nodes = Object.entries(positions).map(([id, entry]) => {\n92\t    const safe = entry && typeof entry === \"object\" ? entry : {};\n93\t    const node = {\n94\t      id,\n95\t      color: typeof safe.color === \"string\" && safe.color ? safe.color : DEFAULT_NODE_COLOR,\n96\t      // `val` drives the default node size in 3d-force-graph. Pre-computed\n97\t      // radii from the 2D layout map directly so the visual weight scales\n98\t      // the same way under both renderers.\n99\t      val: typeof safe.radius === \"number\" ? safe.radius : 1\n100\t    };\n101\t    // Seed the force layout with the SVG-layout coordinates.\n102\t    // If physicsMode is \"pinned\", we fix/pin the X and Y coordinates.\n103\t    // Otherwise (if \"fluid\"), we only set node.x and node.y as initial seeding\n104\t    // values and let the 3D solver move them.\n105\t    if (physicsMode === \"pinned\") {\n106\t      if (typeof safe.x === \"number\") node.fx = safe.x;\n107\t      if (typeof safe.y === \"number\") node.fy = safe.y;\n108\t    } else {\n109\t      if (typeof safe.x === \"number\") node.x = safe.x;\n110\t      if (typeof safe.y === \"number\") node.y = safe.y;\n111\t    }\n112\t    if (safe.layer != null) node