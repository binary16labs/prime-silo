node_modules
.DS_Store
*.sqlite
*.sqlite-shm
*.sqlite-wal
dist
coverage
release
# The unanchored `release` rule above is for build output, but it also swallows
# source dirs that happen to be named release — carve those back in.
!runtime/tests/release/
/app/L1/
/app/L2/

# Benny self-awareness bundle — regenerated on every desktop build, never committed.
/packaging/self-awareness/

# Bundled runtime (embeddable Python + Neo4j + JRE) — assembled at build time, never committed.
/packaging/runtime-bundle/
.env
tmp/
!server/lib/tmp/
!server/lib/tmp/**
!server/tmp/
server/tmp/*
!server/tmp/.gitignore
!server/data/
server/data/*
!server/data/.gitignore
csr.csr
key.pem
.benny_home/
home/
archive/
prime-silo-core/


# Vendored memo-ray child service (MEMORAY-MERGE.md). Source is committed under
# memoray/; its node_modules are covered by the top-level `node_modules` rule and
# are reinstalled by scripts/memoray.ps1 / the desktop build, never committed.
# The entity store is per-user runtime data (canonical: ~/.memoray/data) — the
# in-repo copy that came along in the vendor snapshot is not source.
/memoray/server/data/

# App-registry generated port lockfile (machine-local; never committed).
# The descriptors (app.manifest.json) and registry are source; the lock is not.
apps.lock.json

# Operational data / agent litter (never commit)
/logs/
/workspace/
runtime/logs/
runtime/workspace/
runtime/failed_llm_output_*.txt
# G0 run-event streams land here when PRIME_SILO_HOME/BENNY_HOME are unset
# (e.g. running gates/tests without env set) — per-run data, never committed.
runtime/runs/
# Delivery worktrees (git worktree add .worktrees/<id>) — local-only sandboxes,
# never committed (a stray add here could commit an entire worktree tree).
/.worktrees/

# local scratch: launchers with absolute paths + build logs + session names (repo AGENTS.md §172)
scratch/

# longview transient spawn files (memory gate / graph mover)
scripts/longview/.gate_*.json
scripts/longview/.mover_*.json
