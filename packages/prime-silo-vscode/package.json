{
  "name": "prime-silo-vscode",
  "displayName": "Prime-Silo",
  "description": "VS Code integration for the Prime-Silo deterministic execution platform and graph visualization.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prime-silo.setupRepo",
        "title": "Prime-Silo: Setup Repo"
      },
      {
        "command": "prime-silo.showGraph",
        "title": "Prime-Silo: Show Memory Graph"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "18.x",
    "typescript": "^5.1.3"
  }
}
