# Prime-Silo production environment — copy to .env and fill in.
# NEVER commit the real .env. All values are required unless marked optional.

# --- Benny scope-binding credentials (ADR-003 / Q0) -----------------------------
# Two distinct shared secrets. BENNY_API_KEY is the trusted/human key; the shell
# injects it on /api/runtime. BENNY_AGENT_API_KEY is the sandbox-bound agent key;
# the shell injects it on /api/agent-runtime and Benny pins it to sandbox scope.
# Generate with e.g.  openssl rand -hex 32
#
# Resolution path (no shipped default exists — this is fail-fast by design):
#   1. this env var, if set
#   2. the per-install keystore at %BENNY_HOME%\state\hmac-key (written once by
#      `benny init`; BENNY_AGENT_API_KEY derives from it via HMAC-SHA256)
#   3. neither found -> server/runtime refuses to start with an actionable error
BENNY_API_KEY=
BENNY_AGENT_API_KEY=

# --- Benny internals -----------------------------------------------------------
# HMAC key Benny uses to sign/verify .aamp.view layouts.
BENNY_HMAC_KEY=
NEO4J_PASSWORD=

# --- Networking (Q0: loopback by default) ---------------------------------------
# HOST controls what interface the shell server binds to. Omit it (or leave
# blank) for the safe default: 127.0.0.1 (loopback only, not reachable on the
# LAN). Set HOST=0.0.0.0 only to deliberately expose the server on the network
# — doing so logs a LAN-exposure warning at startup.
HOST=127.0.0.1

# --- Optional ------------------------------------------------------------------
# Host port to expose the shell on (defaults to 3000).
SHELL_PORT=3000
# LLM provider key, if Benny should reach a hosted model.
OPENAI_API_KEY=
